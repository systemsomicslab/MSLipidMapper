    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H2O [cytosol] + PE [endoplasmic reticulum membrane] => LCFA(-) [endoplasmic reticulum membrane] + 1-acyl LPE [endoplasmic reticulum membrane]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10039271], \"className\": \"CatalystActivity\", \"dbId\": 10039269, \"displayName\": \"A2-type glycerophospholipase activity of PLA2(3) [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10039271, \"displayName\": \"PE is hydrolyzed to 1-acyl LPE by PLA2[3]\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039271], \"dbId\": 1500581, \"displayName\": \"PE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PE\", \"phosphatidylethanolamine zwitterion\", \"phosphatidylethanolamine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500581\", \"stIdVersion\": \"R-ALL-1500581.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039271], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PE is hydrolyzed to 1-acyl LPE by PLA2[3]\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1498738, \"displayName\": \"1-acyl LPE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPE\", \"1-acyl-sn-glycero-3-phosphoethanolamine\", \"1-acyl lysophosphatidylethanolamine\", \"L-2-Lysophosphatidylethanolamine\"], \"producedByEvent\": [10039271], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498738\", \"stIdVersion\": \"R-ALL-1498738.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524021, \"displayName\": \"LCFA(-) [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [10039271], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524021\", \"stIdVersion\": \"R-ALL-1524021.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10039136, \"displayName\": \"1-acyl LPE is acylated to PE by LPEAT\", \"followingEvent\": [10039271], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1-acyl LPE is acylated to PE by LPEAT\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1482667\", \"stIdVersion\": \"R-MMU-1482667.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10039118, \"displayName\": \"2-acyl LPE is acylated to PE by LPEAT\", \"followingEvent\": [10039271], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-acyl LPE is acylated to PE