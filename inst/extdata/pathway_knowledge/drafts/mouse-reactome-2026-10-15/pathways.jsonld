    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10085115], \"className\": \"CatalystActivity\", \"dbId\": 10085113, \"displayName\": \"bile acid binding activity of STARD5 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10085115, \"displayName\": \"STARD5 binds DCA, LCA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10085115], \"dbId\": 10085110, \"displayName\": \"Stard5 [cytosol]\", \"endCoordinate\": 213, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Stard5\", \"STARD5\", \"Q9EPQ7\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-196114\", \"stIdVersion\": \"R-MMU-196114.1\", \"startCoordinate\": 1}, {\"className\": \"Set\", \"consumedByEvent\": [10085115], \"dbId\": 8873845, \"displayName\": \"DCA, LCA [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"DCA, LCA\", \"deoxycholic acid, lithocholic acid\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-8873845\", \"stIdVersion\": \"R-ALL-8873845.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD5 binds DCA, LCA\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10085112, \"displayName\": \"STARD5:DCA/LCA [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"STARD5:DCA/LCA\"], \"producedByEvent\": [10085115], \"schemaClass\": \"Complex\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8873894\", \"stIdVersion\": \"R-MMU-8873894.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8873850\", \"stIdVersion\": \"R-MMU-8873850.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
