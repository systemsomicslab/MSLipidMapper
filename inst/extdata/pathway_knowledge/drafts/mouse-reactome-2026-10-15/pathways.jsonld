        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10031446], \"className\": \"CatalystActivity\", \"dbId\": 10031444, \"displayName\": \"malonyl-CoA decarboxylase activity of MLYCD(40-493) [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10031446, \"displayName\": \"malonyl-CoA is decarboxylated to acetyl-CoA in peroxisome\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0006637\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 8047, \"definition\": \"The chemical reactions and pathways involving acyl-CoA, any derivative of coenzyme A in which the sulfhydryl group is in thiolester linkage with an acyl group.\", \"displayName\": \"acyl-CoA metabolic process\", \"name\": \"acyl-CoA metabolic process\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006637\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10031446], \"dbId\": 977323, \"displayName\": \"Malonyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Malonyl-CoA\", \"malonyl-CoA(5-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-977323\", \"stIdVersion\": \"R-ALL