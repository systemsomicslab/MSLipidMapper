        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10018650], \"className\": \"CatalystActivity\", \"dbId\": 10018648, \"displayName\": \"phytanoyl-CoA dioxygenase activity of PHYH:Fe++ [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10018650, \"displayName\": \"phytanoyl-CoA + 2-oxoglutarate + O2 => 2-hydroxyphytanoyl-CoA + succinate + CO2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10018636], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10018650], \"dbId\": 389615, \"displayName\": \"Phytanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Phytanoyl-CoA\", \"phytanoyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389615\", \"stIdVersion\": \"R-ALL-389615.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10018650], \"dbId\": 389537, \"displayName\": \"2OG [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2OG\", \"2-oxoglutarate(2-)\", \"2-Oxoglutarate\", \"2-oxoglutaric acid\", \"Oxoglutaric acid\", \"2-Ketoglutaric acid\", \"alpha-Ketoglutaric acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389537\