    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10039418], \"className\": \"CatalystActivity\", \"dbId\": 10039416, \"displayName\": \"phosphatidate cytidylyltransferase activity of CDS1:Mg2+ [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10039418, \"displayName\": \"PA is converted to CDP-DAG by CDS1\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10039338], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039418], \"dbId\": 426755, \"displayName\": \"PA [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PA\", \"phosphatidate(2-)\", \"phosphatidic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426755\", \"stIdVersion\": \"R-ALL-426755.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039418], \"dbId\": 110614, \"displayName\": \"CTP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CTP\", \"CTP(4-)\", \"cytidine 5'-triphosphate\", \"Cytidine triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-110614\", \"stIdVersion\": \"R-ALL-110614.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PA is converted to CDP-DAG by CDS1\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 426955, \"displayName\": \"CDP-DAG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CDP-DAG\", \"CDP-diacylglycerol(2-)\", \"Cytidine diphosphate diacylglycerol\", \"CDP-diacylglycerol\"], \"producedByEvent\": [10039418], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426955\", \"stIdVersion\": \"R-ALL-426955.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111294, \"displayName\": \"PPi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [10039418], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111294\", \"stIdVersion\": \"R-ALL-111294.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9996042, \"displayName\": \"1-acyl LPA is acylated to PA by AGPAT (LPAAT)\", \"followingEvent\": [10039418], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1-acyl LPA is acylated to PA by AGPAT (LPAAT)\", \"1-acyl-glycerol 3-phosphate + acyl-CoA => 1,2-diacyl-glycerol 3-phosphate + CoASH\", \"lysophosphatidic acid + fatty acyl CoA  => phosphatidic acid + CoA (1) \"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-75885\", \"stIdVersion\": \"R-MMU-75885.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10039442, \"displayName\": \"PC is hydrolyzed to PA and choline by PLD1/2\", \"followingEvent\": [10039418], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PC is hydrolyzed to PA and choline by PLD1/2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1483182\", \"stIdVersion\": \"R-MMU-1483182.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1483121\", \"stIdVersion\": \"R-MMU-1483121.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
