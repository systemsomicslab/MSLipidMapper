    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "Phytanate [peroxisomal matrix] + CoA-SH [peroxisomal matrix] + ATP [peroxisomal matrix] => AMP [peroxisomal matrix] + PPi [peroxisomal matrix] + Phytanoyl-CoA [peroxisomal matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10018641], \"className\": \"CatalystActivity\", \"dbId\": 10018639, \"displayName\": \"phytanate-CoA ligase activity of SLC27A2 [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10018641, \"displayName\": \"phytanate + CoA-SH + ATP => phytanoyl-CoA + AMP + pyrophosphate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10018650], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10018641], \"dbId\": 389573, \"displayName\": \"ATP [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389573\", \"stIdVersion\": \"R-ALL-389573.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10018641], \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10018641], \"dbId\": 389596, \"displayName\": \"Phytanate [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Phytanate\", \"phytanic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389596\", \"stIdVersion\": \"R-ALL-389596.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"phytanate + CoA-SH + ATP => phytanoyl-CoA + AMP + pyrophosphate\", \"3,7,11,15-tetramethylhexadecanoate + ATP + CoA => AMP + diphosphate + phytanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389620, \"displayName\": \"AMP [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AMP\", \"adenosine 5'-monophosphate(2-)\", \"adenosine 5'-monophosphate\"], \"producedByEvent\": [10018641], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389620\", \"stIdVersion\": \"R-ALL-389620.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 389615, \"displayName\": \"Phytanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Phytanoyl-CoA\", \"phytanoyl-CoA(4-)\"], \"producedByEvent\": [10018641], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389615\", \"stIdVersion\": \"R-ALL-389615.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 389593, \"displayName\": \"PPi [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"Pyrophosphate\", \"diphosphoric acid\"], \"producedByEvent\": [10018641], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389593\", \"stIdVersion\": \"R-ALL-389593.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10018657, \"displayName\": \"PMP34-mediated exchange of cytosolic ATP for peroxisomal AMP\", \"followingEvent\": [10018641], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PMP34-mediated exchange of cytosolic ATP for peroxisomal AMP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-389652\", \"stIdVersion\": \"R-MMU-389652.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-389622\", \"stIdVersion\": \"R-MMU-389622.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
