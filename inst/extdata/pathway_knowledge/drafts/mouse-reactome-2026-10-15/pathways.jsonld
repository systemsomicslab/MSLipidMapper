    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "2OH-PALM [peroxisomal matrix] + O2 [peroxisomal matrix] => 2oxo-PALM [peroxisomal matrix] + H2O2 [peroxisomal matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10071870], \"className\": \"CatalystActivity\", \"dbId\": 10071868, \"displayName\": \"(S)-2-hydroxy-acid oxidase activity of HAO2 tetramer [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10071870, \"displayName\": \"HAO2 tetramer oxidises 2OH-PALM\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10071870], \"dbId\": 6787810, \"displayName\": \"2OH-PALM [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2OH-PALM\", \"2-hydroxyhexadecanoate\", \"2-hydroxypalmitic acid\", \"2-hydroxyhexadecanoic acid\", \"2-hydroxypalmitate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6787810\", \"stIdVersion\": \"R-ALL-6787810.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10071870], \"dbId\": 113535, \"displayName\": \"O2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113535\", \"stIdVersion\": \"R-ALL-113535.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HAO2 tetramer oxidises 2OH-PALM\", \"2-hydroxyhexadecanoate + O2 => 2-oxohexadecanoate + H2O2\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 6787814, \"displayName\": \"2oxo-PALM [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2oxo-PALM\", \"2-oxohexadecanoate\", \"2-oxopalmitic acid\", \"2-oxohexadecanoic acid\"], \"producedByEvent\": [10071870], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6787814\", \"stIdVersion\": \"R-ALL-6787814.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113575, \"displayName\": \"H2O2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O2\", \"hydrogen peroxide\"], \"producedByEvent\": [10071870], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113575\", \"stIdVersion\": \"R-ALL-113575.3\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6787811\", \"stIdVersion\": \"R-MMU-6787811.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference 