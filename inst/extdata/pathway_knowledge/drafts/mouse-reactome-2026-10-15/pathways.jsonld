        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10059873], \"className\": \"CatalystActivity\", \"dbId\": 10059871, \"displayName\": \"bile acid nuclear receptor activity of NR1H4 [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10059873, \"displayName\": \"NR1H4 binds DCA, CDCA, LCHA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10059898], \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10059873], \"dbId\": 5340249, \"displayName\": \"DCA,CDCA,LCHA [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"DCA,CDCA,LCHA\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-5340249\", \"stIdVersion\": \"R-ALL-5340249.1\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10059873], \"dbId\": 10007051, \"displayName\": \"NR1H4 [nucleoplasm]\", \"endCoordinate\": 486, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NR1H4\", \"Q60641\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-5340228\", \"stIdVersion\": \"R-MMU-5340228.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NR1H4 binds DCA, CDCA, LCHA\", \"FXR binds bile acids\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10007053, \"displayName\": \"NR1H4:DCA,CD