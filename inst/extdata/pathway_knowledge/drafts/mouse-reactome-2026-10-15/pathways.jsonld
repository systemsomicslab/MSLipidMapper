        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10039158], \"className\": \"CatalystActivity\", \"dbId\": 10039156, \"displayName\": \"glycerol-3-phosphate O-acyltransferase activity of GPAM/GPAT2 [mitochondrial outer membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005741\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17906, \"definition\": \"The outer, i.e. cytoplasm-facing, lipid bilayer of the mitochondrial envelope.\", \"displayName\": \"mitochondrial outer membrane\", \"name\": \"mitochondrial outer membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005741\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10039158, \"displayName\": \"G3P is acylated to 1-acyl LPA by GPAM/GPAT2 (OM)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039158], \"dbId\": 76114, \"displayName\": \"G3P [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"G3P\", \"sn-glycerol 3-phosphate(2-)\", \"Glycerol-3-phosphate\", \"sn-glycerol 3-phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76114\", \"stIdVersion\": \"R-ALL-76114.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039158], \"dbId\": 1500578, \"displayName\": \"acyl-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"acyl-CoA\", \"acyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500578\", \"stIdVersion\": \"R-ALL-1500578.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"G3P is acylated to 1-acyl LPA by GPAM/GPAT2 (OM)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1500580, \"displayName\": \"1-acyl LPA [mitochondrial outer membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPA\", \"1-acyl-sn-glycerol 3-phosphate\", \"1-acyl-glycerol 3-phosphate \", \"lysophosphatidic acid\"], \"producedByEvent\": [10039158], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500580\", \"stIdVersion\": \"R-ALL-1500580.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10039158], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9996091, \"displayName\": \"DHAP is converted to G3P by GPD1/GPD1L\", \"followingEvent\": [10039158], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DHAP is converted to G3P by GPD1/GPD1L\", \"Conversion of Dihydroxyacetone Phosphate to Glycerol -3- phosphate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-75889\", \"stIdVersion\": \"R-MMU-75889.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9996074, \"displayName\": \"Conversion of Glycerol to Glycerol-3-phosphate\", \"followingEvent\": [10039158], \"isInDisease\": false, \"is