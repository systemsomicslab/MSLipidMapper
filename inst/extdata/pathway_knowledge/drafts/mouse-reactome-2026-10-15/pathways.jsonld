      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10040954], \"className\": \"CatalystActivity\", \"dbId\": 10040952, \"displayName\": \"enzyme inhibitor activity of SUMF2 [endoplasmic reticulum lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}], \"dbId\": 10040954, \"displayName\": \"SUMF2 binds SUMF1, inhibiting SUMF1-mediated activation of arylsulfatases\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10040954], \"dbId\": 10040945, \"displayName\": \"SUMF1 [endoplasmic reticulum lumen]\", \"endCoordinate\": 374, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SUMF1\", \"Q8R0F3\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1614316\", \"stIdVersion\": \"R-MMU-1614316.1\", \"startCoordinate\": 34}, {\"className\": \"Protein\", \"consumedByEvent\": [10040954], \"dbId\": 10040949, \"displayName\": \"SUMF2 [endoplasmic reticulum lumen]\", \"endCoordinate\": 301, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SUMF2\", \"Q8BPG6\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1614305\", \"stIdVersion\": \"R-MMU-1614305.1\", \"startCoordinate\": 26}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SUMF2 binds SUMF1, inhibiting SUMF1-mediated activation of arylsulfatases\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10040951, \"displayName\": \"SUMF1:SUMF2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"SUMF1:SUMF2\"], \"producedByEvent\": [10040954], \"schemaClass\": \"Complex\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1614330\", \"stIdVersion\": \"R-MMU-1614330.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1614336\", \"stIdVersion\": \"R-MMU-1614336.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
