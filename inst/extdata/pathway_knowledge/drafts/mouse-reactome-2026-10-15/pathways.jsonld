    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10084999], \"className\": \"CatalystActivity\", \"dbId\": 10084997, \"displayName\": \"phosphatidylinositol-3-phosphate binding activity of PLEKHA4,(5,6) [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10084999, \"displayName\": \"PLEKHA4,(5,6) bind PI3P\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10084999], \"dbId\": 10084994, \"displayName\": \"PLEKHA4,(5,6) [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PLEKHA4,(5,6)\"], \"schemaClass\": \"CandidateSet\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8870496\", \"stIdVersion\": \"R-MMU-8870496.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10084999], \"dbId\": 1806276, \"displayName\": \"PI3P [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI3P\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate(3-)\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806276\", \"stIdVersion\": \"R-ALL-1806276.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLEKHA4,(5,6) bind PI3P\"], \"output\": [{\"