    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + ANDST [cytosol] + NADPH [cytosol] => TEST [cytosol] + NADP+ [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10007361], \"className\": \"CatalystActivity\", \"dbId\": 10007357, \"displayName\": \"testosterone dehydrogenase (NADP+) activity of HSD17B3-like Proteins [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10007361, \"displayName\": \"HSD17B3-like proteins reducde ANDST to TEST\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10007391], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10007361], \"dbId\": 193079, \"displayName\": \"ANDST [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ANDST\", \"androst-4-ene-3,17-dione\", \"4-Androstene-3, 17-dione\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193079\", \"stIdVersion\": \"R-ALL-193079.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10007361], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10007361], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B3-like proteins reducde ANDST to TEST\", \"Reduction of androstenedione to testosterone\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193057, \"displayName\": \"TEST [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TEST\", \"testosterone\"], \"producedByEvent\": [10007361], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193057\", \"stIdVersion\": \"R-ALL-193057.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [10007361], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007377, \"displayName\": \"HSD2B1 dimer, HSD3B2 dimer isomerise DHA to ANDST\", \"followingEvent\": [10007361], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD2B1 dimer, HSD3B2 dimer isomerise DHA to ANDST\", \"DHA isomerizes to 4-Androstene3,17-dione\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193073\", \"stIdVersion\": \"R-MMU-193073.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007379, \"displayName\": \"CYP17A1 cleaves 17aHPROG to ANDST\", \"followingEvent\": [10007361], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP17A1 cleaves 17aHPROG to ANDST\", \"Side chain cleavage of 17alpha-hydroxyprogesterone to form 4-Androstene-3, 17-dione\", \"17alpha-hydroxyprogesterone + NADPH + H+ + O2 => 4-Androstene-3, 17-dione + NADP+ + H2O + acetaldehyde\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193099\", \"stIdVersion\": \"R-MMU-193099.1\"}], \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 10007312, \"displayName\": \"Positive regulation by 'glyco-Lutropin [extracellular region]'\", \"regulatedEntity\": [10007361], \"schemaClass\": \"PositiveRegulation\"}, {\"className\": \"PositiveRegulation\", \"dbId\": 10007362, \"displayName\": \"Positive regulation by 'POMC(138-176) [cytosol]'\", \"regulatedEntity\": [10007361], \"schemaClass\": \"PositiveRegulation\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193064\", \"stIdVersion\": \"R-MMU-193064.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
