    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10001811], \"className\": \"CatalystActivity\", \"dbId\": 10001809, \"displayName\": \"fatty acid synthase activity of FASN [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10001811, \"displayName\": \"Formation of fatty acid synthase (FAS) dimer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10001811, 10001811], \"dbId\": 9995969, \"displayName\": \"phospho-FASN [cytosol]\", \"endCoordinate\": 2511, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"phospho-FASN\", \"P19096\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-54659\", \"stIdVersion\": \"R-MMU-54659.1\", \"startCoordinate\": 1}, 9995969], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Formation of fatty acid synthase (FAS) dimer\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 9995971, \"displayName\": \"FASN dimer [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"FASN dimer\"], \"producedByEvent\": [10001811], \"schemaClass\": \"Complex\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-77380\", \"stIdVersion\": \"R-MMU-77380.1\"}], \"releaseDate\": \