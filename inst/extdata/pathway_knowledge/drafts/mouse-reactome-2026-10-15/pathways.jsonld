    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10006794], \"className\": \"CatalystActivity\", \"dbId\": 10006792, \"displayName\": \"(2E,6E)-farnesyl diphosphate synthase activity of holo-FDPS dimer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10006794, \"displayName\": \"FDPS dimer transfers IPPP to GPP\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10006855], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10006794], \"dbId\": 191409, \"displayName\": \"GPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GPP\", \"geranyl diphosphate(3-)\", \"Geranyl pyrophosphate\", \"geranyl diphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191409\", \"stIdVersion\": \"R-ALL-191409.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10006794], \"dbId\": 191362, \"displayName\": \"IPPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"IPPP\", \"isopentenyl diphosphate(3-)\", \"delta3-isopentenyl-PP\", \"isopentenyl diphosphate\", \"delta3-isopentenyl pyrophosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191362\", \"stIdVersion\": \"R-ALL-191362.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FDPS dimer transfers IPPP to GPP\", \"isopentenyl diphosphate + (2E)-geranyl diphosphate => (2E,6E)-farnesyl diphosphate + diphosphate\", \"Another isopentenyl pyrophosphate is added to geranyl pyrophosphate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 191385, \"displayName\": \"FAPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FAPP\", \"2-trans,6-trans-farnesyl diphosphate(3-)\", \"Farnesyl pyrophosphate\", \"2-trans,6-trans-farnesyl diphosphate\"], \"producedByEvent\": [10006794], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191385\", \"stIdVersion\": \"R-ALL-191385.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111294, \"displayName\": \"PPi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [10006794], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111294\", \"stIdVersion\": \"R-ALL-111294.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10006797, \"displayName\": \"FDPS dimer transfers IPPP to DMAPP\", \"followingEvent\": [10006794], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FDPS dimer transfers IPPP to DMAPP\", \"isopentenyl diphosphate + dimethylallyl diphosphate => (2E)-geranyl diphosphate + diphosphate\", \"Addition of isopentenyl pyrophosphate to DMAPP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-191322\", \"stIdVersion\": \"R-MMU-191322.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10097279, \"displayName\": \"GGPS1 hexamer transfers IPPP to DMAPP\", \"followingEvent\": [10006794], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GGPS1 hexamer transfers IPPP to DMAPP\", \"isopentenyl diphosphate + dimethylallyl diphosphate => (2E)-geranyl diphosphate + diphosphate\", \"Addition of isopentenyl pyrophosphate to DMAPP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9717834\", \"stIdVersion\": \"R-MMU-9717834.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10006864, \"displayName\": \"MVD decarboxylates MVA5PP to IPPP\", \"followingEvent\": [10006794], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MVD decarboxylates MVA5PP to IPPP\", \"(R)-5-diphosphomevalonate + ATP => isopentenyl diphosphate + ADP + phosphate + CO2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-191414\", \"stIdVersion\": \"R-MMU-191414.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-191303\", \"stIdVersion\": \"R-MMU-191303.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
