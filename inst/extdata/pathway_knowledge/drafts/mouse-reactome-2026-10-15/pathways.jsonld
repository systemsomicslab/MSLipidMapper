      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10047182], \"className\": \"CatalystActivity\", \"dbId\": 10018839, \"displayName\": \"acetyl-CoA hydrolase activity of ACOT8 [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10047182, \"displayName\": \"Conversion of DHA-CoA to docosahexaenoic acid (DHA)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10047182], \"dbId\": 2066765, \"displayName\": \"DHA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHA-CoA\", \"(4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoyl-CoA\", \"4Z,7Z,10Z,13Z,16Z,19Z-docosahexaenoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2066765\", \"stIdVersion\": \"R-ALL-2066765.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10047182], \"dbId\": 141343, \"displayName\": \"H2O [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-141343\", \"stIdVersion\": \"R-ALL-141343.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Conversion of DHA-CoA to docosahexaenoic acid (DHA)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2066763, \"displayName\": \"DHA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHA\", \"(4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoate\", \"Docosahexaenoic acid (DHA)\", \"all-cis-docosa-4,7,10,13,16,19-hexaenoic acid\", \"(4Z,7Z,10Z,13Z,16Z,19Z)-Docosahexaenoic acid\", \"22:6(n-3)\"], \"producedByEvent\": [10047182], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2066763\", \"stIdVersion\": \"R-ALL-2066763.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10047182], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10047187, \"displayName\": \"Formation of DHA-CoA catalysed by sterol carrier protein X (SCPx)\", \"followingEvent\": [10047182], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Formation of DHA-CoA catalysed by sterol carrier protein X (SCPx)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2066781\", \"stIdVersion\": \"R-MMU-2066781.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10047192, \"displayName\": \"Formation of DHA-CoA catalysed by 3-ketoacyl-CoA thiolase\", \"followingEvent\": [10047182], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Formation of DHA-CoA catalysed by 3-ketoacyl-CoA thiolase\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2066788\", \"stIdVersion\": \"R-MMU-2066788.1\"}],