        "@value": "{\"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10049926, \"displayName\": \"ASA- acetylates PTGS2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10049926], \"dbId\": 10049906, \"displayName\": \"PTGS2 dimer [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PTGS2 dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-140491\", \"stIdVersion\": \"R-MMU-140491.1\"}, {\"className\": \"ChemicalDrug\", \"consumedByEvent\": [10049926], \"dbId\": 2314693, \"displayName\": \"ASA- [cytosol]\", \"inDisease\": true, \"maxDepth\": 1, \"name\": [\"ASA-\", \"acetylsalicylate(1-)\"], \"schemaClass\": \"ChemicalDrug\", \"stId\": \"R-ALL-2314693\", \"stIdVersion\": \"R-ALL-2314693.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ASA- acetylates PTGS2\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10048579, \"displayName\": \"Ac-PTGS2 dimer [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Ac-PTGS2 dimer\"], \"producedByEvent\": [10049926], \"schemaClass\": \"Complex\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2314687\", \"stIdVersion\": \"R-MMU-2314687.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 2314690, \"displayName\": \"ST [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ST\", \"salicylate\"], \"producedByEvent\": [10049926], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2314690\", \"stIdVersion\": \"R-ALL-2314690.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10094665, \"displayName\": \"SLC16A1:BSG cotransports monocarboxylates, H+ from extracellular region to cytosol\", \"followingEvent\": [10049926], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC16A1:BSG cotransports monocarboxylates, H+ from extracellular region to cytosol\", \"MCTs mediate proton-coupled transport of monocarboxylates and ketone bodies\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9645220\", \"stIdVersion\": \"R-MMU-9645220.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10097669, \"displayName\": \"SLCO2B1-1 transports ASA- from extracellular region to cytosol of GI cells\", \"followingEvent\": [10049926], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLCO2B1-1 transports ASA- from extracellular region to cytosol of GI cells\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9749607\", \"stIdVersion\": \"R-MMU-9749607.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10097658, \"displayName\": \"SLC22A7 transports ASA-,ST from extracellular region to cytosol of hepatocytes\", \"followingEvent\": [10049926], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC22A7 transports ASA-,ST from extracellular region to cytosol of hepatocytes\", \"SLC22A7 transports ASA-,ST into liver cells\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9749583\", \"stIdVersion\": \"R-MMU-9749583.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2314686\", \"stIdVersion\": \"R-MMU-2314686.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
