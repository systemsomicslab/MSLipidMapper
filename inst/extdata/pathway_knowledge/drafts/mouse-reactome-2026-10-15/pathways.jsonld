    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "CoA-SH [cytosol] + ATP [cytosol] + bempedoic acid [cytosol] => ETC-1002-CoA [cytosol] + AMP [cytosol] + PPi [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10097560], \"className\": \"CatalystActivity\", \"dbId\": 10007414, \"displayName\": \"long-chain fatty acid-CoA ligase activity of SLC27A2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10097560, \"displayName\": \"SLC27A2 ligates CoA to bempedoic acid to form ETC-1002-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10097564], \"input\": [{\"className\": \"ChemicalDrug\", \"consumedByEvent\": [10097560], \"dbId\": 9734538, \"displayName\": \"bempedoic acid [cytosol]\", \"inDisease\": true, \"maxDepth\": 1, \"name\": [\"bempedoic acid\"], \"schemaClass\": \"ChemicalDrug\", \"stId\": \"R-ALL-9734538\", \"stIdVersion\": \"R-ALL-9734538.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10097560], \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10097560], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP