        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10006871], \"className\": \"CatalystActivity\", \"dbId\": 10006869, \"displayName\": \"phosphomevalonate kinase activity of PMVK [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10006871, \"displayName\": \"Mevalonate-5-phosphate is further phosphorylated\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10006864], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10006871], \"dbId\": 191296, \"displayName\": \"MVA5P [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MVA5P\", \"(R)-5-phosphonatomevalonate(3-)\", \"Mevalonate-5-phosphate\", \"(R)-5-phosphomevalonic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191296\", \"stIdVersion\": \"R-ALL-191296.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10006871], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Mevalonate-5-phosphate is further phosphorylated\", \"(R)-5-phosphomevalonate + ATP => (R)-5-diphosphomevalonate + ADP\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 191403, \"displayName\": \"MVA5PP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MVA5PP\", \"(R)-5-diphosphonatomevalonate(4-)\", \"(R)-5-diphosphomevalonic acid\", \"Mevalonate-5-pyrophosphate\"], \"producedByEvent\": [10006871], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191403\", \"stIdVersion\": \"R-ALL-191403.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [10006871], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10006829, \"displayName\": \"Mevalonate is phosphorylated to mevalonate-5-phosphate\", \"followingEvent\": [10006871], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Mevalonate is phosphorylated to mevalonate-5-phosphate\", \"(R)-mevalonate + ATP => (R)-5-phosphomevalonate + ADP + H(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-191380\", \"stIdVersion\": \"R-MMU-191380.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-191422\", \"stIdVersion\": \"R-MMU-191422.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
