    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10078027], \"className\": \"CatalystActivity\", \"dbId\": 10078025, \"displayName\": \"phosphatidylinositol-3-phosphate phosphatase activity of MTMR6:MTMR9,MTMR8:MTMR9 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10078027, \"displayName\": \"PI3P is dephosphorylated to PI by MTMR9-bound MTMR8 or MTMR6 at the plasma membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10078027], \"dbId\": 1806276, \"displayName\": \"PI3P [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI3P\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate(3-)\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806276\", \"stIdVersion\": \"R-ALL-1806276.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10078027], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI3P is dephosphorylated to PI by MTMR9-bound MTMR8 or MTMR6 at the plasma membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 426658, \"displayName\": \"PI [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI\", \"1-phosphatidyl-1D-myo-inositol(1-)\", \"Phosphatidyl 1D-myo-inositol\", \"1-phosphatidyl-1D-myo-inositol\"], \"producedByEvent\": [10078027], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426658\", \"stIdVersion\": \"R-ALL-426658.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [10078027], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10041929, \"displayName\": \"PI(3,4)P2 is dephosphorylated to PI3P by INPP4A/B at the plasma membrane\", \"followingEvent\": [10078027], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2 is dephosphorylated to PI3P by INPP4A/B at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1676164\", \"stIdVersion\": \"R-MMU-1676164.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10041718, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI3P by SYNJ at the plasma membrane\", \"followingEvent\": [10078027], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI3P by SYNJ at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1675836\", \"stIdVersion\": \"R-MMU-1675836.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6809325\", \"stIdVersion\": \"R-MMU-6809325.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
