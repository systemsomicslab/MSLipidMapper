      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10041927], \"className\": \"CatalystActivity\", \"dbId\": 10041925, \"displayName\": \"phosphatidylinositol-3,4-bisphosphate 4-phosphatase activity of INPP4A/B [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0031901\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 171062, \"definition\": \"The lipid bilayer surrounding an early endosome.\", \"displayName\": \"early endosome membrane\", \"name\": \"early endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031901\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10041927, \"displayName\": \"PI(3,4)P2 is dephosphorylated to PI3P by INPP4A/B at the early endosome membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10041901], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10041927], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10041927], \"dbId\": 1806238, \"displayName\": \"PI(3,4)P2 [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2\", \"1-phosphatidyl-1D-myo-inositol 3,4-bisphosphate\", \"1-phosphatidyl-1D-myo-inositol 3,4-bisphosphates\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806238\", \"stIdVersion\": \"R-ALL-1806238.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2 is dephosphorylated to PI3P by INPP4A/B at the early endosome membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1806200, \"displayName\": \"PI3P [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI3P\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate(3-)\", \"PtdIns3P\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate\"], \"producedByEvent\": [10041927], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806200\", \"stIdVersion\": \"R-ALL-1806200.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [10041927], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10041967, \"displayName\": \"PI4P is phosphorylated to PI(3,4)P2 by PIK3C2A at the early endosome membrane\", \"followingEvent\": [10041927], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI4P is phosphorylated to PI(3,4)P2 by PIK3C2A at the early endosome membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1676206\", \"stIdVersion\": \"R-MMU-1676206.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\