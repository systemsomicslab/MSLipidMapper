    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "NADPH [mitochondrial matrix] + H+ [mitochondrial matrix] + O2 [mitochondrial matrix] + 11DCORST [mitochondrial matrix] => NADP+ [mitochondrial matrix] + CORST [mitochondrial matrix] + H2O [mitochondrial matrix]"
