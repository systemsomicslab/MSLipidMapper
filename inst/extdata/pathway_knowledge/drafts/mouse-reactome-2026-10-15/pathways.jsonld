        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10007407], \"className\": \"CatalystActivity\", \"dbId\": 10007405, \"displayName\": \"choloyl-CoA hydrolase activity of ACOT8 [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10007407, \"displayName\": \"Hydrolysis of choloyl-CoA to cholate and CoASH\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10007407], \"dbId\": 141343, \"displayName\": \"H2O [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-141343\", \"stIdVersion\": \"R-ALL-141343.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10007407], \"dbId\": 192356, \"displayName\": \"choloyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"choloyl-CoA\", \"choloyl-CoA(4-)\", \"3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192356\", \"stIdVersion\": \"R-ALL-192356.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Hydrolysis of choloyl-CoA to cholate and CoASH\", \"choloyl-CoA + H2O => cholate + CoA + H(+)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193451, \"displayName\": \"CCA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CCA\", \"cholate\", \"cholic acid\"], \"producedByEvent\": [10007407], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193451\", \"stIdVersion\": \"R-ALL-193451.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10007407], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10007407], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007213, \"displayName\": \"Thiolysis of 3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA yields choloyl-CoA (3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA) and propionyl CoA\", \"followingEvent\": [10007407], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Thiolysis of 3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA yields choloyl-CoA (3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA) and propionyl CoA\", \"3alpha,7alpha,12alpha-trihydroxy-24-oxo-5beta-cholestan-26-oyl-CoA + CoA => choloyl-CoA + propanoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-192341\", \"stIdVersion\"