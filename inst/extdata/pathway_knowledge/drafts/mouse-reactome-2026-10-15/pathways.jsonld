    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10007132], \"className\": \"CatalystActivity\", \"dbId\": 10007078, \"displayName\": \"oxidoreductase activity, acting on NAD(P)H as acceptor of CYP27A1 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10007132, \"displayName\": \"5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol is oxidized to 3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-27-al\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10007137], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10007132], \"dbId\": 192201, \"displayName\": \"5bCHOL3a,7a,12a,27-tetrol [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5bCHOL3a,7a,12a,27-tetrol\", \"5beta-cholestane-3alpha,7alpha,12alpha,26-tetrol\", \"5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192201\", \"stIdVersion\": \"R-ALL-192201.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10007132], \"dbId\": 113563, \"displayName\": \"NADP+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDept