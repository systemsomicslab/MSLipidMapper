        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10018829], \"className\": \"CatalystActivity\", \"dbId\": 10018827, \"displayName\": \"carnitine O-octanoyltransferase activity of CROT [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10018829, \"displayName\": \"4,8-dimethylnonanoyl-CoA + carnitine => 4,8-dimethylnonanoylcarnitine + CoASH\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10018829], \"dbId\": 390271, \"displayName\": \"4,8-dimethylnonanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4,8-dimethylnonanoyl-CoA\", \"4,8-dimethylnonanoyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390271\", \"stIdVersion\": \"R-ALL-390271.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10018829], \"dbId\": 390294, \"displayName\": \"CAR [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CAR\", \"(R)-carnitine\", \"gamma-Trimethyl-hydroxybutyrobetaine\", \"carnitine\", \"3-Hydroxy-4-trimethylammoniobutanoate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390294\", \"stIdVersion\": \"R-A