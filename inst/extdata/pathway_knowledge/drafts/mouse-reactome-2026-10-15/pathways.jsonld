    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "5(S)-Hp-18(S)-HEPE [cytosol] + O2 [cytosol] => 5S,6S-epoxy-18(S)-HEPE [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10092450], \"className\": \"CatalystActivity\", \"dbId\": 10092446, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen of ALOX5 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10092450, \"displayName\": \"ALOX5 oxidises 5(S)-Hp-18(S)-HEPE to 5S,6S-epoxy-18(S)-HEPE\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10092453], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10092450], \"dbId\": 9020602, \"displayName\": \"5(S)-Hp-18(S)-HEPE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5(S)-Hp-18(S)-HEPE\", \"(5S)-hydroperoxy-(18S)-hydroxy-(6E,8Z,11Z,14Z,16E)-icosapentaenoate\", \"18S-hydroxy-5S-HpEPE(1-)\", \"(5S)-hydroperoxy-(18S)-hydroxy-(6E,8Z,11Z,14Z,16E)-icosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9020602\", \"stIdVersion\": \"R-ALL-9020602.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10092450], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 5(S)-Hp-18(S)-HEPE to 5S,6S-epoxy-18(S)-HEPE\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9022655, \"displayName\": \"5S,6S-epoxy-18(S)-HEPE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5S,6S-epoxy-18(S)-HEPE\", \"5(S)6-epoxy-18(S)-HEPE(1-)\", \"5(S)6-epoxy-18(S)-HEPE\", \"5(S)6-epoxy-18S-HEPE\", \"5,6-epoxy,18S-hydroxy-eicosapentaenoic acid\"], \"producedByEvent\": [10092450], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9022655\", \"stIdVersion\": \"R-ALL-9022655.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092448, \"displayName\": \"ALOX5 oxidises 18(S)-HEPE to 5(S)-Hp-18(S)-HEPE\", \"followingEvent\": [10092450], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 18(S)-HEPE to 5(S)-Hp-18(S)-HEPE\", \"(18S)-hydroxy-(5Z,8Z,11Z,14Z,16E)-eicosapentaenoate + O2 => (5S)-hydroperoxy-(18S)-hydroxy-(6E,8Z,11Z,14Z,16E)-eicosapentaenoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9018858\", \"stIdVersion\": \"R-MMU-9018858.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9018859\", \"stIdVersion\": \"R-MMU-9018859.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
