    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10039435], \"className\": \"CatalystActivity\", \"dbId\": 10039433, \"displayName\": \"phosphatidylethanolamine N-methyltransferase activity of PEMT [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10039435, \"displayName\": \"PE is methylated to PC by PEMT\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039435], \"dbId\": 1500581, \"displayName\": \"PE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PE\", \"phosphatidylethanolamine zwitterion\", \"phosphatidylethanolamine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500581\", \"stIdVersion\": \"R-ALL-1500581.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039435, 10039435, 10039435], \"dbId\": 71284, \"displayName\": \"AdoMet [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AdoMet\", \"S-adenosyl-L-methionine zwitterion\", \"S-adenosylmethionine\", \"S-adenosyl-L-methionine\", \"SAM\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-71284\", \"stIdVersion\": \"R-ALL-71284.7\"}, 71284, 71284], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PE is methylated to PC by PEMT\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 426925, \"displayName\": \"PC [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PC\", \"1,2-diacyl-sn-glycero-3-phosphocholine\", \"Phosphatidyl choline\"], \"producedByEvent\": [10039435], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426925\", \"stIdVersion\": \"R-ALL-426925.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 71285, \"displayName\": \"AdoHcy [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AdoHcy\", \"S-adenosyl-L-homocysteine zwitterion\", \"S-adenosylhomocysteine\", \"S-adenosyl-L-homocysteine\", \"SAH\"], \"producedByEvent\": [10039435, 10039435, 10039435], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-71285\", \"stIdVersion\": \"R-ALL-71285.7\"}, 71285, 71285], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10039136, \"displayName\": \"1-acyl LPE is acylated to PE by LPEAT\", \"followingEvent\": [10039435], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1-acyl LPE is acylated to PE by LPEAT\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1482667\", \"stIdVersion\": \"R-MMU-1482667.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10039118, \"displayName\": \"2-acyl LPE is acylated to PE by LPEAT\", \"followingEvent\": [10039435], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-acyl LPE is acylated to PE by LPEAT\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1482646\", \"stIdVersion\": \"R-MMU-1482646.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10039320, \"displayName\": \"CDP-ETA and DAG are converted to PE by CEPT1/EPT1\", \"followingEvent\": [10039435], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CDP-ETA and DAG are converted to PE by CEPT1/EPT1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1482962\", \"stIdVersion\": \"R-MMU-1482962.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1483174\", \"stIdVersion\": \"R-MMU-1483174.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
