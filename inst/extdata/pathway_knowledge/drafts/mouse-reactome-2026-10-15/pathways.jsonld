      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10039343], \"className\": \"CatalystActivity\", \"dbId\": 10039341, \"displayName\": \"glycerone-phosphate O-acyltransferase activity of GNPAT [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005778\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17947, \"definition\": \"The lipid bilayer surrounding a peroxisome.\", \"displayName\": \"peroxisomal membrane\", \"name\": \"peroxisomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005778\"}], \"dbId\": 10039343, \"displayName\": \"DHAP is converted to 1-acyl GO3P by GNPAT\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039343], \"dbId\": 75970, \"displayName\": \"DHAP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHAP\", \"glycerone phosphate(2-)\", \"glycerone phosphate\", \"dihydroxyacetone phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-75970\", \"stIdVersion\": \"R-ALL-75970.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039343], \"dbId\": 1500578, \"displayName\": \"acyl-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"acyl-CoA\", \"acyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500578\", \"stIdVersion\": \"R-ALL-1500578.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DHAP is converted to 1-acyl GO3P by GNPAT\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10039343], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 75973, \"displayName\": \"GO3P [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GO3P\", \"1-alkylglycerone 3-phosphate(2-)\", \"O-hexadecylglycerone phosphate\", \"1-alkylglycerone 3-phosphate\", \"O-hexadecyldihydroxyacetone phosphate\", \"O-alkylglycerone phosphate\"], \"producedByEvent\": [10039343], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-75973\", \"stIdVersion\": \"R-ALL-75973.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1483002\", \"stIdVersion\": \"R-MMU-1483002.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
