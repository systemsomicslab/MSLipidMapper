    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "GM2,GD2,GA2 [Golgi membrane] + UDP-Gal [Golgi lumen] => GM1,GD1b,GA1 [Golgi membrane] + H+ [Golgi lumen] + UDP [Golgi lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10100939], \"className\": \"CatalystActivity\", \"dbId\": 10100937, \"displayName\": \"N-acetyl-beta-D-glucosaminide beta-(1,3)-galactosyltransferase activity of B3GALT4 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}], \"dbId\": 10100939, \"displayName\": \"B3GALT4 transfers Gal to gangliosides\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10100957], \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10100939], \"dbId\": 9845519, \"displayName\": \"GM2,GD2,GA2 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GM2,GD2,GA2\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9845519\", \"stIdVersion\": \"R-ALL-9845519.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10100939], \"dbId\": 735682, \"displayName\": \"UDP-Gal [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP-Gal\",