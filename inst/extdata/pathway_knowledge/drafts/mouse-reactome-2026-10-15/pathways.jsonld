    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10002038], \"className\": \"CatalystActivity\", \"dbId\": 10002036, \"displayName\": \"carnitine transmembrane transporter activity of SLC22A5 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10002038, \"displayName\": \"OCTN2 / SLC22A5 transports CAR from extracellular space to cytosol\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"1902603\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 5263434, \"definition\": \"The directed movement of carnitine across a membrane.\", \"displayName\": \"carnitine transmembrane transport\", \"name\": \"carnitine transmembrane transport\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:1902603\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10002038], \"dbId\": 164988, \"displayName\": \"CAR [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CAR\", \"(R)-carnitine\", \"gamma-Trimethyl-hydroxybutyrobetaine\", \"carnitine\", \"3-Hydroxy-4-trimethylammoniobutanoate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-164988\", \"stIdVersion\": \"R-ALL-164988.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10002038], \"dbId\": 74113, \"displayName\": \"Na+ [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Na+\", \"sodium(1+)\", \"sodium ion\", \"Sodium\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-74113\", \"stIdVersion\": \"R-ALL-74113.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"OCTN2 / SLC22A5 transports CAR from extracellular space to cytosol\", \"(R)-carnitine(out) + Na(+)(out) = (R)-carnitine(in) + Na(+)(in)\", \"carnitine [extracellular] + Na+ [extracellular] -> carnitine [cytosol] + Na+ [cytosol]\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 30235, \"displayName\": \"CAR [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CAR\", \"(R)-carnitine\", \"gamma-Trimethyl-hydroxybutyrobetaine\", \"carnitine\", \"3-Hydroxy-4-trimethylammoniobutanoate\"], \"producedByEvent\": [10002038], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-30235\", \"stIdVersion\": \"R-ALL-30235.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 83910, \"displayName\": \"Na+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Na+\", \"sodium(1+)\", \"sodium ion\", \"Sodium\"], \"producedByEvent\": [10002038], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-83910\", \"stIdVersion\": \"R-ALL-83910.4\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-165026\", \"stIdVersion\": \"R-MMU-165026.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
