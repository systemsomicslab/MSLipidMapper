        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10092510], \"className\": \"CatalystActivity\", \"dbId\": 10092446, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen of ALOX5 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10092510, \"displayName\": \"ALOX5 oxidises 17(S)-HDHA to 7(S)-Hp-17(S)-HDHA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10092510], \"dbId\": 9024815, \"displayName\": \"17(S)-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17(S)-HDHA\", \"(17S)-HDHA(1-)\", \"17(S)-HDHA(1-)\", \"17(S)-hydroxydocosahexaenoic acid\", \"17(S)-HDoHE\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024815\", \"stIdVersion\": \"R-ALL-9024815.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10092510], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 17