        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10039022], \"className\": \"CatalystActivity\", \"dbId\": 10039020, \"displayName\": \"1-acylglycerol-3-phosphate O-acyltransferase activity of LPGAT [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10039022, \"displayName\": \"1-acyl LPG is acylated to PG by LPGAT\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039022], \"dbId\": 1498740, \"displayName\": \"1-acyl LPG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPG\", \"1-acyl-sn-glycero-3-phosphoglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498740\", \"stIdVersion\": \"R-ALL-1498740.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039022], \"dbId\": 1500578, \"displayName\": \"acyl-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"acyl-CoA\", \"acyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500578\", \"stIdVersion\": \"R-ALL-1500578.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1-acyl LPG is acylated to PG by LPGAT\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1483256, \"displayName\": \"PG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PG\", \"1,2-diacyl-sn-glycero-3-phospho-(1'-sn-glycerol)(1-)\", \"phosphatidylglycerol\"], \"producedByEvent\": [10039022], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1483256\", \"stIdVersion\": \"R-ALL-1483256.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10039022], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10039288, \"displayName\": \"PG is hydrolyzed to 1-acyl LPG by PLA2[1]\", \"followingEvent\": [10039022], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PG is hydrolyzed to 1-acyl LPG by PLA2[1]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1482900\", \"stIdVersion\": \"R-MMU-1482900.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10039290, \"displayName\": \"PG is hydrolyzed to 1-acyl LPG by PLA2G2A\", \"followingEvent\": [10039022], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PG is hydrolyzed to 1-acyl LPG by PLA2G2A\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1482907\", \"stIdVersion\": \"R-MMU-1482907.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1482539\", \"stIdVersion\": \"R-MMU-1482539.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in