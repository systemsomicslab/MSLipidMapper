        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [9994489], \"className\": \"CatalystActivity\", \"dbId\": 9994476, \"displayName\": \"3-hydroxybutyrate dehydrogenase activity of BDH1 tetramer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 9994489, \"displayName\": \"D-beta hydroxybutyrate+NAD+ <=> acetoacetate+NADH+H+\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [9994713], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9994489], \"dbId\": 73911, \"displayName\": \"bHBA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"bHBA\", \"(R)-3-hydroxybutyric acid\", \"D-beta hydroxybutyrate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-73911\", \"stIdVersion\": \"R-ALL-73911.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9994489], \"dbId\": 113526, \"displayName\": \"NAD+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\", \"NAD+ \"], \"referenceType\