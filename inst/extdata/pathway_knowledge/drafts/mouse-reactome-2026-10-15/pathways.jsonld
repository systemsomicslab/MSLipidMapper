        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10040753], \"className\": \"CatalystActivity\", \"dbId\": 10040751, \"displayName\": \"beta-galactosidase activity of BGAL [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}, {\"accession\": \"0005765\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17938, \"definition\": \"The lipid bilayer surrounding the lysosome and separating its contents from the cell cytoplasm.\", \"displayName\": \"lysosomal membrane\", \"name\": \"lysosomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005765\"}], \"dbId\": 10040753, \"displayName\": \"Beta-galactosidases hydrolyse mobilized GM1 to mobilized GM2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10040716], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10040753], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}, {\"className\": \"Set\", \"consumedByEvent\": [10040753], \"dbId\": 10040726, \"displayName\": \"mobilized GM1 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"mobilized GM1\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9840644\", \"stIdVersion\": \"R-MMU-9840644.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Beta-galactosidases hydrolyse mobilized GM1 to mobilized GM2\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605637, \"displayName\": \"Gal [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Gal\", \"alpha-D-galactose\"], \"producedByEvent\": [10040753], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605637\", \"stIdVersion\": \"R-ALL-1605637.3\"}, {\"className\": \"Set\", \"dbId\": 10040730, \"displayName\": \"mobilized GM2 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"mobilized GM2\"], \"producedByEvent\": [10040753], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9840646\", \"stIdVersion\": \"R-MMU-9840646.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10100277, \"displayName\": \"PSAP(195-273) dimer:PE binds and mobilizes ligands\", \"followingEvent\": [10040753], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PSAP(195-273) dimer:PE binds and mobilizes ligands\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9840470\", \"stIdVersion\": \"R-MMU-9840470.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10040769, \"displayName\": \"GM2A binds and mobilizes ligands\", \"followingEvent\": [10040753], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GM2A binds and mobilizes ligands\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1605717\", \"stIdVersion\": \"R-MMU-1605717.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1605624\", \"stIdVersion\": \"R-MMU-1605624.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
