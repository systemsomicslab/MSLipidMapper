        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10048609], \"className\": \"CatalystActivity\", \"dbId\": 10048585, \"displayName\": \"glutathione peroxidase activity of GPX1/2/4 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10048609, \"displayName\": \"12S-HpETE is reduced to 12S-HETE by GPX1/2/4\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10048609], \"dbId\": 2142811, \"displayName\": \"12S-HpETE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"12S-HpETE\", \"12(S)-HPETE(1-)\", \"12(S)-HPETE\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142811\", \"stIdVersion\": \"R-ALL-2142811.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10048609, 10048609], \"dbId\": 29450, \"displayName\": \"GSH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GSH\", \"glutathionate(1-)\", \"Reduced glutathione\", \"glutathione\", \"5-L-Glutamyl-L-cysteinylglycine\", \"N-(N-gamma-L-Glutamyl-L-cysteinyl)glycine\", \"gamma-L-Glutamyl-L-cysteinyl-glycine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29450\", \"stIdVersion\": \"R-ALL-29450.5\"}, 29450], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"12S-HpETE is reduced to 12S-HETE by GPX1/2/4\", \"(12S)-hydroperoxy-(5Z,8Z,10E,14Z)-eicosatetraenoate + 2 glutathione => (12S)-hydroxy-(5Z,8Z,10E,14Z)-eicosatetraenoate + glutathione disulfide + H2O\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142678, \"displayName\": \"12S-HETE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"12S-HETE\", \"12(S)-HETE(1-)\", \"12(S)-HETE\"], \"producedByEvent\": [10048609], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142678\", \"stIdVersion\": \"R-ALL-2142678.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111745, \"displayName\": \"GSSG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GSSG\", \"glutathione disulfide(2-)\", \"oxidized glutathione\", \"glutathione disulfide\"], \"producedByEvent\": [10048609], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111745\", \"stIdVersion\": \"R-ALL-111745.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10048609], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10048607, \"displayName\": \"Arachidonate is oxidised to 12S-HpETE by ALOX12/15\", \"followingEvent\": [10048609], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Arachidonate is oxidised to 12S-HpETE by ALOX12/15\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate + O2 => (12S)-hydroperoxy-(5Z,8Z,10E,14Z)-eicosatetraenoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2161964\", \"stIdVersion\": \"R-MMU-2161964.1\"}]