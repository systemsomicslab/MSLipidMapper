        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10041529], \"className\": \"CatalystActivity\", \"dbId\": 10020649, \"displayName\": \"metalloendopeptidase activity of MBTPS2 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10041529, \"displayName\": \"S2P hydrolyzes SREBP1A,1C,2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10041529], \"dbId\": 10041525, \"displayName\": \"SREBF1A,1C,2 cleaved by S1P [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"SREBF1A,1C,2 cleaved by S1P\", \"SREBP1A,1C,2 cleaved by S1P\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1655726\", \"stIdVersion\": \"R-MMU-1655726.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"S2P hydrolyzes SREBP1A,1C,2\", \"S2P hydrolyzes SREBF1A,1C,2\"], \"output\": [{\"className\": \"Set\", \"dbId\": 100