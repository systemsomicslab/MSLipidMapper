      {
        "@value": "H2O [cytosol] + 3,7,24THCA-CoA [cytosol] + ATP [cytosol] => Pi [cytosol] + H+ [cytosol] + ADP [cytosol] + 3,7,24THCA-CoA [peroxisomal matrix]"
