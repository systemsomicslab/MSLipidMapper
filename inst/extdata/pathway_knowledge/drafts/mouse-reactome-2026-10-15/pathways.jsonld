    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10018812], \"className\": \"CatalystActivity\", \"dbId\": 10018795, \"displayName\": \"3-hydroxyacyl-CoA dehydratase activity of HSD17B4 dimer [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10018812, \"displayName\": \"HSD17B4 hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10018810], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10018812], \"dbId\": 390249, \"displayName\": \"trans-2,3-dehydrohexacosanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"trans-2,3-dehydrohexacosanoyl-CoA\", \"trans-2-hexacosenoyl-CoA(4-)\", \"trans-2-hexacosenoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390249\", \"stIdVersion\": \"R-ALL-390249.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10018812], \"dbId\": 141343, \"displayName\": \"H2O [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-141343\", \"stIdVersion\": \"R-ALL-141343.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B4 hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"(2E)-hexacosenoyl-CoA + H2O => (3R)-hydroxyhexacosanoyl-CoA\", \"trans-2,3-dehydrohexacosanoyl-CoA + H2O => 3-hydroxyhexacosanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 390248, \"displayName\": \"3-hydroxyhexacosanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3-hydroxyhexacosanoyl-CoA\", \"(R)-3-hydroxyhexacosanoyl-CoA(4-)\"], \"producedByEvent\": [10018812], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390248\", \"stIdVersion\": \"R-ALL-390248.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10018822, \"displayName\": \"ACOX1 oxidizes C26:0 CoA\", \"followingEvent\": [10018812], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACOX1 oxidizes C26:0 CoA\", \"hexacosanoyl-CoA + O2 => (2E)-hexacosenoyl-CoA + H2O2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-390256\", \"stIdVersion\": \"R-MMU-390256.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-390252\", \"stIdVersion\": \"R-MMU-390252.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at leas