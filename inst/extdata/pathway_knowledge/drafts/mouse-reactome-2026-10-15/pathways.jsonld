    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "S1P,SPAP [cytosol] => HXAL,HD2NAL [cytosol] + PETA [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10021783], \"className\": \"CatalystActivity\", \"dbId\": 10021781, \"displayName\": \"sphinganine-1-phosphate aldolase activity of PXLP-SGPL1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10021783, \"displayName\": \"PXLP-SGPL1 cleaves sphingoid-1-phosphates\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10021783], \"dbId\": 9844328, \"displayName\": \"S1P,SPAP [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"S1P,SPAP\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9844328\", \"stIdVersion\": \"R-ALL-9844328.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PXLP-SGPL1 cleaves sphingoid-1-phosphates\", \"sphinganine 1-phosphate => phosphoethanolamine + hexadecanal\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 428686, \"displayName\": \"PETA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PETA\", \"O-phosphoethanolamine\", \"phosphoethanolamine\", \"ethanolamine phosphate\"], \"producedByEvent\": [10021783], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428686\", \"stIdVersion\": \"R-ALL-428686.4\"}, {\"className\": \"Set\", \"dbId\": 9844327, \"displayName\": \"HXAL,HD2NAL [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"HXAL,HD2NAL\"], \"producedByEvent\": [10021783], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9844327\", \"stIdVersion\": \"R-ALL-9844327.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10021704, \"displayName\": \"SPHK1 phosphorylates sphingoid\", \"followingEvent\": [10021783], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SPHK1 phosphorylates sphingoid\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-428273\", \"stIdVersion\": \"R-MMU-428273.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10095933, \"displayName\": \"SPHK2 phosphorylates sphingoid\", \"followingEvent\": [10021783], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SPHK2 phosphorylates sphingoid\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9695949\", \"stIdVersion\": \"R-MMU-9695949.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-428681\", \"stIdVersion\": \"R-MMU-428681.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
