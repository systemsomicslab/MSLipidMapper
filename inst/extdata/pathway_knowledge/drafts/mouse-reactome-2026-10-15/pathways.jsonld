        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10026049], \"className\": \"CatalystActivity\", \"dbId\": 10026047, \"displayName\": \"fatty acid elongase activity of ELOVL1,2,3,5 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10026049, \"displayName\": \"ELOVL1,2,3,5 elongate AA-CoA and Mal-CoA to 3ODCT-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10026049], \"dbId\": 548819, \"displayName\": \"AA-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AA-CoA\", \"arachidonoyl-CoA(4-)\", \"arachidonoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-548819\", \"stIdVersion\": \"R-ALL-548819.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10026049], \"dbId\": 29508, \"displayName\": \"Mal-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Mal-CoA\", \"malonyl-CoA(5-)\", \"Malonyl coenzyme A\", \"malonyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29508\", \"stIdVersion\": \"R-ALL-29508.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10026049], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ELOVL1,2,3,5 elongate AA-CoA and Mal-CoA to 3ODCT-CoA\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoyl-CoA + H(+) + malonyl-CoA => (7Z,10Z,13Z,16Z)-3-oxodocosatetraenoyl-CoA + CO2 + CoA\", \"arachidonoyl-CoA + malonyl-CoA => 3-oxo-(7,10,13,16)-docosatetraenoyl-CoA + CO2 + CoASH\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 548816, \"displayName\": \"3ODCT-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3ODCT-CoA\", \"(7Z,10Z,13Z,16Z)-3-oxodocosatetraenoyl-CoA(4-)\", \"3-oxo-(7,10,13,16)-docosatetraenoyl-CoA\", \"(7Z,10Z,13Z,16Z)-3-oxodocosatetraenoyl-CoA\"], \"producedByEvent\": [10026049], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-548816\", \"stIdVersion\": \"R-ALL-548816.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10026049], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113528, \"displayName\": \"CO2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CO2\", \"carbon dioxide\"], \"producedByEvent\": [10026049], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113528\", \"stIdVersion\": \"R-ALL-113528.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10026089, \"displayName\": \"ACSL3,4 ligate CoA to AA to form AA-CoA\", \"followingEvent\": [10026049], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACSL3,4 ligate CoA to AA to form AA-CoA\", \"arachidonate + CoASH + ATP => arachidonoyl-CoA + AMP + pyrophosphate + H2O [ACSL4]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-548843\", \"stIdVersion\": \"R-MMU-548843.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-548800\", \"stIdVersion\": \"R-MMU-548800.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
