      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "PI(3,4)P2 [plasma membrane] + ATP [cytosol] => ADP [cytosol] + PI(3,4,5)P3 [plasma membrane]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10041623], \"className\": \"CatalystActivity\", \"dbId\": 10041621, \"displayName\": \"phosphatidylinositol kinase activity of PIP5K1A-C [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10041623, \"displayName\": \"PI(3,4)P2 is phosphorylated to PI(3,4,5)P3 by PIP5K1A-C at the plasma membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10041774], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10041623], \"dbId\": 202247, \"displayName\": \"PI(3,4)P2 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2\", \"1-phosphatidyl-1D-myo-inositol 3,4-bisphosphate\", \"1-phosphatidyl-1D-myo-inositol 3,4-bisphosphates\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-202247\", \"stIdVersion\": \"R-ALL-202247.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10041623], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2 is phosphorylated to PI(3,4,5)P3 by PIP5K1A-C at the plasma membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 179838, \"displayName\": \"PI(3,4,5)P3 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4,5)P3\", \"1-phosphatidyl-1D-myo-inositol 3,4,5-trisphosphate(7-)\", \"PIP3\", \"1-phosphatidyl-1D-myo-inositol 3,4,5-trisphosphate\", \"Phosphatidylinositol-3,4,5-trisphosphate\"], \"producedByEvent\": [10041623], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-179838\", \"stIdVersion\": \"R-ALL-179838.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [10041623], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10041774, \"displayName\": \"PI(3,4,5)P3 is dephosphorylated to PI(3,4)P2 by INPP5[2] at the plasma membrane\", \"followingEvent\": [10041623], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,4,5)P3 is dephosphorylated to PI(3,4)P2 by INPP5[2] at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1675949\", \"stIdVersion\": \"R-MMU-1675949.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10041880, \"displayName\": \"PI4P is phosphorylated to PI(3,4)P2 by PI3K3C[2] at the plasma membrane\", \"followingEvent\": [10041623], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI4P is phosphorylated to PI(3,4)P2 by PI3K3C[2] at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1676109\", \"stIdVersion\": \"R-MMU-1676109.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10041906, \"displayName\": \"PI3P is phosphorylated to PI(3,4)P2 by PIP4K2/5K1 at the plasma membrane\", \"followingEvent\": [10041623], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI3P is phosphorylated to PI(3,4)P2 by PIP4K2/5K1 at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1676145\", \"stIdVersion\": \"R-MMU-1676145.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1675773\", \"stIdVersion\": \"R-MMU-1675773.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
