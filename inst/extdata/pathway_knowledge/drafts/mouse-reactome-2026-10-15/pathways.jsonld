        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10068473], \"className\": \"CatalystActivity\", \"dbId\": 10068471, \"displayName\": \"palmitoyl-(protein) hydrolase activity of PPT1 [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 10068473, \"displayName\": \"PPT1 hydrolyses palmitoylated proteins\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10068473], \"dbId\": 5690533, \"displayName\": \"PALM:protein [lysosomal lumen]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"PALM:protein\"], \"schemaClass\": \"Complex\", \"stId\": \"R-ALL-5690533\", \"stIdVersion\": \"R-ALL-5690533.2\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10068473], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPT1 hydrolyses palmitoylated proteins\", \"H2O + S-hexadecanoyl-L-cysteinyl-(protein) => H(+) + hexadecanoate + L-cysteinyl-(protein)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 5690516, \"displayName\": \"PALM [lysosomal lumen]\