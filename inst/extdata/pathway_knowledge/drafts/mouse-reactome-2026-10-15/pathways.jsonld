      {
        "@value": "H+ [cytosol] + 5beta-cholesten-7alpha, 12alpha-diol-3-one [cytosol] + NADPH [cytosol] => NADP+ [cytosol] + 5beta-cholestan-3alpha,7alpha,12alpha-triol [cytosol]"
