    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "SPHM d18:1 [plasma membrane] + H2O [cytosol] => H+ [cytosol] + CERA [plasma membrane] + ChoP [plasma membrane]"
