        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10095930, \"displayName\": \"SPHK2 binds SPHK2 inhibitors\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10095930], \"dbId\": 10095926, \"displayName\": \"SPHK2 [cytosol]\", \"endCoordinate\": 654, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SPHK2\", \"Q9JIA7\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-428236\", \"stIdVersion\": \"R-MMU-428236.1\", \"startCoordinate\": 1}, {\"className\": \"Set\", \"consumedByEvent\": [10095930], \"dbId\": 9695954, \"displayName\": \"SPHK2 inhibitors [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"SPHK2 inhibitors\"], \"schemaClass\": \"CandidateSet\", \"stId\": \"R-ALL-9695954\", \"stIdVersion\": \"R-ALL-9695954.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SPHK2 binds SPHK2 inhibitors\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10095928, \"displayName\": \"SPHK2:SPHK2 inhibitors [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"SPHK2:SPHK2 inhibitors\"], \"producedByEvent\": [10095930], \"schemaClass\": \"Complex\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9695910\", \"stIdVersion\":