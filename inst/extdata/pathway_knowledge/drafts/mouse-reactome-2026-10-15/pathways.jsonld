    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "PSAP(195-273):Sulfatide:PE [lysosomal lumen] + H2O [lysosomal lumen] => GalCer [lysosomal lumen] + SO4(2-) [lysosomal lumen] + PSAP(195-273) dimer [lysosomal lumen] + H+ [lysosomal lumen] + PE 30,32,34 [lysosomal lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
