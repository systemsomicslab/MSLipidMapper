      {
        "@value": "O2 [endoplasmic reticulum lumen] + NADH [endoplasmic reticulum lumen] + LA-CoA [endoplasmic reticulum lumen] => H2O [endoplasmic reticulum lumen] + NAD+ [endoplasmic reticulum lumen] + GLA-CoA [endoplasmic reticulum lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10046937], \"className\": \"CatalystActivity\", \"dbId\": 10046905, \"displayName\": \"acyl-CoA 6-desaturase activity of FADS2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}], \"dbId\": 10046937, \"displayName\": \"Desaturation of Linoleoyl-CoA to gamma-linolenoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10046933], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10046937], \"dbId\": 2046063, \"displayName\": \"LA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LA-CoA\", \"linoleoyl-CoA(4-)\", \"linoleoyl-CoA (LA-CoA)\", \"linoleoyl-CoA\", \"(9Z,12Z)-Octadecadienoyl-CoA\", \"18:2(n-6)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046063\", \"stIdVersion\": \"R-ALL-2046063.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10046937], \"dbId\": 113534, \"displayName\": \"O2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113534\", \"stIdVersion\": \"R-ALL-113534.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10046937, 10046937], \"dbId\": 194697, \"displayName\": \"NADH [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194697\", \"stIdVersion\": \"R-ALL-194697.4\"}, 194697], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Desaturation of Linoleoyl-CoA to gamma-linolenoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2046042, \"displayName\": \"GLA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GLA-CoA\", \"gamma-linolenoyl-CoA\", \"gamma-linolenoyl-CoA (GLA-COA)\", \"octadecatrienoyl-CoA\", \"6Z,9Z,12Z-octadecatrienoyl-CoA\", \"18:3(n-6)\"], \"producedByEvent\": [10046937], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046042\", \"stIdVersion\": \"R-ALL-2046042.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113519, \"displayName\": \"H2O [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10046937, 10046937], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113519\", \"stIdVersion\": \"R-ALL-113519.3\"}, 113519, {\"className\": \"Chemical Compound\", \"dbId\": 194653, \"displayName\": \"NAD+ [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\"], \"producedByEvent\": [10046937, 10046937], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194653\", \"stIdVersion\": \"R-ALL-194653.5\"}, 194653], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10046941, \"displayName\": \"Activation of linoleic acid to linoleoyl-CoA\", \"followingEvent\": [10046937], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Activation of linoleic acid to linoleoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2046098\", \"stIdVersion\": \"R-MMU-2046098.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2046096\", \"stIdVersion\": \"R-MMU-2046096.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
