    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "PA [mitochondrial inner membrane] + CTP [mitochondrial matrix] => CDP-DAG [mitochondrial inner membrane] + PPi [mitochondrial matrix]"
