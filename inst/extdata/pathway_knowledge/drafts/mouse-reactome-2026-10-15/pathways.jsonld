    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10007213], \"className\": \"CatalystActivity\", \"dbId\": 10007211, \"displayName\": \"propanoyl-CoA C-acyltransferase activity of SCP2-1 [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10007213, \"displayName\": \"Thiolysis of 3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA yields choloyl-CoA (3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA) and propionyl CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10007407], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10007213], \"dbId\": 192339, \"displayName\": \"3a,7a,12a-trihydroxy-5b-cholest-24-one-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3a,7a,12a-trihydroxy-5b-cholest-24-one-CoA\", \"3alpha,7alpha,12alpha-trihydroxy-24-oxo-5beta-cholestan-26-oyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192339\", \"stIdVersion\": \"R-ALL-192339.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10007213], \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Thiolysis of 3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA yields choloyl-CoA (3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA) and propionyl CoA\", \"3alpha,7alpha,12alpha-trihydroxy-24-oxo-5beta-cholestan-26-oyl-CoA + CoA => choloyl-CoA + propanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192356, \"displayName\": \"choloyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"choloyl-CoA\", \"choloyl-CoA(4-)\", \"3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA\"], \"producedByEvent\": [10007213], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192356\", \"stIdVersion\": \"R-ALL-192356.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 192314, \"displayName\": \"propionyl CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"propionyl CoA\", \"propionyl-CoA(4-)\", \"propionyl-CoA\"], \"producedByEvent\": [10007213], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192314\", \"stIdVersion\": \"R-ALL-192314.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007425, \"displayName\": \"(24R, 25R) 3alpha,7alpha,12alpha,24-tetrahydroxy-5beta-cholestanoyl-CoA is oxidized to 3alpha,7alpha,12alpha-trihydroxy-5beta-cholest-24-one-CoA\", \"followingEvent\": [10007213], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"(24R, 25R) 3alpha,7alpha,12alpha,24-tetrahydroxy-5beta-cholestanoyl-CoA is oxidized to 3alpha,7alpha,12alpha-trihydroxy-5beta-cholest-24-one-CoA\", \"(24R,25R)-3alpha,7alpha,12alpha,24-tetrahydroxy-5beta-cholestan-26-oyl-CoA + NAD(+) = 3alpha,7alpha,12alpha-trihydroxy-24-oxo-5beta-cholestan-26-oyl-CoA + H(+) + NADH\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193455\", \"stIdVersion\": \"R-MMU-193455.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-192341\", \"stIdVersion\": \"R-MMU-192341.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inferen