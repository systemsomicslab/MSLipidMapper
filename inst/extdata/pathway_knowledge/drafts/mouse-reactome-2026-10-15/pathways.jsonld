    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10090101], \"className\": \"CatalystActivity\", \"dbId\": 10090099, \"displayName\": \"molecular carrier activity of GC:VD3 [extracellular region]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 10090101, \"displayName\": \"VD3 dissociates from GC\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10090101], \"dbId\": 10011935, \"displayName\": \"GC:VD3 [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GC:VD3\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-352339\", \"stIdVersion\": \"R-MMU-352339.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"VD3 dissociates from GC\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 10011933, \"displayName\": \"Gc [extracellular region]\", \"endCoordinate\": 474, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Gc\", \"GC\", \"P21614\"], \"producedByEvent\": [10090101], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-209886\", \"stIdVersion\": \"R-MMU-209886.1\", \"startCoordinate\": 17}, {\"className\": \"Chemical Compound\", \"dbId\": 209767, \"displayName\": \"VD3 [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"VD3\", \"calciol\", \"Vitamin D3\", \"Cholecalciferol\"], \"producedByEvent\": [10090101], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-209767\", \"stIdVersion\": \"R-ALL-209767.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10011938, \"displayName\": \"VD3 binds GC\", \"followingEvent\": [10090101], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"VD3 binds GC\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-209738\", \"stIdVersion\": \"R-MMU-209738.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8963851\", \"stIdVersion\": \"R-MMU-8963851.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
