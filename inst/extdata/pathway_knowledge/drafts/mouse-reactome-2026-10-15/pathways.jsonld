    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10039096], \"className\": \"CatalystActivity\", \"dbId\": 10039094, \"displayName\": \"phosphatidylcholine lysophospholipase A1 activity of PLA2(8) [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10039096, \"displayName\": \"2-acyl LPC is hydrolyzed to GPCho by PLA2[8]\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039096], \"dbId\": 975614, \"displayName\": \"2-acyl LPC [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2-acyl LPC\", \"2-acyl-sn-glycero-3-phosphocholine(1+)\", \"2-acyl-sn-glycero-3-phosphocholine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-975614\", \"stIdVersion\": \"R-ALL-975614.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10039096], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-acyl LPC is hydrolyzed to GPCho by PLA2[8]\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1498750, \"displayName\": \"GPCho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GPCho\", \"choline alfoscerate\", \"GroPCho\", \"Glycerol 3-phosphocholine\", \"glycerophosphocholine\"], \"producedByEvent\": [10039096], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498750\", \"stIdVersion\": \"R-ALL-1498750.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524021, \"displayName\": \"LCFA(-) [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [10039096], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524021\", \"stIdVersion\": \"R-ALL-1524021.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10039254, \"displayName\": \"PC is hydrolysed to 2-acyl LPC by PLA2[7]\", \"followingEvent\": [10039096], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PC is hydrolysed to 2-acyl LPC by PLA2[7]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1482862\", \"stIdVersion\": \"R-MMU-1482862.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10039227, \"displayName\": \"PC is hydrolyzed to 2-acyl LPC by PLA2G4C\", \"followingEvent\": [10039096], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PC is hydrolyzed to 2-acyl LPC by PLA2G4C\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1482827\", \"stIdVersion\": \"R-MMU-1482827.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1482612\", \"stIdVersion\": \"R-MMU-1482612.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and cave