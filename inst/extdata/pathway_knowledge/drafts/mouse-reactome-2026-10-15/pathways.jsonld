    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "Ppara [nucleoplasm] + RXRA [nucleoplasm] + Peroxisome Proliferator Receptor Element (PPRE) [nucleoplasm] => PPARA:RXRA heterodimer [nucleoplasm]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10019798], \"className\": \"CatalystActivity\", \"dbId\": 10019796, \"displayName\": \"RNA polymerase II cis-regulatory region sequence-specific DNA binding activity of RXRA [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10019798, \"displayName\": \"PPARA binds RXRA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10019795], \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10019798], \"dbId\": 879702, \"displayName\": \"Ppara [nucleoplasm]\", \"endCoordinate\": 468, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ppara\", \"Peroxisome proliferator-activated receptor alpha\", \"PPARA_MOUSE\", \"Ppara\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-879702\", \"stIdVersion\": \"R-MMU-879702.1\", \"startCoordinate\": 1}, {\"className\": \"OtherEntity\", \"consumedByEvent\": [10019798], \"dbId\": 422139, \"displayName\": \"Peroxisome Proliferator Receptor Element (PPRE) [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Peroxisome Proliferator Receptor Element (PPRE)\"], \"schemaClass\": \"OtherEntity\", \"stId\": \"R-ALL-422139\", \"stIdVersion\": \"R-ALL-422139.2\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10019798], \"dbId\": 10007047, \"displayName\": \"RXRA [nucleoplasm]\", \"endCoordinate\": 462, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"RXRA\", \"P28700\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-381319\", \"stIdVersion\": \"R-MMU-381319.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA binds RXRA\", \"PPARA binds RXRA forming PPARA:RXRA heterodimer at promoter of target gene\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10019756, \"displayName\": \"PPARA:RXRA heterodimer [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PPARA:RXRA heterodimer\"], \"producedByEvent\": [10019798], \"schemaClass\": \"Complex\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-400138\", \"stIdVersion\": \"R-MMU-400138.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10046333, \"displayName\": \"FABP1 transports fatty acids into the nucleus\", \"followingEvent\": [10019798], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FABP1 transports fatty acids into the nucleus\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2026996\", \"stIdVersion\": \"R-MMU-2026996.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-400204\", \"stIdVersion\": \"R-MMU-400204.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
