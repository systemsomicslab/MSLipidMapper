      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [9996613], \"className\": \"CatalystActivity\", \"dbId\": 9996597, \"displayName\": \"enoyl-CoA hydratase activity of Trifunctional Protein [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 9996613, \"displayName\": \"trans-Hexadec-2-enoyl-CoA+H2O => (S)-3-Hydroxyhexadecanoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [9996615], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9996613], \"dbId\": 77284, \"displayName\": \"trans-Hexadec-2-enoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"trans-Hexadec-2-enoyl-CoA\", \"(E)-hexadec-2-enoyl-CoA(4-)\", \"(E)-hexadec-2-enoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77284\", \"stIdVersion\": \"R-ALL-77284.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9996613], \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"trans-Hexadec-2-enoyl-CoA+H2O => (S)-3-Hydroxyhexadecanoyl-CoA\", \"(2E)-hexadecenoyl-CoA + H2O => (3S)-hydroxyhexadecanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 77300, \"displayName\": \"(S)-3-Hydroxyhexadecanoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(S)-3-Hydroxyhexadecanoyl-CoA\", \"(S)-3-hydroxypalmitoyl-CoA(4-)\", \"(S)-3-hydroxypalmitoyl-CoA\"], \"producedByEvent\": [9996613], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77300\", \"stIdVersion\": \"R-ALL-77300.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9996611, \"displayName\": \"palmitoyl-CoA+FAD => trans-Hexadec-2-enoyl-CoA+FADH2\", \"followingEvent\": [9996613], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"palmitoyl-CoA+FAD => trans-Hexadec-2-enoyl-CoA+FADH2\", \"oxidized (electron-transfer flavoprotein) + hexadecanoyl-CoA + H(+) => (2E)-hexadecenoyl-CoA + reduced (electron-transfer flavoprotein)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-77299\", \"stIdVersion\": \"R-MMU-77299.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-77301\", \"stIdVersion\": \"R-MMU-77301.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
