    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10100922], \"className\": \"CatalystActivity\", \"dbId\": 10100920, \"displayName\": \"beta-galactoside (CMP) alpha-2,3-sialyltransferase activity of ST3GAL5 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}], \"dbId\": 10100922, \"displayName\": \"ST3GAL5 transfers NeuNAc to ceramides\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10100922], \"dbId\": 9844855, \"displayName\": \"LacCer/GalCer/GA1/GA2 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"LacCer/GalCer/GA1/GA2\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9844855\", \"stIdVersion\": \"R-ALL-9844855.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10100922], \"dbId\": 727815, \"displayName\": \"CMP-Neu5Ac [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CMP-Neu5Ac\", \"CMP-N-acetyl-beta-neuraminate(2-)\", \"CMP-sialic acid\", \"CMP-N-acetyl-beta-neuraminic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-727815\", \"stIdVersion\": \"R-ALL-727815.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ST3GAL5 transfers NeuNAc to ceramides\"], \"output\": [{\"className\": \"Set\", \"dbId\": 9844871, \"displayName\": \"GM1/2/3/4 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GM1/2/3/4\"], \"producedByEvent\": [10100922], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9844871\", \"stIdVersion\": \"R-ALL-9844871.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 727810, \"displayName\": \"CMP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CMP\", \"cytidine 5'-monophosphate(2-)\", \"cytidine 5'-monophosphate\", \"cytidylic acid\", \"Cytidine-5'-monophosphate\"], \"producedByEvent\": [10100922], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-727810\", \"stIdVersion\": \"R-ALL-727810.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10100922], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10071539, \"displayName\": \"UGT8 transfers Gal from UDP-Gal to CERA\", \"followingEvent\": [10100922], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"UGT8 transfers Gal from UDP-Gal to CERA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6785933\", \"stIdVersion\": \"R-MMU-6785933.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10026480, \"displayName\": \"SLC35A1 exchanges CMP-Neu5Ac for CMP\", \"followingEvent\": [10100922], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC35A1 exchanges CMP-Neu5Ac for CMP\", \"CMP-N-acetyl-beta-neuraminate(in) + CMP(out) = CMP-N-acetyl-beta-neuraminate(out) + CMP(in)\", \"SLC35A1 mediates the antiport of CMP-sialic acid in exchange for CMP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-727807\", \"stIdVersion\": \"R-MMU-727807.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9844860\", \"stIdVersion\": \"R-MMU-9844860.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER