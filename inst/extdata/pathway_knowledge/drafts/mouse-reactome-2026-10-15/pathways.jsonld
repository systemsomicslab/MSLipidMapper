    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "trans-Tetradec-2-enoyl-CoA+H2O => (S)-3-Hydroxytetradecanoyl-CoA"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/curationStatus": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/Draft"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/directionality": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "trans-Tetradec-2-enoyl-CoA [mitochondrial matrix] + H2O [mitochondrial matrix] => (S)-3-Hydroxytetradecanoyl-CoA [mitochondrial matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [9996599], \"className\": \"CatalystActivity\", \"dbId\": 9996597, \"displayName\": \"enoyl-CoA hydratase activity of Trifunctional Protein [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 9996599, \"displayName\": \"trans-Tetradec-2-enoyl-CoA+H2O => (S)-3-Hydroxytetradecanoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [9996602], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9996599], \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9996599], \"dbId\": 77273, \"displayName\": \"trans-Tetradec-2-enoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"trans-Tetradec-2-enoyl-CoA\", \"trans-tetradec-2-enoyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77273\", \"stIdVersion\": \"R-ALL-77273.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"trans-Tetradec-2-enoyl-CoA+H2O => (S)-3-Hydroxytetradecanoyl-CoA\", \"(2E)-tetradecenoyl-CoA + H2O => (3S)-hydroxytetradecanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 77276, \"displayName\": \"(S)-3-Hydroxytetradecanoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(S)-3-Hydroxytetradecanoyl-CoA\", \"(S)-3-hydroxytetradecanoyl-CoA(4-)\"], \"producedByEvent\": [9996599], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77276\", \"stIdVersion\": \"R-ALL-77276.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9996596, \"displayName\": \"myristoyl-CoA+FAD => trans-tetradec-2-enoyl-CoA+FADH2\", \"followingEvent\": [9996599], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"myristoyl-CoA+FAD => trans-tetradec-2-enoyl-CoA+FADH2\", \"tetradecanoyl-CoA + oxidized (electron-transfer flavoprotein) + H(+) => (2E)-tetradecenoyl-CoA + reduced (electron-transfer flavoprotein)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-77274\", \"stIdVersion\": \"R-MMU-77274.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"MMU\", \"className\": \"Species\", \"dbId\": 48892, \"displayName\": \"Mus musculus\", \"name\": [\"Mus musculus\", \"M. musculus\", \"Mm\", \"house mouse\"], \"schemaClass\": \"Species\", \"taxId\": \"10090\"}], \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-77277\", \"stIdVersion\": \"R-MMU-77277.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
