<https://reactome.org/content/detail/R-MMU-1675780> a ns1:LipidReaction ;
    rdfs:label "PI is phosphorylated to PI4P by PI4K2A/B at the plasma membrane" ;
    ns1:curationStatus ns1:Draft ;
    ns1:directionality ns1:SourceForward ;
