    ns1:equation "NADPH [mitochondrial matrix] + CYP11A1:FDXR:FDX1,FDX1L (red.) [mitochondrial matrix] + H+ [mitochondrial matrix] + 20a,22b-DHCHOL [mitochondrial inner membrane] + O2 [mitochondrial matrix] => NADP+ [mitochondrial matrix] + ISCAL [mitochondrial matrix] + CYP11A1:FDXR:FDX1,FDX1L (ox.) [mitochondrial matrix] + PREG [mitochondrial matrix] + H2O [mitochondrial matrix]" ;
    ns1:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [10007389], \"className\": \"CatalystActivity\", \"dbId\": 10007337, \"displayName\": \"cholesterol monooxygenase (side-chain-cleaving) activity of CYP11A1:FDXR:FDX1,FDX1L (red.) [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 10007389, \"displayName\": \"CYP11A1 cleaves 20a,22b-DHCHOL\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10007389], \"dbId\": 193086, \"displayName\": \"20a,22b-DHCHOL [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"20a,22b-DHCHOL\", \"(20R,22R)-20,22-dihydroxycholesterol\", \"20alpha,22beta dihydroxycholesterol\"], \"referenceType\"