        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10996531, \"displayName\": \"SRD5A2 binds SRD5A2 inhibitors\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10996531], \"dbId\": 10996516, \"displayName\": \"Homologues of SRD5A2 [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Homologues of SRD5A2\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-469664-4\", \"stIdVersion\": \"R-CEL-469664-4.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10996531], \"dbId\": 9705798, \"displayName\": \"SRD5A2 inhibitors [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"SRD5A2 inhibitors\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9705798\", \"stIdVersion\": \"R-ALL-9705798.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SRD5A2 binds SRD5A2 inhibitors\"], \"output\": [{\"clas