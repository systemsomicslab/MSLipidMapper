    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10934768], \"className\": \"CatalystActivity\", \"dbId\": 10934586, \"displayName\": \"acyltransferase activity, transferring groups other than amino-acyl groups of BAAT [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10934768, \"displayName\": \"Chenodeoxycholoyl CoA reacts with glycine or taurine to form glycochenodeoxycholate or taurochenodeoxycholate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10934768], \"dbId\": 193472, \"displayName\": \"chenodeoxycholoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"chenodeoxycholoyl-CoA\", \"chenodeoxycholoyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193472\", \"stIdVersion\": \"R-ALL-193472.4\"}, {\"className\": \"Set\", \"consumedByEvent\": [10934768], \"dbId\": 193463, \"displayName\": \"Gly, TAU [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Gly, TAU\", \"glycine; taurine\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-193463\", \"stIdVersion\": \"R-ALL-193463.2\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\"