        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10986499], \"className\": \"CatalystActivity\", \"dbId\": 10986497, \"displayName\": \"phosphatidylinositol-4,5-bisphosphate 4-phosphatase activity of TMEM55B [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10986499, \"displayName\": \"PI(4,5)P2 is dephosphorylated to PI5P by TMEM55B in the nucleus\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10986499], \"dbId\": 6810412, \"displayName\": \"PI(4,5)P2 [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2\", \"1-phosphatidyl-1D-myo-inositol 4,5-bisphosphate(5-)\", \"1-phosphatidyl-1D-myo-inositol 4,5-bisphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6810412\", \"stIdVersion\": \"R-ALL-6810412.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10986499], \"dbId\": 113518, \"displayName\": \"H2O [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113518\", \"stIdVersion\": \"R-ALL-113518.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2 is dephosphorylated to PI5P by TMEM55B in the nucleus\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 113550, \"displayName\": \"Pi [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [10986499], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113550\", \"stIdVersion\": \"R-ALL-113550.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 6810408, \"displayName\": \"PI5P [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI5P\", \"1-phosphatidyl-1D-myo-inositol 5-phosphate(3-)\", \"1-phosphatidyl-1D-myo-inositol 5-phosphate\"], \"producedByEvent\": [10986499], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6810408\", \"stIdVersion\": \"R-ALL-6810408.5\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10986496, \"displayName\": \"TMEM55B translocates to the nucleus\", \"followingEvent\": [10986499], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TMEM55B translocates to the nucleus\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-6810392\", \"stIdVersion\": \"R-CEL-6810392.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CEL\", \"className\": \"Species\", \"dbId\": 68320, \"displayName\": \"Caenorhabditis elegans\", \"name\": [\"Caenorhabditis elegans\", \"C.elegans\", \"C. elegans\", \"Ce\"], \"schemaClass\": \"Species\", \"taxId\": \"6239\"}], \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-6810410\", \"stIdVersion\": \"R-CEL-6810410.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
