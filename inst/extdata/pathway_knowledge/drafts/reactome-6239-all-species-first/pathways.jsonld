e, \"maxDepth\": 1, \"name\": [\"(2S)-pristanoyl-CoA + O2 => trans-2,3-dehydropristanoyl-CoA + H2O2 (ACOX3)\", \"(2S)-pristanoyl-CoA + O2 => (2E)-pristenoyl-CoA + H2O2\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389894, \"displayName\": \"trans-2,3-dehydropristanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"trans-2,3-dehydropristanoyl-CoA\", \"(E)-2,3-didehydropristanoyl-CoA(4-)\", \"(E)-2,3-didehydropristanoyl-CoA\"], \"producedByEvent\": [10942665], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389894\", \"stIdVersion\": \"R-ALL-389894.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113575, \"displayName\": \"H2O2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O2\", \"hydrogen peroxide\"], \"producedByEvent\": [10942665], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113575\", \"stIdVersion\": \"R-ALL-113575.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10942667, \"displayName\": \"Isomerization of (2R)-pristanoyl-CoA to (2S)-pristanoyl-CoA\", \"followingEvent\": [10942665], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Isomerization of (2R)-pristanoyl-CoA to (2S)-pristanoyl-CoA\", \"(2R)-pristanoyl-CoA => (2S)-pristanoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-389897\", \"stIdVersion\": \"R-CEL-389897.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CEL\", \"className\": \"Species\", \"dbId\": 68320, \"displayName\": \"Caenorhabditis elegans\", \"name\": [\"Caenorhabditis elegans\", \"C.elegans\", \"C. elegans\", \"Ce\"], \"schemaClass\": \"Species\", \"taxId\": \"6239\"}], \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-389891\", \"stIdVersion\": \"R-CEL-389891.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
