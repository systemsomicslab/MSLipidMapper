    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "pristanate [peroxisomal matrix] + CoA-SH [peroxisomal matrix] + ATP [peroxisomal matrix] => PPi [peroxisomal matrix] + (2R) Pristanoyl-CoA [peroxisomal matrix] + AMP [peroxisomal matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10942566], \"className\": \"CatalystActivity\", \"dbId\": 10942564, \"displayName\": \"pristanate-CoA ligase activity of SLC27A2 [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10942566, \"displayName\": \"pristanate + CoA-SH + ATP => pristanoyl-CoA + AMP + pyrophosphate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10942667], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10942566], \"dbId\": 389573, \"displayName\": \"ATP [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389573\", \"stIdVersion\": \"R-ALL-389573.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10942566], \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10942566], \"dbId\": 6811612, \"displayName\": \"pristanate [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"pristanate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6811612\", \"stIdVersion\": \"R-ALL-6811612.2\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"pristanate + CoA-SH + ATP => pristanoyl-CoA + AMP + pyrophosphate\", \"2,6,10,14-tetramethylpentadecanoate + ATP + CoA => AMP + diphosphate + pristanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389620, \"displayName\": \"AMP [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AMP\", \"adenosine 5'-monophosphate(2-)\", \"adenosine 5'-monophosphate\"], \"producedByEvent\": [10942566], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389620\", \"stIdVersion\": \"R-ALL-389620.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 389569, \"displayName\": \"(2R) Pristanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(2R) Pristanoyl-CoA\", \"pristanoyl-CoA(4-)\", \"pristanoyl-CoA\"], \"producedByEvent\": [10942566], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389569\", \"stIdVersion\": \"R-ALL-389569.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 389593, \"displayName\": \"PPi [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"Pyrophosphate\", \"diphosphoric acid\"], \"producedByEvent\": [10942566], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389593\", \"stIdVersion\": \"R-ALL-389593.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10942542, \"displayName\": \"ALDH3A2-2 oxidizes pristanal to pristanate\", \"followingEvent\": [10942566], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALDH3A2-2 oxidizes pristanal to pristanate\", \"pristanal + NAD+ => pristanate + NADH + H+\", \"2,6,10,14-tetramethylpentadecanal + H2O + NAD(+) => 2,6,10,14-tetramethylpentadecanoate + 2 H(+) + NADH\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-389609\", \"stIdVersion\": \"R-CEL-389609.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CEL\", \"className\": \"Species\", \"dbId\": 68320, \"displayName\": \"Caenorhabditis elegans\", \"name\": [\"Caenorhabditis elegans\", \"C.elegans\", \"C. elegans\", \"Ce\"], \"schemaClass\": \"Species\", \"taxId\": \"6239\"}], \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-389632\", \"stIdVersion\": \"R-CEL-389632.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
