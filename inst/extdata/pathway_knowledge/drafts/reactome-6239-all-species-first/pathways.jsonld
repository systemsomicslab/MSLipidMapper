        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10928323], \"className\": \"CatalystActivity\", \"dbId\": 10928278, \"displayName\": \"(3S)-3-hydroxyacyl-CoA dehydrogenase (NAD+) activity of HADH dimer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10928323, \"displayName\": \"(S)-Hydroxybutanoyl-CoA+NAD => Acetoacetyl-CoA+NADH+H\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10928323], \"dbId\": 113526, \"displayName\": \"NAD+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\", \"NAD+ \"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113526\", \"stIdVersion\": \"R-ALL-113526.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10928323], \"dbId\": 77251, \"displayName\": \"3HB-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3HB-CoA\", \"(S)-3-hydroxybutanoyl-CoA(4-)\", \"(S)-3-hydroxybutanoyl-CoA\"], \"referenceType\"