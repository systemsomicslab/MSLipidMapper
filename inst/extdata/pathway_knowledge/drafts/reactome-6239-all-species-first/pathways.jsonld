      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + O2 [cytosol] + NADPH [cytosol] + ANDST [cytosol] => H+ [cytosol] + NADP+ [cytosol] + HCOOH [cytosol] + H2O [cytosol] + E1 [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10934722], \"className\": \"CatalystActivity\", \"dbId\": 10934720, \"displayName\": \"steroid hydroxylase activity of CYP19A1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10934722, \"displayName\": \"CYP19A1 hydroxylates ANDST to E1\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10934722], \"dbId\": 193079, \"displayName\": \"ANDST [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ANDST\", \"androst-4-ene-3,17-dione\", \"4-Androstene-3, 17-dione\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193079\", \"stIdVersion\": \"R-ALL-193079.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10934722, 10934722, 10934722], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, 29364, 29364, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10934722, 10934722, 10934722], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [10934722, 10934722, 10934722, 10934722], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, 70106, 70106, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10934722, 10934722, 10934722], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, 29368, 29368], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP19A1 hydroxylates ANDST to E1\", \"Androstenedione is converted to estrone by Aromatase (CYP19A1)\", \"androst-4-ene-3,17-dione + 3 O2 + 3 reduced (NADPH--hemoprotein reductase) => estrone + formate + 4 H(+) + 4 H2O + 3 oxidized (NADPH--hemoprotein reductase)\"], \"output\": [70106, 70106, 70106, 70106, {\"className\": \"Chemical Compound\", \"dbId\": 193066, \"displayName\": \"E1 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"E1\", \"estrone\"], \"producedByEvent\": [10934722], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193066\", \"stIdVersion\": \"R-ALL-193066.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [10934722, 10934722, 10934722], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}, 29366, 29366, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10934722, 10934722, 10934722, 10934722], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356, 29356, 29356, {\"className\": \"Chemical Compound\", \"dbId\": 29460, \"displayName\": \"HCOOH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HCOOH\", \"formate\", \"Formate\", \"formic acid\", \"Methanoic acid\"], \"producedByEvent\": [10934722], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29460\", \"stIdVersion\": \"R-ALL-29460.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CEL\", \"className\": \"Species\", \"dbId\": 68320, \"displayName\": \"Caenorhabditis elegans\", \"name\": [\"Caenorhabditis elegans\", \"C.elegans\", \"C. elegans\", \"Ce\"], \"schemaClass\": \"Species\", \"taxId\": \"6239\"}], \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-193060\", \"stIdVersion\": \"R-CEL-193060.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
