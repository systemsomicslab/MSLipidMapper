    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "17(S)-Hp-DHA [cytosol] + GSH [cytosol] => 17(S)-HDHA [cytosol] + H2O [cytosol] + GSSG [cytosol]"
