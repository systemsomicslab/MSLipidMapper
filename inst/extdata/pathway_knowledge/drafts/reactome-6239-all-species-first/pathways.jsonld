        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "(S)-3-Hydroxyhexadecanoyl-CoA [mitochondrial matrix] + NAD+ [mitochondrial matrix] => NADH [mitochondrial matrix] + 3-Oxopalmitoyl-CoA [mitochondrial matrix] + H+ [mitochondrial matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10928317], \"className\": \"CatalystActivity\", \"dbId\": 10928301, \"displayName\": \"(3S)-3-hydroxyacyl-CoA dehydrogenase (NAD+) activity of Trifunctional Protein [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10928317, \"displayName\": \"(S)-3-Hydroxyhexadecanoyl-CoA+NAD => 3-Oxopalmitoyl-CoA+NADH+H\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10928319], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10928317], \"dbId\": 77300, \"displayName\": \"(S)-3-Hydroxyhexadecanoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(S)-3-Hydroxyhexadecanoyl-CoA\", \"(S)-3-hydroxypalmitoyl-CoA(4-)\", \"(S)-3-hydroxypalmitoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77300\", \"stIdVersion\": \"R-ALL-77300.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10928317], \"dbId\": 113526, \"displayName\": \"NAD+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\", \"NAD+ \"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113526\", \"stIdVersion\": \"R-ALL-113526.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"(S)-3-Hydroxyhexadecanoyl-CoA+NAD => 3-Oxopalmitoyl-CoA+NADH+H\", \"(3S)-hydroxyhexadecanoyl-CoA + NAD(+) => 3-oxohexadecanoyl-CoA + NADH + H(+)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29362, \"displayName\": \"NADH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [10928317], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29362\", \"stIdVersion\": \"R-ALL-29362.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 77302, \"displayName\": \"3-Oxopalmitoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3-Oxopalmitoyl-CoA\", \"3-oxopalmitoyl-CoA(4-)\"], \"producedByEvent\": [10928317], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77302\", \"stIdVersion\": \"R-ALL-77302.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10928317], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10928315, \"displayName\": \"trans-Hexadec-2-enoyl-CoA+H2O => (S)-3-Hydroxyhexadecanoyl-CoA\", \"followingEvent\": [10928317], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"trans-Hexadec-2-enoyl-CoA+H2O => (S)-3-Hydroxyhexadecanoyl-CoA\", \"(2E)-hexadecenoyl-CoA + H2O => (3S)-hydroxyhexadecanoyl-CoA\"], \"releas