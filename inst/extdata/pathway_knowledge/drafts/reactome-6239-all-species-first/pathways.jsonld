        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10948846], \"className\": \"CatalystActivity\", \"dbId\": 10948844, \"displayName\": \"very-long-chain fatty acyl-CoA dehydrogenase activity of TECR,TECRL [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10948846, \"displayName\": \"TECR,TECRL dehydrogenate TOD-CoA to ST-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10978435], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10948846], \"dbId\": 548809, \"displayName\": \"TOD-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TOD-CoA\", \"trans-2-octadecenoyl-CoA(4-)\", \"trans-octadec-2-enoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-548809\", \"stIdVersion\": \"R-ALL-548809.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10948846], \"dbId\": 29364