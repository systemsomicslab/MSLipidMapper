        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10996056, \"displayName\": \"VDR agonists bind VDR\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10996056], \"dbId\": 10940899, \"displayName\": \"Homologues of VDR [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Homologues of VDR\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-375512-4\", \"stIdVersion\": \"R-CEL-375512-4.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10996056], \"dbId\": 9660116, \"displayName\": \"VDR agonists [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"VDR agonists\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9660116\", \"stIdVersion\": \"R-ALL-9660116.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"VDR agonists bind VDR\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10996054, \"displayName\": \"VDR:VDR agonists [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"VDR:VDR agonists\"], \"producedByEvent\": [10996056], \"schemaClass\": \"Complex\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-9660135\", \"stIdVersion\": \"R-CEL-9660135.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CEL\", \"className\": \"Species