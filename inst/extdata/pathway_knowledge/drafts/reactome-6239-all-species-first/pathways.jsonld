    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10945207], \"className\": \"CatalystActivity\", \"dbId\": 10945205, \"displayName\": \"protein serine/threonine kinase activity of CSNK1G2 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10945207, \"displayName\": \"CSNK1G2 phosphorylates p-CERT1-2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10945207, 10945207], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, 113592, {\"className\": \"Set\", \"consumedByEvent\": [10945207], \"dbId\": 10945164, \"displayName\": \"Homologues of p-S132-CERT1-2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Homologues of p-S132-CERT1-2\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-429704-3\", \"stIdVersion\": \"R-CEL-429704-3.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CSNK1G2 phosphorylates p-CERT1-2\", \"monophospho-CERT + 2 ATP => multiphospho-CERT + 2 ADP\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [10945207, 10945207], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, 29370, {\"className\": \"Set\", \"dbId\": 10945199, \"displayName\": \"Homologues of p-S,S132,T-CERT1-2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Homologues of p-S,S132,T-CERT1-2\"], \"producedByEvent\": [10945207], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-429695-3\", \"stIdVersion\": \"R-CEL-429695-3.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [10945207, 10945207], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, 70106], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10945189, \"displayName\": \"PRKD1,2,3 phosphorylates CERT1-2\", \"followingEvent\": [10945207], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PRKD1,2,3 phosphorylates CERT1-2\", \"CERT + ATP => monophospho-CERT + ADP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-429698\", \"stIdVersion\": \"R-CEL-429698.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CEL\", \"className\": \"Species\", \"dbId\": 68320, \"displayName\": \"Caenorhabditis elegans\", \"name\": [\"Caenorhabditis elegans\", \"C.elegans\", \"C. elegans\", \"Ce\"], \"schemaClass\": \"Species\", \"taxId\": \"6239\"}], \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-429714\", \"stIdVersion\": \"R-CEL-429714.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
