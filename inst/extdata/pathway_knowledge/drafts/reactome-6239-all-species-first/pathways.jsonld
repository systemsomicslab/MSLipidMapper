      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10926261], \"className\": \"CatalystActivity\", \"dbId\": 10926259, \"displayName\": \"succinyl-CoA:3-oxo-acid CoA-transferase activity of OXCT dimers [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10926261, \"displayName\": \"OXCT dimers transfer CoA from SUCC-CoA to ACA, forming ACA-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10926273], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10926261], \"dbId\": 73909, \"displayName\": \"ACA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ACA\", \"acetoacetic acid\", \"acetoacetate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-73909\", \"stIdVersion\": \"R-ALL-73909.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10926261], \"dbId\": 70958, \"displayName\": \"SUCC-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SUCC-CoA\", \"succinyl-CoA(5-)\", \"Succinyl coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70958\", \"stIdVersion\": \"R-ALL-70958.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"OXCT dimers transfer CoA from SUCC-CoA to ACA, forming ACA-CoA\", \"acetoacetate + succinyl-CoA <=> acetoacetyl-CoA + succinate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 73871, \"displayName\": \"ACA-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ACA-CoA\", \"acetoacetyl-CoA(4-)\", \"acetoacetyl-CoA\"], \"producedByEvent\": [10926261], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-73871\", \"stIdVersion\": \"R-ALL-73871.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113536, \"displayName\": \"SUCCA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SUCCA\", \"succinate(2-)\", \"Succinate\", \"succinic acid\", \"Butanedionic acid\", \"Ethylenesuccinic acid\"], \"producedByEvent\": [10926261], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113536\", \"stIdVersion\": \"R-ALL-113536.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CEL\", \"className\": \"Species\", \"dbId\": 68320, \"displayName\": \"Caenorhabditis elegans\", \"name\": [\"Caenorhabditis elegans\", \"C.elegans\", \"C. elegans\", \"Ce\"], \"schemaClass\": \"Species\", \"taxId\": \"6239\"}], \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-74177\", \"stIdVersion\": \"R-CEL-74177.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are