        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10958367], \"className\": \"CatalystActivity\", \"dbId\": 10958365, \"displayName\": \"sphingolipid activator protein activity of GM2A(32-193) [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}, {\"accession\": \"0097488\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 3828048, \"definition\": \"The lipid bilayer surrounding a multivesicular body internal vesicle.\", \"displayName\": \"multivesicular body, internal vesicle membrane\", \"name\": \"multivesicular body, internal vesicle membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0097488\"}], \"dbId\": 10958367, \"displayName\": \"GM2A binds and mobilizes ligands\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10958316], \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10958367], \"dbId\": 10958282, \"displayName\": \"mlt-8 [lysosomal lumen]\", \"endCoordinate\": 193, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"mlt-8\", \"GM2A(32-193)\", \"O02106\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-1605614\", \"stIdVersion\": \"R-CEL-1605614.1\", \"startCoordinate\": 32}, {\"className\": \"Set\", \"consumedByEvent\": [10958367], \"dbId\":