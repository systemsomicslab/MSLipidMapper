        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10991246], \"className\": \"CatalystActivity\", \"dbId\": 10991244, \"displayName\": \"acyl-L-homoserine-lactone lactonohydrolase activity of PON1,2,3:2xCa2+ dimers [extracellular region]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 10991246, \"displayName\": \"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10991246], \"dbId\": 8932801, \"displayName\": \"5-HETEL [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5-HETEL\", \"meadowlactone\", \"5-hydroxy-eicosatetraenoic acid 1,5-lactone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8932801\", \"stIdVersion\": \"R-ALL-8932801.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10991246], \"dbId\": 109276, \"displayName\": \"H2O [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109276\", \"s