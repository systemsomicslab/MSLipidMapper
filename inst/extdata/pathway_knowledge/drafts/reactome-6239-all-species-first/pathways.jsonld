    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "AA [cytosol] + ATP [cytosol] + CoA-SH [cytosol] => AMP [cytosol] + H2O [cytosol] + PPi [cytosol] + AA-CoA [cytosol]"
