    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "14(S)-HDHA [cytosol] + H+ [cytosol] + O2 [cytosol] + NADPH [cytosol] => 14(S),21(S/R)-diHDHA [cytosol] + NADP+ [cytosol] + H2O [cytosol]"
