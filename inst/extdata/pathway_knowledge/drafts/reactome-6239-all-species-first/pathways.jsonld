    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10990327], \"className\": \"CatalystActivity\", \"dbId\": 10990325, \"displayName\": \"molecular carrier activity of PLEKHA3,8 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}], \"dbId\": 10990327, \"displayName\": \"PLEKHA3,8 bind PI4P, ARF1\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10990327], \"dbId\": 10990322, \"displayName\": \"PLEKHA8 [Golgi membrane]\", \"endCoordinate\": 519, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PLEKHA8\", \"Q9BKS2\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-5216169\", \"stIdVersion\": \"R-CEL-5216169.1\", \"startCoordinate\": 1}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10990327], \"dbId\": 1806217, \"displayName\": \"PI4P [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI4P\", \"1-phosphatidyl-1D-myo-inositol 4-phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806217\", \"stIdVersion\": \"R-ALL-1806217.3\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10990327], \"dbId\": 10939401, \"displayName\": \"ARF1 [Golgi membrane]\", \"endCoordinate\": 181,