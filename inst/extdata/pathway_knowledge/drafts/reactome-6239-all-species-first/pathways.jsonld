        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10956419], \"className\": \"CatalystActivity\", \"dbId\": 10956417, \"displayName\": \"1-acylglycerol-3-phosphate O-acyltransferase activity of CRLS1 [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}, {\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10956419, \"displayName\": \"1-acyl LPG is acylated to PG by CRLS1 (IM)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10956419], \"dbId\": 1524027, \"displayName\": \"1-acyl LPG [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPG\", \"1-acyl-sn-glycero-3-phosphoglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524027\", \"stIdVersion\": \"R-ALL-1524027.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10956419], \"dbId\": 1524038, \"displayName\": \"acyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"acyl-CoA\", \"acyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524038\", \"stIdVersion\": \"R-ALL-1524038.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1-acyl LPG is acylated to PG by CRLS1 (IM)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1524042, \"displayName\": \"PG [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PG\", \"1,2-diacyl-sn-glycero-3-phospho-(1'-sn-glycerol)(1-)\", \"phosphatidylglycerol\"], \"producedByEvent\": [10956419], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524042\", \"stIdVersion\": \"R-ALL-1524042.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29374, \"displayName\": \"CoA-SH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"CoA\", \"coenzyme A\"], \"producedByEvent\": [10956419], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29374\", \"stIdVersion\": \"R-ALL-29374.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CEL\", \"className\": \"Species\", \"dbId\": 68320, \"displayName\": \"Caenorhabditis elegans\", \"name\": [\"Caenorhabditis elegans\", \"C.elegans\", \"C. elegans\", \"Ce\"], \"schemaClass\": \"Species\", \"taxId\": \"6239\"}], \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-1482689\", \"stIdVersion\": \"R-CEL-1482689.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has bee