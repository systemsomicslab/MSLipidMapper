        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10999010], \"className\": \"CatalystActivity\", \"dbId\": 10999008, \"displayName\": \"UDP-galactose:glucosylceramide beta-1,4-galactosyltransferase activity of B4GALT5/6 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}], \"dbId\": 10999010, \"displayName\": \"B4GALT5/6 transfer Gal to GlcCer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10999005], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10999010], \"dbId\": 735682, \"displayName\": \"UDP-Gal [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP-Gal\", \"UDP-alpha-D-galactose(2-)\", \"UDPgalactose\", \"UDP-D-galactose\", \"UDP-D-galactopyranose\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-735682\", \"stIdVersion\": \"R-ALL-735682.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\":