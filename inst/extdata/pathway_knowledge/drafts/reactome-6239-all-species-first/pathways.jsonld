    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10978850], \"className\": \"CatalystActivity\", \"dbId\": 10978848, \"displayName\": \"fatty acid amide hydrolase activity of FAAH2 [lipid droplet]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005811\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13977, \"definition\": \"An intracellular non-membrane-bounded organelle comprising a matrix of coalesced lipids surrounded by a phospholipid monolayer. May include associated proteins.\", \"displayName\": \"lipid droplet\", \"name\": \"lipid droplet\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005811\"}], \"dbId\": 10978850, \"displayName\": \"FAAH2 hydrolyses AEA to AA and ETA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10978850], \"dbId\": 5693752, \"displayName\": \"AEA [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AEA\", \"anandamide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5693752\", \"stIdVersion\": \"R-ALL-5693752.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10978850], \"dbId\": 5693747, \"displayName\": \"H2O [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5693747\", \"stIdVersion\": \"R-ALL-5693747.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FAAH2 hydrolyses AEA to AA and ETA\", \"H2O + N-(5Z,8Z,11Z,14Z-eicosatetraenoyl)-ethanolamine => (5Z,8Z,11Z,14Z)-eicosatetraeno