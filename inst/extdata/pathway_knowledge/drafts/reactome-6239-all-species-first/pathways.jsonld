    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "SREBP1A,1C,2:Importin beta-1 [nucleoplasm] + RAN:GTP [nucleoplasm] => Importin-beta:Ran GTP complex [nucleoplasm] + SREBP1A,1C,2 dimer [nucleoplasm]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10962958], \"className\": \"CatalystActivity\", \"dbId\": 10962956, \"displayName\": \"importin-alpha family protein binding activity of RAN:GTP [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10962958, \"displayName\": \"SREBP1A,1C,2:Importin beta-1 dissociates\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10962958], \"dbId\": 10958968, \"displayName\": \"SREBP1A,1C,2:Importin beta-1 [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"SREBP1A,1C,2:Importin beta-1\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-2065543\", \"stIdVersion\": \"R-CEL-2065543.1\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10962958], \"dbId\": 10962953, \"displayName\": \"RAN:GTP [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"RAN:GTP\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-180738\", \"stIdVersion\": \"R-CEL-180738.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SREBP1A,1C,2:Importin beta-1 dissociates\", \"SREBF1A,1C,2:Importin beta-1 dissociates\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10958966, \"displayName\": \"SREBP1A,1C,2 dimer [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"SREBP1A,1C,2 dimer\"], \"producedByEvent\": [10962958], \"schemaClass\": \"Complex\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-1655744\", \"stIdVersion\": \"R-CEL-1655744.1\"}, {\"className\": \"Complex\", \"dbId\": 10962955, \"displayName\": \"Importin-beta:Ran GTP complex [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"Importin-beta:Ran GTP complex\"], \"producedByEvent\": [10962958], \"schemaClass\": \"Complex\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-180719\", \"stIdVersion\": \"R-CEL-180719.1\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10958970, \"displayName\": \"SREBP1A,1C,2 translocates to the nucleus\", \"followingEvent\": [10962958], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SREBP1A,1C,2 translocates to the nucleus\", \"SREBF1A,1C,2 translocates to the nucleus\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-1655831\", \"stIdVersion\": \"R-CEL-1655831.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CEL\", \"className\": \"Species\", \"dbId\": 68320, \"displayName\": \"Caenorhabditis elegans\", \"name\": [\"Caenorhabditis elegans\", \"C.elegans\", \"C. elegans\", \"Ce\"], \"schemaClass\": \"Species\", \"taxId\": \"6239\"}], \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-2065539\", \"stIdVersion\": \"R-CEL-2065539.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
