        "@value": "H2O [lysosomal lumen] + GM2A:GM2 [lysosomal lumen] => GalNAc [lysosomal lumen] + mlt-8 [lysosomal lumen] + GM3 [lysosomal lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10958316], \"className\": \"CatalystActivity\", \"dbId\": 10958314, \"displayName\": \"beta-N-acetylhexosaminidase activity of bHEXA [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 10958316, \"displayName\": \"bHEXA hydrolyzes GM2A:GM2 to GM2A:GM3\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10958367], \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10958316], \"dbId\": 10958284, \"displayName\": \"GM2A:GM2 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GM2A:GM2\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-1605600\", \"stIdVersion\": \"R-CEL-1605600.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10958316], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"bHEXA hydrolyzes GM2A:GM2 to GM2A:GM3\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605658, \"displayName\": \"GalNAc [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GalNAc\", \"N-acetyl-D-galactosamine\", \"N-acetylgalactosamine\"], \"producedByEvent\": [10958316], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605658\", \"stIdVersion\": \"R-ALL-1605658.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1605641, \"displayName\": \"GM3 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GM3\", \"alpha-N-acetylneuraminosyl-(2->3)-beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1')-N-acylsphingosine(1-)\", \"GM3 ganglioside\", \"alpha-N-acetylneuraminosyl-(2->3)-beta-D-galactosyl-(1->4)-beta-D-glucosylceramide\", \"alpha-N-acetylneuraminyl-(2->3)-beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1')-ceramide\"], \"producedByEvent\": [10958316], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605641\", \"stIdVersion\": \"R-ALL-1605641.6\"}, {\"className\": \"Protein\", \"dbId\": 10958282, \"displayName\": \"mlt-8 [lysosomal lumen]\", \"endCoordinate\": 193, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"mlt-8\", \"GM2A(32-193)\", \"O02106\"], \"producedByEvent\": [10958316], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-1605614\", \"stIdVersion\": \"R-CEL-1605614.1\", \"startCoordinate\": 32}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10958367, \"displayName\": \"GM2A binds and mobilizes ligands\", \"followingEvent\": [10958316], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GM2A binds and mobilizes ligands\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-1605717\", \"stIdVersion\": \"R-CEL-1605717.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10958351, \"displayName\": \"Beta-galactosidases hydrolyse mobilized GM1 to mobilized GM2\", \"followingEvent\": [10958316], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Beta-galactosidases hydrolyse mobilized GM1 to mobilized GM2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-1605624\", \"stIdVersion\": \"R-CEL-1605624.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CEL\", \"className\": \"Species\", \"dbId\": 68320, \"displayName\": \"Caenorhabditis elegans\", \"name\": [\"Caenorhabditis elegans\", \"C.elegans\", \"C. elegans\", \"Ce\"], \"schemaClass\": \"Species\", \"taxId\": \"6239\"}], \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-1605595\", \"stIdVersion\": \"R-CEL-1605595.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
