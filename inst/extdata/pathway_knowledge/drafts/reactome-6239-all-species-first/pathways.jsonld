        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10942726], \"className\": \"CatalystActivity\", \"dbId\": 10942724, \"displayName\": \"ATPase-coupled transmembrane transporter activity of ABCD1 homodimer [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005778\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17947, \"definition\": \"The lipid bilayer surrounding a peroxisome.\", \"displayName\": \"peroxisomal membrane\", \"name\": \"peroxisomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005778\"}], \"dbId\": 10942726, \"displayName\": \"Peroxisomal uptake of very long-chain fatty acyl CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10942726], \"dbId\": 5695971, \"displayName\": \"VLCFA-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"VLCFA-CoA\", \"very long-chain fatty acyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5695971\", \"stIdVersion\": \"R-ALL-5695971.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10942726, 10942726], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10942726], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphospha