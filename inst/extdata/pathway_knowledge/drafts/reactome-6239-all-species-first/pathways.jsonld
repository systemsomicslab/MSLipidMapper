    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "BH4 [cytosol] + alkylglycerol [cytosol] + O2 [cytosol] => Glycerol [cytosol] + q-BH2 [cytosol] + fatty aldehyde [cytosol] + H2O [cytosol]"
