]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SPHM d18:1\", \"sphingomyelin d18:1\", \"sphingomyelins\", \"ceramide phosphocholines\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-429776\", \"stIdVersion\": \"R-ALL-429776.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ENPP7 hydrolyzes sphingomyelin\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 429807, \"displayName\": \"CERA [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CERA\", \"N-acylsphingoid\", \"ceramide\"], \"producedByEvent\": [10958942], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-429807\", \"stIdVersion\": \"R-ALL-429807.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1610735, \"displayName\": \"ChoP [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ChoP\", \"choline phosphate(1-)\", \"Choline phosphate\", \"phosphocholine\"], \"producedByEvent\": [10958942], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1610735\", \"stIdVersion\": \"R-ALL-1610735.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [10958942], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10945248, \"displayName\": \"SGMS2 transfers phosphocholine onto ceramide\", \"followingEvent\": [10958942], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SGMS2 transfers phosphocholine onto ceramide\", \"phosphatidylcholine + ceramide <=> sphingomyelin + diacylglycerol [SGMS2]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass