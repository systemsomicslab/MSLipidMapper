        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10934807], \"className\": \"CatalystActivity\", \"dbId\": 10934805, \"displayName\": \"bile acid transmembrane transporter activity of SLCO1B1 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10934807, \"displayName\": \"SLCO1B1 transports ALB:(GCCA,TCCA) from extracellular region to cytosol\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10934807], \"dbId\": 194117, \"displayName\": \"GCCA, TCCA [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GCCA, TCCA\", \"cholate bile salts\", \"glycocholate; taurocholate\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-194117\", \"stIdVersion\": \"R-ALL-194117.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLCO1B1 transports ALB:(GCCA,TCCA) from extracellular region to cytosol\", \"Transport (influx) of glycocholate and taurocholate by OATP-C\"], \"output\": [{\"className\": \"Set\", \"dbId\": 194097, \"displayName\": \"GCCA, TCCA [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GCCA, TCCA\", \"cholate bile salts\", \"glycocholate; taurocholate\"], \"producedByEvent\": [10934807], \"schemaClass\": \"DefinedSet\", \"st