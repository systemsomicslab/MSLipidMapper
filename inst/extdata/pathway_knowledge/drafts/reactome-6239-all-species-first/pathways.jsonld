      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10986332], \"className\": \"CatalystActivity\", \"dbId\": 10986330, \"displayName\": \"phosphatase activator activity of MTMR9 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10986332, \"displayName\": \"MTMR8 binds MTMR9\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10986332], \"dbId\": 10986322, \"displayName\": \"MTMR8 [cytosol]\", \"endCoordinate\": 704, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MTMR8\", \"G5ED68\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-1604671\", \"stIdVersion\": \"R-CEL-1604671.1\", \"startCoordinate\": 1}, {\"className\": \"Protein\", \"consumedByEvent\": [10986332], \"dbId\": 10986327, \"displayName\": \"mtm-9 [cytosol]\", \"endCoordinate\": 549, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"mtm-9\", \"MTMR9\", \"Q965W9\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-6809239\", \"stIdVersion\": \"R-CEL-6809239.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MTMR8 binds MTMR9\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10986329, \"displayName\": \"MTMR8:MTMR9 [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"MTMR8:MTMR9\"], \"producedByEvent\": [10986332], \"schemaClass\": \"Complex\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-6809252\", \"stIdVersion\": \"R-CEL-6809252.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CEL\", \"className\": \"Species\", \"dbId\": 68320, \"displayName\": \"Caenorhabditis elegans\", \"name\": [\"Caenorhabditis elegans\", \"C.elegans\", \"C. elegans\", \"Ce\"], \"schemaClass\": \"Species\", \"taxId\": \"6239\"}], \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-6809254\", \"stIdVersion\": \"R-CEL-6809254.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
