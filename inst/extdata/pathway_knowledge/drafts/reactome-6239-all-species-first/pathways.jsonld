    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "GDP-Fuc [Golgi lumen] + GM1,GA1 [Golgi membrane] => Fuc-GM1, Fuc-GA1 [Golgi membrane] + GDP [Golgi lumen] + H+ [Golgi lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10998994], \"className\": \"CatalystActivity\", \"dbId\": 10998992, \"displayName\": \"fucosyltransferase activity of FUT1,2 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}, {\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}], \"dbId\": 10998994, \"displayName\": \"FUT1,2 transfer fucose to gangliosides\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10998994], \"dbId\": 9846337, \"displayName\": \"GM1,GA1 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GM1,GA1\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9846337\", \"stIdVersion\": \"R-ALL-9846337.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10998994], \"dbId\": 205683, \"displayName\": \"GDP-Fuc [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GDP-Fuc\", \"GDP-beta-L-fucose(2-)\", \"GDP-L-fucose\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-205683\", \"stIdVersion\": \"R-ALL-205683.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FUT1,2 transfer fucose to gangliosides\"], \"output\": [{\"className\": \"Set\", \"dbId\": 9846331, \"displayName\": \"Fuc-GM1, Fuc-GA1 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Fuc-GM1, Fuc-GA1\"], \"producedByEvent\": [10998994], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9846331\", \"stIdVersion\": \"R-ALL-9846331.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 205689, \"displayName\": \"GDP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GDP\", \"GDP(3-)\"], \"producedByEvent\": [10998994], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-205689\", \"stIdVersion\": \"R-ALL-205689.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10998994], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10998989, \"displayName\": \"B3GALT4 transfers Gal to gangliosides\", \"followingEvent\": [10998994], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"B3GALT4 transfers Gal to gangliosides\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-9845516\", \"stIdVersion\": \"R-CEL-9845516.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CEL\", \"className\": \"Species\", \"dbId\": 68320, \"displayName\": \"Caenorhabditis elegans\", \"name\": [\"Caenorhabditis elegans\", \"C.elegans\", \"C. elegans\", \"Ce\"], \"schemaClass\": \"Species\", \"taxId\": \"6239\"}], \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-9846332\", \"stIdVersion\": \"R-CEL-9846332.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
