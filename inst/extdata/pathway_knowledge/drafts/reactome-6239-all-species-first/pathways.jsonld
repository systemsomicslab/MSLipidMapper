      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10956468], \"className\": \"CatalystActivity\", \"dbId\": 10956466, \"displayName\": \"A2-type glycerophospholipase activity of PLA2(5) [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10956468, \"displayName\": \"PC is hydrolyzed to 1-acyl LPC by PLA2[5]\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10956468], \"dbId\": 426925, \"displayName\": \"PC [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PC\", \"1,2-diacyl-sn-glycero-3-phosphocholine\", \"Phosphatidyl choline\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426925\", \"stIdVersion\": \"R-ALL-426925.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10956468], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": fals