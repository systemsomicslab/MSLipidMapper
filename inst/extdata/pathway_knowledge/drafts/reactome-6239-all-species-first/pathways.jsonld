        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10942706], \"className\": \"CatalystActivity\", \"dbId\": 10942704, \"displayName\": \"acetyl-CoA hydrolase activity of ACOT8 [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10942706, \"displayName\": \"acetyl-CoA + H2O => acetate + CoASH + H+\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10942706], \"dbId\": 353123, \"displayName\": \"Ac-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ac-CoA\", \"acetyl-CoA(4-)\", \"Acetyl coenzyme A\", \"acetyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-353123\", \"stIdVersion\": \"R-ALL-353123.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10942706], \"dbId\": 141343, \"displayName\": \"H2O [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-141343\", \"stIdVersion\": \"R-ALL-141343.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"acetyl-CoA + H2O => acetate + CoASH + H+\", \"acetyl-CoA + H2O => acetate