ity\", \"stId\": \"R-ALL-390440\", \"stIdVersion\": \"R-ALL-390440.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1-palmitoylglycerone phosphate + hexadecanol => O-hexadecylglycerone phosphate + palmitate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 390409, \"displayName\": \"GO3P [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GO3P\", \"1-alkylglycerone 3-phosphate(2-)\", \"O-hexadecylglycerone phosphate\", \"1-alkylglycerone 3-phosphate\", \"O-hexadecyldihydroxyacetone phosphate\", \"O-alkylglycerone phosphate\"], \"producedByEvent\": [10942737], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390409\", \"stIdVersion\": \"R-ALL-390409.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 390435, \"displayName\": \"PALM [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PALM\", \"hexadecanoate\", \"palmitate\"], \"producedByEvent\": [10942737], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390435\", \"stIdVersion\": \"R-ALL-390435.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10927353, \"displayName\": \"palmitoyl-CoA + DHAP => 1-palmitoylglycerone phosphate + CoASH\", \"followingEvent\": [10942737], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"palmitoyl-CoA + DHAP => 1-palmitoylglycerone phosphate + CoASH\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-75879\", \"stIdVersion\": \"R-CEL-75879.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10942370, \"displayName\": \"ABCD1-3 dimers transfer LCFAs from cytosol to peroxisomal matrix\", \"followingEvent\": [10942737], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ABCD1-3 dimers transfer LCFAs f