        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10991067], \"className\": \"CatalystActivity\", \"dbId\": 10991065, \"displayName\": \"galactosylgalactosylglucosylceramide beta-D-acetylgalactosaminyltransferase activity of B3GALNT1 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}, {\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}], \"dbId\": 10991067, \"displayName\": \"B3GALNT1 transfers GalNAc to Gb3Cer to form Gb4Cer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10991067], \"dbId\": 8879102, \"displayName\": \"Gb3Cer [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Gb3Cer\", \"alpha-D-galactosyl-(1->4)-beta-D-galactosyl-(1->4)-beta-D-glucosylceramide\", \"Globotriaosylceramide\", \"alpha-D-galactosyl-(1->4)-beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1)-ceramide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8879102\", \"stIdVersion\": \"R-ALL-8879102.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10991067], \"dbId\": 735700, \"displayName\": \"UDP-GalNAc [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP-GalNAc\", \"UDP-N-acetyl-D-galactosamine(2-)\", \"UDP--N-acetylgalactosamine\", \"UDP-N-acetyl-D-galactosamine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-735700\", \"stIdVersion\": \"R-ALL-735700.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"B3GALNT1 transfers GalNAc to Gb3Cer to form Gb4Cer\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8879101, \"displayName\": \"Gb4Cer [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Gb4Cer\", \"N-acetyl-beta-D-galactosaminyl-(1->3)-alpha-D-galactosyl-(1->4)-beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1')-ceramide\", \"N-acetyl-beta-D-galactosaminyl-(1->3)-alpha-D-galactosyl-(1->4)-beta-D-galactosyl-(1->4)-beta-D-glucosylceramide\"], \"producedByEvent\": [10991067], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8879101\", \"stIdVersion\": \"R-ALL-8879101.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 205687, \"displayName\": \"UDP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP\", \"UDP(3-)\", \"uridine 5'-diphosphate\"], \"producedByEvent\": [10991067], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-205687\", \"stIdVersion\": \"R-ALL-205687.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10991067], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"