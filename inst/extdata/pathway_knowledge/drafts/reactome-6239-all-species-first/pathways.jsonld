    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H2O [peroxisomal matrix] + trans-2,3-dehydropristanoyl-CoA [peroxisomal matrix] => 3-hydroxypristanoyl-CoA [peroxisomal matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10942670], \"className\": \"CatalystActivity\", \"dbId\": 10942668, \"displayName\": \"3-hydroxyacyl-CoA dehydratase activity of HSD17B4 dimer [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10942670, \"displayName\": \"trans-2,3-dehydropristanoyl-CoA + H2O => 3-hydroxypristanoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10942672], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10942670], \"dbId\": 389894, \"displayName\": \"trans-2,3-dehydropristanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"trans-2,3-dehydropristanoyl-CoA\", \"(E)-2,3-didehydropristanoyl-CoA(4-)\", \"(E)-2,3-didehydropristanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389894\", \"stIdVersion\": \"R-ALL-389894.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10942670], \"dbId\": 141343, \"displayName\": \"H2O [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-141343\", \"stIdVersion\": \"R-ALL-141343.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"trans-2,3-dehydropristanoyl-CoA + H2O => 3-hydroxypristanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389982, \"displayName\": \"3-hydroxypristanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3-hydroxypristanoyl-CoA\"], \"producedByEvent\": [10942670], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389982\", \"stIdVersion\": \"R-ALL-389982.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10942655, \"displayName\": \"ACOX2:FAD, ACOXL:FAD oxidise (2S)-pristanoyl-CoA to trans-2,3-dehydropristanoyl-CoA\", \"followingEvent\": [10942670], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACOX2:FAD, ACOXL:FAD oxidise (2S)-pristanoyl-CoA to trans-2,3-dehydropristanoyl-CoA\", \"(2S)-pristanoyl-CoA + O2 => (2E)-pristenoyl-CoA + H2O2\", \"(2S)-pristanoyl-CoA + O2 => trans-2,3-dehydropristanoyl-CoA + H2O2 (ACOX2)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-389889\", \"stIdVersion\": \"R-CEL-389889.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10942665, \"displayName\": \"(2S)-pristanoyl-CoA + O2 => trans-2,3-dehydropristanoyl-CoA + H2O2 (ACOX3)\", \"followingEvent\": [10942670], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"(2S)-pristanoyl-CoA + O2 => trans-2,3-dehydropristanoyl-CoA + H2O2 (ACOX3)\", \"(2S)-pristanoyl-CoA + O2 => (2E)-pristenoyl-CoA + H2O2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-389891\", \"stIdVersion\": \"R-CEL-389891.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CEL\", \"className\": \"Species\", \"dbId\": 68320, \"displayName\": \"Caenorhabditis elegans\", \"name\": [\"Caenorhabditis elegans\", \"C.elegans\", \"C. elegans\", \"Ce\"], \"schemaClass\": \"Species\", \"taxId\": \"6239\"}], \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-389986\", \"stIdVersion\": \"R-CEL-389986.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
