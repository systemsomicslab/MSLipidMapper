    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [10928577], \"className\": \"CatalystActivity\", \"dbId\": 10928575, \"displayName\": \"oxidoreductase activity, acting on NAD(P)H of DECR1 tetramer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10928577, \"displayName\": \"Reduction of 2-trans-4-cis-decadienoyl-CoA to form 3-trans-decenoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0006635\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 20426, \"definition\": \"A fatty acid oxidation process that results in the complete oxidation of a long-chain fatty acid. Fatty acid beta-oxidation begins with the addition of coenzyme A to a fatty acid, and occurs by successive cycles of reactions during each of which the fatty acid is shortened by a two-carbon fragment removed as acetyl coenzyme A; the cycle continues until only two or three carbons remain (as acetyl-CoA or propionyl-CoA respectively).\", \"displayName\": \"fatty acid beta-oxidation\", \"name\": \"fatty acid beta-oxidation\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006635\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10928577], \"dbId\": 109990, \"displayName\": \"2-trans-4-cis-decadienoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2-trans-4-cis-decadienoyl-CoA\", \"(2E,4Z)-deca-2,4-dienoyl-CoA(4-)\", \"(2-trans,4-cis)-deca-2,4-dienoyl-CoA\", \"(2E,4Z)-deca-2,4-dienoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109990\", \"stIdVersion\": \"R-ALL-109990.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10928577], \"dbId\": 29362, \"displayName\": \"NADH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29362\", \"stIdVersion\": \"R-ALL-29362.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10928577], \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Reduction of 2-trans-4-cis-decadienoyl-CoA to form 3-trans-decenoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 109994, \"displayName\": \"3-trans-decenoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3-trans-decenoyl-CoA\", \"trans-dec-3-enoyl-CoA(4-)\", \"trans-dec-3-enoyl-CoA\"], \"producedByEvent\": [10928577], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109994\", \"stIdVersion\": \"R-ALL-109994.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113526, \"displayName\": \"NAD+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\":