    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "VLCFA [peroxisomal matrix] + CoA-SH [peroxisomal matrix] + ATP [peroxisomal matrix] => PPi [peroxisomal matrix] + AMP [peroxisomal matrix] + VLCFA-CoA [peroxisomal matrix]"
      }
