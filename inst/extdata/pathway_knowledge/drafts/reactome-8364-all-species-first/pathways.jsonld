    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "Phytanoyl-CoA [peroxisomal matrix] + O2 [peroxisomal matrix] + 2OG [peroxisomal matrix] => SUCCA [peroxisomal matrix] + 3S2HPhy-CoA [peroxisomal matrix] + CO2 [peroxisomal matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10678940], \"className\": \"CatalystActivity\", \"dbId\": 10678938, \"displayName\": \"phytanoyl-CoA dioxygenase activity of PHYH:Fe++ [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10678940, \"displayName\": \"phytanoyl-CoA + 2-oxoglutarate + O2 => 2-hydroxyphytanoyl-CoA + succinate + CO2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10678923], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10678940], \"dbId\": 389615, \"displayName\": \"Phytanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Phytanoyl-CoA\", \"phytanoyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389615\", \"stIdVersion\": \"R-ALL-389615.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10678940], \"dbId\": 389537, \"displayName\": \"2OG [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2OG\", \"2-oxoglutarate(2-)\", \"2-Oxoglutarate\", \"2-oxoglutaric acid\", \"Oxoglutaric acid\", \"2-Ketoglutaric acid\", \"alpha-Ketoglutaric acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389537\", \"stIdVersion\": \"R-ALL-389537.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10678940], \"dbId\": 113535, \"displayName\": \"O2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113535\", \"stIdVersion\": \"R-ALL-113535.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"phytanoyl-CoA + 2-oxoglutarate + O2 => 2-hydroxyphytanoyl-CoA + succinate + CO2\", \"2-oxoglutarate + O2 + phytanoyl-CoA => 2-hydroxyphytanoyl-CoA + CO2 + succinate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389594, \"displayName\": \"3S2HPhy-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3S2HPhy-CoA\", \"2-hydroxyphytanoyl-CoA(4-)\", \"2-hydroxyphytanoyl-CoA\"], \"producedByEvent\": [10678940], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389594\", \"stIdVersion\": \"R-ALL-389594.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 389583, \"displayName\": \"SUCCA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SUCCA\", \"succinate(2-)\", \"Succinate\", \"succinic acid\", \"Butanedionic acid\", \"Ethylenesuccinic acid\"], \"producedByEvent\": [10678940], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389583\", \"stIdVersion\": \"R-ALL-389583.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 389536, \"displayName\": \"CO2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CO2\", \"carbon dioxide\"], \"producedByEvent\": [10678940], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389536\", \"stIdVersion\": \"R-ALL-389536.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10678903, \"displayName\": \"isocitrate + NADP+ => 2-oxoglutarate + CO2 + NADPH + H+\", \"followingEvent\": [10678940], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"isocitrate + NADP+ => 2-oxoglutarate + CO2 + NADPH + H+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-389550\", \"stIdVersion\": \"R-XTR-389550.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10678928, \"displayName\": \"phytanate + CoA-SH + ATP => phytanoyl-CoA + AMP + pyrophosphate\", \"followingEvent\": [10678940], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"phytanate + CoA-SH + ATP => phytanoyl-CoA + AMP + pyrophosphate\", \"3,7,11,15-tetramethylhexadecanoate + ATP + CoA => AMP + diphosphate + phytanoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-389622\", \"stIdVersion\": \"R-XTR-389622.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-389639\", \"stIdVersion\": \"R-XTR-389639.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
