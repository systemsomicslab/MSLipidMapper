      {
        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10729849, \"displayName\": \"SPHK2 binds SPHK2 inhibitors\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10729849], \"dbId\": 10729845, \"displayName\": \"sphk2 [cytosol]\", \"endCoordinate\": 654, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"sphk2\", \"SPHK2\", \"A0A6I8R2W0\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-428236\", \"stIdVersion\": \"R-XTR-428236.1\", \"startCoordinate\": 1}, {\"className\": \"Set\", \"consumedByEvent\": [10729849], \"dbId\": 9695954, \"displayName\": \"SPHK2 inhibitors [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"SPHK2 inhibitors\"], \"schemaClass\": \"CandidateSet\", \"stId\": \"R-ALL-9695954\", \"stIdVersion\": \"R-ALL-9695954.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SPHK2 binds SPHK2 inhibitors\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10729847, \"displayName\": \"SPHK2:SPHK2 inhibitors [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"SPHK2:SPHK2 inhibitors\"], \"producedByEvent\": [10729849], \"schemaClass\": \"Complex\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9695910\", \"stIdVersion\": \"R-XTR-9695910.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9695917\", \"stIdVersion\": \"R-XTR-9695917.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a h