      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10670812], \"className\": \"CatalystActivity\", \"dbId\": 10670810, \"displayName\": \"hydroxymethylglutaryl-CoA reductase (NADPH) activity of HMGCR dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10670812, \"displayName\": \"HMGCR dimer reduces bHMG-CoA to MVA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10670812], \"dbId\": 191374, \"displayName\": \"bHMG-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"bHMG-CoA\", \"(3S)-3-hydroxy-3-methylglutaryl-CoA(5-)\", \"beta-hydroxy-beta-methylglutaryl-CoA\", \"(3S)-3-hydroxy-3-methylglutaryl-CoA\", \"3-hydroxy-3-methylglutaryl-CoA\", \"HMG-CoA\", \"HMG-C0A(5-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191374\", \"stIdVersion\": \"R-ALL-191374.5