        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10679047], \"className\": \"CatalystActivity\", \"dbId\": 10679045, \"displayName\": \"pristanoyl-CoA oxidase activity of ACOX2:FAD, ACOXL:FAD [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10679047, \"displayName\": \"ACOX2:FAD, ACOXL:FAD oxidise (2S)-pristanoyl-CoA to trans-2,3-dehydropristanoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10679047], \"dbId\": 389893, \"displayName\": \"(2S) Pristanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(2S) Pristanoyl-CoA\", \"(2S)-pristanoyl-CoA(4-)\", \"(2S)-pristanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389893\", \"stIdVersion\": \"R-ALL-389893.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10679047], \"dbId\": 113535, \"displayName\": \"O2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113535\", \"stIdVersion\": \"R-ALL-113535.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACOX2:FAD, ACOXL:FAD oxidise (2S)-pristanoyl-CoA to trans-2,3-dehydropristanoyl-CoA\", \"(2S)-pristanoyl-CoA + O2 => (2E)-pristenoyl-CoA + H2O2\", \"(2S)-pristanoyl-CoA + O2 => trans-2,3-dehydropristanoyl-CoA + H2O2 (ACOX2)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389894, \"displayName\": \"trans-2,3-dehydropristanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"trans-2,3-dehydropristanoyl-CoA\", \"(E)-2,3-didehydropristanoyl-CoA(4-)\", \"(E)-2,3-didehydropristanoyl-CoA\"], \"producedByEvent\": [10679047], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389894\", \"stIdVersion\": \"R-ALL-389894.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113575, \"displayName\": \"H2O2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O2\", \"hydrogen peroxide\"], \"producedByEvent\": [10679047], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113575\", \"stIdVersion\": \"R-ALL-113575.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10679058, \"displayName\": \"Isomerization of (2R)-pristanoyl-CoA to (2S)-pristanoyl-CoA\", \"followingEvent\": [10679047], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Isomerization of (2R)-pristanoyl-CoA to (2S)-pristanoyl-CoA\", \"(2R)-pristanoyl-CoA => (2S)-pristanoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-389897\", \"stIdVersion\": \"R-XTR-389897.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8