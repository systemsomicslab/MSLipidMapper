    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "CYP11A1:FDXR:FDX1,FDX1L (red.) [mitochondrial matrix] + NADPH [mitochondrial matrix] + 20a,22b-DHCHOL [mitochondrial inner membrane] + H+ [mitochondrial matrix] + O2 [mitochondrial matrix] => PREG [mitochondrial matrix] + NADP+ [mitochondrial matrix] + H2O [mitochondrial matrix] + CYP11A1:FDXR:FDX1,FDX1L (ox.) [mitochondrial matrix] + ISCAL [mitochondrial matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10671210], \"className\": \"CatalystActivity\", \"dbId\": 10671160, \"displayName\": \"cholesterol monooxygenase (side-chain-cleaving) activity of CYP11A1:FDXR:FDX1,FDX1L (red.) [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 10671210, \"displayName\": \"CYP11A1 cleaves 20a,22b-DHCHOL\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671210], \"dbId\": 193086, \"displayName\": \"20a,22b-DHCHOL [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"20a,22b-DHCHOL\", \"(20R,22R)-20,22-dihydroxycholesterol\", \"20alpha,22beta dihydroxycholesterol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193086\", \"stIdVersion\": \"R-ALL-193086.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671210], \"dbId\": 113533, \"displayName\": \"O2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113533\", \"stIdVersion\": \"R-ALL-113533.4\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10671210, 10671210], \"dbId\": 10671159, \"displayName\": \"CYP11A1:FDXR:FDX1,FDX1L (red.) [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"CYP11A1:FDXR:FDX1,FDX1L (red.)\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-5580249\", \"stIdVersion\": \"R-XTR-5580249.1\"}, 10671159, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671210, 10671210], \"dbId\": 113600, \"displayName\": \"NADPH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113600\", \"stIdVersion\": \"R-ALL-113600.4\"}, 113600, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671210, 10671210], \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}, 113529], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP11A1 cleaves 20a,22b-DHCHOL\", \"(20R,22R)-20,22-dihydroxycholesterol + 2 H(+) + O2 + 2 reduced (adrenodoxin) => 4-methylpentanal + 2 H2O + 2 oxidized (adrenodoxin) + pregnenolone\", \"20alpha,22beta-hydroxycholesterol is cleaved by CYP11A1 to yield pregnenolone and isocaproaldehyde\", \"20alpha,22beta-hydroxycholesterol + NADPH + H+ + O2 => pregnenolone + isocaproaldehyde + NADP+ + H2O\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193164, \"displayName\": \"PREG [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PREG\", \"pregnenolone\"], \"producedByEvent\": [10671210], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193164\", \"stIdVersion\": \"R-ALL-193164.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193046, \"displayName\": \"ISCAL [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ISCAL\", \"4-methylpentanal\", \"Isocaproic aldehyde\", \"isocaproaldehyde\"], \"producedByEvent\": [10671210], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193046\", \"stIdVersion\": \"R-ALL-193046.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10671210, 10671210], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}, 113521, {\"className\": \"Complex\", \"dbId\": 10671208, \"displayName\": \"CYP11A1:FDXR:FDX1,FDX1L (ox.) [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"CYP11A1:FDXR:FDX1,FDX1L (ox.)\"], \"producedByEvent\": [10671210, 10671210], \"schemaClass\": \"Complex\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-5580259\", \"stIdVersion\": \"R-XTR-5580259.1\"}, 10671208, {\"className\": \"Chemical Compound\", \"dbId\": 113563, \"displayName\": \"NADP+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [10671210, 10671210], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113563\", \"stIdVersion\": \"R-ALL-113563.6\"}, 113563], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10671187, \"displayName\": \"Oxidation of 22beta-hydroxycholesterol to 20alpha,22beta-hydroxycholesterol\", \"followingEvent\": [10671210], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Oxidation of 22beta-hydroxycholesterol to 20alpha,22beta-hydroxycholesterol\", \"22beta-hydroxycholesterol + NADPH + H+ + O2 => 20alpha,22beta-hydroxycholesterol + NADP+ + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-193065\", \"stIdVersion\": \"R-XTR-193065.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-193101\", \"stIdVersion\": \"R-XTR-193101.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
