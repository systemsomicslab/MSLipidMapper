        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10732915], \"className\": \"CatalystActivity\", \"dbId\": 10732913, \"displayName\": \"cerebroside-sulfatase activity of active ARSA:Ca2+ [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 10732915, \"displayName\": \"ARSA removes sulfate from SM3\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10732915], \"dbId\": 9840879, \"displayName\": \"SM3 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SM3\", \"beta-D-3-sulfogalactosyl-(1->4)-beta-D-glucosyl-(1<->1')-ceramide(1-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9840879\", \"stIdVersion\": \"R-ALL-9840879.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10732915], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARSA removes sulfate from SM3\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605601, \"displayName\": \"LacCer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LacCer\", \"beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1)-N-acylsphingoid\", \"Lactosylceramide\", \"beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1)-N-acylsphingosine\", \"beta-D-Galactosyl-1,4-beta-D-glucosylceramide\"], \"producedByEvent\": [10732915], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605601\", \"stIdVersion\": \"R-ALL-1605601.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1606845, \"displayName\": \"SO4(2-) [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SO4(2-)\", \"sulfate\"], \"producedByEvent\": [10732915], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1606845\", \"stIdVersion\": \"R-ALL-1606845.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10697191, \"displayName\": \"M6PR transports activated ARSA to the lysosome\", \"followingEvent\": [10732915], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"M6PR transports activated ARSA to the lysosome\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-2248891\", \"stIdVersion\": \"R-XTR-2248891.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9840949\", \"stIdVersion\": \"R-XTR-9840949.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
