    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "ICS-CoA [cytosol] + H+ [cytosol] + Mal-CoA [cytosol] => CoA-SH [cytosol] + 3ODC-CoA [cytosol] + CO2 [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10684363], \"className\": \"CatalystActivity\", \"dbId\": 10684361, \"displayName\": \"fatty acid elongase activity of ELOVL7 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10684363, \"displayName\": \"ELOVL7 elongates ICS-CoA and Mal-CoA to 3ODC-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10684363], \"dbId\": 548794, \"displayName\": \"ICS-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ICS-CoA\", \"icosanoyl-CoA(4-)\", \"arachidoyl-CoA\", \"icosanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-548794\", \"stIdVersion\": \"R-ALL-548794.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10684363], \"dbId\": 29508, \"displayName\": \"Mal-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Mal-CoA\", \"malonyl-CoA(5-)\", \"Malonyl coenzyme A\", \"malonyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29508\", \"stIdVersion\": \"R-ALL-29508.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10684363], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ELOVL7 elongates ICS-CoA and Mal-CoA to 3ODC-CoA\", \"eicosanoyl-CoA + H(+) + malonyl-CoA => 3-oxodocosanoyl-CoA + CO2 + CoA\", \"arachidoyl-CoA + malonyl-CoA => 3-oxobehenoyl-CoA + CO2 + CoASH [ELOVL7]\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10684363], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113528, \"displayName\": \"CO2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CO2\", \"carbon dioxide\"], \"producedByEvent\": [10684363], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113528\", \"stIdVersion\": \"R-ALL-113528.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 548829, \"displayName\": \"3ODC-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3ODC-CoA\", \"3-oxodocosanoyl-CoA(4-)\", \"3-oxobehenoyl-CoA\", \"3-oxodocosanoyl-CoA\"], \"producedByEvent\": [10684363], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-548829\", \"stIdVer