    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "NAD+ [mitochondrial matrix] + (S)-Hydroxydecanoyl-CoA [mitochondrial matrix] => NADH [mitochondrial matrix] + 3-Oxodecanoyl-CoA [mitochondrial matrix] + H+ [mitochondrial matrix]"
