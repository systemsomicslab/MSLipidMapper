        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10734098], \"className\": \"CatalystActivity\", \"dbId\": 10696319, \"displayName\": \"epoxide hydrolase activity of EPHX2 dimer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10734098, \"displayName\": \"14,15-EET is hydrolysed to 14,15-DHET by EPHX2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10734098], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10734098], \"dbId\": 2142792, \"displayName\": \"14,15-EET [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"14,15-EET\", \"14,15-EET(1-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142792\", \"stIdVersion\": \"R-ALL-2142792.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"14,15-EET is hydrolysed to 14,15-DHET by EPHX2\", \"14,15-epoxy-(5Z,8Z,11Z)-eicosatrienoate + H2O => 14,15-dihydroxy-(5Z,8Z,11Z)-eicosatrienoate\"], \"output\": [{\"