    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "ATP [cytosol] + CoA-SH [cytosol] + THCA [cytosol] => 25(R) THCA-CoA [cytosol] + AMP [cytosol] + PPi [cytosol]"
