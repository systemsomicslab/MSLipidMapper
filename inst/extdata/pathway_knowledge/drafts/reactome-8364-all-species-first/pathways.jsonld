      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10671418], \"className\": \"CatalystActivity\", \"dbId\": 10671416, \"displayName\": \"11-beta-hydroxysteroid dehydrogenase (NAD+) activity of HSD11B2, HSD11B1 dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}], \"dbId\": 10671418, \"displayName\": \"HSD11B2,HSD11B1 dimer oxidise CORT to COR\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671418], \"dbId\": 193977, \"displayName\": \"CORT [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CORT\", \"cortisol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193977\", \"stIdVersion\": \"R-ALL-193977.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671418], \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD11B2,HSD11B1 dimer oxidise CORT to COR\", \"cortisol + NADP(+) => cortisone + H(+) + NADPH\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 194035, \"displayName\": \"COR [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"COR\", \"cortisone\"], \"producedByEvent\": [10671418], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194035\", \"stIdVersion\": \"R-ALL-194035.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [10671418], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"producedByEvent\": [10671418], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-194023\", \"stIdVersion\": \"R-XTR-194023.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
