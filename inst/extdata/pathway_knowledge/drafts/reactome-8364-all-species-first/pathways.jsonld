    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10684401], \"className\": \"CatalystActivity\", \"dbId\": 10684399, \"displayName\": \"diacylglycerol O-acyltransferase activity of DGAT2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10684401, \"displayName\": \"1,2-diacyl-glycerol + acyl-CoA => triacylglycerol + CoASH [DGAT2]\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10684401], \"dbId\": 76103, \"displayName\": \"DAG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DAG\", \"1,2-diacyl-sn-glycerol\", \"1,2-diacylglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76103\", \"stIdVersion\": \"R-ALL-76103.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10684401], \"dbId\": 75967, \"displayName\": \"FACoA [cytosol]\", \"inDiseas