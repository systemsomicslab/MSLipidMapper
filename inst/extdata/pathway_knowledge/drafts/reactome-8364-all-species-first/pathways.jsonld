    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "atR-PALM [cytosol] + H2O [cytosol] => H+ [cytosol] + atROL [cytosol] + PALM(-) [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10719044], \"className\": \"CatalystActivity\", \"dbId\": 10719040, \"displayName\": \"retinyl-palmitate esterase activity of PNPLA4 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10719044, \"displayName\": \"PNPLA4 hydrolyzes retinyl palmitate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10719044], \"dbId\": 2534407, \"displayName\": \"atR-PALM [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"atR-PALM\", \"all-trans-retinyl palmitate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2534407\", \"stIdVersion\": \"R-ALL-2534407.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10719044], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PNPLA4 hydrolyzes retinyl palmitate\", \"all-trans-retinyl hexadecanoate + H2O => all-trans-retinol + hexadecanoate + H(+)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 30209, \"displayName\": \"atROL [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"atROL\", \"all-trans-retinol\", \"Retinol\", \"Vitamin A\", \"Vitamin A1\"], \"producedByEvent\": [10719044], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-30209\", \"stIdVersion\": \"R-ALL-30209.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 8848337, \"displayName\": \"PALM(-) [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PALM(-)\", \"hexadecanoate\", \"palmitate\"], \"producedByEvent\": [10719044], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8848337\", \"stIdVersion\": \"R-ALL-8848337.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [10719044], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"regulatedBy\": [{\"className\": \"NegativeRegulation\", \"dbId\": 10719045, \"displayName\": \"Negative regulation by 'PLIN3 [cytosol]'\", \"regulatedEntity\": [10719044], \"schemaClass\": \"NegativeRegulation\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8848355\", \"stIdVersion\": \"R-XTR-8848355.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
