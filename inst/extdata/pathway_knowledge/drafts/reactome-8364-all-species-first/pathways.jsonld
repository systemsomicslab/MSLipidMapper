        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10708875], \"className\": \"CatalystActivity\", \"dbId\": 10708873, \"displayName\": \"3-hydroxyacyl-CoA dehydratase activity of PTPLs [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10708875, \"displayName\": \"PTPLs dehydrate VLC3HA-CoA to VLCTDA-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10684375], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10708875], \"dbId\": 5676631, \"displayName\": \"VLC3HA-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"VLC3HA-CoA\", \"(R)-3-hydroxyacyl-CoA(4-)\", \"very long chain 3-hydroxyacyl-CoA\", \"(R)-3-hydroxyacyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5676631\", \"stIdVersion\": \"R-ALL-5676631.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"na