        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10711214], \"className\": \"CatalystActivity\", \"dbId\": 10711212, \"displayName\": \"estradiol 17-beta-dehydrogenase [NAD(P)+] activity of HSD17B11 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10711214, \"displayName\": \"HSD17B11 dehydrogenates EST17b to E1\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10711214], \"dbId\": 193132, \"displayName\": \"EST17b [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"EST17b\", \"17beta-estradiol\", \"Estradiol-17beta\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193132\", \"stIdVersion\": \"R-ALL-193132.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10711214], \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"isInDisease\": false, \"isInferred\