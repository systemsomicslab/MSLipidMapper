        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10733223], \"className\": \"CatalystActivity\", \"dbId\": 10733221, \"displayName\": \"galactosylceramide sulfotransferase activity of GAL3ST1 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}], \"dbId\": 10733223, \"displayName\": \"GAL3ST1 transfers sulfate to GalCer,LacCer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10733223], \"dbId\": 741440, \"displayName\": \"PAPS [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PAPS\", \"3'-phosphonato-5'-adenylyl sulfate(4-)\", \"3'-phospho-5'-adenylyl sulfate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-741440\", \"stIdVersion\": \"R-ALL-741440.5\"}, {\"className\": \"Set\", \"consumedByEvent\": [10733223], \"dbId\": 9845491, \"displayName\": \"GalCer,LacCer [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GalCer,LacCer\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9845491\", \"stIdVersion\": \"R-ALL-9845491.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GAL3ST1 transfers sulfate to GalCer,LacCer\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 742343, \"displayName\": \"PAP [Golgi lumen]\", \"inDisease\": fal