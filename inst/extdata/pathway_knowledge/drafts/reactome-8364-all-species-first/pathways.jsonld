        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10671007], \"className\": \"CatalystActivity\", \"dbId\": 10671005, \"displayName\": \"racemase and epimerase activity of AMACR [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10671007, \"displayName\": \"Isomerization of 25(R) THCA-CoA to 25(S) THCA-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10671060], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671007], \"dbId\": 192308, \"displayName\": \"25(R) THCA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(R) THCA-CoA\", \"(25R)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oyl-CoA(4-)\", \"25(R) 3alpha,7alpha,12alpha-trihydroxy-5beta-cholestanoyl-CoA\", \"(25R)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192308\", \"stIdVersion\": \"R-ALL-192308.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Isomerization of 25(R) THCA-CoA to 25(S) THCA-CoA\", \"(25R)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oyl-CoA => (25S)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oyl-CoA\", \"25(R) THCA-CoA => 25(S) THCA-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192316, \"displayName\": \"25(S) THCA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(S) THCA-CoA\", \"(25S)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oyl-CoA(4-)\", \"(25S)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholestanoyl-CoA(4-)\", \"25(S) 3alpha,7alpha,12alpha-trihydroxy-5beta-cholestanoyl-CoA\"], \"producedByEvent\": [10671007], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192316\", \"stIdVersion\": \"R-ALL-192316.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10671051, \"displayName\": \"25(R) THCA-CoA is translocated from the cytosol to the peroxisome\", \"followingEvent\": [10671007], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"25(R) THCA-CoA is translocated from the cytosol to the peroxisome\", \"25(R) THCA-CoA [ cytosol] => 25(R) THCA-CoA [peroxisome]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-192325\", \"stIdVersion\": \"R-XTR-192325.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-192056\", \"stIdVersion\": \"R-XTR-192056.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a