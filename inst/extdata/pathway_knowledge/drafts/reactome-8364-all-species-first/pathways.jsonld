    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10733245], \"className\": \"CatalystActivity\", \"dbId\": 10733243, \"displayName\": \"beta-galactoside (CMP) alpha-2,3-sialyltransferase activity of ST3GAL2,3 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}], \"dbId\": 10733245, \"displayName\": \"ST3GAL2,3 transfer Neu5Ac to gangliosides\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10733253], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10733245], \"dbId\": 727815, \"displayName\": \"CMP-Neu5Ac [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CMP-Neu5Ac\", \"CMP-N-acetyl-beta-neuraminate(2-)\", \"CMP-sialic acid\", \"CMP-N-acetyl-beta-neuraminic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-727815\", \"stIdVersion\": \"R-ALL-727815.4\"}, {\"className\": \"Set\", \"consumedByEvent\": [10733245], \"dbId\": 9845510, \"displayName\": \"GM1,GD1b,GA1 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GM1,GD1b,GA1\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9845510\", \"stIdVersion\": \"R-ALL-9845510.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ST3GAL2,3 transfer Neu5Ac to gangliosides\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 727810, \"displayName\": \"CMP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CMP\", \"cytidine 5'-monophosphate(2-)\", \"cytidine 5'-monophosphate\", \"cytidylic acid\", \"Cytidine-5'-monophosphate\"], \"producedByEvent\": [10733245], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-727810\", \"stIdVersion\": \"R-ALL-727810.6\"}, {\"className\": \"Set\", \"dbId\": 9845541, \"displayName\": \"GD1a,GM1b,GT1b [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GD1a,GM1b,GT1b\"], \"producedByEvent\": [10733245], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9845541\", \"stIdVersion\": \"R-ALL-9845541.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10733245], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10733240, \"displayName\": \"B3GALT4 transfers Gal to gangliosides\", \"followingEvent\": [10733245], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"B3GALT4 transfers Gal to gangliosides\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9845516\", \"stIdVersion\": \"R-XTR-9845516.1\"}], \"releaseDate\": \"2026-06-17\", \"s