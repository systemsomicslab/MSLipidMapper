    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10733268], \"className\": \"CatalystActivity\", \"dbId\": 10733266, \"displayName\": \"UDP-galactose:glucosylceramide beta-1,4-galactosyltransferase activity of B4GALT5/6 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}], \"dbId\": 10733268, \"displayName\": \"B4GALT5/6 transfer Gal to GlcCer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10733263], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10733268], \"dbId\": 735682, \"displayName\": \"UDP-Gal [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP-Gal\", \"UDP-alpha-D-galactose(2-)\", \"UDPgalactose\", \"UDP-D-galactose\", \"UDP-D-galactopyranose\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-735682\", \"stIdVersion\": \"R-ALL-735682.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10733268], \"dbId\": 1660674, \"displayName\": \"GlcCer [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GlcCer\", \"beta-D-glucosyl-N-acylsphingosine\", \"Glucosylceramide\", \"Glucocerebroside\", \"D-glucosyl-N-acylsphingosine\", \"D-glucosy-N-acylsphingosine\", \"D-glucosyl-N-acylsphingoid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1660674\", \"stIdVersion\": \"R-ALL-1660674.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"B4GALT5/6 transfer Gal to GlcCer\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 205687, \"displayName\": \"UDP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP\", \"UDP(3-)\", \"uridine 5'-diphosphate\"], \"producedByEvent\": [10733268], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-205687\", \"stIdVersion\": \"R-ALL-205687.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10733268], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 9844874, \"displayName\": \"LacCer-d18 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LacCer-d18\", \"beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1)-N-acylsphingosine\", \"Lactosylceramide\", \"beta-D-Galactosyl-1,4-beta-D-glucosylceramide\"], \"producedByEvent\": [10733268], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9844874\", \"stIdVersion\": \"R-ALL-9844874.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10691687, \"displayName\": \"UGCG transfers glucose to ceramide\", \"followingEvent\": [10733268], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"UGCG transfers glucose to ceramide\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-1638104\", \"stIdVersion\": \"R-XTR-1638104.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9851347\", \"stIdVersion\": \"R-XTR-9851347.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level