        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10711671], \"className\": \"CatalystActivity\", \"dbId\": 10711669, \"displayName\": \"glycerophospholipid phospholipase A1 activity of ABHD3 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10711671, \"displayName\": \"ABHD3 hydrolyses LPC(14:0) to 1AGPC\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10711671], \"dbId\": 5694502, \"displayName\": \"LPC(14:0) [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LPC(14:0)\", \"lysophosphatidylcholine 14:0\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5694502\", \"stIdVersion\": \"R-ALL-5694502.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10711671], \"dbId\": 29356, \"displayName\": \"H