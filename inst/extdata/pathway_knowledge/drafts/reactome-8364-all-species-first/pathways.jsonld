      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10695731], \"className\": \"CatalystActivity\", \"dbId\": 10695729, \"displayName\": \"acetate CoA-transferase activity of ACAA1 [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10695731, \"displayName\": \"Formation of DHA-CoA catalysed by 3-ketoacyl-CoA thiolase\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10695726], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10695731], \"dbId\": 2066762, \"displayName\": \"1-3-oxo-THA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-3-oxo-THA-CoA\", \"(6Z,9Z,12Z,15Z,18Z,21Z)-3-oxotetracosahexaenoyl-CoA\", \"1-(3-oxo-6Z,9Z,12Z,15Z,18Z,21Z-tetracosahexaenoyl)-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2066762\", \"stIdVersion\": \"R-ALL-2066762.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10695731], \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Formation of DHA-CoA catalysed by 3-ketoacyl-CoA thiolase\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2066765, \"displayName\": \"DHA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHA-CoA\", \"(4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoyl-CoA\", \"4Z,7Z,10Z,13Z,16Z,19Z-docosahexaenoyl-CoA\"], \"producedByEvent\": [10695731], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2066765\", \"stIdVersion\": \"R-ALL-2066765.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 353123, \"displayName\": \"Ac-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ac-CoA\", \"acetyl-CoA(4-)\", \"Acetyl coenzyme A\", \"acetyl-CoA\"], \"producedByEvent\": [10695731], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-353123\", \"stIdVersion\": \"R-ALL-353123.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-2066788\", \"stIdVersion\": \"R-XTR-2066788.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
