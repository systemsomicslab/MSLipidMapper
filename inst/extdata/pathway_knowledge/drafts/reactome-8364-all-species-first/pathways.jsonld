    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10666952], \"className\": \"CatalystActivity\", \"dbId\": 10666950, \"displayName\": \"acyltransferase activity of BAAT [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10666952, \"displayName\": \"Cytosolic chenodeoxycholoyl-CoA or choloyl-CoA are conjugated with glycine or taurine\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0008206\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 12647, \"definition\": \"The chemical reactions and pathways involving bile acids, a group of steroid carboxylic acids occurring in bile, where they are present as the sodium salts of their amides with glycine or taurine.\", \"displayName\": \"bile acid metabolic process\", \"name\": \"bile acid metabolic process\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0008206\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10666952], \"dbId\": 194073, \"displayName\": \"choloyl-CoA; chenodeoxycholoyl-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"choloyl-CoA; chenodeoxycholoyl-CoA\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-194073\", \"stIdVersion\": \"R-ALL-194073.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10666952], \"dbId\": 194069, \"displayName\": \"Gly, TAU [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Gly, TAU\", \"glycine; taurine\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-194069\", \"stIdVersion\": \"R-ALL-194069.2\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cytosolic chenodeoxycholoyl-CoA or choloyl-CoA are conjugated with glycine or taurine\"], \"output\": [{\"className\": \"Set\", \"dbId\": 193416, \"displayName\": \"bile salts [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts\"], \"producedByEvent\": [10666952], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-193416\", \"stIdVersion\": \"R-ALL-193416.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10666952], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10666945, \"displayName\": \"Cytosolic cholate and chenodeoxycholate are conjugated with Coenzyme A (SLC27A5 BACS)\", \"followingEvent\": [10666952], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cytosolic cholate and chenodeoxycholate are conjugated with Coenzyme A (SLC27A5 BACS)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-159425\", \"stIdVersion\": \"R-XTR-159425.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-159431\", \"stIdVersion\": \"R-XTR-159431.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
