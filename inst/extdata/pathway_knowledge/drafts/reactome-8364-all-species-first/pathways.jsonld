        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10702421], \"className\": \"CatalystActivity\", \"dbId\": 10702419, \"displayName\": \"SUMO transferase activity of PIAS4 [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10702421, \"displayName\": \"PIAS4 SUMOylates VDR with SUMO2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10702421], \"dbId\": 10676250, \"displayName\": \"vdr [nucleoplasm]\", \"endCoordinate\": 427, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"vdr\", \"VDR\", \"A0A6I8SBB0\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-375512\", \"stIdVersion\": \"R-XTR-375512.1\", \"startCoordinate\": 1}, {\"className\": \"Complex\", \"consumedByEvent\": [10702421, 10702421], \"dbId\": 10699401, \"displayName\": \"SUMO2:UBE2I [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"SUMO2:UBE2I\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-2993778\", \"stIdVersion\": \"R-XTR-2993778.1\"}, 10699401], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PIAS4 SUMOylates VDR with SUMO2\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 10702418, \"displayName\": \"vdr [nucleoplasm]\", \"endCoordinate\": 427, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"vdr\", \"polySUMO2-VDR\", \"A0A6I8SBB0\"], \"producedByEvent\": [10702421], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-4546376\", \"stIdVersion\": \"R-XTR-4546376.1\", \"startCoordinate\": 1}, {\"className\": \"Protein\", \"dbId\": 10699262, \"displayName\": \"ube2i [nucleoplasm]\", \"endCoordinate\": 158, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ube2i\", \"UBE2I\", \"Q28CQ4\"], \"producedByEvent\": [10702421, 10702421], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-912481\", \"stIdVersion\": \"R-XTR-912481.1\", \"startCoordinate\": 1}, 10699262], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-4546387\", \"stIdVersion\": \"R-XTR-4546387.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
