        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10730059, \"displayName\": \"HMGCR dimer binds statins\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10730059], \"dbId\": 10670809, \"displayName\": \"HMGCR dimer [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"HMGCR dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-191277\", \"stIdVersion\": \"R-XTR-191277.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10730059], \"dbId\": 9705575, \"displayName\": \"statins [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"statins\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9705575\", \"stIdVersion\": \"R-ALL-9705575.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCR dimer binds statins\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10730057, \"displayName\": \"HMGCR dimer:statins [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"HMGCR dimer:statins\"], \"producedByEvent\": [10730059], \"schemaClass\": \"Complex\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9705595\", \"stIdVersion\": \"R-XTR-9705595.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10731122, \"displayName\": \"SLCO1B1,1B3,2B1-3 transport ATV from extracelluar region to cytosol\", \"followingEvent\": [10730059], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLCO1B1,1B3,2B1-3 transport ATV from extracelluar region to cytosol\", \"Organic anion transporters transport ATV from blood into hepatocytes\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9757010\", \"stIdVersion\": \"R-XTR-9757010.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9705584\", \"stIdVersion\": \"R-XTR-9705584.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
