    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 10730800, \"displayName\": \"Bile salts and acids bind ALB\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0015721\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 24849, \"definition\": \"The directed movement of bile acid and bile salts into, out of or within a cell, or between cells, by means of some agent such as a transporter or pore.\", \"displayName\": \"bile acid and bile salt transport\", \"name\": \"bile acid and bile salt transport\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0015721\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10730800], \"dbId\": 10675006, \"displayName\": \"ALB [extracellular region]\", \"endCoordinate\": 609, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ALB\", \"Q5CZZ1\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-194115\", \"stIdVersion\": \"R-XTR-194115.1\", \"startCoordinate\": 25}, {\"className\": \"Set\", \"consumedByEvent\": [10730800], \"dbId\": 192483, \"displayName\": \"bile salts and acids [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts and acids\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-192483\", \"stIdVersion\": \"R-ALL-192483.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Bile salts and acids bind ALB\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10730798, \"displayName\": \"ALB:bile salts and acids [extracellular region]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"ALB:bile salts and acids\"], \"producedByEvent\": [10730800], \"schemaClass\": \"Complex\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-194110\", \"stIdVersion\": \"R-XTR-194110.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10730815, \"displayName\": \"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"followingEvent\": [10730800], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"OSTA:OSTB exports bile salts from enterocytes to the portal system\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9733964\", \"stIdVersion\": \"R-XTR-9733964.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10671444, \"displayName\": \"ABCC3 transports bile salts from cytosol to extracellular region\", \"followingEvent\": [10730800], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ABCC3 transports bile salts from cytosol to extracellular region\", \"Efflux of bile salts from enterocytes to portal system by MRP3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-194153\", \"stIdVersion\": \"R-XTR-194153.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9733545\", \"stIdVersion\": \"R-XTR-9733545.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
