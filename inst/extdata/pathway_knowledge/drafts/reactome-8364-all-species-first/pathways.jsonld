    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "SMPD2 and 3 hydrolyze sphingomyelin (plasma membrane)"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/curationStatus": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/Draft"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/directionality": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "SPHM d18:1 [plasma membrane] + H2O [cytosol] => CERA [plasma membrane] + H+ [cytosol] + ChoP [plasma membrane]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10691350], \"className\": \"CatalystActivity\", \"dbId\": 10691348, \"displayName\": \"sphingomyelin phosphodiesterase activity of SMPD2,3:Mg2+ [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10691350, \"displayName\": \"SMPD2 and 3 hydrolyze sphingomyelin (plasma membrane)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10691755], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10691350], \"dbId\": 429776, \"displayName\": \"SPHM d18:1 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SPHM d18:1\", \"sphingomyelin d18:1\", \"sphingomyelins\", \"ceramide phosphocholines\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-429776\", \"stIdVersion\": \"R-ALL-429776.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10691350], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SMPD2 and 3 hydrolyze sphingomyelin (plasma membrane)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 429807, \"displayName\": \"CERA [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CERA\", \"N-acylsphingoid\", \"ceramide\"], \"producedByEvent\": [10691350], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-429807\", \"stIdVersion\": \"R-ALL-429807.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1610735, \"displayName\": \"ChoP [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ChoP\", \"choline phosphate(1-)\", \"Choline phosphate\", \"phosphocholine\"], \"producedByEvent\": [10691350], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1610735\", \"stIdVersion\": \"R-ALL-1610735.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [10691350], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10681515, \"displayName\": \"SGMS2 transfers phosphocholine onto ceramide\", \"followingEvent\": [10691350], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SGMS2 transfers phosphocholine onto ceramide\", \"phosphatidylcholine + ceramide <=> sphingomyelin + diacylglycerol [SGMS