        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10671234], \"className\": \"CatalystActivity\", \"dbId\": 10671049, \"displayName\": \"ATPase-coupled transmembrane transporter activity of ABCD3 dimer [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005778\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17947, \"definition\": \"The lipid bilayer surrounding a peroxisome.\", \"displayName\": \"peroxisomal membrane\", \"name\": \"peroxisomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005778\"}], \"dbId\": 10671234, \"displayName\": \"25(R) DHCA-CoA is translocated from the cytosol to the peroxisome\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10671232], \"goBiologicalProcess\": {\"accession\": \"0015919\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 25870, \"definition\": \"The directed movement of substances to, from or across the peroxisomal membrane.\", \"displayName\": \"peroxisomal membrane transport\", \"name\": \"peroxisomal membrane transport\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0015919\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671234], \"dbId\": 193457, \"displayName\": \"25(R) DHCA-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(R) DHCA-CoA\", \"3alpha,7alpha-dihydroxy-5beta-cholestan-26-oyl-CoA\", \"3alpha,7alpha-Dihydroxy-5beta-cholestanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193457\", \"stIdVersion\": \"R-ALL-193457.4\"}, {\"className\": \"