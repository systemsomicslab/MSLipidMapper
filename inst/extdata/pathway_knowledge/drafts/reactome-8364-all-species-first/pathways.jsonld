      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10695701], \"className\": \"CatalystActivity\", \"dbId\": 10695699, \"displayName\": \"importin-alpha family protein binding activity of RAN:GTP [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10695701, \"displayName\": \"SREBP1A,1C,2:Importin beta-1 dissociates\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10695701], \"dbId\": 10691865, \"displayName\": \"SREBP1A,1C,2:Importin beta-1 [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"SREBP1A,1C,2:Importin beta-1\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-2065543\", \"stIdVersion\": \"R-XTR-2065543.1\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10695701], \"dbId\": 10673518, \"displayName\": \"RAN:GTP [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"RAN:GTP\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-180738\", \"stIdVersion\": \"R-XTR-180738.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SREBP1A,1C,2:Importin beta-1 dissociates\", \"SREBF1A,1C,2:Importin beta-1 dissociates\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10691863, \"displayName\": \"SREBP1A,1C,2 dimer [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"SREBP1A,1C,2 dimer\"], \"producedByEvent\": [10695701], \"schemaClass\": \"Complex\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-1655744\", \"stIdVersion\": \"R-XTR-1655744.1\"}, {\"className\": \"Complex\", \"dbId\": 10695698, \"displayName\": \"Importin-beta:Ran GTP complex [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"Importin-beta:Ran GTP complex\"], \"producedByEvent\": [10695701], \"schemaClass\": \"Complex\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-180719\", \"stIdVersion\": \"R-XTR-180719.1\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10691867, \"displayName\": \"SREBP1A,1C,2 translocates to the nucleus\", \"followingEvent\": [10695701], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SREBP1A,1C,2 translocates to the nucleus\", \"SREBF1A,1C,2 translocates to the nucleus\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-1655831\", \"stIdVersion\": \"R-XTR-1655831.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-2065539\", \"stIdVersion\": \"R-XTR-2065539.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
