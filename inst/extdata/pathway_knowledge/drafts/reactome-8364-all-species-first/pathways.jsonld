    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10671027], \"className\": \"CatalystActivity\", \"dbId\": 10666943, \"displayName\": \"long-chain fatty acid-CoA ligase activity of SLC27A5 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10671027, \"displayName\": \"THCA is conjugated with Coenzyme A (SLC27A5 BACS)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10671051], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671027], \"dbId\": 192013, \"displayName\": \"THCA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"THCA\", \"3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oic acid\", \"3alpha, 7alpha, 12alpha-trihydroxy-5beta-cholestanoate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192013\", \"stIdVersion\": \"R-ALL-192013.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671027], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671027], \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"THCA is conjugated with Coenzyme A (SLC27A5 BACS)\", \"(25R)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oate + ATP + CoA => (25R)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oyl-CoA + AMP + diphosphate\", \"THCA + ATP + CoASH => 25(R) THCA-CoA + AMP + pyrophosphate (SCLS25A5 \\\"BACS\\\")\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192096, \"displayName\": \"25(R) THCA-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(R) THCA-CoA\", \"(25R)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oyl-CoA(4-)\", \"25(R) 3alpha,7alpha,12alpha-trihydroxy-5beta-cholestanoyl-CoA\", \"(25R)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oyl-CoA\"], \"producedByEvent\": [10671027], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192096\", \"stIdVersion\": \"R-ALL-192096.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76577, \"displayName\": \"AMP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AMP\", \"adenosine 5'-monophosphate(2-)\", \"adenosine 5'-monophosphate\", \"Adenylic acid\", \"Adenylate\", \"5'-AMP\", \"5'-Adenylic acid\", \"5'-Adenosine monophosphate\"], \"producedByEvent\": [10671027], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76577\", \"stIdVersion\": \"R-ALL-76577.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111294, \"displayName\": \"PPi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [10671027], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111294\", \"stIdVersion\": \"R-ALL-111294.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-192137\", \"stIdVersion\": \"R-XTR-192137.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
