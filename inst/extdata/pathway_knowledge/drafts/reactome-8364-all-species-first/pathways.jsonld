    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10674994], \"className\": \"CatalystActivity\", \"dbId\": 10674992, \"displayName\": \"choline O-acetyltransferase activity of CHAT [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10674994, \"displayName\": \"Cho is acetylated to AcCho by CHAT\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10674994], \"dbId\": 76183, \"displayName\": \"Ac-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ac-CoA\", \"acetyl-CoA(4-)\", \"Acetyl coenzyme A\", \"acetyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76183\", \"stIdVersion\": \"R-ALL-76183.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10674994], \"dbId\": 264618, \"displayName\": \"Cho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Cho\", \"choline\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-264618\", \"stIdVersion\": \"R-ALL-264618.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho is acetylated to AcCho by CHAT\", \"Synthesis of o-acetylcholine\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10674994], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 264643, \"displayName\": \"AcCho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AcCho\", \"acetylcholine\", \"O-acetylcholine\"], \"producedByEvent\": [10674994], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-264643\", \"stIdVersion\": \"R-ALL-264643.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10681465, \"displayName\": \"SLC5A7 cotransports Cho, Cl-, Na+ from extracellular region to cytosol\", \"followingEvent\": [10674994], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC5A7 cotransports Cho, Cl-, Na+ from extracellular region to cytosol\", \"Sodium- and chloride-dependent choline transport by CHT\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-429594\", \"stIdVersion\": \"R-XTR-429594.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10690467, \"displayName\": \"PC is hydrolyzed to PA and choline by PLD1/2\", \"followingEvent\": [10674994], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PC is hydrolyzed to PA and choline by PLD1/2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-1483182\", \"stIdVersion\": \"R-XTR-1483182.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10690440, \"displayName\": \"PCho is dephosphorylated to Cho by PHOSPHO1\", \"followingEvent\": [10674994], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PCho is dephosphorylated to Cho by PHOSPHO1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-1483159\", \"stIdVersion\": \"R-XTR-1483159.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10682486, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"followingEvent\": [10674994], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-444433\", \"stIdVersion\": \"R-XTR-444433.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-264622\", \"stIdVersion\": \"R-XTR-264622.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
