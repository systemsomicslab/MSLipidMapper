        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10670798], \"className\": \"CatalystActivity\", \"dbId\": 10670796, \"displayName\": \"squalene monooxygenase activity of SQLE:FAD [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10670798, \"displayName\": \"Squalene is oxidized to its epoxide\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10670819], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10670798], \"dbId\": 191269, \"displayName\": \"SQNE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SQNE\", \"squalene\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191269\", \"stIdVersion\": \"R-ALL-191269.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10670798], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\":