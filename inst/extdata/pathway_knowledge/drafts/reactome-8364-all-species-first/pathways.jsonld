      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "UDP-GalNAc [Golgi lumen] + GD3,GM3,GT3,SM3,LacCer [Golgi membrane] => GD2,GM2, GA2,GT2,SM2 [Golgi membrane] + UDP [Golgi lumen] + H+ [Golgi lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10720413], \"className\": \"CatalystActivity\", \"dbId\": 10720411, \"displayName\": \"(N-acetylneuraminyl)-galactosylglucosylceramide N-acetylgalactosaminyltransferase activity of B4GALNT1 dimer [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}], \"dbId\": 10720413, \"displayName\": \"B4GALNT1 dimer transfers GalNAc to gangliosides\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10720413], \"dbId\": 8856243, \"displayName\": \"GD3,GM3,GT3,SM3,LacCer [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GD3,GM3,GT3,SM3,LacCer\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-8856243\", \"stIdVersion\": \"R-ALL-8856243.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10720413], \"dbId\": 735700, \"displayName\": \"UDP-GalNAc [Golgi lumen]\", \"inDisease\": false, \"maxDepth\