    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "11DCORST [mitochondrial matrix] + NADPH [mitochondrial matrix] + O2 [mitochondrial matrix] + H+ [mitochondrial matrix] => NADP+ [mitochondrial matrix] + H2O [mitochondrial matrix] + CORST [mitochondrial matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10671403], \"className\": \"CatalystActivity\", \"dbId\": 10671399, \"displayName\": \"steroid 11-beta-monooxygenase activity of Cytochrome P450 (CYP11B1 based) [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 10671403, \"displayName\": \"CYP11B2 oxidises 11DCORST to CORST\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10671398], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671403], \"dbId\": 193988, \"displayName\": \"11DCORST [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"11DCORST\", \"11-deoxycorticosterone\", \"cortexone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193988\", \"stIdVersion\": \"R-ALL-193988.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671403, 10671403], \"dbId\": 113600, \"displayName\": \"NADPH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113600\", \"stIdVersion\": \"R-ALL-113600.4\"}, 113600, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671403, 10671403], \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}, 113529, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671403], \"dbId\": 113533, \"displayName\": \"O2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113533\", \"stIdVersion\": \"R-ALL-113533.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP11B2 oxidises 11DCORST to CORST\", \"21-hydroxyprogesterone + 2 H(+) + O2 + 2 reduced (adrenodoxin) => corticosterone + H2O + 2 oxidized (adrenodoxin)\", \"11-deoxycorticosterone + NADPH + H+ + O2 => corticosterone + H2O + NADP+\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 194005, \"displayName\": \"CORST [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CORST\", \"corticosterone\"], \"producedByEvent\": [10671403], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194005\", \"stIdVersion\": \"R-ALL-194005.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10671403], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113563, \"displayName\": \"NADP+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [10671403, 10671403], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113563\", \"stIdVersion\": \"R-ALL-113563.6\"}, 113563], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-194017\", \"stIdVersion\": \"R-XTR-194017.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
