    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "NADH [endoplasmic reticulum lumen] + O2 [endoplasmic reticulum lumen] + DGL-CoA [endoplasmic reticulum lumen] => AA-CoA [endoplasmic reticulum lumen] + NAD+ [endoplasmic reticulum lumen] + H2O [endoplasmic reticulum lumen]"
