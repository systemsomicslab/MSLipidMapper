        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10725474], \"className\": \"CatalystActivity\", \"dbId\": 10725472, \"displayName\": \"sn-glycerol 3-phosphatase activity of PGP:Mg2+ dimer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10725474, \"displayName\": \"PGP:Mg2+ dimer hydrolyses G3P to glycerol\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0006114\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 15779, \"definition\": \"The chemical reactions and pathways resulting in the formation of glycerol, 1,2,3-propanetriol, a sweet, hygroscopic, viscous liquid, widely distributed in nature as a constituent of many lipids.\", \"displayName\": \"glycerol biosynthetic process\", \"name\": \"glycerol biosynthetic process\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006114\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10725474], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"co