    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10692175], \"className\": \"CatalystActivity\", \"dbId\": 10692173, \"displayName\": \"1-phosphatidylinositol 4-kinase activator activity of ARF1/3:GTP [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10692175, \"displayName\": \"PI4KB binds to ARF1/3:GTP at the Golgi membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10692175], \"dbId\": 10692063, \"displayName\": \"ARF1/3:GTP [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"ARF1/3:GTP\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-1806258\", \"stIdVersion\": \"R-XTR-1806258.1\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10692175], \"dbId\": 10692172, \"displayName\": \"pi4kb [cytosol]\", \"endCoordinate\": 816, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"pi4kb\", \"PI