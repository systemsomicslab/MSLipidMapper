    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + O2 [cytosol] + NADPH [cytosol] + 14DMLANOL [endoplasmic reticulum membrane] => 4C4MZYMOL [endoplasmic reticulum membrane] + NADP+ [cytosol] + H2O [cytosol]"
