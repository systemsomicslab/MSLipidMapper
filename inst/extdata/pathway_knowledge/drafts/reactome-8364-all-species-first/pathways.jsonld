    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "AEA [lipid droplet] + H2O [lipid droplet] => ETA [lipid droplet] + AA [lipid droplet]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10711262], \"className\": \"CatalystActivity\", \"dbId\": 10711260, \"displayName\": \"fatty acid amide hydrolase activity of FAAH2 [lipid droplet]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005811\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13977, \"definition\": \"An intracellular non-membrane-bounded organelle comprising a matrix of coalesced lipids surrounded by a phospholipid monolayer. May include associated proteins.\", \"displayName\": \"lipid droplet\", \"name\": \"lipid droplet\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005811\"}], \"dbId\": 10711262, \"displayName\": \"FAAH2 hydrolyses AEA to AA and ETA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10711262], \"dbId\": 5693752, \"displayName\": \"AEA [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AEA\", \"anandamide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5693752\", \"stIdVersion\": \"R-ALL-5693752.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10711262], \"dbId\": 5693747, \"displayName\": \"H2O [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5693747\", \"stIdVersion\": \"R-ALL-5693747.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FAAH2 hydrolyses AEA to AA and ETA\", \"H2O + N-(5Z,8Z,11Z,14Z-eicosatetraenoyl)-ethanolamine => (5Z,8Z,11Z,14Z)-eicosatetraenoate + ethanolamine\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 5693733, \"displayName\": \"AA [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AA\", \"arachidonate\", \"Arachidonate\", \"arachidonic acid\", \"cis-5,8,11,14-Eicosatetraenoic acid\"], \"producedByEvent\": [10711262], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5693733\", \"stIdVersion\": \"R-ALL-5693733.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 5693736, \"displayName\": \"ETA [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ETA\", \"ethanolaminium(1+)\", \"ethanolamine\"], \"producedByEvent\": [10711262], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5693736\", \"stIdVersion\": \"R-ALL-5693736.6\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-5693751\", \"stIdVersion\": \"R-XTR-5693751.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
