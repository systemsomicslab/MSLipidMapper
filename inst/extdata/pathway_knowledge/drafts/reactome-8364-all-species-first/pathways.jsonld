    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "4CHOL7a,27DONE [endoplasmic reticulum membrane] + H+ [cytosol] + O2 [cytosol] + NADPH [cytosol] => 4CHOL7a,12a,27TONE [endoplasmic reticulum membrane] + NADP+ [cytosol] + H2O [cytosol]"
