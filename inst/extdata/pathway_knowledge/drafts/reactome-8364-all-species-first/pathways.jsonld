        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10671230], \"className\": \"CatalystActivity\", \"dbId\": 10671224, \"displayName\": \"long-chain fatty acid-CoA ligase activity of SLC27A2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10671230, \"displayName\": \"DHCA is conjugated with Coenzyme A (SLC27A2 VLCS)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10671234], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671230], \"dbId\": 193505, \"displayName\": \"DHCA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHCA\", \"3alpha,7alpha-dihydroxy-5beta-cholestan-26-oic acid\", \"3alpha,7alpha-dihydroxy-5beta-cholestanoate\", \"3alpha,7alpha-Dihydroxy-5beta-cholestanate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193505\", \"stIdVersion\": \"R-ALL-193505.4\"}, {\"className