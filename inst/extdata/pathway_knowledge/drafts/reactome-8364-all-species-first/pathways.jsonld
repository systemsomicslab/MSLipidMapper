  {
    "@id": "https://reactome.org/content/detail/R-XTR-193452",
    "@type": [
      "https://systemomicslab.github.io/MSLipidMapper/ontology/LipidReaction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Isomerization of 25(R) DHCA-CoA to 25(S) DHCA-CoA"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/curationStatus": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/Draft"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/directionality": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "25(R) DHCA-CoA [peroxisomal matrix] => 25(S) DHCA-CoA [peroxisomal matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10671232], \"className\": \"CatalystActivity\", \"dbId\": 10671005, \"displayName\": \"racemase and epimerase activity of AMACR [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10671232, \"displayName\": \"Isomerization of 25(R) DHCA-CoA to 25(S) DHCA-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10671214], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10671232], \"dbId\": 193429, \"displayName\": \"25(R) DHCA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(R) DHCA-CoA\", \"3alpha,7alpha-dihydroxy-5beta-cholestan-26-oyl-CoA\", \"3alpha,7alpha-Dihydroxy-5beta-cholestanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193429\", \"stIdVersion\": \"R-ALL-193429.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Isomerization of 25(R) DHCA-CoA to 25(S) DHCA-CoA\", \"25(R) DHCA-CoA => 25(S) DHCA-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193442, \"displayName\": \"25(S) DHCA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(S) DHCA-CoA\", \"3alpha,7alpha-dihydroxy-5beta-cholestan-26-oyl-CoA\", \"25(S) 3alpha,7alpha-dihydroxy-5beta-cholestanoyl-CoA\"], \"producedByEvent\": [10671232], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193442\", \"stIdVersion\": \"R-ALL-193442.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10671234, \"displayName\": \"25(R) DHCA-CoA is translocated from the cytosol to the peroxisome\", \"followingEvent\": [10671232], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"25(R) DHCA-CoA is translocated from the cytosol to the peroxisome\", \"25(R) DHCA-CoA [ cytosol] => 25(R) DHCA-CoA [peroxisome]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-193482\", \"stIdVersion\": \"R-XTR-193482.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"XTR\", \"className\": \"Species\", \"dbId\": 205621, \"displayName\": \"Xenopus tropicalis\", \"name\": [\"Xenopus tropicalis\", \"Western clawed frog\", \"Silurana tropicalis\"], \"schemaClass\": \"Species\", \"taxId\": \"8364\"}], \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-193452\", \"stIdVersion\": \"R-XTR-193452.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For d