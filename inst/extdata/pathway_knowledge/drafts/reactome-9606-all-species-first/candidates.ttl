ion\": \"R-CFA-9027628.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10216077, \"displayName\": \"ALOX5 oxidises EPA to 5-HEPE\", \"inferredFrom\": [9027628], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises EPA to 5-HEPE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9027628\", \"stIdVersion\": \"R-RNO-9027628.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092865, \"displayName\": \"ALOX5 oxidises EPA to 5-HEPE\", \"inferredFrom\": [9027628], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises EPA to 5-HEPE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9027628\", \"stIdVersion\": \"R-MMU-9027628.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9028283, \"displayName\": \"5-HEPE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5-HEPE\", \"5-HEPE(1-)\", \"5-hydroxy-eicosapentaenoic acid\"], \"producedByEvent\": [9027628], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9028283\", \"stIdVersion\": \"R-ALL-9028283.4\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027628\", \"stIdVersion\": \"R-HSA-9027628.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9028249, \"displayName\": \"In human neutrophils, 5-lipoxygenase (ALOX5) can mediate the...\", \"schemaClass\": \"Summation\", \"text\": \"In human neutrophils, 5-lipoxygenase (ALOX5) can mediate the lipoxygenation of eicosapentaenoic acid (EPA) to 5-hydroxy-eicosapentaenoic acid (5-HEPE) (Cipollina et al. 2014, Powell et al. 1995). Neutrophils treated with an ALOX5 inhibitor completely suppressed the formation of 5-oxo-EPA and its hydroxy precursor 5-HEPE, demonstrating that ALOX5 mediates the first step in 5-oxo-EPA biosynthesis (Cipollina et al. 2014).\"}]}" ;
