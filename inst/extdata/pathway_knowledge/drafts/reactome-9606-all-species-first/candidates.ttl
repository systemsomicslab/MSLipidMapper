className\": \"Reaction\", \"dbId\": 10718361, \"displayName\": \"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\", \"inferredFrom\": [6811522], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-6811522\", \"stIdVersion\": \"R-XTR-6811522.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10635488, \"displayName\": \"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\", \"inferredFrom\": [6811522], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-6811522\", \"stIdVersion\": \"R-DRE-6811522.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10538685, \"displayName\": \"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\", \"inferredFrom\": [6811522], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-6811522\", \"stIdVersion\": \"R-SSC-6811522.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10311754, \"displayName\": \"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\", \"inferredFrom\": [6811522], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-6811522\", \"stIdVersion\": \"R-CFA-6811522.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10202718, \"displayName\": \"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\", \"inferredFrom\": [6811522], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-6811522\", \"stIdVersion\": \"R-RNO-6811522.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10079976, \"displayName\": \"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\", \"inferredFrom\": [6811522], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6811522\", \"stIdVersion\": \"R-MMU-6811522.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 113582, \"displayName\": \"ADP [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [6811522], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113582\", \"stIdVersion\": \"R-ALL-113582.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 6810412, \"displayName\": \"PI(4,5)P2 [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2\", \"1-phosphatidyl-1D-myo-inositol 4,5-bisphosphate(5-)\", \"1-phosphatidyl-1D-myo-inositol 4,5-bisphosphate\"], \"producedByEvent\": [6811522], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6810412\", \"stIdVersion\": \"R-ALL-6810412.5\"}], \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6811522\", \"stIdVersion\": \"R-HSA-6811522.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6811525, \"displayName\": \"In the nucleus, phosphatidylinositol 5-phosphate (PI5P) is p...\", \"schemaClass\": \"Summation\", \"text\": \"In the nucleus, phosphatidylinositol 5-phosphate (PI5P) is phosphorylated to phosphatidylinositol 4,5-bisphosphate (PI(4,5)P2) mainly by phosphatidylinositol-5-phosphate 4-kinase type-2 beta (PIP4K2B). In the nucleus, PIP4K2B predominantly functions as a homodimer or a heterodimer with PIP4K2A. A low level of PIP4K2A homodimers can also be found in the nucleus. Nuclear localization of PIP4K2C has not been examined but is assumed to be possible, at least through formation of heterodimers with PIP4K2B (Ciruela et al. 2000, Jones et al. 2006, Bultsma et al. 2010). Under conditions of cellular stress, nuclear PIP4K2B can be phosphorylated by p38 MAP kinases, resulting in PIP4K2B inactivation. The putative p38 target site, serine residue S326 of PIP4K2B, is conserved in PIP4K2A, but the role and mechanism of p38-mediated regulation of PIP4K2 isoforms has not been studied in detail (Jones et al. 2006). \"}]}" ;
