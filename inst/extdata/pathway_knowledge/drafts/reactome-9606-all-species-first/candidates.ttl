    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [1614336], \"className\": \"CatalystActivity\", \"dbId\": 9956914, \"displayName\": \"enzyme inhibitor activity of SUMF2 [endoplasmic reticulum lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}], \"dbId\": 1614336, \"displayName\": \"SUMF2 binds SUMF1, inhibiting SUMF1-mediated activation of arylsulfatases\", \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [1614336], \"dbId\": 1614316, \"displayName\": \"SUMF1 [endoplasmic reticulum lumen]\", \"endCoordinate\": 374, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SUMF1\", \"Sulfatase-modifying factor 1\", \"SUMF1_HUMAN\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1614316\", \"stIdVersion\": \"R-HSA-1614316.1\", \"startCoordinate\": 34}, {\"className\": \"Protein\", \"consumedByEvent\": [1614336], \"dbId\": 1614305, \"displayName\": \"SUMF2 [endoplasmic reticulum lumen]\", \"endCoordinate\": 301, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SUMF2\", \"Sulfatase-modifying factor 2\", \"SUMF2_HUMAN\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1614305\", \"stIdVersion\": \"R-HSA-1614305.1\", \"startCoordinate\": 26}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1614327, \"displayName\": \"Expression, localization, structural, and functional characterization of pFGE, the paralog of the Calpha-formylglycine-generating enzyme\", \"journal\": \"J Biol Chem\", \"pages\": \"15173-9\", \"pubMedIdentifier\": 15708861, \"schemaClass\": \"LiteratureReference\", \"title\": \"Expression, localization, structural, and functional characterization of pFGE, the paralog of the Calpha-formylglycine-generating enzyme\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15708861\", \"volume\": 280, \"year\": 2005}, {\"className\": \"LiteratureReference\", \"dbId\": 1614344, \"displayName\": \"Sulphatase activities are regulated by the interaction of sulphatase-modifying factor 1 with SUMF2\", \"journal\": \"EMBO Rep\", \"pages\": \"655-60\", \"pubMedIdentifier\": 15962010, \"schemaClass\": \"LiteratureReference\", \"title\": \"Sulphatase activities are regulated by the interaction of sulphatase-modifying factor 1 with SUMF2\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15962010\", \"volume\": 6, \"year\": 2005}, {\"className\": \"LiteratureReference\", \"dbId\": 9863288, \"displayName\": \"Multistep, sequential control of the trafficking and function of the multiple sulfatase deficiency gene product, SUMF1 by PDI, ERGIC-53 and ERp44\", \"journal\": \"Hum Mol Genet\", \"pages\": \"2610-21\", \"pubMedIdentifier\": 18508857, \"schemaClass\": \"LiteratureReference\", \"title\": \"Multistep, sequential control of the trafficking and function of the multiple sulfatase deficiency gene product, SUMF1 by PDI, ERGIC-53 and ERp44\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18508857\", \"volume\": 17, \"year\": 2008}, {\"className\": \"LiteratureReference\", \"dbId\": 9863297, \"displayName\": \"Sulfatase activities are regulated by the interaction of the sulfatase-modifying factor 1 with SUMF2\", \"journal\": \"EMBO Rep\", \"pages\": \"1901\", \"pubMedIdentifier\": 27909074, \"schemaClass\": \"LiteratureReference\", \"title\": \"Sulfatase activities are