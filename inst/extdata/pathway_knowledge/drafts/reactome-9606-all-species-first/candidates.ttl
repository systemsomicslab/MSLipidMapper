\"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9026754, \"displayName\": \"Identification of 14-series sulfido-conjugated mediators that promote resolution of infection and organ protection\", \"journal\": \"Proc. Natl. Acad. Sci. U.S.A.\", \"pages\": \"E4753-61\", \"pubMedIdentifier\": 25324525, \"schemaClass\": \"LiteratureReference\", \"title\": \"Identification of 14-series sulfido-conjugated mediators that promote resolution of infection and organ protection\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25324525\", \"volume\": 111, \"year\": 2014}, {\"className\": \"LiteratureReference\", \"dbId\": 9026774, \"displayName\": \"Maresin conjugates in tissue regeneration biosynthesis enzymes in human macrophages\", \"journal\": \"Proc. Natl. Acad. Sci. U.S.A.\", \"pages\": \"12232-12237\", \"pubMedIdentifier\": 27791009, \"schemaClass\": \"LiteratureReference\", \"title\": \"Maresin conjugates in tissue regeneration biosynthesis enzymes in human macrophages\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/27791009\", \"volume\": 113, \"year\": 2016}, {\"className\": \"LiteratureReference\", \"dbId\": 9026923, \"displayName\": \"Identification and Actions of a Novel Third Maresin Conjugate in Tissue Regeneration: MCTR3\", \"journal\": \"PLoS ONE\", \"pages\": \"e0149319\", \"pubMedIdentifier\": 26881986, \"schemaClass\": \"LiteratureReference\", \"title\": \"Identification and Actions of a Novel Third Maresin Conjugate in Tissue Regeneration: MCTR3\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/26881986\", \"volume\": 11, \"year\": 2016}], \"maxDepth\": 1, \"name\": [\"DPEP hydrolyses MCTR2 to MCTR3\", \"(13R)-S-cysteinylglycyl-(14S)-hydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate + H2O => (13R)-S-cysteinyl-(14S)-hydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate + glycine\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9026776, \"displayName\": \"MCTR3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MCTR3\", \"(13R)-S-cysteinyl-(14S)-hydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate(1-)\", \"MCTR3(1-)\", \"13(R)-cysteinyl, 14(S)-hydroxy-4Z,7Z,9E,11E,13R,14S,16Z,19Zdocosahexaenoic acid\", \"(13R)-S-cysteinyl-(14S)-hydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoic acid\"], \"producedByEvent\": [9026771], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9026776\", \"stIdVersion\": \"R-ALL-9026776.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29424, \"displayName\": \"Gly [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Gly\", \"glycine zwitterion\", \"L-glycine\", \"glycine\", \"Aminoacetic acid\"], \"producedByEvent\": [9026771], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29424\", \"stIdVersion\": \"R-ALL-29424.6\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9026757, \"displayName\": \"GGT hydrolyses MCTR1 to MCTR2\", \"followingEvent\": [9026771], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GGT hydrolyses MCTR1 to MCTR2\", \"(13R)-S-glutathionyl-(14S)-hydroxy-(4Z,7Z,9E,11E16S,17S-epoxy-DHA ,16Z,19Z)-docosahexaenoate + H2O => (13R)-S-cysteinylglycyl-(14S)-hydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate + L-glutamate\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026757\", \"stIdVersion\": \"R-HSA-9026757.3\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026771\", \"stIdVersion\": \"R-HSA-9026771.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9026752, \"displayName\": \"In human macrophages, a dipeptidase (DPEP) is proposed to hy...\", \"schemaClass\": \"Summation\", \"text\": \"In human macrophages, a dipeptidase (DPEP) is proposed to hydrolyse maresin conjugates in tissue regeneration 2 (MCTR2) to MCTR3, identified as 13(R)-cysteinyl, 14(S)-hydroxy-4Z,7Z,9E,11E,13R,14S,16Z,19Zdocosahexaenoic acid (Dalli et al. 2014, 2016a, 2016b). Incubation of human macrophages with MCTR2 and a DPEP inhibitor demonstrates significantly higher MCTR2 levels and significantly lower MCTR3 levels, suggesting a DPEP mediates MCTR2 hydrolysis (Dalli et al. 2016a). MCTR3 displays potent activity in proresolution of inflammation and tissue regeneration (Dalli et al. 2016b).\"}]}" ;
