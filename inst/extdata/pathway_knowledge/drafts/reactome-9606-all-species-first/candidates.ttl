"transition\", \"className\": \"Reaction\", \"dbId\": 10161617, \"displayName\": \"PI is hydrolyzed to 1-acyl LPI by PLA2[11]\", \"inferredFrom\": [1482825], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI is hydrolyzed to 1-acyl LPI by PLA2[11]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1482825\", \"stIdVersion\": \"R-RNO-1482825.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10039224, \"displayName\": \"PI is hydrolyzed to 1-acyl LPI by PLA2[11]\", \"inferredFrom\": [1482825], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI is hydrolyzed to 1-acyl LPI by PLA2[11]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1482825\", \"stIdVersion\": \"R-MMU-1482825.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1498733, \"displayName\": \"1-acyl LPI [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPI\", \"1-acyl-sn-glycero-3-phospho-D-myo-inositol\", \"1-acyl lysophosphatidylinositol\", \"1-Acylglycerophosphoinositol\", \"1-Acyl-sn-glycero-3-phosphoinositol\"], \"producedByEvent\": [1482825], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498733\", \"stIdVersion\": \"R-ALL-1498733.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524021, \"displayName\": \"LCFA(-) [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [1482825], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524021\", \"stIdVersion\": \"R-ALL-1524021.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482976, \"displayName\": \"CDP-DAG is converted to PI by CDIPT\", \"followingEvent\": [1482825], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CDP-DAG is converted to PI by CDIPT\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482976\", \"stIdVersion\": \"R-HSA-1482976.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482598, \"displayName\": \"1-acyl LPI is acylated to PI by MBOAT7\", \"followingEvent\": [1482825], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPI is acylated to PI by MBOAT7\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482598\", \"stIdVersion\": \"R-HSA-1482598.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482626, \"displayName\": \"2-acyl LPI is acylated to PI by MBOAT7\", \"followingEvent\": [1482825], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"2-acyl LPI is acylated to PI by MBOAT7\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482626\", \"stIdVersion\": \"R-HSA-1482626.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676124, \"displayName\": \"PI4P is dephosphorylated to PI by SACM1L at the ER membrane\", \"followingEvent\": [1482825], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI4P is dephosphorylated to PI by SACM1L at the ER membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676124\", \"stIdVersion\": \"R-HSA-1676124.3\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482825\", \"stIdVersion\": \"R-HSA-1482825.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482780, \"displayName\": \"At the endoplasmic reticulum (ER) membrane, phosphatidylinos...\", \"schemaClass\": \"Summation\", \"text\": \"At the endoplasmic reticulum (ER) membrane, phosphatidylinositol (PI) is hydrolyzed, and has one of its acyl chains cleaved off, by a phospholipase A2 to form 1-acyl lysophosphatidylinositol (LPI).  The phospholipases are either cytosolic phospholipase A2 alpha/beta/zeta (PLA2G4A/D/F) (Ghomashchi et al. 2010), group XVI phospholipase A2 (PLA2G16) (Duncan et al. 2008), or Phospholipase B-like 1 (PLBD1) (Xu et al. 2009).  PLBD1 also acts as a phospholipase A2 but in addition has the propensity to hydrolyze the lysophospholipid formed in its initial reaction.\"}]}" ;
