2025, \"displayName\": \"Activation of linoleic acid to linoleoyl-CoA\", \"inferredFrom\": [2046098], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Activation of linoleic acid to linoleoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-2046098\", \"stIdVersion\": \"R-CFA-2046098.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10168919, \"displayName\": \"Activation of linoleic acid to linoleoyl-CoA\", \"inferredFrom\": [2046098], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Activation of linoleic acid to linoleoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-2046098\", \"stIdVersion\": \"R-RNO-2046098.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10046941, \"displayName\": \"Activation of linoleic acid to linoleoyl-CoA\", \"inferredFrom\": [2046098], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Activation of linoleic acid to linoleoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2046098\", \"stIdVersion\": \"R-MMU-2046098.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2046063, \"displayName\": \"LA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LA-CoA\", \"linoleoyl-CoA(4-)\", \"linoleoyl-CoA (LA-CoA)\", \"linoleoyl-CoA\", \"(9Z,12Z)-Octadecadienoyl-CoA\", \"18:2(n-6)\"], \"producedByEvent\": [2046098], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046063\", \"stIdVersion\": \"R-ALL-2046063.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 2046049, \"displayName\": \"PPi [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [2046098], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046049\", \"stIdVersion\": \"R-ALL-2046049.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 2046064, \"displayName\": \"adenosine 5'-monophosphate [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"adenosine 5'-monophosphate\", \"adenosine 5'-monophosphate(2-)\", \"AMP\"], \"producedByEvent\": [2046098], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046064\", \"stIdVersion\": \"R-ALL-2046064.5\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2046098\", \"stIdVersion\": \"R-HSA-2046098.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2045949, \"displayName\": \"The dietary essential fatty acid (EFA) linoleic acid (LA) is...\", \"schemaClass\": \"Summation\", \"text\": \"The dietary essential fatty acid (EFA) linoleic acid (LA) is activated to a high energy form known as linoleoyl-CoA by the action of long-chain acyl-CoA synthetases (ACSLs). Thioesterification of long-chain fatty acids into their acyl-CoA derivatives is considered to be the first committed step in fatty acid metabolism. Formation of acyl-CoA allows an otherwise non-reactive fatty acid to participate in biosynthetic or catabolic pathways. This acyl CoA form is converted to its longer-chain polyunsaturated products by a series of desaturation and elongation reactions (Ellis et al. 2010, Watkins 2008).\"}]}" ;
