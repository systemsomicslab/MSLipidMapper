\"pages\": \"137-74\", \"pubMedIdentifier\": 12543708, \"schemaClass\": \"LiteratureReference\", \"title\": \"The enzymes, regulation, and genetics of bile acid synthesis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12543708\", \"volume\": 72, \"year\": 2003}], \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha, 7alpha-diol is translocated from the cytosol to the mitochondrial matrix\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193436, \"displayName\": \"5beta-cholestan-3alpha, 7alpha-diol [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha, 7alpha-diol\", \"5beta-cholestane-3alpha,7alpha-diol\"], \"producedByEvent\": [193537], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193436\", \"stIdVersion\": \"R-ALL-193436.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 192160, \"displayName\": \"5beta-cholestan-7alpha-ol-3-one is reduced to 5beta-cholestan-3alpha, 7alpha-diol\", \"followingEvent\": [193537], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-7alpha-ol-3-one is reduced to 5beta-cholestan-3alpha, 7alpha-diol\", \"5beta-cholestan-7alpha-ol-3-one+ NADPH + H+ => 5beta-cholestan-3alpha, 7alpha-diol + NADP+\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192160\", \"stIdVersion\": \"R-HSA-192160.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193537\", \"stIdVersion\": \"R-HSA-193537.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193510, \"displayName\": \"5beta-cholestan-3alpha, 7alpha-diol is transported from the ...\", \"schemaClass\": \"Summation\", \"text\": \"5beta-cholestan-3alpha, 7alpha-diol is transported from the cytosol to the mitochondrial matrix. The transporter that mediates its passage across the inner mitochondrial membrane is unknown: the StAR protein that performs this function for cholesterol at the start of steroid hormone biosynthesis is excluded as StAR is not expressed in liver. Other members of the START family of transporters are candidates, however (Russell 2003).\"}]}" ;
