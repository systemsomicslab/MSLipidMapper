    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9032327], \"className\": \"CatalystActivity\", \"dbId\": 9911740, \"displayName\": \"prostaglandin transmembrane transporter activity of transporter [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"uncertain\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 9032327, \"displayName\": \"5-oxo-EPA, 15d-PGJ3 translocate from cytosol to extracellular region\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9032327], \"dbId\": 9028202, \"displayName\": \"5-oxo-EPA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5-oxo-EPA\", \"(6E,8Z,11Z,14Z,17Z)-5-oxoicosapentaenoate\", \"(6E,8Z,11Z,14Z,17Z)-5-oxoicosapentaenoic acid\", \"5-oxo-eicosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9028202\", \"stIdVersion\": \"R-ALL-9028202.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9032327], \"dbId\"