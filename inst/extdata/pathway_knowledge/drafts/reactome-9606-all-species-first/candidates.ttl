191322], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191409\", \"stIdVersion\": \"R-ALL-191409.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111294, \"displayName\": \"PPi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [191322], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111294\", \"stIdVersion\": \"R-ALL-111294.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 191382, \"displayName\": \"Isopentenyl pyrophosphate rearranges to dimethylallyl pyrophosphate\", \"followingEvent\": [191322], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Isopentenyl pyrophosphate rearranges to dimethylallyl pyrophosphate\", \"isopentenyl diphosphate => dimethylallyl diphosphate\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191382\", \"stIdVersion\": \"R-HSA-191382.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 191414, \"displayName\": \"MVD decarboxylates MVA5PP to IPPP\", \"followingEvent\": [191322], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"MVD decarboxylates MVA5PP to IPPP\", \"(R)-5-diphosphomevalonate + ATP => isopentenyl diphosphate + ADP + phosphate + CO2\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191414\", \"stIdVersion\": \"R-HSA-191414.5\"}], \"releaseDate\": \"2007-02-20\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191322\", \"stIdVersion\": \"R-HSA-191322.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 191364, \"displayName\": \"The prenyltransferase enzyme family is involved in the biosy...\", \"schemaClass\": \"Summation\", \"text\": \"The prenyltransferase enzyme family is involved in the biosynthesis of isoprenoids. Two members of this family are known to catalyse the sequential condensation of isopentenyl pyrophosphate (IPPP) to dimethylallyl pyrophosphate (DMAPP): farnesyl pyrophosphate synthase dimer (FPPS dimer) and geranylgeranyl pyrophosphate synthetase hexamer (GGPPS hexamer) (Kavanaugh et al, 2006). Both enzymes utlise Mg2+ as cofactor (Chang et al. 2021).\"}]}" ;
