    mslm:equation "PG [late endosome membrane] => BMP [late endosome membrane]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0031902\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 172574, \"definition\": \"The lipid bilayer surrounding a late endosome.\", \"displayName\": \"late endosome membrane\", \"name\": \"late endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031902\"}], \"dbId\": 1483209, \"displayName\": \"PG is converted to BMP\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1483209], \"dbId\": 1524139, \"displayName\": \"PG [late endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PG\", \"1,2-diacyl-sn-glycero-3-phospho-(1'-sn-glycerol)(1-)\", \"phosphatidylglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524139\", \"stIdVersion\": \"R-ALL-1524139.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1483114, \"displayName\": \"Transacylase formation of bis(monoacylglycerol)phosphate\", \"journal\": \"Biochim Biophys Acta\", \"pages\": \"277-86\", \"pubMedIdentifier\": 10101262, \"schemaClass\": \"LiteratureReference\", \"title\": \"Transacylase formation of bis(monoacylglycerol)phosphate\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/10101262\", \"volume\": 1437, \"year\": 1999}, {\"className\": \"LiteratureReference\", \"dbId\": 1482953, \"displayName\": \"Biological Function of the Cellular Lipid BMP-BMP as a Key Activator for Cholesterol Sorting and Membrane Digestion\", \"journal\": \"Neurochem Res\", \"pubMedIdentifier\": 21136156, \"schemaClass\": \"LiteratureReference\", \"title\": \"Biological Function of the Cellular Lipid BMP-BMP as a Key Activator for Cholesterol Sorting and Membrane Digestion\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/21136156\", \"year\": 2010}, {\"className\": \"LiteratureReference\", \"dbId\": 1483021, \"displayName\": \"Conversion of diphosphatidylglycerol to bis(monoacylglyceryl)phosphate by lysosomes\", \"journal\": \"J Lipid Res\", \"pages\": \"309-15\", \"pubMedIdentifier\": 650089, \"schemaClass\": \"LiteratureReference\", \"title\": \"Conversion of diphosphatidylglycerol to bis(monoacylglyceryl)phosphate by lysosomes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/650089\", \"volume\": 19, \"year\": 1978}, {\"className\": \"LiteratureReference\", \"dbId\": 1483042, \"displayName\": \"De novo biosynthesis of the late endosome lipid, bis(monoacylglycero)phosphate\", \"journal\": \"J Lipid Res\", \"pages\": \"1997-2008\", \"pubMedIdentifier\": 17558022, \"schemaClass\": \"LiteratureReference\", \"title\": \"De novo biosynthesis of the late endosome lipid, bis(monoacylglycero)phosphate\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17558022\", \"volume\": 48, \"year\": 2007}], \"maxDepth\": 1, \"name\": [\"PG is converted to BMP\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1498732, \"displayName\": \"BMP [late endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"BMP\", \"lysobisphosphatidic acid\", \"bis(monoacylglycerol) hydrogen phosphate\"], \"producedByEvent\": [1483209], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498732\", \"stIdVersion\": \"R-ALL-1498732.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1483218, \"displayName\": \"PG transports from the ER membrane to the late endosome membrane\", \"followingEvent\": [1483209], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PG transports from the ER membrane to the late endosome membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483218\", \"stIdVersion\": \"R-HSA-1483218.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483209\", \"stIdVersion\": \"R-HSA-1483209.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1483224, \"displayName\": \"The biosynthetic pathway of lysobisphosphatidic acid, also k...\", \"schemaClass\": \"Summation\", \"text\": \"The biosynthetic pathway of lysobisphosphatidic acid, also known as bis(monoacylglycerol) hydrogen phosphate (BMP), is still not fully understood with the <I>in vivo</I> enzymes responsible yet to be fully identified.  It appears to involve multiple steps including hydrolysis of phosphatidylglycerol (PG) by a phospholipase A2, acylation, and a reorientation of the phosphoryl ester (Poorthuis & Hostetler 1978, Heravi & Waite 1999, Hullin-Matsuda et al. 2007, Gallala & Sandhoff 2010).\"}]}" ;
