    mslm:evidenceJson "{\"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 163489, \"displayName\": \"phosphorylated HSL + H2O -> HSL + orthophosphate\", \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [163489], \"dbId\": 162472, \"displayName\": \"p-S950,S951-LIPE [cytosol]\", \"endCoordinate\": 1076, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"p-S950,S951-LIPE\", \"Phosphorylated Hormone Sensitive Lipase\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-162472\", \"stIdVersion\": \"R-HSA-162472.2\", \"startCoordinate\": 1}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [163489], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"phosphorylated HSL + H2O -> HSL + orthophosphate\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 162503, \"displayName\": \"LIPE [cytosol]\", \"endCoordinate\": 1076, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LIPE\", \"Hormone Sensitve Lipase\", \"HSL\"], \"producedByEvent\": [163489], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-162503\", \"stIdVersion\": \"R-HSA-162503.1\", \"startCoordinate\": 1}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [163489], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 163416, \"displayName\": \"hormone-sensitive lipase (HSL) + 2 ATP -> phosphorylated HSL + 2 ADP\", \"followingEvent\": [163489], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"hormone-sensitive lipase (HSL) + 2 ATP -> phosphorylated HSL + 2 ADP\"], \"releaseDate\": \"2005-06-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163416\", \"stIdVersion\": \"R-HSA-163416.3\"}], \"releaseDate\": \"2005-06-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163489\", \"stIdVersion\": \"R-HSA-163489.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 163596, \"displayName\": \"Rat HSL is inactivated by dephosphorylation. The catalyst of...\", \"schemaClass\": \"Summation\", \"text\": \"Rat HSL is inactivated by dephosphorylation. The catalyst of this reaction is unknown. Protein phosphatases 1 and 2A are both abundant in rat adipocytes and both are active on HSL (Olsson and Belfrage 1987; Wood et al. 1993). Whether these enzymes act on phosphate groups attached to serine residues  659 and 660 of HSL is unknown, however (Holm et al. 2000). Although the reaction is annotated as though the phosphatase acts on phosphorylated HSL monomers, this also is unknown: does the HSL:FABP complex dissociate before HSL dephosphorylation (as implied here), or does dephosphorylation of HSL drive dissociation of the complex?<p>Dephosphorylation of human HSL has not been studied in detail, so the human reaction is inferred from the well-studied rat one.\"}]}" ;
