 \"1-acyl LPC [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPC\", \"1-O-acyl-sn-glycero-3-phosphocholine(1+)\", \"2-lysophosphatidylcholine\", \"1-acyl-sn-glycero-3-phosphocholines\"], \"producedByEvent\": [1482856], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524028\", \"stIdVersion\": \"R-ALL-1524028.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524021, \"displayName\": \"LCFA(-) [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [1482856], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524021\", \"stIdVersion\": \"R-ALL-1524021.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1483219, \"displayName\": \"PC is exchanged with PI by PITPNB\", \"followingEvent\": [1482856], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PC is exchanged with PI by PITPNB\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483219\", \"stIdVersion\": \"R-HSA-1483219.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482961, \"displayName\": \"CDP-Cho and DAG are converted to PC by CEPT1 at the ER membrane\", \"followingEvent\": [1482856], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CDP-Cho and DAG are converted to PC by CEPT1 at the ER membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482961\", \"stIdVersion\": \"R-HSA-1482961.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482547, \"displayName\": \"1-acyl LPC is acylated to PC by LPCAT\", \"followingEvent\": [1482856], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPC is acylated to PC by LPCAT\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482547\", \"stIdVersion\": \"R-HSA-1482547.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482533, \"displayName\": \"2-acyl LPC is acylated to PC by LPCAT\", \"followingEvent\": [1482856], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"2-acyl LPC is acylated to PC by LPCAT\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482533\", \"stIdVersion\": \"R-HSA-1482533.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482856\", \"stIdVersion\": \"R-HSA-1482856.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482876, \"displayName\": \"At the endoplasmic reticulum (ER) membrane, phosphatidylchol...\", \"schemaClass\": \"Summation\", \"text\": \"At the endoplasmic reticulum (ER) membrane, phosphatidylcholine (PC) is hydrolyzed and has one of its acyl chains cleaved off by a phospholipase A2 to form 1-acyl lysophosphatidylcholine (LPC).  The phospholipases are either cytosolic phospholipase A2 alpha/beta/delta/zeta (PLA2G4A/B/D/F) (Ghomashchi et al. 2010, Clarke et al. 1991, Sharp et al. 1994, Song et al. 1999, Chiba et al. 2004), 85 kDa calcium-independent phospholipase A2 (PLA2G6) (Larsson et al. 1998, Ma et al. 1999, Larsson Forsell et al. 1999), group XVI phospholipase A2 (PLA2G16) (Duncan et al. 2008), or Phospholipase B-like 1 (PLBD1) (Xu et al. 2009).  PLBD1 acts as a phospholipase A2 but in addition has the propensity to hydrolyze the lysophospholipid formed in its initial reaction.\"}]}" ;
