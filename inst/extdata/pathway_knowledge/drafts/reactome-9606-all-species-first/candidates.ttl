    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0031901\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 171062, \"definition\": \"The lipid bilayer surrounding an early endosome.\", \"displayName\": \"early endosome membrane\", \"name\": \"early endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031901\"}], \"dbId\": 1675834, \"displayName\": \"PI(3,4)P2 is transported from the plasma membrane to the early endosome membrane\", \"goBiologicalProcess\": {\"accession\": \"0015914\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 21991, \"definition\": \"The directed movement of phospholipids into, out of or within a cell, or between cells, by means of some agent such as a transporter or pore. Phospholipids are any lipids containing phosphoric acid as a mono- or diester.\", \"displayName\": \"phospholipid transport\", \"name\": \"phospholipid transport\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0015914\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1675834], \"dbId\": 202247, \"displayName\": \"PI(3,4)P2 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2\", \"1-phosphatidyl-1D-myo-inositol 3,4-bisphosphate\", \"1-phosphatidyl-1D-myo-inositol 3,4-bisphosphates\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-202247\", \"stIdVersion\": \"R-ALL-202247.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1676088, \"displayName\": \"Detection of novel intracellular agonist responsive pools of phosphatidylinositol 3,4-bisphosphate using the TAPP1 pleckstrin homology domain in immunoelectron microscopy\", \"journal\": \"Biochem J\", \"pages\": \"653-63\", \"pubMedIdentifier\": 14604433, \"schemaClass\": \"LiteratureReference\", \"title\": \"Detection of novel intracellular agonist responsive pools of phosphatidylinositol 3,4-bisphosphate using the TAPP1 pleckstrin homology domain in immunoelectron microscopy\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/14604433\", \"volume\": 377, \"year\": 2004}, {\"className\": \"LiteratureReference\", \"dbId\": 1675803, \"displayName\": \"The type Ialpha inositol polyphosphate 4-phosphatase generates and terminates phosphoinositide 3-kinase signals on endosomes and the plasma membrane\", \"journal\": \"Mol Biol Cell\", \"pages\": \"2218-33\", \"pubMedIdentifier\": 15716355, \"schemaClass\": \"LiteratureReference\", \"title\": \"The type Ialpha inositol polyphosphate 4-phosphatase generates and terminates phosphoinositide 3-kinase signals on endosomes and the plasma membrane\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15716355\", \"volume\": 16, \"year\": 2005}], \"maxDepth\": 1, \"name\": [\"PI(3,4)P2 is transported from the plasma membrane to the early endosome membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1806238, \"displayName\": \"PI(3,4)P2 [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2\", \"1-phosphatidyl-1D-myo-inositol 3,4-bisphosphate\", \"1-phosphatidyl-1D-myo-inositol 3,4-bisphosphates\"], \"producedByEvent\": [1675834], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806238\", \"stIdVersion\": \"R-ALL-1806238.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1675949, \"displayName\": \"PI(3,4,5)P3 is dephosphorylated to PI(3,4)P2 by INPP5[2] at the plasma membrane\", \"followingEvent\": [1675834], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4,5)P3 is dephosphorylated to PI(3,4)P2 by INPP5[2] at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675949\", \"stIdVersion\": \"R-HSA-1675949.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676109, \"displayName\": \"PI4P is phosphorylated to PI(3,4)P2 by PI3K3C[2] at the plasma membrane\", \"followingEvent\": [1675834], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI4P is phosphorylated to PI(3,4)P2 by PI3K3C[2] at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676109\", \"stIdVersion\": \"R-HSA-1676109.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676145, \"displayName\": \"PI3P is phosphorylated to PI(3,4)P2 by PIP4K2/5K1 at the plasma membrane\", \"followingEvent\": [1675834], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI3P is phosphorylated to PI(3,4)P2 by PIP4K2/5K1 at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676145\", \"stIdVersion\": \"R-HSA-1676145.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675834\", \"stIdVersion\": \"R-HSA-1675834.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1676049, \"displayName\": \"In mice, phosphatidylinositol 3,4-bisphosphate (PI(3,4)P2) t...\", \"schemaClass\": \"Summation\", \"text\": \"In mice, phosphatidylinositol 3,4-bisphosphate (PI(3,4)P2) translocates from the plasma membrane to the early endosome membrane (Watt et al. 2004).  A similar event has also been detected in cells from <I>Chlorocebus sabaeus</I> (Green Monkey) (Ivetac et al. 2005).  In humans this event is inferred from the other two occurrences.\"}]}" ;
