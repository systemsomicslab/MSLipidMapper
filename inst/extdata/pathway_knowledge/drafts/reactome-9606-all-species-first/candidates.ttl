\"transition\", \"className\": \"Reaction\", \"dbId\": 10529864, \"displayName\": \"BDH2 dehydrogenates 3HBA\", \"inferredFrom\": [5696457], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"BDH2 dehydrogenates 3HBA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-5696457\", \"stIdVersion\": \"R-SSC-5696457.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10415814, \"displayName\": \"BDH2 dehydrogenates 3HBA\", \"inferredFrom\": [5696457], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"BDH2 dehydrogenates 3HBA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-5696457\", \"stIdVersion\": \"R-BTA-5696457.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10303673, \"displayName\": \"BDH2 dehydrogenates 3HBA\", \"inferredFrom\": [5696457], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"BDH2 dehydrogenates 3HBA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-5696457\", \"stIdVersion\": \"R-CFA-5696457.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10193329, \"displayName\": \"BDH2 dehydrogenates 3HBA\", \"inferredFrom\": [5696457], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"BDH2 dehydrogenates 3HBA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5696457\", \"stIdVersion\": \"R-RNO-5696457.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10070079, \"displayName\": \"BDH2 dehydrogenates 3HBA\", \"inferredFrom\": [5696457], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"BDH2 dehydrogenates 3HBA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-5696457\", \"stIdVersion\": \"R-MMU-5696457.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29666, \"displayName\": \"ACA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ACA\", \"acetoacetate\", \"3-Oxobutanoate\"], \"producedByEvent\": [5696457], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29666\", \"stIdVersion\": \"R-ALL-29666.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [5696457], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 73473, \"displayName\": \"NADH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [5696457], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-73473\", \"stIdVersion\": \"R-ALL-73473.5\"}], \"releaseDate\": \"2015-09-22\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5696457\", \"stIdVersion\": \"R-HSA-5696457.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5696451, \"displayName\": \"Ketone bodies (KBs) are an energy source utilised by mammals...\", \"schemaClass\": \"Summation\", \"text\": \"Ketone bodies (KBs) are an energy source utilised by mammals, the terminal oxidation of which (termed ketogenesis) is most active during fasting states or starvation. This process normally occurs in the mitochondria of cells. Cytoplasmic de novo lipogenesis and cholesterol synthesis are nonoxidative metabolic fates of ketone bodies.\\n3-hydroxybutyrate dehydrogenase type 2 (BDH2 aka DHRS6) is a cytosolic, tetrameric enzyme that may have a (as yet undetermined) physiological role in ketone body metabolism, either for energy supply or to generate precursors for lipid and sterol synthesis. The KB substrate (R)-3-hydroxybutyrate (3HBA) is dehydrogenated into acetoacetate (ACA) which can be further metabolised to acetyl-CoA (Guo et al. 2006). \"}]}" ;
