me\": \"Chemical Compound\", \"dbId\": 30209, \"displayName\": \"atROL [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"atROL\", \"all-trans-retinol\", \"Retinol\", \"Vitamin A\", \"Vitamin A1\"], \"producedByEvent\": [8848355], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-30209\", \"stIdVersion\": \"R-ALL-30209.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 8848337, \"displayName\": \"PALM(-) [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PALM(-)\", \"hexadecanoate\", \"palmitate\"], \"producedByEvent\": [8848355], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8848337\", \"stIdVersion\": \"R-ALL-8848337.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [8848355], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"regulatedBy\": [{\"className\": \"NegativeRegulation\", \"dbId\": 8848342, \"displayName\": \"Negative regulation by 'PLIN3 [cytosol]'\", \"regulatedEntity\": [8848355], \"schemaClass\": \"NegativeRegulation\", \"stId\": \"R-HSA-8848342\", \"stIdVersion\": \"R-HSA-8848342.1\"}], \"regulationReference\": [{\"className\": \"RegulationReference\", \"dbId\": 9641509, \"displayName\": \"Negative regulation by 'PLIN3 [cytosol]' Molecular screening for GS2 lipase regulators: inhibition of keratinocyte retinylester hydrolysis by TIP47\", \"schemaClass\": \"RegulationReference\"}], \"releaseDate\": \"2016-03-23\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8848355\", \"stIdVersion\": \"R-HSA-8848355.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8848357, \"displayName\": \"PNPLA4 (patatin-like phospholipase domain-containing protein...\", \"schemaClass\": \"Summation\", \"text\": \"PNPLA4 (patatin-like phospholipase domain-containing protein 4, also known as GS2 and iPLA2(eta)) catalyzes the hydrolysis of atR-PALM (all-trans retinyl palmitate) to atROL (all-trans retinol) and a molecule of PALM (palmitate) (Gao and Simon 2006; Gao and Simon 2007). The reaction is inhibited by cytosolic PLIN3 (perilipin 3). The enzyme may also catalyze transacylation reactions to form retinyl esters or promote the activity of other enzymes that do so (Gao et al. 2009).\"}]}" ;
