    mslm:equation "GC [extracellular region] + VD3 [extracellular region] => GC:VD3 [extracellular region]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [209738], \"className\": \"CatalystActivity\", \"dbId\": 9959976, \"displayName\": \"molecular carrier activity of GC [extracellular region]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 209738, \"displayName\": \"VD3 binds GC\", \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [209738], \"dbId\": 209886, \"displayName\": \"GC [extracellular region]\", \"endCoordinate\": 474, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GC\", \"Vitamin D-binding protein (DBP)\", \"VTDB_HUMAN\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-209886\", \"stIdVersion\": \"R-HSA-209886.1\", \"startCoordinate\": 17}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [209738], \"dbId\": 209767, \"displayName\": \"VD3 [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"VD3\", \"calciol\", \"Vitamin D3\", \"Cholecalciferol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-209767\", \"stIdVersion\": \"R-ALL-209767.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 209916, \"displayName\": \"A structural basis for the unique binding features of the human vitamin D-binding protein\", \"journal\": \"Nat Struct Biol\", \"pages\": \"131-6\", \"pubMedIdentifier\": 11799400, \"schemaClass\": \"LiteratureReference\", \"title\": \"A structural basis for the unique binding features of the human vitamin D-binding protein\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11799400\", \"volume\": 9, \"year\": 2002}, {\"className\": \"LiteratureReference\", \"dbId\": 9008525, \"displayName\": \"Comparison of Two ELISA Methods and Mass Spectrometry for Measurement of Vitamin D-Binding Protein: Implications for the Assessment of Bioavailable Vitamin D Concentrations Across Genotypes\", \"journal\": \"J. Bone Miner. Res.\", \"pages\": \"1128-36\", \"pubMedIdentifier\": 27250744, \"schemaClass\": \"LiteratureReference\", \"title\": \"Comparison of Two ELISA Methods and Mass Spectrometry for Measurement of Vitamin D-Binding Protein: Implications for the Assessment of Bioavailable Vitamin D Concentrations Across Genotypes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/27250744\", \"volume\": 31, \"year\": 2016}], \"maxDepth\": 1, \"name\": [\"VD3 binds GC\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10757545, \"displayName\": \"VD3 binds GC\", \"inferredFrom\": [209738], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"VD3 binds GC\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-209738\", \"stIdVersion\": \"R-GGA-209738.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10674076, \"displayName\": \"VD3 binds GC\", \"inferredFrom\": [209738], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"VD3 binds GC\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-209738\", \"stIdVersion\": \"R-XTR-209738.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10584101, \"displayName\": \"VD3 binds GC\", \"inferredFrom\": [209738], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"VD3 binds GC\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-209738\", \"stIdVersion\": \"R-DRE-209738.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10475275, \"displayName\": \"VD3 binds GC\", \"inferredFrom\": [209738], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"VD3 binds GC\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-209738\", \"stIdVersion\": \"R-SSC-209738.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10360438, \"displayName\": \"VD3 binds GC\", \"inferredFrom\": [209738], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"VD3 binds GC\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-209738\", \"stIdVersion\": \"R-BTA-209738.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10253072, \"displayName\": \"VD3 binds GC\", \"inferredFrom\": [209738], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"VD3 binds GC\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-209738\", \"stIdVersion\": \"R-CFA-209738.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10133481, \"displayName\": \"VD3 binds GC\", \"inferredFrom\": [209738], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"VD3 binds GC\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-209738\", \"stIdVersion\": \"R-RNO-209738.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10011938, \"displayName\": \"VD3 binds GC\", \"inferredFrom\": [209738], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"VD3 binds GC\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-209738\", \"stIdVersion\": \"R-MMU-209738.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 352339, \"displayName\": \"GC:VD3 [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GC:VD3\"], \"producedByEvent\": [209738], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-352339\", \"stIdVersion\": \"R-HSA-352339.1\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 8963872, \"displayName\": \"VD3 translocates from ER membrane to extracellular region\", \"followingEvent\": [209738], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"VD3 translocates from ER membrane to extracellular region\"], \"releaseDate\": \"2017-03-27\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8963872\", \"stIdVersion\": \"R-HSA-8963872.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2017-09-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-209738\", \"stIdVersion\": \"R-HSA-209738.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 209753, \"displayName\": \"Vitamin D metabolites such as VD3 are lipophilic and must be...\", \"schemaClass\": \"Summation\", \"text\": \"Vitamin D metabolites such as VD3 are lipophilic and must be transported in the circulation bound to plasma proteins. Vitamin D3 is transported to the liver bound to a plasma protein called vitamin D binding protein (GC aka DBP) (Verboven et al. 2002). GC is a 58 kDa circulating glycoprotein that transports vitamin D metabolites. The vast majority of vitamin D metabolites circulate bound to GC (85–90%), some bound to albumin (10–15%), with the remainder (<1%) circulating in the free form. GC has more than 1000-fold stronger binding affinity for vitamin D metabolites than albumin. Thus, the albumin-bound and free fractions of vitamin D metabolites are considered bioavailable (Denburg et al. 2016).\"}]}" ;
