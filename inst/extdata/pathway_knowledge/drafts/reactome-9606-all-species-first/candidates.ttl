: false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"UGCG transfers glucose to ceramide\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1638104\", \"stIdVersion\": \"R-BTA-1638104.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10163372, \"displayName\": \"UGCG transfers glucose to ceramide\", \"inferredFrom\": [1638104], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"UGCG transfers glucose to ceramide\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1638104\", \"stIdVersion\": \"R-RNO-1638104.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10041299, \"displayName\": \"UGCG transfers glucose to ceramide\", \"inferredFrom\": [1638104], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"UGCG transfers glucose to ceramide\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1638104\", \"stIdVersion\": \"R-MMU-1638104.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1660674, \"displayName\": \"GlcCer [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GlcCer\", \"beta-D-glucosyl-N-acylsphingosine\", \"Glucosylceramide\", \"Glucocerebroside\", \"D-glucosyl-N-acylsphingosine\", \"D-glucosy-N-acylsphingosine\", \"D-glucosyl-N-acylsphingoid\"], \"producedByEvent\": [1638104], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1660674\", \"stIdVersion\": \"R-ALL-1660674.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 205687, \"displayName\": \"UDP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP\", \"UDP(3-)\", \"uridine 5'-diphosphate\"], \"producedByEvent\": [1638104], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-205687\", \"stIdVersion\": \"R-ALL-205687.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [1638104], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1638104\", \"stIdVersion\": \"R-HSA-1638104.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1638105, \"displayName\": \"Ceramide glucosyltransferase (UGCG, CGT, GCS) catalyzes the ...\", \"schemaClass\": \"Summation\", \"text\": \"Ceramide glucosyltransferase (UGCG, CGT, GCS) catalyzes the first glycosylation step in glycosphingolipid biosynthesis by transferring glucose to ceramide (Ichikawa et al. 1996). UGCG is localized on the cytosolic part of the cis-Golgi membrane. The cytosolic PLEKHA8 (FAPP2) will transport the product GlcCer to the plasma membrane. GlcCer is also transported to the inside of the Golgi membrane by MDR1 (\\\"flipping\\\"; Fabiana de Rosa et al., 2004; Eckford & Sharom, 2005; reviewed by Liu & Li, 2013).\"}]}" ;
