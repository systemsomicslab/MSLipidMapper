Entity\", \"stId\": \"R-ALL-1806224\", \"stIdVersion\": \"R-ALL-1806224.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [6809944], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 6809782, \"displayName\": \"Multi-level regulation of myotubularin-related protein-2 phosphatase activity by myotubularin-related protein-13/set-binding factor-2\", \"journal\": \"Hum. Mol. Genet.\", \"pages\": \"569-79\", \"pubMedIdentifier\": 16399794, \"schemaClass\": \"LiteratureReference\", \"title\": \"Multi-level regulation of myotubularin-related protein-2 phosphatase activity by myotubularin-related protein-13/set-binding factor-2\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/16399794\", \"volume\": 15, \"year\": 2006}], \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI5P by the MTMR2:SBF2 tetramer at the plasma membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1806240, \"displayName\": \"PI5P [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI5P\", \"1-phosphatidyl-1D-myo-inositol 5-phosphate(3-)\", \"1-phosphatidyl-1D-myo-inositol 5-phosphate\"], \"producedByEvent\": [6809944], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806240\", \"stIdVersion\": \"R-ALL-1806240.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [6809944], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": 