\", \"dbId\": 10039428, \"displayName\": \"PA is converted to CDP-DAG by CDS2\", \"inferredFrom\": [1483165], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PA is converted to CDP-DAG by CDS2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1483165\", \"stIdVersion\": \"R-MMU-1483165.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1524064, \"displayName\": \"CDP-DAG [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CDP-DAG\", \"CDP-diacylglycerol(2-)\", \"Cytidine diphosphate diacylglycerol\", \"CDP-diacylglycerol\"], \"producedByEvent\": [1483165], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524064\", \"stIdVersion\": \"R-ALL-1524064.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 159450, \"displayName\": \"PPi [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [1483165], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-159450\", \"stIdVersion\": \"R-ALL-159450.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1483099, \"displayName\": \"PA translocates from the outer to the inner mitochondrial membrane\", \"followingEvent\": [1483165], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PA translocates from the outer to the inner mitochondrial membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483099\", \"stIdVersion\": \"R-HSA-1483099.3\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483165\", \"stIdVersion\": \"R-HSA-1483165.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482942, \"displayName\": \"At the inner mitochondrial (IM) membrane, phosphatidate cyti...\", \"schemaClass\": \"Summation\", \"text\": \"At the inner mitochondrial (IM) membrane, phosphatidate cytidylyltransferase 2 (CDS2) converts phosphatidic acid (PA) and cytidine triphosphate (CTP) into cytidine diphosphate-diacylglycerol (CDP-DAG).  Both ER and mitochondrial membranes have the capability to synthesise cytidine diphosphate-diacylglycerol (CDP-DAG) with phosphatidate cytidylyltransferase 1 and 2 (CDS1 and CDS2) (Lykidis et al. 1997, Schlame & Haldar 1993).  However, transport of CDP-DAG between organelles cannot be ruled out (Stuhne-Sekalec et al. 1986).\"}]}" ;
