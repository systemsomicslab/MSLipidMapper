<https://reactome.org/content/detail/R-HSA-188467> a mslm:LipidReaction ;
    rdfs:label "Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "G3P [mitochondrial matrix] + FAD [mitochondrial matrix] => DHAP [mitochondrial matrix] + FADH2 [mitochondrial matrix]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [188467], \"className\": \"CatalystActivity\", \"dbId\": 188456, \"displayName\": \"glycerol-3-phosphate dehydrogenase (quinone) activity of GPD2 [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690695, \"displayName\": \"RHEA:31284\", \"identifier\": \"31284\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/31284\"}], \"dbId\": 188467, \"displayName\": \"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\", \"goBiologicalProcess\": {\"accession\": \"0006127\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 15824, \"definition\": \"The process of transferring reducing equivalents from NADH in the cytosol into the mitochondria via glycerol-3-phosphate. Cytosolic glycerol-3-phosphate dehydrogenase uses NADH to convert dihydroxyacetone phosphate (DHAP) to glycerol-3-phosphate (G3P) in the cytosol; G3P then diffuses into the mitochondria where mitochondrial glycerol-3-phosphate dehydrogenase uses FAD to convert G3P back to DHAP; the electrons on the reduced FADH2 are then available for use in the electron transport chain, and DHAP returns to the cytosol to complete the cycle.\", \"displayName\": \"glycerol-3-phosphate shuttle\", \"name\": \"glycerol-3-phosphate shuttle\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006127\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [188467], \"dbId\": 188458, \"displayName\": \"G3P [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"G3P\", \"sn-glycerol 3-phosphate(2-)\", \"Glycerol-3-phosphate\", \"sn-glycerol 3-phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-188458\", \"stIdVersion\": \"R-ALL-188458.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [188467], \"dbId\": 113596, \"displayName\": \"FAD [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FAD\", \"FAD(3-)\", \"Flavin adenine dinucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113596\", \"stIdVersion\": \"R-ALL-113596.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"chapterTitle\": \"21: Oxidative Phosphorylation\", \"className\": \"Book\", \"dbId\": 188450, \"displayName\": \"Biochemistry, 4th ed Stryer, L 21: Oxidative Phosphorylation 0716720094\", \"isbn\": \"0716720094\", \"pages\": \"548-549\", \"schemaClass\": \"Book\", \"title\": \"Biochemistry, 4th ed\", \"year\": 1995}, {\"className\": \"LiteratureReference\", \"dbId\": 188468, \"displayName\": \"The sequence of a human mitochondrial glycerol-3-phosphate dehydrogenase-encoding cDNA\", \"journal\": \"Gene\", \"pages\": \"417-8\", \"pubMedIdentifier\": 7821823, \"schemaClass\": \"LiteratureReference\", \"title\": \"The sequence of a human mitochondrial glycerol-3-phosphate dehydrogenase-encoding cDNA\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/7821823\", \"volume\": 150, \"year\": 1994}, {\"className\": \"LiteratureReference\", \"dbId\": 188448, \"displayName\": \"Molecular cloning of human mitochondrial glycerophosphate dehydrogenase gene: genomic structure, chromosomal localization, and existence of a pseudogene\", \"journal\": \"Biochem Biophys Res Commun\", \"pages\": \"481-6\", \"pubMedIdentifier\": 8687421, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular cloning of human mitochondrial glycerophosphate dehydrogenase gene: genomic structure, chromosomal localization, and existence of a pseudogene\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8687421\", \"volume\": 223, \"year\": 1996}, {\"className\": \"LiteratureReference\", \"dbId\": 188455, \"displayName\": \"Enzymatic, metabolic and secretory patterns in human islets of type 2 (non-insulin-dependent) diabetic patients\", \"journal\": \"Diabetologia\", \"pages\": \"177-81\", \"pubMedIdentifier\": 8163052, \"schemaClass\": \"LiteratureReference\", \"title\": \"Enzymatic, metabolic and secretory patterns in human islets of type 2 (non-insulin-dependent) diabetic patients\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8163052\", \"volume\": 37, \"year\": 1994}], \"maxDepth\": 1, \"name\": [\"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11120418, \"displayName\": \"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\", \"inferredFrom\": [188467], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\"], \"rel