emaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676185, \"displayName\": \"PI is phosphorylated to PI4P by PI4KA/2A/2B at the Golgi membrane\", \"followingEvent\": [1676133], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI is phosphorylated to PI4P by PI4KA/2A/2B at the Golgi membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676185\", \"stIdVersion\": \"R-HSA-1676185.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1675883, \"displayName\": \"PI is phosphorylated to PI4P by PI4KB at the Golgi membrane\", \"followingEvent\": [1676133], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI is phosphorylated to PI4P by PI4KB at the Golgi membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675883\", \"stIdVersion\": \"R-HSA-1675883.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676204, \"displayName\": \"PI(3,4)P2 is dephosphorylated to PI4P by TPTE2 at the Golgi membrane\", \"followingEvent\": [1676133], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2 is dephosphorylated to PI4P by TPTE2 at the Golgi membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676204\", \"stIdVersion\": \"R-HSA-1676204.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1675824, \"displayName\": \"PI(4,5)P2 is dephosphorylated to PI4P by OCRL/INPP5E at the Golgi membrane\", \"followingEvent\": [1676133], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2 is dephosphorylated to PI4P by OCRL/INPP5E at the Golgi membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675824\", \"stIdVersion\": \"R-HSA-1675824.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676133\", \"stIdVersion\": \"R-HSA-1676133.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1675872, \"displayName\": \"At the Golgi membrane, phosphatidylinositide phosphatase SAC...\", \"schemaClass\": \"Summation\", \"text\": \"At the Golgi membrane, phosphatidylinositide phosphatase SAC1 (SACM1L) efficiently dephosphorylates phosphatidylinositol 4-phosphate (PI4P), and to a lesser extent phosphatidylinositol 3-phosphate (PI3P), to phosphatidylinositol (PI).  No significant activity of this enzyme towards phosphatidylinositol 3,5-bisphosphate (PI(3,5)P2) was detected (Rohde et al. 2003).\"}]}" ;
