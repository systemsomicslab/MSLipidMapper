e\": \"Reaction\", \"dbId\": 10215991, \"displayName\": \"ALOX15 oxidises 17(S)-Hp-DHA to PDX\", \"inferredFrom\": [9024872], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX15 oxidises 17(S)-Hp-DHA to PDX\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9024872\", \"stIdVersion\": \"R-RNO-9024872.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092779, \"displayName\": \"ALOX15 oxidises 17(S)-Hp-DHA to PDX\", \"inferredFrom\": [9024872], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX15 oxidises 17(S)-Hp-DHA to PDX\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9024872\", \"stIdVersion\": \"R-MMU-9024872.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9024883, \"displayName\": \"PDX [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PDX\", \"(4Z,7Z,10S,11E,13Z,15E,17S,19Z)-10,17-dihydroxydocosahexaenoic acid\", \"10(S),17(S)-dihydroxy-docosa-4Z,7Z,11E,13Z,15E,19Z-hexaenoic acid\"], \"producedByEvent\": [9024872], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024883\", \"stIdVersion\": \"R-ALL-9024883.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9020275, \"displayName\": \"ALOX15 oxidises DHA to 17(S)-Hp-DHA\", \"followingEvent\": [9024872], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX15 oxidises DHA to 17(S)-Hp-DHA\", \"4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoate + O2 => (17S)-hydroperoxy-(4Z,7Z,10Z,13Z,15E,19Z)-docosahexaenoate\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9020275\", \"stIdVersion\": \"R-HSA-9020275.3\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9024872\", \"stIdVersion\": \"R-HSA-9024872.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9024878, \"displayName\": \"15-lipoxygenase (ALOX15) can mediate a second lipoxygenation...\", \"schemaClass\": \"Summation\", \"text\": \"15-lipoxygenase (ALOX15) can mediate a second lipoxygenation reaction where 17(S)-Hp-DHA is oxidised to the production of the protectin D1 (PD1) isomer PDX (Hong et al. 2003, Serhan et al. 2006, Chen et al. 2009). The chemical structure of PDX is 10(S),17(S)-dihydroxy-docosahexa-4Z,7Z,11E,13Z,15E,19Z-enoic acid. It differs from PD1, having E,Z,E geometry (PDX) instead of E,E,Z (PD1) and S configuration at carbon 10 instead of R (Chen et al. 2009). PDX is not a major product of leukocytes and has low potency compared to PD1 as a regulator of polymorphonuclear leukocyte (PMN) infiltration (Serhan et al. 2006).\"}]}" ;
