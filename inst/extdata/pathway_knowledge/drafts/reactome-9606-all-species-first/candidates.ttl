me\": [\"SMPD1 hydrolyzes SPHM\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1605797\", \"stIdVersion\": \"R-BTA-1605797.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10162992, \"displayName\": \"SMPD1 hydrolyzes SPHM\", \"inferredFrom\": [1605797], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SMPD1 hydrolyzes SPHM\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1605797\", \"stIdVersion\": \"R-RNO-1605797.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10040826, \"displayName\": \"SMPD1 hydrolyzes SPHM\", \"inferredFrom\": [1605797], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SMPD1 hydrolyzes SPHM\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1605797\", \"stIdVersion\": \"R-MMU-1605797.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605673, \"displayName\": \"CERA [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CERA\", \"N-acylsphingoid\", \"Ceramide\", \"N-acylsphingosine\"], \"producedByEvent\": [1605797], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605673\", \"stIdVersion\": \"R-ALL-1605673.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1605750, \"displayName\": \"ChoP [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ChoP\", \"choline phosphate(1-)\", \"Choline phosphate\", \"phosphocholine\"], \"producedByEvent\": [1605797], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605750\", \"stIdVersion\": \"R-ALL-1605750.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 428040, \"displayName\": \"H+ [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [1605797], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428040\", \"stIdVersion\": \"R-ALL-428040.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605797\", \"stIdVersion\": \"R-HSA-1605797.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1605662, \"displayName\": \"Sphingomyelin phosphodiesterase (SMPD1), also called acid sp...\", \"schemaClass\": \"Summation\", \"text\": \"Sphingomyelin phosphodiesterase (SMPD1), also called acid sphingomyelinase (ASM), is a lysosomal phosphodiesterase that hydrolyses sphingomyelin to ceramide and phosphocholine (Schuchman et al. 1991, Schuchman et al. 1992). Defects in SMPD1 are the cause of two types of Niemann-Pick disease. Type A (NPDA, Niemann-Pick disease classical infantile form) (MIM:257200) (Ferlinz et al. 1991) and type B (NPDB, Niemann-Pick disease visceral form) (MIM:607616) (Rodriguez-Pascau et al. 2009).\"}]}" ;
