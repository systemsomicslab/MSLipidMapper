"R-CFA-193746.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10128638, \"displayName\": \"4-cholesten-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-7alpha,24(S)-diol-3-one\", \"inferredFrom\": [193746], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4-cholesten-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-7alpha,24(S)-diol-3-one\", \"4-cholesten-7alpha,24(S)-diol-3-one + NADPH + H+ => 5beta-cholestan-7alpha,24(S)-diol-3-one + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-193746\", \"stIdVersion\": \"R-RNO-193746.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007637, \"displayName\": \"4-cholesten-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-7alpha,24(S)-diol-3-one\", \"inferredFrom\": [193746], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4-cholesten-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-7alpha,24(S)-diol-3-one\", \"4-cholesten-7alpha,24(S)-diol-3-one + NADPH + H+ => 5beta-cholestan-7alpha,24(S)-diol-3-one + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193746\", \"stIdVersion\": \"R-MMU-193746.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193760, \"displayName\": \"5beta-cholestan-7alpha,24(S)-diol-3-one [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-7alpha,24(S)-diol-3-one\", \"(24S)-7alpha,24-dihydroxy-5beta-cholestan-3-one\"], \"producedByEvent\": [193746], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193760\", \"stIdVersion\": \"R-ALL-193760.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [193746], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193789, \"displayName\": \"Cholest-5-ene-3beta,7alpha,24(S)-triol is oxidized and isomerized to 4-cholesten-7alpha,24(S)-diol-3-one\", \"followingEvent\": [193746], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Cholest-5-ene-3beta,7alpha,24(S)-triol is oxidized and isomerized to 4-cholesten-7alpha,24(S)-diol-3-one\", \"(24S)-7alpha-dihydroxycholesterol + NAD(+) => (24S)-7alpha,24-dihydroxycholest-4-en-3-one + H(+) + NADH\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193789\", \"stIdVersion\": \"R-HSA-193789.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193746\", \"stIdVersion\": \"R-HSA-193746.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193742, \"displayName\": \"4-Cholesten-7alpha,24(S)-diol-3-one, NADPH, and H+ react to ...\", \"schemaClass\": \"Summation\", \"text\": \"4-Cholesten-7alpha,24(S)-diol-3-one, NADPH, and H+ react to form 5beta-cholestan-7alpha,24(S)-diol-3-one and NADP+. This reaction is catalyzed by AKR1D1 (3-oxo-5-beta-steroid 4-dehydrogenase). AKR1D1 is localized to the cytosol, and in the course of the reaction its steroid substrate moves from the endoplasmic reticulum membrane to the cytosol. It is unclear whether this translocation results simply from its increased hydrophilicity or is mediated by the enzyme or another transport protein (Russell 2003).\"}]}" ;
