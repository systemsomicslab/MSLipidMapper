", \"stIdVersion\": \"R-ALL-1605637.3\"}, {\"className\": \"Complex\", \"dbId\": 9840792, \"displayName\": \"GM2A:GA2 [lysosomal lumen]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"GM2A:GA2\"], \"producedByEvent\": [9840795], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840792\", \"stIdVersion\": \"R-HSA-9840792.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1605717, \"displayName\": \"GM2A binds and mobilizes ligands\", \"followingEvent\": [9840795], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GM2A binds and mobilizes ligands\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605717\", \"stIdVersion\": \"R-HSA-1605717.3\"}], \"releaseDate\": \"2023-09-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840795\", \"stIdVersion\": \"R-HSA-9840795.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1605722, \"displayName\": \"Ganglioside GA1 (asialo-GM1, ganglio-N-tetraosylceramide) is...\", \"schemaClass\": \"Summation\", \"text\": \"Ganglioside GA1 (asialo-GM1, ganglio-N-tetraosylceramide) is a ganglioside that accumulates in nerve cells in GM1-gangliosidosis, showing that GA1 is hydrolyzed by GLB1, probably to GA2 (Caciotti et al., 2005). Since GLB1 acts on solubilized gangliosides, we assume GA1 and GA2 are bound to GM2A during the process. GLB1L, GLB1L2, and GLB1L3 are gene products with nearly identical protein sequences to GLB1 and may be able to perform the same function.\"}]}" ;
