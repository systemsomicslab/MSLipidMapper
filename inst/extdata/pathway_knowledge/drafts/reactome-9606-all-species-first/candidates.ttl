\": \"Reaction\", \"dbId\": 10068480, \"displayName\": \"SCD desaturates ST-CoA to OLE-CoA\", \"inferredFrom\": [5690565], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SCD desaturates ST-CoA to OLE-CoA\", \"2 Fe(II)-(cytochrome b5) + 2 H(+) + O2 + octadecanoyl-CoA => (9Z)-octadecenoyl-CoA + 2 Fe(III)-(cytochrome b5) + 2 H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-5690565\", \"stIdVersion\": \"R-MMU-5690565.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 5690558, \"displayName\": \"OLE-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"OLE-CoA\", \"oleoyl-CoA(4-)\"], \"producedByEvent\": [5690565], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5690558\", \"stIdVersion\": \"R-ALL-5690558.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 4085425, \"displayName\": \"Fe(3+)Cb5 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Fe(3+)Cb5\", \"ferricytochrome b5\"], \"producedByEvent\": [5690565, 5690565], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-4085425\", \"stIdVersion\": \"R-ALL-4085425.3\"}, 4085425, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [5690565, 5690565], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 548831, \"displayName\": \"TECR,TECRL dehydrogenate TOD-CoA to ST-CoA\", \"followingEvent\": [5690565], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"TECR,TECRL dehydrogenate TOD-CoA to ST-CoA\", \"(2E)-octadecenoyl-CoA + H(+) + NADPH => NADP(+) + octadecanoyl-CoA\", \"trans-octadec-2-enoyl-CoA + NADPH + H+ => stearoyl-CoA + NADP+\"], \"releaseDate\": \"2008-12-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-548831\", \"stIdVersion\": \"R-HSA-548831.4\"}], \"releaseDate\": \"2015-09-22\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5690565\", \"stIdVersion\": \"R-HSA-5690565.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5690555, \"displayName\": \"Acyl-CoA desaturase (SCD), located on the ER membrane, is th...\", \"schemaClass\": \"Summation\", \"text\": \"Acyl-CoA desaturase (SCD), located on the ER membrane, is the terminal enzyme of the liver microsomal stearyl-CoA desaturase system and is the rate-limiting enzyme in the cellular synthesis of monounsaturated fatty acids (MUFAs) from saturated fatty acids. SCD utilises O2 and electrons from reduced ferrocytochrome b5 (Fe(2+)Cb5) to catalyse the insertion of a double bond into a range of fatty acyl-CoA substrates. This example shows stearoyl-CoA (ST-CoA) desaturation to oleoyl-CoA (OLE-CoA) (Li et al. 1994, Zhang et al. 1999).  Studies of tagged recombinant enzyme overexpressed in transiently transfected cells suggest that the enzyme forms dimers and higher oligomers (Zhang et al. 2005).\"}]}" ;
