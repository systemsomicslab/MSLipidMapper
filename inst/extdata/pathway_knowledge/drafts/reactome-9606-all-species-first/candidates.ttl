    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005758\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17927, \"definition\": \"The region between the inner and outer lipid bilayers of the mitochondrial envelope.\", \"displayName\": \"mitochondrial intermembrane space\", \"name\": \"mitochondrial intermembrane space\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005758\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690125, \"displayName\": \"RHEA:34959\", \"identifier\": \"34959\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/34959\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9911367, \"displayName\": \"RHEA:34959\", \"identifier\": \"34959\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/34959\"}], \"dbId\": 8949399, \"displayName\": \"CAR translocates from the cytosol to the mitochondrial intermembrane space\", \"goBiologicalProcess\": {\"accession\": \"0170036\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 9910499, \"definition\": \"The directed movement of substances from the cytosol into the mitochondrion.\", \"displayName\": \"import into the mitochondrion\", \"name\": \"import into the mitochondrion\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0170036\"}, \"input\": [{\"className\": \