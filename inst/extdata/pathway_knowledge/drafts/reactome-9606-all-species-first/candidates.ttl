: \"Chemical Compound\", \"dbId\": 113532, \"displayName\": \"CH3CHO [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CH3CHO\", \"acetaldehyde\", \"Ethanal\"], \"producedByEvent\": [5696415], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113532\", \"stIdVersion\": \"R-ALL-113532.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 5693978, \"displayName\": \"NH3 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NH3\", \"ammonia\"], \"producedByEvent\": [5696415], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5693978\", \"stIdVersion\": \"R-ALL-5693978.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113548, \"displayName\": \"Pi [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\"], \"producedByEvent\": [5696415], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113548\", \"stIdVersion\": \"R-ALL-113548.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1483222, \"displayName\": \"ETA is phosphorylated to PETA by CHK/ETNK\", \"followingEvent\": [5696415], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ETA is phosphorylated to PETA by CHK/ETNK\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483222\", \"stIdVersion\": \"R-HSA-1483222.2\"}], \"releaseDate\": \"2015-09-22\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5696415\", \"stIdVersion\": \"R-HSA-5696415.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5696421, \"displayName\": \"In mitochondria, ethanolamine-phosphate phospho-lyase and 5-...\", \"schemaClass\": \"Summation\", \"text\": \"In mitochondria, ethanolamine-phosphate phospho-lyase and 5-phosphohydroxy-L-lysine phospho-lyase (ETNPPL and PHYKPL respectively) are two closely related pyridoxal-phosphate-dependent, homotetrameric  ammoniophospholyases that hydrolyse phosphoethanolamine (PETA) and 5-phosphohydroxylysine (5PHL) respectively (Veiga-da-Cunha et al. 2012). PETA is a component and a precursor of phospholipids whereas 5PHL is a breakdown product of collagen. ETNPPL utilises one pyridoxal 5'-phosphate (PXLP) as cofactor per subunit. \"}]}" ;
