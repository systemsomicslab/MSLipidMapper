    mslm:equation "HXOL [cytosol] => HXOL [peroxisomal matrix]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 8848586, \"displayName\": \"Transport of cytosolic HXOL to the peroxisome\", \"goBiologicalProcess\": {\"accession\": \"0015919\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 25870, \"definition\": \"The directed movement of substances to, from or across the peroxisomal membrane.\", \"displayName\": \"peroxisomal membrane transport\", \"name\": \"peroxisomal membrane transport\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0015919\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8848586], \"dbId\": 8848577, \"displayName\": \"HXOL [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HXOL\", \"hexadecan-1-ol\", \"Hexadecanol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8848577\", \"stIdVersion\": \"R-ALL-8848577.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8848504, \"displayName\": \"Mammalian wax biosynthesis. II. Expression cloning of wax synthase cDNAs encoding a member of the acyltransferase enzyme family\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"37798-807\", \"pubMedIdentifier\": 15220349, \"schemaClass\": \"LiteratureReference\", \"title\": \"Mammalian wax biosynthesis. II. Expression cloning of wax synthase cDNAs encoding a member of the acyltransferase enzyme family\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15220349\", \"volume\": 279, \"year\": 2004}], \"maxDepth\": 1, \"name\": [\"Transport of cytosolic HXOL to the peroxisome\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 390440, \"displayName\": \"HXOL [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HXOL\", \"hexadecan-1-ol\", \"Hexadecanol\"], \"producedByEvent\": [8848586], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390440\", \"stIdVersion\": \"R-ALL-390440.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 390425, \"displayName\": \"FAR1 reduces PalmCoA to HXOL\", \"followingEvent\": [8848586], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"FAR1 reduces PalmCoA to HXOL\", \"palmitoyl-CoA + 2 NADPH + 2 H+ => hexadecanol + 2 NADP+ [FAR1]\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390425\", \"stIdVersion\": \"R-HSA-390425.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 390438, \"displayName\": \"FAR2 reduces PalmCoA to HXOL\", \"followingEvent\": [8848586], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"FAR2 reduces PalmCoA to HXOL\", \"palmitoyl-CoA + 2 NADPH + 2 H+ => hexadecanol + 2 NADP+ [FAR2]\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390438\", \"stIdVersion\": \"R-HSA-390438.4\"}], \"releaseDate\": \"2016-03-23\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8848586\", \"stIdVersion\": \"R-HSA-8848586.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8848578, \"displayName\": \"The existence of a mechanism to transport HXOL (hexadecanol)...\", \"schemaClass\": \"Summation\", \"text\": \"The existence of a mechanism to transport HXOL (hexadecanol) between the cytosol and the peroxisomal matrix is inferred from studies of wax synthesis in cultured cells (Cheng & Russell 2004). A transporter for HXOL has not been identified.\"}]}" ;
