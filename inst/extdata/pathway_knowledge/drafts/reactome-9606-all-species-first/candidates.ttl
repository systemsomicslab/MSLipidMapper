\"Bos taurus\", \"stId\": \"R-BTA-8952137\", \"stIdVersion\": \"R-BTA-8952137.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10211848, \"displayName\": \"Phospholipid phosphatase 6 hydrolyses Presqualene diphosphate to presqualene monophosphate\", \"inferredFrom\": [8952137], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Phospholipid phosphatase 6 hydrolyses Presqualene diphosphate to presqualene monophosphate\", \"presqualene diphosphate + H2O => presqualene phosphate + phosphate + H(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8952137\", \"stIdVersion\": \"R-RNO-8952137.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10088731, \"displayName\": \"Phospholipid phosphatase 6 hydrolyses Presqualene diphosphate to presqualene monophosphate\", \"inferredFrom\": [8952137], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Phospholipid phosphatase 6 hydrolyses Presqualene diphosphate to presqualene monophosphate\", \"presqualene diphosphate + H2O => presqualene phosphate + phosphate + H(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8952137\", \"stIdVersion\": \"R-MMU-8952137.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8952135, \"displayName\": \"PSMP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PSMP\", \"presqualene monophosphate(2-)\", \"presqualene monophosphate\"], \"producedByEvent\": [8952137], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8952135\", \"stIdVersion\": \"R-ALL-8952135.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [8952137], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [8952137], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 191405, \"displayName\": \"Two FAPP molecules dimerize to form presqualene diphosphate\", \"followingEvent\": [8952137], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Two FAPP molecules dimerize to form presqualene diphosphate\", \"2 (2E,6E)-farnesyl diphosphate => presqualene diphosphate + diphosphate\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191405\", \"stIdVersion\": \"R-HSA-191405.5\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2017-03-27\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8952137\", \"stIdVersion\": \"R-HSA-8952137.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8952146, \"displayName\": \"Phospholipid phosphatase 6 (PLPP6) dephosphorylates presqual...\", \"schemaClass\": \"Summation\", \"text\": \"Phospholipid phosphatase 6 (PLPP6) dephosphorylates presqualene diphosphate (PSDP) to presqualene monophosphate (PSMP). It may be indirectly involved in innate immunity, as PSDP is a bioactive lipid that rapidly remodels to presqualene monophosphate PSMP upon cell activation. PLPP6 displays diphosphate phosphatase activity with a substrate preference PSDP > FDP > phosphatidic acid (Fukunaga et al. 2006).\"}]}" ;
