    mslm:equation "GSH [cytosol] + LTA4 [cytosol] => LTC4 [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [266050], \"className\": \"CatalystActivity\", \"dbId\": 266055, \"displayName\": \"leukotriene-C4 synthase activity of ALOX5:ALOX5AP:LTC4S [nuclear envelope]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005635\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13231, \"definition\": \"The double lipid bilayer that encloses the nucleus, separating its contents from the cytoplasm. It consists of an inner and outer nuclear membrane, with an intermembrane space (20-40 nm wide, also called the perinuclear space) between them. The envelope is supported by the nuclear lamina and contains nuclear pore complexes, which regulate molecular transport.\", \"displayName\": \"nuclear envelope\", \"name\": \"nuclear envelope\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005635\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690590, \"displayName\": \"RHEA:17619\", \"identifier\": \"17619\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/17619\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9915862, \"displayName\": \"RHEA:17619\", \"identifier\": \"17619\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/17619\"}], \"dbId\": 266050, \"displayName\": \"LTA4 is converted to LTC4 by LTC4S\", \"followingEvent\": [266070], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [266050], \"dbId\": 265281, \"displayName\": \"LTA4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LTA4\", \"leukotriene A4(1-)\", \"leukotriene A4\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-265281\", \"stIdVersion\": \"R-ALL-265281.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [266050], \"dbId\": 29450, \"displayName\": \"GSH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GSH\", \"glutathionate(1-)\", \"Reduced glutathione\", \"glutathione\", \"5-L-Glutamyl-L-cysteinylglycine\", \"N-(N-gamma-L-Glutamyl-L-cysteinyl)glycine\", \"gamma-L-Glutamyl-L-cysteinyl-glycine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29450\", \"stIdVersion\": \"R-ALL-29450.5\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 266053, \"displayName\": \"Expression cloning of a cDNA for human leukotriene C4 synthase, an integral membrane protein conjugating reduced glutathione to leukotriene A4\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"7663-7\", \"pubMedIdentifier\": 8052639, \"schemaClass\": \"LiteratureReference\", \"title\": \"Expression cloning of a cDNA for human leukotriene C4 synthase, an integral membrane protein conjugating reduced glutathione to leukotriene A4\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8052639\", \"volume\": 91, \"year\": 1994}, {\"className\": \"LiteratureReference\", \"dbId\": 266019, \"displayName\": \"Molecular cloning and expression of human leukotriene-C4 synthase\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"9745-9\", \"pubMedIdentifier\": 7937884, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular cloning and expression of human leukotriene-C4 synthase\", \"url\": \"http://www.ncbi.nlm.n