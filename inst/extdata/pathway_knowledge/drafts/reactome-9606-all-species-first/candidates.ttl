s\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8959462\", \"stIdVersion\": \"R-DME-8959462.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10725692, \"displayName\": \"SAMD8 transfers phosphatidyl from PE onto C16DH CER\", \"inferredFrom\": [8959462], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SAMD8 transfers phosphatidyl from PE onto C16DH CER\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8959462\", \"stIdVersion\": \"R-XTR-8959462.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10643162, \"displayName\": \"SAMD8 transfers phosphatidyl from PE onto C16DH CER\", \"inferredFrom\": [8959462], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SAMD8 transfers phosphatidyl from PE onto C16DH CER\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-8959462\", \"stIdVersion\": \"R-DRE-8959462.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10548526, \"displayName\": \"SAMD8 transfers phosphatidyl from PE onto C16DH CER\", \"inferredFrom\": [8959462], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SAMD8 transfers phosphatidyl from PE onto C16DH CER\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8959462\", \"stIdVersion\": \"R-SSC-8959462.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10435077, \"displayName\": \"SAMD8 transfers phosphatidyl from PE onto C16DH CER\", \"inferredFrom\": [8959462], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SAMD8 transfers phosphatidyl from PE onto C16DH CER\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8959462\", \"stIdVersion\": \"R-BTA-8959462.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10213232, \"displayName\": \"SAMD8 transfers phosphatidyl from PE onto C16DH CER\", \"inferredFrom\": [8959462], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SAMD8 transfers phosphatidyl from PE onto C16DH CER\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8959462\", \"stIdVersion\": \"R-RNO-8959462.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10090036, \"displayName\": \"SAMD8 transfers phosphatidyl from PE onto C16DH CER\", \"inferredFrom\": [8959462], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SAMD8 transfers phosphatidyl from PE onto C16DH CER\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8959462\", \"stIdVersion\": \"R-MMU-8959462.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8959463, \"displayName\": \"CPE [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CPE\", \"N-hexadecanoylsphinganine-1-phosphoethanolamine zwitterion\", \"ceramide phosphoethanolamine\"], \"producedByEvent\": [8959462], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8959463\", \"stIdVersion\": \"R-ALL-8959463.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1500596, \"displayName\": \"DAG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DAG\", \"1,2-diacyl-sn-glycerol\", \"1,2-diacylglycerol\"], \"producedByEvent\": [8959462], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500596\", \"stIdVersion\": \"R-ALL-1500596.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 428259, \"displayName\": \"DEGS1 dehydrogenates dihydroceramide\", \"followingEvent\": [8959462], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"DEGS1 dehydrogenates dihydroceramide\", \"dihydroceramide + 2Fe(2+) + 2H+ + O2 => (4E)-ceramide + 2Fe(3+) + 2H2O\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428259\", \"stIdVersion\": \"R-HSA-428259.4\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2017-03-27\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8959462\", \"stIdVersion\": \"R-HSA-8959462.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8959488, \"displayName\": \"Sphingolipids such as sphingomyelin (SM) are essential compo...\", \"schemaClass\": \"Summation\", \"text\": \"Sphingolipids such as sphingomyelin (SM) are essential components of cellular membranes and dynamic regulators of many cellular processes in most organisms. Ceramides constitute the backbone of all sphingolipids and are synthesized on the cytosolic surface of the endoplasmic reticulum (ER) and then transported to the Golgi for conversion to SM. The ER-membrane resident protein sphingomyelin synthase-related protein 1 (SAMD8) catalyzes the synthesis of the SM analog ceramide phosphoethanolamine (CPE) in the ER lumen. SAMD8 only produces trace amounts of CPE, but blocking its catalytic activity causes a substantial rise in ER ceramide levels and a structural collapse of the early secretory pathway. SAMD8 is, therefore, a key regulator of ceramide homeostasis, functioning as a sensor rather than a converter of ceramides in the ER (Vacaru et al., 2009). SAMD8 self-associates into ER-resident trimers and hexamers (Cabukusta et al., 2017). The biological role of the produced CPE in humans needs to be better defined. However, it is the main sphingolipid in arthropods and some protozoa and bacteria (see review by Panewska et al., 2019).\"}]}" ;
