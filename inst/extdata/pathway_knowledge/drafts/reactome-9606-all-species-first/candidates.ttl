9, \"displayName\": \"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\", \"inferredFrom\": [188467], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-188467\", \"stIdVersion\": \"R-SSC-188467.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10354722, \"displayName\": \"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\", \"inferredFrom\": [188467], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-188467\", \"stIdVersion\": \"R-BTA-188467.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10247560, \"displayName\": \"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\", \"inferredFrom\": [188467], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-188467\", \"stIdVersion\": \"R-CFA-188467.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10127010, \"displayName\": \"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\", \"inferredFrom\": [188467], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-188467\", \"stIdVersion\": \"R-RNO-188467.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10006239, \"displayName\": \"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\", \"inferredFrom\": [188467], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-188467\", \"stIdVersion\": \"R-MMU-188467.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 188451, \"displayName\": \"DHAP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHAP\", \"glycerone phosphate(2-)\", \"glycerone phosphate\", \"dihydroxyacetone phosphate\"], \"producedByEvent\": [188467], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-188451\", \"stIdVersion\": \"R-ALL-188451.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 31649, \"displayName\": \"FADH2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FADH2\", \"FADH2(2-)\"], \"producedByEvent\": [188467], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-31649\", \"stIdVersion\": \"R-ALL-31649.3\"}], \"releaseDate\": \"2009-04-01\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-188467\", \"stIdVersion\": \"R-HSA-188467.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 188463, \"displayName\": \"FAD-linked mitochondrial glycerol 3-phosphate dehydrogenase ...\", \"schemaClass\": \"Summation\", \"text\": \"FAD-linked mitochondrial glycerol 3-phosphate dehydrogenase (GPD2, alias: mGPDH) and its NAD-linked  cytosolic isoform (GPD1, alias:cGPDH) constitute glycerol phosphate shuttle.  GPD2 catalyzes the unidirectional conversion of glycerol-3-phosphate (G-3-P) to dihydroxyacetone phosphate (DHAP) with concomitant reduction of the enzyme-bound FAD. Impaired activity of GPD2 has been suggested to be one of the primary causes of insulin secretory defects in beta-cells and thus it is a candidate gene for type 2 diabetes.\"}]}" ;
