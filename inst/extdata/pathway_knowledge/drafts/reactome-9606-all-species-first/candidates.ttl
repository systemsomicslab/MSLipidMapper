ce\": [{\"className\": \"LiteratureReference\", \"dbId\": 9840329, \"displayName\": \"Lipid-binding proteins in membrane digestion, antigen presentation, and antimicrobial defense\", \"journal\": \"J Biol Chem\", \"pages\": \"41125-8\", \"pubMedIdentifier\": 16230343, \"schemaClass\": \"LiteratureReference\", \"title\": \"Lipid-binding proteins in membrane digestion, antigen presentation, and antimicrobial defense\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/16230343\", \"volume\": 280, \"year\": 2005}, {\"className\": \"LiteratureReference\", \"dbId\": 9840327, \"displayName\": \"A Comparative Study of Human Saposins\", \"journal\": \"Molecules\", \"pubMedIdentifier\": 29443946, \"schemaClass\": \"LiteratureReference\", \"title\": \"A Comparative Study of Human Saposins\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/29443946\", \"volume\": 23, \"year\": 2018}, {\"className\": \"LiteratureReference\", \"dbId\": 9840332, \"displayName\": \"Molecular role of sulfated glycoprotein-1 (SGP-1/prosaposin) in Sertoli cells\", \"journal\": \"Histol Histopathol\", \"pages\": \"1023-34\", \"pubMedIdentifier\": 8573994, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular role of sulfated glycoprotein-1 (SGP-1/prosaposin) in Sertoli cells\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8573994\", \"volume\": 10, \"year\": 1995}, {\"className\": \"LiteratureReference\", \"dbId\": 9840335, \"displayName\": \"Saposin proteins: structure, function, and role in human lysosomal storage disorders\", \"journal\": \"FASEB J\", \"pages\": \"301-8\", \"pubMedIdentifier\": 2001789, \"schemaClass\": \"LiteratureReference\", \"title\": \"Saposin proteins: structure, function, and role in human lysosomal storage disorders\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/2001789\", \"volume\": 5, \"year\": 1991}, {\"className\": \"LiteratureReference\", \"dbId\": 9840694, \"displayName\": \"Lysosomal degradation of membrane lipids\", \"journal\": \"FEBS Lett\", \"pages\": \"