\", \"stId\": \"R-XTR-5696822\", \"stIdVersion\": \"R-XTR-5696822.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10627311, \"displayName\": \"AKR1B15 reduces EST17b to E1\", \"inferredFrom\": [5696822], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AKR1B15 reduces EST17b to E1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-5696822\", \"stIdVersion\": \"R-DRE-5696822.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10416008, \"displayName\": \"AKR1B15 reduces EST17b to E1\", \"inferredFrom\": [5696822], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AKR1B15 reduces EST17b to E1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-5696822\", \"stIdVersion\": \"R-BTA-5696822.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10193548, \"displayName\": \"AKR1B15 reduces EST17b to E1\", \"inferredFrom\": [5696822], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AKR1B15 reduces EST17b to E1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5696822\", \"stIdVersion\": \"R-RNO-5696822.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10070299, \"displayName\": \"AKR1B15 reduces EST17b to E1\", \"inferredFrom\": [5696822], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AKR1B15 reduces EST17b to E1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-5696822\", \"stIdVersion\": \"R-MMU-5696822.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 5696848, \"displayName\": \"E1 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"E1\", \"estrone\"], \"producedByEvent\": [5696822], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5696848\", \"stIdVersion\": \"R-ALL-5696848.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113600, \"displayName\": \"NADPH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"producedByEvent\": [5696822], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113600\", \"stIdVersion\": \"R-ALL-113600.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [5696822], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}], \"releaseDate\": \"2015-09-22\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5696822\", \"stIdVersion\": \"R-HSA-5696822.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5696829, \"displayName\": \"The aldo-keto reductases (AKRs) are multifunctional enzymes ...\", \"schemaClass\": \"Summation\", \"text\": \"The aldo-keto reductases (AKRs) are multifunctional enzymes that catalyse the reduction of biogenic and xenobiotic aldehydes and ketones as well as the synthesis and metabolism of sex hormones. The newest identified member, Aldo-keto reductase family 1 member B15 (AKR1B15) is able to catalyse the reduction of 17beta-sex hormones such as 17beta-estradiol (EST17b) to estrone (E1). Two isoforms of AKR1B15 exist in different subcellular locations; isoform 2 is cytosolic (like most AKRs) whereas isoform 1 co-localises with the mitochondria (Weber et al. 2015).\"}]}" ;
