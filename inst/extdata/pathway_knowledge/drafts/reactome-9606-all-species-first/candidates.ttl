ane\", \"inferredFrom\": [8868402], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"OSBP exchanges 25OH-CHOL with PI4P from ER membrane to Golgi membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8868402\", \"stIdVersion\": \"R-RNO-8868402.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10084231, \"displayName\": \"OSBP exchanges 25OH-CHOL with PI4P from ER membrane to Golgi membrane\", \"inferredFrom\": [8868402], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"OSBP exchanges 25OH-CHOL with PI4P from ER membrane to Golgi membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8868402\", \"stIdVersion\": \"R-MMU-8868402.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8868393, \"displayName\": \"25OH-CHOL [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25OH-CHOL\", \"25-hydroxycholesterol\"], \"producedByEvent\": [8868402], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8868393\", \"stIdVersion\": \"R-ALL-8868393.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1806234, \"displayName\": \"PI4P [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI4P\", \"1-phosphatidyl-1D-myo-inositol 4-phosphate\"], \"producedByEvent\": [8868402], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806234\", \"stIdVersion\": \"R-ALL-1806234.3\"}], \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8868402\", \"stIdVersion\": \"R-HSA-8868402.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8868390, \"displayName\": \"Oxysterol-binding protein 1 (OSBP) is involved in lipid coun...\", \"schemaClass\": \"Summation\", \"text\": \"Oxysterol-binding protein 1 (OSBP) is involved in lipid countertransport between the Golgi and the ER membranes. It specifically exchanges sterols such as 25-hydroxycholesterol (25OH-CHOL) with phosphatidylinositol 4-phosphate (PI4P), delivering it to the Golgi in exchange for PI4P, which is degraded by the SAC1/SACM1L phosphatases in the ER. The PH-FFAT region of OSBP is necessary for membrane tethering, which then directs forward sterol and backward PI4P transport by the ORD domain of OSBP (Mesmin et al. 2013).\"}]}" ;
