tus norvegicus\", \"stId\": \"R-RNO-9027607\", \"stIdVersion\": \"R-RNO-9027607.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092859, \"displayName\": \"Ac-PTGS2 dimer oxidises DPAn-3 to 17-HDPAn-3\", \"inferredFrom\": [9027607], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Ac-PTGS2 dimer oxidises DPAn-3 to 17-HDPAn-3\", \"(7Z,10Z,13Z,16Z,19Z)-docosapentaenoate + O2 => 17-hydroperoxy-(7Z,10Z,13Z,15E,19Z)-docosapentaenoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9027607\", \"stIdVersion\": \"R-MMU-9027607.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9027614, \"displayName\": \"17-HDPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17-HDPAn-3\", \"(7Z,10Z,13Z,15E,19Z)-17-hydroperoxydocosapentaenoate\", \"(7Z,10Z,13Z,15E,19Z)-17-hydroperoxydocosapentaenoic acid\", \"17-hydroperoxy-omega3-docosapentaenoic acid\", \"17-hydroperoxy-docosapentaenoic acid\"], \"producedByEvent\": [9027607], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9027614\", \"stIdVersion\": \"R-ALL-9027614.5\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027607\", \"stIdVersion\": \"R-HSA-9027607.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9027613, \"displayName\": \"Normally, cyclooxygenases (COX) carry out stereospecific oxy...\", \"schemaClass\": \"Summation\", \"text\": \"Normally, cyclooxygenases (COX) carry out stereospecific oxygenation of arachidonic acid to generate prostaglandins.Inflammation results in activated macrophages in which, when treated with aspirin (acetylsalicylic acid, ASA), dimeric cyclooxygenase 2 (COX2, PTGS2 dimer) can be acetylated. ASA covalently modifies PTGS2 by acetylating a serine residue at position 530 within the cyclooxygenase active site (Lucido et al. 2016). Ac-PTGS2 dimer changes the oxygenation stereospecificity towards its substrates, perhaps by steric shielding effects (Tosco 2013), producing a shift in lipid mediator production. Ac-PTGS2 dimer is able to incorporate molecular oxygen into ω-3 fatty acid docosapentaenoic acid (DPAn-3) to form 17-hydroxy-docosapentaenoic acid (17-HDPAn-3) (Serhan et al. 2002, Groeger et al. 2010).\\n\\n\\n\"}]}" ;
