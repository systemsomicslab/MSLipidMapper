<https://reactome.org/content/detail/R-HSA-109342> a mslm:LipidReaction ;
    rdfs:label "Trans,cis-lauro-2,6-dienoyl-CoA is converted to cis,cis-3,6- 4-cis-decenoyl-CoA by one cycle of beta-oxidation" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "trans,cis-Lauro-2,6-dienoyl-CoA  [mitochondrial matrix] + CoA-SH [mitochondrial matrix] + H2O [mitochondrial matrix] + FAD [mitochondrial matrix] + NAD+ [mitochondrial matrix] => H+ [mitochondrial matrix] + 4-cis-decenoyl-CoA [mitochondrial matrix] + Ac-CoA [mitochondrial matrix] + FADH2 [mitochondrial matrix] + NADH [mitochondrial matrix]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 109342, \"displayName\": \"Trans,cis-lauro-2,6-dienoyl-CoA is converted to cis,cis-3,6- 4-cis-decenoyl-CoA by one cycle of beta-oxidation\", \"figure\": [{\"className\": \"Figure\", \"dbId\": 109987, \"displayName\": \"/figures/unsatfattyacidbetao_3.jpg\", \"schemaClass\": \"Figure\", \"url\": \"/figures/unsatfattyacidbetao_3.jpg\"}], \"followingEvent\": [109341], \"goBiologicalProcess\": {\"accession\": \"0006635\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 20426, \"definition\": \"A fatty acid oxidation process that results in the complete oxidation of a long-chain fatty acid. Fatty acid beta-oxidation begins with the addition of coenzyme A to a fatty acid, and occurs by successive cycles of reactions during each of which the fatty acid is shortened by a two-carbon fragment removed as acetyl coenzyme A; the cycle continues until only two or three carbons remain (as acetyl-CoA or propionyl-CoA respectively).\", \"displayName\": \"fatty acid beta-oxidation\", \"name\": \"fatty acid beta-oxidation\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006635\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [109342], \"dbId\": 77360, \"displayName\": \"trans,cis-Lauro-2,6-dienoyl-CoA  [mitochondrial matrix]\", \"inDisease\": 