8, \"displayName\": \"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DHA to 13(S),14(S)-epoxy-DHA\", \"inferredFrom\": [9024983], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DHA to 13(S),14(S)-epoxy-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9024983\", \"stIdVersion\": \"R-CFA-9024983.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10215997, \"displayName\": \"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DHA to 13(S),14(S)-epoxy-DHA\", \"inferredFrom\": [9024983], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DHA to 13(S),14(S)-epoxy-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9024983\", \"stIdVersion\": \"R-RNO-9024983.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092785, \"displayName\": \"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DHA to 13(S),14(S)-epoxy-DHA\", \"inferredFrom\": [9024983], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DHA to 13(S),14(S)-epoxy-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9024983\", \"stIdVersion\": \"R-MMU-9024983.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9025001, \"displayName\": \"13(S),14(S)-epoxy-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"13(S),14(S)-epoxy-DHA\", \"(13S,14S)-epoxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate\", \"(13S,14S)-epoxy-DHA(1-)\", \"(13S,14S)-epoxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoic acid\"], \"producedByEvent\": [9024983], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9025001\", \"stIdVersion\": \"R-ALL-9025001.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"producedByEvent\": [9024983], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9020274, \"displayName\": \"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\", \"followingEvent\": [9024983], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9020274\", \"stIdVersion\": \"R-HSA-9020274.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9024983\", \"stIdVersion\": \"R-HSA-9024983.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9024995, \"displayName\": \"In macrophages, lipoxygenase 12 (ALOX12:Fe2+) may abstract h...\", \"schemaClass\": \"Summation\", \"text\": \"In macrophages, lipoxygenase 12 (ALOX12:Fe2+) may abstract hydrogen from 14(S)-hydroperoxy-docosaheaenoic acid (14(S)-Hp-DHA) to form 13(S),14(S)-epoxy-DHA (Serhan et al. 2009, Dalli et al. 2013, Deng et al. 2014). This epoxy product is a central intermediate in maresin MaR1 and MaR2 and maresin conjugates in tissue regeneration (MCTR) biosyntheses (Dalli et al. 2016) as well as possessing potent proresolving activity (Dalli et al 2013).\"}]}" ;
