\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9018907\", \"stIdVersion\": \"R-MMU-9018907.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9023644, \"displayName\": \"(18R)-resolvin E3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(18R)-resolvin E3\", \"(18R)-resolvin E3(1-)\", \"18(R)-RvE3\", \"18(R) resolvin-E3\"], \"producedByEvent\": [9018907], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9023644\", \"stIdVersion\": \"R-ALL-9023644.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9018895, \"displayName\": \"GPX4-2 reduces 18(R)-HpEPE to 18(R)-HEPE\", \"followingEvent\": [9018907], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GPX4-2 reduces 18(R)-HpEPE to 18(R)-HEPE\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9018895\", \"stIdVersion\": \"R-HSA-9018895.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9018907\", \"stIdVersion\": \"R-HSA-9018907.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9018884, \"displayName\": \"Unlike resolvins E1 and E2, both of which are biosynthesised...\", \"schemaClass\": \"Summation\", \"text\": \"Unlike resolvins E1 and E2, both of which are biosynthesised by neutrophils via the 5-lipoxygenase pathway, resolvin E3 (RvE3) is biosynthesised in eosinophils or resident macrophages via the 15-lipoxygenase (ALOX15) pathway. 18(R)-hydroxyeicosapentaenoic acid (18(R)-HEPE) is oxidised by ALOX15 (possibly through C13-hydrogen abstraction) into a number of dihydroxy-HEPEs including 17(R),18(R)-diHEPE (18(R)-RvE3) (Isobe et al. 2012, Isobe et al. 2013).\"}]}" ;
