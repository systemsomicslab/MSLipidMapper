olecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-141343\", \"stIdVersion\": \"R-ALL-141343.3\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 6809359, \"displayName\": \"The mouse Nudt7 gene encodes a peroxisomal nudix hydrolase specific for coenzyme A and its derivatives\", \"journal\": \"Biochem. J.\", \"pages\": \"33-8\", \"pubMedIdentifier\": 11415433, \"schemaClass\": \"LiteratureReference\", \"title\": \"The mouse Nudt7 gene encodes a peroxisomal nudix hydrolase specific for coenzyme A and its derivatives\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11415433\", \"volume\": 357, \"year\": 2001}, {\"className\": \"LiteratureReference\", \"dbId\": 6809355, \"displayName\": \"The nudix hydrolase 7 is an Acyl-CoA diphosphatase involved in regulating peroxisomal coenzyme A homeostasis\", \"journal\": \"J. Biochem.\", \"pages\": \"655-63\", \"pubMedIdentifier\": 18799520, \"schemaClass\": \"LiteratureReference\", \"title\": \"The nudix hydrolase 7 is an Acyl-CoA diphosphatase involved in regulating peroxisomal coenzyme A homeostasis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18799520\", \"volume\": 144, \"year\": 2008}], \"maxDepth\": 1, \"name\": [\"NUDT7 hydrolyses CoA-SH to 3',5'-ADP and PPANT\", \"CoA + H2O => (R)-4'-phosphopantetheine + adenosine 3',5'-bisphosphate + 2 H(+)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 6809358, \"displayName\": \"PPANT [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPANT\", \"D-pantetheine 4'-phosphate(2-)\", \"4' phosphopantetheine\", \"pantetheine 4'-phosphate\"], \"producedByEvent\": [6809354], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6809358\", \"stIdVersion\": \"R-ALL-6809358.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 9641154, \"displayName\": \"PAP [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PAP\", \"adenosine 3',5'-bismonophosphate(4-)\", \"adenosine 3',5'-bisphosphate\", \"adenosine 3',5'-bismonophosphate\"], \"producedByEvent\": [6809354], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9641154\", \"stIdVersion\": \"R-ALL-9641154.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [6809354, 6809354], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}, 193465], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 390304, \"displayName\": \"acetyl-CoA + H2O => acetate + CoASH + H+\", \"followingEvent\": [6809354], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"acetyl-CoA + H2O => acetate + CoASH + H+\", \"acetyl-CoA + H2O => acetate + CoA + H(+)\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390304\", \"stIdVersion\": \"R-HSA-390304.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 390291, \"displayName\": \"acetyl-CoA + carnitine => acetylcarnitine + CoASH\", \"followingEvent\": [6809354], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"acetyl-CoA + carnitine => acetylcarnitine + CoASH\", \"R)-carnitine + acetyl-CoA => CoA + O-acetyl-(R)-carnitine\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390291\", \"stIdVersion\": \"R-HSA-390291.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 390284, \"displayName\": \"propionyl-CoA + carnitine => propionylcarnitine + CoASH\", \"followingEvent\": [6809354], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"propionyl-CoA + carnitine => propionylcarnitine + CoASH\", \"(R)-carnitine + propanoyl-CoA => CoA + O-propanoyl-(R)-carnitine\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390284\", \"stIdVersion\": \"R-HSA-390284.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 390281, \"displayName\": \"4,8-dimethylnonanoyl-CoA + carnitine => 4,8-dimethylnonanoylcarnitine + CoASH\", \"followingEvent\": [6809354], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"4,8-dimethylnonanoyl-CoA + carnitine => 4,8-dimethylnonanoylcarnitine + CoASH\", \"(R)-carnitine + 4,8-dimethylnonanoyl-CoA => CoA + O-4,8-dimethylnonanoyl-(R)-carnitine\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390281\", \"stIdVersion\": \"R-HSA-390281.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-03-23\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6809354\", \"stIdVersion\": \"R-HSA-6809354.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6810451, \"displayName\": \"Coenzyme A (CoASH) is a necessary cofactor for the oxidation...\", \"schemaClass\": \"Summation\", \"text\": \"Coenzyme A (CoASH) is a necessary cofactor for the oxidation of lipids in peroxisomes. Peroxisomal coenzyme A diphosphatase (NUDT7) mediates the cleavage of CoA (and CoA esters and oxidised CoA) to produce 3',5'-ADP and 4'-phosphopantetheine (PPANT) and is  suggested to be involved in the regulation of peroxisomal CoASH levels. Human NUDT7 activity is inferred from mouse Nudt7 activity (Gasmi et al. 2001, Reilly et al. 2008).\"}]}" ;
