<https://reactome.org/content/detail/R-HSA-191971> a mslm:LipidReaction ;
    rdfs:label "THCA is translocated from the mitochondrial matrix to the cytosol" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "THCA [mitochondrial matrix] => THCA [cytosol]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 191971, \"displayName\": \"THCA is translocated from the mitochondrial matrix to the cytosol\", \"followingEvent\": [192137], \"goBiologicalProcess\": {\"accession\": \"0170037\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 9910496, \"definition\": \"The directed movement of substances from the mitochondrion to the cytosol.\", \"displayName\": \"export from the mitochondrion\", \"name\": \"export from the mitochondrion\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0170037\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [191971], \"dbId\": 192161, \"displayName\": \"THCA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"THCA\", \"3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oic acid\", \"3alpha,7alpha,12alpha-trihydroxy-5beta-cholestanoate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192161\", \"stIdVersion\": \"R-ALL-192161.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 192080, \"displayName\": \"The enzymes, regulation, and genetics of bile acid synthesis\", \"journal\": \"Annu Rev Biochem\", \"pages\": \"137-74\", \"pubMedIdentifier\": 12543708, \"schemaClass\": \"LiteratureReference\", \"title\": \"The enzymes, regulation, and genetics of bile acid synthesis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12543708\", \"volume\": 72, \"year\": 2003}], \"maxDepth\": 1, \"name\": [\"THCA is translocated from the mitochondrial matrix to the cytosol\", \"THCA [mitochondrial matrix] => THCA [cytosol]\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192013, \"displayName\": \"THCA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"THCA\", \"3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oic acid\", \"3alpha, 7alpha, 12alpha-trihydroxy-5beta-cholestanoate\"], \"producedByEvent\": [191971], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192013\", \"stIdVersion\": \"R-ALL-192013.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 192054, \"displayName\": \"3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-27-al is oxidized to 3alpha,7alpha,12alpha-trihydroxy-5beta-cholestanoate (THCA)\", \"followingEvent\": [191971], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-27-al is oxidized to 3alpha,7alpha,12alpha-trihydroxy-5beta-cholestanoate (THCA)\", \"3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-27-al + NADPH + H+ + O2 => 3alpha,7alpha,12alpha-trihydroxy-5beta-cholestanoate (THCA) + NADP+ + H2O\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192054\", \"stIdVersion\": \"R-HSA-192054.2\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191971\", \"stIdVersion\": \"R-HSA-191971.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 191966, \"displayName\": \"THCA (3alpha,7alpha,12alpha-trihydroxy-5beta-cholestanoate) ...\", \"schemaClass\": \"Summation\", \"text\": \"THCA (3alpha,7alpha,12alpha-trihydroxy-5beta-cholestanoate) is translocated from the mitochondrial matrix to the cytosol. The transporter that mediates its passage across the inner mitochondrial membrane has not been identified. In particular, despite the structural and functional similarities between THCA and long chain fatty acids, searches for carnitine - THCA have failed (Russell 2003). VLCS (SLC27A2), one of the enzymes that catalyzes CoA conjugation of THCA may also be present in peroxisomes, and Mihalik et al. (2002) have hypothesized that THCA could be translocated unchanged from the mitochondrial matrix to the peroxisomal matrix and undergo conjugation there.\"}]}" ;
