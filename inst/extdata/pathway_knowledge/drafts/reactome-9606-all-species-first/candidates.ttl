    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [548830], \"className\": \"CatalystActivity\", \"dbId\": 548824, \"displayName\": \"fatty acid elongase activity of ELOVL1,4 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690706, \"displayName\": \"RHEA:36516\", \"identifier\": \"36516\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/36516\"}], \"dbId\": 548830, \"displayName\": \"ELOVL1,4 elongate TCS-CoA and Mal-CoA to 3OHC-CoA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [548830], \"dbId\": 548808, \"displayName\": \"TCS-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TCS-CoA\", \"tetracosanoyl-CoA(4-)\", \"lignoceroyl-CoA\", \"tetracosanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-548808\", \"stIdVersion\": \"R-ALL-548808.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [548830], \"dbId\": 29508, \"displayName\": \"Mal-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Mal-CoA\", \"malonyl-CoA(5-)\", \"Malonyl coenzyme A\", \"malonyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29508\", \"stIdVersion\": \"R-ALL-29508.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [548830], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 548665, \"displayName\": \"Role of Stargardt-3 macular dystrophy protein (ELOVL4) in the biosynthesis of very long chain fatty acids\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"12843-8\", \"pubMedIdentifier\": 18728184, \"schemaClass\": \"LiteratureReference\", \"title\": \"Role of Stargardt-3 macular dystrophy protein (ELOVL4) in the biosynthesis of very long chain fatty acids\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18728184\", \"volume\": 105, \"year\": 2008}, {\"className\": \"LiteratureReference\", \"dbId\": 548675, \"displayName\": \"Dominant negative mechanism underlies autosomal dominant Stargardt-like macular dystrophy linked to mutations in ELOVL4\", \"journal\": \"J Biol Chem\", \"pages\": \"32521-30\", \"pubMedIdentifier\": 16036915, \"schemaClass\": \"LiteratureReference\", \"title\": \"Dominant negative mechanism underlies autosomal dominant Stargardt-like macular dystrophy linked to mutations in ELOVL4\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/16036915\", \"volume\": 280, \"year\": 2005}], \"maxDepth\": 1, \"name\": [\"ELOVL1,4 elongate TCS-CoA and Mal-CoA to 3OHC-CoA\", \"H(+) + malonyl-CoA + tetracosanoyl-CoA => 3-oxohexacosanoyl-CoA + CO2 + CoA\", \"lignoceroyl-CoA + malonyl-CoA => 3-oxocerotoyl-CoA + CO2 + CoASH\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 548797, \"displayName\": \"3OHC-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3OHC-CoA\", \"3-oxohexacosanoyl-CoA(4-)\", \"3-oxocerotoyl-CoA\", \"3-oxohexacosanoyl-CoA\"], \"producedByEvent\": [548830], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-548797\", \"stIdVersion\": \"R-ALL-548797.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [548830], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113528, \"displayName\": \"CO2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CO2\", \"carbon dioxide\"], \"producedByEvent\": [548830], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113528\", \"stIdVersion\": \"R-ALL-113528.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2010-06-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-548830\", \"stIdVersion\": \"R-HSA-548830.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 548835, \"displayName\": \"Elongation of very long chain fatty acids proteins 1, 4 (ELO...\", \"schemaClass\": \"Summation\", \"text\": \"Elongation of very long chain fatty acids proteins 1, 4 (ELOVL1,4) catalyse the elongation of lignoceroyl-CoA (TCS-CoA) and malonyl-CoA (Mal-CoA) to form 3-oxocerotoyl-CoA (3OHC-CoA). ELOVL4 is abundant in retinal cells, where it is localized to the endoplasmic reticulum membrane (Grayson & Molday 2005). The catalytic activity of ELOVL4 has not been examined directly but is inferred from that of the homologous mouse protein, which is also active on polyunsaturated fatty acids (PUFAs) (PUFAs) (Agbada et al. 2008).\"}]}" ;
