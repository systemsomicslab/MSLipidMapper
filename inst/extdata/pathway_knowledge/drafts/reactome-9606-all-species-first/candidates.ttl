-2161964.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10048607, \"displayName\": \"Arachidonate is oxidised to 12S-HpETE by ALOX12/15\", \"inferredFrom\": [2161964], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Arachidonate is oxidised to 12S-HpETE by ALOX12/15\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate + O2 => (12S)-hydroperoxy-(5Z,8Z,10E,14Z)-eicosatetraenoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2161964\", \"stIdVersion\": \"R-MMU-2161964.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142811, \"displayName\": \"12S-HpETE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"12S-HpETE\", \"12(S)-HPETE(1-)\", \"12(S)-HPETE\"], \"producedByEvent\": [2161964], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142811\", \"stIdVersion\": \"R-ALL-2142811.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 428990, \"displayName\": \"SLC27A1 transports arachidonate across the ER membrane\", \"followingEvent\": [2161964], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC27A1 transports arachidonate across the ER membrane\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate(out) = (5Z,8Z,11Z,14Z)-eicosatetraenoate(in)\"], \"releaseDate\": \"2012-12-04\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428990\", \"stIdVersion\": \"R-HSA-428990.5\"}], \"releaseDate\": \"2012-03-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapie