9705713], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SRD5A2 dehydrogenates TEST to DHTEST\", \"Testosterone is converted to 5-alpha-dihydroxytestosterone\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9705713\", \"stIdVersion\": \"R-DRE-9705713.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10441067, \"displayName\": \"SRD5A2 dehydrogenates TEST to DHTEST\", \"inferredFrom\": [9705713], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SRD5A2 dehydrogenates TEST to DHTEST\", \"Testosterone is converted to 5-alpha-dihydroxytestosterone\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9705713\", \"stIdVersion\": \"R-BTA-9705713.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10327019, \"displayName\": \"SRD5A2 dehydrogenates TEST to DHTEST\", \"inferredFrom\": [9705713], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SRD5A2 dehydrogenates TEST to DHTEST\", \"Testosterone is converted to 5-alpha-dihydroxytestosterone\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9705713\", \"stIdVersion\": \"R-CFA-9705713.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10219518, \"displayName\": \"SRD5A2 dehydrogenates TEST to DHTEST\", \"inferredFrom\": [9705713], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SRD5A2 dehydrogenates TEST to DHTEST\", \"Testosterone is converted to 5-alpha-dihydroxytestosterone\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9705713\", \"stIdVersion\": \"R-RNO-9705713.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10096238, \"displayName\": \"SRD5A2 dehydrogenates TEST to DHTEST\", \"inferredFrom\": [9705713], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SRD5A2 dehydrogenates TEST to DHTEST\", \"Testosterone is converted to 5-alpha-dihydroxytestosterone\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9705713\", \"stIdVersion\": \"R-MMU-9705713.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 469662, \"displayName\": \"DHTEST [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHTEST\", \"17beta-hydroxy-5alpha-androstan-3-one\", \"5-alpha-dihydrotestosterone\"], \"producedByEvent\": [9705713], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-469662\", \"stIdVersion\": \"R-ALL-469662.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [9705713], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193064, \"displayName\": \"HSD17B3-like proteins reducde ANDST to TEST\", \"followingEvent\": [9705713], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"HSD17B3-like proteins reducde ANDST to TEST\", \"Reduction of androstenedione to testosterone\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193064\", \"stIdVersion\": \"R-HSA-193064.4\"}], \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 1449720, \"displayName\": \"Positive regulation by 'POMC(138-176) [cytosol]'\", \"regulatedEntity\": [9705713], \"schemaClass\": \"PositiveRegulation\", \"stId\": \"R-HSA-1449720\", \"stIdVersion\": \"R-HSA-1449720.1\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9705713\", \"stIdVersion\": \"R-HSA-9705713.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9705711, \"displayName\": \"The conversion of testosterone to the most potent androgen, ...\", \"schemaClass\": \"Summation\", \"text\": \"The conversion of testosterone to the most potent androgen, 5-alpha-dihydrotestosterone (DHTEST), is catalyzed by microsomal 5alpha-steroid reductase 2, (SRD5A2) (Andersson et al. 1991). SRD5A2 is highly expressed in the prostate but also in other androgen target sites. Defects in SRD5A2 are the cause of pseudovaginal perineoscrotal hypospadias, also known as male pseudohermaphroditism (Anwar et al. 1997). Corticotropin (Adrenocorticotropic hormone, ACTH) acts through the ACTH receptor called melanocortin receptor type 2 (MC2R) to stimulate steroidogenesis, increasing the production of androgens (McKenna et al. 1997).\"}]}" ;
