us\", \"stId\": \"R-BTA-74177\", \"stIdVersion\": \"R-BTA-74177.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10236986, \"displayName\": \"OXCT dimers transfer CoA from SUCC-CoA to ACA, forming ACA-CoA\", \"inferredFrom\": [74177], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"OXCT dimers transfer CoA from SUCC-CoA to ACA, forming ACA-CoA\", \"acetoacetate + succinyl-CoA <=> acetoacetyl-CoA + succinate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-74177\", \"stIdVersion\": \"R-CFA-74177.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10114053, \"displayName\": \"OXCT dimers transfer CoA from SUCC-CoA to ACA, forming ACA-CoA\", \"inferredFrom\": [74177], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"OXCT dimers transfer CoA from SUCC-CoA to ACA, forming ACA-CoA\", \"acetoacetate + succinyl-CoA <=> acetoacetyl-CoA + succinate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-74177\", \"stIdVersion\": \"R-RNO-74177.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9994713, \"displayName\": \"OXCT dimers transfer CoA from SUCC-CoA to ACA, forming ACA-CoA\", \"inferredFrom\": [74177], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"OXCT dimers transfer CoA from SUCC-CoA to ACA, forming ACA-CoA\", \"acetoacetate + succinyl-CoA <=> acetoacetyl-CoA + succinate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-74177\", \"stIdVersion\": \"R-MMU-74177.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 73871, \"displayName\": \"ACA-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ACA-CoA\", \"acetoacetyl-CoA(4-)\", \"acetoacetyl-CoA\"], \"producedByEvent\": [74177], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-73871\", \"stIdVersion\": \"R-ALL-73871.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113536, \"displayName\": \"SUCCA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SUCCA\", \"succinate(2-)\", \"Succinate\", \"succinic acid\", \"Butanedionic acid\", \"Ethylenesuccinic acid\"], \"producedByEvent\": [74177], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113536\", \"stIdVersion\": \"R-ALL-113536.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 73920, \"displayName\": \"D-beta hydroxybutyrate+NAD+ <=> acetoacetate+NADH+H+\", \"followingEvent\": [74177], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"D-beta hydroxybutyrate+NAD+ <=> acetoacetate+NADH+H+\"], \"releaseDate\": \"2004-07-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-73920\", \"stIdVersion\": \"R-HSA-73920.3\"}], \"releaseDate\": \"2004-07-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-74177\", \"stIdVersion\": \"R-HSA-74177.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 178368, \"displayName\": \"Mitochondrial succinyl-CoA:3-ketoacid coenzyme A transferase...\", \"schemaClass\": \"Summation\", \"text\": \"Mitochondrial succinyl-CoA:3-ketoacid coenzyme A transferases 1 and 2 (OXCT1 and OXCT2) are key enzymes for the metabolism of ketone bodies, catalysing the first rate-limiting step of ketone body utilisation in peripheral tissues. In dimeric form, they mediate the transfer of a CoA moiety from succinyl-CoA (SUCC-CoA) to acetoacetate (ACA) to form acetoacetyl-CoA (ACA-CoA) and succinate (SUCCA) (Kassovska-Bratinova et al. 1996, Tanaka et al. 2002). ACA-CoA can be converted to acetyl-CoA which can be utilised by the tricarboxylic acid cycle for energy production.\\n\\n\"}]}" ;
