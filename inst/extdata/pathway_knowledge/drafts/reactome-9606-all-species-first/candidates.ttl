ition\", \"className\": \"Reaction\", \"dbId\": 10040812, \"displayName\": \"GLA hydrolyzes PSAP(195-273):Gb3Cer:PE\", \"inferredFrom\": [1605736], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GLA hydrolyzes PSAP(195-273):Gb3Cer:PE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1605736\", \"stIdVersion\": \"R-MMU-1605736.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605637, \"displayName\": \"Gal [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Gal\", \"alpha-D-galactose\"], \"producedByEvent\": [1605736], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605637\", \"stIdVersion\": \"R-ALL-1605637.3\"}, {\"className\": \"Complex\", \"dbId\": 9840818, \"displayName\": \"PSAP(195-273):LacCer:PE [lysosomal lumen]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"PSAP(195-273):LacCer:PE\", \"mobilized LacCer\"], \"producedByEvent\": [1605736], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840818\", \"stIdVersion\": \"R-HSA-9840818.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1605632, \"displayName\": \"bHEXA,bHEXB hydrolyze PSAP(195-273):Gb4Cer:PE\", \"followingEvent\": [1605736], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"bHEXA,bHEXB hydrolyze PSAP(195-273):Gb4Cer:PE\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605632\", \"stIdVersion\": \"R-HSA-1605632.3\"}], \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605736\", \"stIdVersion\": \"R-HSA-1605736.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1605725, \"displayName\": \"Alpha-galactosidase A (GLA) (Bishop et al. 1986) removes the...\", \"schemaClass\": \"Summation\", \"text\": \"Alpha-galactosidase A (GLA) (Bishop et al. 1986) removes the terminal galactose residue from glycolipids or glycoproteins, mobilized by PSAP(195-273) (Saposin B), resulting in galactose and an alcohol. An example is the Fabry disease substrate globotriaosylceramide (Gb3Cer) which is hydrolysed to form galactose and lactosylceramide. GLA functions as a homodimer (Garman & Garboczi 2004) and defects in this enzyme lead to Fabry disease (FD) (MIM:301500), a rare X-linked sphingolipidosis disease where glycolipids such as Gb3Cer accumulate in many tissues (Garman & Garboczi 2004, Eng et al. 1993, Shabeer et al. 2006).\\nResearchers also observed elevated Gb3Cer in prosaposin deficiency (PSAPD, MIM: 611721) cases, a rare disease with low levels of all saposins. Saposin B (PSAP(195-273)) is an essential cofactor to the reaction (Bradova et al., 1993).\"}]}" ;
