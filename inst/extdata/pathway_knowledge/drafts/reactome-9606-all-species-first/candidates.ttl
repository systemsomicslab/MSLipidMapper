": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193997\", \"stIdVersion\": \"R-HSA-193997.6\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193986, \"displayName\": \"Cytochrome P450 11B1, mitochondrial (CYP11B1) usually hydrox...\", \"schemaClass\": \"Summation\", \"text\": \"Cytochrome P450 11B1, mitochondrial (CYP11B1) usually hydroxylates 11-deoxycortisol (11DCORT) to form cortisol (CORT). CYP11B1 is associated with the inner mitochondrial membrane. Corticotropin (Adrenocorticotropic hormone, ACTH) acts through the ACTH receptor, melanocortin receptor type 2 (MC2R) to stimulate steroidogenesis, increasing the production of androgens (McKenna et al, 1997).\"}]}" ;
