: [\"SPG\", \"sphingoid base(1+)\", \"sphingoid base\"], \"producedByEvent\": [1606602], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1606588\", \"stIdVersion\": \"R-ALL-1606588.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1861779, \"displayName\": \"RCOO- [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"RCOO-\", \"fatty acid anion\", \"carboxylate\", \"carboxylic acid\"], \"producedByEvent\": [1606602], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1861779\", \"stIdVersion\": \"R-ALL-1861779.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1606564, \"displayName\": \"GALC hydrolyzes GalCer\", \"followingEvent\": [1606602], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GALC hydrolyzes GalCer\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1606564\", \"stIdVersion\": \"R-HSA-1606564.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1605797, \"displayName\": \"SMPD1 hydrolyzes SPHM\", \"followingEvent\": [1606602], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SMPD1 hydrolyzes SPHM\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605797\", \"stIdVersion\": \"R-HSA-1605797.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1605591, \"displayName\": \"GBA1:SAPC hydrolyzes GlcCer\", \"followingEvent\": [1606602], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GBA1:SAPC hydrolyzes GlcCer\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605591\", \"stIdVersion\": \"R-HSA-1605591.3\"}, {\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 9840334, \"displayName\": \"PSAP is cleaved\", \"followingEvent\": [1606602], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PSAP is cleaved\"], \"releaseDate\": \"2023-09-13\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840334\", \"stIdVersion\": \"R-HSA-9840334.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"regulatedBy\": [{\"className\": \"Requirement\", \"dbId\": 9841168, \"displayName\": \"Requirement by 'PSAP(405-486) [lysosomal lumen]'\", \"regulatedEntity\": [1606602], \"schemaClass\": \"Requirement\"}], \"regulationReference\": [{\"className\": \"RegulationReference\", \"dbId\": 9841167, \"displayName\": \"Requirement by 'PSAP(405-486) [lysosomal lumen]' Structural and membrane-binding properties of saposin D\", \"schemaClass\": \"RegulationReference\"}], \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1606602\", \"stIdVersion\": \"R-HSA-1606602.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1606598, \"displayName\": \"Acid ceramidase (ASAH1) is a lysosomal enzyme that catalyses...\", \"schemaClass\": \"Summation\", \"text\": \"Acid ceramidase (ASAH1) is a lysosomal enzyme that catalyses the hydrolysis of ceramide to sphingosine and free fatty acid. It functions as a heterodimer of one alpha and one beta subunit (Bernardo et al. 1995; Gebai et al, 2018). The reaction is stimulated by Saposin D (Sap D, PSAP(405-486)) (Tatti et al, 1999). Defects in ASAH1 are the cause of Farber lipogranulomatosis (FL) (MIM:228000), also called Farber disease (FD) (Zhang et al. 2000, Koch et al. 1996).\"}]}" ;
