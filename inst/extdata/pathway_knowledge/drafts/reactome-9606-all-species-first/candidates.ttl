\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10215687, \"displayName\": \"LTA4H:Zn2+ hydrolyses 5S,6S-epoxy-18(R)-HEPE to 18(R)-RvE1\", \"inferredFrom\": [9018877], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4H:Zn2+ hydrolyses 5S,6S-epoxy-18(R)-HEPE to 18(R)-RvE1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9018877\", \"stIdVersion\": \"R-RNO-9018877.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092462, \"displayName\": \"LTA4H:Zn2+ hydrolyses 5S,6S-epoxy-18(R)-HEPE to 18(R)-RvE1\", \"inferredFrom\": [9018877], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4H:Zn2+ hydrolyses 5S,6S-epoxy-18(R)-HEPE to 18(R)-RvE1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9018877\", \"stIdVersion\": \"R-MMU-9018877.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9023712, \"displayName\": \"18(R)-RvE1 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"18(R)-RvE1\", \"resolvin E1(1-)\", \"18(R)-resolvin E1\", \"resolvin E1\"], \"producedByEvent\": [9018877], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9023712\", \"stIdVersion\": \"R-ALL-9023712.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9018894, \"displayName\": \"ALOX5 oxidises 5(S)-Hp-18(R)-HEPE to 5S,6S-epoxy-18(R)-HEPE\", \"followingEvent\": [9018877], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 5(S)-Hp-18(R)-HEPE to 5S,6S-epoxy-18(R)-HEPE\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9018894\", \"stIdVersion\": \"R-HSA-9018894.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9018877\", \"stIdVersion\": \"R-HSA-9018877.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9023713, \"displayName\": \"Leukotriene A4 hydrolase (LTA4H) is a monomeric, soluble enz...\", \"schemaClass\": \"Summation\", \"text\": \"Leukotriene A4 hydrolase (LTA4H) is a monomeric, soluble enzyme that uses a Zn2+ cofactor to catalyse the hydrolysis of the allylic epoxide leukotriene A4 (LTA4) (McGee & Fitzpatrick 1985). LTA4H can also catalyse the hydrolysis of 5S,6S-epoxy-18(R)-HEPE to the 18(R) stereoisomer of resolvin E1 (18(R)-RvE1) (Oh et al. 2011). The E-resolvins are antiinflammatory, pro-resolving, and non-phlogistic (that is, they mediate the clearance of leukocytes without eliciting an inflammatory response) (Serhan et al. 2008).\"}]}" ;
