on\": \"R-HSA-1482547.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482533, \"displayName\": \"2-acyl LPC is acylated to PC by LPCAT\", \"followingEvent\": [1483142], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"2-acyl LPC is acylated to PC by LPCAT\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482533\", \"stIdVersion\": \"R-HSA-1482533.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483142\", \"stIdVersion\": \"R-HSA-1483142.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1483073, \"displayName\": \"In the endoplasmic reticulum (ER) membrane, phospholipase D1...\", \"schemaClass\": \"Summation\", \"text\": \"In the endoplasmic reticulum (ER) membrane, phospholipase D1-4,6 (PLD1-4,6) transphosphatidylates phosphatidylcholine (PC) with glycerol to displace choline (Cho) and form phosphatidylglycerol (PG).  This reaction is inferred from rats, but PLD enzymes are present in humans (Hammond et al. 1995, Steed et al. 1998, Cao et al. 1997).\"}]}" ;
