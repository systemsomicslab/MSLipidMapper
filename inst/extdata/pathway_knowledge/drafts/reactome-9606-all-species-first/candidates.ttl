, \"maxDepth\": 1, \"name\": [\"PI is phosphorylated to PI3P by PIK3C2A/3 at the early endosome membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1675939\", \"stIdVersion\": \"R-RNO-1675939.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10041761, \"displayName\": \"PI is phosphorylated to PI3P by PIK3C2A/3 at the early endosome membrane\", \"inferredFrom\": [1675939], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI is phosphorylated to PI3P by PIK3C2A/3 at the early endosome membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1675939\", \"stIdVersion\": \"R-MMU-1675939.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [1675939], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1806200, \"displayName\": \"PI3P [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI3P\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate(3-)\", \"PtdIns3P\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate\"], \"producedByEvent\": [1675939], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806200\", \"stIdVersion\": \"R-ALL-1806200.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676141, \"displayName\": \"PI3P is dephosphorylated to PI by MTM proteins at the early endosome membrane\", \"followingEvent\": [1675939], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI3P is dephosphorylated to PI by MTM proteins at the early endosome membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676141\", \"stIdVersion\": \"R-HSA-1676141.4\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675939\", \"stIdVersion\": \"R-HSA-1675939.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1675828, \"displayName\": \"At the early endosome membrane, phosphatidylinositol 3-kinas...\", \"schemaClass\": \"Summation\", \"text\": \"At the early endosome membrane, phosphatidylinositol 3-kinase catalytic subunit type 3 (PIK3C3) aka VPS34 binds to phosphoinositide 3-kinase regulatory subunit 4 (PIK3R4).  The PIK3C3:PIK3R4 complex and phosphatidylinositol-4-phosphate 3-kinase C2 domain-containing subunit alpha (PIK3C2A) phosphorylate phosphatidylinositol (PI) to phosphatidylinositol 3-phosphate (PI3P).<br><br>The following lists the above proteins with their corresponding literature references: PIK3C3:PIK3R4 complex (Panaretou et al. 1997, Volinia et al. 1995, Cao et al. 2007) and PIK3C2A (Arcaro et al. 2000, Domin et al. 2000).\"}]}" ;
