    mslm:equation "NADP+ [cytosol] + 13-HDHA [cytosol] => 13-oxo-DHA [cytosol] + NADPH [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9027531], \"className\": \"CatalystActivity\", \"dbId\": 9027560, \"displayName\": \"alcohol dehydrogenase (NADP+) activity of Dehydrogenase [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9027531, \"displayName\": \"Dehydrogenase dehydrogenates 13-HDHA to 13-oxo-DHA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027531], \"dbId\": 9027547, \"displayName\": \"13-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"13-HDHA\", \"(4Z,7Z,10Z,14E,16Z,19Z)-13-hydroxydocosahexaenoate\", \"13-HDoHE\", \"(4Z,7Z,10Z,14E,16Z,19Z)-13-hydroxydocosahexaenoic acid\", \"13-hydroxy-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9027547\", \"stIdVersion\": \"R-ALL-9027547.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027531], \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9027533, \"displayName\": \"Cyclooxygenase-2 generates anti-inflammatory mediators from omega-3 fatty acids\", \"journal\": \"Nat. Chem. Biol.\", \"pages\": \"433-41\", \"pubMedIdentifier\": 20436486, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cyclooxygenase-2 generates anti-inflammatory mediators from omega-3 fatty acids\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/20436486\", \"volume\": 6, \"year\": 2010}], \"maxDepth\": 1, \"name\": [\"Dehydrogenase dehydrogenates 13-HDHA to 13-oxo-DHA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9027537, \"displayName\": \"13-oxo-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"13-oxo-DHA\", \"(4Z,7Z,10Z,14E,16Z,19Z)-13-oxodocosahexaenoate\", \"13-oxo-docosahexaenoic acid\", \"(4Z,7Z,10Z,14E,16Z,19Z)-13-oxodocosahexaenoic acid\", \"EFOX-D6\"], \"producedByEvent\": [9027531], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9027537\", \"stIdVersion\": \"R-ALL-9027537.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"producedByEvent\": [9027531], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9027532, \"displayName\": \"PTGS2 dimer oxidises DHA to 13-HDHA\", \"followingEvent\": [9027531], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PTGS2 dimer oxidises DHA to 13-HDHA\", \"(4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoate + AH2 + O2 => 13-hydroxy-(4Z,7Z,10Z,14E,16Z,19Z)-docosahexaenoate + A + H2O\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027532\", \"stIdVersion\": \"R-HSA-9027532.3\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027531\", \"stIdVersion\": \"R-HSA-9027531.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9027535, \"displayName\": \"In activated macrophages, an unknown dehdyrogenase abstracts...\", \"schemaClass\": \"Summation\", \"text\": \"In activated macrophages, an unknown dehdyrogenase abstracts hydrogen from 13-hydroxy-docosahexaenoic acid to form the electrophilic oxo-derivative (EFOX) 13-oxo-DHA (Groeger et al. 2010). Potential candidates are cellular dehydrogenases such as 3α-hydroxysteroid dehydrogenases (3α-HSDs), which can convert 13- and 17-HDHA into their corresponding oxo-derivatives in the presence of NAD(P)+ <i>in vitro</i> (supplementary data, Groeger et al. 2010) or 5- and 15-hydroxyeicosanoid dehydrogenases (5- and 15-HEDH), which convert LOX products to 5-and 15-oxoETE (Erlemann et al. 2007).  EFOXs can act as peroxisome proliferator-activated receptor-γ (PPARγ) agonists and inhibit pro-inflammatory cytokine and nitric oxide production, confirming their anti-inflammatory actions (Groeger et al. 2010).\"}]}" ;
