    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9916401], \"className\": \"CatalystActivity\", \"dbId\": 2161800, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen, incorporation of two atoms of oxygen of ALOX12:Fe2+ [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690744, \"displayName\": \"RHEA:48589\", \"identifier\": \"48589\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/48589\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9916400, \"displayName\": \"RHEA:48589\", \"identifier\": \"48589\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/48589\"}], \"dbId\": 9916401, \"displayName\": \"ALOX12 oxidises LTA4 to LXB4\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9916401, 9916401], \"dbId\": 9032038, \"displayName\": \"LTA4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LTA4\", \"leukotriene A4(1-)\", \"leukotriene A4\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9032038\", \"stIdVersion\": \"R-ALL-9032038.4\"}, 9032038, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9916401], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9916401, 9916401], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 2161873, \"displayName\": \"Lipoxin synthase activity of human platelet 12-lipoxygenase\", \"journal\": \"Biochem J\", \"pages\": \"127-33\", \"pubMedIdentifier\": 8250832, \"schemaClass\": \"LiteratureReference\", \"title\": \"Lipoxin synthase activity of human platelet 12-lipoxygenase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8250832\", \"volume\": 296, \"year\": 1993}, {\"className\": \"LiteratureReference\", \"dbId\": 2162054, \"displayName\": \"Lipoxin formation during human neutrophil-platelet interactions. Evidence for the transformation of leukotriene A4 by platelet 12-lipoxygenase in vitro\", \"journal\": \"J Clin Invest\", \"pages\": \"772-80\", \"pubMedIdentifier\": 2155925, \"schemaClass\": \"LiteratureReference\", \"title\": \"Lipoxin formation during human neutrophil-platelet interactions. Evidence for the transformation of leukotriene A4 by platelet 12-lipoxygenase in vitro\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/2155925\", \"volume\": 85, \"year\": 1990}, {\"className\": \"LiteratureReference\", \"dbId\": 2161812, \"displayName\": \"Evidence for a 5(6)-epoxytetraene intermediate in the biosynthesis of lipoxins in human leukocytes. Conversion into lipoxin A by cytosolic epoxide hydrolase\", \"journal\": \"FEBS Lett\", \"pages\": \"127-32\", \"pubMedIdentifier\": 3770188, \"schemaClass\": \"LiteratureReference\", \"title\": \"Evidence for a 5(6)-epoxytetraene intermediate in the biosynthesis of lipoxins in human leukocytes. Conversion into lipoxin A by cytosolic epoxide hydrolase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/3770188\", \"volume\": 207, \"year\": 1986}], \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXB4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin B4\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11056077, \"displayName\": \"ALOX12 oxidises LTA4 to LXB4\", \"inferredFrom\": [9916401], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXB4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-9916401\", \"stIdVersion\": \"R-DDI-9916401.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10652810, \"displayName\": \"ALOX12 oxidises LTA4 to LXB4\", \"inferredFrom\": [9916401], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXB4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9916401\", \"stIdVersion\": \"R-DRE-9916401.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10560266, \"displayName\": \"ALOX12 oxidises LTA4 to LXB4\", \"inferredFrom\": [9916401], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXB4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9916401\", \"stIdVersion\": \"R-SSC-9916401.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10447168, \"displayName\": \"ALOX12 oxidises LTA4 to LXB4\", \"inferredFrom\": [9916401], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXB4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9916401\", \"stIdVersion\": \"R-BTA-9916401.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10332882, \"displayName\": \"ALOX12 oxidises LTA4 to LXB4\", \"inferredFrom\": [9916401], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXB4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9916401\", \"stIdVersion\": \"R-CFA-9916401.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10225860, \"displayName\": \"ALOX12 oxidises LTA4 to LXB4\", \"inferredFrom\": [9916401], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXB4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9916401\", \"stIdVersion\": \"R-RNO-9916401.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10102252, \"displayName\": \"ALOX12 oxidises LTA4 to LXB4\", \"inferredFrom\": [9916401], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXB4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9916401\", \"stIdVersion\": \"R-MMU-9916401.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142776, \"displayName\": \"LXB4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LXB4\", \"lipoxin B4(1-)\", \"lipoxin B4\"], \"producedByEvent\": [9916401, 9916401], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142776\", \"stIdVersion\": \"R-ALL-2142776.4\"}, 2142776], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 9032036, \"displayName\": \"LTA4 translocates from neutrophil cytosol to platelet cytosol\", \"followingEvent\": [9916401], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"LTA4 translocates from neutrophil cytosol to platelet cytosol\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9032036\", \"stIdVersion\": \"R-HSA-9032036.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821383, \"definition\": \"internally reviewed\", \"displayName\": \"three stars\", \"name\": [\"three stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2024-09-11\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9916401\", \"stIdVersion\": \"R-HSA-9916401.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9916419, \"displayName\": \"Arachidonate 12-lipoxygenase, 12S-type (ALOX12) catalyses th...\", \"schemaClass\": \"Summation\", \"text\": \"Arachidonate 12-lipoxygenase, 12S-type (ALOX12) catalyses the conversion of leukotriene A4 (LTA4) into the lipoxin LXB4, which has it positioned at C-14 (Romano et al. 1993, Serhan & Sheppard  1990).  One of the reaction intermediates of this process might be 5S,6S-epoxy-15S-hydroxy-7E,9E,11Z,13E-eicosatetraenoic acid (5,6-Ep-15S-HETE) (Puustinen et al. 1986).  However, its generation from LTA4 is unclear but it can be hydrolysed to form the lipoxins.\"}]}" ;
