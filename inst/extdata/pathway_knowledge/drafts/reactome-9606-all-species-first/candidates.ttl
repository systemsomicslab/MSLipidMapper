    mslm:equation "3HA-CoA [mitochondrial matrix] => t2E-CoA [mitochondrial matrix] + H2O [mitochondrial matrix]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8957389], \"className\": \"CatalystActivity\", \"dbId\": 8957385, \"displayName\": \"3-hydroxyacyl-CoA dehydratase activity of HTD2 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690709, \"displayName\": \"RHEA:26527\", \"identifier\": \"26527\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/26527\"}], \"dbId\": 8957389, \"displayName\": \"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8957389], \"dbId\": 8957387, \"displayName\": \"3HA-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3HA-CoA\", \"(R)-3-hydroxyacyl-CoA(4-)\", \"3-hydroxyacyl-CoA\", \"(R)-3-hydroxyacyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8957387\", \"stIdVersion\": \"R-ALL-8957387.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8957399, \"displayName\": \"An ancient genetic link between vertebrate mitochondrial fatty acid synthesis and RNA processing\", \"journal\": \"FASEB J.\", \"pages\": \"569-78\", \"pubMedIdentifier\": 17898086, \"schemaClass\": \"LiteratureReference\", \"title\": \"An ancient genetic link between vertebrate mitochondrial fatty acid synthesis and RNA processing\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17898086\", \"volume\": 22, \"year\": 2008}], \"maxDepth\": 1, \"name\": [\"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"a (3R)-3-hydroxyacyl-CoA => a (2E)-enoyl-CoA + H2O\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11050000, \"displayName\": \"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"inferredFrom\": [8957389], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"a (3R)-3-hydroxyacyl-CoA => a (2E)-enoyl-CoA + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-8957389\", \"stIdVersion\": \"R-DDI-8957389.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10908207, \"displayName\": \"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"inferredFrom\": [8957389], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"a (3R)-3-hydroxyacyl-CoA => a (2E)-enoyl-CoA + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8957389\", \"stIdVersion\": \"R-DME-8957389.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10820360, \"displayName\": \"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"inferredFrom\": [8957389], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"a (3R)-3-hydroxyacyl-CoA => a (2E)-enoyl-CoA + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-8957389\", \"stIdVersion\": \"R-GGA-8957389.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10548517, \"displayName\": \"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"inferredFrom\": [8957389], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"a (3R)-3-hydroxyacyl-CoA => a (2E)-enoyl-CoA + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8957389\", \"stIdVersion\": \"R-SSC-8957389.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10321181, \"displayName\": \"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"inferredFrom\": [8957389], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"a (3R)-3-hydroxyacyl-CoA => a (2E)-enoyl-CoA + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8957389\", \"stIdVersion\": \"R-CFA-8957389.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8957386, \"displayName\": \"t2E-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"t2E-CoA\", \"2,3-trans-enoyl CoA(4-)\", \"trans-2-enoyl-CoA\"], \"producedByEvent\": [8957389], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8957386\", \"stIdVersion\": \"R-ALL-8957386.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [8957389], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}], \"releaseDate\": \"2017-03-27\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8957389\", \"stIdVersion\": \"R-HSA-8957389.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8957398, \"displayName\": \"Polycistronic transcripts, where a single mRNA can encode se...\", \"schemaClass\": \"Summation\", \"text\": \"Polycistronic transcripts, where a single mRNA can encode several different polypeptide chains, are common in prokaryotes. In humans, only 3 bicistronic transcripts have been characterised to date. Human cDNAs encoding both RPP14 of the RNase P complex and mitochondrial 3-hydroxyacyl thioester dehydratase (HTD2) have been isolated. HTD2 functions in the mitochondrial fatty acid synthesis (FAS) pathway, dehydrating (3R)-hydroxyacyl-CoA (3HA-CoA) to trans-2-enoyl-CoA (t2E-CoA) (Autio et al. 2008).\"}]}" ;
