    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0031901\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 171062, \"definition\": \"The lipid bilayer surrounding an early endosome.\", \"displayName\": \"early endosome membrane\", \"name\": \"early endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031901\"}, {\"accession\": \"0031902\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 172574, \"definition\": \"The lipid bilayer surrounding a late endosome.\", \"displayName\": \"late endosome membrane\", \"name\": \"late endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031902\"}], \"dbId\": 1676041, \"displayName\": \"Presence of PI(3,5)P2 stimulates the maturation of the early endosome into the late endosome\", \"followingEvent\": [1676161], \"goBiologicalProcess\": {\"accession\": \"0045022\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 18833, \"definition\": \"The directed movement of substances, in membrane-bounded vesicles, from the early sorting endosomes to the late sorting endosomes; transport occurs along microtubules and can be experimentally blocked with microtubule-depolymerizing drugs.\", \"displayName\": \"early endosome to late endosome transport\", \"name\": \"early endosome to late endosome transport\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0045022\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1676041], \"dbId\": 1806205, \"displayName\": \"PI(3,5)P2 [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2\", \"1-phosphatidyl-1D-myo-inositol 3,5-bisphosphate(5-)\", \"1-phosphatidyl-1D-myo-inositol 3,5-bisphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEnt