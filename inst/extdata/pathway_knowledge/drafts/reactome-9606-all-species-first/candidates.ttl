 \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8878787\", \"stIdVersion\": \"R-BTA-8878787.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10317491, \"displayName\": \"ALPI dimer hydrolyses phosphate monoesters\", \"inferredFrom\": [8878787], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALPI dimer hydrolyses phosphate monoesters\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8878787\", \"stIdVersion\": \"R-CFA-8878787.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10209151, \"displayName\": \"ALPI dimer hydrolyses phosphate monoesters\", \"inferredFrom\": [8878787], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALPI dimer hydrolyses phosphate monoesters\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8878787\", \"stIdVersion\": \"R-RNO-8878787.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10086133, \"displayName\": \"ALPI dimer hydrolyses phosphate monoesters\", \"inferredFrom\": [8878787], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALPI dimer hydrolyses phosphate monoesters\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8878787\", \"stIdVersion\": \"R-MMU-8878787.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 109277, \"displayName\": \"Pi [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"inorganic phosphate\", \"phosphate\"], \"producedByEvent\": [8878787], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109277\", \"stIdVersion\": \"R-ALL-109277.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 8878776, \"displayName\": \"Alcohol [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Alcohol\"], \"producedByEvent\": [8878787], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8878776\", \"stIdVersion\": \"R-ALL-8878776.2\"}], \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8878787\", \"stIdVersion\": \"R-HSA-8878787.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8878782, \"displayName\": \"Alkaline phosphatases (ALPs) are ubiquitous membrane-bound g...\", \"schemaClass\": \"Summation\", \"text\": \"Alkaline phosphatases (ALPs) are ubiquitous membrane-bound glycoproteins that catalyse the hydrolysis of phosphate monoesters in alkaline conditions (Sharma et al. 2014). To date, little is known about the physiological function of ALPs in most tissues. In humans, four isozymes exist, named from their tissue localisations. One isozyme, intestinal-type alkaline phosphatase (ALPI, IAP), possesses alkaline phosphatase activity but has no specific physiological substrate defiend for it yet. It may be involved in the hydrolysis of pro-drugs in the intestine (Lowe et al. 1990).\"}]}" ;
