    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [193101], \"className\": \"CatalystActivity\", \"dbId\": 193154, \"displayName\": \"cholesterol monooxygenase (side-chain-cleaving) activity of CYP11A1:FDXR:FDX1,FDX1L (red.) [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9907729, \"displayName\": \"RHEA:34344\", \"identifier\": \"34344\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/34344\"}], \"dbId\": 193101, \"displayName\": \"CYP11A1 cleaves 20a,22b-DHCHOL\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193101], \"dbId\": 193086, \"displayName\": \"20a,22b-DHCHOL [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"20a,22b-DHCHOL\", \"(20R,22R)-20,22-dihydroxycholesterol\", \"20alpha,22beta dihydroxycho