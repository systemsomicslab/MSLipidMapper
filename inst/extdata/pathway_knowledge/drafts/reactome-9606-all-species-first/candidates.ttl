nt\": [9755937], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Squalene 2,3-epoxide cyclizes, forming lanosterol\", \"(S)-2,3-epoxysqualene => lanosterol\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191366\", \"stIdVersion\": \"R-HSA-191366.4\"}], \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 9756530, \"displayName\": \"Positive regulation by 'SREBP1,2 [endoplasmic reticulum membrane]'\", \"regulatedEntity\": [9755937], \"schemaClass\": \"PositiveRegulation\"}], \"regulationReference\": [{\"className\": \"RegulationReference\", \"dbId\": 9756519, \"displayName\": \"Positive regulation by 'SREBP1,2 [endoplasmic reticulum membrane]' Sterols regulate 3β-hydroxysterol Δ24-reductase (DHCR24) via dual sterol regulatory elements: cooperative induction of key enzymes in lipid synthesis by Sterol Regulatory Element Binding Proteins\", \"schemaClass\": \"RegulationReference\"}], \"releaseDate\": \"2021-12-08\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9755937\", \"stIdVersion\": \"R-HSA-9755937.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9755935, \"displayName\": \"DHCR24 (delta(24)-sterol reductase) (review Zerenturk et al....\", \"schemaClass\": \"Summation\", \"text\": \"DHCR24 (delta(24)-sterol reductase) (review Zerenturk et al. 2013) associated with the endoplasmic reticulum membrane catalyzes the reduction of lanosterol (LAN) to 24,25-dihydrolanosterol (24,25-dhLAN) (Kandutsch & Russell 1960). Like most cholesterol synthesis enzymes, DHCR24 is  transcriptionally regulated by the SREBP family of transcription factors and hence, is subject to negative regulation by cholesterol (Zerenturk et al. 2012).\"}]}" ;
