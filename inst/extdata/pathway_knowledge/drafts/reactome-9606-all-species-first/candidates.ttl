    mslm:equation "PETA [mitochondrial matrix] + H2O [mitochondrial matrix] => Pi [mitochondrial matrix] + CH3CHO [mitochondrial matrix] + NH3 [mitochondrial matrix]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [5696415], \"className\": \"CatalystActivity\", \"dbId\": 5696410, \"displayName\": \"ethanolamine-phosphate phospho-lyase activity of PXLP-K278-ETNPPL tetramer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690735, \"displayName\": \"RHEA:17890\", \"identifier\": \"17890\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/17890\"}], \"dbId\": 5696415, \"displayName\": \"PXLP-K278-ETNPPL tetramer hydrolyses PETA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [5696415], \"dbId\": 5696414, \"displayName\": \"PETA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PETA\", \"O-phosphoethanolamine\", \"phosphoethanolamine\", \"ethanolamine phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5696414\", \"stIdVersion\": \"R-ALL-5696414.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [5696415], \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R