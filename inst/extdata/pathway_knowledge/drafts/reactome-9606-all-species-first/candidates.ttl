nferredFrom\": [6813740], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GDE1 hydrolyzes GroPIns\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-6813740\", \"stIdVersion\": \"R-DRE-6813740.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10538713, \"displayName\": \"GDE1 hydrolyzes GroPIns\", \"inferredFrom\": [6813740], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GDE1 hydrolyzes GroPIns\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-6813740\", \"stIdVersion\": \"R-SSC-6813740.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10425262, \"displayName\": \"GDE1 hydrolyzes GroPIns\", \"inferredFrom\": [6813740], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GDE1 hydrolyzes GroPIns\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-6813740\", \"stIdVersion\": \"R-BTA-6813740.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10311782, \"displayName\": \"GDE1 hydrolyzes GroPIns\", \"inferredFrom\": [6813740], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GDE1 hydrolyzes GroPIns\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-6813740\", \"stIdVersion\": \"R-CFA-6813740.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10202751, \"displayName\": \"GDE1 hydrolyzes GroPIns\", \"inferredFrom\": [6813740], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GDE1 hydrolyzes GroPIns\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-6813740\", \"stIdVersion\": \"R-RNO-6813740.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10080004, \"displayName\": \"GDE1 hydrolyzes GroPIns\", \"inferredFrom\": [6813740], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GDE1 hydrolyzes GroPIns\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6813740\", \"stIdVersion\": \"R-MMU-6813740.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 76114, \"displayName\": \"G3P [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"G3P\", \"sn-glycerol 3-phosphate(2-)\", \"Glycerol-3-phosphate\", \"sn-glycerol 3-phosphate\"], \"producedByEvent\": [6813740], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76114\", \"stIdVersion\": \"R-ALL-76114.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 426910, \"displayName\": \"Ins [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ins\", \"myo-inositol\", \"Inositol\"], \"producedByEvent\": [6813740], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426910\", \"stIdVersion\": \"R-ALL-426910.4\"}], \"releaseDate\": \"2016-03-23\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6813740\", \"stIdVersion\": \"R-HSA-6813740.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6813738, \"displayName\": \"GDE1 (glycerophosphodiester phosphodiesterase 1) catalyzes t...\", \"schemaClass\": \"Summation\", \"text\": \"GDE1 (glycerophosphodiester phosphodiesterase 1) catalyzes the hydrolysis of GroPIns (1-(sn-glycero-3-O-phosphonato)-1D-myo-inositol; glycerophosphoinositol) to G3P (glycerol-3-phosphate) and Ins (inositol). Experimental studies of the homologous rat enzyme have shown it to be associated with cellular membranes, to have a strong preference for glycerophosphoinositol over glycerophosphocholine as a substrate, and to be stimulated by G protein agonists, suggesting a possible role for GDE1 in signaling by G protein-coupled receptors (Zheng et al. 2000, 2003). Modeling studies with the human protein have been interpreted to suggest localization specifically to the plasma membrane (Bachmann et al. 2006).\"}]}" ;
