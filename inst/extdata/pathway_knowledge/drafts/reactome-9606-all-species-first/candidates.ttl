e\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356, 29356, {\"className\": \"Complex\", \"consumedByEvent\": [429730], \"dbId\": 429703, \"displayName\": \"PPM1L:VAPA/B dimer [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PPM1L:VAPA/B dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-429703\", \"stIdVersion\": \"R-HSA-429703.1\"}, {\"className\": \"Genes and Transcripts\", \"consumedByEvent\": [429730], \"dbId\": 429695, \"displayName\": \"p-S,S132,T-CERT1-2 [cytosol]\", \"endCoordinate\": 624, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"p-S,S132,T-CERT1-2\", \"p-S,S132,T-COL4A3BP-2\", \"multiphospho-CERT\", \"COL4A3BP\", \"GPBPdelta26\"], \"referenceType\": \"ReferenceIsoform\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-429695\", \"stIdVersion\": \"R-HSA-429695.2\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 429720, \"displayName\": \"Protein phosphatase 2Cepsilon is an endoplasmic reticulum integral membrane protein that dephosphorylates the ceramide transport protein CERT to enhance its association with organelle membranes\", \"journal\": \"J Biol Chem\", \"pages\": \"6584-93\", \"pubMedIdentifier\": 18165232, \"schemaClass\": \"LiteratureReference\", \"title\": \"Protein phosphatase 2Cepsilon is an endoplasmic reticulum integral membrane protein that dephosphorylates the ceramide transport protein CERT to enhance its association with organelle membranes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18165232\", \"volume\": 283, \"year\": 2008}, {\"className\": \"LiteratureReference\", \"dbId\": 9843187, \"displayName\": \"Structure, functions and regulation of CERT, a lipid-transfer protein for the delivery of ceramide at the ER-Golgi membrane contact sites\", \"journal\": \"FEBS Lett\", \"pages\": \"2366-2377\", \"pubMedIdentifier\": 31254361, \"schemaClass\": \"LiteratureReference\", \"title\": \"Structure, functions and regulation of CERT, a lipid-transfer protein for the delivery of ceramide at the ER-Golgi membrane contact sites\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/31254361\", \"volume\": 593, \"year\": 2019}], \"maxDepth\": 1, \"name\": [\"PPM1L dephosphorylates multiphospho-CERT1-2\", \"O-phospho-L-seryl/threonyl-(protein) + H2O => L-seryl/threonyl-(protein) + phosphate\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10859834, \"displayName\": \"PPM1L dephosphorylates multiphospho-CERT1-2\", \"inferredFrom\": [429730], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPM1L dephosphorylates multiphospho-CERT1-2\", \"O-phospho-L-seryl/threonyl-(protein) + H2O => L-seryl/threonyl-(protein) + phosphate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-429730\", \"stIdVersion\": \"R-DME-429730.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10592366, \"displayName\": \"PPM1L dephosphorylates multiphospho-CERT1-2\", \"inferredFrom\": [429730], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPM1L dephosphorylates multiphospho-CERT1-2\", \"O-phospho-L-seryl/threonyl-(protein) + H2O => L-seryl/threonyl-(protein) + phosphate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-429730\", \"stIdVersion\": \"R-DRE-429730.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10370465, \"displayName\": \"PPM1L dephosphorylates multiphospho-CERT1-2\", \"inferredFrom\": [429730], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPM1L dephosphorylates multiphospho-CERT1-2\", \"O-phospho-L-seryl/threonyl-(protein) + H2O => L-seryl/threonyl-(protein) + phosphate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-429730\", \"stIdVersion\": \"R-BTA-429730.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 429672, \"displayName\": \"CERT1-2:PPM1L:VAPA/B dimer [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"CERT1-2:PPM1L:VAPA/B dimer\"], \"producedByEvent\": [429730], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-429672\", \"stIdVersion\": \"R-HSA-429672.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [429730, 429730, 429730], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}, 29372, 29372], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2009-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-429730\", \"stIdVersion\": \"R-HSA-429730.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 429731, \"displayName\": \"Multiphospho-CERT (ceramide transfer protein) associates wit...\", \"schemaClass\": \"Summation\", \"text\": \"Multiphospho-CERT (ceramide transfer protein) associates with the complex of VAPA/B (VAMP-associated proteins A or B) and PPM1L (protein phosphatase 1-like) in the endoplasmic reticulum membrane (Kawano et al. 2006; Saito et al. 2008; Kumagai & Hanada 2019), enabling PPM1L to catalyze the dephosphorylation of the multiphospho-CERT complex component (Saito et al. 2008; Kumagai & Hanada 2019). This dephosphorylation restores CERT’s ability to bind and transport ceramide.\"}]}" ;
