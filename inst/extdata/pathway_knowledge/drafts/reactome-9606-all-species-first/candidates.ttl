\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10220511, \"displayName\": \"GGPS1 hexamer transfers IPPP to DMAPP\", \"inferredFrom\": [9717834], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GGPS1 hexamer transfers IPPP to DMAPP\", \"isopentenyl diphosphate + dimethylallyl diphosphate => (2E)-geranyl diphosphate + diphosphate\", \"Addition of isopentenyl pyrophosphate to DMAPP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9717834\", \"stIdVersion\": \"R-RNO-9717834.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10097279, \"displayName\": \"GGPS1 hexamer transfers IPPP to DMAPP\", \"inferredFrom\": [9717834], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GGPS1 hexamer transfers IPPP to DMAPP\", \"isopentenyl diphosphate + dimethylallyl diphosphate => (2E)-geranyl diphosphate + diphosphate\", \"Addition of isopentenyl pyrophosphate to DMAPP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9717834\", \"stIdVersion\": \"R-MMU-9717834.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 191409, \"displayName\": \"GPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GPP\", \"geranyl diphosphate(3-)\", \"Geranyl pyrophosphate\", \"geranyl diphosphate\"], \"producedByEvent\": [9717834], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191409\", \"stIdVersion\": \"R-ALL-191409.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111294, \"displayName\": \"PPi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [9717834], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111294\", \"stIdVersion\": \"R-ALL-111294.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 191382, \"displayName\": \"Isopentenyl pyrophosphate rearranges to dimethylallyl pyrophosphate\", \"followingEvent\": [9717834], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Isopentenyl pyrophosphate rearranges to dimethylallyl pyrophosphate\", \"isopentenyl diphosphate => dimethylallyl diphosphate\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191382\", \"stIdVersion\": \"R-HSA-191382.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 191414, \"displayName\": \"MVD decarboxylates MVA5PP to IPPP\", \"followingEvent\": [9717834], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"MVD decarboxylates MVA5PP to IPPP\", \"(R)-5-diphosphomevalonate + ATP => isopentenyl diphosphate + ADP + phosphate + CO2\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191414\", \"stIdVersion\": \"R-HSA-191414.5\"}], \"releaseDate\": \"2007-02-20\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9717834\", \"stIdVersion\": \"R-HSA-9717834.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 191364, \"displayName\": \"The prenyltransferase enzyme family is involved in the biosy...\", \"schemaClass\": \"Summation\", \"text\": \"The prenyltransferase enzyme family is involved in the biosynthesis of isoprenoids. Two members of this family are known to catalyse the sequential condensation of isopentenyl pyrophosphate (IPPP) to dimethylallyl pyrophosphate (DMAPP): farnesyl pyrophosphate synthase dimer (FPPS dimer) and geranylgeranyl pyrophosphate synthetase hexamer (GGPPS hexamer) (Kavanaugh et al, 2006). Both enzymes utlise Mg2+ as cofactor (Chang et al. 2021).\"}]}" ;
