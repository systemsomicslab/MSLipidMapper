stIdVersion\": \"R-ALL-5279323.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 428127, \"displayName\": \"SPTLC complexes transfer acyl-CoA onto serine\", \"followingEvent\": [428123], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SPTLC complexes transfer acyl-CoA onto serine\", \"acyl-CoA + serine => 3-ketosphingoid + CoASH + CO2\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428127\", \"stIdVersion\": \"R-HSA-428127.6\"}], \"releaseDate\": \"2009-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428123\", \"stIdVersion\": \"R-HSA-428123.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 428135, \"displayName\": \"KDSR (3-ketodihydrosphingosine reductase) enzyme associated ...\", \"schemaClass\": \"Summation\", \"text\": \"KDSR (3-ketodihydrosphingosine reductase) enzyme associated with the cytosolic face of the endoplasmic reticulum membrane catalyzes the reduction of 3-ketosphingoid by NADPH to form sphingoid (Kihara and Igarashi 2004). Defects in KDSR or missing activity causes Erythrokeratodermia (EKVP4, MIM:617526), associated with sphingolipid dysregulation (Boyden et al., 2017). While there is no data on substrates other than 3-ketosphinganine, it is probable that KDSR has activity toward 3-ketosphingoids with other chain lengths than C16.\"}]}" ;
