<https://reactome.org/content/detail/R-HSA-9027562> a mslm:LipidReaction ;
    rdfs:label "Dehydrogenase dehydrogenates 17-HDHA to 17-oxo-DHA" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "NADP+ [cytosol] + 17-HDHA [cytosol] => 17-oxo-DHA [cytosol] + NADPH [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9027562], \"className\": \"CatalystActivity\", \"dbId\": 9027560, \"displayName\": \"alcohol dehydrogenase (NADP+) activity of Dehydrogenase [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9027562, \"displayName\": \"Dehydrogenase dehydrogenates 17-HDHA to 17-oxo-DHA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027562], \"dbId\": 9027622, \"displayName\": \"17-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17-HDHA\", \"(4Z,7Z,10Z,13Z,15E,19Z)-17-hydroxydocosahexaenoate\", \"(4Z,7Z,10Z,13Z,15E,19Z)-17-hydroxydocosahexaenoic acid\", \"17-HDoHE\", \"17-hydroxy-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9027622\", \"stIdVersion\": \"R-ALL-9027622.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027562], \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9027533, \"displayName\": \"Cyclooxygenase-2 generates anti-inflammatory mediators from omega-3 fatty acids\", \"journal\": \"Nat. Chem. Biol.\", \"pages\": \"433-41\", \"pubMedIdentifier\": 20436486, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cyclooxygenase-2 generates anti-inflammatory mediators from omega-3 fatty acids\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/20436486\", \"volume\": 6, \"year\": 2010}], \"maxDepth\": 1, \"name\": [\"Dehydrogenase dehydrogenates 17-HDHA to 17-oxo-DHA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9027626, \"displayName\": \"17-oxo-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17-oxo-DHA\", \"(4Z,7Z,10Z,13Z,15E,19Z)-17-oxodocosahexaenoate\", \"(4Z,7Z,10Z,13Z,15E,19Z)-17-oxodocosahexaenoic acid\", \"17-oxo-docosahexaenoic acid\"], \"producedByEvent\": [9027562], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9027626\", \"stIdVersion\": \"R-ALL-9027626.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"producedByEvent\": [9027562], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9027627, \"displayName\": \"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\", \"followingEvent\": [9027562], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027627\", \"stIdVersion\": \"R-HSA-9027627.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027562\", \"stIdVersion\": \"R-HSA-9027562.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9027558, \"displayName\": \"When acetylated by aspirin, dimeric acetylated-cyclooxygenas...\", \"schemaClass\": \"Summation\", \"text\": \"When acetylated by aspirin, dimeric acetylated-cyclooxygenase 2 (Ac-PTGS2 dimer aka COX2) in macrophages is able to form 17-hydroxy-docosahexaenoic acid (17-HDHA). This intermediate is then dehydrogenated by an unknown dehydrogenase to form the electrophilic oxo (EFOX) product 17-oxo-docosahexaenoic acid (17-oxo-DHA) (Groeger et al. 2010). Potential candidate enzymes are cellular dehydrogenases such as 3α-hydroxysteroid dehydrogenases (3α-HSDs), which can convert 13- and 17-HDHA into corresponding EFOXs in the presence of NAD(P)+ <i>in vitro</i>(supplementary data, Groeger et al. 2010) or 5- and 15-hydroxyeicosanoid dehydrogenases (5- and 15-HEDH), which convert LOX products to 5-and 15-oxoETE (Erlemann et al. 2007, Wendell et al. 2015). Anti-inflammatory actions of 17-oxo-DHA include acting as a peroxisome proliferator-activated receptor-γ (PPARγ) agonist to inhibit pro-inflammatory cytokine and nitric oxide production (Groeger et al. 2010, Cipollina et al. 2016). 17-oxo-DHA was also found to be a strong inducer of the anti-oxidant response, promoting Nrf2 nuclear accumulation, leading to the expression of heme oxygenase 1 and more than doubling glutathione levels (Cipollina et al. 2014).\"}]}" ;
