splayName\": \"NADH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [390251], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192305\", \"stIdVersion\": \"R-ALL-192305.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [390251], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 390252, \"displayName\": \"HSD17B4 hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"followingEvent\": [390251], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"HSD17B4 hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"(2E)-hexacosenoyl-CoA + H2O => (3R)-hydroxyhexacosanoyl-CoA\", \"trans-2,3-dehydrohexacosanoyl-CoA + H2O => 3-hydroxyhexacosanoyl-CoA\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390252\", \"stIdVersion\": \"R-HSA-390252.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 6809263, \"displayName\": \"EHHADH hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"followingEvent\": [390251], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"EHHADH hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"(2E)-hexacosenoyl-CoA + H2O => (3R)-hydroxyhexacosanoyl-CoA\", \"trans-2,3-dehydrohexacosanoyl-CoA + H2O => 3-hydroxyhexacosanoyl-CoA (EHHADH)\"], \"releaseDate\": \"2016-03-23\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6809263\", \"stIdVersion\": \"R-HSA-6809263.3\"}], \"releaseDate\": \"2009-04-01\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390251\", \"stIdVersion\": \"R-HSA-390251.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 390259, \"displayName\": \"Peroxisomal HSD17B4 dimer catalyzes the reaction of 3-hydrox...\", \"schemaClass\": \"Summation\", \"text\": \"Peroxisomal HSD17B4 dimer catalyzes the reaction of 3-hydroxyhexacosanoyl-CoA and NAD+ to form 3-ketohexacosanoyl-CoA and NADH + H+. The enzyme is bifunctional - an aminoterminal domain catalyzes the dehydrogenation of a variety of 3-hydroxyacyl-CoA's, the reaction annotated here, and a carboxyterminal domain catalyzes the hydration of a variety of trans-2,3-dehydroacyl-CoA's (Jiang et al. 1996, 1997). Defects in the enzyme are associated with a severe disorder of peroxisomal fatty acid metabolism in humans (Ferdinandusse et al. 2006).\"}]}" ;
