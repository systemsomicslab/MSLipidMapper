498722, \"displayName\": \"2-acyl LPS [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2-acyl LPS\", \"2-acyl-sn-glycero-3-phosphoserine\", \"2-acyl lysophosphatidylserine\"], \"producedByEvent\": [1482897], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498722\", \"stIdVersion\": \"R-ALL-1498722.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524021, \"displayName\": \"LCFA(-) [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [1482897], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524021\", \"stIdVersion\": \"R-ALL-1524021.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1483186, \"displayName\": \"PC is converted to PS by PTDSS1\", \"followingEvent\": [1482897], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PC is converted to PS by PTDSS1\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483186\", \"stIdVersion\": \"R-HSA-1483186.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1483089, \"displayName\": \"PE is converted to PS by PTDSS2\", \"followingEvent\": [1482897], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PE is converted to PS by PTDSS2\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483089\", \"stIdVersion\": \"R-HSA-1483089.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482636, \"displayName\": \"1-acyl LPS is acylated to PS by LPSAT\", \"followingEvent\": [1482897], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPS is acylated to PS by LPSAT\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482636\", \"stIdVersion\": \"R-HSA-1482636.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482691, \"displayName\": \"2-acyl LPS is acylated to PS by LPSAT\", \"followingEvent\": [1482897], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"2-acyl LPS is acylated to PS by LPSAT\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482691\", \"stIdVersion\": \"R-HSA-1482691.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482897\", \"stIdVersion\": \"R-HSA-1482897.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482875, \"displayName\": \"At the endoplasmic reticulum (ER) membrane, phosphatidylseri...\", \"schemaClass\": \"Summation\", \"text\": \"At the endoplasmic reticulum (ER) membrane, phosphatidylserine (PS) is hydrolyzed, and has one of its acyl chains cleaved off, by cytosolic phospholipase A2 alpha/delta/zeta (PLA2G4A/D/F) (Ghomashchi et al. 2010).  This produces 2-acyl lysophosphatidylserine (LPS).  Cytosolic phospholipase A2 enzymes show not only PLA2 hydrolyzing activity to form the 1-acyl lysophospholipid but also have a degree of PLA1 activity, producing a 2-acyl lysophospholipid.\"}]}" ;
