edFrom\": [1861789], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA3 hydrolyzes GlcCer (cytosol)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1861789\", \"stIdVersion\": \"R-BTA-1861789.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10164969, \"displayName\": \"GBA3 hydrolyzes GlcCer (cytosol)\", \"inferredFrom\": [1861789], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA3 hydrolyzes GlcCer (cytosol)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1861789\", \"stIdVersion\": \"R-RNO-1861789.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 194377, \"displayName\": \"CERA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CERA\", \"N-acylsphingoid\", \"Ceramide\"], \"producedByEvent\": [1861789], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194377\", \"stIdVersion\": \"R-ALL-194377.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70113, \"displayName\": \"Glc [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Glc\", \"D-glucopyranose\", \"D-glucose\"], \"producedByEvent\": [1861789], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70113\", \"stIdVersion\": \"R-ALL-70113.5\"}], \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1861789\", \"stIdVersion\": \"R-HSA-1861789.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1861777, \"displayName\": \"Human glucosylceramidase 3 (GBA3) hydrolyses the glucosidic ...\", \"schemaClass\": \"Summation\", \"text\": \"Human glucosylceramidase 3 (GBA3) hydrolyses the glucosidic bond of glucocerebrosides to form ceramide in the cytosol. GBA3 may be involved in the intestinal absorption and metabolism of dietary flavonoid glycosides (Berrin et al. 2002, Nemeth et al. 2003). However, the activity of GBA3 is relatively low and its significance in vivo is not clear (Dekker et al., 2011).\"}]}" ;
