    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [200410], \"className\": \"CatalystActivity\", \"dbId\": 201039, \"displayName\": \"carnitine O-acyltransferase activity of CPT2 [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9643316, \"displayName\": \"carnitine O-acyltransferase activity of CPT2 [mitochondrial inner membrane] Carnitine palmitoyltransferase II deficiency: structure of the gene and characterization of two novel disease-causing mutations\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}, {\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690118, \"displayName\": \"RHEA:12663\", \"identifier\": \"12663\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/12663\"}, {\"className\": \"DatabaseIdentifier\", \"data