, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3,7,24THCA is conjugated with Coenzyme A (SLC27A5 BACS)\", \"3,7,24THCA + ATP + CoASH => 3,7,24THCA-CoA + AMP + pyrophosphate + H2O (SCLS25A5 \\\"BACS\\\")\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193711\", \"stIdVersion\": \"R-MMU-193711.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193739, \"displayName\": \"3,7,24THCA-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3,7,24THCA-CoA\", \"3alpha,7alpha,24-trihydroxy-5beta-cholestan-26-oyl-CoA\", \"25(R) 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoyl-CoA\"], \"producedByEvent\": [193711], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193739\", \"stIdVersion\": \"R-ALL-193739.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76577, \"displayName\": \"AMP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AMP\", \"adenosine 5'-monophosphate(2-)\", \"adenosine 5'-monophosphate\", \"Adenylic acid\", \"Adenylate\", \"5'-AMP\", \"5'-Adenylic acid\", \"5'-Adenosine monophosphate\"], \"producedByEvent\": [193711], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76577\", \"stIdVersion\": \"R-ALL-76577.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111294, \"displayName\": \"PPi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [193711], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111294\", \"stIdVersion\": \"R-ALL-111294.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [193711], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 193786, \"displayName\": \"3,7,24THCA is translocated from the mitochondrial matrix to the cytosol\", \"followingEvent\": [193711], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"3,7,24THCA is translocated from the mitochondrial matrix to the cytosol\", \"3,7,24THCA [mitochondrial matrix] => 3,7,24THCA [cytosol]\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193786\", \"stIdVersion\": \"R-HSA-193786.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193711\", \"stIdVersion\": \"R-HSA-193711.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193726, \"displayName\": \"3,7,24THCA (25(R) 3alpha,7alpha,24(S)-trihydroxy-5beta-chole...\", \"schemaClass\": \"Summation\", \"text\": \"3,7,24THCA (25(R) 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate), coenzyme A, and ATP react to form the CoA conjugate of 3,7,24THCA, AMP, pyrophosphate and water. This cytosolic reaction is catalyzed by SLC27A5 (BACS). SLC27A2 (VLCS) also catalyzes this reaction; the relative contributions of the two enzymes to de novo bile acid synthesis in vivo are not certain (Mihalik et al. 2002).\"}]}" ;
