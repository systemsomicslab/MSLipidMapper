h\": 1, \"name\": [\"ST8SIA5 transfers Neu5Ac to gangliosides\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9845587\", \"stIdVersion\": \"R-BTA-9845587.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10224476, \"displayName\": \"ST8SIA5 transfers Neu5Ac to gangliosides\", \"inferredFrom\": [9845587], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ST8SIA5 transfers Neu5Ac to gangliosides\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9845587\", \"stIdVersion\": \"R-RNO-9845587.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10100947, \"displayName\": \"ST8SIA5 transfers Neu5Ac to gangliosides\", \"inferredFrom\": [9845587], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ST8SIA5 transfers Neu5Ac to gangliosides\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9845587\", \"stIdVersion\": \"R-MMU-9845587.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 727810, \"displayName\": \"CMP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CMP\", \"cytidine 5'-monophosphate(2-)\", \"cytidine 5'-monophosphate\", \"cytidylic acid\", \"Cytidine-5'-monophosphate\"], \"producedByEvent\": [9845587], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-727810\", \"stIdVersion\": \"R-ALL-727810.6\"}, {\"className\": \"Set\", \"dbId\": 9845591, \"displayName\": \"GQ1b,GT3,GD1c,GT1a [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GQ1b,GT3,GD1c,GT1a\"], \"producedByEvent\": [9845587], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9845591\", \"stIdVersion\": \"R-ALL-9845591.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [9845587], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}], \"releaseDate\": \"2023-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9845587\", \"stIdVersion\": \"R-HSA-9845587.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9845588, \"displayName\": \"Alpha-2,8-sialyltransferase 5 (ST8SIA5) transfers N-acetylne...\", \"schemaClass\": \"Summation\", \"text\": \"Alpha-2,8-sialyltransferase 5 (ST8SIA5) transfers N-acetylneuraminate (Neu5Ac) to terminal Neu5Ac-yl groups of gangliosides GD1a, GT1b, GM1b and GD3 to produce gangliosides GD1c, GT1a, GQ1b, and GP1c (Kono et al., 1996; Kim et al. 1997). Gangliosides localize to the plasma membrane via vesicle transport, endocytosis, and exocytosis. Three isoforms of ST8SIA5 may have different localizations and substrate specificities (Araki et al., 2022).\"}]}" ;
