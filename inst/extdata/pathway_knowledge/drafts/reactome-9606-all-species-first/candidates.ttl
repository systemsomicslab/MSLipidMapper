: \"transition\", \"className\": \"Reaction\", \"dbId\": 10544940, \"displayName\": \"MCAT transfers Mal from Mal-CoA to NDUFAB1\", \"inferredFrom\": [8933547], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MCAT transfers Mal from Mal-CoA to NDUFAB1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8933547\", \"stIdVersion\": \"R-SSC-8933547.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10431288, \"displayName\": \"MCAT transfers Mal from Mal-CoA to NDUFAB1\", \"inferredFrom\": [8933547], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MCAT transfers Mal from Mal-CoA to NDUFAB1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8933547\", \"stIdVersion\": \"R-BTA-8933547.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10317774, \"displayName\": \"MCAT transfers Mal from Mal-CoA to NDUFAB1\", \"inferredFrom\": [8933547], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MCAT transfers Mal from Mal-CoA to NDUFAB1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8933547\", \"stIdVersion\": \"R-CFA-8933547.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10209448, \"displayName\": \"MCAT transfers Mal from Mal-CoA to NDUFAB1\", \"inferredFrom\": [8933547], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MCAT transfers Mal from Mal-CoA to NDUFAB1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8933547\", \"stIdVersion\": \"R-RNO-8933547.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10086413, \"displayName\": \"MCAT transfers Mal from Mal-CoA to NDUFAB1\", \"inferredFrom\": [8933547], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MCAT transfers Mal from Mal-CoA to NDUFAB1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8933547\", \"stIdVersion\": \"R-MMU-8933547.1\"}], \"output\": [{\"className\": \"Protein\", \"dbId\": 8934586, \"displayName\": \"Mal-PPANT-S112-NDUFAB1 [mitochondrial inner membrane]\", \"endCoordinate\": 156, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Mal-PPANT-S112-NDUFAB1\", \"NADH-ubiquinone oxidoreductase 9.6 kDa subunit\"], \"producedByEvent\": [8933547], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8934586\", \"stIdVersion\": \"R-HSA-8934586.1\", \"startCoordinate\": 69}, {\"className\": \"Chemical Compound\", \"dbId\": 29374, \"displayName\": \"CoA-SH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"CoA\", \"coenzyme A\"], \"producedByEvent\": [8933547], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29374\", \"stIdVersion\": \"R-ALL-29374.5\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8933547\", \"stIdVersion\": \"R-HSA-8933547.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8933544, \"displayName\": \"The ACP (acyl carrier protein) NDUFAB1 is the cofactor prote...\", \"schemaClass\": \"Summation\", \"text\": \"The ACP (acyl carrier protein) NDUFAB1 is the cofactor protein that covalently binds all fatty acyl intermediates via a phosphopantetheine linkage during the synthesis of fatty acids. Mitochondrial malonyl-CoA-acyl carrier protein transacylase (MCAT, MT) catalyses the transfer of a malonyl moiety from malonyl-CoA (Mal-CoA) to the free thiol group of the phosphopantetheine arm of NDUFAB1, suggesting a possible role in fatty acid biosynthesis in the mitochondrion (Zhang et al. 2003).\"}]}" ;
