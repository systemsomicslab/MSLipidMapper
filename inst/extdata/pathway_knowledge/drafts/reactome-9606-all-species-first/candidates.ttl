e\": \"Bos taurus\", \"stId\": \"R-BTA-389889\", \"stIdVersion\": \"R-BTA-389889.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10259321, \"displayName\": \"ACOX2:FAD, ACOXL:FAD oxidise (2S)-pristanoyl-CoA to trans-2,3-dehydropristanoyl-CoA\", \"inferredFrom\": [389889], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACOX2:FAD, ACOXL:FAD oxidise (2S)-pristanoyl-CoA to trans-2,3-dehydropristanoyl-CoA\", \"(2S)-pristanoyl-CoA + O2 => (2E)-pristenoyl-CoA + H2O2\", \"(2S)-pristanoyl-CoA + O2 => trans-2,3-dehydropristanoyl-CoA + H2O2 (ACOX2)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-389889\", \"stIdVersion\": \"R-CFA-389889.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10140908, \"displayName\": \"ACOX2:FAD, ACOXL:FAD oxidise (2S)-pristanoyl-CoA to trans-2,3-dehydropristanoyl-CoA\", \"inferredFrom\": [389889], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACOX2:FAD, ACOXL:FAD oxidise (2S)-pristanoyl-CoA to trans-2,3-dehydropristanoyl-CoA\", \"(2S)-pristanoyl-CoA + O2 => (2E)-pristenoyl-CoA + H2O2\", \"(2S)-pristanoyl-CoA + O2 => trans-2,3-dehydropristanoyl-CoA + H2O2 (ACOX2)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-389889\", \"stIdVersion\": \"R-RNO-389889.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10018768, \"displayName\": \"ACOX2:FAD, ACOXL:FAD oxidise (2S)-pristanoyl-CoA to trans-2,3-dehydropristanoyl-CoA\", \"inferredFrom\": [389889], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACOX2:FAD, ACOXL:FAD oxidise (2S)-pristanoyl-CoA to trans-2,3-dehydropristanoyl-CoA\", \"(2S)-pristanoyl-CoA + O2 => (2E)-pristenoyl-CoA + H2O2\", \"(2S)-pristanoyl-CoA + O2 => trans-2,3-dehydropristanoyl-CoA + H2O2 (ACOX2)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-389889\", \"stIdVersion\": \"R-MMU-389889.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389894, \"displayName\": \"trans-2,3-dehydropristanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"trans-2,3-dehydropristanoyl-CoA\", \"(E)-2,3-didehydropristanoyl-CoA(4-)\", \"(E)-2,3-didehydropristanoyl-CoA\"], \"producedByEvent\": [389889], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389894\", \"stIdVersion\": \"R-ALL-389894.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113575, \"displayName\": \"H2O2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O2\", \"hydrogen peroxide\"], \"producedByEvent\": [389889], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113575\", \"stIdVersion\": \"R-ALL-113575.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 389897, \"displayName\": \"Isomerization of (2R)-pristanoyl-CoA to (2S)-pristanoyl-CoA\", \"followingEvent\": [389889], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Isomerization of (2R)-pristanoyl-CoA to (2S)-pristanoyl-CoA\", \"(2R)-pristanoyl-CoA => (2S)-pristanoyl-CoA\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-389897\", \"stIdVersion\": \"R-HSA-389897.3\"}], \"releaseDate\": \"2009-04-01\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-389889\", \"stIdVersion\": \"R-HSA-389889.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 389885, \"displayName\": \"In human liver and kidney tissue, monomeric peroxisomal ACOX...\", \"schemaClass\": \"Summation\", \"text\": \"In human liver and kidney tissue, monomeric peroxisomal ACOX2 (bound to FAD cofactor) catalyzes the reaction of (2S)-pristanoyl-CoA and O2 to form trans-2,3-dehydropristanoyl-CoA and H2O2 (Vanhove et al. 1993; Baumgart et al. 1996). A putative acyl-coenzyme A oxidase-like protein ACOXL could catalyse this type of reaction but its activity has not yet been determined.\"}]}" ;
