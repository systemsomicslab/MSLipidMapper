<https://reactome.org/content/detail/R-HSA-2046090> a mslm:LipidReaction ;
    rdfs:label "Elongation of docosapentaenoyl-CoA to tetracosapentaenoyl-CoA" ;
    mslm:curationStatus mslm:Draft ;
