    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8942208], \"className\": \"CatalystActivity\", \"dbId\": 8942207, \"displayName\": \"hydroperoxy icosatetraenoate isomerase activity of ALOXE3 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 8942208, \"displayName\": \"ALOXE3 isomerises 12R-HpETE to HXA3\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8942208], \"dbId\": 2142790, \"displayName\": \"12R-HpETE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"12R-HpETE\", \"12(R)-HPETE(1-)\", \"12(R)-HPETE\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142790\", \"stIdVersion\": \"R-ALL-2142790.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8942956, \"displayName\": \"The lipoxygenase gene ALOXE3 implicated in skin differentiation encodes a hydroperoxide isomerase\", \"journal\": \"Proc. Natl. Acad. Sci. U.S.A.\", \"pages\": \"9162-7\", \"pubMedIdentifier\": 12881489, \"schemaClass\": \"LiteratureReference\", \"title\": \"The lipoxygenase gene ALOXE3 implicated in skin differentiation encodes a hydroperoxide isomerase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12881489\", \"volume\": 100, \"year\": 2003}, {\"className\": \"LiteratureReference\", \"dbId\": 8942951, \"displayName\": \"Lipoxygenases mediate the effect of essential fatty acid in skin barrier formation: a proposed role in releasing omega-hydroxyceramide for construction of the corneocyte lipid envelope\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"24046-56\", \"pubMedIdentifier\": 21558561, \"schemaClass\": \"LiteratureReference\", \"title\": \"Lipoxygenases mediate the effect of essential fatty acid in skin barrier formation: a proposed role in releasing omega-hydroxyceramide for construction of the corneocyte lipid envelope\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/21558561\", \"volume\": 286, \"year\": 2011}, {\"className\": \"LiteratureReference\", \"dbId\": 8942949, \"displayName\": \"Mutations associated with a congenital form of ichthyosis (NCIE) inactivate the epidermal lipoxygenases 12R-LOX and eLOX3\", \"journal\": \"Biochim. Biophys. Acta\", \"pages\": \"238-47\", \"pubMedIdentifier\": 15629692, \"schemaClass\": \"LiteratureReference\", \"title\": \"Mutations associated with a congenital form of ichthyosis (NCIE) inactivate the epidermal lipoxygenases 12R-LOX and eLOX3\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15629692\", \"volume\": 1686, \"year\": 2005}, {\"className\": \"LiteratureReference\", \"dbId\": 8942952, \"displayName\": \"Homozygous ALOXE3 Nonsense Variant Identified in a Patient with Non-Bullous Congenital Ichthyosiform Erythroderma Complicated by Superimposed Bullous Majocchi's Granuloma: The Consequences of Skin Barrier Dysfunction\", \"journal\": \"Int J Mol Sci\", \"pages\": \"21791-801\", \"pubMedIdentifier\": 26370990, \"schemaClass\": \"LiteratureReference\", \"title\": \"Homozygous ALOXE3 Nonsense Variant Identified in a Patient with Non-Bullous Congenital Ichthyosiform Erythroderma Complicated by Superimposed Bullous Majocchi's Granuloma: The Consequences of Skin Barrier Dysfunction\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/26370990\", \"volume\": 16, \"year\": 2015}], \"maxDepth\": 1, \"name\": [\"ALOXE3 isomerises 12R-HpETE to HXA3\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11049139, \"displayName\": \"ALOXE3 isomerises 12R-HpETE to HXA3\", \"inferredFrom\": [8942208], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOXE3 isomerises 12R-HpETE to HXA3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-8942208\", \"stIdVersion\": \"R-DDI-8942208.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10818200, \"displayName\": \"ALOXE3 isomerises 12R-HpETE to HXA3\", \"inferredFrom\": [8942208], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOXE3 isomerises 12R-HpETE to HXA3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-8942208\", \"stIdVersion\": \"R-GGA-8942208.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10723950, \"displayName\": \"ALOXE3 isomerises 12R-HpETE to HXA3\", \"inferredFrom\": [8942208], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOXE3 isomerises 12R-HpETE to HXA3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8942208\", \"stIdVersion\": \"R-XTR-8942208.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10641263, \"displayName\": \"ALOXE3 isomerises 12R-HpETE to HXA3\", \"inferredFrom\": [8942208], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOXE3 isomerises 12R-HpETE to HXA3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-8942208\", \"stIdVersion\": \"R-DRE-8942208.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10546195, \"displayName\": \"ALOXE3 isomerises 12R-HpETE to HXA3\", \"inferredFrom\": [8942208], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOXE3 isomerises 12R-HpETE to HXA3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8942208\", \"stIdVersion\": \"R-SSC-8942208.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10432717, \"displayName\": \"ALOXE3 isomerises 12R-HpETE to HXA3\", \"inferredFrom\": [8942208], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOXE3 isomerises 12R-HpETE to HXA3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8942208\", \"stIdVersion\": \"R-BTA-8942208.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10318944, \"displayName\": \"ALOXE3 isomerises 12R-HpETE to HXA3\", \"inferredFrom\": [8942208], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOXE3 isomerises 12R-HpETE to HXA3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8942208\", \"stIdVersion\": \"R-CFA-8942208.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10210805, \"displayName\": \"ALOXE3 isomerises 12R-HpETE to HXA3\", \"inferredFrom\": [8942208], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOXE3 isomerises 12R-HpETE to HXA3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8942208\", \"stIdVersion\": \"R-RNO-8942208.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10087717, \"displayName\": \"ALOXE3 isomerises 12R-HpETE to HXA3\", \"inferredFrom\": [8942208], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOXE3 isomerises 12R-HpETE to HXA3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8942208\", \"stIdVersion\": \"R-MMU-8942208.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8942209, \"displayName\": \"HXA3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HXA3\", \"hepoxilin A3(1-)\", \"hepoxilin A3\"], \"producedByEvent\": [8942208], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8942209\", \"stIdVersion\": \"R-ALL-8942209.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2161950, \"displayName\": \"Arachidonate is oxidised to 12R-HpETE by ALOX12B\", \"followingEvent\": [8942208], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Arachidonate is oxidised to 12R-HpETE by ALOX12B\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate + O2 => (12R)-hydroperoxy-(5Z,8Z,10E,14Z)-eicosatetraenoate\"], \"releaseDate\": \"2012-12-04\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161950\", \"stIdVersion\": \"R-HSA-2161950.4\"}], \"releaseDate\": \"2017-03-27\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8942208\", \"stIdVersion\": \"R-HSA-8942208.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8942203, \"displayName\": \"Hydroperoxide isomerase (ALOXE3, e-LOX-3) is a non-heme iron...\", \"schemaClass\": \"Summation\", \"text\": \"Hydroperoxide isomerase (ALOXE3, e-LOX-3) is a non-heme iron-containing lipoxygenase which is atypical in that it displays a prominent hydroperoxide isomerase activity and a reduced dioxygenase activity compared to other lipoxygenases. The hydroperoxide isomerase activity catalyses the isomerisation of hydroperoxides, derived from arachidonate and linoleate by ALOX12B, into epoxyalcohols (Yu et al. 2003).<br>In the skin, ALOXE3 acts downstream of ALOX12B on the linoleate moiety of esterified omega-hydroxyacyl-sphingosine (EOS) ceramides to produce an epoxy-ketone derivative, a crucial step in the conjugation of omega-hydroxyceramide to membrane proteins, important for the maintenance of the skin permeability barrier and protection against water loss. Loss-of-function mutations in ALOX12B and ALOXE3 represent the second most common cause of autosomal recessive congenital ichthyosis, a hereditary disorder of keratinization (Yu et al. 2005, Wang et al. 2015). Targeted disruption of these genes in mice resulted in neonatal death due to a severely impaired permeability barrier function (Zheng et al. 2011).\"}]}" ;
