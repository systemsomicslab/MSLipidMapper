    mslm:evidenceJson "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 9677320, \"definition\": \"Inhibition\", \"displayName\": \"PTGS1 dimer binds PTGS1 Inhibitors\", \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [9677320], \"dbId\": 428986, \"displayName\": \"PTGS1 dimer [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PTGS1 dimer\", \"PGHS1 homodimer\", \"COX1\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428986\", \"stIdVersion\": \"R-HSA-428986.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [9677320], \"dbId\": 9677343, \"displayName\": \"PTGS1 Inhibitors [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PTGS1 Inhibitors\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9677343\", \"stIdVersion\": \"R-ALL-9677343.1\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9677655, \"displayName\": \"Inhibition of prostaglandin synthesis as a mechanism of action for aspirin-like drugs\", \"journal\": \"Nature New Biol.\", \"pages\": \"232-5\", \"pubMedIdentifier\": 5284360, \"schemaClass\": \"LiteratureReference\", \"title\": \"Inhibition of prostaglandin synthesis as a mechanism of action for aspirin-like drugs\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/5284360\", \"volume\": 231, \"year\": 1971}, {\"className\": \"LiteratureReference\", \"dbId\": 9677653, \"displayName\": \"Mechanism of action of aspirin-like drugs\", \"journal\": \"Semin. Arthritis Rheum.\", \"pages\": \"2-10\", \"pubMedIdentifier\": 9219313, \"schemaClass\": \"LiteratureReference\", \"title\": \"Mechanism of action of aspirin-like drugs\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9219313\", \"volume\": 26, \"year\": 1997}, {\"className\": \"LiteratureReference\", \"dbId\": 9677654, \"displayName\": \"Cyclooxygenase-1 and cyclooxygenase-2 selectivity of widely used nonsteroidal anti-inflammatory drugs\", \"journal\": \"Am. J. Med.\", \"pages\": \"413-21\", \"pubMedIdentifier\": 9626023, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cyclooxygenase-1 and cyclooxygenase-2 selectivity of widely used nonsteroidal anti-inflammatory drugs\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9626023\", \"volume\": 104, \"year\": 1998}, {\"className\": \"LiteratureReference\", \"dbId\": 9677491, \"displayName\": \"Nonsteroid drug selectivities for cyclo-oxygenase-1 rather than cyclo-oxygenase-2 are associated with human gastrointestinal toxicity: a full in vitro analysis\", \"journal\": \"Proc. Natl. Acad. Sci. U.S.A.\", \"pages\": \"7563-8\", \"pubMedIdentifier\": 10377455, \"schemaClass\": \"LiteratureReference\", \"title\": \"Nonsteroid drug selectivities for cyclo-oxygenase-1 rather than cyclo-oxygenase-2 are associated with human gastrointestinal toxicity: a full in vitro analysis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/10377455\", \"volume\": 96, \"year\": 1999}], \"maxDepth\": 1, \"name\": [\"PTGS1 dimer binds PTGS1 Inhibitors\"], \"orthologousEvent\": [{\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10824990, \"displayName\": \"PTGS1 dimer binds PTGS1 Inhibitors\", \"inferredFrom\": [9677320], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS1 dimer binds PTGS1 Inhibitors\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-9677320\", \"stIdVersion\": \"R-GGA-9677320.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10729574, \"displayName\": \"PTGS1 dimer binds PTGS1 Inhibitors\", \"inferredFrom\": [9677320], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS1 dimer binds PTGS1 Inhibitors\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9677320\", \"stIdVersion\": \"R-XTR-9677320.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10647191, \"displayName\": \"PTGS1 dimer binds PTGS1 Inhibitors\", \"inferredFrom\": [9677320], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS1 dimer binds PTGS1 Inhibitors\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9677320\", \"stIdVersion\": \"R-DRE-9677320.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10553676, \"displayName\": \"PTGS1 dimer binds PTGS1 Inhibitors\", \"inferredFrom\": [9677320], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS1 dimer binds PTGS1 Inhibitors\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9677320\", \"stIdVersion\": \"R-SSC-9677320.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10440394, \"displayName\": \"PTGS1 dimer binds PTGS1 Inhibitors\", \"inferredFrom\": [9677320], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS1 dimer binds PTGS1 Inhibitors\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9677320\", \"stIdVersion\": \"R-BTA-9677320.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10326357, \"displayName\": \"PTGS1 dimer binds PTGS1 Inhibitors\", \"inferredFrom\": [9677320], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS1 dimer binds PTGS1 Inhibitors\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9677320\", \"stIdVersion\": \"R-CFA-9677320.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10218838, \"displayName\": \"PTGS1 dimer binds PTGS1 Inhibitors\", \"inferredFrom\": [9677320], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS1 dimer binds PTGS1 Inhibitors\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9677320\", \"stIdVersion\": \"R-RNO-9677320.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10095529, \"displayName\": \"PTGS1 dimer binds PTGS1 Inhibitors\", \"inferredFrom\": [9677320], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS1 dimer binds PTGS1 Inhibitors\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9677320\", \"stIdVersion\": \"R-MMU-9677320.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 9677354, \"displayName\": \"PTGS1 dimer:PTGS1 Inhibitors [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PTGS1 dimer:PTGS1 Inhibitors\"], \"producedByEvent\": [9677320], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9677354\", \"stIdVersion\": \"R-HSA-9677354.1\"}], \"precedingEvent\": [{\"category\": \"uncertain\", \"className\": \"Reaction\", \"dbId\": 9754180, \"displayName\": \"APAP translocates from extracellular region to cytosol\", \"followingEvent\": [9677320], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"APAP translocates from extracellular region to cytosol\"], \"releaseDate\": \"2021-12-08\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9754180\", \"stIdVersion\": \"R-HSA-9754180.2\"}], \"releaseDate\": \"2022-06-09\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9677320\", \"stIdVersion\": \"R-HSA-9677320.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9677621, \"displayName\": \"Prostaglandins are involved in physiological functions such ...\", \"schemaClass\": \"Summation\", \"text\": \"Prostaglandins are involved in physiological functions such as protecting the stomach mucosa, platelet aggregation and regulating kidney function. They also play pathological roles in inflammation, fever and pain (Ricciotti & FitzGerald 2011). Cyclooxygenase enzymes mediate the production of protaglandins. Prostaglandin G/H synthase 1 (PTGS1, cyclooxygenase 1, COX1) is a mainly constitutively expressed enzyme that acts in a 'housekeeping' fashion producing prostaglandins for physiological functions whereas prostaglandin G/H synthase 2 (PTGS2, cyclooxygenase 2, COX2) is an inducible form which mediates protaglandin production for inflammation.<br><br>In 1971, John R Vane showed that the pharmacological actions of aspirin and similar nonsteroid anti-inflammatory drugs (NSAIDs) were due to the inhibition of cyclooxygenase (Vane 1971). Thus, aspirin-like drugs exert their anti-inflammatory, antipyretic and analgesic effects by the inhibition of cyclooxygenase (Vane & Botting 1997, Botting 2006). The beneficial actions of NSAIDs can be associated with inhibition of COX2 whereas their harmful side effects are associated with inhibition of COX1 therefore developing drugs with a high COX2 specificity is advantageous (Cryer & Feldman 1998, Warner et al. 1999, García-Rayado et al. 2018, Saad & Matthew 2020).<br><br>Most NSAIDs possess some or all of antipyretic, analgesic and anti-inflammatory properties and are used to treat rheumatic and osteoarthritic conditions, pain, inflammation and fever (Botting 2006, Crofford 2013).\"}]}" ;
