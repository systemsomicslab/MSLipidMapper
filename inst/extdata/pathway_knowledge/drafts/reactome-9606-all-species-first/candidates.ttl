ame\": \"2xHSD17B8:2xCBR4 reduces 3OA-ACP to 3HA-ACP\", \"inferredFrom\": [8862152], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2xHSD17B8:2xCBR4 reduces 3OA-ACP to 3HA-ACP\", \"a 3-oxoacyl-(ACP) + H(+) + NADPH => a (3R)-hydroxyacyl-(ACP) + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8862152\", \"stIdVersion\": \"R-RNO-8862152.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10083043, \"displayName\": \"2xHSD17B8:2xCBR4 reduces 3OA-ACP to 3HA-ACP\", \"inferredFrom\": [8862152], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2xHSD17B8:2xCBR4 reduces 3OA-ACP to 3HA-ACP\", \"a 3-oxoacyl-(ACP) + H(+) + NADPH => a (3R)-hydroxyacyl-(ACP) + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8862152\", \"stIdVersion\": \"R-MMU-8862152.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 113563, \"displayName\": \"NADP+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [8862152], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113563\", \"stIdVersion\": \"R-ALL-113563.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 8862371, \"displayName\": \"3HA-ACP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3HA-ACP\", \"O-[S-(3R)-3-hydroxyacylpantetheine-4'-phosphoryl]serine(1-) residue\", \"(3R)-3-hydroxyacyl-(acyl-carrier-protein)\", \"(3R)-3-hydroxyacyl-[acyl-carrier-protein]\", \"3-hydroxyacyl-(acyl-carrier protein)\"], \"producedByEvent\": [8862152], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8862371\", \"stIdVersion\": \"R-ALL-8862371.6\"}], \"releaseDate\": \"2016-06-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8862152\", \"stIdVersion\": \"R-HSA-8862152.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8862373, \"displayName\": \"Estradiol 17-beta-dehydrogenase 8 (HSD17B8) (Ohno et al. 200...\", \"schemaClass\": \"Summation\", \"text\": \"Estradiol 17-beta-dehydrogenase 8 (HSD17B8) (Ohno et al. 2008) forms a heterotetramer with carbonyl reductase family member 4 (CBR4) (Chen et al. 2009, Zhang et al. 2005). The heterotetramer has NADPH-dependent 3-ketoacyl-acyl carrier protein reductase activity which is suggested to play a role in biosynthesis of fatty acids in mitochondria (Venkatesan et al. 2014).\"}]}" ;
