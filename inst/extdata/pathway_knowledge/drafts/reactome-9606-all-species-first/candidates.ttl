": [2161768], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"LTA4 is converted to EXA4 by ALOX15\"], \"releaseDate\": \"2012-12-04\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2162019\", \"stIdVersion\": \"R-HSA-2162019.3\"}], \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161768\", \"stIdVersion\": \"R-HSA-2161768.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2161974, \"displayName\": \"In addition to its role converting leukotriene A4 (LTA4) int...\", \"schemaClass\": \"Summation\", \"text\": \"In addition to its role converting leukotriene A4 (LTA4) into leukotriene C4 (LTC4), the enzyme leukotriene C4 synthase (LTC4S) analogously converts eoxin A4 (EXA4), with reduced glutathione (GSH), to eoxin C4 (EXC4) (Feltenmark et al. 2008, Claesson et al. 2008).\"}]}" ;
