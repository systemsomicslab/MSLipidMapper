te\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5690046\", \"stIdVersion\": \"R-RNO-5690046.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10068179, \"displayName\": \"PPT2 hydrolyses PALMCoA to PALM\", \"inferredFrom\": [5690046], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPT2 hydrolyses PALMCoA to PALM\", \"H2O + hexadecanoyl-CoA => CoA + H(+) + hexadecanoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-5690046\", \"stIdVersion\": \"R-MMU-5690046.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 5690516, \"displayName\": \"PALM [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PALM\", \"hexadecanoate\", \"palmitate\"], \"producedByEvent\": [5690046], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5690516\", \"stIdVersion\": \"R-ALL-5690516.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1678675, \"displayName\": \"CoA-SH [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [5690046], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1678675\", \"stIdVersion\": \"R-ALL-1678675.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 428040, \"displayName\": \"H+ [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [5690046], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428040\", \"stIdVersion\": \"R-ALL-428040.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2015-09-22\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5690046\", \"stIdVersion\": \"R-HSA-5690046.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5690518, \"displayName\": \"The maintenance/regulation of cellular levels of free fatty ...\", \"schemaClass\": \"Summation\", \"text\": \"The maintenance/regulation of cellular levels of free fatty acids and fatty acyl-CoAs (the activated form of free fatty acids) is extremely important, as imbalances in lipid metabolism can have serious consequences for human health. Free fatty acids can act as detergents to disrupt membranes so their generation is normally tightly regulated to states where they will be rapidly consumed or sequestered. Acyl-coenzyme A thioesterases (ACOTs) hydrolyse the thioester bond in medium- to long-chain fatty acyl-CoAs (of C12-C18 lengths) (MCFAcylCoA, LCFAcylCoA) to their free fatty acids (MCFA, LCFA) (Cohen 2013, Hunt et al. 2012, Kirkby et al. 2010). Lysosomal thioesterase PPT2 is able to specifically hydrolyse palmitoyl-CoA (PALM-CoA) to palmitic acid (PALM) (Soyombo & Hofmann 1997).\"}]}" ;
