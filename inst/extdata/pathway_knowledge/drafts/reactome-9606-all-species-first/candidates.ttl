    mslm:evidenceJson "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9717841, \"displayName\": \"holo-FDPS dimer binds NBPs\", \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [9717841], \"dbId\": 981570, \"displayName\": \"holo-FDPS dimer [cytosol]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"holo-FDPS dimer\", \"2(FDPS:3Mg2+)\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-981570\", \"stIdVersion\": \"R-HSA-981570.2\"}, {\"className\": \"Set\", \"consumedByEvent\": [9717841], \"dbId\": 9717840, \"displayName\": \"NBPs [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"NBPs\", \"FDPS inhibitors\", \"biphosphonates\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9717840\", \"stIdVersion\": \"R-ALL-9717840.1\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9717861, \"displayName\": \"Alendronate is a specific, nanomolar inhibitor of farnesyl diphosphate synthase\", \"journal\": \"Arch. Biochem. Biophys.\", \"pages\": \"231-41\", \"pubMedIdentifier\": 10620343, \"schemaClass\": \"LiteratureReference\", \"title\": \"Alendronate is a specific, nanomolar inhibitor of farnesyl diphosphate synthase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/10620343\", \"volume\": 373, \"year\": 2000}, {\"className\": \"LiteratureReference\", \"dbId\": 9717875, \"displayName\": \"Design, synthesis, and biological evaluation of novel aminob