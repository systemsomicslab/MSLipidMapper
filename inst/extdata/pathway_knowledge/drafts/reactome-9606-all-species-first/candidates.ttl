    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [2161732], \"className\": \"CatalystActivity\", \"dbId\": 2161726, \"displayName\": \"11-hydroxythromboxane B2 dehydrogenase activity of TXDH [endoplasmic reticulum lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690675, \"displayName\": \"RHEA:52313\", \"identifier\": \"52313\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/52313\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9915831, \"displayName\": \"RHEA:52313\", \"identifier\": \"52313\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/52313\"}], \"dbId\": 2161732, \"displayName\": \"TXB2 is converted to 11dh-TXB2 by TXDH\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161732], \"dbId\": 443890, \"displayName\": \"TXB2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TXB2\", \"thromboxane B2(1-)\", \"thromboxane B2\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-443890\", \"stIdVersion\": \"R-ALL-443890.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161732], \"dbId\": 194653, \"displayName\": \"NAD+ [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194653\", \"stIdVersion\": \"R-ALL-194653.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 2161625, \"displayName\": \"Radioimmunoassay for 11-dehydro-TXB2: a method for monitoring thromboxane production in vivo\", \"journal\": \"Prostaglandins\", \"pages\": \"741-67\", \"pubMedIdentifier\": 3823488, \"schemaClass\": \"LiteratureReference\", \"title\": \"Radioimmunoassay for 11-dehydro-TXB2: a method for monitoring thromboxane production in vivo\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/3823488\", \"volume\": 32, \"year\": 1986}, {\"className\": \"LiteratureReference\", \"dbId\": 2161569, \"displayName\": \"11-Dehydrothromboxane B2: a quantitative index of thromboxane A2 formation in the human circulation\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"5861-5\", \"pubMedIdentifier\": 3461463, \"schemaClass\": \"LiteratureReference\", \"title\": \"11-Dehydrothromboxane B2: a quantitative index of thromboxane A2 formation in the human circulation\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/3461463\", \"volume\": 83, \"year\": 1986}, {\"className\": \"LiteratureReference\", \"dbId\": 2161682, \"displayName\": \"11-Hydroxythromboxane B2 dehydrogenase is identical to cytosolic aldehyde dehydrogenase\", \"journal\": \"FEBS Lett\", \"pages\": \"99-103\", \"pubMedIdentifier\": 8200461, \"schemaClass\": \"LiteratureReference\", \"title\": \"11-Hydroxythromboxane B2 dehydrogenase is identical to cytosolic aldehyde dehydrogenase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8200461\", \"volume\": 345, \"year\": 1994}], \"maxDepth\": 1, \"name\": [\"TXB2 is converted to 11dh-TXB2 by TXDH\", \"NAD(+) + thromboxane B2 => 11-dehydro-thromboxane B2 + H(+) + NADH\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142828, \"displayName\": \"11dh-TXB2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"11dh-TXB2\", \"11-dehydro-thromboxane B2(1-)\", \"11-dehydro-thromboxane B2\"], \"producedByEvent\": [2161732], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142828\", \"stIdVersion\": \"R-ALL-2142828.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 194697, \"displayName\": \"NADH [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [2161732], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194697\", \"stIdVersion\": \"R-ALL-194697.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 156540, \"displayName\": \"H+ [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [2161732], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-156540\", \"stIdVersion\": \"R-ALL-156540.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 443894, \"displayName\": \"TXA2 is hydrolysed to TXB2\", \"followingEvent\": [2161732], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"TXA2 is hydrolysed to TXB2\", \"Thromboxane A2 degenerates to thromboxane B2\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-443894\", \"stIdVersion\": \"R-HSA-443894.3\"}], \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161732\", \"stIdVersion\": \"R-HSA-2161732.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2161584, \"displayName\": \"Thromboxane B2 (TXB2) undergoes dehydrogenation at C-11 to f...\", \"schemaClass\": \"Summation\", \"text\": \"Thromboxane B2 (TXB2) undergoes dehydrogenation at C-11 to form 11-dehydro-thromboxane B2 (11dh-TXB2).  The enzyme responsible for catalysis has been termed 11-dehydroxythromboxane B2 dehydrogenase (TXDH) (Kumlin & Granström 1986, Catella et al. 1986, Westlund et al. 1994).  The human TXDH isoform has not been cloned but 11dh-TXB2 has been detected in various experiments.\"}]}" ;
