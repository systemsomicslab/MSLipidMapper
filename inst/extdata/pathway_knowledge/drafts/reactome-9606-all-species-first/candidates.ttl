    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [192097], \"className\": \"CatalystActivity\", \"dbId\": 192106, \"displayName\": \"steroid dehydrogenase activity, acting on the CH-OH group of donors, NAD or NADP as acceptor of HSD3B7 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690644, \"displayName\": \"RHEA:11896\", \"identifier\": \"11896\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/11896\"}], \"dbId\": 192097, \"displayName\": \"7alpha-hydroxycholesterol is oxidized and isomerized to 4-cholesten-7alpha-ol-3-one\", \"followingEvent\": [192033], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [192097], \"dbId\": 192114, \"displayName\": \"7 alpha-hydroxycholesterol [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7 alpha-hydroxycholesterol\", \"7alpha-hydroxycholesterol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192114\", \"stIdVersion\": \"R-ALL-192114.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [192097], \"dbId\": 29360, \"displayName\": \"NAD+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29360\", \"stIdVersion\": \"R-ALL-29360.6\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 193374, \"displayName\": \"Molecular genetics of 3beta-hydroxy-Delta5-C27-steroid oxidoreductase deficiency in 16 patients with loss of bile acid synthesis and liver disease\", \"journal\": \"J Clin Endocrinol Metab\", \"pages\": \"1833-41\", \"pubMedIdentifier\": 12679481, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular genetics of 3beta-hydroxy-Delta5-C27-steroid oxidoreductase deficiency in 16 patients with loss of bile acid synthesis and liver disease\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12679481\", \"volume\": 88, \"year\": 2003}, {\"className\": \"LiteratureReference\", \"dbId\": 193532, \"displayName\": \"The bile acid synthetic gene 3beta-hydroxy-Delta(5)-C(27)-steroid oxidoreductase is mutated in progressive intrahepatic cholestasis\", \"journal\": \"J Clin Invest\", \"pages\": \"1175-84\", \"pubMedIdentifier\": 11067870, \"schemaClass\": \"LiteratureReference\", \"title\": \"The bile acid synthetic gene 3beta-hydroxy-Delta(5)-C(27)-steroid oxidoreductase is mutated in progressive intrahepatic cholestasis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11067870\", \"volume\": 106, \"year\": 2000}], \"maxDepth\": 1, \"name\": [\"7alpha-hydroxycholesterol is oxidized and isomerized to 4-cholesten-7alpha-ol-3-one\", \"7alpha-hydroxycholesterol + NAD(+) => 7alpha-hydroxycholest-4-en-3-one + H(+) + NADH\"], \"orthologousEvent\": 