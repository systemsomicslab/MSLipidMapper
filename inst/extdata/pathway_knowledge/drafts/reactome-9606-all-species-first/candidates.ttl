<https://reactome.org/content/detail/R-HSA-194025> a mslm:LipidReaction ;
    rdfs:label "11-deoxycortisol translocates to the mitochondrion" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "11-deoxycortisol [cytosol] => 11DCORT [mitochondrial matrix]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 194025, \"displayName\": \"11-deoxycortisol translocates to the mitochondrion\", \"followingEvent\": [193997], \"goBiologicalProcess\": {\"accession\": \"0170036\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 9910499, \"definition\": \"The directed movement of substances from the cytosol into the mitochondrion.\", \"displayName\": \"import into the mitochondrion\", \"name\": \"import into the mitochondrion\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0170036\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [194025], \"dbId\": 193966, \"displayName\": \"11-deoxycortisol [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"11-deoxycortisol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193966\", \"stIdVersion\": \"R-ALL-193966.2\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 193094, \"displayName\": \"Overview of steroidogenic enzymes in the pathway from cholesterol to active steroid hormones\", \"journal\": \"Endocr Rev\", \"pages\": \"947-70\", \"pubMedIdentifier\": 15583024, \"schemaClass\": \"LiteratureReference\", \"title\": \"Overview of steroidogenic enzymes in the pathway from cholesterol to active steroid hormones\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15583024\", \"volume\": 25, \"year\": 2004}], \"maxDepth\": 1, \"name\": [\"11-deoxycortisol translocates to the mitochondrion\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193998, \"displayName\": \"11DCORT [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"11DCORT\", \"11-deoxycortisol\"], \"producedByEvent\": [194025], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193998\", \"stIdVersion\": \"R-ALL-193998.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193981, \"displayName\": \"CYP21A2 oxidises 17HPROG\", \"followingEvent\": [194025], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYP21A2 oxidises 17HPROG\", \"17alpha-hydroxyprogesterone + O2 + reduced (NADPH--hemoprotein reductase) => 11-deoxycortisol + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\", \"Hydroxylation of 17-hydroxyprogesterone to form 11-deoxycortisol\", \"17-hydroxyprogesterone + NADPH + H+ + O2 => 11-deoxycortisol + NADP+ + H2O\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193981\", \"stIdVersion\": \"R-HSA-193981.4\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194025\", \"stIdVersion\": \"R-HSA-194025.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 196371, \"displayName\": \"11-deoxycortisol is synthesized in a reaction at the endopla...\", \"schemaClass\": \"Summation\", \"text\": \"11-deoxycortisol is synthesized in a reaction at the endoplasmic reticulum membrane and is further metabolized to cortisol in a reaction catalyzed by mitochondrial enzymes. The means by which 11-deoxycortisol translocates into the mitochondrial matrix, however, is unknown. \"}]}" ;
