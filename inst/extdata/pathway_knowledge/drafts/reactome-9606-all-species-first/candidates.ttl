\", \"stIdVersion\": \"R-CFA-8848582.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10203618, \"displayName\": \"AWAT2 transfers PALM from PALM-CoA to HXOL, forming palmityl palmitate ester\", \"inferredFrom\": [8848582], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AWAT2 transfers PALM from PALM-CoA to HXOL, forming palmityl palmitate ester\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8848582\", \"stIdVersion\": \"R-RNO-8848582.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10080823, \"displayName\": \"AWAT2 transfers PALM from PALM-CoA to HXOL, forming palmityl palmitate ester\", \"inferredFrom\": [8848582], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AWAT2 transfers PALM from PALM-CoA to HXOL, forming palmityl palmitate ester\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8848582\", \"stIdVersion\": \"R-MMU-8848582.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [8848582], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 8848499, \"displayName\": \"PALM-PALM [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PALM-PALM\", \"palmityl palmitate\"], \"producedByEvent\": [8848582], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8848499\", \"stIdVersion\": \"R-ALL-8848499.3\"}], \"releaseDate\": \"2016-03-23\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8848582\", \"stIdVersion\": \"R-HSA-8848582.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8848583, \"displayName\": \"AWAT2 (Acyl-CoA wax alcohol acyltransferase 2, also known as...\", \"schemaClass\": \"Summation\", \"text\": \"AWAT2 (Acyl-CoA wax alcohol acyltransferase 2, also known as MFAT and DC4) associated with the endoplasmic reticulum membrane catalyzes the reaction of HXOL (hexadecanol) and PALM-CoA (palmitoyl-CoA) to form the wax monoester palmityl palmitate. The enzyme also acts efficiently on other long-chain fatty alcohols and fatty acyl CoAs. It is abundant in skin and is thought to play a central role in the synthesis of wax molecules that protect the skin from drying (Cheng & Russell 2004; Turkish et al. 2005; Yen et al. 2005).\"}]}" ;
