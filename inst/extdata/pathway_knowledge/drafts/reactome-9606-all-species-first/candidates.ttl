], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AACS ligates CoA-SH to ACA, forming ACA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-5694494\", \"stIdVersion\": \"R-SSC-5694494.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10415553, \"displayName\": \"AACS ligates CoA-SH to ACA, forming ACA-CoA\", \"inferredFrom\": [5694494], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AACS ligates CoA-SH to ACA, forming ACA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-5694494\", \"stIdVersion\": \"R-BTA-5694494.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10193049, \"displayName\": \"AACS ligates CoA-SH to ACA, forming ACA-CoA\", \"inferredFrom\": [5694494], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AACS ligates CoA-SH to ACA, forming ACA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5694494\", \"stIdVersion\": \"R-RNO-5694494.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10069791, \"displayName\": \"AACS ligates CoA-SH to ACA, forming ACA-CoA\", \"inferredFrom\": [5694494], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AACS ligates CoA-SH to ACA, forming ACA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-5694494\", \"stIdVersion\": \"R-MMU-5694494.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 191293, \"displayName\": \"ACA-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ACA-CoA\", \"acetoacetyl-CoA(4-)\", \"acetoacetyl-CoA\"], \"producedByEvent\": [5694494], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191293\", \"stIdVersion\": \"R-ALL-191293.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76577, \"displayName\": \"AMP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AMP\", \"adenosine 5'-monophosphate(2-)\", \"adenosine 5'-monophosphate\", \"Adenylic acid\", \"Adenylate\", \"5'-AMP\", \"5'-Adenylic acid\", \"5'-Adenosine monophosphate\"], \"producedByEvent\": [5694494], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76577\", \"stIdVersion\": \"R-ALL-76577.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111294, \"displayName\": \"PPi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [5694494], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111294\", \"stIdVersion\": \"R-ALL-111294.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 5696457, \"displayName\": \"BDH2 dehydrogenates 3HBA\", \"followingEvent\": [5694494], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"BDH2 dehydrogenates 3HBA\"], \"releaseDate\": \"2015-09-22\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5696457\", \"stIdVersion\": \"R-HSA-5696457.2\"}], \"releaseDate\": \"2015-09-22\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5694494\", \"stIdVersion\": \"R-HSA-5694494.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5694451, \"displayName\": \"Ketone bodies (KBs) are an energy source utilised by mammals...\", \"schemaClass\": \"Summation\", \"text\": \"Ketone bodies (KBs) are an energy source utilised by mammals, the terminal oxidation of which (termed ketogenesis) is most active during fasting states or starvation. This process normally occurs in the mitochondria of cells. Cytoplasmic de novo lipogenesis and cholesterol synthesis are nonoxidative metabolic fates of ketone bodies. Acetoacetyl-CoA synthetase (AACS) mediates the activation of acetoacetate (ACA) to the KB acetoacetyl-CoA (ACA-CoA) in the cytosol of cells of lipogenic tissues (Aquilo et al. 2010). AACS is proposed to provide an alternative supply of acetyl units from that of mitochondrial ketogenesis for de novo lipogenesis and cholesterol synthesis in the brain, based on rat experiments (Endemann et al. 1982, review Cotter et al. 2013).  Human AACS mRNA is abundant in the kidney, heart and brain, but low in liver (Ohgami et al. 2003).\"}]}" ;
