    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [2161917], \"className\": \"CatalystActivity\", \"dbId\": 2161852, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen, incorporation of two atoms of oxygen of ALOX5:ALOX5AP:LTC4S [nuclear envelope]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 2161917, \"displayName\": \"ALOX5 oxidises 15S-HpETE to LXA4/B4\", \"followingEvent\": [2161779], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161917], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161917, 2161917], \"dbId\": 2142718, \"displayName\": \"15S-HpETE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"15S-HpETE\", \"15(S)-HPETE(1-)\", \"15(S)-HPETE\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142718\", \"stIdVersion\": \"R-ALL-2142718.4\"}, 2142718], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 2161806, \"displayName\": \"Lipoxins: novel series of biologically active compounds formed from arachidonic acid in human leukocytes