e\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-8963915\", \"stIdVersion\": \"R-CEL-8963915.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10908269, \"displayName\": \"1,25(OH)2D binds VDR\", \"inferredFrom\": [8963915], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1,25(OH)2D binds VDR\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8963915\", \"stIdVersion\": \"R-DME-8963915.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10820412, \"displayName\": \"1,25(OH)2D binds VDR\", \"inferredFrom\": [8963915], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1,25(OH)2D binds VDR\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-8963915\", \"stIdVersion\": \"R-GGA-8963915.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10725725, \"displayName\": \"1,25(OH)2D binds VDR\", \"inferredFrom\": [8963915], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1,25(OH)2D binds VDR\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8963915\", \"stIdVersion\": \"R-XTR-8963915.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10643216, \"displayName\": \"1,25(OH)2D binds VDR\", \"inferredFrom\": [8963915], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1,25(OH)2D binds VDR\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-8963915\", \"stIdVersion\": \"R-DRE-8963915.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10548582, \"displayName\": \"1,25(OH)2D binds VDR\", \"inferredFrom\": [8963915], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1,25(OH)2D binds VDR\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8963915\", \"stIdVersion\": \"R-SSC-8963915.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10435140, \"displayName\": \"1,25(OH)2D binds VDR\", \"inferredFrom\": [8963915], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1,25(OH)2D binds VDR\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8963915\", \"stIdVersion\": \"R-BTA-8963915.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10213292, \"displayName\": \"1,25(OH)2D binds VDR\", \"inferredFrom\": [8963915], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1,25(OH)2D binds VDR\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8963915\", \"stIdVersion\": \"R-RNO-8963915.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10090106, \"displayName\": \"1,25(OH)2D binds VDR\", \"inferredFrom\": [8963915], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1,25(OH)2D binds VDR\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8963915\", \"stIdVersion\": \"R-MMU-8963915.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 8963916, \"displayName\": \"1,25(OH)2D:VDR [nucleoplasm]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"1,25(OH)2D:VDR\"], \"producedByEvent\": [8963915], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8963916\", \"stIdVersion\": \"R-HSA-8963916.1\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 8963913, \"displayName\": \"1,25(OH)2D translocates from cytosol to nucleoplasm\", \"followingEvent\": [8963915], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"1,25(OH)2D translocates from cytosol to nucleoplasm\"], \"releaseDate\": \"2017-12-13\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8963913\", \"stIdVersion\": \"R-HSA-8963913.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2017-12-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8963915\", \"stIdVersion\": \"R-HSA-8963915.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8963933, \"displayName\": \"The biologically active form of vitamin D, 1-alpha, 25-dihyd...\", \"schemaClass\": \"Summation\", \"text\": \"The biologically active form of vitamin D, 1-alpha, 25-dihydroxyvitamin D (1,25(OH)2D), interacts with the nuclear hormone receptor vitamin D receptor (VDR) in the nucleoplasm of any target tissue (Neme et al. 2017). VDR regulates the actions of 1,25(OH)2D and their binding recruits coactivators (Eelen et al. 2005, Kim et al. 2005, Du et al. 2017) to initiate a signaling response that regulates an estimated upwards of 2000 genes involved in calcium homeostasis, immune responses, cellular growth, differentiation and apoptosis (Hossein-nezhad et al. 2013, Hossein-nezhad & Holick 2013, Wolden-Kirk et al. 2012, Prietl et al. 2013, Hewison 2012, Christakos et al. 2016, Bandera Merchan et al. 2017).\"}]}" ;
