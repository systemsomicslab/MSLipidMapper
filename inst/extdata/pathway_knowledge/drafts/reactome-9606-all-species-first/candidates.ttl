": true, \"maxDepth\": 1, \"name\": [\"CYP17A1 cleaves 17aHPREG to DHA\", \"Side chain cleavage of 17alpha-hydroxypregnenolone to yield DHA\", \"17alpha-hydroxyprenenolone + NADPH + H+ + O2 => DHA (dehydroepiandrostenedione) + NADP+ + H2O + acetaldehyde\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-193070\", \"stIdVersion\": \"R-RNO-193070.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007373, \"displayName\": \"CYP17A1 cleaves 17aHPREG to DHA\", \"inferredFrom\": [193070], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP17A1 cleaves 17aHPREG to DHA\", \"Side chain cleavage of 17alpha-hydroxypregnenolone to yield DHA\", \"17alpha-hydroxyprenenolone + NADPH + H+ + O2 => DHA (dehydroepiandrostenedione) + NADP+ + H2O + acetaldehyde\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193070\", \"stIdVersion\": \"R-MMU-193070.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [193070], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [193070], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29510, \"displayName\": \"CH3CHO [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CH3CHO\", \"acetaldehyde\", \"Ethanal\"], \"producedByEvent\": [193070], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29510\", \"stIdVersion\": \"R-ALL-29510.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 176626, \"displayName\": \"DHEA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHEA\", \"dehydroepiandrosterone\"], \"producedByEvent\": [193070], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-176626\", \"stIdVersion\": \"R-ALL-176626.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193068, \"displayName\": \"CYP17A1 17-hydroxylates PREG\", \"followingEvent\": [193070], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYP17A1 17-hydroxylates PREG\", \"O2 + pregnenolone + reduced (NADPH--hemoprotein reductase) => 17alpha-hydroxypregnenolone + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\", \"Hydroxylation of pregnenolone to form 17alpha-hydroxypregnenolone\", \"pregnenolone + NADPH + H+ => 17alpha-hydroxypregnenolone + NADP+ + H2O\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193068\", \"stIdVersion\": \"R-HSA-193068.3\"}], \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 1449712, \"displayName\": \"Positive regulation by 'POMC(138-176) [cytosol]'\", \"regulatedEntity\": [193070], \"schemaClass\": \"PositiveRegulation\", \"stId\": \"R-HSA-1449712\", \"stIdVersion\": \"R-HSA-1449712.1\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193070\", \"stIdVersion\": \"R-HSA-193070.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193146, \"displayName\": \"17-alpha-hydroxypregnenolone, NADPH + H+, and O2 react to fo...\", \"schemaClass\": \"Summation\", \"text\": \"17-alpha-hydroxypregnenolone, NADPH + H+, and O2 react to form DHA (dehydroepiandrostenedione), NADP+, H2O, and acetaldehyde. CYP17 (which also catalyzes 17-alpha-hydroxylation) catalyzes this lyase reaction. There are marked species differences in which substrate is used for this lyase activity. The human enzyme prefers 17alpha-pregnenolone (delta5 steroid) as substrate (Brock, BJ, Waterman, MR, 1999). Corticotropin (Adrenocorticotropic hormone, ACTH) acts through the ACTH receptor called melanocortin receptor type 2 (MC2R) to stimulate steroidogenesis, increasing the production of androgens (McKenna et al, 1997).\"}]}" ;
