on\", \"dbId\": 10327907, \"displayName\": \"PTGS2 dimer binds PTGS inhibitors\", \"inferredFrom\": [9716836], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS2 dimer binds PTGS inhibitors\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9716836\", \"stIdVersion\": \"R-CFA-9716836.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10220463, \"displayName\": \"PTGS2 dimer binds PTGS inhibitors\", \"inferredFrom\": [9716836], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS2 dimer binds PTGS inhibitors\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9716836\", \"stIdVersion\": \"R-RNO-9716836.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10097236, \"displayName\": \"PTGS2 dimer binds PTGS inhibitors\", \"inferredFrom\": [9716836], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS2 dimer binds PTGS inhibitors\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9716836\", \"stIdVersion\": \"R-MMU-9716836.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 9716835, \"displayName\": \"PTGS2 dimer:PTGS inhibitors [endoplasmic reticulum membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"PTGS2 dimer:PTGS inhibitors\"], \"producedByEvent\": [9716836], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9716835\", \"stIdVersion\": \"R-HSA-9716835.1\"}], \"precedingEvent\": [{\"category\": \"uncertain\", \"className\": \"Reaction\", \"dbId\": 9754180, \"displayName\": \"APAP translocates from extracellular region to cytosol\", \"followingEvent\": [9716836], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"APAP translocates from extracellular region to cytosol\"], \"releaseDate\": \"2021-12-08\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9754180\", \"stIdVersion\": \"R-HSA-9754180.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821383, \"definition\": \"internally reviewed\", \"displayName\": \"three stars\", \"name\": [\"three stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2024-09-11\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9716836\", \"stIdVersion\": \"R-HSA-9716836.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9716970, \"displayName\": \"Inhibition of PTGS2 in cells involved in inflammation, fever...\", \"schemaClass\": \"Summation\", \"text\": \"Inhibition of PTGS2 in cells involved in inflammation, fever, and pain explains the therapeutic activity of non-specific PTGS inhibitors (flurbiprofen, diclofenac, meclofenamic acid, nimesulide, ketoprofen, ibuprofen, naproxen, ketorolac, mefenamic acid, oxaprozin, phenylbutazone, piroxicam, suprofen) which show good anti-inflammatory and analgesic efficiency. Due to their simultaneous inhibition of PTGS1, they have side effects like ulcers and upper gastrointestinal complications, as well as increased heart attack and stroke risk (Grosser et al, 2017).\"}]}" ;
