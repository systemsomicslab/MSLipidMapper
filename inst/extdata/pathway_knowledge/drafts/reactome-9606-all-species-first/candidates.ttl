al Compound\", \"dbId\": 76577, \"displayName\": \"AMP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AMP\", \"adenosine 5'-monophosphate(2-)\", \"adenosine 5'-monophosphate\", \"Adenylic acid\", \"Adenylate\", \"5'-AMP\", \"5'-Adenylic acid\", \"5'-Adenosine monophosphate\"], \"producedByEvent\": [193401], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76577\", \"stIdVersion\": \"R-ALL-76577.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111294, \"displayName\": \"PPi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [193401], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111294\", \"stIdVersion\": \"R-ALL-111294.5\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 191971, \"displayName\": \"THCA is translocated from the mitochondrial matrix to the cytosol\", \"followingEvent\": [193401], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"THCA is translocated from the mitochondrial matrix to the cytosol\", \"THCA [mitochondrial matrix] => THCA [cytosol]\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191971\", \"stIdVersion\": \"R-HSA-191971.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193401\", \"stIdVersion\": \"R-HSA-193401.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193413, \"displayName\": \"THCA (25(R) 3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan...\", \"schemaClass\": \"Summation\", \"text\": \"THCA (25(R) 3alpha,7alpha,12alpha-trihydroxy-5beta-cholestanoate), coenzyme A, and ATP react to form the CoA conjugate of 25(R) THCA, AMP, and pyrophosphate. This cytosolic reaction is catalyzed by SLC27A2 (VLCS). SLC27A5 (BACS) also catalyzes this reaction; the relative contributions of the two enzymes to de novo bile acid synthesis in vivo are not certain (Mihalik et al. 2002).\"}]}" ;
