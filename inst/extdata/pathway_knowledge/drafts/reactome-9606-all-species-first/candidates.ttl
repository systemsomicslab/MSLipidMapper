rom\": [1605624], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Beta-galactosidases hydrolyse mobilized GM1 to mobilized GM2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1605624\", \"stIdVersion\": \"R-SSC-1605624.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10386293, \"displayName\": \"Beta-galactosidases hydrolyse mobilized GM1 to mobilized GM2\", \"inferredFrom\": [1605624], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Beta-galactosidases hydrolyse mobilized GM1 to mobilized GM2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1605624\", \"stIdVersion\": \"R-BTA-1605624.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605637, \"displayName\": \"Gal [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Gal\", \"alpha-D-galactose\"], \"producedByEvent\": [1605624], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605637\", \"stIdVersion\": \"R-ALL-1605637.3\"}, {\"className\": \"Set\", \"dbId\": 9840646, \"displayName\": \"mobilized GM2 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"mobilized GM2\"], \"producedByEvent\": [1605624], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840646\", \"stIdVersion\": \"R-HSA-9840646.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9840470, \"displayName\": \"PSAP(195-273) dimer:PE binds and mobilizes ligands\", \"followingEvent\": [1605624], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PSAP(195-273) dimer:PE binds and mobilizes ligands\"], \"releaseDate\": \"2023-09-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840470\", \"stIdVersion\": \"R-HSA-9840470.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1605717, \"displayName\": \"GM2A binds and mobilizes ligands\", \"followingEvent\": [1605624], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GM2A binds and mobilizes ligands\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605717\", \"stIdVersion\": \"R-HSA-1605717.3\"}], \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605624\", \"stIdVersion\": \"R-HSA-1605624.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9841886, \"displayName\": \"The prototypical ganglioside GM1 is hydrolyzed to the GM2 ga...\", \"schemaClass\": \"Summation\", \"text\": \"The prototypical ganglioside GM1 is hydrolyzed to the GM2 ganglioside by beta-galactosidase (GLB1), cleaving off the terminal galactose (Asp et al. 1969). Either Saposin B (PSAP(195-273)) or ganglioside GM2 activator (GM2A, GM2AP) acts as a cofactor (Wilkening et al., 2000). Defects in GLB1 cause the lysosomal storage diseases GM1-gangliosidosis (Yoshida et al. 1991; reviewed in Brunetti-Pierri & Scaglia, 2008) and Morquio syndrome B (Oshima et al. 1991). GLB1L, GLB1L2, and GLB1L3 are gene products with nearly identical protein sequences to GLB1 and may be able to perform the same function.\"}]}" ;
