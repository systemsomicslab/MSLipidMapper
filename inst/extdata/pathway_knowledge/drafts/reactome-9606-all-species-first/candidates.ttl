alse, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 18(R)-HEPE to 5(S)-Hp-18(R)-HEPE\", \"(18R)-hydroxy-(5Z,8Z,11Z,14Z,16E)-eicosapentaenoate + O2 => (5S)-hydroperoxy-(18R)-hydroxy-(6E,8Z,11Z,14Z,16E)-eicosapentaenoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9018863\", \"stIdVersion\": \"R-RNO-9018863.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092455, \"displayName\": \"ALOX5 oxidises 18(R)-HEPE to 5(S)-Hp-18(R)-HEPE\", \"inferredFrom\": [9018863], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 18(R)-HEPE to 5(S)-Hp-18(R)-HEPE\", \"(18R)-hydroxy-(5Z,8Z,11Z,14Z,16E)-eicosapentaenoate + O2 => (5S)-hydroperoxy-(18R)-hydroxy-(6E,8Z,11Z,14Z,16E)-eicosapentaenoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9018863\", \"stIdVersion\": \"R-MMU-9018863.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9023702, \"displayName\": \"5(S)-Hp-18(R)-HEPE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5(S)-Hp-18(R)-HEPE\", \"5(S)-hydroperoxy-18(R)-hydroxy-(6E,8Z,11Z,14Z,16E)-icosapentaenoate\", \"5(S)-Hp-18(R)-HEPE(1-)\", \"5(S)-hydroperoxy-18(R)-hydroxy-(6E,8Z,11Z,14Z,16E)-icosapentaenoic acid\"], \"producedByEvent\": [9018863], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9023702\", \"stIdVersion\": \"R-ALL-9023702.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9018895, \"displayName\": \"GPX4-2 reduces 18(R)-HpEPE to 18(R)-HEPE\", \"followingEvent\": [9018863], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GPX4-2 reduces 18(R)-HpEPE to 18(R)-HEPE\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9018895\", \"stIdVersion\": \"R-HSA-9018895.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9018863\", \"stIdVersion\": \"R-HSA-9018863.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9023710, \"displayName\": \"Unlike resolvin E3, which is biosynthesised in eosinophils o...\", \"schemaClass\": \"Summation\", \"text\": \"Unlike resolvin E3, which is biosynthesised in eosinophils or resident macrophages via the 15-lipoxygenase (ALOX15) pathway, resolvins E1 and E2 are biosynthesised by neutrophils via the 5-lipoxygenase pathway. In neutrophils, ALOX5 oxidises 18(R)-hydroxyeicosapentaenoic acid (18(R)-HEPE) to 5(R)-hydroperoxy-18(R)-hydroxyeicosapentaenoic acid (5(R)-Hp-18(R)-HEPE) (Tjonahen et al. 2006, Oh et al. 2012).\"}]}" ;
