 \"stIdVersion\": \"R-BTA-8871370.1\"}, {\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10316538, \"displayName\": \"p-Y389,400-RUFY1 translocates from cytosol to early endosome membrane\", \"inferredFrom\": [8871370], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"p-Y389,400-RUFY1 translocates from cytosol to early endosome membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8871370\", \"stIdVersion\": \"R-CFA-8871370.1\"}, {\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10208072, \"displayName\": \"p-Y389,400-RUFY1 translocates from cytosol to early endosome membrane\", \"inferredFrom\": [8871370], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"p-Y389,400-RUFY1 translocates from cytosol to early endosome membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8871370\", \"stIdVersion\": \"R-RNO-8871370.1\"}, {\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10085081, \"displayName\": \"p-Y389,400-RUFY1 translocates from cytosol to early endosome membrane\", \"inferredFrom\": [8871370], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"p-Y389,400-RUFY1 translocates from cytosol to early endosome membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8871370\", \"stIdVersion\": \"R-MMU-8871370.1\"}], \"output\": [{\"className\": \"Protein\", \"dbId\": 5215951, \"displayName\": \"p-Y389,400-RUFY1 [early endosome membrane]\", \"endCoordinate\": 708, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"p-Y389,400-RUFY1\", \"RUN and FYVE domain-containing protein 1\", \"RUFY1_HUMAN\"], \"producedByEvent\": [8871370], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5215951\", \"stIdVersion\": \"R-HSA-5215951.2\", \"startCoordinate\": 1}], \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8871370\", \"stIdVersion\": \"R-HSA-8871370.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8871363, \"displayName\": \"RUN and FYVE domain-containing protein 1 (RUFY1, aka RABIP4,...\", \"schemaClass\": \"Summation\", \"text\": \"RUN and FYVE domain-containing protein 1 (RUFY1, aka RABIP4, ZFYVE12) associates with phosphatidylinositol 3-phosphate in membranes of early endosomes and may participate in early endosomal membrane trafficking of the glucose transporter GLUT4. RUFY1 is localised to the cytoplasm and early endosomal membrane, the latter being the predominant localisation after RUFY1 is phosphorylated. Cytoplasmic tyrosine-protein kinase BMX (BMX, aka ETK) is a a downstream tyrosine kinase of PI3-kinase which, through its SH2 and SH3 domains, binds to and phosphorylates RUFY1 at Tyr-389 and Tyr 400. These phosphorylations are essential for endosomal localisation (Yang et al. 2002).\"}]}" ;
