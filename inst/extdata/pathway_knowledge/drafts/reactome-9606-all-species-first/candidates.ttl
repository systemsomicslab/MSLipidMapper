460\", \"stIdVersion\": \"R-ALL-29460.5\"}, {\"className\": \"Complex\", \"dbId\": 8957351, \"displayName\": \"CYP450:Fe3+ [endoplasmic reticulum membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"CYP450:Fe3+\"], \"producedByEvent\": [9947148, 9947148, 9947148], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8957351\", \"stIdVersion\": \"R-HSA-8957351.2\"}, 8957351, 8957351, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [9947148, 9947148, 9947148, 9947148], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, 70106, 70106, 70106, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [9947148, 9947148, 9947148, 9947148], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356, 29356, 29356], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9755937, \"displayName\": \"DHCR24 reduces LAN to 24,25-dhLAN\", \"followingEvent\": [9947148], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"DHCR24 reduces LAN to 24,25-dhLAN\", \"lanosterol + NADPH + H(+) = 24,25-dihydrolanosterol + NADP(+)\"], \"releaseDate\": \"2021-12-08\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9755937\", \"stIdVersion\": \"R-HSA-9755937.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 76494, \"displayName\": \"POR reduces CYP450:Fe3+ to CYP450:Fe2+\", \"followingEvent\": [9947148], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"POR reduces CYP450:Fe3+ to CYP450:Fe2+\", \"2 oxidized (cytochrome P450) + NADPH => 2 reduced (cytochrome P450) + NADP(+) + H(+)\"], \"releaseDate\": \"2016-03-23\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-76494\", \"stIdVersion\": \"R-HSA-76494.5\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821383, \"definition\": \"internally reviewed\", \"displayName\": \"three stars\", \"name\": [\"three stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2025-06-18\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9947148\", \"stIdVersion\": \"R-HSA-9947148.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9947153, \"displayName\": \"CYP51A1 (Lanosterol 14-alpha demethylase), inferred to be lo...\", \"schemaClass\": \"Summation\", \"text\": \"CYP51A1 (Lanosterol 14-alpha demethylase), inferred to be located in the endoplasmic reticulum membrane (Aoyama et al. 1996), demethylates 24,25-dhLAN (24,25-dihydrolanosterol) to 4,4-diMeCholesta-8,14-dien-3-ol (Sonoda et al. 1993; Stromstedt et al. 1996), in a reaction coupled to POR-mediated reduction of oxidized heme iron atoms.\"}]}" ;
