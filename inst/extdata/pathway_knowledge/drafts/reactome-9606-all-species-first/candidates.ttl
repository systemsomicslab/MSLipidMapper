, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARV1 transports CHOL from ER membrane to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-5250531\", \"stIdVersion\": \"R-XTR-5250531.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10618135, \"displayName\": \"ARV1 transports CHOL from ER membrane to plasma membrane\", \"inferredFrom\": [5250531], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARV1 transports CHOL from ER membrane to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-5250531\", \"stIdVersion\": \"R-DRE-5250531.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10519310, \"displayName\": \"ARV1 transports CHOL from ER membrane to plasma membrane\", \"inferredFrom\": [5250531], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARV1 transports CHOL from ER membrane to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-5250531\", \"stIdVersion\": \"R-SSC-5250531.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10405088, \"displayName\": \"ARV1 transports CHOL from ER membrane to plasma membrane\", \"inferredFrom\": [5250531], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARV1 transports CHOL from ER membrane to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-5250531\", \"stIdVersion\": \"R-BTA-5250531.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10181829, \"displayName\": \"ARV1 transports CHOL from ER membrane to plasma membrane\", \"inferredFrom\": [5250531], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARV1 transports CHOL from ER membrane to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5250531\", \"stIdVersion\": \"R-RNO-5250531.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10059306, \"displayName\": \"ARV1 transports CHOL from ER membrane to plasma membrane\", \"inferredFrom\": [5250531], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARV1 transports CHOL from ER membrane to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-5250531\", \"stIdVersion\": \"R-MMU-5250531.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 171095, \"displayName\": \"CHOL [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CHOL\", \"cholesterol\"], \"producedByEvent\": [5250531], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-171095\", \"stIdVersion\": \"R-ALL-171095.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 196417, \"displayName\": \"Reduction of desmosterol to cholesterol\", \"followingEvent\": [5250531], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Reduction of desmosterol to cholesterol\", \"desmosterol + NADPH + H(+) => cholesterol + NADP(+)\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-196417\", \"stIdVersion\": \"R-HSA-196417.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 6807055, \"displayName\": \"DHCR7 reduces 7-dehydroCHOL to CHOL\", \"followingEvent\": [5250531], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"DHCR7 reduces 7-dehydroCHOL to CHOL\", \"7-dehydrocholesterol + NADPH + H(+) => cholesterol + NADP(+)\"], \"releaseDate\": \"2015-12-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6807055\", \"stIdVersion\": \"R-HSA-6807055.4\"}], \"releaseDate\": \"2014-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5250531\", \"stIdVersion\": \"R-HSA-5250531.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5250552, \"displayName\": \"Sterols such as cholesterol (CHOL) synthesised in the endopl...\", \"schemaClass\": \"Summation\", \"text\": \"Sterols such as cholesterol (CHOL) synthesised in the endoplasmic reticulum (ER) need to be efficiently transported to the plasma membrane, where 90% of the free sterol pool resides. Conversely, sterols taken up from outside the cell need to be transported back to the ER for esterification to sterol esters. The mechanisms that control this bi-directional movement of sterols are still poorly understood but a likely candidate is protein ARV1 (ARV1). Studies with mutant yeast Arv1 indicate altered intracellular sterol distribution and subsequent defects in sphingolipid metabolism. Human ARV1, a predicted sequence ortholog of yeast Arv1, complements the defects seen associated with deletion of yeast Arv1 (Tinkelenberg et al. 2000, Swain et al. 2002).\"}]}" ;
