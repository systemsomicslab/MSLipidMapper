tput\": [{\"className\": \"Chemical Compound\", \"dbId\": 192194, \"displayName\": \"Cholest-5-ene-3beta,7alpha,27-triol [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Cholest-5-ene-3beta,7alpha,27-triol\", \"7alpha,26-dihydroxycholesterol\", \"5-Cholesten-3beta,7alpha,27-triol\"], \"producedByEvent\": [191972], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192194\", \"stIdVersion\": \"R-ALL-192194.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [191972], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [191972], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 5340195, \"displayName\": \"NR1H4 binds DCA, CDCA, LCHA\", \"followingEvent\": [191972], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"NR1H4 binds DCA, CDCA, LCHA\", \"FXR binds bile acids\"], \"releaseDate\": \"2015-03-19\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5340195\", \"stIdVersion\": \"R-HSA-5340195.3\"}], \"regulatedBy\": [{\"className\": \"NegativeRegulation\", \"dbId\": 5340418, \"displayName\": \"Negative regulation by 'NCOA1,2:RXRA:NR1H4:DCA,CDCA,LCHA [nucleoplasm]'\", \"regulatedEntity\": [191972], \"schemaClass\": \"NegativeRegulation\", \"stId\": \"R-HSA-5340418\", \"stIdVersion\": \"R-HSA-5340418.1\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191972\", \"stIdVersion\": \"R-HSA-191972.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193810, \"displayName\": \"27-hydroxycholesterol, NADPH + H+, and O2 react to form chol...\", \"schemaClass\": \"Summation\", \"text\": \"27-hydroxycholesterol, NADPH + H+, and O2 react to form cholest-5-ene-3beta,7alpha,27-triol, H2O, and NADP+. This reaction is catalyzed by CYP7B1 in the endoplasmic reticulum membrane. Defects in CYB7B1 are associated with failure of 7alpha-hydroxylation in vivo, and with liver damage, confirming both the function of the enzyme and the central role of the liver in this metabolic process (Setchell et al. 1998).\"}]}" ;
