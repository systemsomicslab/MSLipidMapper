    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9018874], \"className\": \"CatalystActivity\", \"dbId\": 9029002, \"displayName\": \"monooxygenase activity of CYP [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 9018874, \"displayName\": \"CYP monooxygenates EPA to 18(S)-HpEPE\", \"followingEvent\": [9018868], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9018874], \"dbId\": 2026977, \"displayName\": \"EPA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"EPA\", \"all-cis-5,8,11,14,17-icosapentaenoate\", \"eicosapentaenoic acid\", \"all-cis-5,8,11,14,17-icosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2026977\", \"stIdVersion\": \"R-ALL-2026977.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9018874], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9018874], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9018874], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9020473, \"displayName\": \"Arachidonic acid-metabolizing cytochrome P450 enzymes are targets of {omega}-3 fatty acids\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"32720-33\", \"pubMedIdentifier\": 20732876, \"schemaClass\": \"LiteratureReference\", \"title\": \"Arachidonic acid-metabolizing cytochrome P450 enzymes are targets of {omega}-3 fatty acids\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/20732876\", \"volume\": 285, \"year\": 2010}], \"maxDepth\": 1, \"name\": [\"CYP monooxygenates EPA to 18(S)-HpEPE\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9020583, \"displayName\": \"18(S)-HpEPE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"18(S)-HpEPE\", \"(18S)-hydroperoxyicosapentaenoate\", \"(18S)-hydroperoxyicosapentaenoic acid\"], \"producedByEvent\": [9018874], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9020583\", \"stIdVersion\": \"R-ALL-9020583.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [9018874], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9018874\", \"stIdVersion\": \"R-HSA-9018874.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9020491, \"displayName\": \"The same cytochrome P450 (CYP) isoforms that metabolise the ...\", \"schemaClass\": \"Summation\", \"text\": \"The same cytochrome P450 (CYP) isoforms that metabolise the ω-6 polyunsaturated fatty acid (PUFA) arachidonic acid (AA) accept the ω-3 PUFAs eicosapentaenoic acid (EPA) and docosahexaenoic acid (DHA) as efficient alternative substrates (Arnold et al. 2010a). Several human CYPs are thought to oxidise EPA to 18(S)-hydroperoxyeicosapentaenoic acid (18(S)-HpEPE) although the exact CYP enzymes involved are not known (Arnold et al. 2010b, Weylandt et al. 2012). Microbial CYPs can generate 18-HEPE from EPA (Serhan et al. 2000) that can be converted by human PMNs to RvE1 and RvE2 (Arita et al. 2005). The microbial content in the local environment can therefore, also be a critical factor in the production of E-series resolvins in vivo in humans.\"}]}" ;
