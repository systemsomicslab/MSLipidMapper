lassName\": \"Reaction\", \"dbId\": 10558322, \"displayName\": \"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\", \"inferredFrom\": [9841189], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9841189\", \"stIdVersion\": \"R-SSC-9841189.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10445067, \"displayName\": \"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\", \"inferredFrom\": [9841189], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9841189\", \"stIdVersion\": \"R-BTA-9841189.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10330923, \"displayName\": \"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\", \"inferredFrom\": [9841189], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9841189\", \"stIdVersion\": \"R-CFA-9841189.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10223693, \"displayName\": \"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\", \"inferredFrom\": [9841189], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9841189\", \"stIdVersion\": \"R-RNO-9841189.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605637, \"displayName\": \"Gal [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Gal\", \"alpha-D-galactose\"], \"producedByEvent\": [9841189], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605637\", \"stIdVersion\": \"R-ALL-1605637.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1606573, \"displayName\": \"GalCer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GalCer\", \"galactosylceramide\", \"D-galactosyl-N-acylsphingosine\", \"N-acyl-beta-D-galactosylsphingosine\", \"Galactocerebroside\", \"Galactosylceramide\"], \"producedByEvent\": [9841189], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1606573\", \"stIdVersion\": \"R-ALL-1606573.5\"}, {\"className\": \"Complex\", \"dbId\": 9840482, \"displayName\": \"PSAP(195-273) dimer [lysosomal lumen]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"PSAP(195-273) dimer\", \"Sap B dimer\"], \"producedByEvent\": [9841189], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840482\", \"stIdVersion\": \"R-HSA-9840482.1\"}, {\"className\": \"Set\", \"dbId\": 9840939, \"displayName\": \"PE 30,32,34 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PE 30,32,34\"], \"producedByEvent\": [9841189], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9840939\", \"stIdVersion\": \"R-ALL-9840939.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9840470, \"displayName\": \"PSAP(195-273) dimer:PE binds and mobilizes ligands\", \"followingEvent\": [9841189], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PSAP(195-273) dimer:PE binds and mobilizes ligands\"], \"releaseDate\": \"2023-09-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840470\", \"stIdVersion\": \"R-HSA-9840470.2\"}], \"releaseDate\": \"2023-09-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9841189\", \"stIdVersion\": \"R-HSA-9841189.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9841188, \"displayName\": \"Alpha-galactosidase A (GLA) (Bishop et al. 1986) removes the...\", \"schemaClass\": \"Summation\", \"text\": \"Alpha-galactosidase A (GLA) (Bishop et al. 1986) removes the terminal galactose residue from glycolipids or glycoproteins, mobilized by PSAP(195-273) (Saposin B), resulting in galactose and an alcohol. An example is the Fabry disease substrate digalactosylceramide (Gal2Cer) which is hydrolysed to form galactose and galactosylceramide (GalCer) (Dean & Sweeley, 1979). GLA functions as a homodimer (Garman & Garboczi 2004) and defects in this enzyme lead to Fabry disease (FD) (MIM:301500), a rare X-linked sphingolipidosis disease where glycolipids such as Gal2Cer accumulate in many tissues (Garman & Garboczi 2004, Eng et al. 1993, Shabeer et al. 2006).\\nResearchers also observed elevated Gal2Cer in prosaposin deficiency (PSAPD, MIM: 611721) cases, a rare disease with low levels of all saposins. Saposin B (PSAP(195-273)) is an essential cofactor to the reaction (Bradova et al., 1993; Kase et al., 1996)\"}]}" ;
