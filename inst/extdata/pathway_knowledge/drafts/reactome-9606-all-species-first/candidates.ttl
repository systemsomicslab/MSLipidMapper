    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [444433], \"className\": \"CatalystActivity\", \"dbId\": 444463, \"displayName\": \"choline transmembrane transporter activity of CTL1-5 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}, {\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12689761, \"displayName\": \"RHEA:32751\", \"identifier\": \"32751\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/32751\"}], \"dbId\": 444433, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [444433], \"dbId\": 264638, \"displayName\": \"Cho [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Cho\", \"choline\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-264638\", \"stIdVersion\": \"R-ALL-264638.3\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 444435, \"displayName\": \"Characterization of CDw92 as a member of the choline transporter-like protein family regulated specifically on dendritic cells\", \"journal\": \"J Immunol\", \"pages\": \"5795-804\", \"pubMedIdentifier\": 11698453, \"schemaClass\": \"LiteratureReference\", \"title\": \"Characterization of CDw92 as a member of the choline transporter-like protein family regulated specifically on dendritic cells\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11698453\", \"volume\": 167, \"year\": 2001}, {\"className\": \"LiteratureReference\", \"dbId\": 444455, \"displayName\": \"Identification and characterization of choline transporter-like protein 2, an inner ear glycoprotein of 68 and 72 kDa that is the target of antibody-induced hearing loss\", \"journal\": \"J Neurosci\", \"pages\": \"1772-9\", \"pubMedIdentifier\": 14973250, \"schemaClass\": \"LiteratureReference\", \"title\": \"Identification and characterization of choline transporter-like protein 2, an inner ear glycoprotein of 68 and 72 kDa that is the target of antibody-induced hearing loss\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/14973250\", \"volume\": 24, \"year\": 2004}, {\"className\": \"LiteratureReference\", \"dbId\": 372536, \"displayName\": \"Functional characterization of the human high-affinity choline transporter\", \"journal\": \"FEBS Lett\", \"pages\": \"92-7\", \"pubMedIdentifier\": 11068039, \"schemaClass\": \"LiteratureReference\", \"title\": \"Functional characterization of the human high-affinity choline transporter\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11068039\", \"volume\": 484, \"year\": 2000}, {\"className\": \"LiteratureReference\", \"dbId\": 1483013, \"displayName\": \"Molecular characterization of the family of choline transporter-like proteins and their splice variants\", \"journal\": \"J Neurochem\", \"pages\": \"1116-25\", \"pubMedIdentifier\": 15715662, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular characterization of the family of choline transporter-like proteins and their splice variants\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15715662\", \"volume\": 92, \"year\": 2005}, {\"className\": \"LiteratureReference\", \"dbId\": 1482871, \"displayName\": \"An electric lobe suppressor for a yeast choline transport mutation belongs to a new family of transporter-like proteins\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"1835-40\", \"pubMedIdentifier\": 10677542, \"schemaClass\": \"LiteratureReference\", \"title\": \"An electric lobe suppressor for a yeast choline transport mutation belongs to a new family of transporter-like proteins\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/10677542\", \"volume\": 97, \"year\": 2000}], \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11122203, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"inferredFrom\": [444433], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Plasmodium falciparum\", \"stId\": \"R-PFA-444433\", \"stIdVersion\": \"R-PFA-444433.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11019666, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"inferredFrom\": [444433], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-444433\", \"stIdVersion\": \"R-DDI-444433.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10946429, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"inferredFrom\": [444433], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-444433\", \"stIdVersion\": \"R-CEL-444433.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10861180, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"inferredFrom\": [444433], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-444433\", \"stIdVersion\": \"R-DME-444433.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10767220, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"inferredFrom\": [444433], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-444433\", \"stIdVersion\": \"R-GGA-444433.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10682486, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"inferredFrom\": [444433], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-444433\", \"stIdVersion\": \"R-XTR-444433.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10593340, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"inferredFrom\": [444433], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-444433\", \"stIdVersion\": \"R-DRE-444433.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10485912, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"inferredFrom\": [444433], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-444433\", \"stIdVersion\": \"R-SSC-444433.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10371648, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"inferredFrom\": [444433], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-444433\", \"stIdVersion\": \"R-BTA-444433.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10263611, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"inferredFrom\": [444433], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-444433\", \"stIdVersion\": \"R-CFA-444433.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10146220, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"inferredFrom\": [444433], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-444433\", \"stIdVersion\": \"R-RNO-444433.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10023214, \"displayName\": \"Cho transports from the extracellular space to the cytosol\", \"inferredFrom\": [444433], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho transports from the extracellular space to the cytosol\", \"CTL1-5 can mediate the uptake of choline\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-444433\", \"stIdVersion\": \"R-MMU-444433.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 264618, \"displayName\": \"Cho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Cho\", \"choline\"], \"producedByEvent\": [444433], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-264618\", \"stIdVersion\": \"R-ALL-264618.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 372519, \"displayName\": \"AcCho is hydrolyzed to Cho and acetate by ACHE\", \"followingEvent\": [444433], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"AcCho is hydrolyzed to Cho and acetate by ACHE\", \"Acetylcholine clearance from synaptic cleft\"], \"releaseDate\": \"2008-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-372519\", \"stIdVersion\": \"R-HSA-372519.6\"}], \"releaseDate\": \"2009-12-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-444433\", \"stIdVersion\": \"R-HSA-444433.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 444441, \"displayName\": \"Choline (Cho) transports from the extracellular space throug...\", \"schemaClass\": \"Summation\", \"text\": \"Choline (Cho) transports from the extracellular space through the plasma membrane via the choline transporter-like proteins (SLC44A1-5 also known as CTL1-5) to the cytosol (Okuda & Haga 2000, Traiffort et al. 2005, O'Regan et al. 2000).<br><br>CTL1 is broadly expressed on leukocytes and endothelial cells (Wille et al. 2001). CTL2 is highly expressed in human inner ear and is the target of antibody-induced hearing loss (Nair et al. 2004).\"}]}" ;
