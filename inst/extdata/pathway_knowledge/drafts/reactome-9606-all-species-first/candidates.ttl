    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9027627], \"className\": \"CatalystActivity\", \"dbId\": 2161919, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen of Ac-PTGS2 dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 9027627, \"displayName\": \"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\", \"followingEvent\": [9027562], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027627], \"dbId\": 9024011, \"displayName\": \"DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHA\", \"(4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoate\", \"Docosahexaenoic acid\", \"all-cis-docosa-4,7,10,13,16,19-hexaenoic acid\", \"cis-4,7,10,13,16,19-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024011\", \"stIdVersion\": \"R-ALL-9024011.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027627], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9022657, \"displayName\": \"Resolvins: a family of bioactive products of omega-3 fatty acid transformation circuits initiated by aspirin treatment that counter proinflammation signals\", \"journal\": \"J. Exp. Med.\", \"pages\": \"1025-37\", \"pubMedIdentifier\": 12391014, \"schemaClass\": \"LiteratureReference\", \"title\": \"Resolvins: a family of bioactive products of omega-3 fatty acid transformation circuits initiated by aspirin treatment that counter proinflammation signals\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12391014\", \"volume\": 196, \"year\": 2002}, {\"className\": \"LiteratureReference\", \"dbId\": 9027533, \"displayName\": \"Cyclooxygenase-2 generates anti-inflammatory mediators from omega-3 fatty acids\", \"journal\": \"Nat. Chem. Biol.\", \"pages\": \"433-41\", \"pubMedIdentifier\": 20436486, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cyclooxygenase-2 generates anti-inflammatory mediators from omega-3 fatty acids\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/20436486\", \"volume\": 6, \"year\": 2010}], \"maxDepth\": 1, \"name\": [\"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10822973, \"displayName\": \"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\", \"inferredFrom\": [9027627], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-9027627\", \"stIdVersion\": \"R-GGA-9027627.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10727795, \"displayName\": \"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\", \"inferredFrom\": [9027627], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9027627\", \"stIdVersion\": \"R-XTR-9027627.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10645358, \"displayName\": \"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\", \"inferredFrom\": [9027627], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9027627\", \"stIdVersion\": \"R-DRE-9027627.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10551255, \"displayName\": \"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\", \"inferredFrom\": [9027627], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9027627\", \"stIdVersion\": \"R-SSC-9027627.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10437846, \"displayName\": \"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\", \"inferredFrom\": [9027627], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9027627\", \"stIdVersion\": \"R-BTA-9027627.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10323968, \"displayName\": \"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\", \"inferredFrom\": [9027627], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9027627\", \"stIdVersion\": \"R-CFA-9027627.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10216075, \"displayName\": \"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\", \"inferredFrom\": [9027627], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9027627\", \"stIdVersion\": \"R-RNO-9027627.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092863, \"displayName\": \"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\", \"inferredFrom\": [9027627], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9027627\", \"stIdVersion\": \"R-MMU-9027627.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9027622, \"displayName\": \"17-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17-HDHA\", \"(4Z,7Z,10Z,13Z,15E,19Z)-17-hydroxydocosahexaenoate\", \"(4Z,7Z,10Z,13Z,15E,19Z)-17-hydroxydocosahexaenoic acid\", \"17-HDoHE\", \"17-hydroxy-docosahexaenoic acid\"], \"producedByEvent\": [9027627], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9027622\", \"stIdVersion\": \"R-ALL-9027622.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2314686, \"displayName\": \"ASA- acetylates PTGS2\", \"followingEvent\": [9027627], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ASA- acetylates PTGS2\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2314686\", \"stIdVersion\": \"R-HSA-2314686.4\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027627\", \"stIdVersion\": \"R-HSA-9027627.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9027623, \"displayName\": \"Normally, cyclooxygenases (COX) carry out stereospecific oxy...\", \"schemaClass\": \"Summation\", \"text\": \"Normally, cyclooxygenases (COX) carry out stereospecific oxygenation of arachidonic acid to generate prostaglandins. When treated with aspirin (acetylsalicylic acid, ASA), dimeric cyclooxygenase 2 (COX2, PTGS2 dimer) can be acetylated. ASA covalently modifies PTGS2 by acetylating a serine residue at position 530 within the cyclooxygenase active site (Lucido et al. 2016). Acetylated PTGS2 dimer (Ac-PTGS2 dimer) changes the oxygenation stereospecificity towards its substrates, perhaps by steric shielding effects (Tosco 2013), producing a shift in lipid mediator production. Ac-PTGS2 dimer expressed in macrophages can be acetylated by ASA, which enables this form to mediate the biosynthesis of precursors of endogenous anti-inflammatory mediators. Ac-PTGS2 dimer is able to incorporate molecular oxygen into ω-3 fatty acid docosahexaenoic acid (DHA), to form 17-hydroxy-docosahexaenoic acid (17-HDHA) (Serhan et al. 2002, Groeger et al. 2010).\"}]}" ;
