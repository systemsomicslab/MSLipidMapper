: \"Chemical Compound\", \"dbId\": 29768, \"displayName\": \"AA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AA\", \"arachidonate\", \"Arachidonate\", \"arachidonic acid\", \"cis-5,8,11,14-Eicosatetraenoic acid\"], \"producedByEvent\": [5693742], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29768\", \"stIdVersion\": \"R-ALL-29768.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1498751, \"displayName\": \"ETA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ETA\", \"ethanolaminium(1+)\", \"ethanolamine\"], \"producedByEvent\": [5693742], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498751\", \"stIdVersion\": \"R-ALL-1498751.5\"}], \"releaseDate\": \"2015-09-22\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5693742\", \"stIdVersion\": \"R-HSA-5693742.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5693732, \"displayName\": \"Fatty acid amides are a class of lipid transmitters that inc...\", \"schemaClass\": \"Summation\", \"text\": \"Fatty acid amides are a class of lipid transmitters that include the endogenous cannabinoid anandamide (AEA) and the sleep-inducing chemical oleamide. The magnitude and duration of their signalling are controlled by enzymatic hydrolysis mediated by fatty-acid amide hydrolases 1 and 2 (FAAH, H2). Hydrolysis of AEA is described here (Wei et al. 2006). FAAH is localised to the ER membrane whereas FAAH2 is localised to lipid droplets (Kaczocha et al. 2010).\"}]}" ;
