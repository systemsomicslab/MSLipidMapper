    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9841189], \"className\": \"CatalystActivity\", \"dbId\": 1605696, \"displayName\": \"alpha-galactosidase activity of GLA dimer [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 9841189, \"displayName\": \"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\", \"followingEvent\": [9840470], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9841189], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}, {\"className\": \"Complex\", \"consumedByEvent\": [9841189], \"dbId\": 9841186, \"displayName\": \"PSAP(195-273):Gal2Cer:PE [lysosomal lumen]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"PSAP(195-273):Gal2Cer:PE\", \"mobilized Gal2Cer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9841186\", \"stIdVersion\": \"R-HSA-9841186.1\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1605784, \"displayName\": \"Human alpha-galactosidase A: nucleotide sequence of a cDNA clone encoding the mature enzyme\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"4859-63\", \"pubMedIdentifier\": 3014515, \"schemaClass\": \"LiteratureReference\", \"title\": \"Human alpha-galactosidase A: nucleotide sequence of a cDNA clone encoding the mature enzyme\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/3014515\", \"volume\": 83, \"year\": 1986}, {\"className\": \"LiteratureReference\", \"dbId\": 1605751, \"displayName\": \"The molecular defect leading to Fabry disease: structure of human alpha-galactosidase\", \"journal\": \"J Mol Biol\", \"pages\": \"319-35\", \"pubMedIdentifier\": 15003450, \"schemaClass\": \"LiteratureReference\", \"title\": \"The molecular defect leading to Fabry disease: structure of human alpha-galactosidase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15003450\", \"volume\": 337, \"year\": 2004}, {\"className\": \"LiteratureReference\", \"dbId\": 1605633, \"displayName\": \"Nature and frequency of mutations in the alpha-galactosidase A gene that cause Fabry disease\", \"journal\": \"Am J Hum Genet\", \"pages\": \"1186-97\", \"pubMedIdentifier\": 7504405, \"schemaClass\": \"LiteratureReference\", \"title\": \"Nature and frequency of mutations in the alpha-galactosidase A gene that cause Fabry disease\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/7504405\", \"volume\": 53, \"year\": 1993}, {\"className\": \"LiteratureReference\", \"dbId\": 1605665, \"displayName\": \"Fabry disease: identification of 50 novel alpha-galactosidase A mutations causing the classic phenotype and three-dimensional structural analysis of 29 missense mutations\", \"journal\": \"Hum Genomics\", \"pages\": \"297-309\", \"pubMedIdentifier\": 16595074, \"schemaClass\": \"LiteratureReference\", \"title\": \"Fabry disease: identification of 50 novel alpha-galactosidase A mutations causing the classic phenotype and three-dimensional structural analysis of 29 missense mutations\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/16595074\", \"volume\": 2, \"year\": 2006}, {\"className\": \"LiteratureReference\", \"dbId\": 9840817, \"displayName\": \"Prosaposin deficiency: further characterization of the sphingolipid activator protein-deficient sibs. Multiple glycolipid elevations (including lactosylceramidosis), partial enzyme deficiencies and ultrastructure of the skin in this generalized sphingolipid storage disease\", \"journal\": \"Hum Genet\", \"pages\": \"143-52\", \"pubMedIdentifier\": 8370580, \"schemaClass\": \"LiteratureReference\", \"title\": \"Prosaposin deficiency: further characterization of the sphingolipid activator protein-deficient sibs. Multiple glycolipid elevations (including lactosylceramidosis), partial enzyme deficiencies and ultrastructure of the skin in this generalized sphingolipid storage disease\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8370580\", \"volume\": 92, \"year\": 1993}, {\"className\": \"LiteratureReference\", \"dbId\": 9841170, \"displayName\": \"Studies on human liver alpha-galactosidases. I. Purification of alpha-galactosidase A and its enzymatic properties with glycolipid and oligosaccharide substrates\", \"journal\": \"J Biol Chem\", \"pages\": \"9994-10000\", \"pubMedIdentifier\": 39940, \"schemaClass\": \"LiteratureReference\", \"title\": \"Studies on human liver alpha-galactosidases. I. Purification of alpha-galactosidase A and its enzymatic properties with glycolipid and oligosaccharide substrates\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/39940\", \"volume\": 254, \"year\": 1979}, {\"className\": \"LiteratureReference\", \"dbId\": 9841172, \"displayName\": \"Only sphingolipid activator protein B (SAP-B or saposin B) stimulates the degradation of globotriaosylceramide by recombinant human lysosomal alpha-galactosidase in a detergent-free liposomal system\", \"journal\": \"FEBS Lett\", \"pages\": \"74-6\", \"pubMedIdentifier\": 8804427, \"schemaClass\": \"LiteratureReference\", \"title\": \"Only sphingolipid activator protein B (SAP-B or saposin B) stimulates the degradation of globotriaosylceramide by recombinant human lysosomal alpha-galactosidase in a detergent-free liposomal system\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8804427\", \"volume\"