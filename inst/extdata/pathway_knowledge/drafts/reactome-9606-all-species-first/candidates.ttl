    mslm:equation "NDUFAB1 [mitochondrial inner membrane] + Malonyl-CoA [mitochondrial matrix] => Mal-PPANT-S112-NDUFAB1 [mitochondrial inner membrane] + CoA-SH [mitochondrial matrix]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8933547], \"className\": \"CatalystActivity\", \"dbId\": 8933543, \"displayName\": \"[acyl-carrier-protein] S-malonyltransferase activity of MCAT [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}, {\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 8933547, \"displayName\": \"MCAT transfers Mal from Mal-CoA to NDUFAB1\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8933547], \"dbId\": 977314, \"displayName\": \"Malonyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Malonyl-CoA\", \"malonyl-CoA(5-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-977314\", \"stIdVersion\": \"R-ALL-977314.4\"}, {\"className\": \"Protein\", \"consumedByEvent\": [8933547], \"dbId\": 163925, \"displayName\": \"NDUFAB1 [mitochondrial inner membrane]\", \"endCoordinate\": 156, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NDUFAB1\", \"NADH-ubiquinone oxidoreductase 9.6 kDa subunit\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163925\", \"stIdVersion\": \"R-HSA-163925.2\", \"startCoordinate\": 69}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8933546, \"displayName\": \"Cloning, expression, characterization, and interaction of two components of a human mitochondrial fatty acid synthase. Malonyltransferase and acyl carrier protein\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"40067-74\", \"pubMedIdentifier\": 12882974, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cloning, expression, characterization, and interaction of two components of a human mitochondrial fatty acid synthase. Malonyltransferase and acyl carrier protein\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12882974\", \"volume\": 278, \"year\": 2003}], \"maxDepth\": 1, \"name\": [\"MCAT transfers Mal from Mal-CoA to NDUFAB1\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11111091, \"displayName\": \"MCAT transfers Mal from Mal-CoA to NDUFAB1\", \"inferredFrom\": [8933547], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MCAT transfers Mal from Mal-CoA to NDUFAB1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-8933547\", \"stIdVersion\": \"R-SCE-8933547.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11081894, \"displayName\": \"MCAT transfers Mal from Mal-CoA to NDUFAB1\", \"inferredFrom\": [8933547], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MCAT transfers Mal from Mal-CoA to NDUFAB1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"specie