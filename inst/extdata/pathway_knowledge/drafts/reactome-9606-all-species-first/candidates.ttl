owingEvent\": [191366], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Squalene is oxidized to its epoxide\", \"squalene + reduced (NADPH--hemoprotein reductase) + O2 = (S)-2,3-epoxysqualene + oxidized (NADPH--hemoprotein reductase) + H2O + H(+)\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191299\", \"stIdVersion\": \"R-HSA-191299.3\"}], \"releaseDate\": \"2007-02-20\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191366\", \"stIdVersion\": \"R-HSA-191366.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 191288, \"displayName\": \"Lanosterol synthase (LSS) catalyzes the cyclization of squal...\", \"schemaClass\": \"Summation\", \"text\": \"Lanosterol synthase (LSS) catalyzes the cyclization of squalene 2,3-epoxide to lanosterol, a reaction that forms the sterol nucleus (Sung et al. 1995; Van Tamelen et al. 1966). LSS is located on the ER membrane and is active in monomeric form (Ruf et al. 2004).\"}]}" ;
