    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [2161692], \"className\": \"CatalystActivity\", \"dbId\": 2161566, \"displayName\": \"15-oxoprostaglandin 13-reductase [NAD(P)+] activity of PTGR2 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690681, \"displayName\": \"RHEA:11914\", \"identifier\": \"11914\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/11914\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690680, \"displayName\": \"RHEA:50590\", \"identifier\": \"50590\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/50590\"}], \"dbId\": 2161692, \"displayName\": \"15k-PGE2/F2a is reduced to dhk-PGE2/F2a by PTGR1\", \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [2161692], \"dbId\": 2161650, \"displayName\": \"15k-PGE2,15k-PGF2a [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"15k-PGE2,15k-PGF2a\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-2161650\", \"stIdVersion\": \"R-ALL-2161650.2\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161692], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161692], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 2161575, \"displayName\": \"Identification of a novel prostaglandin reductase reveals the involvement of prostaglandin E2 catabolism in regulation of peroxisome proliferator-activated receptor gamma activation\", \"journal\": \"J Biol Chem\", \"pages\": \"18162-72\", \"pubMedIdentifier\": 17449869, \"schemaClass\": \"LiteratureReference\", \"title\": \"Identification of a novel prostaglandin reductase reveals the involvement of prostaglandin E2 catabolism in regulation of peroxisome proliferator-activated receptor gamma activation\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17449869\", \"volume\": 282, \"year\": 2007}, {\"className\": \"LiteratureReference\", \"dbId\": 8940913, \"displayName\": \"Structural basis for catalytic and inhibitory mechanisms of human prostaglandin reductase PTGR2\", \"journal\": \"Structure\", \"pages\": \"1714-23\", \"pubMedIdentifier\": 19000823, \"schemaClass\": \"LiteratureReference\", \"title\": \"Structural basis for catalytic and inhibitory mechanisms of human prostaglandin reductase PTGR2\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/19000823\", \"volume\": 16, \"year\": 2008}], \"maxDepth\": 1, \"name\": [\"15k-PGE2/F2a is reduced to dhk-PGE2/F2a by PTGR1\"], \"output\": [{\"className\": \"Set\", \"dbId\": 2161684, \"displayName\": \"dhk-PGE2,dhk-PGF2a [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"dhk-PGE2,dhk-PGF2a\"], \"producedByEvent\": [2161692], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-2161684\", \"stIdVersion\": \"R-ALL-2161684.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [2161692], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2161662, \"displayName\": \"PGD2/E2/F2a is oxidised to 15k-PGD2/E2/F2a by HPGD\", \"followingEvent\": [2161692], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PGD2/E2/F2a is oxidised to 15k-PGD2/E2/F2a by HPGD\"], \"releaseDate\": \"2012-12-04\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161662\", \"stIdVersion\": \"R-HSA-2161662.3\"}], \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161692\", \"stIdVersion\": \"R-HSA-2161692.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2161637, \"displayName\": \"Prostaglandin reductase 2 (PTGR2) is a 13-prostaglandin redu...\", \"schemaClass\": \"Summation\", \"text\": \"Prostaglandin reductase 2 (PTGR2) is a 13-prostaglandin reductase which metabolises eicosanoids by catalysing NADH/NADPH-dependant double bond reduction in 15-keto-prostaglandin E2 (15k-PGE2) and F2alpha (15k-PGF2a) to produce 13,14-dihydro-15-keto-prostaglandin E2 (dhk-PGE2) and F2alpha (dhk-PGF2a) respectively (Wu et al. 2008).  This has been inferred from the reaction event in mice involving prostaglandin reductase 2 (Ptgr2) (Chou et al. 2007).\"}]}" ;
