\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10149376, \"displayName\": \"HSD17B3,12 hydrogenates 3OOD-CoA to 3HODC-CoA\", \"inferredFrom\": [548818], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B3,12 hydrogenates 3OOD-CoA to 3HODC-CoA\", \"3-oxooctadecanoyl-CoA (3-oxostearoyl-CoA) + NADPH + H+ => 3-hydroxyoctadecanoyl-CoA + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-548818\", \"stIdVersion\": \"R-RNO-548818.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10026069, \"displayName\": \"HSD17B3,12 hydrogenates 3OOD-CoA to 3HODC-CoA\", \"inferredFrom\": [548818], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B3,12 hydrogenates 3OOD-CoA to 3HODC-CoA\", \"3-oxooctadecanoyl-CoA (3-oxostearoyl-CoA) + NADPH + H+ => 3-hydroxyoctadecanoyl-CoA + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-548818\", \"stIdVersion\": \"R-MMU-548818.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 548836, \"displayName\": \"3HODC-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3HODC-CoA\", \"3-hydroxyoctadecanoyl-CoA(4-)\", \"3-hydroxyoctadecanoyl-CoA\"], \"producedByEvent\": [548818], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-548836\", \"stIdVersion\": \"R-ALL-548836.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [548818], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 548814, \"displayName\": \"ELOVL3,6,7 elongate PALM-CoA and Mal-CoA to 3OOD-CoA\", \"followingEvent\": [548818], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ELOVL3,6,7 elongate PALM-CoA and Mal-CoA to 3OOD-CoA\", \"H(+) + hexadecanoyl-CoA + malonyl-CoA => 3-oxooctadecanoyl-CoA + CO2 + CoA\", \"palmitoyl-CoA + malonyl-CoA => 3-oxooctadecanoyl-CoA (3-oxostearoyl-CoA) + CO2 + CoASH\"], \"releaseDate\": \"2010-06-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-548814\", \"stIdVersion\": \"R-HSA-548814.3\"}], \"releaseDate\": \"2010-06-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-548818\", \"stIdVersion\": \"R-HSA-548818.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 548796, \"displayName\": \"Hydroxysteroid (17-beta) dehydrogenase 12 (HSD17B12) catalyz...\", \"schemaClass\": \"Summation\", \"text\": \"Hydroxysteroid (17-beta) dehydrogenase 12 (HSD17B12) catalyzes the reaction of 3-oxooctadecanoyl-CoA (3-oxostearoyl-CoA) and NADPH  + H+ to form 3-hydroxyoctadecanoyl-CoA and NADP+. This activity of HSD17B12 protein and its localization to the endoplasmic reticulum membrane were established in studies of transfected cells expressing the protein (Moon and Horton 2003). Based on the phenotypes of human subjects deficient in the enzyme, HSD17B3 is thought to catalyze the reduction of androstenedione to testosterone (Geissler et al. 1994). A detailed analysis of sequence similarities among the HSD17B protein family reveals close similarity of specificity-determining features of HSD17B12 and HSD12B3, making HSD17B3 a candidate to catalyze 3-OOD-CoA reduction as well (W. Pearson, unpublished, 2012).\"}]}" ;
