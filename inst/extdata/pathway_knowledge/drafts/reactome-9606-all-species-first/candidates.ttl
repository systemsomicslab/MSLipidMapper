\"displayName\": \"BMX phosphorylates RUFY1\", \"inferredFrom\": [8871373], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"BMX phosphorylates RUFY1\", \"L-tyrosyl-(protein) + ATP => O-phospho-L-tyrosyl-(protein) + ADP + H(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8871373\", \"stIdVersion\": \"R-MMU-8871373.1\"}], \"output\": [{\"className\": \"Protein\", \"dbId\": 8871352, \"displayName\": \"p-Y389,400-RUFY1 [cytosol]\", \"endCoordinate\": 708, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"p-Y389,400-RUFY1\", \"RUN and FYVE domain-containing protein 1\", \"RUFY1_HUMAN\"], \"producedByEvent\": [8871373], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8871352\", \"stIdVersion\": \"R-HSA-8871352.2\", \"startCoordinate\": 1}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [8871373, 8871373], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, 29370, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [8871373], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8871373\", \"stIdVersion\": \"R-HSA-8871373.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8871360, \"displayName\": \"RUN and FYVE domain-containing protein 1 (RUFY1, aka RABIP4,...\", \"schemaClass\": \"Summation\", \"text\": \"RUN and FYVE domain-containing protein 1 (RUFY1, aka RABIP4, ZFYVE12) associates with phosphatidylinositol 3-phosphate in membranes of early endosomes and may participate in early endosomal membrane trafficking of the glucose transporter GLUT4. RUFY1 is broadly expressed, with highest levels in lung, testis, kidney and brain. RUFY1 is localised to the cytoplasm and early endosomal membrane, the latter being the predominant localisation after RUFY1 is phosphorylated. Cytoplasmic tyrosine-protein kinase BMX (BMX, aka ETK) is a a downstream tyrosine kinase of PI3-kinase which, through its SH2 and SH3 domains, binds to and phosphorylates RUFY1 at Tyr-389 and Tyr-400. These phosphorylations are essential for endosomal localisation (Yang et al. 2002).\"}]}" ;
