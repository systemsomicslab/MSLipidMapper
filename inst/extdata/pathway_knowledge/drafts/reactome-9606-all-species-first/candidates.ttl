", \"dbId\": 193724, \"displayName\": \"4CHOL7a,24(S)DONE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4CHOL7a,24(S)DONE\", \"(24S)-7alpha,24-dihydroxycholest-4-en-3-one\", \"4-cholesten-7alpha,24(S)-diol-3-one\"], \"producedByEvent\": [193789], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193724\", \"stIdVersion\": \"R-ALL-193724.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 73473, \"displayName\": \"NADH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [193789], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-73473\", \"stIdVersion\": \"R-ALL-73473.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [193789], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 192178, \"displayName\": \"CYP39A1 7-hydroxylates 24OH-CHOL\", \"followingEvent\": [193789], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYP39A1 7-hydroxylates 24OH-CHOL\", \"(24S)-hydroxycholesterol + O2 + reduced (NADPH--hemoprotein reductase) => (24S)-7alpha-dihydroxycholesterol + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\", \"24-hydroxycholesterol is 7alpha-hydroxylated to yield cholest-5-ene-3beta,7alpha,24-triol\", \"24-hydroxycholesterol + NADPH + H+ + O2 => cholest-5-ene-3beta,7alpha,24-triol + NADP+ + H2O\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192178\", \"stIdVersion\": \"R-HSA-192178.4\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193789\", \"stIdVersion\": \"R-HSA-193789.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193744, \"displayName\": \"Cholest-5-ene-3beta,7alpha,24(S)-triol and NAD+ react to for...\", \"schemaClass\": \"Summation\", \"text\": \"Cholest-5-ene-3beta,7alpha,24(S)-triol and NAD+ react to form 4-cholesten-7alpha,24(S)-diol-3-one and NADH + H+, catalyzed by HSD3B7 (3 beta-hydroxysteroid dehydrogenase type 7) in the endoplasmic reticulum membrane. Its function in vivo has been confirmed in studies of patients with defects in bile acid synthesis (Schwarz et al. 2000).\"}]}" ;
