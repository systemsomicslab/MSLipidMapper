transition\", \"className\": \"Reaction\", \"dbId\": 10370124, \"displayName\": \"ACER1 hydrolyzes ceramide (endoplasmic reticulum)\", \"inferredFrom\": [428231], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACER1 hydrolyzes ceramide (endoplasmic reticulum)\", \"ceramide + H2O <=> fatty acid + sphingosine (endoplasmic reticulum)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-428231\", \"stIdVersion\": \"R-BTA-428231.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10144585, \"displayName\": \"ACER1 hydrolyzes ceramide (endoplasmic reticulum)\", \"inferredFrom\": [428231], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACER1 hydrolyzes ceramide (endoplasmic reticulum)\", \"ceramide + H2O <=> fatty acid + sphingosine (endoplasmic reticulum)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-428231\", \"stIdVersion\": \"R-RNO-428231.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10021670, \"displayName\": \"ACER1 hydrolyzes ceramide (endoplasmic reticulum)\", \"inferredFrom\": [428231], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACER1 hydrolyzes ceramide (endoplasmic reticulum)\", \"ceramide + H2O <=> fatty acid + sphingosine (endoplasmic reticulum)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-428231\", \"stIdVersion\": \"R-MMU-428231.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1861754, \"displayName\": \"RCOO- [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"RCOO-\", \"fatty acid anion\", \"carboxylate\", \"carboxylic acid\"], \"producedByEvent\": [428231], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1861754\", \"stIdVersion\": \"R-ALL-1861754.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 428682, \"displayName\": \"SPG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SPG\", \"sphingoid base(1+)\", \"sphingosine\"], \"producedByEvent\": [428231], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428682\", \"stIdVersion\": \"R-ALL-428682.6\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 428259, \"displayName\": \"DEGS1 dehydrogenates dihydroceramide\", \"followingEvent\": [428231], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"DEGS1 dehydrogenates dihydroceramide\", \"dihydroceramide + 2Fe(2+) + 2H+ + O2 => (4E)-ceramide + 2Fe(3+) + 2H2O\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428259\", \"stIdVersion\": \"R-HSA-428259.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1606288, \"displayName\": \"SMPD4 hydrolyzes sphingomyelin (ER membrane)\", \"followingEvent\": [428231], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SMPD4 hydrolyzes sphingomyelin (ER membrane)\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1606288\", \"stIdVersion\": \"R-HSA-1606288.3\"}], \"releaseDate\": \"2009-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428231\", \"stIdVersion\": \"R-HSA-428231.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 428263, \"displayName\": \"ACER1 (alkaline ceramidase 1) catalyzes the reversible hydro...\", \"schemaClass\": \"Summation\", \"text\": \"ACER1 (alkaline ceramidase 1) catalyzes the reversible hydrolysis of ceramide to yield a free fatty acid and sphingosine (Sun et al. 2008). ACER1 hydrolyses C20:0-C24:0 ceramides, localizes to the endoplasmic reticulum membrane, and is mainly expressed in skin tissue (Casasampere et al., 2015). ACER1 is believed to be a key regulator of keratinocyte differentiation and has a fundamental role in skin barrier formation (Liakath-Ali et al., 2016; reviewed by Mao & Obeid, 2008; Parveen et al., 2019; Duarte et al., 2020).\"}]}" ;
