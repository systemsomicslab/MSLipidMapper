    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9026757], \"className\": \"CatalystActivity\", \"dbId\": 9026767, \"displayName\": \"glutathione gamma-glutamate hydrolase activity of GGT [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690748, \"displayName\": \"RHEA:53513\", \"identifier\": \"53513\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/53513\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9916765, \"displayName\": \"RHEA:53513\", \"identifier\": \"53513\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/53513\"}], \"dbId\": 9026757, \"displayName\": \"GGT hydrolyses MCTR1 to MCTR2\", \"followingEvent\": [9026771], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9026757], \"dbId\": 9026761, \"displayName\": \"MCTR1 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MCTR1\", \"(13R)-S-glutathionyl-(14S)-hydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate(2-)\", \"MCTR1(2-)\", \"13(R)-glutathionyl, 14(S)-hydroxy-4Z,7Z,9E,11E,13R,14S,16Z,19Z-docosahexaenoic acid\", \"(13R)-S-glutathionyl-(14S)-hydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9026761\", \"stIdVersion\": \"R-ALL-9026761.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9026757], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9026754, \"displayName\": \"Identification of 14-series sulfido-conjugated mediators that promote resolution of infection and organ protection\", \"journal\": \"Proc. Natl. Acad. Sci. U.S.A.\", \"pages\": \"E4753-61\", \"pubMedIdentifier\": 25324525, \"schemaClass\": \"LiteratureReference\", \"title\": \"Identification of 14-series sulfido-conjugated mediators that promote resolution of infection and organ protection\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25324525\", \"volume\": 111, \"year\": 2014}, {\"className\": \"LiteratureReference\", \"dbId\": 9026774, \"displayName\": \"Maresin conjugates in tissue regeneration biosynthesis enzymes in human macrophages\", \"journal\": \"Proc. Natl. Acad. Sci. U.S.A.\", \"pages\": \"12232-12237\", \"pubMedIdentifier\": 27791009, \"schemaClass\": \"LiteratureReference\", \"title\": \"Maresin conjugates in tissue regeneration biosynthesis enzymes in human macrophages\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/27791009\", \"volume\": 113, \"year\": 2016}, {\"className\": \"LiteratureReference\", \"dbId\": 9026923, \"displayName\": \"Identification and Actions of a Novel Third Maresin Conjugate in Tissue Regeneration: MCTR3\", \"journal\": \"PLoS ONE\", \"pages\": \"e0149319\", \"pubMedIdentifier\": 26881986, \"schemaClass\": \"LiteratureReference\", \"title\": \"Identification and Actions of a Novel Third Maresin Conjugate in Tissue Regeneration: MCTR3\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/26881986\", \"volume\": 11, \"year\": 2016}], \"maxDepth\": 1, \"name\": [\"GGT hydrolyses MCTR1 to MCTR2\", \"(13R)-S-glutathionyl-(14S)-hydroxy-(4Z,7Z,9E,11E16S,17S-epoxy-DHA ,16Z,19Z)-docosahexaenoate + H2O => (13R)-S-cysteinylglycyl-(14S)-hydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate + L-glutamate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9026760, \"displayName\": \"MCTR2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MCTR2\", \"(13R)-glycinylcystein-S-yl-(14S)-hydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate(1-)\", \"MCTR2(1-)\", \"13(R)-cysteinylglycinyl, 14(S)-hydroxy-4Z,7Z,9E,11E,13R,14S,16Z,19Z-docosahexaenoic acid\", \"(13R)-S-cysteinylglycinyl-(14S)-hydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoic acid\"], \"producedByEvent\": [9026757], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9026760\", \"stIdVersion\": \"R-ALL-9026760.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29404, \"displayName\": \"L-Glu [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"L-Glu\", \"L-glutamate(1-)\", \"L-Glutamate\", \"L-glutamic acid\", \"L-Glutaminic acid\"], \"producedByEvent\": [9026757], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29404\", \"stIdVersion\": \"R-ALL-29404.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9026777, \"displayName\": \"GSTM4 dimer transfers GSH to 13(S),14(S)-epoxy-DHA to form MCTR1\", \"followingEvent\": [9026757], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GSTM4 dimer transfers GSH to 13(S),14(S)-epoxy-DHA to form MCTR1\", \"(13S,14S)-epoxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate + glutathione => (13R)-S-glutathionyl-(14S)-hydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026777\", \"stIdVersion\": \"R-HSA-9026777.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9026780, \"displayName\": \"LTC4S trimer transfers GSH to 13(S),14(S)-epoxy-DHA to form MCTR1\", \"followingEvent\": [9026757], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"LTC4S trimer transfers GSH to 13(S),14(S)-epoxy-DHA to form MCTR1\", \"(13S,14S)-epoxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate + glutathione => (13R)-S-glutathionyl-(14S)-hydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026780\", \"stIdVersion\": \"R-HSA-9026780.3\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026757\", \"stIdVersion\": \"R-HSA-9026757.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9026756, \"displayName\": \"In human macrophages, a glutathione hydrolase (GGT) is propo...\", \"schemaClass\": \"Summation\", \"text\": \"In human macrophages, a glutathione hydrolase (GGT) is proposed to cleave the γ-glutamyl moiety of MCTR1 to yield MCTR2, identified as 13(R)-cysteinylglycinyl, 14(S)-hydroxy-docosahexaenoic acid (Dalli et al. 2014, 2016a, 2016b). Incubation of human macrophages with MCTR1 and GGT enzyme inhibitors significantly reduces MCTR2 and MCTR3 production and significantly increases MCTR1 amounts, suggesting a GGT mediates MCTR2 production (Dalli et al. 2016a). In addition, Dalli et al. found the human recombinant GGT used in the experiment has a higher affinity for MCTR1 than leukotriene C4 (Dalli et al. 2016a). MCTR2, given to mice with E. coli peritonitis, showed potent proresolving action in inflammation and infections. With human macrophages, MCTR2 proved to be more potent that MCTR1 in stimulating efferocytosis of apoptotic cells (Dalli et al. 2014).\"}]}" ;
