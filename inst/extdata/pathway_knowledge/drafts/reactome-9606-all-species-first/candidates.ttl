lass\": \"SimpleEntity\", \"stId\": \"R-ALL-193403\", \"stIdVersion\": \"R-ALL-193403.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 192305, \"displayName\": \"NADH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [193508], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192305\", \"stIdVersion\": \"R-ALL-192305.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [193508], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193535, \"displayName\": \"25(S) 3alpha,7alpha-dihydroxy-5beta-cholest-24-enoyl-CoA is hydrated to (24R, 25R) 3alpha,7alpha,24-trihydroxy-5beta-cholestanoyl-CoA\", \"followingEvent\": [193508], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"25(S) 3alpha,7alpha-dihydroxy-5beta-cholest-24-enoyl-CoA is hydrated to (24R, 25R) 3alpha,7alpha,24-trihydroxy-5beta-cholestanoyl-CoA\", \"25(S) 3alpha,7alpha-dihydroxy-5beta-cholest-24-enoyl-CoA + H2O => (24R, 25R) 3alpha,7alpha,24-trihydroxy-5beta-cholestanoyl-CoA\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193535\", \"stIdVersion\": \"R-HSA-193535.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193736, \"displayName\": \"Isomerization of 3,7,24THCA-CoA to (24R, 25R) 3alpha,7alpha,24-trihydroxy-5beta-cholestanoyl-CoA\", \"followingEvent\": [193508], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Isomerization of 3,7,24THCA-CoA to (24R, 25R) 3alpha,7alpha,24-trihydroxy-5beta-cholestanoyl-CoA\", \"3,7,24THCA-CoA => (24R, 25R) 3alpha,7alpha,24-trihydroxy-5beta-cholestanoyl-CoA\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193736\", \"stIdVersion\": \"R-HSA-193736.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193508\", \"stIdVersion\": \"R-HSA-193508.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193411, \"displayName\": \"(24R, 25R) 3alpha,7alpha,24-trihydroxy-5beta-cholestanoyl-Co...\", \"schemaClass\": \"Summation\", \"text\": \"(24R, 25R) 3alpha,7alpha,24-trihydroxy-5beta-cholestanoyl-CoA and NAD+ react to form 3alpha,7alpha-dihydroxy-5beta-cholest-24-one-CoA,  NADH, and H+. This oxidation reaction, catalyzed by the peroxisomal D-bifunctional enzyme (Huyghe et al. 2006), occurs in the peroxisomal matrix.\"}]}" ;
