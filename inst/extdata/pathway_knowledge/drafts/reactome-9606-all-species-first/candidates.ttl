, \"displayName\": \"DECR2 reduces a (2E,4E)-dienoyl-CoA to a 4,5-saturated-(3E)-enoyl-CoA \", \"inferredFrom\": [6786720], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DECR2 reduces a (2E,4E)-dienoyl-CoA to a 4,5-saturated-(3E)-enoyl-CoA \", \"a (2E,4E)-dienoyl-CoA + H(+) + NADPH => a 4,5-saturated-(3E)-enoyl-CoA + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-6786720\", \"stIdVersion\": \"R-RNO-6786720.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10071787, \"displayName\": \"DECR2 reduces a (2E,4E)-dienoyl-CoA to a 4,5-saturated-(3E)-enoyl-CoA \", \"inferredFrom\": [6786720], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DECR2 reduces a (2E,4E)-dienoyl-CoA to a 4,5-saturated-(3E)-enoyl-CoA \", \"a (2E,4E)-dienoyl-CoA + H(+) + NADPH => a 4,5-saturated-(3E)-enoyl-CoA + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6786720\", \"stIdVersion\": \"R-MMU-6786720.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389556, \"displayName\": \"NADP+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [6786720], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389556\", \"stIdVersion\": \"R-ALL-389556.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 9914123, \"displayName\": \"4,5-saturated-(3E)-enoyl-CoA(4-) [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4,5-saturated-(3E)-enoyl-CoA(4-)\", \"4-saturated-trans-3-enoyl-CoA(4-)\"], \"producedByEvent\": [6786720], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9914123\", \"stIdVersion\": \"R-ALL-9914123.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2015-12-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6786720\", \"stIdVersion\": \"R-HSA-6786720.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6786724, \"displayName\": \"Saturated and unsaturated fats can undergo beta-oxidation in...\", \"schemaClass\": \"Summation\", \"text\": \"Saturated and unsaturated fats can undergo beta-oxidation in the mitochondrion and peroxisomes. The only major difference known so far is that peroxisomes can process linear as well as branched unsaturated fatty acid enoyl-CoA esters with much longer chains (>C20) when compared with the mitochondrion. Peroxisomal 2,4-dienoyl-CoA reductase (DECR2) mediates the reduction of long-chain enoyl-CoA esters (2,3-dienoyl-CoA) to form 4,5-saturated-(3E)-enoyl-CoA esters (De Nys et al. 2001, Hua et al. 2012). DECR2 functions as an auxiliary enzyme for fatty acid beta-oxidation where very long-chain and long-chain fatty acids are shortened in peroxisomes and shuttled to the mitochondrion for complete degradation.<br>\"}]}" ;
