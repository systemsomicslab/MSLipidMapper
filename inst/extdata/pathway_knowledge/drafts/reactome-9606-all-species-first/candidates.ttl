seDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9024881\", \"stIdVersion\": \"R-DRE-9024881.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10551173, \"displayName\": \"ALOX15 dehydrogenates 17(S)-Hp-DHA to 16S,17S-epoxy-DHA\", \"inferredFrom\": [9024881], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX15 dehydrogenates 17(S)-Hp-DHA to 16S,17S-epoxy-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9024881\", \"stIdVersion\": \"R-SSC-9024881.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10437764, \"displayName\": \"ALOX15 dehydrogenates 17(S)-Hp-DHA to 16S,17S-epoxy-DHA\", \"inferredFrom\": [9024881], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX15 dehydrogenates 17(S)-Hp-DHA to 16S,17S-epoxy-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9024881\", \"stIdVersion\": \"R-BTA-9024881.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10323884, \"displayName\": \"ALOX15 dehydrogenates 17(S)-Hp-DHA to 16S,17S-epoxy-DHA\", \"inferredFrom\": [9024881], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX15 dehydrogenates 17(S)-Hp-DHA to 16S,17S-epoxy-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9024881\", \"stIdVersion\": \"R-CFA-9024881.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10215993, \"displayName\": \"ALOX15 dehydrogenates 17(S)-Hp-DHA to 16S,17S-epoxy-DHA\", \"inferredFrom\": [9024881], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX15 dehydrogenates 17(S)-Hp-DHA to 16S,17S-epoxy-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9024881\", \"stIdVersion\": \"R-RNO-9024881.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092781, \"displayName\": \"ALOX15 dehydrogenates 17(S)-Hp-DHA to 16S,17S-epoxy-DHA\", \"inferredFrom\": [9024881], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX15 dehydrogenates 17(S)-Hp-DHA to 16S,17S-epoxy-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9024881\", \"stIdVersion\": \"R-MMU-9024881.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9024873, \"displayName\": \"16S,17S-epoxy-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"16S,17S-epoxy-DHA\", \"(16S,17S)-epoxy-(4Z,7Z,10Z,12E,14E,19Z)-docosahexaenoate\", \"(16S,17S)-epoxy-DHA(1-)\", \"(16S,17S)-epoxy-(4Z,7Z,10Z,12E,14E,19Z)-docosahexaenoic acid\", \"16S,17S-epoxy-docosahexaenoic acid\"], \"producedByEvent\": [9024881], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024873\", \"stIdVersion\": \"R-ALL-9024873.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"producedByEvent\": [9024881], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9020275, \"displayName\": \"ALOX15 oxidises DHA to 17(S)-Hp-DHA\", \"followingEvent\": [9024881], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX15 oxidises DHA to 17(S)-Hp-DHA\", \"4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoate + O2 => (17S)-hydroperoxy-(4Z,7Z,10Z,13Z,15E,19Z)-docosahexaenoate\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9020275\", \"stIdVersion\": \"R-HSA-9020275.3\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9024881\", \"stIdVersion\": \"R-HSA-9024881.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9024896, \"displayName\": \"Instead of undergoing a second oxygenation (to form PDX), th...\", \"schemaClass\": \"Summation\", \"text\": \"Instead of undergoing a second oxygenation (to form PDX), the hydroperoxide intermediate 17(S)-Hp-DHA undergoes a  hydrogen abstraction by 15-lipoxygenase (ALOX15) to form an intermediate epoxide, 16S,17S-epoxy-DHA (Hong et al. 2003, Serhan et al. 2006, Hong et al. 2007, Aursnes et al. 2015). This epoxide has now proved to be the precursor for the production of (neuro)protectin D1 ((N)PD1) as well as production of protectin conjugates in tissue regeneration (PCTRs) (Dalli et al. 2015, Ramon et al. 2016, Aursnes et al. 2015).\"}]}" ;
