<https://reactome.org/content/detail/R-HSA-193801> a mslm:LipidReaction ;
    rdfs:label "Influx of 27-hydroxycholesterol" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "27OH-CHOL [extracellular region] => 27HCHOL [endoplasmic reticulum membrane]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 193801, \"displayName\": \"Influx of 27-hydroxycholesterol\", \"goBiologicalProcess\": {\"accession\": \"0035376\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 937728, \"definition\": \"The directed movement of a sterol into a cell or organelle. Sterols are steroids with one or more hydroxyl groups and a hydrocarbon side-chain in the molecule.\", \"displayName\": \"sterol import\", \"name\": \"sterol import\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0035376\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193801], \"dbId\": 193804, \"displayName\": \"27OH-CHOL [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"27OH-CHOL\", \"26-hydroxycholesterol\", \"27-hydroxycholesterol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193804\", \"stIdVersion\": \"R-ALL-193804.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 193748, \"displayName\": \"Cholesterol homeostasis in human brain: evidence for an age-dependent flux of 24S-hydroxycholesterol from the brain into the circulation\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"9799-804\", \"pubMedIdentifier\": 8790411, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cholesterol homeostasis in human brain: evidence for an age-dependent flux of 24S-hydroxycholesterol from the brain into the circulation\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8790411\", \"volume\": 93, \"year\": 1996}, {\"className\": \"LiteratureReference\", \"dbId\": 193791, \"displayName\": \"Cholesterol homeostasis in human brain: turnover of 24S-hydroxycholesterol and evidence for a cerebral origin of most of this oxysterol in the circulation\", \"journal\": \"J Lipid Res\", \"pages\": \"1594-600\", \"pubMedIdentifier\": 9717719, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cholesterol homeostasis in human brain: turnover of 24S-hydroxycholesterol and evidence for a cerebral origin of most of this oxysterol in the circulation\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9717719\", \"volume\": 39, \"year\": 1998}], \"maxDepth\": 1, \"name\": [\"Influx of 27-hydroxycholesterol\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 176617, \"displayName\": \"27HCHOL [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"27HCHOL\", \"26-hydroxycholesterol\", \"27-hydroxycholesterol\"], \"producedByEvent\": [193801], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-176617\", \"stIdVersion\": \"R-ALL-176617.4\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 193812, \"displayName\": \"Efflux of 27-hydroxycholesterol\", \"followingEvent\": [193801], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Efflux of 27-hydroxycholesterol\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193812\", \"stIdVersion\": \"R-HSA-193812.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193801\", \"stIdVersion\": \"R-HSA-193801.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193831, \"displayName\": \"27-hydroxycholesterol is transported from the extracellular ...\", \"schemaClass\": \"Summation\", \"text\": \"27-hydroxycholesterol is transported from the extracellular space to the endoplasmic reticulum. In humans, this event is the means by which the molecule, generated from cholesterol in the brain, is taken up by liver cells for conversion to bile acids and bile salts (Babiker et al. 1999; Bjorkhem et al. 1994). While transport proteins are likely to play a role in this process, these proteins have not been identified.\"}]}" ;
