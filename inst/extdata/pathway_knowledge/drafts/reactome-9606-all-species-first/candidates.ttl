<https://reactome.org/content/detail/R-HSA-5655955> a mslm:LipidReaction ;
    rdfs:label "OLAH hydrolyzes decanoyl-FASN dimer to DECA and FASN dimer" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "H2O [cytosol] + decanoyl-FASN dimer [cytosol] => DECA [cytosol] + H+ [cytosol] + FASN dimer [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [5655955], \"className\": \"CatalystActivity\", \"dbId\": 5655933, \"displayName\": \"fatty acyl-[ACP] hydrolase activity of OLAH [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9865946, \"displayName\": \"RHEA:30116\", \"identifier\": \"30116\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/30116\"}], \"dbId\": 5655955, \"displayName\": \"OLAH hydrolyzes decanoyl-FASN dimer to DECA and FASN dimer\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [5655955, 5655955], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356, {\"className\": \"Complex\", \"consumedByEvent\": [5655955], \"dbId\": 5655943, \"displayName\": \"decanoyl-FASN dimer [cytosol]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"decanoyl-FASN dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5655943\", \"stIdVersion\": \"R-HSA-5655943.1\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 5655942, \"displayName\": \"Purification and properties of a thioesterase from lactating rat mammary gland which modifies the product specificity of fatty acid synthetase\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"1393-401\", \"pubMedIdentifier\": 627544, \"schemaClass\": \"LiteratureReference\", \"title\": \"Purification and properties of a thioesterase from lactating rat mammary gland which modifies the product specificity of fatty acid synthetase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/627544\", \"volume\": 253, \"year\": 1978}, {\"className\": \"LiteratureReference\", \"dbId\": 5655922, \"displayName\": \"Interaction of rat mammary gland thioesterase II with fatty acid synthetase is dependent on the presence of acyl chains on the synthetase\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"1570-4\", \"pubMedIdentifier\": 3805044, \"schemaClass\": \"LiteratureReference\", \"title\": \"Interaction of rat mammary gland thioesterase II with fatty acid synthetase is dependent on the presence of acyl chains on the synthetase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/3805044\", \"volume\": 262, \"year\": 1987}, {\"className\": \"LiteratureReference\", \"dbId\": 5656424, \"displayName\": \"The fatty acids of human milk from mothers on diets taken ad libitum\", \"journal\": \"Biochem. J.\", \"pages\": \"27-33\", \"pubMedIdentifier\": 13651131, \"schemaClass\": \"LiteratureReference\", \"title\": \"The fatty acids of human milk from mothers on diets taken ad libitum\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/13651131\", \"volume\": 72, \"year\": 1959}, {\"className\": \"LiteratureReference\", \"dbId\": 5656418, \"displayName\": \"Triglyceride structure of human milk fat\", \"journal\": \"Can. J. Biochem.\", \"pages\": \"761-9\", \"pubMedIdentifier\": 5810867, \"schemaClass\": \"LiteratureReference\", \"title\": \"Triglyceride structure of human milk fat\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/5810867\", \"volume\": 47, \"year\": 1969}], \"maxDepth\": 1, \"name\": [\"OLAH hydrolyzes decanoyl-FASN dimer to DECA and FASN dimer\", \"decanoyl-(ACP) + H2O => decanoate + H(+) + holo-(ACP)\", \"decanoyl-FASN dimer + 2 H2O => 2 decanoate + FASN dimer\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 879620, \"displayName\": \"DECA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DECA\", \"decanoate\", \"capric acid\", \"decanoic acid\"], \"producedByEvent\": [5655955, 5655955], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-879620\", \"stIdVersion\": \"R-ALL-879620.5\"}, 879620, {\"className\": \"Complex\", \"dbId\": 77380, \"displayName\": \"FASN dimer [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"FASN dimer\", \"FAS dimer\"], \"producedByEvent\": [5655955], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-77380\", \"stIdVersion\": \"R-HSA-77380.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [5655955, 5655955], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, 70106], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2014-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5655955\", \"stIdVersion\": \"R-HSA-5655955.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5655952, \"displayName\": \"OLAH, a monomeric cytosolic thiolase, catalyzes the hydrolys...\", \"schemaClass\": \"Summation\", \"text\": \"OLAH, a monomeric cytosolic thiolase, catalyzes the hydrolysis of FASN (fatty acid synthase) charged with decanoyl fatty acyl moieties to yield FASN and decanoate (DECA). OLAH expression is confined to the lactating mammary gland, and its catalytic activity enables the early termination of a portion of fatty acid biosynthesis to produce the medium chain-length fatty acids (annotated here as DECA) found in milk (Insull & Ahrens 1959; Breckenridge et al. 1969). OLAH is known only as an open reading frame identified in the human genome and as an mRNA observed in gene expression screening studies. Its biological properties are inferred from those of its well-studied rat ortholog (Libertini & Smith 1978; Mikkelsen et al. 1987).\"}]}" ;
