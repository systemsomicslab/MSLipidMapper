e\"], \"producedByEvent\": [193737], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113563\", \"stIdVersion\": \"R-ALL-113563.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [193737], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193719, \"displayName\": \"5beta-cholestan-3alpha,7alpha,24(S),27-tetrol is oxidized to 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al\", \"followingEvent\": [193737], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha,7alpha,24(S),27-tetrol is oxidized to 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al\", \"5beta-cholestan-3alpha,7alpha,24(S),27-tetrol + NADPH + H+ + O2 => 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al + NADP+ + H2O\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193719\", \"stIdVersion\": \"R-HSA-193719.2\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193737\", \"stIdVersion\": \"R-HSA-193737.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193725, \"displayName\": \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al, NADPH ...\", \"schemaClass\": \"Summation\", \"text\": \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al, NADPH + H+, and O2 react to form 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate (3,7,24THCA), NADP+, and H2O. This oxidation reaction occurs in the mitochondrial matrix, catalyzed by CYP27A1.\"}]}" ;
