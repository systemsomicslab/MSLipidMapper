se, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GM1 localizes to ILV membrane\"], \"releaseDate\": \"2023-09-13\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840579\", \"stIdVersion\": \"R-HSA-9840579.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1606807, \"displayName\": \"ARSA removes sulfate from PSAP(195-273):Sulfatide\", \"followingEvent\": [9840470], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ARSA removes sulfate from PSAP(195-273):Sulfatide\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1606807\", \"stIdVersion\": \"R-HSA-1606807.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9841189, \"displayName\": \"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\", \"followingEvent\": [9840470], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\"], \"releaseDate\": \"2023-09-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9841189\", \"stIdVersion\": \"R-HSA-9841189.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2023-09-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840470\", \"stIdVersion\": \"R-HSA-9840470.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9840455, \"displayName\": \"By encapsulating phosphatidylethanolamines (PE) of different...\", \"schemaClass\": \"Summation\", \"text\": \"By encapsulating phosphatidylethanolamines (PE) of different sizes from the membrane of intralysosomal luminal vesicles (ILV), the Saposin B (PSAP(195-273) dimer can solubilize relatively large lipid ligands from these membranes. Ligands carried by Saposin B include GM1, GM3, Gb3, SM4s, Ga2Cer, and LacCer (Vogel et al., 1991; Wilkening et al., 2000; Ahn et al., 2003; reviewed by Sandhoff & Sandhoff, 2018).\"}]}" ;
