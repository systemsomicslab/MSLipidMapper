Class\": \"LiteratureReference\", \"title\": \"Differential stimulation of cholesterol and unsaturated fatty acid biosynthesis in cells expressing individual nuclear sterol regulatory element-binding proteins\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9748295\", \"volume\": 273, \"year\": 1998}, {\"className\": \"LiteratureReference\", \"dbId\": 1655608, \"displayName\": \"Genistein downregulates SREBP-1 regulated gene expression by inhibiting site-1 protease expression in HepG2 cells\", \"journal\": \"J Nutr\", \"pages\": \"1127-31\", \"pubMedIdentifier\": 17449569, \"schemaClass\": \"LiteratureReference\", \"title\": \"Genistein downregulates SREBP-1 regulated gene expression by inhibiting site-1 protease expression in HepG2 cells\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17449569\", \"volume\": 137, \"year\": 2007}], \"maxDepth\": 1, \"name\": [\"SREBP1A,1C binds the FASN promoter\", \"SREBF1A,1C binds the FASN promoter\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 1655738, \"displayName\": \"SREBP1A,1C:NF-Y:SP1:FASN gene [nucleoplasm]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 4, \"name\": [\"SREBP1A,1C:NF-Y:SP1:FASN gene\", \"SREBF1A,1C:NF-Y:SP1:FASN gene\"], \"producedByEvent\": [2426148], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1655738\", \"stIdVersion\": \"R-HSA-1655738.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2065539, \"displayName\": \"SREBP1A,1C,2:Importin beta-1 dissociates\", \"followingEvent\": [2426148], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SREBP1A,1C,2:Importin beta-1 dissociates\", \"SREBF1A,1C,2:Importin beta-1 dissociates\"], \"releaseDate\": \"2012-09-18\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2065539\", \"stIdVersion\": \"R-HSA-2065539.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2012-09-18\", \"releaseStatus\": \"UPDATED\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2426148\", \"stIdVersion\": \"R-HSA-2426148.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2426218, \"displayName\": \"SREBP1A (SREBF1A) or SREBP1C, together with NF-Y and SP1, bi...\", \"schemaClass\": \"Summation\", \"text\": \"SREBP1A (SREBF1A) or SREBP1C, together with NF-Y and SP1, bind and transactivate the promoter of the FASN gene (Bennett et al. 1995, Pai et al. 1998, Xiong et al. 2000, Amemiya-Kudo et al. 2002, Shin et al. 2007, Choi et al. 2008, Rome et al. 2008). NF-Y is required for response to cholesterol (Xiong et al. 2000). SREBP1A activates FASN more strongly than does SREBP1C or SREBP2 (Pai et al. 1998, Amemiya-Kudo et al. 2002).\"}]}" ;
