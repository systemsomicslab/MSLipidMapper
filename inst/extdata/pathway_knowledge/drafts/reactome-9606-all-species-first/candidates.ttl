e\": \"2007-05-15\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193767\", \"stIdVersion\": \"R-HSA-193767.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192178\", \"stIdVersion\": \"R-HSA-192178.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 192109, \"displayName\": \"24-hydroxycholesterol 7-alpha-hydroxylase (CYP39A1), located...\", \"schemaClass\": \"Summation\", \"text\": \"24-hydroxycholesterol 7-alpha-hydroxylase (CYP39A1), located on the ER membrane, 7-alpha-hydroxylates 24-hydroxycholesterol (24OH-CHOL) to cholest-5-ene-3beta,7alpha,24-triol (CHOL7a,24(S)DIOL). In the body, expression of CYP39A1 is restricted to the liver and is involved in bile acid metabolism (Li-Hawkins et al. 2000).\"}]}" ;
