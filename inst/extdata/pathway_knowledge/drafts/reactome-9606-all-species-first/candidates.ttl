<https://reactome.org/content/detail/R-HSA-443894> a mslm:LipidReaction ;
    rdfs:label "TXA2 is hydrolysed to TXB2" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "H2O [endoplasmic reticulum lumen] + TXA2 [endoplasmic reticulum lumen] => TXB2 [endoplasmic reticulum lumen]" ;
    mslm:evidenceJson "{\"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}], \"dbId\": 443894, \"displayName\": \"TXA2 is hydrolysed to TXB2\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [443894], \"dbId\": 32879, \"displayName\": \"TXA2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TXA2\", \"thromboxane A2(1-)\", \"(5Z,13E)-(15S)-9alpha,11alpha-Epoxy-15-hydroxythromboxa-5,13-dienoate\", \"thromboxane A2\", \"(5Z,9alpha,11alpha,13E,15S)-9,11-Epoxy-15-hydroxythromboxa-5,13-dien-1-oic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-32879\", \"stIdVersion\": \"R-ALL-32879.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [443894], \"dbId\": 113519, \"displayName\": \"H2O [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113519\", \"stIdVersion\": \"R-ALL-113519.3\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 443891, \"displayName\": \"Thromboxanes: a new group of biologically active compounds derived from prostaglandin endoperoxides\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"2994-8\", \"pubMedIdentifier\": 1059088, \"schemaClass\": \"LiteratureReference\", \"title\": \"Thromboxanes: a new group of biologically active compounds derived from prostaglandin endoperoxides\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/1059088\", \"volume\": 72, \"year\": 1975}, {\"className\": \"LiteratureReference\", \"dbId\": 2161070, \"displayName\": \"Substrate binding is the rate-limiting step in thromboxane synthase catalysis\", \"journal\": \"J Biol Chem\", \"pages\": \"14737-43\", \"pubMedIdentifier\": 11297515, \"schemaClass\": \"LiteratureReference\", \"title\": \"Substrate binding is the rate-limiting step in thromboxane synthase catalysis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11297515\", \"volume\": 276, \"year\": 2001}], \"maxDepth\": 1, \"name\": [\"TXA2 is hydrolysed to TXB2\", \"Thromboxane A2 degenerates to thromboxane B2\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 443890, \"displayName\": \"TXB2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TXB2\", \"thromboxane B2(1-)\", \"thromboxane B2\"], \"producedByEvent\": [443894], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-443890\", \"stIdVersion\": \"R-ALL-443890.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 76500, \"displayName\": \"TBXAS1 isomerises PGH2 to TXA2\", \"followingEvent\": [443894], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"TBXAS1 isomerises PGH2 to TXA2\", \"rostaglandin H2 => thromboxane A2\", \"Thromboxane synthase (CYP5A1) mediates the isomerization of prostaglandin H2 to thromboxane A2\"], \"releaseDate\": \"2008-06-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-76500\", \"stIdVersion\": \"R-HSA-76500.3\"}], \"releaseDate\": \"2009-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-443894\", \"stIdVersion\": \"R-HSA-443894.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 443893, \"displayName\": \"Thromboxane A2 (TXA2) contains an unstable ether linkage tha...\", \"schemaClass\": \"Summation\", \"text\": \"Thromboxane A2 (TXA2) contains an unstable ether linkage that is rapidly hydrolysed under aqueous conditions to form the biologically inert thromboxane B2 (TXB2) (Wang et al. 2001, Hamberg et al. 1975), which is excreted.\"}]}" ;
