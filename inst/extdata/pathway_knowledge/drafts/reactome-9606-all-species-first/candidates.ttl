iesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-193385\", \"stIdVersion\": \"R-RNO-193385.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007407, \"displayName\": \"Hydrolysis of choloyl-CoA to cholate and CoASH\", \"inferredFrom\": [193385], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Hydrolysis of choloyl-CoA to cholate and CoASH\", \"choloyl-CoA + H2O => cholate + CoA + H(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193385\", \"stIdVersion\": \"R-MMU-193385.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193451, \"displayName\": \"CCA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CCA\", \"cholate\", \"cholic acid\"], \"producedByEvent\": [193385], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193451\", \"stIdVersion\": \"R-ALL-193451.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [193385], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [193385], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 192341, \"displayName\": \"Thiolysis of 3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA yields choloyl-CoA (3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA) and propionyl CoA\", \"followingEvent\": [193385], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Thiolysis of 3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA yields choloyl-CoA (3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-one-CoA) and propionyl CoA\", \"3alpha,7alpha,12alpha-trihydroxy-24-oxo-5beta-cholestan-26-oyl-CoA + CoA => choloyl-CoA + propanoyl-CoA\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192341\", \"stIdVersion\": \"R-HSA-192341.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193385\", \"stIdVersion\": \"R-HSA-193385.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193515, \"displayName\": \"The peroxisomal matrix enzyme acyl-coenzyme A thioesterase 8...\", \"schemaClass\": \"Summation\", \"text\": \"The peroxisomal matrix enzyme acyl-coenzyme A thioesterase 8 (ACOT8) mediates the hydrolysis of choloyl-CoA to form cholate and CoASH (Jones et al. 1999, Hunt et al. 2002). While bile salts are the major product of the de novo biosynthetic pathway in the normal human liver, bile acids are major feedback regulators of this pathway and this hydrolysis reaction is thought to play a role in generating them (Russell 2003).\"}]}" ;
