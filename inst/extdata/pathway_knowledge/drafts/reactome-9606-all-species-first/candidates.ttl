sName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483219\", \"stIdVersion\": \"R-HSA-1483219.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482961, \"displayName\": \"CDP-Cho and DAG are converted to PC by CEPT1 at the ER membrane\", \"followingEvent\": [1482827], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CDP-Cho and DAG are converted to PC by CEPT1 at the ER membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482961\", \"stIdVersion\": \"R-HSA-1482961.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482547, \"displayName\": \"1-acyl LPC is acylated to PC by LPCAT\", \"followingEvent\": [1482827], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPC is acylated to PC by LPCAT\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482547\", \"stIdVersion\": \"R-HSA-1482547.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482533, \"displayName\": \"2-acyl LPC is acylated to PC by LPCAT\", \"followingEvent\": [1482827], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"2-acyl LPC is acylated to PC by LPCAT\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482533\", \"stIdVersion\": \"R-HSA-1482533.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482827\", \"stIdVersion\": \"R-HSA-1482827.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482891, \"displayName\": \"At the endoplasmic reticulum (ER) membrane, phosphatidylchol...\", \"schemaClass\": \"Summation\", \"text\": \"At the endoplasmic reticulum (ER) membrane, phosphatidylcholine (PC) is hydrolyzed, and has one of its acyl chains cleaved off, by membrane-associated phospholipase A2 gamma 4C, PLA2G4C (Yamashita et al. 2005, Ghomashchi et al. 2010, Yamashita et al. 2009), to form 2-acyl lysophosphatidylcholine (LPC).  Cytosolic phospholipase A2 enzymes show not only PLA2 hydrolysing activity to form the 1-acyl lysophospholipid but also have a degree of PLA1 activity, producing a 2-acyl lysophospholipid.\"}]}" ;
