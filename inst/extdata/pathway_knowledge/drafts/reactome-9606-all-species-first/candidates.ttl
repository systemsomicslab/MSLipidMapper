    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 1989764, \"displayName\": \"Expression of CYP1A1\", \"goBiologicalProcess\": {\"accession\": \"0045944\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 17788, \"definition\": \"Any process that activates or increases the frequency, rate or extent of transcription from an RNA polymerase II promoter.\", \"displayName\": \"positive regulation of transcription by RNA polymerase II\", \"name\": \"positive regulation of transcription by RNA polymerase II\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0045944\"}, \"input\": [{\"className\": \"DNA Sequence\", \"consumedByEvent\": [1989764], \"dbId\": 5649956, \"displayName\": \"CYP1A1 gene [nucleoplasm]\", \"endCoordinate\": -1, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CYP1A1 gene\"], \"referenceType\": \"ReferenceDNASequence\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5649956\", \"stIdVersion\": \"R-HSA-5649956.1\", \"startCoordinate\": 1}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 561142, \"displayName\": \"Profiling of promoter occupancy by PPAR{alpha} in human hepatoma cells via ChIP-chip analysis\", \"journal\": \"Nucleic Acids Res\", \"pubMedIdentifier\": 20110263, \"schemaClass\": \"LiteratureReference\", \"title\": \"Profiling of promoter occupancy by PPAR{alpha} in human hepatoma cells via ChIP-chip analysis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/20110263\", \"year\": 2010}, {\"className\": \"LiteratureReference\", \"dbId\": 561153, \"displayName\": \"Comparative analysis of gene regulation by the transcription factor PPARalpha between mouse and human\", \"journal\": \"PLoS One\", \"pages\": \"e6796\", \"pubMedIdentifier\": 19710929, \"schemaClass\": \"LiteratureReference\", \"title\": \"Comparative analysis of gene regulation by the transcription factor PPARalpha between mouse and human\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/19710929\", \"volume\": 4, \"year\": 2009}, {\"className\": \"LiteratureReference\", \"dbId\": 8937160, \"displayName\": \"Regulation of constitutive and inducible AHR signaling: complex interactions involving the AHR repressor\", \"journal\": \"Biochem. Pharmacol.\", \"pages\": \"485-97\", \"pubMedIdentifier\": 18848529, \"schemaClass\": \"LiteratureReference\", \"title\": \"Regulation of constitutive and inducible AHR signaling: complex interactions involving the AHR repressor\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18848529\", \"volume\": 77, \"year\": 2009}, {\"className\": \"LiteratureReference\", \"dbId\": 8937206, \"displayName\": \"The aryl hydrocarbon receptor complex and the control of gene expression\", \"journal\": \"Crit. Rev. Eukaryot. Gene Expr.\", \"pages\": \"207-50\", \"pubMedIdentifier\": 18540824, \"schemaClass\": \"LiteratureReference\", \"title\": \"The aryl hydrocarbon receptor complex and the control of gene expression\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18540824\", \"volume\": 18, \"year\": 2008}, {\"className\": \"LiteratureReference\", \"dbId\": 8937186, \"displayName\": \"The arylhydrocarbon receptor repressor (AhRR): structure, expression, and function\", \"journal\": \"Biol. Chem.\", \"pages\": \"1195-9\", \"pubMedIdentifier\": 16972786, \"schemaClass\": \"LiteratureReference\", \"title\": \"The arylhydrocarbon receptor repressor (AhRR): structure, expression, and function\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/16972786\", \"volume\": 387, \"year\": 2006}], \"maxDepth\": 1, \"name\": [\"Expression of CYP1A1\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 52623, \"displayName\": \"CYP1A1 [endoplasmic reticulum membrane]\", \"endCoordinate\": 512, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CYP1A1\", \"CYPIA1\", \"Cytochrome P450 1A1 \", \"P450-P1\", \"P450 form 6\", \"P450-C\"], \"producedByEvent\": [1989764], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-52623\", \"stIdVersion\": \"R-HSA-52623.1\", \"startCoordinate\": 1}], \"precedingEvent\": [{\"category\": \"uncertain\", \"className\": \"Reaction\", \"dbId\": 400143, \"displayName\": \"Fatty acid ligands activate PPARA\", \"followingEvent\": [1989764], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Fatty acid ligands activate PPARA\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-400143\", \"stIdVersion\": \"R-HSA-400143.4\"}], \"regulatedBy\": [{\"className\": \"PositiveGeneExpressionRegulation\", \"dbId\": 1989817, \"displayName\": \"Positive gene expression regulation by 'PPARA:RXRA Coactivator complex [nucleoplasm]'\", \"regulatedEntity\": [1989764], \"schemaClass\": \"PositiveGeneExpressionRegulation\", \"stId\": \"R-HSA-1989817\", \"stIdVersion\": \"R-HSA-1989817.1\"}, {\"className\": \"NegativeGeneExpressionRegulation\", \"dbId\": 8937237, \"displayName\": \"Negative gene expression regulation by 'AHRR:ARNT [nucleoplasm]'\", \"regulatedEntity\": [1989764], \"schemaClass\": \"NegativeGeneExpressionRegulation\", \"stId\": \"R-HSA-8937237\", \"stIdVersion\": \"R-HSA-8937237.1\"}, {\"className\": \"PositiveGeneExpressionRegulation\", \"dbId\": 8937241, \"displayName\": \"Positive gene expression regulation by 'AHR:TCDD:ARNT [nucleoplasm]'\", \"regulatedEntity\": [1989764], \"schemaClass\": \"PositiveGeneExpressionRegulation\", \"stId\": \"R-HSA-8937241\", \"stIdVersion\": \"R-HSA-8937241.1\"}], \"regulationReference\": [{\"className\": \"RegulationReference\", \"dbId\": 9642535, \"displayName\": \"Positive gene expression regulation by 'PPARA:RXRA Coactivator complex [nucleoplasm]' Profiling of promoter occupancy by PPAR{alpha} in human hepatoma cells via ChIP-chip analysis\", \"schemaClass\": \"RegulationReference\"}], \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1989764\", \"stIdVersion\": \"R-HSA-1989764.7\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1989636, \"displayName\": \"The CYP1A1 gene is transcribed to yield mRNA and the mRNA is...\", \"schemaClass\": \"Summation\", \"text\": \"The CYP1A1 gene is transcribed to yield mRNA and the mRNA is translated to yield protein (van der Meer et al. 2010, Rakhshandehroo et al. 2009). The aryl hydrocarbon receptor (AHR) is a ligand-activated transcription factor that controls the expression of a diverse set of genes. AHR acts as a sensor of polyaromatic chemicals, which upon activation, translocates to the nucleus and binds with the aryl hydrocarbon receptor nuclear translocator (ARNT) to transactivate target genes via binding to xenobiotic response elements (XREs) in their promoter regions. AHR targets genes of Phase I and Phase II metabolism, such as cytochrome P450 1A1 (CYP1A1) (Beischlag et al. 2008). AHR is regulated by the aryl hydrocarbon receptor repressor (AHRR, aka BHLHE77, KIAA1234) that inhibits both xenobiotic-induced and constitutively active AHR transcriptional activity in many species (Hahn et al. 2009, Haarmann-Stemmann & Abel 2006).<br>\"}]}" ;
