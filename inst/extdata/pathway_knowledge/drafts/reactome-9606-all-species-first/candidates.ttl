    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 390302, \"displayName\": \"Beta-oxidation of tetradecenoyl-CoA to octanoyl-CoA\", \"followingEvent\": [390304], \"goBiologicalProcess\": {\"accession\": \"0006635\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 20426, \"definition\": \"A fatty acid oxidation process that results in the complete oxidation of a long-chain fatty acid. Fatty acid beta-oxidation begins with the addition of coenzyme A to a fatty acid, and occurs by successive cycles of reactions during each of which the fatty acid is shortened by a two-carbon fragment removed as acetyl coenzyme A; the cycle continues until only two or three carbons remain (as acetyl-CoA or propionyl-CoA respectively).\", \"displayName\": \"fatty acid beta-oxidation\", \"name\": \"fatty acid beta-oxidation\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006635\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [390302, 390302, 390302, 390302, 390302, 390302, 390302, 390302], \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}, 193514, 193514, 193514, 193514, 193514, 193514, 193514, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [390302, 390302, 390302, 390302, 390302, 390302, 390302, 390302], \"dbId\": 141343, \"displayName\": \"H2O [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-141343\", \"stIdVersion\": \"R-ALL-141343.3\"}, 141343, 141343, 141343, 141343, 141343, 141343, 141343, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [390302, 390302, 390302, 390302, 390302, 390302, 390302, 390302], \"dbId\": 192307, \"displayName\": \"NAD+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192307\", \"stIdVersion\": \"R-ALL-192307.5\"}, 192307, 192307, 192307, 192307, 192307, 192307, 192307, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [390302, 390302, 390302, 390302, 390302, 390302, 390302, 390302], \"dbId\": 113535, \"displayName\": \"O2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113535\", \"stIdVersion\": \"R-ALL-113535.4\"}, 113535, 113535, 113535, 113535, 113535, 113535, 113535, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [390302], \"dbId\": 390246, \"displayName\": \"tetracosanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"tetracosanoyl-CoA\", \"tetracosanoyl-CoA(4-)\", \"lignoceryl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390246\", \"stIdVersion\": \"R-ALL-390246.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 389650, \"displayName\": \"Biochemistry of mammalian peroxisomes revisited\", \"journal\": \"Annu Rev Biochem\", \"pages\": \"295-332\", \"pubMedIdentifier\": 16756494, \"schemaClass\": \"LiteratureReference\", \"title\": \"Biochemistry of mammalian peroxisomes revisited\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/16756494\", \"volume\": 75, \"year\": 2006}], \"maxDepth\": 1, \"name\": [\"Beta-oxidation of tetradecenoyl-CoA to octanoyl-CoA\", \"tetracosenoyl-CoA + 8 O2 + 8 H2O + 8 NAD+ + 8 CoASH => octanoyl-CoA + 8 H2O2 + 8 NADH + 8 H+ + 8 acetyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 353123, \"displayName\": \"Ac-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ac-CoA\", \"acetyl-CoA(4-)\", \"Acetyl coenzyme A\", \"acetyl-CoA\"], \"producedByEvent\": [390302, 390302, 390302, 390302, 390302, 390302, 390302, 390302], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-353123\", \"stIdVersion\": \"R-ALL-353123.5\"}, 353123, 353123, 353123, 353123, 353123, 353123, 353123, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [390302, 390302, 390302, 390302, 390302, 390302, 390302, 390302], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}, 193465, 193465, 193465, 193465, 193465, 193465, 193465, {\"className\": \"Chemical Compound\", \"dbId\": 113575, \"displayName\": \"H2O2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O2\", \"hydrogen peroxide\"], \"producedByEvent\": [390302, 390302, 390302, 390302, 390302, 390302, 390302, 390302], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113575\", \"stIdVersion\": \"R-ALL-113575.3\"}, 113575, 113575, 113575, 113575, 113575, 113575, 113575, {\"className\": \"Chemical Compound\", \"dbId\": 192305, \"displayName\": \"NADH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [390302, 390302, 390302, 390302, 390302, 390302, 390302, 390302], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192305\", \"stIdVersion\": \"R-ALL-192305.4\"}, 192305, 192305, 192305, 192305, 192305, 192305, 192305, {\"className\": \"Chemical Compound\", \"dbId\": 390303, \"displayName\": \"Octanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Octanoyl-CoA\", \"octanoyl-CoA(4-)\"], \"producedByEvent\": [390302], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390303\", \"stIdVersion\": \"R-ALL-390303.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 390250, \"displayName\": \"3-ketohexacosanoyl-CoA + CoASH => tetracosanoyl-CoA + acetyl-CoA\", \"followingEvent\": [390302], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"3-ketohexacosanoyl-CoA + CoASH => tetracosanoyl-CoA + acetyl-CoA\", \"3-oxohexacosanoyl-CoA + CoA => acetyl-CoA + tetracosanoyl-CoA\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390250\", \"stIdVersion\": \"R-HSA-390250.4\"}], \"releaseDate\": \"2009-04-01\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390302\", \"stIdVersion\": \"R-HSA-390302.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 390300, \"displayName\": \"In eight cycles of beta-oxidation mediated by the same enzym...\", \"schemaClass\": \"Summation\", \"text\": \"In eight cycles of beta-oxidation mediated by the same enzyme activities responsible for the conversion of hexacosanoyl-CoA to tetracosenoyl-CoA, the latter molecule is converted to octanoyl-CoA. Eight molecules each of O2, H2O, NAD+, and CoASH are consumed in the process and  eight molecules of H2O2 and NADH + H+ are generated, together with eight molecules of acetyl-CoA (Wanders and Waterham 2006).\"}]}" ;
