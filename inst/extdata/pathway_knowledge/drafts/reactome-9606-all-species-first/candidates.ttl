    mslm:equation "LTC4 [cytosol] + H2O [cytosol] + ATP [cytosol] => Pi [cytosol] + H+ [cytosol] + LTC4 [extracellular region] + ADP [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [266070], \"className\": \"CatalystActivity\", \"dbId\": 266058, \"displayName\": \"ABC-type transporter activity of ABCC1 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9915868, \"displayName\": \"ABC-type transporter activity of ABCC1 [plasma membrane] The MRP gene encodes an ATP-dependent export pump for leukotriene C4 and structurally related conjugates\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment