 \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-111883\", \"stIdVersion\": \"R-DDI-111883.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11063808, \"displayName\": \"PLA2G4A (cPLA2) hydrolyzes phosphatidylcholine\", \"inferredFrom\": [111883], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLA2G4A (cPLA2) hydrolyzes phosphatidylcholine\", \"1-acyl-2-(5Z,8Z,11Z,14Z-eicosatetraenoyl)-sn-glycero-3-phosphocholine + H2O => (5Z,8Z,11Z,14Z)-eicosatetraenoate + a 1-acyl-sn-glycero-3-phosphocholine + H+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-111883\", \"stIdVersion\": \"R-SPO-111883.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11092319, \"displayName\": \"PLA2G4A (cPLA2) hydrolyzes phosphatidylcholine\", \"inferredFrom\": [111883], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLA2G4A (cPLA2) hydrolyzes phosphatidylcholine\", \"1-acyl-2-(5Z,8Z,11Z,14Z-eicosatetraenoyl)-sn-glycero-3-phosphocholine + H2O => (5Z,8Z,11Z,14Z)-eicosatetraenoate + a 1-acyl-sn-glycero-3-phosphocholine + H+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-111883\", \"stIdVersion\": \"R-SCE-111883.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29768, \"displayName\": \"AA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AA\", \"arachidonate\", \"Arachidonate\", \"arachidonic acid\", \"cis-5,8,11,14-Eicosatetraenoic acid\"], \"producedByEvent\": [111883], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29768\", \"stIdVersion\": \"R-ALL-29768.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [111883], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 6814253, \"displayName\": \"LysoPtdCho [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LysoPtdCho\", \"1-O-acyl-sn-glycero-3-phosphocholine\"], \"producedByEvent\": [111883], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6814253\", \"stIdVersion\": \"R-ALL-6814253.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 111881, \"displayName\": \"Phospho-cPLA2 translocates to membranes when intracellular calcium levels increase\", \"followingEvent\": [111883], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Phospho-cPLA2 translocates to membranes when intracellular calcium levels increase\"], \"releaseDate\": \"2008-12-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-111881\", \"stIdVersion\": \"R-HSA-111881.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2008-12-17\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-111883\", \"stIdVersion\": \"R-HSA-111883.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 378471, \"displayName\": \"Once associated with the endoplasmic reticulum membrane, PLA...\", \"schemaClass\": \"Summation\", \"text\": \"Once associated with the endoplasmic reticulum membrane, PLA2G4A (cPLA2) hydrolyzes phosphatidylcholine to produce arachidonate (AA), a precursor to inflammatory mediators. While several phospholipases can catalyze this reaction in cells overexpressing the enzymes, PLA2G4A is the major enzyme that catalyzes it in vivo (Reed et al. 2011). At the same time, possible physiological roles have been described for soluble phospholipases (sPLA) in the mobilization of arachidonate in some cell types or under some physiological conditions (Murakami et al. 2011).\"}]}" ;
