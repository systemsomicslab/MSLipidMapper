4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [2161745], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [2161745, 2161745], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 211873, \"displayName\": \"CYP4F2, 4F3 20-hydroxylate LTB4\", \"followingEvent\": [2161745], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYP4F2, 4F3 20-hydroxylate LTB4\", \"leukotriene B4 + O2 + reduced (NADPH--hemoprotein reductase) => 20-hydroxy-leukotriene B4 + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\", \"CYP4F2 omega-hydroxylates leukotriene B4, thus inactivating it\"], \"releaseDate\": \"2008-06-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-211873\", \"stIdVersion\": \"R-HSA-211873.3\"}], \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161745\", \"stIdVersion\": \"R-HSA-2161745.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2161746, \"displayName\": \"The cytochrome P450s 4F2 (CYP4F2) and F3 (CYP4F3) oxidise th...\", \"schemaClass\": \"Summation\", \"text\": \"The cytochrome P450s 4F2 (CYP4F2) and F3 (CYP4F3) oxidise the omega hydroxylated metabolite, 20-hydroxyleukotriene B4 (20oh-LTB4) to form 20-aldehyde leukotriene B4 (20cho-LTB4) (Soberman et al. 1988).\"}]}" ;
