": 22037487, \"schemaClass\": \"LiteratureReference\", \"title\": \"Identification and characterization of splicing variants of PLEKHA5 (Plekha5) during brain development\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/22037487\", \"volume\": 492, \"year\": 2012}, {\"className\": \"LiteratureReference\", \"dbId\": 8870490, \"displayName\": \"Identification of pleckstrin-homology-domain-containing proteins with novel phosphoinositide-binding specificities\", \"journal\": \"Biochem. J.\", \"pages\": \"19-31\", \"pubMedIdentifier\": 11001876, \"schemaClass\": \"LiteratureReference\", \"title\": \"Identification of pleckstrin-homology-domain-containing proteins with novel phosphoinositide-binding specificities\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11001876\", \"volume\": 351, \"year\": 2000}], \"maxDepth\": 1, \"name\": [\"PLEKHA4,(5,6) bind PI3P\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11047837, \"displayName\": \"PLEKHA4,(5,6) bind PI3P\", \"inferredFrom\": [8870489], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLEKHA4,(5,6) bind PI3P\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-8870489\", \"stIdVersion\": \"R-DDI-8870489.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10904074, \"displayName\": \"PLEKHA4,(5,6) bind PI3P\", \"inferredFrom\": [8870489], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLEKHA4,(5,6) bind PI3P\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8870489\", \"stIdVersion\": \"R-DME-8870489.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10721917, \"displayName\": \"PLEKHA4,(5,6) bind PI3P\", \"inferredFrom\": [8870489], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLEKHA4,(5,6) bind PI3P\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8870489\", \"stIdVersion\": \"R-XTR-8870489.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10543683, \"displayName\": \"PLEKHA4,(5,6) bind PI3P\", \"inferredFrom\": [8870489], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLEKHA4,(5,6) bind PI3P\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8870489\", \"stIdVersion\": \"R-SSC-8870489.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10429932, \"displayName\": \"PLEKHA4,(5,6) bind PI3P\", \"inferredFrom\": [8870489], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLEKHA4,(5,6) bind PI3P\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8870489\", \"stIdVersion\": \"R-BTA-8870489.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10316459, \"displayName\": \"PLEKHA4,(5,6) bind PI3P\", \"inferredFrom\": [8870489], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLEKHA4,(5,6) bind PI3P\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8870489\", \"stIdVersion\": \"R-CFA-8870489.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10207988, \"displayName\": \"PLEKHA4,(5,6) bind PI3P\", \"inferredFrom\": [8870489], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLEKHA4,(5,6) bind PI3P\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8870489\", \"stIdVersion\": \"R-RNO-8870489.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10084999, \"displayName\": \"PLEKHA4,(5,6) bind PI3P\", \"inferredFrom\": [8870489], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLEKHA4,(5,6) bind PI3P\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8870489\", \"stIdVersion\": \"R-MMU-8870489.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 8870509, \"displayName\": \"PLEKHA4,(5,6):PI3P [plasma membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"PLEKHA4,(5,6):PI3P\"], \"producedByEvent\": [8870489], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8870509\", \"stIdVersion\": \"R-HSA-8870509.1\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8870489\", \"stIdVersion\": \"R-HSA-8870489.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8870497, \"displayName\": \"The second messenger phosphatidylinositol 3,4,5-trisphosphat...\", \"schemaClass\": \"Summation\", \"text\": \"The second messenger phosphatidylinositol 3,4,5-trisphosphate\\r\\n(PIP3, PtdIns(3,4,5)P) is generated by the action of phosphoinositide\\r\\n3-kinase (PI3K) in response to growth factors and insulin and regulates a range of cellular processes. Proteins containing the plekstrin homology (PH) domain can interact specifically with PIP3 or its immediate breakdown product, phosphatidylinositol 3,4-diphosphate (PIP2, PtdIns(3,4)P). Proteins with a PH domain have also been found to bind to PIs other than PIP3 or PIP2. Pleckstrin homology domain-containing family A member 4 (PLEKHA4 aka PEPP1) is able to specifically bind phosphatidylinositol 3-phosphate (PI3P) but not other phosphoinositides (Dowler et al. 2000). Two related isoforms of\\r\\nPLEKHA4, PLEKHA5 and 6 (PEPP2 and PEPP3), possess a very similar PH domain sequence, indicating that they may also interact with PI3P (Dowler et al. 2000, Yamada et al. 2012). These proteins may function as adaptor molecules since they possess no obvious catalytic moieties.\"}]}" ;
