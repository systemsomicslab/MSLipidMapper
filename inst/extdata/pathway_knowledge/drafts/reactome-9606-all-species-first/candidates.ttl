ONE\", \"pages\": \"e94836\", \"pubMedIdentifier\": 24736647, \"schemaClass\": \"LiteratureReference\", \"title\": \"Generation and dietary modulation of anti-inflammatory electrophilic omega-3 fatty acid derivatives\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/24736647\", \"volume\": 9, \"year\": 2014}, {\"className\": \"LiteratureReference\", \"dbId\": 9028241, \"displayName\": \"Formation of a 5-oxo metabolite of 5,8,11,14,17-eicosapentaenoic acid and its effects on human neutrophils and eosinophils\", \"journal\": \"J. Lipid Res.\", \"pages\": \"2590-8\", \"pubMedIdentifier\": 8847485, \"schemaClass\": \"LiteratureReference\", \"title\": \"Formation of a 5-oxo metabolite of 5,8,11,14,17-eicosapentaenoic acid and its effects on human neutrophils and eosinophils\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8847485\", \"volume\": 36, \"year\": 1995}], \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises EPA to 5-HEPE\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11051187, \"displayName\": \"ALOX5 oxidises EPA to 5-HEPE\", \"inferredFrom\": [9027628], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises EPA to 5-HEPE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-9027628\", \"stIdVersion\": \"R-DDI-9027628.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10822975, \"displayName\": \"ALOX5 oxidises EPA to 5-HEPE\", \"inferredFrom\": [9027628], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises EPA to 5-HEPE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-9027628\", \"stIdVersion\": \"R-GGA-9027628.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10727797, \"displayName\": \"ALOX5 oxidises EPA to 5-HEPE\", \"inferredFrom\": [902762