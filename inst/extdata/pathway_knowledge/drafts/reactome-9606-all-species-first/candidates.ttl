eaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-390256\", \"stIdVersion\": \"R-BTA-390256.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10259374, \"displayName\": \"ACOX1 oxidizes C26:0 CoA\", \"inferredFrom\": [390256], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACOX1 oxidizes C26:0 CoA\", \"hexacosanoyl-CoA + O2 => (2E)-hexacosenoyl-CoA + H2O2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-390256\", \"stIdVersion\": \"R-CFA-390256.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10018822, \"displayName\": \"ACOX1 oxidizes C26:0 CoA\", \"inferredFrom\": [390256], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACOX1 oxidizes C26:0 CoA\", \"hexacosanoyl-CoA + O2 => (2E)-hexacosenoyl-CoA + H2O2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-390256\", \"stIdVersion\": \"R-MMU-390256.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 390249, \"displayName\": \"trans-2,3-dehydrohexacosanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"trans-2,3-dehydrohexacosanoyl-CoA\", \"trans-2-hexacosenoyl-CoA(4-)\", \"trans-2-hexacosenoyl-CoA\"], \"producedByEvent\": [390256], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390249\", \"stIdVersion\": \"R-ALL-390249.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113575, \"displayName\": \"H2O2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O2\", \"hydrogen peroxide\"], \"producedByEvent\": [390256], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113575\", \"stIdVersion\": \"R-ALL-113575.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9914143, \"displayName\": \"SLC27A2-mediated ligation of peroxisomal fatty acid and CoASH\", \"followingEvent\": [390256], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SLC27A2-mediated ligation of peroxisomal fatty acid and CoASH\", \"a very long-chain fatty acid + ATP + CoA => a very long-chain fatty acyl-CoA + AMP + diphosphate\"], \"releaseDate\": \"2024-09-11\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9914143\", \"stIdVersion\": \"R-HSA-9914143.1\"}], \"releaseDate\": \"2009-04-01\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390256\", \"stIdVersion\": \"R-HSA-390256.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 390254, \"displayName\": \"Peroxisomal ACOX1 catalyzes the reaction of hexacosanoyl-CoA...\", \"schemaClass\": \"Summation\", \"text\": \"Peroxisomal ACOX1 catalyzes the reaction of hexacosanoyl-CoA and O2 to form trans-2,3-dehydrohexacosanoyl-CoA and H2O2. The active form of the enzyme is a homodimer with FAD as a cofactor (Chu et al. 1995). Mutations in the ACOX1 gene are asociated with accumulation of very long chain fatty acids. Two isoforms of ACOX1, generated by alternative splicing are known; a mutation affecting specifically the second isoform blocks the oxidation of very long chain fatty acids (Ferdinandusse et al. 2007).\"}]}" ;
