    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [193792], \"className\": \"CatalystActivity\", \"dbId\": 192037, \"displayName\": \"oxidoreductase activity, acting on NAD(P)H as acceptor of CYP27A1 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 193792, \"displayName\": \"CYP27A1 27-hydroxylates 5β-CHOL3α,7α,24(s)-triol\", \"followingEvent\": [193719], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193792], \"dbId\": 193720, \"displayName\": \"5β-CHOL3α,7α,24(s)-triol [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5β-CHOL3α,7α,24(s)-triol\", \"(24S)-5beta-cholestane-3alpha,7alpha,24-triol\", \"5beta-cholestan-3alpha,7alpha,24(S)-triol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193720\", \"stIdVersion\": \"R-ALL-193720.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [193792], \"dbId\": 113600, \"displayName\": \"NADPH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113600\", \"stIdVersion\": \"R-ALL-113600.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [193792], \"dbId\": 113529, \"displayName\": \"H+ [m