ce\": [{\"className\": \"LiteratureReference\", \"dbId\": 6810416, \"displayName\": \"Nuclear PtdIns5P as a transducer of stress signaling: an in vivo role for PIP4Kbeta\", \"journal\": \"Mol. Cell\", \"pages\": \"685-95\", \"pubMedIdentifier\": 16949365, \"schemaClass\": \"LiteratureReference\", \"title\": \"Nuclear PtdIns5P as a transducer of stress signaling: an in vivo role for PIP4Kbeta\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/16949365\", \"volume\": 23, \"year\": 2006}, {\"className\": \"LiteratureReference\", \"dbId\": 6811521, \"displayName\": \"Nuclear targeting of the beta isoform of type II phosphatidylinositol phosphate kinase (phosphatidylinositol 5-phosphate 4-kinase) by its alpha-helix 7\", \"journal\": \"Biochem. J.\", \"pages\": \"587-91\", \"pubMedIdentifier\": 10698683, \"schemaClass\": \"LiteratureReference\", \"title\": \"Nuclear targeting of the beta isoform of type II phosphatidylinositol phosphate kinase (phosphatidylinositol 5-phosphate 4-kinase) by its alpha-helix 7\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/10698683\", \"volume\": 346, \"year\": 2000}, {\"className\": \"LiteratureReference\", \"dbId\": 6811524, \"displayName\": \"PIP4Kbeta interacts with and modulates nuclear localization of the high-activity PtdIns5P-4-kinase isoform PIP4Kalpha\", \"journal\": \"Biochem. J.\", \"pages\": \"223-35\", \"pubMedIdentifier\": 20583997, \"schemaClass\": \"LiteratureReference\", \"title\": \"PIP4Kbeta interacts with and modulates nuclear localization of the high-activity PtdIns5P-4-kinase isoform PIP4Kalpha\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/20583997\", \"volume\": 430, \"year\": 2010}], \"maxDepth\": 1, \"name\": [\"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10425234, \"displayName\": \"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers in the nucleus\", \"inferredFrom\": [6811522], \"isInDiseas