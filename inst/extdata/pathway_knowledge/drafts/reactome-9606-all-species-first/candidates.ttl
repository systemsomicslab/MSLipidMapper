<https://reactome.org/content/detail/R-HSA-8848582> a mslm:LipidReaction ;
    rdfs:label "AWAT2 transfers PALM from PALM-CoA to HXOL, forming palmityl palmitate ester" ;
    mslm:curationStatus mslm:Draft ;
