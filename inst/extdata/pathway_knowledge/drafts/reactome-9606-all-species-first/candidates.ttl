    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [193965], \"className\": \"CatalystActivity\", \"dbId\": 193967, \"displayName\": \"steroid hydroxylase activity of CYP11B2 [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9907745, \"displayName\": \"RHEA:50793\", \"identifier\": \"50793\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/50793\"}], \"dbId\": 193965, \"displayName\": \"CYP11B2 oxidises 18HCORST to ALDO\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193965], \"dbId\": 194012, \"displayName\": \"18HCORST [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"18HCORST\", \"18-hydroxycorticosterone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194012\", \"stIdVersion\": \"R-ALL-194012.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [193965, 193965], \"dbId\": 113600, \"displayName\": \"NADPH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113600\", \"stIdVersion\": \"R-ALL-113600.4\"}, 113600, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [193965, 193965], \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}, 113529, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [193965], \"dbId\": 113533, \"displayName\": \"O2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113533\", \"stIdVersion\": \"R-ALL-113533.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 194016, \"displayName\": \"Characterization of two genes encoding human steroid 11 beta-hydroxylase (P-450(11) beta)\", \"journal\": \"J Biol Chem\", \"pages\": \"20961-7\", \"pubMedIdentifier\": 2592361, \"schemaClass\": \"LiteratureReference\", \"title\": \"Characterization of two genes encoding human steroid 11 beta-hydroxylase (P-450(11) beta)\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/2592361\", \"volume\": 264, \"year\": 1989}, {\"className\": \"LiteratureReference\", \"dbId\": 194015, \"displayName\": \"Cloning and expression of a cDNA for human cytochrome P-450aldo as related to primary aldosteronism\", \"journal\": \"Biochem Biophys Res Commun\", \"pages\": \"309-16\", \"pubMedIdentifier\": 22