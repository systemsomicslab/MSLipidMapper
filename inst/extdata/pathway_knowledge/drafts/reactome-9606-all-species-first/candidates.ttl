\": \"NR1H4 binds DCA, CDCA, LCHA\", \"inferredFrom\": [5340195], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NR1H4 binds DCA, CDCA, LCHA\", \"FXR binds bile acids\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-5340195\", \"stIdVersion\": \"R-SSC-5340195.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10405707, \"displayName\": \"NR1H4 binds DCA, CDCA, LCHA\", \"inferredFrom\": [5340195], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NR1H4 binds DCA, CDCA, LCHA\", \"FXR binds bile acids\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-5340195\", \"stIdVersion\": \"R-BTA-5340195.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10293839, \"displayName\": \"NR1H4 binds DCA, CDCA, LCHA\", \"inferredFrom\": [5340195], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NR1H4 binds DCA, CDCA, LCHA\", \"FXR binds bile acids\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-5340195\", \"stIdVersion\": \"R-CFA-5340195.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10182500, \"displayName\": \"NR1H4 binds DCA, CDCA, LCHA\", \"inferredFrom\": [5340195], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NR1H4 binds DCA, CDCA, LCHA\", \"FXR binds bile acids\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5340195\", \"stIdVersion\": \"R-RNO-5340195.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10059873, \"displayName\": \"NR1H4 binds DCA, CDCA, LCHA\", \"inferredFrom\": [5340195], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NR1H4 binds DCA, CDCA, LCHA\", \"FXR binds bile acids\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-5340195\", \"stIdVersion\": \"R-MMU-5340195.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 5340186, \"displayName\": \"NR1H4:DCA,CDCA,LCHA [nucleoplasm]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"NR1H4:DCA,CDCA,LCHA\"], \"producedByEvent\": [5340195], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5340186\", \"stIdVersion\": \"R-HSA-5340186.1\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2015-03-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5340195\", \"stIdVersion\": \"R-HSA-5340195.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5340176, \"displayName\": \"The nuclear orphan protein bile acid receptor aka farnesoid ...\", \"schemaClass\": \"Summation\", \"text\": \"The nuclear orphan protein bile acid receptor aka farnesoid X-activated receptor (NR1H4 aka FXR) can be activated by bile acids and their salts, its physiological ligands. Mouse Nrih4 is highly expressed in the liver, intestine, kidney and adrenal gland, and to a lesser extent in white adipose tissue and heart (Zhang et al. 2003). Bile acids tested to activate NR1H4 are chenodeoxycholic acid (CDCA), lithocholic acid (LCHA) and deoxycholic acid (DCA) (Parks et al. 1999, Makishima et al. 1999).<br><br>Once bound to its ligand, activated NR1H4 binds to retinoic acid receptor RXR-alpha (RXRA) and either nuclear receptor coactivator 1 or 2 (NCOA1 or 2) to function as a ligand-activated transcription factor. This complex repressed transcription of the CYP7A1 gene (encoding cholesterol 7alpha-hydroxylase, the rate-limiting enzyme in bile acid synthesis) (Holt et al. 2003) and activated the SLC10A2 and 6 genes (encoding Ileal sodium/bile acid cotransporters, both bile acid transporters) (Plass et al. 2002, Ananthanarayanan et al. 2001). Thus, NR1H4 is one of the most important regulators of bile acid metabolism, regulating bile acid synthesis, conjugation, secretion and uptake (Lee et al. 2006, Houten et al. 2006).\"}]}" ;
