0, \"schemaClass\": \"LiteratureReference\", \"title\": \"Autocatalytic activation of human legumain at aspartic acid residues\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9821970\", \"volume\": 438, \"year\": 1998}, {\"className\": \"LiteratureReference\", \"dbId\": 350091, \"displayName\": \"Activation of human prolegumain by cleavage at a C-terminal asparagine residue\", \"journal\": \"Biochem J\", \"pages\": \"327-34\", \"pubMedIdentifier\": 11085925, \"schemaClass\": \"LiteratureReference\", \"title\": \"Activation of human prolegumain by cleavage at a C-terminal asparagine residue\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11085925\", \"volume\": 352, \"year\": 2000}], \"maxDepth\": 1, \"name\": [\"Endocytic translocation of CUBN:GC:25(OH)D to lysosomal lumen\"], \"orthologousEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10360456, \"displayName\": \"Endocytic translocation of CUBN:GC:25(OH)D to lysosomal lumen\", \"inferredFrom\": [209760], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Endocytic translocation of CUBN:GC:25(OH)D to lysosomal lumen\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-209760\", \"stIdVersion\": \"R-BTA-209760.1\"}, {\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10133499, \"displayName\": \"Endocytic translocation of CUBN:GC:25(OH)D to lysosomal lumen\", \"inferredFrom\": [209760], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Endocytic translocation of CUBN:GC:25(OH)D to lysosomal lumen\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-209760\", \"stIdVersion\": \"R-RNO-209760.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 350085, \"displayName\": \"CUBN:GC:25(OH)D [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"CUBN:GC:25(OH