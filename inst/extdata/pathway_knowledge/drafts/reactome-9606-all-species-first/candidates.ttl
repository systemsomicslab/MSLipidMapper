", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-194641\", \"stIdVersion\": \"R-MMU-194641.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 194735, \"displayName\": \"4C4MZYMOL [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4C4MZYMOL\", \"4beta-methylzymosterol-4alpha-carboxylate\", \"4-methyl,4-carboxycholesta-8(9),24-dien-3beta-ol\", \"4-carboxy-4-methylzymosterol\"], \"producedByEvent\": [194641], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194735\", \"stIdVersion\": \"R-ALL-194735.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [194641, 194641, 194641, 194641], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356, 29356, 29356, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [194641, 194641, 194641], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}, 29366, 29366], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 194678, \"displayName\": \"CYP51A1 demethylates LAN\", \"followingEvent\": [194641], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYP51A1 demethylates LAN\", \"lanosterol + 3 O2 + 3 reduced (NADPH--hemoprotein reductase) => 4,4-dimethyl-5alpha-cholesta-8,14,24-trien-3beta-ol + formate + 4 H(+) + 4 H2O + 3 oxidized (NADPH--hemoprotein reductase)\", \"lanosterol + 3 NADPH + 3 H+ + 3 O2 => 4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol + 3 NADP+ + 4 H2O + formate\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194678\", \"stIdVersion\": \"R-HSA-194678.5\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 194698, \"displayName\": \"4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol is reduced to 4,4-dimethylcholesta-8(9),24-dien-3beta-ol [TM7SF2]\", \"followingEvent\": [194641], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol is reduced to 4,4-dimethylcholesta-8(9),24-dien-3beta-ol [TM7SF2]\", \"4,4-dimethyl-5alpha-cholesta-8,14,24-trien-3beta-ol + NADPH + H(+) => 4,4-dimethyl-5alpha-cholesta-8,24-dien-3beta-ol + NADP(+)\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194698\", \"stIdVersion\": \"R-HSA-194698.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2007-02-20\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194641\", \"stIdVersion\": \"R-HSA-194641.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 194733, \"displayName\": \"4,4-dimethylcholesta-8(9),24-dien-3beta-ol, NADPH +  H+, and...\", \"schemaClass\": \"Summation\", \"text\": \"4,4-dimethylcholesta-8(9),24-dien-3beta-ol, NADPH +  H+, and O2 react to form 4-methyl,4-carboxycholesta-8(9),24-dien-3beta-ol, NADP+, and H2O. This reaction, in the endoplasmic reticulum, is catalyzed by SC4MOL (C-4 methylsterol oxidase). The human enzyme has been identified based on its sequence similarity to yeast methyl sterol oxidase (ERG25) and the ability of the cloned human gene to rescue ERG25-deficient yeast cells (Li and Kaplan 1996). The mechanism and stoichiometry of the reaction have been inferred from studies of partially purified rat enzyme (Gaylor et al. 1975; Fukushima et al. 1981).\"}]}" ;
