: \"R-GGA-8865637.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10721001, \"displayName\": \"MFSD2A transports LPC from extracellular region to plasma membrane\", \"inferredFrom\": [8865637], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MFSD2A transports LPC from extracellular region to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8865637\", \"stIdVersion\": \"R-XTR-8865637.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10638475, \"displayName\": \"MFSD2A transports LPC from extracellular region to plasma membrane\", \"inferredFrom\": [8865637], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MFSD2A transports LPC from extracellular region to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-8865637\", \"stIdVersion\": \"R-DRE-8865637.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10542399, \"displayName\": \"MFSD2A transports LPC from extracellular region to plasma membrane\", \"inferredFrom\": [8865637], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MFSD2A transports LPC from extracellular region to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8865637\", \"stIdVersion\": \"R-SSC-8865637.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10428797, \"displayName\": \"MFSD2A transports LPC from extracellular region to plasma membrane\", \"inferredFrom\": [8865637], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MFSD2A transports LPC from extracellular region to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8865637\", \"stIdVersion\": \"R-BTA-8865637.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10315282, \"displayName\": \"MFSD2A transports LPC from extracellular region to plasma membrane\", \"inferredFrom\": [8865637], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MFSD2A transports LPC from extracellular region to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8865637\", \"stIdVersion\": \"R-CFA-8865637.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10206597, \"displayName\": \"MFSD2A transports LPC from extracellular region to plasma membrane\", \"inferredFrom\": [8865637], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MFSD2A transports LPC from extracellular region to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8865637\", \"stIdVersion\": \"R-RNO-8865637.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10083626, \"displayName\": \"MFSD2A transports LPC from extracellular region to plasma membrane\", \"inferredFrom\": [8865637], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MFSD2A transports LPC from extracellular region to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8865637\", \"stIdVersion\": \"R-MMU-8865637.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8865629, \"displayName\": \"LPC (22:6) [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LPC (22:6)\", \"lysophosphatidylcholine 22:6\", \"docosahexaenoyl-sn-glycero-3-phosphocholine\"], \"producedByEvent\": [8865637], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8865629\", \"stIdVersion\": \"R-ALL-8865629.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 83910, \"displayName\": \"Na+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Na+\", \"sodium(1+)\", \"sodium ion\", \"Sodium\"], \"producedByEvent\": [8865637], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-83910\", \"stIdVersion\": \"R-ALL-83910.4\"}], \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8865637\", \"stIdVersion\": \"R-HSA-8865637.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8865630, \"displayName\": \"Sodium-dependent lysophosphatidylcholine symporter 1 (MFSD2A...\", \"schemaClass\": \"Summation\", \"text\": \"Sodium-dependent lysophosphatidylcholine symporter 1 (MFSD2A, aka NLS1) plays an essential role in blood-brain barrier (BBB) formation and function and transports LPC into the brain via a flipping motion (Nguyen et al. 2014, Guemez-Gamboa et al. 2015, Quek et al. 2016). LPCs are synthesised by the liver, circulate bound to albumin and serve as the chemical carrier for DHA uptake via MFSD2A. LPC can contain docosahexanoic acid (DHA), the most abundant omega-3 fatty acid in brain. Despite large DHA content in phospholipids, the brain does not synthesise it. MFSD2A is highly enriched in cerebral vasculature, where it is exclusively found in BBB endothelium.\"}]}" ;
