Canis familiaris\", \"stId\": \"R-CFA-192033\", \"stIdVersion\": \"R-CFA-192033.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10128006, \"displayName\": \"4-cholesten-7alpha-ol-3-one is reduced to 5beta-cholestan-7alpha-ol-3-one\", \"inferredFrom\": [192033], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4-cholesten-7alpha-ol-3-one is reduced to 5beta-cholestan-7alpha-ol-3-one\", \"7alpha-hydroxycholest-4-en-3-one + H(+) + NADPH => 7alpha-hydroxy-5beta-cholestan-3-one + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-192033\", \"stIdVersion\": \"R-RNO-192033.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007087, \"displayName\": \"4-cholesten-7alpha-ol-3-one is reduced to 5beta-cholestan-7alpha-ol-3-one\", \"inferredFrom\": [192033], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4-cholesten-7alpha-ol-3-one is reduced to 5beta-cholestan-7alpha-ol-3-one\", \"7alpha-hydroxycholest-4-en-3-one + H(+) + NADPH => 7alpha-hydroxy-5beta-cholestan-3-one + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-192033\", \"stIdVersion\": \"R-MMU-192033.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 191980, \"displayName\": \"5beta-cholestan-7alpha-ol-3-one [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-7alpha-ol-3-one\", \"7alpha-hydroxy-5beta-cholestan-3-one\"], \"producedByEvent\": [192033], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191980\", \"stIdVersion\": \"R-ALL-191980.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [192033], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 192097, \"displayName\": \"7alpha-hydroxycholesterol is oxidized and isomerized to 4-cholesten-7alpha-ol-3-one\", \"followingEvent\": [192033], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"7alpha-hydroxycholesterol is oxidized and isomerized to 4-cholesten-7alpha-ol-3-one\", \"7alpha-hydroxycholesterol + NAD(+) => 7alpha-hydroxycholest-4-en-3-one + H(+) + NADH\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192097\", \"stIdVersion\": \"R-HSA-192097.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192033\", \"stIdVersion\": \"R-HSA-192033.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 192066, \"displayName\": \"4-Cholesten-7alpha-ol-3-one, NADPH, and H+ react to form 5be...\", \"schemaClass\": \"Summation\", \"text\": \"4-Cholesten-7alpha-ol-3-one, NADPH, and H+ react to form 5beta-cholestan-7alpha-ol-3-one and NADP+. This reaction is catalyzed by AKR1D1 (3-oxo-5-beta-steroid 4-dehydrogenase). AKR1D1 is localized to the cytosol, and in the course of the reaction its steroid substrate moves from the endoplasmic reticulum membrane to the cytosol. It is unclear whether this translocation results simply from its increased hydrophilicity or is mediated by the enzyme or another transport protein (Russell 2003).\"}]}" ;
