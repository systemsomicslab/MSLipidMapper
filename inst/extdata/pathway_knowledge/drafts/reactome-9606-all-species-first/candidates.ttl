: false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CIDEA:CIDEC binds lipid droplets\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8856630\", \"stIdVersion\": \"R-CFA-8856630.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10205583, \"displayName\": \"CIDEA:CIDEC binds lipid droplets\", \"inferredFrom\": [8856630], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CIDEA:CIDEC binds lipid droplets\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8856630\", \"stIdVersion\": \"R-RNO-8856630.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10082701, \"displayName\": \"CIDEA:CIDEC binds lipid droplets\", \"inferredFrom\": [8856630], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CIDEA:CIDEC binds lipid droplets\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8856630\", \"stIdVersion\": \"R-MMU-8856630.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 8856647, \"displayName\": \"CIDEA:CIDEC:lipid droplet [lipid droplet]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"CIDEA:CIDEC:lipid droplet\"], \"producedByEvent\": [8856630], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8856647\", \"stIdVersion\": \"R-HSA-8856647.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-06-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8856630\", \"stIdVersion\": \"R-HSA-8856630.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8856929, \"displayName\": \"Humans possess three cell death-inducing DFFA-like effector ...\", \"schemaClass\": \"Summation\", \"text\": \"Humans possess three cell death-inducing DFFA-like effector (CIDE) proteins, CIDEA, CIDEB and CIDEC. Initially, their function was determined to be the promotion of apoptosis but they are also known to play a role in energy metabolism. CIDEA and C bind to lipid droplets and regulate their enlargement, thereby restricting lipolysis and favouring storage (by promoting net neutral lipid transfer from smaller to larger lipid droplets) (for review see Gao & Goodman 2015). CIDEA is bound to CIDEC to form a heterodimer, both subunits of which are required for the adaptor activity annotated here (Liu et al. 2009). CIDEB has not been determined to bind lipid droplets.\"}]}" ;
