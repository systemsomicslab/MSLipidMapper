<https://reactome.org/content/detail/R-HSA-1605591> a mslm:LipidReaction ;
    rdfs:label "GBA1:SAPC hydrolyzes GlcCer" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "H2O [lysosomal lumen] + GlcCer [lysosomal lumen] => Glc [lysosomal lumen] + CERA [lysosomal lumen]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [1605591], \"className\": \"CatalystActivity\", \"dbId\": 1605702, \"displayName\": \"glucosylceramidase activity of GBA1:SAPC [lysosomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005765\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17938, \"definition\": \"The lipid bilayer surrounding the lysosome and separating its contents from the cell cytoplasm.\", \"displayName\": \"lysosomal membrane\", \"name\": \"lysosomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005765\"}, {\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 1605591, \"displayName\": \"GBA1:SAPC hydrolyzes GlcCer\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1605591], \"dbId\": 1605592, \"displayName\": \"GlcCer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GlcCer\", \"beta-D-glucosyl-N-acylsphingosine\", \"Glucosylceramide\", \"Glucocerebroside\", \"D-glucosyl-N-acylsphingosine\", \"D-glucosy-N-acylsphingosine\", \"D-glucosyl-N-acylsphingoid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605592\", \"stIdVersion\": \"R-ALL-1605592.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [1605591], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersi