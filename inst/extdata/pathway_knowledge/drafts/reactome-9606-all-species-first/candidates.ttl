    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9028255], \"className\": \"CatalystActivity\", \"dbId\": 9027536, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen of PTGS2 dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 9028255, \"displayName\": \"PTGS2 dimer oxidises EPA to PGH3\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9028255], \"dbId\": 2026977, \"displayName\": \"EPA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"EPA\", \"all-cis-5,8,11,14,17-icosapentaenoate\", \"eicosapentaenoic acid\", \"all-cis-5,8,11,14,17-icosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2026977\", \"stIdVersion\": \"R-ALL-2026977.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9028255], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9027533, \"displayName\": \"Cyclooxygenase-2 generates anti-inflammatory mediators from omega-3 fatty acids\", \"journal\": \"Nat. Chem. Biol.\", \"pages\": \"433-41\", \"pubMedIdentifier\": 20436486, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cyclooxygenase-2 generates anti-inflammatory mediators from omega-3 fatty acids\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/20436486\", \"volume\": 6, \"year\": 2010}, {\"className\": \"LiteratureReference\", \"dbId\": 9022657, \"displayName\": \"Resolvins: a family of bioactive products of omega-3 fatty acid transformation circuits initiated by aspirin treatment that counter proinflammation signals\", \"journal\": \"J. Exp. Med.\", \"pages\": \"1025-37\", \"pubMedIdentifier\": 12391014, \"schemaClass\": \"LiteratureReference\", \"title\": \"Resolvins: a family of bioactive products of omega-3 fatty acid transformation circuits initiated by aspirin treatment that counter proinflammation signals\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12391014\", \"volume\": 196, \"year\": 2002}, {\"className\": \"LiteratureReference\", \"dbId\": 9028279, \"displayName\": \"Enzymes and receptors of prostaglandin pathways with arachidonic acid-derived versus eicosapentaenoic acid-derived substrates and products\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"22254-66\", \"pubMedIdentifier\": 17519235, \"schemaClass\": \"LiteratureReference\", \"title\": \"Enzymes and receptors of prostaglandin pathways with arachidonic acid-derived versus eicosapentaenoic acid-derived substrates and products\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17519235\", \"volume\": 282, \"year\": 2007}], \"maxDepth\": 1, \"name\": [\"PTGS2 dimer oxidises EPA to PGH3\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10822981, \"displayName\": \"PTGS2 dimer oxidises EPA to PGH3\", \"inferredFrom\": [9028255], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS2 dimer oxidises EPA to PGH3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-9028255\", \"stIdVersion\": \"R-GGA-9028255.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10727803, \"displayName\": \"PTGS2 dimer oxidises EPA to PGH3\", \"inferredFrom\": [9028255], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS2 dimer oxidises EPA to PGH3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9028255\", \"stIdVersion\": \"R-XTR-9028255.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10645366, \"displayName\": \"PTGS2 dimer oxidises EPA to PGH3\", \"inferredFrom\": [9028255], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS2 dimer oxidises EPA to PGH3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9028255\", \"stIdVersion\": \"R-DRE-9028255.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10551263, \"displayName\": \"PTGS2 dimer oxidises EPA to PGH3\", \"inferredFrom\": [9028255], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS2 dimer oxidises EPA to PGH3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9028255\", \"stIdVersion\": \"R-SSC-9028255.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10437854, \"displayName\": \"PTGS2 dimer oxidises EPA to PGH3\", \"inferredFrom\": [9028255], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS2 dimer oxidises EPA to PGH3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9028255\", \"stIdVersion\": \"R-BTA-9028255.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10323976, \"displayName\": \"PTGS2 dimer oxidises EPA to PGH3\", \"inferredFrom\": [9028255], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS2 dimer oxidises EPA to PGH3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9028255\", \"stIdVersion\": \"R-CFA-9028255.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10216083, \"displayName\": \"PTGS2 dimer oxidises EPA to PGH3\", \"inferredFrom\": [9028255], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS2 dimer oxidises EPA to PGH3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9028255\", \"stIdVersion\": \"R-RNO-9028255.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092871, \"displayName\": \"PTGS2 dimer oxidises EPA to PGH3\", \"inferredFrom\": [9028255], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS2 dimer oxidises EPA to PGH3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9028255\", \"stIdVersion\": \"R-MMU-9028255.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9028280, \"displayName\": \"PGH3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGH3\", \"prostaglandin H3(1-)\", \"prostaglandin H3\"], \"producedByEvent\": [9028255], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9028280\", \"stIdVersion\": \"R-ALL-9028280.5\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9028255\", \"stIdVersion\": \"R-HSA-9028255.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9028267, \"displayName\": \"In the absence of aspirin, dimeric cyclooxygenase 2 (PTGS2 d...\", \"schemaClass\": \"Summation\", \"text\": \"In the absence of aspirin, dimeric cyclooxygenase 2 (PTGS2 dimer aka COX2) located on the ER membrane can mediate the oxidation of eicosapentaenoic acid (EPA) to prostaglandin D3 (PGD3) in activated macrophages (Serhan et al. 2002, Groeger et al. 2010, Wada et al. 2007). It is likely that EPA-derived oxo-derivatives are formed in the same way as demonstrated by Fitzpatrick et al. (Fitzpatrick et al. 1983, Shibata et al. 2002). EPA supplementation to mice resulted in enhanced endogenous production of 15-deoxy-PGJ3 (15d-PGJ3), the final deoxy-product of EPA (Lefils-Lacourtablaise et al. 2013).\"}]}" ;
