", \"startCoordinate\": 1}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [429714, 429714], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, 70106], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 429698, \"displayName\": \"PRKD1,2,3 phosphorylates CERT1-2\", \"followingEvent\": [429714], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PRKD1,2,3 phosphorylates CERT1-2\", \"CERT + ATP => monophospho-CERT + ADP\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-429698\", \"stIdVersion\": \"R-HSA-429698.7\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2009-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-429714\", \"stIdVersion\": \"R-HSA-429714.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 429701, \"displayName\": \"Cytosolic CSNK1G2 (casein kinase 1, gamma 2) catalyzes the p...\", \"schemaClass\": \"Summation\", \"text\": \"Cytosolic CSNK1G2 (casein kinase 1, gamma 2) catalyzes the phosphorylation of multiple serine and threonine residues of “CERT” (ceramide transfer protein) already phosphorylated on serine-132 (Tomishige et al. 2009). This reaction has the effect of inhibiting ceramide transport from the endoplasmic reticulum to the Golgi apparatus as multiphospho-CERT is unable to bind ceramides or associate with the Golgi membrane (reviewed by Kumagai & Hanada, 2019).\"}]}" ;
