    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [390256], \"className\": \"CatalystActivity\", \"dbId\": 390231, \"displayName\": \"acyl-CoA oxidase activity of ACOX1 dimer [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9914119, \"displayName\": \"acyl-CoA oxidase activity of ACOX1 dimer [peroxisomal matrix] Clinical, biochemical, and mutational spectrum of peroxisomal acyl-coenzyme A oxidase deficiency\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12689961, \"displayName\": \"RHEA:78632\", \"identifier\": \"78632\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/78632\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9914138, \"displayName\": \"RHEA:78632\", \"identifier\": \"78632\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/78632\"}], \"dbId\": 390256, \"displayName\": \"ACOX1 oxidizes C26:0 CoA\", \"followingEvent\": [390252], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [390256], \"dbId\": 390260, \"displayName\": \"C26:0 CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"C26:0 CoA\", \"hexacosanoyl-CoA(4-)\", \"cerotyl-CoA\", \"hexacosanoyl-CoA\"], \"referenceType\"