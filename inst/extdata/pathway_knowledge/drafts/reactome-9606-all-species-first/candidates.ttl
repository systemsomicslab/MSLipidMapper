, \"pages\": \"22492-8\", \"pubMedIdentifier\": 17561512, \"schemaClass\": \"LiteratureReference\", \"title\": \"Phosphorylation of StarD10 on serine 284 by casein kinase II modulates its lipid transfer activity\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17561512\", \"volume\": 282, \"year\": 2007}], \"maxDepth\": 1, \"name\": [\"Casein kinase II phosphorylates STARD10\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10990378, \"displayName\": \"Casein kinase II phosphorylates STARD10\", \"inferredFrom\": [8873929], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Casein kinase II phosphorylates STARD10\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-8873929\", \"stIdVersion\": \"R-CEL-8873929.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10639279, \"displayName\": \"Casein kinase II phosphorylates STARD10\", \"inferredFrom\": [8873929], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Casein kinase II phosphorylates STARD10\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-8873929\", \"stIdVersion\": \"R-DRE-8873929.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10543783, \"displayName\": \"Casein kinase II phosphorylates STARD10\", \"inferredFrom\": [8873929], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Casein kinase II phosphorylates STARD10\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8873929\", \"stIdVersion\": \"R-SSC-8873929.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10430064, \"displayName\": \"Casein kinase II phosphorylates STARD10\", \"inferredFrom\": [8873929], \"isInDisease\": false, \"isInferred\": tru