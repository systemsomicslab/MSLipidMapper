    mslm:equation "1,25(OH)2D [cytosol] => 1,25(OH)2D [nucleoplasm]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 8963913, \"displayName\": \"1,25(OH)2D translocates from cytosol to nucleoplasm\", \"followingEvent\": [8963915], \"goBiologicalProcess\": {\"accession\": \"0006869\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 1122, \"definition\": \"The directed movement of lipids into, out of or within a cell, or between cells, by means of some agent such as a transporter or pore. Lipids are compounds soluble in an organic solvent but not, or sparingly, in an aqueous solvent.\", \"displayName\": \"lipid transport\", \"name\": \"lipid transport\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006869\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8963913], \"dbId\": 209800, \"displayName\": \"1,25(OH)2D [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1,25(OH)2D\", \"calcitriol\", \"CTL\", \"1,25-dihydroxyD3\", \"1,25-dihydroxyvitamin D3\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-209800\", \"stIdVersion\": \"R-ALL-209800.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8963930, \"displayName\": \"Vitamin D: Metabolism, Molecular Mechanism of Action, and Pleiotropic Effects\", \"journal\": \"Physiol. Rev.\", \"pages\": \"365-408\", \"pubMedIdentifier\": 26681795, \"schemaClass\": \"LiteratureReference\", \"title\": \"Vitamin D: Metabolism, Molecular Mechanism of Action, and Pleiotropic Effects\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/26681795\", \"volume\": 96, \"year\": 2016}], \"maxDepth\": 1, \"name\": [\"1,25(OH)2D translocates from cytosol to nucleoplasm\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8963912, \"displayName\": \"1,25(OH)2D [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1,25(OH)2D\", \"calcitriol\", \"CTL\", \"1,25-dihydroxyD3\", \"1,25-dihydroxyvitamin D3\"], \"producedByEvent\": [8963913], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8963912\", \"stIdVersion\": \"R-ALL-8963912.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 209868, \"displayName\": \"CYP27B1 hydroxylates 25(OH)D to 1,25(OH)2D\", \"followingEvent\": [8963913], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYP27B1 hydroxylates 25(OH)D to 1,25(OH)2D\"], \"releaseDate\": \"2008-06-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-209868\", \"stIdVersion\": \"R-HSA-209868.5\"}], \"releaseDate\": \"2017-12-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8963913\", \"stIdVersion\": \"R-HSA-8963913.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8963940, \"displayName\": \"The biologically active form of vitamin D, 1-alpha, 25-dihyd...\", \"schemaClass\": \"Summation\", \"text\": \"The biologically active form of vitamin D, 1-alpha, 25-dihydroxyvitamin D (1,25(OH)2D), can be transported to any target tissue where it enters the nucleoplasm to interact with vitamin D receptor (VDR) to exert its effects. The mechanism of translocation from cytosol to nucleoplasm is unknown (see review for general description - Christakos et al. 2016).\"}]}" ;
