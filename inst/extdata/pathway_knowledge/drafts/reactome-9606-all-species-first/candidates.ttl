3.1\"}], \"output\": [{\"className\": \"Polymer\", \"dbId\": 8876893, \"displayName\": \"Btn-p-S222-ACACB:2Mn2+ polymer [mitochondrial outer membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"Btn-p-S222-ACACB:2Mn2+ polymer\"], \"producedByEvent\": [200423], \"schemaClass\": \"Polymer\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8876893\", \"stIdVersion\": \"R-HSA-8876893.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [200423], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [200423], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 200421, \"displayName\": \"Activation of cytosolic AMPK by phosphorylation\", \"followingEvent\": [200423], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Activation of cytosolic AMPK by phosphorylation\"], \"releaseDate\": \"2010-03-16\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-200421\", \"stIdVersion\": \"R-HSA-200421.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 380930, \"displayName\": \"Phosphorylated AMPK binds AMP\", \"followingEvent\": [200423], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Phosphorylated AMPK binds AMP\"], \"releaseDate\": \"2010-03-16\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-380930\", \"stIdVersion\": \"R-HSA-380930.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2005-09-26\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-200423\", \"stIdVersion\": \"R-HSA-200423.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 201087, \"displayName\": \"Acetyl-CoA carboxylase 2 (ACACB, ACC2) is involved in the re...\", \"schemaClass\": \"Summation\", \"text\": \"Acetyl-CoA carboxylase 2 (ACACB, ACC2) is involved in the regulation of mitochondrial fatty acid oxidation through the inhibition of carnitine palmitoyltransferase 1 by its product malonyl-CoA. Phosphorylated AMPK inactivates ACACB in muscle cells by phosphorylation. This results in decreased levels of malonyl CoA, contributing to the homeostasis of mitochondrial beta oxidation (Ruderman & Prentki 2004).\"}]}" ;
