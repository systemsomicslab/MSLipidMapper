6424], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AWAT1 transfers acyl group from acyl-CoA to ARACOH, forming wax esters\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-5696424\", \"stIdVersion\": \"R-CFA-5696424.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10193317, \"displayName\": \"AWAT1 transfers acyl group from acyl-CoA to ARACOH, forming wax esters\", \"inferredFrom\": [5696424], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AWAT1 transfers acyl group from acyl-CoA to ARACOH, forming wax esters\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5696424\", \"stIdVersion\": \"R-RNO-5696424.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10070067, \"displayName\": \"AWAT1 transfers acyl group from acyl-CoA to ARACOH, forming wax esters\", \"inferredFrom\": [5696424], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AWAT1 transfers acyl group from acyl-CoA to ARACOH, forming wax esters\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-5696424\", \"stIdVersion\": \"R-MMU-5696424.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 5696412, \"displayName\": \"arachidyl ester [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"arachidyl ester\", \"wax ester\"], \"producedByEvent\": [5696424], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5696412\", \"stIdVersion\": \"R-ALL-5696412.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 162743, \"displayName\": \"CoA-SH [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [5696424], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-162743\", \"stIdVersion\": \"R-ALL-162743.6\"}], \"releaseDate\": \"2015-09-22\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5696424\", \"stIdVersion\": \"R-HSA-5696424.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5696423, \"displayName\": \"Arachidyl alcohol (ARACOH) is straight-chain fatty alcohol o...\", \"schemaClass\": \"Summation\", \"text\": \"Arachidyl alcohol (ARACOH) is straight-chain fatty alcohol of C20 length used as an emollient in cosmetics. Esterification of alcohols with fatty acids represents the formation of both storage and cytoprotective molecules in the body. Overproduction of these esters is associated with several disease pathologies, including atherosclerosis and obesity. The ER membrane-associated acyl-CoA wax alcohol acyltransferase 1 (AWAT1) mediates the esterification of its preferred substrate ARACOH (Turkish et al. 2005).\"}]}" ;
