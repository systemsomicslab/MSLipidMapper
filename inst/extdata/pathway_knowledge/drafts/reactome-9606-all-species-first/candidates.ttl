    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [390224], \"className\": \"CatalystActivity\", \"dbId\": 192310, \"displayName\": \"propanoyl-CoA C-acyltransferase activity of SCP2-1 [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9764593, \"displayName\": \"propionyl-CoA C2-trimethyltridecanoyltransferase activity of SCP2-1 [peroxisomal matrix] Mutations in the gene encoding peroxisomal sterol carrier protein X (SCPx) cause leukencephalopathy with dystonia and motor neuropathy\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690231, \"displayName\": \"RHEA:10410\", \"identifier\": \"10410\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/10410\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9914040, \"displayName\": \"RHEA:10410\", \"identifier\": \"10410\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/10410\"}], \"dbId\": 390224, \"displayName\": \"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"followingEvent\": [390284], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [390224], \"dbId\": 389996, \"displayName\": \"3-ketopristanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3-ketopristanoyl-CoA\", \"3-oxopristanoyl-CoA(4-)\", \"3-oxopristanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389996\", \"stIdVersion\": \"R-ALL-389996.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [390224], \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 390220, \"displayName\": \"Mutations in the gene encoding peroxisomal sterol carrier protein X (SCPx) cause leukencephalopathy with dystonia and motor neuropathy\", \"journal\": \"Am J Hum Genet\", \"pages\": \"1046-52\", \"pubMedIdentifier\": 16685654, \"schemaClass\": \"LiteratureReference\", \"title\": \"Mutations in the gene encoding peroxisomal sterol carrier protein X (SCPx) cause leukencephalopathy with dystonia and motor neuropathy\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/16685654\", \"volume\": 78, \"year\": 2006}, {\"className\": \"LiteratureReference\", \"dbId\": 9764596, \"displayName\": \"Sterol carrier protein X (SCPx) is a peroxisomal branched-chain beta-ketothiolase specifically reacting with 3-oxo-pristanoyl-CoA: a new, unique role for SCPx in branched-chain fatty acid metabolism in peroxisomes\", \"journal\": \"Biochem Biophys Res Commun\", \"pages\": \"565-9\", \"pubMedIdentifier\": 9245689, \"schemaClass\": \"LiteratureReference\", \"title\": \"Sterol carrier protein X (SCPx) is a peroxisomal branched-chain beta-ketothiolase specifically reacting with 3-oxo-pristanoyl-CoA: a new, unique role for SCPx in branched-chain fatty acid metabolism in peroxisomes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9245689\", \"volume\": 236, \"year\": 1997}], \"maxDepth\": 1, \"name\": [\"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"3-oxopristanoyl-CoA + CoA => 4,8,12-trimethyltridecanoyl-CoA + propanoyl-CoA\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10857130, \"displayName\": \"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"inferredFrom\": [390224], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"3-oxopristanoyl-CoA + CoA => 4,8,12-trimethyltridecanoyl-CoA + propanoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-390224\", \"stIdVersion\": \"R-DME-390224.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10763284, \"displayName\": \"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"inferredFrom\": [390224], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"3-oxopristanoyl-CoA + CoA => 4,8,12-trimethyltridecanoyl-CoA + propanoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-390224\", \"stIdVersion\": \"R-GGA-390224.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10589546, \"displayName\": \"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"inferredFrom\": [390224], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"3-oxopristanoyl-CoA + CoA => 4,8,12-trimethyltridecanoyl-CoA + propanoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-390224\", \"stIdVersion\": \"R-DRE-390224.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10367127, \"displayName\": \"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"inferredFrom\": [390224], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"3-oxopristanoyl-CoA + CoA => 4,8,12-trimethyltridecanoyl-CoA + propanoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-390224\", \"stIdVersion\": \"R-BTA-390224.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10259352, \"displayName\": \"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"inferredFrom\": [390224], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"3-oxopristanoyl-CoA + CoA => 4,8,12-trimethyltridecanoyl-CoA + propanoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-390224\", \"stIdVersion\": \"R-CFA-390224.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10140941, \"displayName\": \"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"inferredFrom\": [390224], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"3-oxopristanoyl-CoA + CoA => 4,8,12-trimethyltridecanoyl-CoA + propanoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-390224\", \"stIdVersion\": \"R-RNO-390224.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10018801, \"displayName\": \"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"inferredFrom\": [390224], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"3-oxopristanoyl-CoA + CoA => 4,8,12-trimethyltridecanoyl-CoA + propanoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-390224\", \"stIdVersion\": \"R-MMU-390224.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 390002, \"displayName\": \"4,8,12-trimethyltridecanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4,8,12-trimethyltridecanoyl-CoA\", \"4,8,12-trimethyltridecanoyl-CoA(4-)\"], \"producedByEvent\": [390224], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390002\", \"stIdVersion\": \"R-ALL-390002.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 192314, \"displayName\": \"propionyl CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"propionyl CoA\", \"propionyl-CoA(4-)\", \"propionyl-CoA\"], \"producedByEvent\": [390224], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192314\", \"stIdVersion\": \"R-ALL-192314.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 389995, \"displayName\": \"3-hydroxypristanoyl-CoA + NAD+ => 3-ketoxypristanoyl-CoA + NADH + H+\", \"followingEvent\": [390224], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"3-hydroxypristanoyl-CoA + NAD+ => 3-ketoxypristanoyl-CoA + NADH + H+\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-389995\", \"stIdVersion\": \"R-HSA-389995.2\"}], \"releaseDate\": \"2009-04-01\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390224\", \"stIdVersion\": \"R-HSA-390224.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 390226, \"displayName\": \"Peroxisomal SCPx (Non-specific lipid transfer protein; SCP2)...\", \"schemaClass\": \"Summation\", \"text\": \"Peroxisomal SCPx (Non-specific lipid transfer protein; SCP2) catalyzes the reaction of 3-ketopristanoyl-CoA and CoASH to form 4,8,12-trimethyltridecanoyl-CoA and propionyl-CoA. Both intact SCPx and an SCPx fragment corresponding to approximately the 430 aminoterminal residues of the protein are catalytically active in vitro; the latter form may predominate in vivo. Consistent with the role of rat SCPx in the beta-oxidation of branched-chain fatty acids in vitro (Wanders et al. 1997) mutations in the human protein are associated with loss of SCP thiolase activity in cell extracts in vitro, elevated levels of pristanic acid in the blood in vivo and the development of neurological defects (Ferdinandusse et al. 2006).\"}]}" ;
