ferredFrom\": [5334794], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FABPs bind LCFAs\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-5334794\", \"stIdVersion\": \"R-MMU-5334794.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 5334829, \"displayName\": \"FABPs:LCFA [cytosol]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"FABPs:LCFA\"], \"producedByEvent\": [5334794], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5334829\", \"stIdVersion\": \"R-HSA-5334829.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 163595, \"displayName\": \"2-acylglycerol + H2O -> glycerol + fatty acid\", \"followingEvent\": [5334794], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-acylglycerol + H2O -> glycerol + fatty acid\", \"a 2-acylglycerol + H2O => glycerol + a fatty acid + H(+)\"], \"releaseDate\": \"2005-06-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163595\", \"stIdVersion\": \"R-HSA-163595.5\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 163432, \"displayName\": \"cholesterol ester + H2O -> cholesterol + fatty acid\", \"followingEvent\": [5334794], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"cholesterol ester + H2O -> cholesterol + fatty acid\", \"a cholesterol ester + H2O => cholesterol + a fatty acid + H(+)\"], \"releaseDate\": \"2005-06-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163432\", \"stIdVersion\": \"R-HSA-163432.5\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 163402, \"displayName\": \"diacylglycerol + H2O -> 2-acylglycerol + fatty acid\", \"followingEvent\": [5334794], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"diacylglycerol + H2O -> 2-acylglycerol + fatty acid\", \"a 1,2-diacyl-sn-glycerol + H2O => a 2-acylglycerol + a fatty acid + H(+)\"], \"releaseDate\": \"2005-06-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163402\", \"stIdVersion\": \"R-HSA-163402.5\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 163551, \"displayName\": \"triacylglycerol + H2O -> diacylglycerol + fatty acid\", \"followingEvent\": [5334794], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"triacylglycerol + H2O -> diacylglycerol + fatty acid\", \"a triacylglycerol + H2O => a diacylglycerol + a fatty acid + H(+)\"], \"releaseDate\": \"2005-06-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163551\", \"stIdVersion\": \"R-HSA-163551.5\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2015-03-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5334794\", \"stIdVersion\": \"R-HSA-5334794.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5334839, \"displayName\": \"Hydrophobic compounds such as long-chain fatty acids (LCFAs)...\", \"schemaClass\": \"Summation\", \"text\": \"Hydrophobic compounds such as long-chain fatty acids (LCFAs) and their acyl-CoA derivatives (LCFA-CoAs) are involved in important functions within a cell such as membrane substrates, energy sources and signalling molecules. The hydrophobic nature of these compounds makes translocation between different compartments of a cell extremely difficult. Fatty acid-binding proteins (FABPs) are able to bind these hydrophobic compounds with high affinity and transport them through the cytosol for delivery to different organelles within the cell. To date, 9 human FABP-coding genes have been identified (Smathers & Petersen 2011).\"}]}" ;
