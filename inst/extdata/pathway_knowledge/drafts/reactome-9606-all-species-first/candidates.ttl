, \"stId\": \"R-RNO-196060\", \"stIdVersion\": \"R-RNO-196060.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007997, \"displayName\": \"Reduction of isocaproaldehyde to 4-methylpentan-1-ol\", \"inferredFrom\": [196060], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Reduction of isocaproaldehyde to 4-methylpentan-1-ol\", \"isocaproaldehyde + NADPH + H+ => 4-methylpentan-1-ol + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-196060\", \"stIdVersion\": \"R-MMU-196060.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 196066, \"displayName\": \"MePeOH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MePeOH\", \"4-methylpentan-1-ol\", \"isohexyl alcohol\"], \"producedByEvent\": [196060], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-196066\", \"stIdVersion\": \"R-ALL-196066.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [196060], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 196125, \"displayName\": \"Translocation of isocaproaldehyde from the mitochondrial matrix to the cytosol\", \"followingEvent\": [196060], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Translocation of isocaproaldehyde from the mitochondrial matrix to the cytosol\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-196125\", \"stIdVersion\": \"R-HSA-196125.4\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-196060\", \"stIdVersion\": \"R-HSA-196060.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 196087, \"displayName\": \"Isocaproaldehyde is reduced by NADPH + H+ to yield  4-methyl...\", \"schemaClass\": \"Summation\", \"text\": \"Isocaproaldehyde is reduced by NADPH + H+ to yield  4-methylpentan-1-ol and NADP+. This cytosolic reaction is catalyzed by AKR1B1 (aldose reductase). The purified human enzyme has been shown to catalyze this reaction efficiently in vitro; its abundance in adrenal tissue in humans and other mammals and its concordant expression with other enzymes of steroid hormone synthesis are consistent with it performing this role in vivo as well  (Matsuura et al. 1996; Lefrancois-Martinez et al. 2004). The metabolic fate of 4-methylpentan-1-ol is unknown.\"}]}" ;
