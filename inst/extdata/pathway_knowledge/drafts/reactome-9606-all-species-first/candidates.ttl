<https://reactome.org/content/detail/R-HSA-9026901> a mslm:LipidReaction ;
    rdfs:label "GGT transfers GSH to 16S,17S-epoxy-DHA to form PCTR1" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "GSH [cytosol] + 16S,17S-epoxy-DHA [cytosol] => PCTR1 [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9026901], \"className\": \"CatalystActivity\", \"dbId\": 9026925, \"displayName\": \"glutathione transferase activity of GGT [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9026901, \"displayName\": \"GGT transfers GSH to 16S,17S-epoxy-DHA to form PCTR1\", \"followingEvent\": [9026912], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9026901], \"dbId\": 9024873, \"displayName\": \"16S,17S-epoxy-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"16S,17S-epoxy-DHA\", \"(16S,17S)-epoxy-(4Z,7Z,10Z,12E,14E,19Z)-docosahexaenoate\", \"(16S,17S)-epoxy-DHA(1-)\", \"(16S,17S)-epoxy-(4Z,7Z,10Z,12E,14E,19Z)-docosahexaenoic acid\", \"16S,17S-epoxy-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024873\", \"stIdVersion\": \"R-ALL-9024873.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9026901], \"dbId\": 29450, \"displayName\": \"GSH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GSH\", \"glutathionate(1-)\", \"Reduced glutathione\", \"glutathione\", \"5-L-Glutamyl-L-cysteinylglycine\", \"N-(N-gamma-L-Glutamyl-L-cysteinyl)glycine\", \"gamma-L-Glutamyl-L-cysteinyl-glycine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29450\", \"stIdVersion\": \"R-ALL-29450.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9026926, \"displayName\": \"The Protectin PCTR1 Is Produced by Human M2 Macrophages and Enhances Resolution of Infectious Inflammation\", \"journal\": \"Am. J. Pathol.\", \"pages\": \"962-73\", \"pubMedIdentifier\": 26878209, \"schemaClass\": \"LiteratureReference\", \"title\": \"The Protectin PCTR1 Is Produced by Human M2 Macrophages and Enhances Resolution of Infectious Inflammation\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/26878209\", \"volume\": 186, \"year\": 2016}, {\"className\": \"LiteratureReference\", \"dbId\": 9026755, \"displayName\": \"Novel proresolving and tissue-regenerative resolvin and protectin sulfido-conjugated pathways\", \"journal\": \"FASEB J.\", \"pages\": \"2120-36\", \"pubMedIdentifier\": 25713027, \"schemaClass\": \"LiteratureReference\", \"title\": \"Novel proresolving and tissue-regenerative resolvin and protectin sulfido-conjugated pathways\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25713027\", \"volume\": 29, \"year\": 2015}], \"maxDepth\": 1, \"name\": [\"GGT transfers GSH to 16S,17S-epoxy-DHA to form PCTR1\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9026903, \"displayName\": \"PCTR1 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PCTR1\", \"16(S)-glutathionyl-17(R)-hydroxy-(4Z,7Z,10,12,14,19Z)-docosahexaenoate(2-)\", \"PCTR1(2-)\", \"16(S)-glutathionyl-17(R)-hydroxy-(4Z,7Z,10,12,14,19Z)-docosahexaenoic acid\", \"16-glutathionyl, 17-hydroxy-4Z,7Z,10,12,14,19Z-docosahexaenoic acid\", \"protectin conjugate in tissue regeneration 1\"], \"producedByEvent\": [9026901], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9026903\", \"stIdVersion\": \"R-ALL-9026903.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9024881, \"displayName\": \"ALOX15 dehydrogenates 17(S)-Hp-DHA to 16S,17S-epoxy-DHA\", \"followingEvent\": [9026901], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX15 dehydrogenates 17(S)-Hp-DHA to 16S,17S-epoxy-DHA\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9024881\", \"stIdVersion\": \"R-HSA-9024881.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026901\", \"stIdVersion\": \"R-HSA-9026901.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9026929, \"displayName\": \"Human macrophages produce protectin conjugates in tissue reg...\", \"schemaClass\": \"Summation\", \"text\": \"Human macrophages produce protectin conjugates in tissue regeneration (PCTR). PCTR are named as such because they share a proposed biosynthetic pathway, structural features, and biological actions with DHA-derived protectins as well as displaying potent tissue-regenerative actions. 16S,17S-epoxy-docosahexaenoic acid (16S,17S-epoxy-DHA) was found to be a substrate for a glutathione transferase (GGT) which produces PCTR1 (16-glutathionyl, 17-hydroxy-docosahexaenoic acid) in greater quantities in M2-type macrophages than M1-type macrophages and was found to enhance resolution of infectious inflammation (Ramon et al. 2016, Dalli et al. 2015).\"}]}" ;
