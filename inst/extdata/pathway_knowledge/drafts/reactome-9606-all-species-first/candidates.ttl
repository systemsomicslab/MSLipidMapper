O-199456\", \"stIdVersion\": \"R-RNO-199456.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 179856, \"displayName\": \"PI(4,5)P2 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2\", \"1-phosphatidyl-1D-myo-inositol 4,5-bisphosphate(5-)\", \"PIP2\", \"1-phosphatidyl-1D-myo-inositol 4,5-bisphosphate\", \"Phosphatidylinositol-4,5-bisphosphate\", \"1-phosphatidyl-1D-myo-inositol 4,5- bisphosphate\"], \"producedByEvent\": [199456], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-179856\", \"stIdVersion\": \"R-ALL-179856.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [199456], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"uncertain\", \"className\": \"Reaction\", \"dbId\": 198266, \"displayName\": \"PI3K produces PIP3 and other phosphatidyl inositides\", \"followingEvent\": [199456], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI3K produces PIP3 and other phosphatidyl inositides\"], \"releaseDate\": \"2008-03-12\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-198266\", \"stIdVersion\": \"R-HSA-198266.6\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676048, \"displayName\": \"PI(4,5)P2 is phosphorylated to PI(3,4,5)P3 by PIK3C[1] at the plasma membrane\", \"followingEvent\": [199456], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2 is phosphorylated to PI(3,4,5)P3 by PIK3C[1] at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676048\", \"stIdVersion\": \"R-HSA-1676048.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1675773, \"displayName\": \"PI(3,4)P2 is phosphorylated to PI(3,4,5)P3 by PIP5K1A-C at the plasma membrane\", \"followingEvent\": [199456], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2 is phosphorylated to PI(3,4,5)P3 by PIP5K1A-C at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675773\", \"stIdVersion\": \"R-HSA-1675773.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2316434, \"displayName\": \"PI3K phosphorylates PIP2 to PIP3\", \"followingEvent\": [199456], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI3K phosphorylates PIP2 to PIP3\"], \"releaseDate\": \"2012-09-18\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2316434\", \"stIdVersion\": \"R-HSA-2316434.9\"}, {\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 2321904, \"displayName\": \"PTEN mRNA translation negatively regulated by microRNAs\", \"followingEvent\": [199456], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PTEN mRNA translation negatively regulated by microRNAs\"], \"releaseDate\": \"2012-09-18\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2321904\", \"stIdVersion\": \"R-HSA-2321904.5\"}, {\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 8944497, \"displayName\": \"PTEN mRNA translation is negatively regulated by microRNAs\", \"followingEvent\": [199456], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PTEN mRNA translation is negatively regulated by microRNAs\"], \"releaseDate\": \"2017-06-12\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8944497\", \"stIdVersion\": \"R-HSA-8944497.5\"}], \"releaseDate\": \"2008-03-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-199456\", \"stIdVersion\": \"R-HSA-199456.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 199419, \"displayName\": \"At the plasma membrane, phosphatidylinositol-3,4,5-trisphosp...\", \"schemaClass\": \"Summation\", \"text\": \"At the plasma membrane, phosphatidylinositol-3,4,5-trisphosphate 3-phosphatase and dual-specificity protein phosphatase aka phosphatase and tensin homolog (PTEN) dephosphorylates phosphatidylinositol 3,4,5-trisphosphate (PI(3,4,5)P3) to phosphatidylinositol 4,5-bisphosphate (PI(4,5)P2) (Maehama & Dixon 1998, Myers et al. 1998, Das et al. 2003). The PI3K network is negatively regulated by phospholipid phosphatases that dephosphorylate PIP3, thus hampering AKT activation (Myers et al. 1998). The tumour suppressor PTEN is the primary phospholipid phosphatase.<br>Early studies indicated that magnesium ion, Mg2+, was needed for the catalytic activity of PTEN isolated from bovine thymus (Kabuyama et al. 1996). Subsequent studies have shown that PTEN was catalytically active in buffers free of magnesium and magnesium was not detected as part of the PTEN crystal (Lee et al. 1999). \"}]}" ;
