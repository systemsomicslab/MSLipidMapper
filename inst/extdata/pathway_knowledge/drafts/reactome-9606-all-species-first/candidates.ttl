e\": [\"PGH2 is reduced to PGF2a by AKR1C3\", \"H(+) + NADPH + prostaglandin H2 => NADP(+) + prostaglandin F2alpha\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-2161549\", \"stIdVersion\": \"R-BTA-2161549.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10283440, \"displayName\": \"PGH2 is reduced to PGF2a by AKR1C3\", \"inferredFrom\": [2161549], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PGH2 is reduced to PGF2a by AKR1C3\", \"H(+) + NADPH + prostaglandin H2 => NADP(+) + prostaglandin F2alpha\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-2161549\", \"stIdVersion\": \"R-CFA-2161549.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10170338, \"displayName\": \"PGH2 is reduced to PGF2a by AKR1C3\", \"inferredFrom\": [2161549], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PGH2 is reduced to PGF2a by AKR1C3\", \"H(+) + NADPH + prostaglandin H2 => NADP(+) + prostaglandin F2alpha\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-2161549\", \"stIdVersion\": \"R-RNO-2161549.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10048449, \"displayName\": \"PGH2 is reduced to PGF2a by AKR1C3\", \"inferredFrom\": [2161549], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PGH2 is reduced to PGF2a by AKR1C3\", \"H(+) + NADPH + prostaglandin H2 => NADP(+) + prostaglandin F2alpha\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2161549\", \"stIdVersion\": \"R-MMU-2161549.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 879535, \"displayName\": \"PGF2a [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGF2a\", \"prostaglandin F2alpha(1-)\", \"prostaglandin F2alpha\"], \"producedByEvent\": [2161549], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-879535\", \"stIdVersion\": \"R-ALL-879535.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [2161549], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"uncertain\", \"className\": \"Reaction\", \"dbId\": 2299725, \"displayName\": \"PGH2 diffuses from the endoplasmic reticulum lumen to the cytosol\", \"followingEvent\": [2161549], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PGH2 diffuses from the endoplasmic reticulum lumen to the cytosol\"], \"releaseDate\": \"2012-12-04\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2299725\", \"stIdVersion\": \"R-HSA-2299725.4\"}], \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161549\", \"stIdVersion\": \"R-HSA-2161549.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2161555, \"displayName\": \"Aldo-keto reductase family 1 member C3 (AKR1C3) aka PGFS is ...\", \"schemaClass\": \"Summation\", \"text\": \"Aldo-keto reductase family 1 member C3 (AKR1C3) aka PGFS is responsible for the reduction of prostaglandin H2 (PGH2) to prostaglandin F2alpha (PGF2a) (Suzuki-Yamamoto et al. 1999, Komoto et al. 2004, Komoto et al. 2006).  There is an additional way of achieving this reaction involving the prostamide/prostaglandin F synthase, FAM213B and thioredoxin (TRX).\"}]}" ;
