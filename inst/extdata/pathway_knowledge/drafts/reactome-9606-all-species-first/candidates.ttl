xDepth\": 1, \"name\": [\"EHHADH dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"3-hydroxyhexacosanoyl-CoA + NAD+ => 3-ketohexacosanoyl-CoA + NADH + H+ (EHHADH)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-6809264\", \"stIdVersion\": \"R-DRE-6809264.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10537715, \"displayName\": \"EHHADH dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"inferredFrom\": [6809264], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"EHHADH dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"3-hydroxyhexacosanoyl-CoA + NAD+ => 3-ketohexacosanoyl-CoA + NADH + H+ (EHHADH)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-6809264\", \"stIdVersion\": \"R-SSC-6809264.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10423811, \"displayName\": \"EHHADH dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"inferredFrom\": [6809264], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"EHHADH dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"3-hydroxyhexacosanoyl-CoA + NAD+ => 3-ketohexacosanoyl-CoA + NADH + H+ (EHHADH)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-6809264\", \"stIdVersion\": \"R-BTA-6809264.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10311104, \"displayName\": \"EHHADH dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"inferredFrom\": [6809264], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"EHHADH dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"3-hydroxyhexacosanoyl-CoA + NAD+ => 3-ketohexacosanoyl-CoA + NADH + H+ (EHHADH)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-6809264\", \"stIdVersion\": \"R-CFA-6809264.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10078006, \"displayName\": \"EHHADH dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"inferredFrom\": [6809264], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"EHHADH dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"3-hydroxyhexacosanoyl-CoA + NAD+ => 3-ketohexacosanoyl-CoA + NADH + H+ (EHHADH)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6809264\", \"stIdVersion\": \"R-MMU-6809264.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 390241, \"displayName\": \"3-ketohexacosanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3-ketohexacosanoyl-CoA\", \"3-oxohexacosanoyl-CoA(4-)\", \"3-oxohexacosanoyl-CoA\"], \"producedByEvent\": [6809264], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390241\", \"stIdVersion\": \"R-ALL-390241.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 192305, \"displayName\": \"NADH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [6809264], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192305\", \"stIdVersion\": \"R-ALL-192305.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [6809264], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 6809263, \"displayName\": \"EHHADH hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"followingEvent\": [6809264], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"EHHADH hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"(2E)-hexacosenoyl-CoA + H2O => (3R)-hydroxyhexacosanoyl-CoA\", \"trans-2,3-dehydrohexacosanoyl-CoA + H2O => 3-hydroxyhexacosanoyl-CoA (EHHADH)\"], \"releaseDate\": \"2016-03-23\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6809263\", \"stIdVersion\": \"R-HSA-6809263.3\"}], \"releaseDate\": \"2009-04-01\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6809264\", \"stIdVersion\": \"R-HSA-6809264.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6809269, \"displayName\": \"Peroxisomal EHHADH catalyzes the reaction of 3-hydroxyhexaco...\", \"schemaClass\": \"Summation\", \"text\": \"Peroxisomal EHHADH catalyzes the reaction of 3-hydroxyhexacosanoyl-CoA and NAD+ to form 3-ketohexacosanoyl-CoA and NADH + H+. The enzyme is bifunctional - an aminoterminal domain catalyzes the dehydrogenation of a variety of 3-hydroxyacyl-CoA's, the reaction annotated here, and a carboxyterminal domain catalyzes the hydration of a variety of trans-2,3-dehydroacyl-CoA's. The properties of the human enzyme are inferred from studies of its mouse and rat homologues and from enzymatic studies of mutant yeast cells expressing the cloned human enzyme (Chen et al. 1991, Ferdinandusse et al. 2004; Houten et al. 2012; Lalwani et al. 1981; Osumi & Hashimoto 1979). The enzyme can also act on fatty dicarboxylic acids (not annotated here) (Houten et al, 2012).\"}]}" ;
