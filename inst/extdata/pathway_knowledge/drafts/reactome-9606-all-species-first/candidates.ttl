0071870, \"displayName\": \"HAO2 tetramer oxidises 2OH-PALM\", \"inferredFrom\": [6787811], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HAO2 tetramer oxidises 2OH-PALM\", \"2-hydroxyhexadecanoate + O2 => 2-oxohexadecanoate + H2O2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6787811\", \"stIdVersion\": \"R-MMU-6787811.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 6787814, \"displayName\": \"2oxo-PALM [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2oxo-PALM\", \"2-oxohexadecanoate\", \"2-oxopalmitic acid\", \"2-oxohexadecanoic acid\"], \"producedByEvent\": [6787811], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6787814\", \"stIdVersion\": \"R-ALL-6787814.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113575, \"displayName\": \"H2O2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O2\", \"hydrogen peroxide\"], \"producedByEvent\": [6787811], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113575\", \"stIdVersion\": \"R-ALL-113575.3\"}], \"releaseDate\": \"2015-12-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6787811\", \"stIdVersion\": \"R-HSA-6787811.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6787815, \"displayName\": \"Fatty acids can be metabolised by two distinct pathways; alp...\", \"schemaClass\": \"Summation\", \"text\": \"Fatty acids can be metabolised by two distinct pathways; alpha- and beta-oxidation. Peroxisomal hydroxyacid oxidase 2 (HAO2) is thought to take part in alpha-oxidation of long chain fatty acids such as 2-hydroxypalmitate (2OH-PALM).  HAO2 functions as a homotetramer and is highly expressed in liver and kidney (Jones et al. 2000).\"}]}" ;
