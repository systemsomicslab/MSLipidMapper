on\", \"className\": \"Reaction\", \"dbId\": 10681234, \"displayName\": \"ACER2 hydrolyzes ceramide (Golgi)\", \"inferredFrom\": [428205], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACER2 hydrolyzes ceramide (Golgi)\", \"ceramide + H2O => fatty acid + sphingosine (Golgi)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-428205\", \"stIdVersion\": \"R-XTR-428205.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10592072, \"displayName\": \"ACER2 hydrolyzes ceramide (Golgi)\", \"inferredFrom\": [428205], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACER2 hydrolyzes ceramide (Golgi)\", \"ceramide + H2O => fatty acid + sphingosine (Golgi)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-428205\", \"stIdVersion\": \"R-DRE-428205.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10484441, \"displayName\": \"ACER2 hydrolyzes ceramide (Golgi)\", \"inferredFrom\": [428205], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACER2 hydrolyzes ceramide (Golgi)\", \"ceramide + H2O => fatty acid + sphingosine (Golgi)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-428205\", \"stIdVersion\": \"R-SSC-428205.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10370117, \"displayName\": \"ACER2 hydrolyzes ceramide (Golgi)\", \"inferredFrom\": [428205], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACER2 hydrolyzes ceramide (Golgi)\", \"ceramide + H2O => fatty acid + sphingosine (Golgi)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-428205\", \"stIdVersion\": \"R-BTA-428205.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10144578, \"displayName\": \"ACER2 hydrolyzes ceramide (Golgi)\", \"inferredFrom\": [428205], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACER2 hydrolyzes ceramide (Golgi)\", \"ceramide + H2O => fatty acid + sphingosine (Golgi)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-428205\", \"stIdVersion\": \"R-RNO-428205.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10021663, \"displayName\": \"ACER2 hydrolyzes ceramide (Golgi)\", \"inferredFrom\": [428205], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACER2 hydrolyzes ceramide (Golgi)\", \"ceramide + H2O => fatty acid + sphingosine (Golgi)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-428205\", \"stIdVersion\": \"R-MMU-428205.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1861754, \"displayName\": \"RCOO- [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"RCOO-\", \"fatty acid anion\", \"carboxylate\", \"carboxylic acid\"], \"producedByEvent\": [428205], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1861754\", \"stIdVersion\": \"R-ALL-1861754.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 428682, \"displayName\": \"SPG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SPG\", \"sphingoid base(1+)\", \"sphingosine\"], \"producedByEvent\": [428205], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428682\", \"stIdVersion\": \"R-ALL-428682.6\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9956909, \"displayName\": \"CERT1-2 transfers CERA from the ER membrane to the Golgi membrane\", \"followingEvent\": [428205], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CERT1-2 transfers CERA from the ER membrane to the Golgi membrane\"], \"releaseDate\": \"2025-09-18\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9956909\", \"stIdVersion\": \"R-HSA-9956909.1\"}], \"releaseDate\": \"2009-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428205\", \"stIdVersion\": \"R-HSA-428205.6\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 428243, \"displayName\": \"ACER2 (alkaline ceramidase 2), associated with the membrane ...\", \"schemaClass\": \"Summation\", \"text\": \"ACER2 (alkaline ceramidase 2), associated with the membrane of the Golgi apparatus, catalyzes the hydrolysis of ceramide to yield a free fatty acid and sphingosine. ACER2 hydrolyses ceramides and dihydroceramides C18:1 and C20:1 (Casasampere et al., 2015). ACER2 mRNA is widely expressed in the body, although only at low levels except in the placenta (Xu et al., 2006; Sun et al., 2010; Xu et al., 2018). ACER2 expression is regulated by the tumor suppressor p53 and endothelial PAS domain-containing protein 1 (EPAS1, hypoxia-inducible factor HIF2A) (reviewed by Mao & Obeid, 2008; Parveen et al., 2019; Duarte et al., 2020).\"}]}" ;
