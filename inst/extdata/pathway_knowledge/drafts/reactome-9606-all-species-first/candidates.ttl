    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [192157], \"className\": \"CatalystActivity\", \"dbId\": 192125, \"displayName\": \"sterol 12-alpha-hydroxylase activity of CYP8B1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9907725, \"displayName\": \"RHEA:46753\", \"identifier\": \"46753\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/46753\"}], \"dbId\": 192157, \"displayName\": \"CYP8B1 12-hydroxylates 4CHOL7aOLONE\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [192157], \"dbId\": 192136, \"displayName\": \"4CHOL7aOLONE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4CHOL7aOLONE\", \"7alpha-hydroxycholest-4-en-3-one\", \"4-cholesten-7alpha-ol-3-one\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192136\", \"stIdVersion\": \"R-ALL-192136.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [192157], \"dbI