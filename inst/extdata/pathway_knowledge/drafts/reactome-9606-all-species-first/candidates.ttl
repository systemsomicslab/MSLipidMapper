e\": \"LiteratureReference\", \"dbId\": 8873816, \"displayName\": \"STARD5 specific ligand binding: comparison with STARD1 and STARD4 subfamilies\", \"journal\": \"Mol. Cell. Endocrinol.\", \"pages\": \"20-5\", \"pubMedIdentifier\": 23337244, \"schemaClass\": \"LiteratureReference\", \"title\": \"STARD5 specific ligand binding: comparison with STARD1 and STARD4 subfamilies\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/23337244\", \"volume\": 371, \"year\": 2013}, {\"className\": \"LiteratureReference\", \"dbId\": 8873877, \"displayName\": \"StAR-related lipid transfer domain protein 5 binds primary bile acids\", \"journal\": \"J. Lipid Res.\", \"pages\": \"2677-89\", \"pubMedIdentifier\": 23018617, \"schemaClass\": \"LiteratureReference\", \"title\": \"StAR-related lipid transfer domain protein 5 binds primary bile acids\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/23018617\", \"volume\": 53, \"year\": 2012}], \"maxDepth\": 1, \"name\": [\"STARD5 binds DCA, LCA\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10990368, \"displayName\": \"STARD5 binds DCA, LCA\", \"inferredFrom\": [8873850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD5 binds DCA, LCA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-8873850\", \"stIdVersion\": \"R-CEL-8873850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10815777, \"displayName\": \"STARD5 binds DCA, LCA\", \"inferredFrom\": [8873850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD5 binds DCA, LCA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-8873850\", \"stIdVersion\": \"R-GGA-8873850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10722035, \"displayName\": \"STARD5 binds DCA, LCA\", \"inferredFrom\": [8873850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD5 binds DCA, LCA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8873850\", \"stIdVersion\": \"R-XTR-8873850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10543775, \"displayName\": \"STARD5 binds DCA, LCA\", \"inferredFrom\": [8873850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD5 binds DCA, LCA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8873850\", \"stIdVersion\": \"R-SSC-8873850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10430056, \"displayName\": \"STARD5 binds DCA, LCA\", \"inferredFrom\": [8873850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD5 binds DCA, LCA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8873850\", \"stIdVersion\": \"R-BTA-8873850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10316573, \"displayName\": \"STARD5 binds DCA, LCA\", \"inferredFrom\": [8873850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD5 binds DCA, LCA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8873850\", \"stIdVersion\": \"R-CFA-8873850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10208106, \"displayName\": \"STARD5 binds DCA, LCA\", \"inferredFrom\": [8873850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD5 binds DCA, LCA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8873850\", \"stIdVersion\": \"R-RNO-8873850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10085115, \"displayName\": \"STARD5 binds DCA, LCA\", \"inferredFrom\": [8873850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD5 binds DCA, LCA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8873850\", \"stIdVersion\": \"R-MMU-8873850.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 8873894, \"displayName\": \"STARD5:DCA/LCA [cytosol]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"STARD5:DCA/LCA\"], \"producedByEvent\": [8873850], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8873894\", \"stIdVersion\": \"R-HSA-8873894.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8873850\", \"stIdVersion\": \"R-HSA-8873850.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8873798, \"displayName\": \"StAR-related lipid transfer protein 5 (STARD5) binds a molec...\", \"schemaClass\": \"Summation\", \"text\": \"StAR-related lipid transfer protein 5 (STARD5) binds a molecule of  deoxycholate (DCA) or lithocholate (LCA).<br>STARD5 is highly expressed in at least three cell types targeted by bile acids: liver macrophage Kupffer cells, peripheral macrophages and kidney proximal tubule cells. Unlike members 4 and 6 of the STARD subfamily of START-containing proteins, STARD5 has low or no affinity for cholesterol but instead, specifically binds primary and secondary bile acids. STARD5's affinity for the secondary bile acids deoxycholic acid (DCA) and lithocholic acid (LCA), which lack the alpha-OH in C7, is greater than that of the primary bile acids cholic acid (CA) and chenodeoxycholic acid (CDCA) (Letourneau et al. 2012, Letourneau et al. 2013). The physiological roles played by STARD5 remain to be elucidated but it could act as a bile acid transporter or sensor.\"}]}" ;
