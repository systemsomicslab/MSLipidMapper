69\", \"stIdVersion\": \"R-BTA-194669.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10249083, \"displayName\": \"4-methylcholesta-8(9),24-dien-3beta-ol is oxidized to 4-carboxycholesta-8(9),24-dien-3beta-ol\", \"inferredFrom\": [194669], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4-methylcholesta-8(9),24-dien-3beta-ol is oxidized to 4-carboxycholesta-8(9),24-dien-3beta-ol\", \"4alpha-methylzymosterol + 6 Fe(II)-(cytochrome b5) + 3 O2 + 5 H(+) => 4alpha-carboxyzymosterol + 6 Fe(III)-(cytochrome b5) + 4 H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-194669\", \"stIdVersion\": \"R-CFA-194669.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10128873, \"displayName\": \"4-methylcholesta-8(9),24-dien-3beta-ol is oxidized to 4-carboxycholesta-8(9),24-dien-3beta-ol\", \"inferredFrom\": [194669], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4-methylcholesta-8(9),24-dien-3beta-ol is oxidized to 4-carboxycholesta-8(9),24-dien-3beta-ol\", \"4alpha-methylzymosterol + 6 Fe(II)-(cytochrome b5) + 3 O2 + 5 H(+) => 4alpha-carboxyzymosterol + 6 Fe(III)-(cytochrome b5) + 4 H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-194669\", \"stIdVersion\": \"R-RNO-194669.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007839, \"displayName\": \"4-methylcholesta-8(9),24-dien-3beta-ol is oxidized to 4-carboxycholesta-8(9),24-dien-3beta-ol\", \"inferredFrom\": [194669], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4-methylcholesta-8(9),24-dien-3beta-ol is oxidized to 4-carboxycholesta-8(9),24-dien-3beta-ol\", \"4alpha-methylzymosterol + 6 Fe(II)-(cytochrome b5) + 3 O2 + 5 H(+) => 4alpha-carboxyzymosterol + 6 Fe(III)-(cytochrome b5) + 4 H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-194669\", \"stIdVersion\": \"R-MMU-194669.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 194657, \"displayName\": \"4CZYMOL [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4CZYMOL\", \"4alpha-carboxyzymosterol(1-)\", \"4-carboxycholesta-8(9),24-dien-3beta-ol\", \"4-carboxyzymosterol\"], \"producedByEvent\": [194669], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194657\", \"stIdVersion\": \"R-ALL-194657.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [194669, 194669, 194669, 194669], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356, 29356, 29356, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [194669, 194669, 194669], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}, 29366, 29366], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 194689, \"displayName\": \"4-methylcholesta-8(9),24-dien-3-one is reduced to 4-methylcholesta-8(9),24-dien-3beta-ol\", \"followingEvent\": [194669], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"4-methylcholesta-8(9),24-dien-3-one is reduced to 4-methylcholesta-8(9),24-dien-3beta-ol\", \"4alpha-methylzymosterol + NADP(+) => 3-dehydro-4alpha-methylzymosterol + NADPH + H(+)\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194689\", \"stIdVersion\": \"R-HSA-194689.3\"}], \"releaseDate\": \"2007-02-20\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194669\", \"stIdVersion\": \"R-HSA-194669.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 194675, \"displayName\": \"4-methylcholesta-8(9),24-dien-3beta-ol, NADPH + H+, and O2 r...\", \"schemaClass\": \"Summation\", \"text\": \"4-methylcholesta-8(9),24-dien-3beta-ol, NADPH + H+, and O2 react to form 4-carboxycholesta-8(9),24-dien-3beta-ol, NADP+, and H2O. This reaction, in the endoplasmic reticulum, is catalyzed by SC4MOL (C-4 methylsterol oxidase). The human enzyme has been identified based on its sequence similarity to yeast methyl sterol oxidase (ERG25) and the ability of the cloned human gene to rescue ERG25-deficient yeast cells (Li and Kaplan 1996). The mechanism and stoichiometry of the reaction have been inferred from studies of partially purified rat enzyme (Gaylor et al. 1975; Fukushima et al. 1981).\"}]}" ;
