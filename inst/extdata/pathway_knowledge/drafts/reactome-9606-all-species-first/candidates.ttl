3, \"displayName\": \"SPHK1 phosphorylates sphingoid\", \"followingEvent\": [9843721], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SPHK1 phosphorylates sphingoid\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428273\", \"stIdVersion\": \"R-HSA-428273.5\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9695949, \"displayName\": \"SPHK2 phosphorylates sphingoid\", \"followingEvent\": [9843721], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SPHK2 phosphorylates sphingoid\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9695949\", \"stIdVersion\": \"R-HSA-9695949.4\"}], \"releaseDate\": \"2023-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9843721\", \"stIdVersion\": \"R-HSA-9843721.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9843729, \"displayName\": \"The proton pumps ABCC1, ABCG2 transport sphing-4-enine 1-pho...\", \"schemaClass\": \"Summation\", \"text\": \"The proton pumps ABCC1, ABCG2 transport sphing-4-enine 1-phosphate (sphingosine-1-phosphate, C18-S1P) out of cells. ABCC1 is mainly expressed in mast cells, fibroblasts, and endothelial cells (Mitra et al., 2006; Nieuwenhuis et al., 2009). Export of C18-S1P by ABCG2 has been shown in MCF-7 epithelial cells (Takabe et al., 2010). These processes support a role of C18-S1P secretion in mast cell migration, cytoprotection, maintenance of epithelial barriers, and cancer/multidrug resistance (reviewed by Reitsema et al., 2014).\"}]}" ;
