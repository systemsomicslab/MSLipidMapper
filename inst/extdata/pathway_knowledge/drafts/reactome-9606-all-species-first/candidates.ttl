: \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-266072\", \"stIdVersion\": \"R-MMU-266072.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 266056, \"displayName\": \"LTB4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LTB4\", \"leukotriene B4(1-)\", \"leukotriene B4\"], \"producedByEvent\": [266072], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-266056\", \"stIdVersion\": \"R-ALL-266056.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 266051, \"displayName\": \"5S-HpETE is dehydrated to LTA4 by ALOX5\", \"followingEvent\": [266072], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"5S-HpETE is dehydrated to LTA4 by ALOX5\", \"(5S)-hydroperoxy-(6E,8Z,11Z,14Z)-eicosatetraenoate => H2O + leukotriene A4\", \"Dehydration of 5-HpETE to leukotriene A4\"], \"releaseDate\": \"2008-12-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-266051\", \"stIdVersion\": \"R-HSA-266051.4\"}], \"releaseDate\": \"2008-12-17\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-266072\", \"stIdVersion\": \"R-HSA-266072.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 266075, \"displayName\": \"Leukotriene A4 hydrolase (LTA4H) is a monomeric, soluble enz...\", \"schemaClass\": \"Summation\", \"text\": \"Leukotriene A4 hydrolase (LTA4H) is a monomeric, soluble enzyme that catalyzes the hydrolysis of the allylic epoxide leukotriene A4 (LTA4) to the dihydroxy acid leukotriene B4 (LTB4) (Radmark et al. 1984, McGee & Fitzpatrick 1985).\"}]}" ;
