sInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCLL1:Mg2+ cleaves bHMG-CoA to Ac-CoA and ACA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-6788597\", \"stIdVersion\": \"R-SSC-6788597.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10417619, \"displayName\": \"HMGCLL1:Mg2+ cleaves bHMG-CoA to Ac-CoA and ACA\", \"inferredFrom\": [6788597], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCLL1:Mg2+ cleaves bHMG-CoA to Ac-CoA and ACA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-6788597\", \"stIdVersion\": \"R-BTA-6788597.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10305464, \"displayName\": \"HMGCLL1:Mg2+ cleaves bHMG-CoA to Ac-CoA and ACA\", \"inferredFrom\": [6788597], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCLL1:Mg2+ cleaves bHMG-CoA to Ac-CoA and ACA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-6788597\", \"stIdVersion\": \"R-CFA-6788597.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10195238, \"displayName\": \"HMGCLL1:Mg2+ cleaves bHMG-CoA to Ac-CoA and ACA\", \"inferredFrom\": [6788597], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCLL1:Mg2+ cleaves bHMG-CoA to Ac-CoA and ACA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-6788597\", \"stIdVersion\": \"R-RNO-6788597.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10071934, \"displayName\": \"HMGCLL1:Mg2+ cleaves bHMG-CoA to Ac-CoA and ACA\", \"inferredFrom\": [6788597], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCLL1:Mg2+ cleaves bHMG-CoA to Ac-CoA and ACA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6788597\", \"stIdVersion\": \"R-MMU-6788597.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 76183, \"displayName\": \"Ac-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ac-CoA\", \"acetyl-CoA(4-)\", \"Acetyl coenzyme A\", \"acetyl-CoA\"], \"producedByEvent\": [6788597], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76183\", \"stIdVersion\": \"R-ALL-76183.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29666, \"displayName\": \"ACA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ACA\", \"acetoacetate\", \"3-Oxobutanoate\"], \"producedByEvent\": [6788597], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29666\", \"stIdVersion\": \"R-ALL-29666.4\"}], \"releaseDate\": \"2015-12-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6788597\", \"stIdVersion\": \"R-HSA-6788597.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6788598, \"displayName\": \"3-hydroxy-3-methylglutaryl CoA lyase (HMGCL) catalyses the c...\", \"schemaClass\": \"Summation\", \"text\": \"3-hydroxy-3-methylglutaryl CoA lyase (HMGCL) catalyses the cleavage of beta-hydroxy-3-methylglutaryl CoA (bHMG-CoA) to acetoacetate (ACA) and acetyl-CoA (Ac-CoA). This reaction is the common final step in ketogenesis and leucine catabolism. HMGCL isoforms are usually located to the mitochondrial matrix or peroxisomes. The mitochondrial isoform contributes to ketone body production whereas the function of the peroxisomal form is unclear. Another isoform has recently been discovered, (HMGCLL1) which is expressed mainly in liver, lung, kidney and brain and has a dual location of ER and cytosolic cellular compartments. The metabolic function of HMGCLL1 is unknown but could provide support for energy production in the tissues mentioned above (Montgomery et al. 2012, Arnedo et al. 2012).\"}]}" ;
