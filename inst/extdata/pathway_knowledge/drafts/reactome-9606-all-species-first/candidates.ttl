<https://reactome.org/content/detail/R-HSA-163539> a mslm:LipidReaction ;
    rdfs:label "perilipin:ABHD5 complex -> perilipin + ABHD5" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "perilipin:ABHD5 complex [lipid droplet] => PLIN1 [lipid droplet] + ABHD5 [cytosol]" ;
    mslm:evidenceJson "{\"category\": \"dissociation\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005811\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13977, \"definition\": \"An intracellular non-membrane-bounded organelle comprising a matrix of coalesced lipids surrounded by a phospholipid monolayer. May include associated proteins.\", \"displayName\": \"lipid droplet\", \"name\": \"lipid droplet\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005811\"}], \"dbId\": 163539, \"displayName\": \"perilipin:ABHD5 complex -> perilipin + ABHD5\", \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [163539], \"dbId\": 163495, \"displayName\": \"perilipin:ABHD5 complex [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"perilipin:ABHD5 complex\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163495\", \"stIdVersion\": \"R-HSA-163495.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"perilipin:ABHD5 complex -> perilipin + ABHD5\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 163531, \"displayName\": \"ABHD5 [cytosol]\", \"endCoordinate\": 349, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ABHD5\", \"CGI-58\", \"abhydrolase domain containing 5\"], \"producedByEvent\": [163539], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163531\", \"stIdVersion\": \"R-HSA-163531.1\", \"startCoordinate\": 1}, {\"className\": \"Protein\", \"dbId\": 163460, \"displayName\": \"PLIN1 [lipid droplet]\", \"endCoordinate\": 522, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PLIN1\", \"perilipin\", \"PLIN\"], \"producedByEvent\": [163539], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163460\", \"stIdVersion\": \"R-HSA-163460.2\", \"startCoordinate\": 1}], \"releaseDate\": \"2005-06-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163539\", \"stIdVersion\": \"R-HSA-163539.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 163541, \"displayName\": \"In unstimulated mouse 3T3-L1 adipocytes, perilipin (PLIN1) i...\", \"schemaClass\": \"Summation\", \"text\": \"In unstimulated mouse 3T3-L1 adipocytes, perilipin (PLIN1) is localized to the surfaces of cytosolic lipid particles as a complex with ABHD5 (1-acylglycerol-3-phosphate O-acyltransferase, also known as CGI-58). Catecholamine stimulation (and by inference glucagon stimulation) is associated with rapid dissociation of the complex and relocalization of the ABHD5 protein away from the lipid particle. The stoichiometry of the complex is unknown. Dissociation of the PLIN1:ABHD5 complex appears to precede PLIN1 phosphorylation, although the molecular link between these two steps is unknown (Subramanian et al. 2004).<p>The interaction of human ABHD5 and PLIN1 on the lipid particle surface has not been studied in detail, so the human reaction is inferred from the well-studied mouse one. The observation that humans homozygous for ABHD5 mutations suffer from Chanarin-Dorfman Syndrome, characterized by the abnormal accumulation of triacylglycerol droplets in most tissues (Lefevre et al. 2001), provides indirect evidence that human and mouse ABHD5 proteins have similar functions.\"}]}" ;
