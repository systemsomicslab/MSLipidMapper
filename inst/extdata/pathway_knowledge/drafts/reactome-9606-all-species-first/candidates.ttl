<https://reactome.org/content/detail/R-HSA-193996> a mslm:LipidReaction ;
    rdfs:label "11DCORST translocates from cytosol to mitochondrial matrix" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "11DCORST [cytosol] => 11DCORST [mitochondrial matrix]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 193996, \"displayName\": \"11DCORST translocates from cytosol to mitochondrial matrix\", \"followingEvent\": [194017], \"goBiologicalProcess\": {\"accession\": \"0170036\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 9910499, \"definition\": \"The directed movement of substances from the cytosol into the mitochondrion.\", \"displayName\": \"import into the mitochondrion\", \"name\": \"import into the mitochondrion\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0170036\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193996], \"dbId\": 194037, \"displayName\": \"11DCORST [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"11DCORST\", \"11-deoxycorticosterone\", \"cortexone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194037\", \"stIdVersion\": \"R-ALL-194037.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 193094, \"displayName\": \"Overview of steroidogenic enzymes in the pathway from cholesterol to active steroid hormones\", \"journal\": \"Endocr Rev\", \"pages\": \"947-70\", \"pubMedIdentifier\": 15583024, \"schemaClass\": \"LiteratureReference\", \"title\": \"Overview of steroidogenic enzymes in the pathway from cholesterol to active steroid hormones\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15583024\", \"volume\": 25, \"year\": 2004}], \"maxDepth\": 1, \"name\": [\"11DCORST translocates from cytosol to mitochondrial matrix\", \"11-deoxycorticosterone translocates from the cytosol to the mitochondrial matrix\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193988, \"displayName\": \"11DCORST [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"11DCORST\", \"11-deoxycorticosterone\", \"cortexone\"], \"producedByEvent\": [193996], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193988\", \"stIdVersion\": \"R-ALL-193988.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193964, \"displayName\": \"CYP21A2 21-hydroxylates PROG\", \"followingEvent\": [193996], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYP21A2 21-hydroxylates PROG\", \"O2 + progesterone + reduced (NADPH--hemoprotein reductase) => 21-hydroxyprogesterone + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\", \"21-hydroxylation of progesterone to form 11-deoxycorticosterone\", \"progesterone + NAPDH + H+ + O2 => 11-deoxycorticosterone + NADP+ + H2O\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193964\", \"stIdVersion\": \"R-HSA-193964.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193996\", \"stIdVersion\": \"R-HSA-193996.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 196337, \"displayName\": \"11-deoxycorticosterone is synthesized in a reaction at the e...\", \"schemaClass\": \"Summation\", \"text\": \"11-deoxycorticosterone is synthesized in a reaction at the endoplasmic reticulum membrane and is further metabolized, ultimately to yield aldosterone, in reactions catalyzed by mitochondrial enzymes. The means by which 11-deoxycorticosterone translocates into the mitochondrial matrix, however, is unknown.\"}]}" ;
