sName\": \"Gallus gallus\", \"stId\": \"R-GGA-8869241\", \"stIdVersion\": \"R-GGA-8869241.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10721602, \"displayName\": \"PITPNM1,2,3 exchange PI for PA\", \"inferredFrom\": [8869241], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PITPNM1,2,3 exchange PI for PA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8869241\", \"stIdVersion\": \"R-XTR-8869241.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10638752, \"displayName\": \"PITPNM1,2,3 exchange PI for PA\", \"inferredFrom\": [8869241], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PITPNM1,2,3 exchange PI for PA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-8869241\", \"stIdVersion\": \"R-DRE-8869241.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10543192, \"displayName\": \"PITPNM1,2,3 exchange PI for PA\", \"inferredFrom\": [8869241], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PITPNM1,2,3 exchange PI for PA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8869241\", \"stIdVersion\": \"R-SSC-8869241.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10429431, \"displayName\": \"PITPNM1,2,3 exchange PI for PA\", \"inferredFrom\": [8869241], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PITPNM1,2,3 exchange PI for PA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8869241\", \"stIdVersion\": \"R-BTA-8869241.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10315997, \"displayName\": \"PITPNM1,2,3 exchange PI for PA\", \"inferredFrom\": [8869241], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PITPNM1,2,3 exchange PI for PA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8869241\", \"stIdVersion\": \"R-CFA-8869241.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10207433, \"displayName\": \"PITPNM1,2,3 exchange PI for PA\", \"inferredFrom\": [8869241], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PITPNM1,2,3 exchange PI for PA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8869241\", \"stIdVersion\": \"R-RNO-8869241.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10084442, \"displayName\": \"PITPNM1,2,3 exchange PI for PA\", \"inferredFrom\": [8869241], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PITPNM1,2,3 exchange PI for PA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8869241\", \"stIdVersion\": \"R-MMU-8869241.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 426658, \"displayName\": \"PI [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI\", \"1-phosphatidyl-1D-myo-inositol(1-)\", \"Phosphatidyl 1D-myo-inositol\", \"1-phosphatidyl-1D-myo-inositol\"], \"producedByEvent\": [8869241], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426658\", \"stIdVersion\": \"R-ALL-426658.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 426755, \"displayName\": \"PA [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PA\", \"phosphatidate(2-)\", \"phosphatidic acid\"], \"producedByEvent\": [8869241], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426755\", \"stIdVersion\": \"R-ALL-426755.4\"}], \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8869241\", \"stIdVersion\": \"R-HSA-8869241.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8869403, \"displayName\": \"Phosphatidylinositol 4,5-bisphosphate (PIP2) at the plasma m...\", \"schemaClass\": \"Summation\", \"text\": \"Phosphatidylinositol 4,5-bisphosphate (PIP2) at the plasma membrane (PM) constitutively controls many cellular functions, and its hydrolysis via receptor stimulation can mediate cell signalling. A steady delivery of phosphatidylinositol (PI) from its site of synthesis in the endoplasmic reticulum (ER) to the PM is essential to maintain PIP2 levels. In addition, phosphatidic acid (PA), generated from diacylglycerol in the PM, has to reach the ER for PI resynthesis. The ubiquitously-expressed membrane-associated phosphatidylinositol transfer proteins 1, 2 and 3 (PITPNM1,2,3) (Lev et al. 1999) detect PIP2 hydrolysis and translocate to ER-PM junctions where they mediate the exchange of PI for PA (Kim et al. 2015, Chang & Liou 2015). Defects in PITPNM3 can cause cone-rod dystrophy 5 (CORD5; MIM:600977), a retinal dystrophy manifested as progressive loss of central vision, defective color vision, and photophobia. The missense mutation Q626H lacks the N-terminal PIT domain needed for transport of phospholipids and renewal of photoreceptors membranes is impaired (Kohn et al. 2007).\"}]}" ;
