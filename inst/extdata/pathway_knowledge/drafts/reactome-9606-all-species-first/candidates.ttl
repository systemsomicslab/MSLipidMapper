: \"Homo sapiens\", \"stId\": \"R-HSA-192315\", \"stIdVersion\": \"R-HSA-192315.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 194121, \"displayName\": \"SLC10A1 co-transport bile salts and Na+ from extracellular region to cytosol\", \"followingEvent\": [193362], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SLC10A1 co-transport bile salts and Na+ from extracellular region to cytosol\", \"NTCP takes up bile salts and Na+ into the liver\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194121\", \"stIdVersion\": \"R-HSA-194121.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 194130, \"displayName\": \"Transport (influx) of bile salts and acids by OATP-A\", \"followingEvent\": [193362], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Transport (influx) of bile salts and acids by OATP-A\", \"SLCO1A2 transports\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194130\", \"stIdVersion\": \"R-HSA-194130.5\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 194079, \"displayName\": \"SLCO1B3 transports ALB:(GCCA, TCCA) from extracellular region to cytosol\", \"followingEvent\": [193362], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SLCO1B3 transports ALB:(GCCA, TCCA) from extracellular region to cytosol\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194079\", \"stIdVersion\": \"R-HSA-194079.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 194083, \"displayName\": \"SLCO1B1 transports ALB:(GCCA,TCCA) from extracellular region to cytosol\", \"followingEvent\": [193362], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SLCO1B1 transports ALB:(GCCA,TCCA) from extracellular region to cytosol\", \"Transport (influx) of glycocholate and taurocholate by OATP-C\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194083\", \"stIdVersion\": \"R-HSA-194083.5\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 159431, \"displayName\": \"Cytosolic chenodeoxycholoyl-CoA or choloyl-CoA are conjugated with glycine or taurine\", \"followingEvent\": [193362], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Cytosolic chenodeoxycholoyl-CoA or choloyl-CoA are conjugated with glycine or taurine\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-159431\", \"stIdVersion\": \"R-HSA-159431.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193362\", \"stIdVersion\": \"R-HSA-193362.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193394, \"displayName\": \"A molecule of glycocholate, glycochenodeoxycholate, taurocho...\", \"schemaClass\": \"Summation\", \"text\": \"A molecule of glycocholate, glycochenodeoxycholate, taurocholate, or taurochenodeoxycholate is transported from the cytosol to the extracellular space, coupled to the hydrolysis of a molecule of cytosolic ATP to ADP and orthophosphate. This reaction is mediated by ABCB11 (bile salt export pump). In the body, this reaction mediates the release of bile salts from the liver cells into the bile (Kullak-Ublick et al. 2004); the role of ABCB11 in the reaction is confirmed by the observed failure of bile salt export in patients in whom the transporter is defective (Noe et al. 2005).\"}]}" ;
