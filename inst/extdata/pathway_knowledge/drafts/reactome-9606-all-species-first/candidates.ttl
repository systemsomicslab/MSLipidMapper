<https://reactome.org/content/detail/R-HSA-9026000> a mslm:LipidReaction ;
    rdfs:label "Epoxide hydrolase hydrolyses 16(S),17(S)-epoxy-DPAn-3 to PD1n-3DPA or PD2n-3DPA" ;
