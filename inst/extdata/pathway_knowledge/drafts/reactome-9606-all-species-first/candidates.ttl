 \"dbId\": 10039153, \"displayName\": \"2-acyl LPS is acylated to PS by LPSAT\", \"inferredFrom\": [1482691], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-acyl LPS is acylated to PS by LPSAT\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1482691\", \"stIdVersion\": \"R-MMU-1482691.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1500646, \"displayName\": \"PS [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PS\", \"3-sn-phosphatidyl-L-serine\", \"phosphatidylserine\", \"phosphatidyl-L-serine\"], \"producedByEvent\": [1482691], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500646\", \"stIdVersion\": \"R-ALL-1500646.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [1482691], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482897, \"displayName\": \"PS is hydrolyzed to 2-acyl LPS by PLA2[10]\", \"followingEvent\": [1482691], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PS is hydrolyzed to 2-acyl LPS by PLA2[10]\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482897\", \"stIdVersion\": \"R-HSA-1482897.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482691\", \"stIdVersion\": \"R-HSA-1482691.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482607, \"displayName\": \"At the endoplasmic reticulum (ER) membrane, lysophospholipid...\", \"schemaClass\": \"Summation\", \"text\": \"At the endoplasmic reticulum (ER) membrane, lysophospholipid acyltransferases acylate 2-acyl lysophosphatidylserine (LPS) to form phosphatidylserine (PS).  The lysophospholipid acyltransferases involved are: lysophospholipid acyltransferase 5 (LPCAT3) (Gijon et al. 2008, Hishikawa et al. 2008); lysophospholipid acyltransferase LPCAT4 (LPCAT4) aka LPEAT2 (Cao et al. 2008); or lysophospholipid acyltransferase 1 (MBOAT1) aka LPEAT1 (Hishikawa et al. 2008, Gijon et al. 2008).\"}]}" ;
