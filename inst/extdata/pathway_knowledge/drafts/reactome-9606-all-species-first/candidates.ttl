, \"THCA [mitochondrial matrix] => THCA [cytosol]\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191971\", \"stIdVersion\": \"R-HSA-191971.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192137\", \"stIdVersion\": \"R-HSA-192137.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193534, \"displayName\": \"THCA (25(R) 3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan...\", \"schemaClass\": \"Summation\", \"text\": \"THCA (25(R) 3alpha,7alpha,12alpha-trihydroxy-5beta-cholestanoate) , coenzyme A, and ATP react to form the CoA conjugate of 25(R) THCA, AMP, and pyrophosphate. This cytosolic reaction is catalyzed by SLC27A5 (BACS). SLC27A2 (VLCS) also catalyzes this reaction; the relative contributions of the two enzymes to de novo bile acid synthesis in vivo are not certain (Mihalik et al. 2002).\"}]}" ;
