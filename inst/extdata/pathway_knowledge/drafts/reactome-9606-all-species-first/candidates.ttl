se, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP2E1 oxidises 14(S)-HDHA to 14(S),21(R)-diHDHA and 14(S),21(S)-diHDHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9027302\", \"stIdVersion\": \"R-BTA-9027302.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10323957, \"displayName\": \"CYP2E1 oxidises 14(S)-HDHA to 14(S),21(R)-diHDHA and 14(S),21(S)-diHDHA\", \"inferredFrom\": [9027302], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP2E1 oxidises 14(S)-HDHA to 14(S),21(R)-diHDHA and 14(S),21(S)-diHDHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9027302\", \"stIdVersion\": \"R-CFA-9027302.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10216064, \"displayName\": \"CYP2E1 oxidises 14(S)-HDHA to 14(S),21(R)-diHDHA and 14(S),21(S)-diHDHA\", \"inferredFrom\": [9027302], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP2E1 oxidises 14(S)-HDHA to 14(S),21(R)-diHDHA and 14(S),21(S)-diHDHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9027302\", \"stIdVersion\": \"R-RNO-9027302.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092852, \"displayName\": \"CYP2E1 oxidises 14(S)-HDHA to 14(S),21(R)-diHDHA and 14(S),21(S)-diHDHA\", \"inferredFrom\": [9027302], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP2E1 oxidises 14(S)-HDHA to 14(S),21(R)-diHDHA and 14(S),21(S)-diHDHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9027302\", \"stIdVersion\": \"R-MMU-9027302.1\"}], \"output\": [{\"className\": \"Set\", \"dbId\": 9027326, \"displayName\": \"14(S),21(S/R)-diHDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"14(S),21(S/R)-diHDHA\"], \"producedByEvent\": [9027302], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9027326\", \"stIdVersion\": \"R-ALL-9027326.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [9027302], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [9027302], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9027033, \"displayName\": \"Hydroperoxy reducatase reduces 14(S)-Hp-DHA to 14(S)-HDHA\", \"followingEvent\": [9027302], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Hydroperoxy reducatase reduces 14(S)-Hp-DHA to 14(S)-HDHA\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027033\", \"stIdVersion\": \"R-HSA-9027033.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027302\", \"stIdVersion\": \"R-HSA-9027302.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9027318, \"displayName\": \"In macrophages, cytochrome P450s (CYPs) are likely to 21-hyd...\", \"schemaClass\": \"Summation\", \"text\": \"In macrophages, cytochrome P450s (CYPs) are likely to 21-hydroxylate 14(S)-hydroxy-docosahexaenoic acid (14(S)-HDHA) to 14(S),21(R)-dihydroxy-docosahexaenoic acid (14(S),21(R)-diHDHA) and 14(S),21(S)-diHDHA (Lu et al. 2010, Tian et al. 2011a, 2011b). In human skin, CYP1A1, 2B6/7, 2E1, 3A4/7 and 3A5 proteins have been identified and shown to possess catalytic activities (Swanson 2004). CYP2E1 is able to generate 19-hydroxyleicosatetraenoic acid, an ω-1 hydroxylation intermediate of arachidonic acid (Laethem et al. 1993) therefore, it might also ω-1 hydroxylate 14(S)-HDHA in human skin.<br>14(S),21(R)-diHDHA was shown to counteract the diabetic impairment of macrophage pro-healing functions in an autocrine/paracrine fashion, enhancing wound healing (Lu et al. 2010, Tian et al. 2011a, 2011b).\"}]}" ;
