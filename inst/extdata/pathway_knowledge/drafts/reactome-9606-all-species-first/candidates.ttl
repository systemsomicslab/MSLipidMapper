th\": 1, \"name\": [\"3-hydroxypristanoyl-CoA + NAD+ => 3-ketoxypristanoyl-CoA + NADH + H+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-389995\", \"stIdVersion\": \"R-BTA-389995.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10259350, \"displayName\": \"3-hydroxypristanoyl-CoA + NAD+ => 3-ketoxypristanoyl-CoA + NADH + H+\", \"inferredFrom\": [389995], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-hydroxypristanoyl-CoA + NAD+ => 3-ketoxypristanoyl-CoA + NADH + H+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-389995\", \"stIdVersion\": \"R-CFA-389995.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10140939, \"displayName\": \"3-hydroxypristanoyl-CoA + NAD+ => 3-ketoxypristanoyl-CoA + NADH + H+\", \"inferredFrom\": [389995], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-hydroxypristanoyl-CoA + NAD+ => 3-ketoxypristanoyl-CoA + NADH + H+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-389995\", \"stIdVersion\": \"R-RNO-389995.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10018799, \"displayName\": \"3-hydroxypristanoyl-CoA + NAD+ => 3-ketoxypristanoyl-CoA + NADH + H+\", \"inferredFrom\": [389995], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-hydroxypristanoyl-CoA + NAD+ => 3-ketoxypristanoyl-CoA + NADH + H+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-389995\", \"stIdVersion\": \"R-MMU-389995.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389996, \"displayName\": \"3-ketopristanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3-ketopristanoyl-CoA\", \"3-oxopristanoyl-CoA(4-)\", \"3-oxopristanoyl-CoA\"], \"producedByEvent\": [389995], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389996\", \"stIdVersion\": \"R-ALL-389996.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 192305, \"displayName\": \"NADH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [389995], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192305\", \"stIdVersion\": \"R-ALL-192305.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [389995], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 389986, \"displayName\": \"trans-2,3-dehydropristanoyl-CoA + H2O => 3-hydroxypristanoyl-CoA\", \"followingEvent\": [389995], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"trans-2,3-dehydropristanoyl-CoA + H2O => 3-hydroxypristanoyl-CoA\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-389986\", \"stIdVersion\": \"R-HSA-389986.3\"}], \"releaseDate\": \"2009-04-01\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-389995\", \"stIdVersion\": \"R-HSA-389995.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 390000, \"displayName\": \"Peroxisomal HSD17B4 dimer catalyzes the reaction of 3-hydrox...\", \"schemaClass\": \"Summation\", \"text\": \"Peroxisomal HSD17B4 dimer catalyzes the reaction of 3-hydroxypristanoyl-CoA and NAD+ to form 3-ketoxypristanoyl-CoA and NADH + H+. The enzyme is bifunctional - an aminoterminal domain catalyzes the dehydrogenation of a variety of 3-hydroxyacyl-CoA's, the reaction annotated here, and a carboxyterminal domain catalyzes the hydration of a variety of trans-2,3-dehydroacyl-CoA's (Jiang et al. 1996, 1997). Defects in the enzyme are associated with a severe disorder of peroxisomal fatty acid metabolism in humans (Ferdinandusse et al. 2006).\"}]}" ;
