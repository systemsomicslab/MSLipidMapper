d\": 10238650, \"displayName\": \"PTGIS, CYP8A1 isomerise PGH2 to PGI2\", \"inferredFrom\": [76496], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGIS, CYP8A1 isomerise PGH2 to PGI2\", \"prostaglandin H2 => prostaglandin I2\", \"Prostacyclin synthase (CYP8A1) mediates the isomerization of prostaglandin H2 to prostaglandin I2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-76496\", \"stIdVersion\": \"R-CFA-76496.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10116150, \"displayName\": \"PTGIS, CYP8A1 isomerise PGH2 to PGI2\", \"inferredFrom\": [76496], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGIS, CYP8A1 isomerise PGH2 to PGI2\", \"prostaglandin H2 => prostaglandin I2\", \"Prostacyclin synthase (CYP8A1) mediates the isomerization of prostaglandin H2 to prostaglandin I2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-76496\", \"stIdVersion\": \"R-RNO-76496.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9996454, \"displayName\": \"PTGIS, CYP8A1 isomerise PGH2 to PGI2\", \"inferredFrom\": [76496], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGIS, CYP8A1 isomerise PGH2 to PGI2\", \"prostaglandin H2 => prostaglandin I2\", \"Prostacyclin synthase (CYP8A1) mediates the isomerization of prostaglandin H2 to prostaglandin I2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-76496\", \"stIdVersion\": \"R-MMU-76496.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 31593, \"displayName\": \"PGI2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGI2\", \"prostaglandin I2(1-)\", \"Prostacyclin\", \"prostaglandin I2\", \"(5Z,13E)-(15S)-6,9alpha-Epoxy-11alpha,15-dihydroxyprosta-5,13-dienoate\"], \"producedByEvent\": [76496], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-31593\", \"stIdVersion\": \"R-ALL-31593.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 140359, \"displayName\": \"PGG2 is reduced to PGH2 by PTGS1\", \"followingEvent\": [76496], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PGG2 is reduced to PGH2 by PTGS1\", \"AH2 + prostaglandin G2 = A + H2O + prostaglandin H2\", \"Peroxidative reduction of PGG2 to PGH2\"], \"releaseDate\": \"2008-06-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-140359\", \"stIdVersion\": \"R-HSA-140359.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2309773, \"displayName\": \"PGG2 is reduced to PGH2 by PTGS2\", \"followingEvent\": [76496], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PGG2 is reduced to PGH2 by PTGS2\", \"AH2 + prostaglandin G2 = A + H2O + prostaglandin H2\", \"Peroxidative reduction of PGG2 to PGH2\"], \"releaseDate\": \"2008-06-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2309773\", \"stIdVersion\": \"R-HSA-2309773.8\"}], \"releaseDate\": \"2008-06-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-76496\", \"stIdVersion\": \"R-HSA-76496.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 76555, \"displayName\": \"Prostacyclin synthase (PTGIS) aka CYP8A1 mediates the isomer...\", \"schemaClass\": \"Summation\", \"text\": \"Prostacyclin synthase (PTGIS) aka CYP8A1 mediates the isomerisation of prostaglandin H2 (PGH2) to prostaglandin I2 (PGI2) aka prostacyclin (Wada et al. 2004).  This reaction is not coupled with any P450 reductase proteins nor consumes NADPH. Experiments on rats with thrombolytic models suggest endogenous MNA could be a stimulator of the COX2/PGI2 pathway and thus regulate an anti-thrombotic effect (Chlopicki et al. 2007).\"}]}" ;
