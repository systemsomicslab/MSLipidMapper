<https://reactome.org/content/detail/R-HSA-193767> a mslm:LipidReaction ;
    rdfs:label "Influx of 24-hydroxycholesterol" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "24OH-CHOL [extracellular region] => 24OH-CHOL [endoplasmic reticulum membrane]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 193767, \"displayName\": \"Influx of 24-hydroxycholesterol\", \"goBiologicalProcess\": {\"accession\": \"0035376\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 937728, \"definition\": \"The directed movement of a sterol into a cell or organelle. Sterols are steroids with one or more hydroxyl groups and a hydrocarbon side-chain in the molecule.\", \"displayName\": \"sterol import\", \"name\": \"sterol import\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0035376\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193767], \"dbId\": 193717, \"displayName\": \"24OH-CHOL [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"24OH-CHOL\", \"(24S)-24-hydroxycholesterol\", \"24-hydroxycholesterol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193717\", \"stIdVersion\": \"R-ALL-193717.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 193748, \"displayName\": \"Cholesterol homeostasis in human brain: evidence for an age-dependent flux of 24S-hydroxycholesterol from the brain into the circulation\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"9799-804\", \"pubMedIdentifier\": 8790411, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cholesterol homeostasis in human brain: evidence for an age-dependent flux of 24S-hydroxycholesterol from the brain into the circulation\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8790411\", \"volume\": 93, \"year\": 1996}, {\"className\": \"LiteratureReference\", \"dbId\": 193791, \"displayName\": \"Cholesterol homeostasis in human brain: turnover of 24S-hydroxycholesterol and evidence for a cerebral origin of most of this oxysterol in the circulation\", \"journal\": \"J Lipid Res\", \"pages\": \"1594-600\", \"pubMedIdentifier\": 9717719, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cholesterol homeostasis in human brain: turnover of 24S-hydroxycholesterol and evidence for a cerebral origin of most of this oxysterol in the circulation\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9717719\", \"volume\": 39, \"year\": 1998}], \"maxDepth\": 1, \"name\": [\"Influx of 24-hydroxycholesterol\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192060, \"displayName\": \"24OH-CHOL [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"24OH-CHOL\", \"(24S)-24-hydroxycholesterol\", \"24-hydroxycholesterol\"], \"producedByEvent\": [193767], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192060\", \"stIdVersion\": \"R-ALL-192060.4\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 193776, \"displayName\": \"Efflux of 24-hydroxycholesterol\", \"followingEvent\": [193767], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Efflux of 24-hydroxycholesterol\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193776\", \"stIdVersion\": \"R-HSA-193776.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193767\", \"stIdVersion\": \"R-HSA-193767.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193784, \"displayName\": \"24-hydroxycholesterol is transported from the extracellular ...\", \"schemaClass\": \"Summation\", \"text\": \"24-hydroxycholesterol is transported from the extracellular space to the endoplasmic reticulum. In humans, this event is the means by which the molecule, generated from cholesterol in the brain, is taken up by liver cells for conversion to bile acids and bile salts. While transport proteins are likely to play a role in this process, these proteins have not been identified (Lutjohann et al. 1996; Bjorkhem et al. 1998).\"}]}" ;
