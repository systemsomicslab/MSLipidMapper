: \"SimpleEntity\", \"stId\": \"R-ALL-9023708\", \"stIdVersion\": \"R-ALL-9023708.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9018863, \"displayName\": \"ALOX5 oxidises 18(R)-HEPE to 5(S)-Hp-18(R)-HEPE\", \"followingEvent\": [9018894], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 18(R)-HEPE to 5(S)-Hp-18(R)-HEPE\", \"(18R)-hydroxy-(5Z,8Z,11Z,14Z,16E)-eicosapentaenoate + O2 => (5S)-hydroperoxy-(18R)-hydroxy-(6E,8Z,11Z,14Z,16E)-eicosapentaenoate\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9018863\", \"stIdVersion\": \"R-HSA-9018863.3\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9018894\", \"stIdVersion\": \"R-HSA-9018894.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9023699, \"displayName\": \"In neutrophils, 5-lipoxygenase (ALOX5) can mediate the inser...\", \"schemaClass\": \"Summation\", \"text\": \"In neutrophils, 5-lipoxygenase (ALOX5) can mediate the insertion of molecular oxygen into 5(S)-hydroperoxy-18(R)-hydroxyeicosapentaenoic acid (5(S)-Hp-18(R)-HEPE) to form 5S,6S-epoxy-18(R)-HEPE which is essential for 18(R)-resolvin E1 biosynthesis (Tjonahen et al. 2006, Oh et al. 2012).\"}]}" ;
