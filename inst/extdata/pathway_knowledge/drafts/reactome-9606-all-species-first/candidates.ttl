    mslm:equation "PS [mitochondrial inner membrane] => CO2 [mitochondrial matrix] + PE [mitochondrial inner membrane]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [1483212], \"className\": \"CatalystActivity\", \"dbId\": 1524158, \"displayName\": \"phosphatidylserine decarboxylase activity of PISD:Pyruvoyl [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}, {\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 1483212, \"displayName\": \"PS is decarboxylated to PE by PISD\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1483212], \"dbId\": 9025386, \"displayName\": \"PS [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PS\", \"3-sn-phosphatidyl-L-serine\", \"L-1-phosphatidylserine\", \"phys-ent-participant105443\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9025386\", \"stIdVersion\": \"R-ALL-9025386.1\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1602055, \"displayName\": \"High-throughput mass spectrometry screening for inhibitors of phosphatidylserine decarboxylase\", \"journal\": \"J Biomol Screen\", \"pages\": \"628-34\", \"pubMedIdentifier\": 17478478, \"schemaClass\": \"LiteratureReference\", \"title\": \"High-throughput mass spectrometry screening for inhibitors of phosphatidylserine decarboxylase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17478478\", \"volume\": 12, \"year\": 2007}], \"maxDepth\": 1, \"name\": [\"PS is decarboxylated to PE by PISD\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1524083, \"displayName\": \"PE [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PE\", \"phosphatidylethanolamine zwitterion\", \"phosphatidylethanolamine\"], \"producedByEvent\": [1483212], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524083\", \"stIdVersion\": \"R-ALL-1524083.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29376, \"displayName\": \"CO2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CO2\", \"carbon dioxide\"], \"producedByEvent\": [1483212], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29376\", \"stIdVersion\": \"R-ALL-29376.3\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 1483170, \"displayName\": \"PS transports from the ER membrane to the IM membrane\", \"followingEvent\": [1483212], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PS transports from the ER membrane to the IM membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483170\", \"stIdVersion\": \"R-HSA-1483170.4\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483212\", \"stIdVersion\": \"R-HSA-1483212.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482963, \"displayName\": \"At the inner mitochondrial (IM) membrane, phosphatidylserine...\", \"schemaClass\": \"Summation\", \"text\": \"At the inner mitochondrial (IM) membrane, phosphatidylserine decarboxylase proenzyme (heterodimer of two chains from the same protein) (PISD) decarboxylates phosphatidylserine (PS) to phosphatidylethanolamine (PE).  This event has been inferred from rats and limited data for a human PISD (Forbes et al. 2007).\"}]}" ;
