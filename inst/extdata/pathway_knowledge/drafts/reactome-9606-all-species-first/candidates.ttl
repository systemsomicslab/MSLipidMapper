1, \"name\": [\"ST3GAL5 transfers NeuNAc to ceramides\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9844860\", \"stIdVersion\": \"R-BTA-9844860.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10224451, \"displayName\": \"ST3GAL5 transfers NeuNAc to ceramides\", \"inferredFrom\": [9844860], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ST3GAL5 transfers NeuNAc to ceramides\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9844860\", \"stIdVersion\": \"R-RNO-9844860.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10100922, \"displayName\": \"ST3GAL5 transfers NeuNAc to ceramides\", \"inferredFrom\": [9844860], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ST3GAL5 transfers NeuNAc to ceramides\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9844860\", \"stIdVersion\": \"R-MMU-9844860.1\"}], \"output\": [{\"className\": \"Set\", \"dbId\": 9844871, \"displayName\": \"GM1/2/3/4 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GM1/2/3/4\"], \"producedByEvent\": [9844860], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9844871\", \"stIdVersion\": \"R-ALL-9844871.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 727810, \"displayName\": \"CMP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CMP\", \"cytidine 5'-monophosphate(2-)\", \"cytidine 5'-monophosphate\", \"cytidylic acid\", \"Cytidine-5'-monophosphate\"], \"producedByEvent\": [9844860], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-727810\", \"stIdVersion\": \"R-ALL-727810.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [9844860], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 6785933, \"displayName\": \"UGT8 transfers Gal from UDP-Gal to CERA\", \"followingEvent\": [9844860], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"UGT8 transfers Gal from UDP-Gal to CERA\"], \"releaseDate\": \"2015-12-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6785933\", \"stIdVersion\": \"R-HSA-6785933.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 727807, \"displayName\": \"SLC35A1 exchanges CMP-Neu5Ac for CMP\", \"followingEvent\": [9844860], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SLC35A1 exchanges CMP-Neu5Ac for CMP\", \"CMP-N-acetyl-beta-neuraminate(in) + CMP(out) = CMP-N-acetyl-beta-neuraminate(out) + CMP(in)\", \"SLC35A1 mediates the antiport of CMP-sialic acid in exchange for CMP\"], \"releaseDate\": \"2010-06-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-727807\", \"stIdVersion\": \"R-HSA-727807.4\"}], \"releaseDate\": \"2023-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9844860\", \"stIdVersion\": \"R-HSA-9844860.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9844861, \"displayName\": \"Following its biosynthesis, a fraction of GalCer reaches the...\", \"schemaClass\": \"Summation\", \"text\": \"Following its biosynthesis, a fraction of GalCer reaches the lumen of the Golgi and is reacted with cytidine-5′-monophospho-N-acetylneuraminic acid by the action of the sialyltransferase ST3GAL5 to form N-acetylneuraminyl-GalCer (GM4; sialyl-GalCer) (Shanker and Pieringer, 1983; Ishii et al., 1998; reviewed by Liu & Li, 2013). ST3GAL5 also catalyzes the sialylation of lactosylceramide (LacCer) to ganglioside GM3 and the sialylation of gangliosides GA1/GA2 to gangliosides GM1/GM2. The process is localized in the Golgi membrane (Allende et al., 2000; Stern et al., 2000; Berselli et al., 2006). Deficiencies in ST3GAL5 are the cause of \\\"Salt and Pepper\\\" developmental regression syndrome (SPDRS, MIM:609056; Aoki et al., 2019; reviewed by Inamori & Inokuchi, 2022).\"}]}" ;
