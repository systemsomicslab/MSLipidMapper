Depth\": 1, \"name\": [\"PI is phosphorylated to PI4P by PI4KB at the Golgi membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675883\", \"stIdVersion\": \"R-HSA-1675883.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676204, \"displayName\": \"PI(3,4)P2 is dephosphorylated to PI4P by TPTE2 at the Golgi membrane\", \"followingEvent\": [1675928], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2 is dephosphorylated to PI4P by TPTE2 at the Golgi membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676204\", \"stIdVersion\": \"R-HSA-1676204.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1675824, \"displayName\": \"PI(4,5)P2 is dephosphorylated to PI4P by OCRL/INPP5E at the Golgi membrane\", \"followingEvent\": [1675928], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2 is dephosphorylated to PI4P by OCRL/INPP5E at the Golgi membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675824\", \"stIdVersion\": \"R-HSA-1675824.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675928\", \"stIdVersion\": \"R-HSA-1675928.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1675881, \"displayName\": \"At the Golgi membrane, phosphatidylinositol-4-phosphate 3-ki...\", \"schemaClass\": \"Summation\", \"text\": \"At the Golgi membrane, phosphatidylinositol-4-phosphate 3-kinase C2 domain-containing subunit alpha (PIK3C2A) (Domin et al. 2000, Arcaro et al. 2000) and phosphatidylinositol-4-phosphate 3-kinase C2 domain-containing subunit gamma (PIK3C2G) (Ono et al. 1998, Rozycka et al. 1998, Misawa et al. 1998) phosphorylate phosphatidylinositol 4-phosphate (PI4P) to phosphatidylinositol 3,4-bisphosphate (PI(3,4)P2).  PIK3C2G phosphorylates phosphatidylinositol (PI) and PI4P but not phosphatidylinositol 4,5-bisphosphate (PI(4,5)P2).\"}]}" ;
