    mslm:evidenceJson "{\"category\": \"uncertain\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}, {\"accession\": \"0005741\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17906, \"definition\": \"The outer, i.e. cytoplasm-facing, lipid bilayer of the mitochondrial envelope.\", \"displayName\": \"mitochondrial outer membrane\", \"name\": \"mitochondrial outer membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005741\"}], \"dbId\": 1801587, \"displayName\": \"Expression of Carnitine O-palmitoyltransferase 1 CPT1A\", \"goBiologicalProcess\": {\"accession\": \"0045944\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 17788, \"definition\": \"Any process that activates or increases the frequency, rate or extent of transcription from an RNA polymerase II promoter.\", \"displayName\": \"positive regulation of transcription by RNA polymerase II\", \"name\": \"positive regulation of transcription by RNA polymerase II\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0045944\"}, \"input\": [{\"className\": \"DNA Sequence\", \"consumedByEvent\": [1801587], \"dbId\": 5641230, \"displayName\": \"CPT1A gene [nucleoplasm]\", \"endCoordinate\": -1, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CPT1A gene\"], \"referenceType\": \"ReferenceDNASequence\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5641230\", \"stIdVersion\": \"R-HSA-5641230.1\", \"startCoordinate\": 1}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1801582, \"displayName\": \"Human liver mitochondrial carnitine palmitoyltransferase I: characterization of its cDNA and chromosomal localization and partial analysis of the gene\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"1984-8\", \"pubMedIdentifier\": 7892212, \"schemaClass\": \"LiteratureReference\", \"title\": \"Human liver mitochondrial carnitine palmitoyltransferase I: characterization of its cDNA and chromosomal localization and partial analysis of the gene\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/7892212\", \"volume\": 92, \"year\": 1995}, {\"className\": \"LiteratureReference\", \"dbId\": 561153, \"displayName\": \"Comparative analysis of gene regulation by the transcription factor PPARalpha between mouse and human\", \"journal\": \"PLoS One\", \"pages\": \"e6796\", \"pubMedIdentifier\": 19710929, \"schemaClass\": \"LiteratureReference\", \"title\": \"Comparative analysis of gene regulation by the transcription factor PPARalpha between mouse and human\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/19710929\", \"volume\": 4, \"year\": 2009}, {\"className\": \"LiteratureReference\", \"dbId\": 400114, \"displayName\": \"Regulation of P450 4A expression by peroxisome proliferator activated receptors\", \"journal\": \"Toxicology\", \"pages\": \"203-6\", \"pubMedIdentifier\": 12505311, \"schemaClass\": \"LiteratureReference\", \"title\": \"Regulation of P450 4A expression by peroxisome proliferator activated receptors\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12505311\", \"volume\": 181, \"year\": 2002}], \"maxDepth\": 1, \"name\": [\"Expression of Carnitine O-palmitoyltransferase 1 CPT1A\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 400161, \"displayName\": \"CPT1A [mitochondrial outer membrane]\", \"endCoordinate\": 773, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CPT1A\", \"CPT1 (liver)\", \"carnitine palmitoyltransferase 1A (liver)\"], \"producedByEvent\": [1801587], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-400161\", \"stIdVersion\": \"R-HSA-400161.1\", \"startCoordinate\": 2}], \"precedingEvent\": [{\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 5663264, \"displayName\": \"RORA and EP300 bind the Carnitine O-palmitoyltransferase 1 (CPT1A) gene\", \"followingEvent\": [1801587], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"RORA and EP300 bind the Carnitine O-palmitoyltransferase 1 (CPT1A) gene\"], \"releaseDate\": \"2015-03-19\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5663264\", \"stIdVersion\": \"R-HSA-5663264.3\"}, {\"category\": \"uncertain\", \"className\": \"Reaction\", \"dbId\": 400143, \"displayName\": \"Fatty acid ligands activate PPARA\", \"followingEvent\": [1801587], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Fatty acid ligands activate PPARA\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-400143\", \"stIdVersion\": \"R-HSA-400143.4\"}], \"regulatedBy\": [{\"className\": \"PositiveGeneExpressionRegulation\", \"dbId\": 1801583, \"displayName\": \"Positive gene expression regulation by 'RORA:EP300:CPT1A gene [nucleoplasm]'\", \"regulatedEntity\": [1801587], \"schemaClass\": \"PositiveGeneExpressionRegulation\", \"stId\": \"R-HSA-1801583\", \"stIdVersion\": \"R-HSA-1801583.1\"}, {\"className\": \"PositiveGeneExpressionRegulation\", \"dbId\": 1989798, \"displayName\": \"Positive gene expression regulation by 'PPARA:RXRA Coactivator complex [nucleoplasm]'\", \"regulatedEntity\": [1801587], \"schemaClass\": \"PositiveGeneExpressionRegulation\", \"stId\": \"R-HSA-1989798\", \"stIdVersion\": \"R-HSA-1989798.3\"}], \"regulationReference\": [{\"className\": \"RegulationReference\", \"dbId\": 9641397, \"displayName\": \"Positive gene expression regulation by 'PPARA:RXRA Coactivator complex [nucleoplasm]' Comparative analysis of gene regulation by the transcription factor PPARalpha between mouse and human\", \"schemaClass\": \"RegulationReference\"}, {\"className\": \"RegulationReference\", \"dbId\": 9642555, \"displayName\": \"Positive gene expression regulation by 'RORA:EP300:CPT1A gene [nucleoplasm]' RORalpha regulates the expression of genes involved in lipid homeostasis in skeletal muscle cells: caveolin-3 and CPT-1 are direct targets of ROR\", \"schemaClass\": \"RegulationReference\"}], \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1801587\", \"stIdVersion\": \"R-HSA-1801587.9\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1801585, \"displayName\": \"The CPT1A gene is transcribed to yield mRNA and the mRNA is ...\", \"schemaClass\": \"Summation\", \"text\": \"The CPT1A gene is transcribed to yield mRNA and the mRNA is translated to yield protein (Britton et al. 1995, Johnson et al. 2002, Rakhshanderoo et al. 2009). As inferred from mouse homologs, RORA binds RRE DNA elements in the promoter of CPT1A and recruits the coactivators PGC-1alpha (PPARGC1A) and p300 (EP300, a histone acetylase) to enhance transcription of CPT1A. Regulation by RORA imparts circadian expression on CPT1A (Arnardottir et al. 2014), which encodes Carnitine O-palmitoyltransferase 1, an enzyme required for uptake and beta oxidation of fatty acids by mitochondria. Ppara, Rxra, and Per2 regulate the transcription of CPT1A (Chavan et al. 2016), which is important for food anticipatory activity in mice.\"}]}" ;
