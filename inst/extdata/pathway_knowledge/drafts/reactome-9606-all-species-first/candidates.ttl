    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [2161945], \"className\": \"CatalystActivity\", \"dbId\": 2161784, \"displayName\": \"eoxin D4 synthase activity of GGT [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 2161945, \"displayName\": \"EXC4 is converted to EXD4 by GGT\", \"followingEvent\": [2161868], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161945], \"dbId\": 2142726, \"displayName\": \"EXC4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"EXC4\", \"eoxin C4\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142726\", \"stIdVersion\": \"R-ALL-2142726.3\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 2161756, \"displayName\": \"Eoxins are proinflammatory arachidonic acid metabolites produced via the 15-lipoxygenase-1 pathway in human eosinophils and mast cells\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"680-5\", \"pubMedIdentifier\": 18184802, \"schemaClass\": \"LiteratureReference\", \"title\": \"Eoxins are proinflammatory arachidonic acid metabolites produced via the 15-lipoxygenase-1 pathway in human eosinophils and mast cells\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18184802\", \"volume\": 105, \"year\": 2008}, {\"className\": \"LiteratureReference\", \"dbId\": 2161760, \"displayName\": \"Hodgkin Reed-Sternberg cells express 15-lipoxygenase-1 and are putative producers of eoxins in vivo: novel insight into the inflammatory features of classical Hodgkin lymphoma\", \"journal\": \"FEBS J\", \"pages\": \"4222-34\", \"pubMedIdentifier\": 18647347, \"schemaClass\": \"LiteratureReference\", \"title\": \"Hodgkin Reed-Sternberg cells express 15-lipoxygenase-1 and are putative producers of eoxins in vivo: novel insight into the inflammatory features of classical Hodgkin lymphoma\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18647347\", \"volume\": 275, \"year\": 2008}], \"maxDepth\": 1, \"name\": [\"EXC4 is converted to EXD4 by GGT\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142758, \"displayName\": \"EXD4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"EXD4\", \"eoxin D4(1-)\", \"eoxin D4\"], \"producedByEvent\": [2161945], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142758\", \"stIdVersion\": \"R-ALL-2142758.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29404, \"displayName\": \"L-Glu [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"L-Glu\", \"L-glutamate(1-)\", \"L-Glutamate\", \"L-glutamic acid\", \"L-Glutaminic acid\"], \"producedByEvent\": [2161945], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29404\", \"stIdVersion\": \"R-ALL-29404.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2161768, \"displayName\": \"EXA4 is converted to EXC4 by LTC4S\", \"followingEvent\": [2161945], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"EXA4 is converted to EXC4 by LTC4S\"], \"releaseDate\": \"2012-12-04\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161768\", \"stIdVersion\": \"R-HSA-2161768.3\"}], \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161945\", \"stIdVersion\": \"R-HSA-2161945.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2161932, \"displayName\": \"In an analogous reaction to the formation of leukotriene D4 ...\", \"schemaClass\": \"Summation\", \"text\": \"In an analogous reaction to the formation of leukotriene D4 (LTD4), eoxin C4 (EXC4) is converted to eoxin D4 (EXD4) by a class of gamma-glutamyltransferase (GGT) (Feltenmark et al. 2008, Claesson et al. 2008) which has not yet been identified.\"}]}" ;
