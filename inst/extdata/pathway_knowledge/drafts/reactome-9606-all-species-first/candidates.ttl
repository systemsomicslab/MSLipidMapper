 \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-194023\", \"stIdVersion\": \"R-RNO-194023.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007706, \"displayName\": \"HSD11B2,HSD11B1 dimer oxidise CORT to COR\", \"inferredFrom\": [194023], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD11B2,HSD11B1 dimer oxidise CORT to COR\", \"cortisol + NADP(+) => cortisone + H(+) + NADPH\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-194023\", \"stIdVersion\": \"R-MMU-194023.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 194035, \"displayName\": \"COR [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"COR\", \"cortisone\"], \"producedByEvent\": [194023], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194035\", \"stIdVersion\": \"R-ALL-194035.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [194023], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"producedByEvent\": [194023], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 194036, \"displayName\": \"Cortisol translocates from the mitochondrial matrix to the cytosol\", \"followingEvent\": [194023], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Cortisol translocates from the mitochondrial matrix to the cytosol\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194036\", \"stIdVersion\": \"R-HSA-194036.4\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194023\", \"stIdVersion\": \"R-HSA-194023.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193973, \"displayName\": \"Cortisol and NADP+ react to form cortisone, NADPH, and H+. T...\", \"schemaClass\": \"Summation\", \"text\": \"Cortisol and NADP+ react to form cortisone, NADPH, and H+. This reaction is catalyzed by 11beta-hydroxysteroid dehydrogenases 11B1 and B2 (HSD11B1, B2), associated with the endoplasmic reticulum membrane. The conversion of cortisol (CORT), an active hormone, into inactive cortisone (COR) occurs in many tissues in the body, notably in the liver, and appears to play a role in regulating cortisol activity (Tannin et al. 1991, Stewart et al. 1987).\"}]}" ;
