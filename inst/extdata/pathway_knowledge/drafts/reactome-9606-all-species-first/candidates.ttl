 \"stId\": \"R-ALL-113548\", \"stIdVersion\": \"R-ALL-113548.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [71031], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 70844, \"displayName\": \"alpha-methylacetoacetyl-CoA + CoA => propionyl-CoA + acetyl-CoA\", \"followingEvent\": [71031], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"alpha-methylacetoacetyl-CoA + CoA => propionyl-CoA + acetyl-CoA\", \"2-methyl-3-oxobutanoyl-CoA + CoA => acetyl-CoA + propanoyl-CoA\"], \"releaseDate\": \"2004-07-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-70844\", \"stIdVersion\": \"R-HSA-70844.7\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 70893, \"displayName\": \"methylmalonate semialdehyde + NAD+ + CoA + H2O => propionyl-CoA + HCO3- + NADH + H+\", \"followingEvent\": [71031], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"methylmalonate semialdehyde + NAD+ + CoA + H2O => propionyl-CoA + HCO3- + NADH + H+\", \"(S)-2-methyl-3-oxopropanoate + CoA + H2O + NAD(+) => H(+) + hydrogencarbonate + NADH + propanoyl-CoA\"], \"releaseDate\": \"2004-07-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-70893\", \"stIdVersion\": \"R-HSA-70893.6\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2004-07-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-71031\", \"stIdVersion\": \"R-HSA-71031.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 179123, \"displayName\": \"Propionyl CoA carboxylase in the mitochondrial matrix cataly...\", \"schemaClass\": \"Summation\", \"text\": \"Propionyl CoA carboxylase in the mitochondrial matrix catalyzes the reaction of propionyl-CoA, CO2, and ATP to form D-methylmalonyl-CoA, ADP, and orthophosphate. The active form of the enzyme is a heteromultimer, probably consisting of six alpha subunits each bound to a biotin molecule and six beta subunits (Kaziro et al. 1961; Kalousek et al. 1980; Fenton et al. 2001). Both alpha and beta subunits are posttranslationally modified to remove amino-terminal mitochondrial import sequences (Stadler et al. 2005).\"}]}" ;
