isplayName\": \"Bile salts dissociate from FABP6\", \"inferredFrom\": [9733969], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Bile salts dissociate from FABP6\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9733969\", \"stIdVersion\": \"R-RNO-9733969.1\"}, {\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10097550, \"displayName\": \"Bile salts dissociate from FABP6\", \"inferredFrom\": [9733969], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Bile salts dissociate from FABP6\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9733969\", \"stIdVersion\": \"R-MMU-9733969.1\"}], \"output\": [{\"className\": \"Set\", \"dbId\": 194156, \"displayName\": \"bile salts and acids [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts and acids\"], \"producedByEvent\": [9733969], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-194156\", \"stIdVersion\": \"R-ALL-194156.2\"}, {\"className\": \"Protein\", \"dbId\": 194158, \"displayName\": \"FABP6 [cytosol]\", \"endCoordinate\": 128, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FABP6\", \"I-BABP\", \"Intestinal bile acid-binding protein\"], \"producedByEvent\": [9733969], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194158\", \"stIdVersion\": \"R-HSA-194158.1\", \"startCoordinate\": 2}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 9733973, \"displayName\": \"Bile salts bind FABP6\", \"followingEvent\": [9733969], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Bile salts bind FABP6\"], \"releaseDate\": \"2021-09-15\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9733973\", \"stIdVersion\": \"R-HSA-9733973.3\"}], \"releaseDate\": \"2021-09-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9733969\", \"stIdVersion\": \"R-HSA-9733969.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9733955, \"displayName\": \"Cytosolic ileal bile acid binding protein (IBABP, FABP6) (Fu...\", \"schemaClass\": \"Summation\", \"text\": \"Cytosolic ileal bile acid binding protein (IBABP, FABP6) (Fujita et al. 1995) mediates the intracellular binding and movement of bile acids (Kurz et al. 2003) to the basolateral membrane where organic solute transporters (OSTs) export bile acids and salts into the portal circulation to be returned to the liver. It is assumed that bile acids dissociate from FABP6 by an as-yet unknown mechanism before OSTs transport them across the basolateral membrane. \"}]}" ;
