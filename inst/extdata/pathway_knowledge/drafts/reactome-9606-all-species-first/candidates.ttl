"maxDepth\": 1, \"name\": [\"UGT8 transfers Gal from UDP-Gal to CERA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6785933\", \"stIdVersion\": \"R-MMU-6785933.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 6785915, \"displayName\": \"GalCer [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GalCer\", \"galactosylceramide\", \"D-galactosyl-N-acylsphingoid\", \"N-acyl-beta-D-galactosylsphingoid\", \"Galactocerebroside\", \"Galactosylceramide\"], \"producedByEvent\": [6785933], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6785915\", \"stIdVersion\": \"R-ALL-6785915.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 158602, \"displayName\": \"UDP [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP\", \"UDP(3-)\", \"uridine 5'-diphosphate\"], \"producedByEvent\": [6785933], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-158602\", \"stIdVersion\": \"R-ALL-158602.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 156540, \"displayName\": \"H+ [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [6785933], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-156540\", \"stIdVersion\": \"R-ALL-156540.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1640164, \"displayName\": \"ENPP7 hydrolyzes sphingomyelin\", \"followingEvent\": [6785933], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ENPP7 hydrolyzes sphingomyelin\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1640164\", \"stIdVersion\": \"R-HSA-1640164.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1861788, \"displayName\": \"GBA2 hydrolyzes GlcCer (plasma membrane)\", \"followingEvent\": [6785933], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GBA2 hydrolyzes GlcCer (plasma membrane)\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1861788\", \"stIdVersion\": \"R-HSA-1861788.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1606273, \"displayName\": \"SMPD2 and 3 hydrolyze sphingomyelin (plasma membrane)\", \"followingEvent\": [6785933], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SMPD2 and 3 hydrolyze sphingomyelin (plasma membrane)\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1606273\", \"stIdVersion\": \"R-HSA-1606273.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2015-12-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6785933\", \"stIdVersion\": \"R-HSA-6785933.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6785921, \"displayName\": \"2-hydroxyacylsphingosine 1-beta-galactosyltransferase (UGT8,...\", \"schemaClass\": \"Summation\", \"text\": \"2-hydroxyacylsphingosine 1-beta-galactosyltransferase (UGT8, GCS) catalyzes the transfer of galactosyl moiety from UDP-galactose (UDP-Gal) to ceramide (CERA), an essential step in the biosynthesis of galactocerebrosides (GalCer), which are abundant sphingolipids of the myelin membrane of the CNS and PNS. UGT8 localizes to the luminal part of the endoplasmic reticulum (ER) membrane (Kapitonov & Yu, 1997; Sprong et al., 1998; reviewed by Liu & Li, 2013).\"}]}" ;
