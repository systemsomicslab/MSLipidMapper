    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [6814766], \"className\": \"CatalystActivity\", \"dbId\": 6814772, \"displayName\": \"phosphatidylcholine lysophospholipase A1 activity of GDPD1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 6814766, \"displayName\": \"GDPD1 hydrolyzes LysoPtdCho\", \"followingEvent\": [6814132], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [6814766], \"dbId\": 6814253, \"displayName\": \"LysoPtdCho [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LysoPtdCho\", \"1-O-acyl-sn-glycero-3-phosphocholine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6814253\", \"stIdVersion\": \"R-ALL-6814253.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [6814766], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 6814770, \"displayName\": \"New members of the mammalian glycerophosphodiester phosphodiesterase family: GDE4 and GDE7 produce lysophosphatidic acid by lysophospholipase D activity\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"4260-71\", \"pubMedIdentifier\": 25528375, \"schemaClass\": \"LiteratureReference\", \"title\": \"New members of the mammalian glycerophosphodiester phosphodiesterase family: GDE4 and GDE7 produce lysophosphatidic acid by lysophospholipase D activity\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25528375\", \"volume\": 290, \"year\": 2015}], \"maxDepth\": 1, \"name\": [\"GDPD1 hydrolyzes LysoPtdCho\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1498750, \"displayName\": \"GPCho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GPCho\", \"choline alfoscerate\", \"GroPCho\", \"Glycerol 3-phosphocholine\", \"glycerophosphocholine\"], \"producedByEvent\": [6814766], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498750\", \"stIdVersion\": \"R-ALL-1498750.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524021, \"displayName\": \"LCFA(-) [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [6814766], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524021\", \"stIdVersion\": \"R-ALL-1524021.3\"}], \"releaseDate\": \"2016-03-23\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6814766\", \"stIdVersion\": \"R-HSA-6814766.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6814780, \"displayName\": \"GDPD1 (Glycerophosphodiester phosphodiesterase domain-contai...\", \"schemaClass\": \"Summation\", \"text\": \"GDPD1 (Glycerophosphodiester phosphodiesterase domain-containing protein 1, also known as GDE4 - Glycerophosphodiester phosphodiesterase 4) associated with the endoplasmic reticulum membrane catalyzes the hydrolysis of LysoPtcCho (lysophosphatidylcholine) to GPCho (glycerophosphocholine) and LCFA (long chain fatty acid). The human protein has been characterized only to a limited extent; its enzymatic activity and predominant intracellular localization are inferred from in vitro studies of the recombinant homologous mouse protein (Oshima et al. 2015).\"}]}" ;
