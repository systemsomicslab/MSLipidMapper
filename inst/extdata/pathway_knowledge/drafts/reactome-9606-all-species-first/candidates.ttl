    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9840949], \"className\": \"CatalystActivity\", \"dbId\": 1606828, \"displayName\": \"cerebroside-sulfatase activity of active ARSA:Ca2+ [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 9840949, \"displayName\": \"ARSA removes sulfate from SM3\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9840949], \"dbId\": 9840879, \"displayName\": \"SM3 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SM3\", \"beta-D-3-sulfogalactosyl-(1->4)-beta-D-glucosyl-(1<->1')-ceramide(1-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9840879\", \"stIdVersion\": \"R-ALL-9840879.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9840949], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9840952, \"displayName\": \"Characterization of urinary sulfatides in metachromatic leukodystrophy using electrospray ionization-tandem mass spectrometry\", \"journal\": \"Mol Genet Metab\", \"pages\": \"30-7\", \"pubMedIdentifier\": 11350180, \"schemaClass\": \"LiteratureReference\", \"title\": \"Characterization of 