\", \"inferredFrom\": [9025957], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DPAn-6 to 14(S)-HDPAn-6\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9025957\", \"stIdVersion\": \"R-RNO-9025957.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092793, \"displayName\": \"ALOX12:Fe2+ oxidises DPAn-6 to 14(S)-HDPAn-6\", \"inferredFrom\": [9025957], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DPAn-6 to 14(S)-HDPAn-6\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9025957\", \"stIdVersion\": \"R-MMU-9025957.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9025960, \"displayName\": \"14(S)-HDPAn-6 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"14(S)-HDPAn-6\", \"(4Z,7Z,10Z,12E,14S,16Z)-14-hydroxydocosapentaenoate\", \"14(S)-HDPAn-6(1-)\", \"(4Z,7Z,10Z,12E,14S,16Z)-14-hydroxydocosapentaenoic acid\", \"14(S)-hydroxy-omega-6-docosapentaenoic acid\"], \"producedByEvent\": [9025957], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9025960\", \"stIdVersion\": \"R-ALL-9025960.5\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9025957\", \"stIdVersion\": \"R-HSA-9025957.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9025958, \"displayName\": \"The main product of ω-6 docosapentaenoic acid (DPAn-6) oxyge...\", \"schemaClass\": \"Summation\", \"text\": \"The main product of ω-6 docosapentaenoic acid (DPAn-6) oxygenation by 12-lipoxygenase (ALOX12:Fe2+) is 14(S)-hydroxy-DPAn-6 (14(S)-HDPAn-6) (Dangi et al. 2009, 2010, Dobson et al. 2013). The final product is produced via a hydroperoxy intermediate, which is then reduced to the corresponding hydroxy compound (these details not described here and also, the human enzymes involved in these reactions are unknown). This DPAn-6 product is analogous in structure and action to DHA (docosahexaenoic acid)-derived resolvins (Dangi et al. 2010).\"}]}" ;
