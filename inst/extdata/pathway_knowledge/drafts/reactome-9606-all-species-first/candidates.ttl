    mslm:equation "H2O [lysosomal lumen] + PALM-CoA [lysosomal lumen] => H+ [lysosomal lumen] + CoA-SH [lysosomal lumen] + PALM [lysosomal lumen]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [5690046], \"className\": \"CatalystActivity\", \"dbId\": 5690062, \"displayName\": \"palmitoyl hydrolase activity of PPT2 [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690712, \"displayName\": \"RHEA:16646\", \"identifier\": \"16646\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/16646\"}], \"dbId\": 5690046, \"displayName\": \"PPT2 hydrolyses PALMCoA to PALM\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [5690046], \"dbId\": 5690537, \"displayName\": \"PALM-CoA [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PALM-CoA\", \"palmitoyl-CoA(4-)\", \"palmitoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5690537\", \"stIdVersion\": \"R-ALL-5690537.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [5690046], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 5690372, \"displayName\": \"New players on the metabolic stage: How do you like Them Acots?\", \"journal\": \"Adipocyte\", \"pages\": \"3-6\", \"pubMedIdentifier\": 23700546, \"schemaClass\": \"LiteratureReference\", \"title\": \"New players on the metabolic stage: How do you like Them Acots?\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/23700546\", \"volume\": 2, \"year\": 2013}, {\"className\": \"LiteratureReference\", \"dbId\": 5690404, \"displayName\": \"The emerging role of acyl-CoA thioesterases and acyltransferases in regulating peroxisomal lipid metabolism\", \"journal\": \"Biochim. Biophys. Acta\", \"pages\": \"1397-410\", \"pubMedIdentifier\": 22465940, \"schemaClass\": \"LiteratureReference\", \"title\": \"The emerging role of acyl-CoA thioesterases and acyltransferases in regulating peroxisomal lipid metabolism\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/22465940\", \"volume\": 1822, \"year\": 2012}, {\"className\": \"LiteratureReference\", \"dbId\": 5690397, \"displayName\": \"Functional and structural properties of mammalian acyl-coenzyme A thioesterases\", \"journal\": \"Prog. Lipid Res.\", \"pages\": \"366-77\", \"pubMedIdentifier\": 20470824, \"schemaClass\": \"LiteratureReference\", \"title\": \"Functional and structural properties of mammalian acyl-coenzyme A thioesterases\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/20470824\", \"volume\": 49, \"year\": 2010}, {\"className\": \"LiteratureReference\", \"dbId\": 5690545, \"displayName\": \"Molecular cloning and expression of palmitoyl-protein thioesterase 2 (PPT2), a homolog of lysosomal palmitoyl-protein thioesterase with a distinct substrate specificity\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"27456-63\", \"pubMedIdentifier\": 9341199, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular cloning and expression of palmitoyl-protein thioesterase 2 (PPT2), a homolog of lysosomal palmitoyl-protein thioesterase with a distinct substrate specificity\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9341199\", \"volume\": 272, \"year\": 1997}], \"maxDepth\": 1, \"name\": [\"PPT2 hydrolyses PALMCoA to PALM\", \"H2O + hexadecanoyl-CoA => CoA + H(+) + hexadecanoate\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11036777, \"displayName\": \"PPT2 hydrolyses PALMCoA to PALM\", \"inferredFrom\": [5690046], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPT2 hydrolyses PALMCoA to PALM\", \"H2O + hexadecanoyl-CoA => CoA + H(+) + hexadecanoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-5690046\", \"stIdVersion\": \"R-DDI-5690046.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10890883, \"displayName\": \"PPT2 hydrolyses PALMCoA to PALM\", \"inferredFrom\": [5690046], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPT2 hydrolyses PALMCoA to PALM\", \"H2O + hexadecanoyl-CoA => CoA + H(+) + hexadecanoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-5690046\", \"stIdVersion\": \"R-DME-5690046.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10710346, \"displayName\": \"PPT2 hydrolyses PALMCoA to PALM\", \"inferredFrom\": [5690046], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPT2 hydrolyses PALMCoA to PALM\", \"H2O + hexadecanoyl-CoA => CoA + H(+) + hexadecanoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-5690046\", \"stIdVersion\": \"R-XTR-5690046.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10625610, \"displayName\": \"PPT2 hydrolyses PALMCoA to PALM\", \"inferredFrom\": [5690046], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPT2 hydrolyses PALMCoA to PALM\", \"H2O + hexadecanoyl-CoA => CoA + H(+) + hexadecanoate\"], \"releaseD