    mslm:directionality mslm:SourceForward ;
    mslm:equation "PI3P [late endosome membrane] + ATP [cytosol] => PI(3,5)P2 [late endosome membrane] + ADP [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [1675910], \"className\": \"CatalystActivity\", \"dbId\": 1806250, \"displayName\": \"1-phosphatidylinositol-3-phosphate 5-kinase activity of PIKFYVE:VAC14:FIG4 [late endosome membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0031902\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 172574, \"definition\": \"The lipid bilayer surrounding a late endosome.\", \"displayName\": \"late endosome membrane\", \"name\": \"late endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031902\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12689745, \"displayName\": \"RHEA:13609\", \"identifier\": \"13609\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/13609\"}], \"dbId\": 1675910, \"displayName\": \"PI3P is phosphorylated to PI(3,5)P2 by PIKFYVE at the late endosome membrane\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1675910], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [1675910], \"dbId\": 1806198, \"displayName\": \"PI3P [late endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI3P\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate(3-)\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806198\", \"stIdVersion\": \"R-ALL-1806198.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1675786, \"displayName\": \"Myotubularin lipid phosphatase binds the hVPS15/hVPS34 lipid kinase complex on endosomes\", \"journal\": \"Traffic\", \"pages\": \"1052-67\", \"pubMedIdentifier\": 17651088, \"schemaClass\": \"LiteratureReference\", \"title\": \"Myotubularin lipid phosphatase binds the hVPS15/hVPS34 lipid kinase complex on endosomes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17651088\", \"volume\": 8, \"year\": 2007}, {\"className\": \"LiteratureReference\", \"dbId\": 1675955, \"displayName\": \"PIKfyve, a mammalian ortholog of yeast Fab1p lipid kinase, synthesizes 5-phosphoinositides. Effect of insulin\", \"journal\": \"J Biol Chem\", \"pages\": \"21589-97\", \"pubMedIdentifier\": 10419465, \"schemaClass\": \"LiteratureReference\", \"title\": \"PIKfyve, a mammalian ortholog of yeast Fab1p lipid kinase, synthesizes 5-phosphoinositides. Effect of insulin\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/10419465\", \"volume\": 274, \"year\": 1999}, {\"className\": \"LiteratureReference\", \"dbId\": 1675790, \"displayName\": \"Core protein machinery for mammalian phosphatidylinositol 3,5-bisphosphate synthesis and turnover that regulates the progression of endosomal transport. Novel Sac phosphatase joins the ArPIKfyve-PIKfyve complex\", \"journal\": \"J Biol Chem\", \"pages\": \"23878-91\", \"pubMedIdentifier\": 17556371, \"schemaClass\": \"LiteratureReference\", \"title\": \"Core protein machinery for mammalian phosphatidylinositol 3,5-bisphosphate synthesis and turnover that regulates the progression of endosomal transport. Novel Sac phosphatase joins the ArPIKfyve-PIKfyve complex\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17556371\", \"volume\": 282, \"year\": 2007}, {\"className\": \"LiteratureReference\", \"dbId\": 1676068, \"displayName\": \"Phosphatidylinositol 3-phosphate-interacting domains in PIKfyve. Binding specificity and role in PIKfyve. Endomenbrane localization\", \"journal\": \"J Biol Chem\", \"pages\": \"6073-9\", \"pubMedIdentifier\": 11706043, \"schemaClass\": \"LiteratureReference\", \"title\": \"Phosphatidylinositol 3-phosphate-interacting domains in PIKfyve. Binding specificity and role in PIKfyve. Endomenbrane localization\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11706043\", \"volume\": 277, \"year\": 2002}], \"maxDepth\": 1, \"name\": [\"PI3P is phosphorylated to PI(3,5)P2 by PIKFYVE at the late endosome membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [1675910], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1806289, \"displayName\": \"PI(3,5)P2 [late endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2\", \"1-phosphatidyl-1D-myo-inositol 3,5-bisphosphate(5-)\", \"1-phosphatidyl-1D-myo-inositol 3,5-bisphosphate\"], \"producedByEvent\": [1675910], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806289\", \"stIdVersion\": \"R-ALL-1806289.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676020, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI3P by FIG4 at the late endosome membrane\", \"followingEvent\": [1675910], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI3P by FIG4 at the late endosome membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676020\", \"stIdVersion\": \"R-HSA-1676020.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676024, \"displayName\": \"PI is phosphorylated to PI3P by PIK3C2A/3 at the late endosome membrane\", \"followingEvent\": [1675910], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI is phosphorylated to PI3P by PIK3C2A/3 at the late endosome membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676024\", \"stIdVersion\": \"R-HSA-1676024.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675910\", \"stIdVersion\": \"R-HSA-1675910.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1675837, \"displayName\": \"At the late endosome membrane, the PAS complex, consisting o...\", \"schemaClass\": \"Summation\", \"text\": \"At the late endosome membrane, the PAS complex, consisting of FYVE finger-containing phosphoinositide kinase (PIKFYVE), yeast VAC14 homologue (VAC14), and polyphosphoinositide phosphatase aka SAC3 (FIG4), binds to the membrane via PIKFYVE's FYVE finger (Sbrissa et al. 2002, Cao et al. 2007).  The PIKFYVE kinase component phosphorylates phosphatidylinositol 3-phosphate (PI3P) to phosphatidylinositol 3,5-bisphosphate PI(3,5)P2 (Sbrissa et al. 1999).  The PAS complex is present in the cytosol and is recruited to the membrane (Sbrissa et al. 2007).\"}]}" ;
