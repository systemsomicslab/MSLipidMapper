Id\": 10048528, \"displayName\": \"Arachidonate is converted to HXA3/B3 by ALOX12\", \"inferredFrom\": [2161794], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Arachidonate is converted to HXA3/B3 by ALOX12\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2161794\", \"stIdVersion\": \"R-MMU-2161794.1\"}], \"output\": [{\"className\": \"Set\", \"dbId\": 2162031, \"displayName\": \"HXA3/B3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"HXA3/B3\"], \"producedByEvent\": [2161794], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-2162031\", \"stIdVersion\": \"R-ALL-2162031.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 428990, \"displayName\": \"SLC27A1 transports arachidonate across the ER membrane\", \"followingEvent\": [2161794], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC27A1 transports arachidonate across the ER membrane\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate(out) = (5Z,8Z,11Z,14Z)-eicosatetraenoate(in)\"], \"releaseDate\": \"2012-12-04\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428990\", \"stIdVersion\": \"R-HSA-428990.5\"}], \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161794\", \"stIdVersion\": \"R-HSA-2161794.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2161935, \"displayName\": \"Arachidonate 12-lipoxygenase, 12S-type (ALOX12) converts ara...\", \"schemaClass\": \"Summation\", \"text\": \"Arachidonate 12-lipoxygenase, 12S-type (ALOX12) converts arachidonate to both hepoxilin A3 (HXA3) and B3 (HXB3).  They both incorporate an epoxide across the C-11 and C-12 double bond, as well as an additional hydroxyl moiety with HXA3 having a C-8 hydroxyl, whereas the HXB3 hydroxyl occurs at C-10 (Sutherland et al. 2001, Nigam et al. 2004).\"}]}" ;
