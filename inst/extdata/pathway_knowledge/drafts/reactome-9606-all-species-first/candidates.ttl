    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8875077], \"className\": \"CatalystActivity\", \"dbId\": 8875075, \"displayName\": \"very long-chain fatty acid-CoA ligase activity of SLC27A3 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12689960, \"displayName\": \"RHEA:54537\", \"identifier\": \"54537\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/54537\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9865934, \"displayName\": \"RHEA:54537\", \"identifier\": \"54537\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/54537\"}], \"dbId\": 8875077, \"displayName\": \"SLC27A3 ligates CoA-SH to VLCFA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8875077], \"dbId\": 113593, \"displayName\": \"ATP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113593\", \"stIdVersion\": \"R-ALL-113593.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8875077], \"dbId\": 29374, \"displayName\": \"CoA-SH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"CoA\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29374\", \"stIdVersion\": \"R-ALL-29374.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8875077], \"dbId\": 5696008, \"displayName\": \"VLCFA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"VLCFA\", \"very long-chain fatty acid anion\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5696008\", \"stIdVersion\": \"R-ALL-5696008.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 5696002, \"displayName\": \"Evidence for 26 distinct acyl-coenzyme A synthetase genes in the human genome\", \"journal\": \"J. Lipid Res.\", \"pages\": \"2736-50\", \"pubMedIdentifier\": 17762044, \"schemaClass\": \"LiteratureReference\", \"title\": \"Evidence for 26 distinct acyl-coenzyme A synthetase genes in the human genome\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17762044\", \"volume\": 48, \"year\": 2007}, {\"className\": \"LiteratureReference\", \"dbId\": 8875074, \"displayName\": \"Mouse very long-chain Acyl-CoA synthetase 3/fatty acid transport protein 3 catalyzes fatty acid activation but not fatty acid transport in MA-10 cells\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"54454-62\", \"pubMedIdentifier\": 15469937, \"schemaClass\": \"LiteratureReference\", \"title\": \"Mouse very long-chain Acyl-CoA synthetase 3/fatty acid transport protein 3 catalyzes fatty acid activation but not fatty acid transport in MA-10 cells\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15469937\", \"volume\": 279, \"year\": 2004}], \"maxDepth\": 1, \"name\": [\"SLC27A3 ligates CoA-SH to VLCFA\", \"a very long-chain fatty acid + ATP + CoA => a very long-chain fatty acyl-CoA + AMP + diphosphate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 5696003, \"displayName\": \"VLCFA-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"VLCFA-CoA\", \"very long-chain fatty acyl-CoA(4-)\"], \"producedByEvent\": [8875077], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5696003\", \"stIdVersion\": \"R-ALL-5696003.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 159448, \"displayName\": \"AMP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AMP\", \"adenosine 5'-monophosphate(2-)\", \"adenosine 5'-monophosphate\", \"Adenylic acid\", \"Adenylate\", \"5'-AMP\", \"5'-Adenylic acid\", \"5'-Adenosine monophosphate\"], \"producedByEvent\": [8875077], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-159448\", \"stIdVersion\": \"R-ALL-159448.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 159450, \"displayName\": \"PPi [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [8875077], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-159450\", \"stIdVersion\": \"R-ALL-159450.5\"}], \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8875077\", \"stIdVersion\": \"R-HSA-8875077.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8875079, \"displayName\": \"Acyl-coenzyme A synthetases catalyse the activation of fatty...\", \"schemaClass\": \"Summation\", \"text\": \"Acyl-coenzyme A synthetases catalyse the activation of fatty acids by thioesterification to CoA, the fundamental initial reaction in fatty acid oxidation. Members of the long chain acyl-coenzyme A synthetases (ACSVL) subfamily were originally thought to be fatty acid transport proteins (FATPs), hence their approved gene names and symbols are “solute carrier family 27 (fatty acid transporter) member x\\\" (SLC27Ax) but their transport function has never been proven. Instead, their amino acid sequence contains two highly conserved motifs characteristic of acyl-CoA synthetases. Long-chain fatty acid transport protein 3 (SLC27A3, aka ACSVL3, FATP3) preferentially ligates CoA-SH to very long-chain fatty acids (VLCFA) (Watkins et al. 2007). The activity of human SLC27A3 is inferred from mouse Slc27a3 functional studies (Pei et al. 2004).\"}]}" ;
