    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [2317530], \"className\": \"CatalystActivity\", \"dbId\": 9987239, \"displayName\": \"protein sequestering activity of SREBP1A,1C,2:SCAP [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9987234, \"displayName\": \"protein sequestering activity of SREBP1A,1C,2:SCAP [endoplasmic reticulum membrane] Insig required for sterol-mediated inhibition of Scap/SREBP binding to COPII proteins in vitro\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 2317530, \"displayName\": \"SREBP1A,1C,2 binds SCAP:cholesterol:INSIG and is retained in the endoplasmic reticulum\", \"goBiologicalProcess\": {\"accession\": \"0098544\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 5263256, \"definition\": \"Any process in which a protein complex is maintained in a location and prevented from moving elsewhere. These include sequestration, stabilization to prevent transport elsewhere and the active retrieval of protein complexes that move away.\", \"displayName\": \"maintenance of protein complex location\", \"name\": \"maintenance of protein complex location\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0098544\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [2317530], \"dbId\": 2317520, \"displayName\": \"SREBP1A,1C,2:SCAP [endoplasmic reticulum membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"SREBP1A,1C,2:SCAP\", \"SREBF1A,1C,2:SCAP\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2317520\", \"stIdVersion\": \"R-HSA-2317520.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [2317530, 2317530, 2317530, 2317530], \"dbId\": 1655749, \"displayName\": \"INSIG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"INSIG\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1655749\", \"stIdVersion\": \"R-HSA-1655749.1\"}, 1655749, 1655749, 1655749, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [2317530, 2317530, 2317530, 2317530], \"dbId\": 193384, \"displayName\": \"CHOL [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CHOL\", \"cholesterol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193384\", \"stIdVersion\": \"R-ALL-193384.3\"}, 193384, 193384, 193384], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SREBP1A,1C,2 binds SCAP:cholesterol:INSIG and is retained in the endoplasmic reticulum\", \"SREBF1A,1C,2 binds SCAP:cholesterol:INSIG and is retained in the endoplasmic reticulum\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 1655766, \"displayName\": \"SREBP1A,1C,2:SCAP:cholesterol:INSIG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 4, \"name\": [\"SREBP1A,1C,2:SCAP:cholesterol:INSIG\", \"SREBF1A,1C,2:SCAP:cholesterol:INSIG\"], \"producedByEvent\": [2317530], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1655766\", \"stIdVersion\": \"R-HSA-1655766.1\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2012-09-18\", \"releaseStatus\": \"UPDATED\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2317530\", \"stIdVersion\": \"R-HSA-2317530.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2317537, \"displayName\": \"SREBPs (SREBP1A/1C/2, SREBFs) bind SCAP in the endoplasmic r...\", \"schemaClass\": \"Summation\", \"text\": \"SREBPs (SREBP1A/1C/2, SREBFs) bind SCAP in the endoplasmic reticulum membrane. Luminal loop 1 of SCAP binds cholesterol which prevents SCAP from interacting with Sec24 in the CopII coat complex and allows SCAP to interact with INSIG instead. These interactions retain SCAP:SREBP1A/1C/2 in the endoplasmic reticulum. The order of assembly of the SREBP1A/1C/2:SCAP:cholesterol:INSIG complex is unknown.\"}]}" ;
