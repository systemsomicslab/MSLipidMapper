n\", \"dbId\": 1638104, \"displayName\": \"UGCG transfers glucose to ceramide\", \"followingEvent\": [9851347], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"UGCG transfers glucose to ceramide\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1638104\", \"stIdVersion\": \"R-HSA-1638104.4\"}], \"releaseDate\": \"2023-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9851347\", \"stIdVersion\": \"R-HSA-9851347.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9845275, \"displayName\": \"Beta-1,4-galactosyltransferases 5 and 6 (B4GALT5/6) catalyze...\", \"schemaClass\": \"Summation\", \"text\": \"Beta-1,4-galactosyltransferases 5 and 6 (B4GALT5/6) catalyze the transfer of galactose from UDP-α-D-galactose onto glucosylceramide (GlcCer) to produce lactosylceramide (LacCer). LacCer is the primary precursor in the biosynthesis of complex glycosphingolipids (Tokuda et al., 2013; Yamaji & Hanada, 2014; reviewed by Chatterjee et al., 2021).\"}]}" ;
