<https://reactome.org/content/detail/R-HSA-9025998> a mslm:LipidReaction ;
    rdfs:label "Epoxide hydrolase hydrolyses 13,14-epoxy-DPAn-3 to MaR1n-3 DPA or MaR2n-3 DPA" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "13,14(S)-epoxy-DPAn-3 [cytosol] + H2O [cytosol] => MaR1n-3 DPA, MaR2n-3 DPA [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9025998], \"className\": \"CatalystActivity\", \"dbId\": 9025026, \"displayName\": \"epoxide hydrolase activity of Epoxide hydrolase [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9025998, \"displayName\": \"Epoxide hydrolase hydrolyses 13,14-epoxy-DPAn-3 to MaR1n-3 DPA or MaR2n-3 DPA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9025998], \"dbId\": 9026307, \"displayName\": \"13,14(S)-epoxy-DPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"13,14(S)-epoxy-DPAn-3\", \"(7Z,9E,11E,16Z,19Z)-13,14-epoxydocosapentaenoate\", \"13,14(S)-epoxy-docosapentaenoic acid\", \"(7Z,9E,11E,16Z,19Z)-13,14-epoxydocosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9026307\", \"stIdVersion\": \"R-ALL-9026307.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9025998], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9025095, \"displayName\": \"Novel n-3 immunoresolvents: structures and actions\", \"journal\": \"Sci Rep\", \"pages\": \"1940\", \"pubMedIdentifier\": 23736886, \"schemaClass\": \"LiteratureReference\", \"title\": \"Novel n-3 immunoresolvents: structures and actions\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/23736886\", \"volume\": 3, \"year\": 2013}, {\"className\": \"LiteratureReference\", \"dbId\": 9026317, \"displayName\": \"Total synthesis of the anti-inflammatory and pro-resolving lipid mediator MaR1n-3 DPA utilizing an sp(3) -sp(3) Negishi cross-coupling reaction\", \"journal\": \"Chemistry\", \"pages\": \"14575-8\", \"pubMedIdentifier\": 25225129, \"schemaClass\": \"LiteratureReference\", \"title\": \"Total synthesis of the anti-inflammatory and pro-resolving lipid mediator MaR1n-3 DPA utilizing an sp(3) -sp(3) Negishi cross-coupling reaction\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25225129\", \"volume\": 20, \"year\": 2014}], \"maxDepth\": 1, \"name\": [\"Epoxide hydrolase hydrolyses 13,14-epoxy-DPAn-3 to MaR1n-3 DPA or MaR2n-3 DPA\"], \"output\": [{\"className\": \"Set\", \"dbId\": 9026321, \"displayName\": \"MaR1n-3 DPA, MaR2n-3 DPA [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"MaR1n-3 DPA, MaR2n-3 DPA\"], \"producedByEvent\": [9025998], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9026321\", \"stIdVersion\": \"R-ALL-9026321.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9026007, \"displayName\": \"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DPAn-3 to 13,14-epoxy-DPAn-3\", \"followingEvent\": [9025998], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DPAn-3 to 13,14-epoxy-DPAn-3\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026007\", \"stIdVersion\": \"R-HSA-9026007.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9025998\", \"stIdVersion\": \"R-HSA-9025998.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9026323, \"displayName\": \"In a reaction scheme similar to the one for DHA-derived mare...\", \"schemaClass\": \"Summation\", \"text\": \"In a reaction scheme similar to the one for DHA-derived maresins, 13,14(S)-epoxy-docosapentaenoic acid (13,14(S)-epoxy-DPAn-3) can be hydrolysed by an epoxide hydrolase to form either 7(R),14(S)-dihydroxy-docosapentaenoic acid (MaR1n-3 DPA) or 13,14(S)-dihydroxy-docosapentaenoic acid (MaR2n-3 DPA) (Dalli et al. 2013). MaR1n-3 DPA and MaR2n-3 DPA are named after maresin-1 (derived from DHA) as they share an alcohol group at C14 and are proposed to possess similar anti-inflammatory and proresolving potency and activity as maresin-1. With human leukocytes these n-3 DPA-SPMs reduced neutrophil chemotaxis, adhesion and enhanced macrophage phagocytosis (Dalli et al. 2013, Vik et al. 2017). The total chemical synthesis of MaR1n-3 DPA had been reported for the first time in 2014 (Tungen et al. 2014).\"}]}" ;
