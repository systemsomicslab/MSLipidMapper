ansition\", \"className\": \"Reaction\", \"dbId\": 1482776, \"displayName\": \"PS is hydrolyzed to 1-acyl LPS by PLA2G2A\", \"followingEvent\": [1482636], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PS is hydrolyzed to 1-acyl LPS by PLA2G2A\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482776\", \"stIdVersion\": \"R-HSA-1482776.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482636\", \"stIdVersion\": \"R-HSA-1482636.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482620, \"displayName\": \"At the endoplasmic reticulum (ER) membrane, lysophospholipid...\", \"schemaClass\": \"Summation\", \"text\": \"At the endoplasmic reticulum (ER) membrane, lysophospholipid acyltransferases acylate 1-acyl lysophosphatidylserine (LPS) to form phosphatidylserine (PS).  The lysophospholipid acyltransferases involved are: lysophospholipid acyltransferase 5 (LPCAT3) (Gijon et al. 2008, Hishikawa et al. 2008); lysophospholipid acyltransferase LPCAT4 (LPCAT4) aka LPEAT2 (Cao et al. 2008); or lysophospholipid acyltransferase 1 (MBOAT1) aka LPEAT1 (Hishikawa et al. 2008, Gijon et al. 2008).\"}]}" ;
