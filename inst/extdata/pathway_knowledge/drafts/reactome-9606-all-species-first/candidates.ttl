d\": \"R-MMU-2161999\", \"stIdVersion\": \"R-MMU-2161999.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142678, \"displayName\": \"12S-HETE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"12S-HETE\", \"12(S)-HETE(1-)\", \"12(S)-HETE\"], \"producedByEvent\": [2161999], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142678\", \"stIdVersion\": \"R-ALL-2142678.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111745, \"displayName\": \"GSSG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GSSG\", \"glutathione disulfide(2-)\", \"oxidized glutathione\", \"glutathione disulfide\"], \"producedByEvent\": [2161999], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111745\", \"stIdVersion\": \"R-ALL-111745.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [2161999], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2161964, \"displayName\": \"Arachidonate is oxidised to 12S-HpETE by ALOX12/15\", \"followingEvent\": [2161999], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Arachidonate is oxidised to 12S-HpETE by ALOX12/15\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate + O2 => (12S)-hydroperoxy-(5Z,8Z,10E,14Z)-eicosatetraenoate\"], \"releaseDate\": \"2012-03-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161964\", \"stIdVersion\": \"R-HSA-2161964.4\"}], \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161999\", \"stIdVersion\": \"R-HSA-2161999.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2162050, \"displayName\": \"Glutathione peroxidase 1 (GPX1) (Bryant et al. 1982, Sutherl...\", \"schemaClass\": \"Summation\", \"text\": \"Glutathione peroxidase 1 (GPX1) (Bryant et al. 1982, Sutherland et al. 2001), 2 (GPX2) (Chu et al. 1993), and 4 (Bryant et al. 1982, Sutherland et al. 2001) are involved in converting 12S-hydroperoxy-eicosatetraenoic acid (12S-HpETE) to 12S-hydro-eicosatetraenoic acid (12S-HETE).  GPXs are selenoenzymes that are responsible for reducing the cellular peroxide.  Cellular GPXs compete with hepoxilins A3 (HXA3) synthase for 12S-HpETE as substrate either to produce 12S-HETE or to convert to HXA3, respectively.\"}]}" ;
