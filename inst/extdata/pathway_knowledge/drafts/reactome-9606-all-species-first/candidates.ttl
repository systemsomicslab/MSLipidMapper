<https://reactome.org/content/detail/R-HSA-9027044> a mslm:LipidReaction ;
    rdfs:label "CYP4 ω-oxidises 14(R)-HDHA to MaR-L2" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "H+ [cytosol] + NADPH [cytosol] + O2 [cytosol] + 14(R)-HDHA [cytosol] => H2O [cytosol] + NADP+ [cytosol] + MaR-L2 [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9027044], \"className\": \"CatalystActivity\", \"dbId\": 9020576, \"displayName\": \"monooxygenase activity of CYP4 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 9027044, \"displayName\": \"CYP4 ω-oxidises 14(R)-HDHA to MaR-L2\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027044], \"dbId\": 9027049, \"displayName\": \"14(R)-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"14(R)-HDHA\", \"(14R)-HDoHE(1-)\", \"(14R)-HDHA(1-)\", \"14(R)-hydroxy-docosahexaenoic acid\", \"(14R)-HDoHE\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9027049\", \"stIdVersion\": \"R-ALL-9027049.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027044], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027044], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027044], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9027018, \"displayName\": \"Maresin-like lipid mediators are produced by leukocytes and platelets and rescue reparative function of diabetes-impaired macrophages\", \"journal\": \"Chem. Biol.\", \"pages\": \"1318-1329\", \"pubMedIdentifier\": 25200603, \"schemaClass\": \"LiteratureReference\", \"title\": \"Maresin-like lipid mediators are produced by leukocytes and platelets and rescue reparative function of diabetes-impaired macrophages\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25200603\", \"volume\": 21, \"year\": 2014}], \"maxDepth\": 1, \"name\": [\"CYP4 ω-oxidises 14(R)-HDHA to MaR-L2\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9027045, \"displayName\": \"MaR-L2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MaR-L2\", \"(4Z,7Z,10Z,12E,14R,16Z,19Z)-14,22-dihydroxydocosahexaenoate\", \"maresin-L2(1-)\", \"14(R),22-dihydroxy-docosahexaenoic acid\", \"(4Z,7Z,10Z,12E,14R,16Z,19Z)-14,22-dihydroxydocosahexaenoic acid\", \"14(R),22-diHDHA\"], \"producedByEvent\": [9027044], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9027045\", \"stIdVersion\": \"R-ALL-9027045.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [9027044], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [9027044], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9027043, \"displayName\": \"CYPs hydroxylate DHA to 14(R)-HDHA\", \"followingEvent\": [9027044], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYPs hydroxylate DHA to 14(R)-HDHA\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027043\", \"stIdVersion\": \"R-HSA-9027043.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027044\", \"stIdVersion\": \"R-HSA-9027044.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9027311, \"displayName\": \"Cytochrome P450 (CYP) enzymes are thought to ω-hydroxylate (...\", \"schemaClass\": \"Summation\", \"text\": \"Cytochrome P450 (CYP) enzymes are thought to ω-hydroxylate (position 22) 14(R)-hydroxy-docosahexaenoic acid (14(R)-HDHA) to 14(R),22-dihydroxy-docosahexaenoic acid, namely maresin-like mediator 2 (MaR-L2) (Hong et al. 2014). CYP inhibition was found to decrease the amount of MaR-L2 formed (Hong et al. 2014). The exact CYP responsible for MaR-L2 formation is unknown but is likely to be a member of the CYP4 family as those enzymes mediate the ω-hydroxylation of fatty acids and eicosanoids (Kikuta et al. 2002). Diabetes results in delayed- or non-healing of wounds and is associated with impaired macrophage function (Brem & Tomic-Canic 2007). Leukocytes and platelets play critical roles in wound healing by mechanisms as yet unknown. Maresin-like mediators MaR-L1 and Mar-L2 are produced by leukocytes and platelets and have been shown (in vitro) to restore reparative functions of diabetic macrophages in wounds (Hong et al. 2014).\"}]}" ;
