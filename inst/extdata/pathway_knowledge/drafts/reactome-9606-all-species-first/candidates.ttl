    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [193068], \"className\": \"CatalystActivity\", \"dbId\": 193113, \"displayName\": \"steroid 17-alpha-monooxygenase activity of CYP17A1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9913419, \"displayName\": \"RHEA:50237\", \"identifier\": \"50237\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/50237\"}], \"dbId\": 193068, \"displayName\": \"CYP17A1 17-hydroxylates PREG\", \"followingEvent\": [193070], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193068], \"dbId\": 193103, \"displayName\": \"PREG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PREG\", \"pregnenolone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193103\", \"stIdVersion\": \"R-ALL-193103.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [193068], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [193068], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [193068], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 193045, \"displayName\": \"Molecular modeling of human P450c17 (17alpha-hydroxylase/17,20-lyase): insights into reaction mechanisms and effects of mutations\", \"journal\": \"Mol Endocrinol\", \"pages\": \"1169-82\", \"pubMedIdentifier\": 10406467, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular modeling of human P450c17 (17alpha-hydroxylase/17,20-lyase): insights into reaction mechanisms and effects of mutations\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/10406467\", \"volume\": 13, \"year\": 1999}], \"maxDepth\": 1, \"name\": [\"CYP17A1 17-hydroxylates PREG\", \"O2 + pregnenolone + reduced (NADPH--hemoprotein reductase) => 17alpha-hydroxypregnenolone + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\", \"Hydroxylation of pregnenolone to form 17alpha-hydroxypregnenolone\", \"pregnenolone + NADPH + H+ => 17alpha-hydroxypregnenolone + NADP+ + H2O\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction