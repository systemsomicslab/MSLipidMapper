me\": \"Reaction\", \"dbId\": 10092861, \"displayName\": \"ALOX5 oxidises DHA to 7-HDHA\", \"inferredFrom\": [9027624], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises DHA to 7-HDHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9027624\", \"stIdVersion\": \"R-MMU-9027624.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9028274, \"displayName\": \"7-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7-HDHA\", \"(4Z,8E,10Z,13Z,16Z,19Z)-7-hydroxydocosahexaenoate\", \"(4Z,8E,10Z,13Z,16Z,19Z)-7-hydroxydocosahexaenoic acid\", \"7-HDoHE\", \"7-hydroxy-docosahexaenoic acid\"], \"producedByEvent\": [9027624], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9028274\", \"stIdVersion\": \"R-ALL-9028274.6\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027624\", \"stIdVersion\": \"R-HSA-9027624.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9028292, \"displayName\": \"In human neutrophils, 5-lipoxygenase (ALOX5) can mediate the...\", \"schemaClass\": \"Summation\", \"text\": \"In human neutrophils, 5-lipoxygenase (ALOX5) can mediate the lipoxygenation of docosahexaenoic acid (DHA) to 7-hydroxy-docosahexaenoic acid (7-HDHA) (Cipollina et al. 2014). Neutrophils treated with an ALOX5 inhibitor completely suppressed the formation of 7-oxo-DHA and its hydroxy precursor 7-HDHA, demonstrating that ALOX5 mediates the first step in 5-oxo-DHA biosynthesis (Cipollina et al. 2014).\"}]}" ;
