isplayName\": \"LTA4 is converted to LTC4 by LTC4S\", \"inferredFrom\": [266050], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4 is converted to LTC4 by LTC4S\", \"glutathione + leukotriene A4 => leukotriene C4\", \"LTA4 conjugates with glutathione to form LTC4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-266050\", \"stIdVersion\": \"R-DRE-266050.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10476902, \"displayName\": \"LTA4 is converted to LTC4 by LTC4S\", \"inferredFrom\": [266050], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4 is converted to LTC4 by LTC4S\", \"glutathione + leukotriene A4 => leukotriene C4\", \"LTA4 conjugates with glutathione to form LTC4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-266050\", \"stIdVersion\": \"R-SSC-266050.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10362051, \"displayName\": \"LTA4 is converted to LTC4 by LTC4S\", \"inferredFrom\": [266050], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4 is converted to LTC4 by LTC4S\", \"glutathione + leukotriene A4 => leukotriene C4\", \"LTA4 conjugates with glutathione to form LTC4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-266050\", \"stIdVersion\": \"R-BTA-266050.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10135360, \"displayName\": \"LTA4 is converted to LTC4 by LTC4S\", \"inferredFrom\": [266050], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4 is converted to LTC4 by LTC4S\", \"glutathione + leukotriene A4 => leukotriene C4\", \"LTA4 conjugates with glutathione to form LTC4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-266050\", \"stIdVersion\": \"R-RNO-266050.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10013589, \"displayName\": \"LTA4 is converted to LTC4 by LTC4S\", \"inferredFrom\": [266050], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4 is converted to LTC4 by LTC4S\", \"glutathione + leukotriene A4 => leukotriene C4\", \"LTA4 conjugates with glutathione to form LTC4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-266050\", \"stIdVersion\": \"R-MMU-266050.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 266066, \"displayName\": \"LTC4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LTC4\", \"leukotriene C4(2-)\", \"leukotriene C4\"], \"producedByEvent\": [266050], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-266066\", \"stIdVersion\": \"R-ALL-266066.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 266051, \"displayName\": \"5S-HpETE is dehydrated to LTA4 by ALOX5\", \"followingEvent\": [266050], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"5S-HpETE is dehydrated to LTA4 by ALOX5\", \"(5S)-hydroperoxy-(6E,8Z,11Z,14Z)-eicosatetraenoate => H2O + leukotriene A4\", \"Dehydration of 5-HpETE to leukotriene A4\"], \"releaseDate\": \"2008-12-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-266051\", \"stIdVersion\": \"R-HSA-266051.4\"}], \"releaseDate\": \"2008-12-17\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-266050\", \"stIdVersion\": \"R-HSA-266050.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 266015, \"displayName\": \"Leukotriene A4 conjugates with reduced glutathione (GSH) to ...\", \"schemaClass\": \"Summation\", \"text\": \"Leukotriene A4 conjugates with reduced glutathione (GSH) to produce leukotriene C4 (LTC4). This conjugation is mediated by the homodimeric, perinuclear membrane-bound enzyme leukotriene C4 synthase (LTC4S) (Lam et al. 1994, Welsch et al. 1994).  LTC4S differs from cytosolic and microsomal GSH-S-transferases by having a very narrow substrate specificity and the inability to conjugate xenobiotics.\"}]}" ;
