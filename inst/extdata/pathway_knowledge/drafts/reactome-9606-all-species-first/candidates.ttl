<https://reactome.org/content/detail/R-HSA-192010> a mslm:LipidReaction ;
    rdfs:label "5beta-cholestan-3alpha, 7alpha, 12alpha-triol is translocated from the cytosol to the mitochondrial matrix" ;
    mslm:curationStatus mslm:Draft ;
