Id\": \"R-CFA-8878654\", \"stIdVersion\": \"R-CFA-8878654.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10209132, \"displayName\": \"ACP6 hydrolyses MYS-LPA\", \"inferredFrom\": [8878654], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACP6 hydrolyses MYS-LPA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8878654\", \"stIdVersion\": \"R-RNO-8878654.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10086114, \"displayName\": \"ACP6 hydrolyses MYS-LPA\", \"inferredFrom\": [8878654], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACP6 hydrolyses MYS-LPA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8878654\", \"stIdVersion\": \"R-MMU-8878654.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8934414, \"displayName\": \"1-MMG [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-MMG\", \"1-monomyristoylglycerol\"], \"producedByEvent\": [8878654], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8934414\", \"stIdVersion\": \"R-ALL-8934414.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113548, \"displayName\": \"Pi [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\"], \"producedByEvent\": [8878654], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113548\", \"stIdVersion\": \"R-ALL-113548.5\"}], \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8878654\", \"stIdVersion\": \"R-HSA-8878654.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8878655, \"displayName\": \"Lysophosphatidic acid (LPA) is a bioactive phospholipid. It ...\", \"schemaClass\": \"Summation\", \"text\": \"Lysophosphatidic acid (LPA) is a bioactive phospholipid. It consists of a single fatty acyl chain, a glycerol backbone and a free phosphate group. The acyl chain can be of varying length and degree of saturation hence many forms of LPA can exist. LPA is an important extracellular signalling molecule and an intermediate lipid in phospholipid metabolism inside the cell, playing an important role in modulating the structure and fluidity of lipid rafts. Degradation of LPA is important for termination of signalling and for the finetuning of lipid raft structure. Degradation of LPA can occur via either acylation or hydrolysis. Lysophosphatidic acid phosphatase type 6 (ACP6) can hydrolyse LPA of varying lengths. It is a monomeric enzyme located in mitochondria where it preferentially hydrolyses myristoyl LPA (C14:0) and other LPAs such as monounsaturated oleate (C18:1) or palmitate (C16:0) (latter two not shown here) (Hiroyama & Takenawa 1999, Li et al. 2013).\"}]}" ;
