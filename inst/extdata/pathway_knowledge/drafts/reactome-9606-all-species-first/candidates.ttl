], \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15S-HpETE to LXA4/B4\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11027066, \"displayName\": \"ALOX5 oxidises 15S-HpETE to LXA4/B4\", \"inferredFrom\": [2161917], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15S-HpETE to LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-2161917\", \"stIdVersion\": \"R-DDI-2161917.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10787392, \"displayName\": \"ALOX5 oxidises 15S-HpETE to LXA4/B4\", \"inferredFrom\": [2161917], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15S-HpETE to LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-2161917\", \"stIdVersion\": \"R-GGA-2161917.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10696271, \"displayName\": \"ALOX5 oxidises 15S-HpETE to LXA4/B4\", \"inferredFrom\": [2161917], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15S-HpETE to LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-2161917\", \"stIdVersion\": \"R-XTR-2161917.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10609668, \"displayName\": \"ALOX5 oxidises 15S-HpETE to LXA4/B4\", \"inferredFrom\": [2161917], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15S-HpETE to LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-2161917\", \"stIdVersion\": \"R-DRE-2161917.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10508547, \"displayName\": \"ALOX5 oxidises 15S-HpETE to LXA4/B4\", \"inferredFrom\": [2161917], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15S-HpETE to LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-2161917\", \"stIdVersion\": \"R-SSC-2161917.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10393540, \"displayName\": \"ALOX5 oxidises 15S-HpETE to LXA4/B4\", \"inferredFrom\": [2161917], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15S-HpETE to LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-2161917\", \"stIdVersion\": \"R-BTA-2161917.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10170458, \"displayName\": \"ALOX5 oxidises 15S-HpETE to LXA4/B4\", \"inferredFrom\": [2161917], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15S-HpETE to LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-2161917\", \"stIdVersion\": \"R-RNO-2161917.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10048553, \"displayName\": \"ALOX5 oxidises 15S-HpETE to LXA4/B4\", \"inferredFrom\": [2161917], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15S-HpETE to LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2161917\", \"stIdVersion\": \"R-MMU-2161917.1\"}], \"output\": [{\"className\": \"Set\", \"dbId\": 2161856, \"displayName\": \"LXA4/B4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"LXA4/B4\"], \"producedByEvent\": [2161917, 2161917], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-2161856\", \"stIdVersion\": \"R-ALL-2161856.1\"}, 2161856], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2162002, \"displayName\": \"Arachidonate is oxidised to 15S-HpETE by ALOX15/15B\", \"followingEvent\": [2161917], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Arachidonate is oxidised to 15S-HpETE by ALOX15/15B\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate + O2 => (15S)-hydroperoxy-(5Z,8Z,11Z,13E)-eicosatetraenoate\"], \"releaseDate\": \"2012-12-04\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2162002\", \"stIdVersion\": \"R-HSA-2162002.4\"}], \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161917\", \"stIdVersion\": \"R-HSA-2161917.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2161765, \"displayName\": \"Arachidonate 5-lipoxygenase (ALOX5) (Ueda et al. 1987) conve...\", \"schemaClass\": \"Summation\", \"text\": \"Arachidonate 5-lipoxygenase (ALOX5) (Ueda et al. 1987) converts 15S-hydroperoxy-eicosatetraenoic acid (15S-HpETE) into lipoxin A4 (LXA4) and B4 (LXB4) (Serhan et al. 1984A, Serhan et al. 1984B).  One of the reaction intermediates of this process might be 5S,6S-epoxy-15S-hydroxy-7E,9E,11Z,13E-eicosatetraenoic acid (5,6-Ep-15S-HETE) (Puustinen et al. 1986).  However, its generation from LTA4 is unclear but it can be hydrolysed to form the lipoxins.\"}]}" ;
