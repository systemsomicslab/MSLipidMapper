<https://reactome.org/content/detail/R-HSA-1655825> a mslm:LipidReaction ;
    rdfs:label "SREBP1A,1C,2:SCAP binds CopII Coat Complex" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "SAR1B:GTP:SEC23:SEC24 [endoplasmic reticulum membrane] + SREBP1A,1C,2:SCAP [endoplasmic reticulum membrane] => SREBP1A,1C,2:SCAP:Cop II Coat [endoplasmic reticulum membrane]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [1655825], \"className\": \"CatalystActivity\", \"dbId\": 9987246, \"displayName\": \"cargo adaptor activity of SREBP1A,1C,2:SCAP [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9987235, \"displayName\": \"cargo adaptor activity of SREBP1A,1C,2:SCAP [endoplasmic reticulum membrane] Cholesterol and 25-hydroxycholesterol inhibit activation of SREBPs by different mechanisms, both involving SCAP and Insigs\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 1655825, \"displayName\": \"SREBP1A,1C,2:SCAP binds CopII Coat Complex\", \"goBiologicalProcess\": {\"accession\": \"0006888\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 22571, \"definition\": \"The directed movement of substances from the endoplasmic reticulum (ER) to the Golgi, mediated by COP II vesicles. Small COP II coated vesicles form from the ER and then fuse directly with the cis-Golgi. Larger structures are transported along microtubules to the cis-Golgi.\", \"displayName\": \"endoplasmic reticulum to Golgi vesicle-mediated transport\", \"name\": \"endoplasmic reticulum to Golgi vesicle-mediated transport\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006888\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [1655825, 1655825, 1655825, 1655825], \"dbId\": 203997, \"displayName\": \"SAR1B:GTP:SEC23:SEC24 [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"SAR1B:GTP:SEC23:SEC24\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-203997\", \"stIdVersion\": \"R-HSA-203997.2\"}, 203997, 203997, 203997, {\"className\": \"Complex\", \"consumedByEvent\": [1655825], \"dbId\": 2317520, \"displayName\": \"SREBP1A,1C,2:SCAP [endoplasmic reticulum membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"SREBP1A,1C,2:SCAP\", \"SREBF1A,1C,2:SCAP\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2317520\", \"stIdVersion\": \"R-HSA-2317520.1\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SREBP1A,1C,2:SCAP binds CopII Coat Complex\", \"SREBF1A,1C,2:SCAP binds CopII Coat Complex\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 1655765, \"displayName\": \"SREBP1A,1C,2:SCAP:Cop II Coat [endoplasmic reticulum membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 5, \"name\": [\"SREBP1A,1C,2:SCAP:Cop II Coat\", \"SREBF1A,1C,2:SCAP:Cop II Coat\"], \"producedByEvent\": [1655825], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1655765\", \"stIdVersion\": \"R-HSA-1655765.1\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2012-09-18\", \"releaseStatus\": \"UPDATED\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1655825\", \"stIdVersion\": \"R-HSA-1655825.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2317544, \"displayName\": \"SREBPs (SREBP1A, SREBP1C, SREBP2, also known as SREBFs) are ...\", \"schemaClass\": \"Summation\", \"text\": \"SREBPs (SREBP1A, SREBP1C, SREBP2, also known as SREBFs) are transmembrane proteins that bind SCAP in the endoplasmic reticulum membrane. In the presence of cholesterol or oxysterols SCAP:SREBP1A/1C/2 binds INSIG and is retained in the endoplasmic reticulum. At cholesterol concentrations below 5 mol%  SCAP changes conformation, SCAP:SREBP1A/1C/2 loses interaction with INSIG, binds the CopII coat complex, and is translocated to the Golgi.\"}]}" ;
