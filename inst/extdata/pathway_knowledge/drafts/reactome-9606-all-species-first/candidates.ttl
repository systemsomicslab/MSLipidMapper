    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8952251], \"className\": \"CatalystActivity\", \"dbId\": 8952250, \"displayName\": \"A2-type glycerophospholipase activity of PLA2G15 [extracellular region]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 8952251, \"displayName\": \"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8952251], \"dbId\": 2173763, \"displayName\": \"lysoPC [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"lysoPC\", \"lysophosphatidylcholine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2173763\", \"stIdVersion\": \"R-ALL-2173763.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8952251], \"dbId\": 109276, \"displayName\": \"H2O [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109276\", \"stIdVersion\": \"R-ALL-109276.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8952262, \"displayName\": \"Cloning and expression of a novel lysophospholipase which structurally resembles lecithi