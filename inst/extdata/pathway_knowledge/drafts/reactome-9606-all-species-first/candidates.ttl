 {\"className\": \"LiteratureReference\", \"dbId\": 196356, \"displayName\": \"Structure/function relationships responsible for coenzyme specificity and the isomerase activity of human type 1 3 beta-hydroxysteroid dehydrogenase/isomerase\", \"journal\": \"J Biol Chem\", \"pages\": \"35483-90\", \"pubMedIdentifier\": 12832414, \"schemaClass\": \"LiteratureReference\", \"title\": \"Structure/function relationships responsible for coenzyme specificity and the isomerase activity of human type 1 3 beta-hydroxysteroid dehydrogenase/isomerase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12832414\", \"volume\": 278, \"year\": 2003}], \"maxDepth\": 1, \"name\": [\"Pregn-5-ene-3,20-dione isomerizes to progesterone\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10849938, \"displayName\": \"Pregn-5-ene-3,20-dione isomerizes to progesterone\", \"inferredFrom\": [193052], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Pregn-5-ene-3,20-dione isomerizes to progesterone\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-193052\", \"stIdVersion\": \"R-DME-193052.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10580385, \"displayName\": \"Pregn-5-ene-3,20-dione isomerizes to progesterone\", \"inferredFrom\": [193052], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Pregn-5-ene-3,20-dione isomerizes to progesterone\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-193052\", \"stIdVersion\": \"R-DRE-193052.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10470543, \"displayName\": \"Pregn-5-ene-3,20-dione isomerizes to progesterone\", \"inferredFrom\": [193052], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Pregn-5-ene-3,20-dione isomerizes to progesterone\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-193052\", \"stIdVersion\": \"R-SSC-193052.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10355701, \"displayName\": \"Pregn-5-ene-3,20-dione isomerizes to progesterone\", \"inferredFrom\": [193052], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Pregn-5-ene-3,20-dione isomerizes to progesterone\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-193052\", \"stIdVersion\": \"R-BTA-193052.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10248561, \"displayName\": \"Pregn-5-ene-3,20-dione isomerizes to progesterone\", \"inferredFrom\": [193052], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Pregn-5-ene-3,20-dione isomerizes to progesterone\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-193052\", \"stIdVersion\": \"R-CFA-193052.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10128266, \"displayName\": \"Pregn-5-ene-3,20-dione isomerizes to progesterone\", \"inferredFrom\": [193052], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Pregn-5-ene-3,20-dione isomerizes to progesterone\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-193052\", \"stIdVersion\": \"R-RNO-193052.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007311, \"displayName\": \"Pregn-5-ene-3,20-dione isomerizes to progesterone\", \"inferredFrom\": [193052], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Pregn-5-ene-3,20-dione isomerizes to progesterone\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193052\", \"stIdVersion\": \"R-MMU-193052.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193055, \"displayName\": \"P4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"P4\", \"progesterone\"], \"producedByEvent\": [193052], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193055\", \"stIdVersion\": \"R-ALL-193055.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 196350, \"displayName\": \"Pregnenolone is dehydrogenated to form pregn-5-ene-3,20-dione\", \"followingEvent\": [193052], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Pregnenolone is dehydrogenated to form pregn-5-ene-3,20-dione\", \"Pregnenolone + NAD+ => pregn-5-ene-3,20-dione + NADH + H+\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-196350\", \"stIdVersion\": \"R-HSA-196350.2\"}], \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 1449722, \"displayName\": \"Positive regulation by 'glyco-Lutropin [extracellular region]'\", \"regulatedEntity\": [193052], \"schemaClass\": \"PositiveRegulation\", \"stId\": \"R-HSA-1449722\", \"stIdVersion\": \"R-HSA-1449722.2\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193052\", \"stIdVersion\": \"R-HSA-193052.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193122, \"displayName\": \"Pregn-5-ene-3,20-dione isomerizes to progesterone. This reac...\", \"schemaClass\": \"Summation\", \"text\": \"Pregn-5-ene-3,20-dione isomerizes to progesterone. This reaction is catalyzed by the isomerase activity of 3 beta-HSD, associated with the endoplasmic reticulum membrane. The active form of the enzyme is a homodimer. The enzyme occurs in two isoforms that are similar in their biochemical properties but differ in their tissue expression: type I (HSD3B1) is found in placenta and skin, while type II (HSD3B2) is found in the adrenal glands and gonads.<br>The hormone lutropin (LH) triggers ovulation and development of the corpus luteum, that in turn increases production of progesterone.\"}]}" ;
