    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [192123], \"className\": \"CatalystActivity\", \"dbId\": 192037, \"displayName\": \"oxidoreductase activity, acting on NAD(P)H as acceptor of CYP27A1 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690645, \"displayName\": \"RHEA:43837\", \"identifier\": \"43837\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/43837\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9987900, \"displayName\": \"RHEA:43837\", \"identifier\": \"43837\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/43837\"}], \"dbId\": 192123, \"displayName\": \"CYP27A1 27-hydroxylates CHOL\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [192123], \"dbId\": 193840, \"displayName\": \"CHOL [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CHOL\", \"cholesterol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193840\", \"stIdVersion\": \"R-ALL-193840.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [192123], \"dbId\": 113600, \"displayName\": \"NADPH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113600\", \"stIdVersion\": \"R-ALL-113600.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [192123], \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [192123], \"dbId\": 113533, \"displayName\": \"O2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113533\", \"stIdVersion\": \"R-ALL-113533.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 192197, \"displayName\": \"Characterization of human sterol 27-hydroxylase. A mitochondrial cytochrome P-450 that catalyzes multiple oxidation reaction in bile acid biosynthesis.\", \"journal\": \"J Biol Chem\", \"pages\": \"7774-8\", \"pubMedIdentifier\": 1708392, \"schemaClass\": \"LiteratureReference\", \"title\": \"Characterization of human sterol 27-hydroxylase. A mitochondrial cytochrome P-450 that catalyzes multiple oxidation reaction in bile acid biosynthesis.\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/1708392\", \"volume\": 266, \"year\": 1991}], \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates CHOL\", \"cholesterol + H(+) + NADPH + O2 => 26-hydroxycholesterol + H2O + NADP(+)\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10580307, \"displayName\": \"CYP27A1 27-hydroxylates CHOL\", \"inferredFrom\": [192123], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates CHOL\", \"cholesterol + H(+) + NADPH + O2 => 26-hydroxycholesterol + H2O + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-192123\", \"stIdVersion\": \"R-DRE-192123.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10470434, \"displayName\": \"CYP27A1 27-hydroxylates CHOL\", \"inferredFrom\": [192123], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates CHOL\", \"cholesterol + H(+) + NADPH + O2 => 26-hydroxycholesterol + H2O + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-192123\", \"stIdVersion\": \"R-SSC-192123.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10355584, \"displayName\": \"CYP27A1 27-hydroxylates CHOL\", \"inferredFrom\": [192123], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates CHOL\", \"cholesterol + H(+) + NADPH + O2 => 26-hydroxycholesterol + H2O + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-192123\", \"stIdVersion\": \"R-BTA-192123.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10248493, \"displayName\": \"CYP27A1 27-hydroxylates CHOL\", \"inferredFrom\": [192123], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates CHOL\", \"cholesterol + H(+) + NADPH + O2 => 26-hydroxycholesterol + H2O + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-192123\", \"stIdVersion\": \"R-CFA-192123.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10128098, \"displayName\": \"CYP27A1 27-hydroxylates CHOL\", \"inferredFrom\": [192123], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates CHOL\", \"cholesterol + H(+) + NADPH + O2 => 26-hydroxycholesterol + H2O + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-192123\", \"stIdVersion\": \"R-RNO-192123.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007164, \"displayName\": \"CYP27A1 27-hydroxylates CHOL\", \"inferredFrom\": [192123], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates CHOL\", \"cholesterol + H(+) + NADPH + O2 => 26-hydroxycholesterol + H2O + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-192123\", \"stIdVersion\": \"R-MMU-192123.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193846, \"displayName\": \"27OH-CHOL [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"27OH-CHOL\", \"26-hydroxycholesterol\", \"27-hydroxycholesterol\"], \"producedByEvent\": [192123], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193846\", \"stIdVersion\": \"R-ALL-193846.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [192123], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113563, \"displayName\": \"NADP+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [192123], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113563\", \"stIdVersion\": \"R-ALL-113563.6\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192123\", \"stIdVersion\": \"R-HSA-192123.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 192152, \"displayName\": \"Cholesterol (CHOL), NADPH + H+, and O2 react to form 27-hydr...\", \"schemaClass\": \"Summation\", \"text\": \"Cholesterol (CHOL), NADPH + H+, and O2 react to form 27-hydroxycholesterol (27OH-CHOL), H2O, and NADP+, in the mitochondrial matrix, catalysed by CYP27A1. 27OH-CHOL is the most abundant oxysterol in human plasma. Its formation is thought to play a central role in the mobilization of CHOL from non-hepatic tissues (Cali et al. 1991).\"}]}" ;
