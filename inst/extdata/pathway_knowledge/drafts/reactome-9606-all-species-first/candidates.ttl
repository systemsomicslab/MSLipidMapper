": 10079384, \"displayName\": \"PECR reduces 2E-phytenoyl-CoA to phytanoyl-CoA\", \"inferredFrom\": [6809810], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PECR reduces 2E-phytenoyl-CoA to phytanoyl-CoA\", \"a (2E)-enoyl-CoA + H(+) + NADPH => a 2,3-saturated acyl-CoA + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6809810\", \"stIdVersion\": \"R-MMU-6809810.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389556, \"displayName\": \"NADP+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [6809810], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389556\", \"stIdVersion\": \"R-ALL-389556.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 389615, \"displayName\": \"Phytanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Phytanoyl-CoA\", \"phytanoyl-CoA(4-)\"], \"producedByEvent\": [6809810], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389615\", \"stIdVersion\": \"R-ALL-389615.3\"}], \"releaseDate\": \"2016-03-23\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6809810\", \"stIdVersion\": \"R-HSA-6809810.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6809812, \"displayName\": \"PECR associated with the peroxisomal membrane catalyzes the ...\", \"schemaClass\": \"Summation\", \"text\": \"PECR associated with the peroxisomal membrane catalyzes the NADPH-dependent reduction of 2E-phytenoyl-CoA to form phytanoyl-CoA (Das et al. 2000; Gloerich et al. 2006). The active form of the enzyme is inferred to be a homotetramer from unpublished data deposited in PDB (accession 1YXM). This reaction is part of the process by which dietary phytol, ultimately derived from chlorophyll, is catabolized (Van Veldhoven 2010).\"}]}" ;
