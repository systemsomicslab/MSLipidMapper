aClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9695949\", \"stIdVersion\": \"R-BTA-9695949.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10326726, \"displayName\": \"SPHK2 phosphorylates sphingoid\", \"inferredFrom\": [9695949], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SPHK2 phosphorylates sphingoid\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9695949\", \"stIdVersion\": \"R-CFA-9695949.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10219205, \"displayName\": \"SPHK2 phosphorylates sphingoid\", \"inferredFrom\": [9695949], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SPHK2 phosphorylates sphingoid\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9695949\", \"stIdVersion\": \"R-RNO-9695949.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10095933, \"displayName\": \"SPHK2 phosphorylates sphingoid\", \"inferredFrom\": [9695949], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SPHK2 phosphorylates sphingoid\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9695949\", \"stIdVersion\": \"R-MMU-9695949.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [9695949], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [9695949], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 5279322, \"displayName\": \"S1P [cytoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"S1P\", \"sphingoid 1-phosphate(1-)\", \"sphingoid 1-phosphate\", \"phys-ent-participant40241\", \"phys-ent-participant40259\"], \"producedByEvent\": [9695949], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5279322\", \"stIdVersion\": \"R-ALL-5279322.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 428696, \"displayName\": \"PLPP1,2,3 dephosphorylate cytosolic sphingosine-1-phosphate\", \"followingEvent\": [9695949], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PLPP1,2,3 dephosphorylate cytosolic sphingosine-1-phosphate\", \"sphingosine 1-phosphate + H2O => sphingosine + orthophosphate [cytosolic - PPAP]\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428696\", \"stIdVersion\": \"R-HSA-428696.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 428123, \"displayName\": \"KDSR reduces 3-ketosphingoid\", \"followingEvent\": [9695949], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"KDSR reduces 3-ketosphingoid\", \"3-ketosphingoid + NADPH + H+ => sphingoid + NADP+\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428123\", \"stIdVersion\": \"R-HSA-428123.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 428231, \"displayName\": \"ACER1 hydrolyzes ceramide (endoplasmic reticulum)\", \"followingEvent\": [9695949], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ACER1 hydrolyzes ceramide (endoplasmic reticulum)\", \"ceramide + H2O <=> fatty acid + sphingosine (endoplasmic reticulum)\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428231\", \"stIdVersion\": \"R-HSA-428231.4\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"regulatedBy\": [{\"className\": \"NegativeRegulation\", \"dbId\": 9695921, \"displayName\": \"Negative regulation by 'SPHK2:SPHK2 inhibitors [cytosol]'\", \"regulatedEntity\": [9695949], \"schemaClass\": \"NegativeRegulation\"}], \"releaseDate\": \"2009-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9695949\", \"stIdVersion\": \"R-HSA-9695949.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9695948, \"displayName\": \"The cytosolic enzyme sphingosine kinase 2 (SPHK2) catalyzes ...\", \"schemaClass\": \"Summation\", \"text\": \"The cytosolic enzyme sphingosine kinase 2 (SPHK2) catalyzes the phosphorylation of sphingoids (SPG) to sphingoid 1-phosphate (S1P). The main product is sphingosine 1-phosphate, a bioactive lipid that acts extracellularly on G protein-coupled receptors of the S1P1/EDG-1 subfamily (Liu et al., 2000; reviewed by Siow & Wattenberg, 2011). Through alternative splicing, the isoforms of SK2a and SK2b are produced that show functional differences in their activity (reviewed by Hatoum et al., 2017). In contrast to pro-survival SPHK1, the BH3-only protein SPHK2 inhibits cell growth and enhances apoptosis (Maceyka et al., 2005).\"}]}" ;
