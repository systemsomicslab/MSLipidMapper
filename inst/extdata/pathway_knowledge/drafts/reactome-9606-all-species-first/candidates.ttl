\", \"stIdVersion\": \"R-MMU-192335.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192342, \"displayName\": \"THCA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"THCA-CoA\", \"(24E)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholest-24-en-26-oyl-CoA(4-)\", \"3alpha,7alpha,12alpha-trihydroxy-5beta-cholest-24-enoyl-CoA\", \"3alpha,7alpha,12alpha-trihydroxy-5beta-cholest-24-en-26-oyl-CoA\"], \"producedByEvent\": [192335], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192342\", \"stIdVersion\": \"R-ALL-192342.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113575, \"displayName\": \"H2O2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O2\", \"hydrogen peroxide\"], \"producedByEvent\": [192335], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113575\", \"stIdVersion\": \"R-ALL-113575.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 192056, \"displayName\": \"Isomerization of 25(R) THCA-CoA to 25(S) THCA-CoA\", \"followingEvent\": [192335], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Isomerization of 25(R) THCA-CoA to 25(S) THCA-CoA\", \"(25R)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oyl-CoA => (25S)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholestan-26-oyl-CoA\", \"25(R) THCA-CoA => 25(S) THCA-CoA\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192056\", \"stIdVersion\": \"R-HSA-192056.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192335\", \"stIdVersion\": \"R-HSA-192335.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 192327, \"displayName\": \"25(S) THCA-CoA and O2 react to form 3alpha,7alpha,12alpha-tr...\", \"schemaClass\": \"Summation\", \"text\": \"25(S) THCA-CoA and O2 react to form 3alpha,7alpha,12alpha-trihydroxy-5beta-cholest-24-enoyl-CoA (THCA-CoA) and H2O2. This dehydrogenation reaction occurs in the peroxisomal matrix. It is catalyzed by the FAD-containing peroxisomal enzyme branched chain acyl-CoA oxidase (ACOX2). The enzyme transfers electrons to molecular oxygen and hydrogen peroxide is produced as a byproduct.\"}]}" ;
