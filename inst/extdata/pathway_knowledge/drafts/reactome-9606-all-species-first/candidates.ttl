\"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [192051], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 192114, \"displayName\": \"7 alpha-hydroxycholesterol [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7 alpha-hydroxycholesterol\", \"7alpha-hydroxycholesterol\"], \"producedByEvent\": [192051], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192114\", \"stIdVersion\": \"R-ALL-192114.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 5340195, \"displayName\": \"NR1H4 binds DCA, CDCA, LCHA\", \"followingEvent\": [192051], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"NR1H4 binds DCA, CDCA, LCHA\", \"FXR binds bile acids\"], \"releaseDate\": \"2015-03-19\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5340195\", \"stIdVersion\": \"R-HSA-5340195.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"regulatedBy\": [{\"className\": \"NegativeRegulation\", \"dbId\": 5340416, \"displayName\": \"Negative regulation by 'NCOA1,2:RXRA:NR1H4:DCA,CDCA,LCHA [nucleoplasm]'\", \"regulatedEntity\": [192051], \"schemaClass\": \"NegativeRegulation\", \"stId\": \"R-HSA-5340416\", \"stIdVersion\": \"R-HSA-5340416.1\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192051\", \"stIdVersion\": \"R-HSA-192051.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 192159, \"displayName\": \"Cholesterol, NADPH + H+, and O2 form 7alpha-cholesterol (5-c...\", \"schemaClass\": \"Summation\", \"text\": \"Cholesterol, NADPH + H+, and O2 form 7alpha-cholesterol (5-cholesten-3beta, 7alpha-diol), NADP+,and H2O, in a reaction catalysed by CYP7A1 (cholesterol 7alpha-hydroylase) in the endoplasmic reticulum membrane. In the body, this enzyme is expressed only in liver, and its expression is tightly regulated at the level of transcription to determine the overall rate of bile acid and bile salt production (Noshiro et al. 1990).\"}]}" ;
