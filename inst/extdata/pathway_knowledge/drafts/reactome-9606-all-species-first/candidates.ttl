    mslm:equation "5beta-cholestan-3alpha,7alpha,12alpha-triol [cytosol] => 5bCHOL3a,7a,12a-triol [mitochondrial matrix]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [192010], \"className\": \"CatalystActivity\", \"dbId\": 9948409, \"displayName\": \"alcohol transmembrane transporter activity of unknown START protein [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9948410, \"displayName\": \"alcohol transmembrane transporter activity of unknown START protein [mitochondrial inner membrane] The enzymes, regulation, and genetics of bile acid synthesis\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 192010, \"displayName\": \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol is translocated from the cytosol to the mitochondrial matrix\", \"followingEvent\": [191999], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [192010], \"dbId\": 192087, \"displayName\": \"5beta-cholestan-3alpha,7alpha,12alpha-triol [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha,7alpha,12alpha-triol\", \"5beta-cholestane-3alpha,7alpha,12alpha-triol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192087\", \"stIdVersion\": \"R-ALL-192087.3\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 192080, \"displayName\": \"The enzymes, regulation, and genetics of bile acid synthesis\", \"journal\": \"Annu Rev Biochem\", \"pages\": \"137-74\", \"pubMedIdentifier\": 12543708, \"schemaClass\": \"LiteratureReference\", \"title\": \"The enzymes, regulation, and genetics of bile acid synthesis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12543708\", \"volume\": 72, \"year\": 2003}], \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha, 7alpha, 12alpha-triol is translocated from the cytosol to the mitochondrial matrix\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192078, \"displayName\": \"5bCHOL3a,7a,12a-triol [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5bCHOL3a,7a,12a-triol\", \"5beta-cholestane-3alpha,7alpha,12alpha-triol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol\"], \"producedByEvent\": [192010], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192078\", \"stIdVersion\": \"R-ALL-192078.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 192036, \"displayName\": \"5Beta-cholesten-7alpha, 12alpha-diol-3-one is reduced to 5beta-cholestan-3alpha, 7alpha, 12alpha-triol\", \"followingEvent\": [192010], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"5Beta-cholesten-7alpha, 12alpha-diol-3-one is reduced to 5beta-cholestan-3alpha, 7alpha, 12alpha-triol\", \"5Beta-cholesten-7alpha, 12alpha-diol-3-one + NADPH + H+ => 5beta-cholestan-3alpha, 7alpha, 12alpha-triol + NAPDP+\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192036\", \"stIdVersion\": \"R-HSA-192036.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192010\", \"stIdVersion\": \"R-HSA-192010.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 192049, \"displayName\": \"5beta-cholestan-3alpha,7alpha,12alpha-triol is translocated ...\", \"schemaClass\": \"Summation\", \"text\": \"5beta-cholestan-3alpha,7alpha,12alpha-triol is translocated from the cytosol to the mitochondrial matrix. The transporter that mediates its passage across the inner mitochondrial membrane is unknown: the StAR protein that performs this function for cholesterol at the start of steroid hormone biosynthesis is excluded as StAR is not expressed in liver. Other members of the START family of transporters are candidates, however (Russell 2003).\"}]}" ;
