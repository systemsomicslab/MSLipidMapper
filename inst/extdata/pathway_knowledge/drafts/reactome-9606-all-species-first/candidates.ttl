    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8870499], \"className\": \"CatalystActivity\", \"dbId\": 9960139, \"displayName\": \"molecular carrier activity of PLEKHA3,8 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9960140, \"displayName\": \"molecular carrier activity of PLEKHA3,8 [Golgi membrane] ARF mediates recruitment of PtdIns-4-OH kinase-beta and stimulates synthesis of PtdIns(4,5)P2 on the Golgi complex\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}], \"dbId\": 8870499, \"displayName\": \"PLEKHA3,8 bind PI4P, ARF1\", \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [8870499], \"dbId\": 8870506, \"displayName\": \"PLEKHA3,8 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PLEKHA3,8\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8870506\", \"stIdVersion\": \"R-HSA-8870506.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8870499], \"dbId\": 1806217, \"displayName\": \"PI4P [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI4P\", \"1-phosphatidyl-1D-myo-inositol 4-phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806217\", \"stIdVersion\": \"R-ALL-1806217.3\"}, {\"className\": \"Protein\", \"consumedByEvent\": [8870499], \"dbId\": 199971, \"displayName\": \"ARF1 [Golgi membrane]\", \"endCoordinate\": 181, \"inDisease\": false,