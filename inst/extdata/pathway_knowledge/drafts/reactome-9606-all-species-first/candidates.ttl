mpleEntity\", \"stId\": \"R-ALL-9028230\", \"stIdVersion\": \"R-ALL-9028230.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [9028273], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9028255, \"displayName\": \"PTGS2 dimer oxidises EPA to PGH3\", \"followingEvent\": [9028273], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PTGS2 dimer oxidises EPA to PGH3\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9028255\", \"stIdVersion\": \"R-HSA-9028255.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9028273\", \"stIdVersion\": \"R-HSA-9028273.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9028227, \"displayName\": \"It is proposed that EPA-derived prostaglandin H3 (PGH3) unde...\", \"schemaClass\": \"Summation\", \"text\": \"It is proposed that EPA-derived prostaglandin H3 (PGH3) undergoes nonenzymatic dehydration to form prostaglandin J3 (PGJ3) (Fitzpatrick et al. 1983, Shibata et al. 2002). EPA supplementation to mice resulted in enhanced endogenous production of 15-deoxy-PGJ3 (15d-PGJ3),