75851], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Btn-ACACA:2Mn2+ polymer carboxylates Ac-CoA to form Mal-CoA\", \"acetyl-CoA + ATP + hydrogencarbonate => ADP + H(+) + malonyl-CoA + phosphate\", \"Formation of Malonyl-CoA from Acetyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-75851\", \"stIdVersion\": \"R-SPO-75851.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11091579, \"displayName\": \"Btn-ACACA:2Mn2+ polymer carboxylates Ac-CoA to form Mal-CoA\", \"inferredFrom\": [75851], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Btn-ACACA:2Mn2+ polymer carboxylates Ac-CoA to form Mal-CoA\", \"acetyl-CoA + ATP + hydrogencarbonate => ADP + H(+) + malonyl-CoA + phosphate\", \"Formation of Malonyl-CoA from Acetyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-75851\", \"stIdVersion\": \"R-SCE-75851.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11119004, \"displayName\": \"Btn-ACACA:2Mn2+ polymer carboxylates Ac-CoA to form Mal-CoA\", \"inferredFrom\": [75851], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Btn-ACACA:2Mn2+ polymer carboxylates Ac-CoA to form Mal-CoA\", \"acetyl-CoA + ATP + hydrogencarbonate => ADP + H(+) + malonyl-CoA + phosphate\", \"Formation of Malonyl-CoA from Acetyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Plasmodium falciparum\", \"stId\": \"R-PFA-75851\", \"stIdVersion\": \"R-PFA-75851.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [75851], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [75851], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29508, \"displayName\": \"Mal-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Mal-CoA\", \"malonyl-CoA(5-)\", \"Malonyl coenzyme A\", \"malonyl-CoA\"], \"producedByEvent\": [75851], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29508\", \"stIdVersion\": \"R-ALL-29508.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [75851], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 75848, \"displayName\": \"ACLY tetramer transforms CIT to Ac-CoA\", \"followingEvent\": [75851], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ACLY tetramer transforms CIT to Ac-CoA\", \"ATP + citrate + CoA => acetyl-CoA + ADP + oxaloacetate + phosphate\", \"Generation of Cytoplasmic Acetyl CoA from Citrate\"], \"releaseDate\": \"2004-07-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-75848\", \"stIdVersion\": \"R-HSA-75848.7\"}, {\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 163743, \"displayName\": \"Transcriptional activation of ACACA by ChREBP:MLX\", \"followingEvent\": [75851], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Transcriptional activation of ACACA by ChREBP:MLX\"], \"releaseDate\": \"2005-09-26\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163743\", \"stIdVersion\": \"R-HSA-163743.7\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 8876882, \"displayName\": \"Positive regulation by 'CIT [cytosol]'\", \"regulatedEntity\": [75851], \"schemaClass\": \"PositiveRegulation\", \"stId\": \"R-HSA-8876882\", \"stIdVersion\": \"R-HSA-8876882.1\"}, {\"className\": \"PositiveRegulation\", \"dbId\": 8878971, \"displayName\": \"Positive regulation by 'MID1IP1:THRSP [cytosol]'\", \"regulatedEntity\": [75851], \"schemaClass\": \"PositiveRegulation\", \"stId\": \"R-HSA-8878971\", \"stIdVersion\": \"R-HSA-8878971.1\"}], \"regulationReference\": [{\"className\": \"RegulationReference\", \"dbId\": 9642107, \"displayName\": \"Positive regulation by 'MID1IP1:THRSP [cytosol]' Hepatic expression of the SPOT 14 (S14) paralog S14-related (Mid1 interacting protein) is regulated by dietary carbohydrate\", \"schemaClass\": \"RegulationReference\"}], \"releaseDate\": \"2004-07-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-75851\", \"stIdVersion\": \"R-HSA-75851.6\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 76211, \"displayName\": \"Cytosolic acetyl-CoA carboxylase 1 (ACACA) catalyzes the rea...\", \"schemaClass\": \"Summation\", \"text\": \"Cytosolic acetyl-CoA carboxylase 1 (ACACA) catalyzes the reaction of bicarbonate, ATP, and acetyl-CoA to form malonyl-CoA, ADP, and orthophosphate. The reaction is positively regulated by citrate. The human ACACA cDNA has been cloned (Abu-Elheiga et al. 1995) and the biochemical properties of the human enzyme have recently been described (Cheng et al. 2007; Locke et al. 2008). Four ACACA isoforms generated by alternative splicing have been identified as mRNAs - the protein product of the first has been characterized experimentally. ACACA uses biotin (Btn) and two Mn2+ ions per subunit as cofactors and its activity is increased by polymerization (Kim et al. 2010, Ingaramo & Beckett 2012). Cytosolic ACACA is thought to maintain regulation of fatty acid synthesis in all tissues but especially lipogenic tissues such as adipose tissue and lactating mammary glands.<br><br>Mid1-interacting protein 1 (MID1IP1, aka MIG12, SPOT14R, S14R) plays a role in the regulation of lipogenesis in the liver. It is rapidly upregulated by processes that induce lipogenesis (enhanced glucose metabolism, thyroid hormone administration) (Tsatsos et al. 2008). MID1IP1 forms a heterodimer with thyroid hormone-inducible hepatic protein (THRSP, aka SPOT14, S14), proposed to play the same role in lipogenesis as MID1IP1 (Aipoalani et al. 2010). This complex can polymerizes in fatty acid (FA) synthesis. Polymerization enhances ACACA and ACACB enzyme activities (Kim et al. 2010).\"}]}" ;
