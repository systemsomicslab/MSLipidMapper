\": \"R-SSC-8952873.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10434621, \"displayName\": \"MECR dimer reduces tdec2-CoA to DEC-CoA\", \"inferredFrom\": [8952873], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MECR dimer reduces tdec2-CoA to DEC-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8952873\", \"stIdVersion\": \"R-BTA-8952873.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10320768, \"displayName\": \"MECR dimer reduces tdec2-CoA to DEC-CoA\", \"inferredFrom\": [8952873], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MECR dimer reduces tdec2-CoA to DEC-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8952873\", \"stIdVersion\": \"R-CFA-8952873.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10212740, \"displayName\": \"MECR dimer reduces tdec2-CoA to DEC-CoA\", \"inferredFrom\": [8952873], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MECR dimer reduces tdec2-CoA to DEC-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8952873\", \"stIdVersion\": \"R-RNO-8952873.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10089616, \"displayName\": \"MECR dimer reduces tdec2-CoA to DEC-CoA\", \"inferredFrom\": [8952873], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MECR dimer reduces tdec2-CoA to DEC-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8952873\", \"stIdVersion\": \"R-MMU-8952873.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 77308, \"displayName\": \"DEC-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DEC-CoA\", \"decanoyl-CoA(4-)\", \"decanoyl-CoA\"], \"producedByEvent\": [8952873], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77308\", \"stIdVersion\": \"R-ALL-77308.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113563, \"displayName\": \"NADP+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [8952873], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113563\", \"stIdVersion\": \"R-ALL-113563.6\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 109998, \"displayName\": \"Isomerization of 3-trans-decenoyl-CoA to form trans-dec-2-enoyl-CoA\", \"followingEvent\": [8952873], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Isomerization of 3-trans-decenoyl-CoA to form trans-dec-2-enoyl-CoA\", \"3E)-decenoyl-CoA => (2E)-decenoyl-CoA\"], \"releaseDate\": \"2004-07-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-109998\", \"stIdVersion\": \"R-HSA-109998.4\"}], \"releaseDate\": \"2017-03-27\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8952873\", \"stIdVersion\": \"R-HSA-8952873.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8952861, \"displayName\": \"Mitochondrial trans-2-enoyl-CoA reductase (MECR aka NBRF1) i...\", \"schemaClass\": \"Summation\", \"text\": \"Mitochondrial trans-2-enoyl-CoA reductase (MECR aka NBRF1) is a dimeric oxidoreductase with a preference for short and medium chain trans fatty acyl-CoA substrates and may play a role in mitochondrial fatty acid synthesis (Chen et al. 2008). MECR is able to reduce trans acyl-CoA substrates of chain length C6 to C16 in an NADPH-dependent manner (Miinalainen et al. 2003). A representative reaction described here is the reduction of trans-dec-2-enoyl-CoA (tdec2-CoA) to decanoyl-CoA (DEC-CoA).\"}]}" ;
