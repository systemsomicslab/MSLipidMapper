    mslm:equation "5beta-cholestan-3alpha,7alpha,26-triol [cytosol] => 5beta-cholestan-3alpha,7alpha,26-triol [mitochondrial matrix]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [193808], \"className\": \"CatalystActivity\", \"dbId\": 9948409, \"displayName\": \"alcohol transmembrane transporter activity of unknown START protein [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9948410, \"displayName\": \"alcohol transmembrane transporter activity of unknown START protein [mitochondrial inner membrane] The enzymes, regulation, and genetics of bile acid synthesis\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 193808, \"displayName\": \"5beta-cholestan-3alpha,7alpha,27-triol is translocated from the cytosol to the mitochondrial matrix\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193808], \"dbId\": 193842, \"displayName\": \"5beta-cholestan-3alpha,7alpha,26-triol [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha,7alpha,26-triol\", \"5beta-cholestane-3alpha,7alpha,26-triol\", \"5beta-cholestan-3alpha,7alpha,27-triol\", \"5beta-cholestan-3alpha,7alpha,27-triol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193842\", \"stIdVersion\": \"R-ALL-193842.5\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 192080, \"displayName\": \"The enzymes, regulation, and genetics of bile acid synthesis\", \"journal\": \"Annu Rev Biochem\", \"pages\": \"137-74\", \"pubMedIdentifier\": 12543708, \"schemaClass\": \"LiteratureReference\", \"title\": \"The enzymes, regulation, and genetics of bile acid synthesis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12543708\", \"volume\": 72, \"year\": 2003}], \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha,7alpha,27-triol is translocated from the cytosol to the mitochondrial matrix\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193387, \"displayName\": \"5beta-cholestan-3alpha,7alpha,26-triol [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha,7alpha,26-triol\", \"5beta-cholestane-3alpha,7alpha,26-triol\"], \"producedByEvent\": [193808], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193387\", \"stIdVersion\": \"R-ALL-193387.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193841, \"displayName\": \"5beta-cholestan-7alpha,27-diol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,27-triol\", \"followingEvent\": [193808], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-7alpha,27-diol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,27-triol\", \"5beta-cholestan-7alpha,27-diol-3-one+ NADPH + H+ => 5beta-cholestan-3alpha,7alpha,27-triol + NADP+\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193841\", \"stIdVersion\": \"R-HSA-193841.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193808\", \"stIdVersion\": \"R-HSA-193808.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193809, \"displayName\": \"5beta-cholestan-3alpha,7alpha,27-triol is transported from t...\", \"schemaClass\": \"Summation\", \"text\": \"5beta-cholestan-3alpha,7alpha,27-triol is transported from the cytosol to the mitochondrial matrix. The transporter that mediates its passage across the inner mitochondrial membrane is unknown: the StAR protein that performs this function for cholesterol at the start of steroid hormone biosynthesis is excluded as StAR is not expressed in liver. Other members of the START family of transporters are candidates, however (Russell 2003).\"}]}" ;
