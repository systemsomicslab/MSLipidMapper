    mslm:equation "H2O [cytosol] + 16(S),17(S)-epoxy-DPAn-3 [cytosol] => PD1n-3DPA,PD2n-3DPA [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9026000], \"className\": \"CatalystActivity\", \"dbId\": 9025026, \"displayName\": \"epoxide hydrolase activity of Epoxide hydrolase [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9026000, \"displayName\": \"Epoxide hydrolase hydrolyses 16(S),17(S)-epoxy-DPAn-3 to PD1n-3DPA or PD2n-3DPA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9026000], \"dbId\": 9026046, \"displayName\": \"16(S),17(S)-epoxy-DPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"16(S),17(S)-epoxy-DPAn-3\", \"(16S,17S)-epoxy-(7Z,10Z,12E,14E,19Z)-docosapentaenoate\", \"16(S),17(S)-epoxy-DPA(n-3)(1-)\", \"(16S,17S)-epoxy-(7Z,10Z,12E,14E,19Z)-docosapentaenoic acid\", \"16(S),17(S)-epoxy-omega3-docosapentaenoic acid\", \"16(S),17(S)-epoxy-docosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9026046\", \"stIdVersion\": \"R-ALL-9026046.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9026000], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9026026, \"displayName\": \"Stereocontrolled synthesis and investigation of the biosynthetic transformations of 16(S),17(S)-epoxy-PDn-3 DPA\", \"journal\": \"Org. Biomol. Chem.\", \"pubMedIdentifier\": 28980694, \"schemaClass\": \"LiteratureReference\", \"title\": \"Stereocontrolled synthesis and investigation of the biosynthetic transformations of 16(S),17(S)-epoxy-PDn-3 DPA\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/28980694\", \"year\": 2017}, {\"className\": \"LiteratureReference\", \"dbId\": 9025095, \"displayName\": \"Novel n-3 immunoresolvents: structures and actions\", \"journal\": \"Sci Rep\", \"pages\": \"1940\", \"pubMedIdentifier\": 23736886, \"schemaClass\": \"LiteratureReference\", \"title\": \"Novel n-3 immunoresolvents: structures and actions\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/23736886\", \"volume\": 3, \"year\": 2013}, {\"className\": \"LiteratureReference\", \"dbId\": 9026037, \"displayName\": \"Total synthesis of the lipid mediator PD1n-3 DPA: configurational assignments and anti-inflammatory and pro-resolving actions\", \"journal\": \"J. Nat. Prod.\", \"pages\": \"910-6\", \"pubMedIdentifier\": 24576195, \"schemaClass\": \"LiteratureReference\", \"title\": \"Total synthesis of the lipid mediator PD1n-3 DPA: configurational assignments and anti-inflammatory and pro-resolving actions\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/24576195\", \"volume\": 77, \"year\": 2014}], \"maxDepth\": 1, \"name\": [\"Epoxide hydrolase hydrolyses 16(S),17(S)-epoxy-DPAn-3 to PD1n-3DPA or PD2n-3DPA\"], \"output\": [{\"className\": \"Set\", \"dbId\": 9026023, \"displayName\": \"PD1n-3DPA,PD2n-3DPA [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PD1n-3DPA,PD2n-3DPA\"], \"producedByEvent\": [9026000], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9026023\", \"stIdVersion\": \"R-ALL-9026023.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9025999, \"displayName\": \"ALOX5 dehydrogenates 17(S)-Hp-DPAn-3 to 16(S),17(S)-epoxy-DPAn-3\", \"followingEvent\": [9026000], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX5 dehydrogenates 17(S)-Hp-DPAn-3 to 16(S),17(S)-epoxy-DPAn-3\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9025999\", \"stIdVersion\": \"R-HSA-9025999.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026000\", \"stIdVersion\": \"R-HSA-9026000.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9026049, \"displayName\": \"In neutrophils, an epoxide hydrolase can hydrolyse 16(S),17(...\", \"schemaClass\": \"Summation\", \"text\": \"In neutrophils, an epoxide hydrolase can hydrolyse 16(S),17(S)-epoxy-docosapentaenoic acid (16(S),17(S)-epoxy-DPAn-3) to either 10(R),17(S)-dihydroxy-docosapentaenoic acid (PD1n-3DPA) or 16,17(S)-dihydroxy-docosapentaenoic acid (PD2n-3DPA) (Dalli et al. 2013). The formation of these protectins is supported by chemical synthesis experiments (Aursnes et al. 2014, Primdahl et al. 2017). These DPAn-3-derived protectins demonstrate potent anti-inflammatory activities together with pro-resolving actions, stimulating human macrophage phagocytosis and efferocytosis (Dalli et al. 2013, Aursnes et al. 2014, Primdahl et al. 2017, Gobbetti et al. 2017).\"}]}" ;
