ed\": true, \"maxDepth\": 1, \"name\": [\"GM2A binds and mobilizes ligands\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1605717\", \"stIdVersion\": \"R-CFA-1605717.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 9840631, \"displayName\": \"GM2A:Ligands [lysosomal lumen]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"GM2A:Ligands\"], \"producedByEvent\": [1605717], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840631\", \"stIdVersion\": \"R-HSA-9840631.1\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 9840579, \"displayName\": \"GM1 localizes to ILV membrane\", \"followingEvent\": [1605717], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GM1 localizes to ILV membrane\"], \"releaseDate\": \"2023-09-13\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840579\", \"stIdVersion\": \"R-HSA-9840579.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1605595, \"displayName\": \"bHEXA hydrolyzes GM2A:GM2 to GM2A:GM3\", \"followingEvent\": [1605717], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"bHEXA hydrolyzes GM2A:GM2 to GM2A:GM3\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605595\", \"stIdVersion\": \"R-HSA-1605595.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9840884, \"displayName\": \"bHEXA,bHEXS hydrolyze GM2A:SM2\", \"followingEvent\": [1605717], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"bHEXA,bHEXS hydrolyze GM2A:SM2\"], \"releaseDate\": \"2023-09-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840884\", \"stIdVersion\": \"R-HSA-9840884.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605717\", \"stIdVersion\": \"R-HSA-1605717.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9840630, \"displayName\": \"Ganglioside GM2 activator (GM2A, GM2AP) acts as carrier prot...\", \"schemaClass\": \"Summation\", \"text\": \"Ganglioside GM2 activator (GM2A, GM2AP) acts as carrier protein solubilizing the membrane-bound glycolipids GM1, GM2, GA1, GA2, and SM2A, functioning as a cofactor in their enzymatic degradation. GM2A is essential for the hydrolysis of GM2, and defects in GM2A function lead to GM2 gangliosidosis AB (MIM:272750), also known as Tay-Sachs disease AB variant (Schroeder et al., 1991; Wilkening et al., 2000; reviewed by Sandhoff & Sandhoff, 2018).\"}]}" ;
