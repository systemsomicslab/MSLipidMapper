tifier\": 11012668, \"schemaClass\": \"LiteratureReference\", \"title\": \"Dual metabolic pathway of 25-hydroxyvitamin D3 catalyzed by human CYP24\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11012668\", \"volume\": 267, \"year\": 2000}], \"maxDepth\": 1, \"name\": [\"CYP24A1 hydroxylates 1,25(OH)2D, inactivating it\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10253079, \"displayName\": \"CYP24A1 hydroxylates 1,25(OH)2D, inactivating it\", \"inferredFrom\": [209765], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP24A1 hydroxylates 1,25(OH)2D, inactivating it\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-209765\", \"stIdVersion\": \"R-CFA-209765.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10938064, \"displayName\": \"CYP24A1 hydroxylates 1,25(OH)2D, inactivating it\", \"inferredFrom\": [209765], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP24A1 hydroxylates 1,25(OH)2D, inactivating it\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-209765\", \"stIdVersion\": \"R-CEL-209765.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10853118, \"displayName\": \"CYP24A1 hydroxylates 1,25(OH)2D, inactivating it\", \"inferredFrom\": [209765], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP24A1 hydroxylates 1,25(OH)2D, inactivating it\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-209765\", \"stIdVersion\": \"R-DME-209765.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10584108, \"displayName\": \"CYP24A1 hydroxylates 1,25(OH)2D, inactivating it\", \"inferredFrom\": [209765], \"isInDisease\": false, \"is