\": \"Reaction\", \"dbId\": 10470652, \"displayName\": \"Chenodeoxycholoyl CoA reacts with glycine or taurine to form glycochenodeoxycholate or taurochenodeoxycholate\", \"inferredFrom\": [193491], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Chenodeoxycholoyl CoA reacts with glycine or taurine to form glycochenodeoxycholate or taurochenodeoxycholate\", \"chenodeoxycholoyl-CoA + glycine => CoA + glycochenodeoxycholate + H(+)\", \"chenodeoxycholoyl-CoA + taurine => CoA + H(+) + taurochenodeoxycholate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-193491\", \"stIdVersion\": \"R-SSC-193491.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10248665, \"displayName\": \"Chenodeoxycholoyl CoA reacts with glycine or taurine to form glycochenodeoxycholate or taurochenodeoxycholate\", \"inferredFrom\": [193491], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Chenodeoxycholoyl CoA reacts with glycine or taurine to form glycochenodeoxycholate or taurochenodeoxycholate\", \"chenodeoxycholoyl-CoA + glycine => CoA + glycochenodeoxycholate + H(+)\", \"chenodeoxycholoyl-CoA + taurine => CoA + H(+) + taurochenodeoxycholate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-193491\", \"stIdVersion\": \"R-CFA-193491.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10128400, \"displayName\": \"Chenodeoxycholoyl CoA reacts with glycine or taurine to form glycochenodeoxycholate or taurochenodeoxycholate\", \"inferredFrom\": [193491], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Chenodeoxycholoyl CoA reacts with glycine or taurine to form glycochenodeoxycholate or taurochenodeoxycholate\", \"chenodeoxycholoyl-CoA + glycine => CoA + glycochenodeoxycholate + H(+)\", \"chenodeoxycholoyl-CoA + taurine => CoA + H(+) + taurochenodeoxycholate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-193491\", \"stIdVersion\": \"R-RNO-193491.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007431, \"displayName\": \"Chenodeoxycholoyl CoA reacts with glycine or taurine to form glycochenodeoxycholate or taurochenodeoxycholate\", \"inferredFrom\": [193491], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Chenodeoxycholoyl CoA reacts with glycine or taurine to form glycochenodeoxycholate or taurochenodeoxycholate\", \"chenodeoxycholoyl-CoA + glycine => CoA + glycochenodeoxycholate + H(+)\", \"chenodeoxycholoyl-CoA + taurine => CoA + H(+) + taurochenodeoxycholate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193491\", \"stIdVersion\": \"R-MMU-193491.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [193491], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}, {\"className\": \"Set\", \"dbId\": 193453, \"displayName\": \"chenodeoxycholate bile salts [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"chenodeoxycholate bile salts\"], \"producedByEvent\": [193491], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-193453\", \"stIdVersion\": \"R-ALL-193453.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [193491], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193533, \"displayName\": \"Thiolysis of 3alpha,7alpha-dihydroxy-5beta-cholan-24-one-CoA yields chenodeoxycholoyl-CoA (3alpha,7alpha-dihydroxy-5beta-cholan-24-one-CoA) and propionyl CoA\", \"followingEvent\": [193491], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Thiolysis of 3alpha,7alpha-dihydroxy-5beta-cholan-24-one-CoA yields chenodeoxycholoyl-CoA (3alpha,7alpha-dihydroxy-5beta-cholan-24-one-CoA) and propionyl CoA\", \"3alpha,7alpha-dihydroxy-5beta-cholan-24-one-CoA + CoASH => chenodeoxycholoyl-CoA (3alpha,7alpha-dihydroxy-5beta-cholan-24-one-CoA) + propionyl CoA\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193533\", \"stIdVersion\": \"R-HSA-193533.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193491\", \"stIdVersion\": \"R-HSA-193491.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193501, \"displayName\": \"Chenodeoxycholoyl CoA reacts with glycine or taurine to form...\", \"schemaClass\": \"Summation\", \"text\": \"Chenodeoxycholoyl CoA reacts with glycine or taurine to form glycochenodeoxycholate or taurochenodeoxycholate, releasing CoASH. This reaction, which completes the de novo synthesis of bile salts from cholesterol in vivo, is catalyzed by BAAT (Bile acid CoA:amino acid N-acyltransferase - Falany et al. 1994) and occurs in the peroxisomal matrix (Solaas et al. 2000; Mihalik et al. 2002). In vivo, the relative amounts of glycochenodeoxycholate and taurochenodeoxycholate synthesized appear to be determined solely by the intracellular abundances of glycine and taurine (Russell 2003).\"}]}" ;
