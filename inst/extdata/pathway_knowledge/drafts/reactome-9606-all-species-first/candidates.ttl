    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8847912], \"className\": \"CatalystActivity\", \"dbId\": 8847901, \"displayName\": \"phosphatidylcholine lysophospholipase A1 activity of PNPLA7 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 8847912, \"displayName\": \"PNPLA7 hydrolyzes LysoPtdCho\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8847912], \"dbId\": 6814253, \"displayName\": \"LysoPtdCho [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LysoPtdCho\", \"1-O-acyl-sn-glycero-3-phosphocholine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6814253\", \"stIdVersion\": \"R-ALL-6814253.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8847912], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8847902, \"displayName\": \"Identification of an insulin-regulated lysophospholipase with homology to neuropathy target esterase\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"5908-17\", \"pubMedIdentifier\": 18086666, \"schemaClass\": \"LiteratureReference\", \"title\": \"Identification of an insulin-regulated lysophospholipase with homology to neuropathy target esterase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18086666\", \"volume\": 283, \"year\": 2008}, {\"className\": \"LiteratureReference\", \"dbId\": 8847907, \"displayName\": \"Characterization of the human patatin-like phospholipase family\", \"journal\": \"J. Lipid Res.\", \"pages\": \"1940-9\", \"pubMedIdentifier\": 16799181, \"schemaClass\": \"LiteratureReference\", \"title\": \"Characterization of the human patatin-like phospholipase family\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/16799181\", \"volume\": 47, \"year\": 2006}], \"maxDepth\": 1, \"name\": [\"PNPLA7 hydrolyzes LysoPtdCho\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1498750, \"displayName\": \"GPCho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GPCho\", \"choline alfoscerate\", \"GroPCho\", \"Glycerol 3-phosphocholine\", \"glycerophosphocholine\"], \"producedByEvent\": [8847912], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498750\", \"stIdVersion\": \"R-ALL-1498750.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524021, \"displayName\": \"LCFA(-) [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [8847912], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524021\", \"stIdVersion\": \"R-ALL-1524021.3\"}], \"releaseDate\": \"2016-03-23\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8847912\", \"stIdVersion\": \"R-HSA-8847912.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8847898, \"displayName\": \"PNPLA7 (Patatin-like phospholipase domain-containing protein...\", \"schemaClass\": \"Summation\", \"text\": \"PNPLA7 (Patatin-like phospholipase domain-containing protein 7, also known as NRE - NTE-related  esterase) associated with the endoplasmic reticulum membrane catalyzes the hydrolysis of LysoPtcCho (lysophosphatidylcholine) to GPCho (glycerophosphocholine) and LCFA (long chain fatty acid). The human enzyme is expressed most abundantly in prostate, pancreas, and adipose tissues (Wilson et al. 2006). Its location and enzymatic activity have been inferrred from the properties of its mouse homologue (Kienesberger et al. 2008).\"}]}" ;
