<https://reactome.org/content/detail/R-HSA-2161732> a mslm:LipidReaction ;
    rdfs:label "TXB2 is converted to 11dh-TXB2 by TXDH" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
