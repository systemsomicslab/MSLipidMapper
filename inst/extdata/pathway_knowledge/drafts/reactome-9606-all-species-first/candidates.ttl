": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 2161596, \"displayName\": \"Molecular characterization of a novel type of prostamide/prostaglandin F synthase, belonging to the thioredoxin-like superfamily\", \"journal\": \"J Biol Chem\", \"pages\": \"792-801\", \"pubMedIdentifier\": 18006499, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular characterization of a novel type of prostamide/prostaglandin F synthase, belonging to the thioredoxin-like superfamily\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18006499\", \"volume\": 283, \"year\": 2008}, {\"className\": \"LiteratureReference\", \"dbId\": 2161667, \"displayName\": \"Preferential localization of prostamide/prostaglandin F synthase in myelin sheaths of the central nervous system\", \"journal\": \"Brain Res\", \"pages\": \"22-32\", \"pubMedIdentifier\": 20950588, \"schemaClass\": \"LiteratureReference\", \"title\": \"Preferential localization of prostamide/prostaglandin F synthase in myelin sheaths of the central nervous system\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/20950588\", \"volume\": 1367, \"year\": 2011}], \"maxDepth\": 1, \"name\": [\"PGH2 is reduced to PGF2a by FAM213B\", \"thioredoxin-dithiol + prostaglandin H2 => thioredoxin-disulfide + prostaglandin F2alpha\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 879535, \"displayName\": \"PGF2a [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGF2a\", \"prostaglandin F2alpha(1-)\", \"prostaglandin F2alpha\"], \"producedByEvent\": [2161612], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-879535\", \"stIdVersion\": \"R-ALL-879535.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 2142833, \"displayName\": \"TXN-S2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TXN-S2\", \"thioredoxin disulfide\", \"Thioredoxin disulphide\", \"Oxidised thioredoxin\"], \"producedByEvent\": [2161612], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142833\", \"stIdVersion\": \"R-ALL-2142833.4\"}], \"precedingEvent\": [{\"category\": \"uncertain\", \"className\": \"Reaction\", \"dbId\": 2299725, \"displayName\": \"PGH2 diffuses from the endoplasmic reticulum lumen to the cytosol\", \"followingEvent\": [2161612], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PGH2 diffuses from the endoplasmic reticulum lumen to the cytosol\"], \"releaseDate\": \"2012-12-04\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2299725\", \"stIdVersion\": \"R-HSA-2299725.4\"}], \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161612\", \"stIdVersion\": \"R-HSA-2161612.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2161641, \"displayName\": \"Prostamide/prostaglandin F synthase, FAM213B and thioredoxin...\", \"schemaClass\": \"Summation\", \"text\": \"Prostamide/prostaglandin F synthase, FAM213B and thioredoxin (TXN) are the proteins involved in the reduction of prostaglandin H2 (PGH2) to prostaglandin F2alpha (PGF2a) (Moriuchi et al. 2008, Yoshikawa et al. 2011).  This reaction has been inferred from an event in mice.  An additional way of achieving this reaction involves the protein aldo-keto reductase family 1 member C3 (AKR1C3) aka PGFS.\"}]}" ;
