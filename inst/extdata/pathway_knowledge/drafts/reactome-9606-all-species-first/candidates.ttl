 \"name\": [\"PE is hydrolyzed to 1-acyl LPE by PLA2[16]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1602398\", \"stIdVersion\": \"R-SSC-1602398.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10386048, \"displayName\": \"PE is hydrolyzed to 1-acyl LPE by PLA2[16]\", \"inferredFrom\": [1602398], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PE is hydrolyzed to 1-acyl LPE by PLA2[16]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1602398\", \"stIdVersion\": \"R-BTA-1602398.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10276029, \"displayName\": \"PE is hydrolyzed to 1-acyl LPE by PLA2[16]\", \"inferredFrom\": [1602398], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PE is hydrolyzed to 1-acyl LPE by PLA2[16]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1602398\", \"stIdVersion\": \"R-CFA-1602398.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10162652, \"displayName\": \"PE is hydrolyzed to 1-acyl LPE by PLA2[16]\", \"inferredFrom\": [1602398], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PE is hydrolyzed to 1-acyl LPE by PLA2[16]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1602398\", \"stIdVersion\": \"R-RNO-1602398.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10040499, \"displayName\": \"PE is hydrolyzed to 1-acyl LPE by PLA2[16]\", \"inferredFrom\": [1602398], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PE is hydrolyzed to 1-acyl LPE by PLA2[16]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1602398\", \"stIdVersion\": \"R-MMU-1602398.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1602372, \"displayName\": \"1-acyl LPE [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPE\", \"1-acyl-sn-glycero-3-phosphoethanolamine\", \"1-acyl lysophosphatidylethanolamine\", \"L-2-Lysophosphatidylethanolamine\"], \"producedByEvent\": [1602398], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1602372\", \"stIdVersion\": \"R-ALL-1602372.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1602366, \"displayName\": \"LCFA(-) [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [1602398], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1602366\", \"stIdVersion\": \"R-ALL-1602366.4\"}], \"regulatedBy\": [{\"className\": \"NegativeRegulation\", \"dbId\": 8864276, \"displayName\": \"Negative regulation by 'PLA2R1(21-?) [extracellular region]'\", \"regulatedEntity\": [1602398], \"schemaClass\": \"NegativeRegulation\", \"stId\": \"R-HSA-8864276\", \"stIdVersion\": \"R-HSA-8864276.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1602398\", \"stIdVersion\": \"R-HSA-1602398.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1602358, \"displayName\": \"At the plasma membrane, phosphatidylethanolamine (PE) is hyd...\", \"schemaClass\": \"Summation\", \"text\": \"At the plasma membrane, phosphatidylethanolamine (PE) is hydrolyzed, removing one of its acyl groups, to 1-acyl phosphatidylethanolamine (LPE) by secretory phospholipase A2 proteins (Singer et al. 2002, Ishizaki et al. 1999).  These include: Group IB (PLA2G1B) (Grataroli et al. 1982); Group IIA (PLA2G2A) (Seilhamer et al. 1989); Group IID (PLA2G2D) (Ishizaki et al. 1999); Group IIE (PLA2G2E) (Suzuki et al. 2000); Group IIF (PLA2G2F) (Valentin et al. 2000); Group III (PLA2G3) (Murakami et al. 2003, Murakami et al. 2005); Calcium-dependent Group V (PLA2G5) (Chen et al. 1994); Group X (PLA2G10) (Cupillard et al. 1997, Pan et al. 2002); and Group XIIA (PLA2G12A) (Gelb et al. 2000, Murakami et al. 2003).\"}]}" ;
