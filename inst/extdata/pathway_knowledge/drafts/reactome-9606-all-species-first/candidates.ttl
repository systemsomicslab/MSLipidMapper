<https://reactome.org/content/detail/R-HSA-390276> a mslm:LipidReaction ;
    rdfs:label "Conversion of 4,8,12-trimethyltridecanoyl-CoA to 4,8-dimethylnonanoyl-CoA" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "4,8,12-trimethyltridecanoyl-CoA [peroxisomal matrix] => 4,8-dimethylnonanoyl-CoA [peroxisomal matrix]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 390276, \"displayName\": \"Conversion of 4,8,12-trimethyltridecanoyl-CoA to 4,8-dimethylnonanoyl-CoA\", \"followingEvent\": [390291], \"goBiologicalProcess\": {\"accession\": \"0006635\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 20426, \"definition\": \"A fatty acid oxidation process that results in the complete oxidation of a long-chain fatty acid. Fatty acid beta-oxidation begins with the addition of coenzyme A to a fatty acid, and occurs by successive cycles of reactions during each of which the fatty acid is shortened by a two-carbon fragment removed as acetyl coenzyme A; the cycle continues until only two or three carbons remain (as acetyl-CoA or propionyl-CoA respectively).\", \"displayName\": \"fatty acid beta-oxidation\", \"name\": \"fatty acid beta-oxidation\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006635\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [390276], \"dbId\": 390002, \"displayName\": \"4,8,12-trimethyltridecanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4,8,12-trimethyltridecanoyl-CoA\", \"4,8,12-trimethyltridecanoyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390002\", \"stIdVersion\": \"R-ALL-390002.3\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 390289, \"displayName\": \"Phytanic acid and pristanic acid are oxidized by sequential peroxisomal and mitochondrial reactions in cultured fibroblasts\", \"journal\": \"J Lipid Res\", \"pages\": \"66-74\", \"pubMedIdentifier\": 9469587, \"schemaClass\": \"LiteratureReference\", \"title\": \"Phytanic acid and pristanic acid are oxidized by sequential peroxisomal and mitochondrial reactions in cultured fibroblasts\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9469587\", \"volume\": 39, \"year\": 1998}], \"maxDepth\": 1, \"name\": [\"Conversion of 4,8,12-trimethyltridecanoyl-CoA to 4,8-dimethylnonanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 390271, \"displayName\": \"4,8-dimethylnonanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4,8-dimethylnonanoyl-CoA\", \"4,8-dimethylnonanoyl-CoA(4-)\"], \"producedByEvent\": [390276], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390271\", \"stIdVersion\": \"R-ALL-390271.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 390224, \"displayName\": \"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"followingEvent\": [390276], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"3-ketopristanoyl-CoA + CoASH => 4,8,12-trimethyltridecanoyl-CoA + propionyl-CoA\", \"3-oxopristanoyl-CoA + CoA => 4,8,12-trimethyltridecanoyl-CoA + propanoyl-CoA\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390224\", \"stIdVersion\": \"R-HSA-390224.4\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2009-04-01\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-390276\", \"stIdVersion\": \"R-HSA-390276.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 390270, \"displayName\": \"The beta-oxidation of pristanoyl-CoA requires the conversion...\", \"schemaClass\": \"Summation\", \"text\": \"The beta-oxidation of pristanoyl-CoA requires the conversion of 4,8,12-trimethyltridecanoyl-CoA to 4,8-dimethylnonanoyl-CoA (Verhoeven et al. 1998). This conversion could be mediated by two cycles of beta-oxidation but this specific reaction sequence has not been established experimentally so it is annotated here simply as conversion of 4,8,12-trimethyltridecanoyl-CoA to 4,8-dimethylnonanoyl-CoA with no other reactants and products specified.\"}]}" ;
