e\": \"Reaction\", \"dbId\": 10653706, \"displayName\": \"FITM1 binds TAGs\", \"inferredFrom\": [9942190], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FITM1 binds TAGs\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9942190\", \"stIdVersion\": \"R-DRE-9942190.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10561482, \"displayName\": \"FITM1 binds TAGs\", \"inferredFrom\": [9942190], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FITM1 binds TAGs\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9942190\", \"stIdVersion\": \"R-SSC-9942190.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10448475, \"displayName\": \"FITM1 binds TAGs\", \"inferredFrom\": [9942190], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FITM1 binds TAGs\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9942190\", \"stIdVersion\": \"R-BTA-9942190.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10334124, \"displayName\": \"FITM1 binds TAGs\", \"inferredFrom\": [9942190], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FITM1 binds TAGs\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9942190\", \"stIdVersion\": \"R-CFA-9942190.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10227178, \"displayName\": \"FITM1 binds TAGs\", \"inferredFrom\": [9942190], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FITM1 binds TAGs\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9942190\", \"stIdVersion\": \"R-RNO-9942190.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10103529, \"displayName\": \"FITM1 binds TAGs\", \"inferredFrom\": [9942190], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FITM1 binds TAGs\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9942190\", \"stIdVersion\": \"R-MMU-9942190.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 9942191, \"displayName\": \"FITM1:TAGs [endoplasmic reticulum membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"FITM1:TAGs\"], \"producedByEvent\": [9942190], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9942191\", \"stIdVersion\": \"R-HSA-9942191.1\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821383, \"definition\": \"internally reviewed\", \"displayName\": \"three stars\", \"name\": [\"three stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2025-06-18\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9942190\", \"stIdVersion\": \"R-HSA-9942190.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8857667, \"displayName\": \"Lipid droplets (LDs) are cytosolic structures found in all e...\", \"schemaClass\": \"Summation\", \"text\": \"Lipid droplets (LDs) are cytosolic structures found in all eukaryotes, comprising a monolayer of phospholipids surrounding a core of uncharged lipids such as triglyceride (TAG) and sterol esters. They play an important role in both cellular physiology and disease. LD formation involves the partitioning of neutral lipids from their site of synthesis at the endoplasmic reticulum (ER) to the cytosol. The fat storage-inducing transmembrane proteins 1 (FITM1) belong to an evolutionarily-conserved gene family which mediates LD formation (Kadereit et al. 2008, Gross et al. 2011). FITM1 is an ER membrane associated protein that mediates binding (annotated here) and partitioning of TAGs into LDs (Gross et al. 2011, Miranda et al. 2014). FITM1 is expressed primarily in skeletal muscle whereas its paralog FITM2 is expressed primarily in adipose tissue, suggesting these proteins may have distinct functions (Gross et al. 2011).\"}]}" ;
