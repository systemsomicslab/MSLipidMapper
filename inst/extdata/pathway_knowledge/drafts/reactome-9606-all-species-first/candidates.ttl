    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005811\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13977, \"definition\": \"An intracellular non-membrane-bounded organelle comprising a matrix of coalesced lipids surrounded by a phospholipid monolayer. May include associated proteins.\", \"displayName\": \"lipid droplet\", \"name\": \"lipid droplet\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005811\"}], \"dbId\": 163554, \"displayName\": \"Phosphorylated HSL dimer translocates from the cytosol to the lipid particle\", \"followingEvent\": [163549], \"goBiologicalProcess\": {\"accession\": \"1990044\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 3446241, \"definition\": \"A process in which a protein is transported to, or maintained in, a location on or within a lipid droplet.\", \"displayName\": \"protein localization to lipid droplet\", \"name\": \"protein localization to lipid droplet\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:1990044\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [163554], \"dbId\": 163513, \"displayName\": \"phosphorylated HSL dimer [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"phosphorylated HSL dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163513\", \"stIdVersion\": \"R-HSA-163513.1\"}], \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 163569, \"displayName\": \"Mutational analysis of the hormone-sensitive lipase translocation reaction in adipocytes\", \"journal\": \"J Biol Chem\", \"pages\": \"43615-9\", \"pubMedIdentifier\": 12832420, \"schemaClass\": \"LiteratureReference\", \"title\": \"Mutational analysis of the hormone-sensitive lipase translocation reaction in adipocytes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12832420\", \"volume\": 278, \"year\": 2003}, {\"className\": \"LiteratureReference\", \"dbId\": 163555, \"displayName\": \"Perilipin A is essential for the translocation of hormone-sensitive lipase during lipolytic activation\", \"journal\": \"J Cell Biol\", \"pages\": \"1093-103\", \"pubMedIdentifier\": 12810697, \"schemaClass\": \"LiteratureReference\", \"title\": \"Perilipin A is essential for the translocation of hormone-sensitive lipase during lipolytic activation\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12810697\", \"volume\": 161, \"year\": 2003}, {\"className\": \"LiteratureReference\", \"dbId\": 163593, \"displayName\": \"Translocation of hormone-sensitive lipase and perilipin upon lipolytic stimulation of rat adipocytes\", \"journal\": \"J Biol Chem\", \"pages\": \"5011-5\", \"pubMedIdentifier\": 10671541, \"schemaClass\": \"LiteratureReference\", \"title\": \"Translocation of hormone-sensitive lipase and perilipin upon lipolytic stimulation of rat adipocytes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/10671541\", \"volume\": 275, \"year\": 2000}, {\"className\": \"LiteratureReference\", \"dbId\": 9961062, \"displayName\": \"Molecular determinants for the association of human hormone-sensitive lipase with lipid droplets\", \"journal\": \"Nat Commun\", \"pages\": \"3497\", \"pubMedIdentifier\": 40221426, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular determinants for the association of human hormone-sensitive lipase with lipid droplets\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/40221426\", \"volume\": 16, \"year\": 2025}], \"maxDepth\": 1, \"name\": [\"Phosphorylated HSL dimer translocates from the cytosol to the lipid particle\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 163435, \"displayName\": \"phosphorylated HSL dimer [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"phosphorylated HSL dimer\"], \"producedByEvent\": [163554], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163435\", \"stIdVersion\": \"R-HSA-163435.2\"}], \"precedingEvent\": [{\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 163602, \"displayName\": \"2 phosphorylated HSL monomers -> phosphorylated HSL dimer\", \"followingEvent\": [163554], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2 phosphorylated HSL monomers -> phosphorylated HSL dimer\"], \"releaseDate\": \"2005-04-11\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163602\", \"stIdVersion\": \"R-HSA-163602.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 163418, \"displayName\": \"perilipin + 2 ATP -> phosphorylated perilipin + 2 ADP\", \"followingEvent\": [163554], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"perilipin + 2 ATP -> phosphorylated perilipin + 2 ADP\"], \"releaseDate\": \"2005-06-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163418\", \"stIdVersion\": \"R-HSA-163418.4\"}], \"releaseDate\": \"2005-06-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163554\", \"stIdVersion\": \"R-HSA-163554.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 163481, \"displayName\": \"In primary adipocytes from young rats and in adipocytes deri...\", \"schemaClass\": \"Summation\", \"text\": \"In primary adipocytes from young rats and in adipocytes derived from 3T3-L1 cells in vitro, phosphorylated hormone-sensitive lipase (HSL) translocates from the cytosol to the surfaces of lipid droplets following the phosphorylation of perilipin (Clifford et al. 2000; Su et al. 2003; Sztalryd et al. 2003).<p>Recent studies have identified the structural domain of HSL that mediates its interaction with lipid droplets, and raise the possibility, not annotated here, that under some conditions unphosphorylated HSL can interact with lipid droplets (Peng et al. 2025).<p>The human reaction is inferred from the well-studied rat one.\"}]}" ;
