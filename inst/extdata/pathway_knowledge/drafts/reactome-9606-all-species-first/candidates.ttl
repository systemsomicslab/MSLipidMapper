ersion\": \"R-RNO-9027633.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092867, \"displayName\": \"ALOX5 oxidises DPAn-3 to 7-HDPAn-3\", \"inferredFrom\": [9027633], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises DPAn-3 to 7-HDPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9027633\", \"stIdVersion\": \"R-MMU-9027633.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9028240, \"displayName\": \"7-HDPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7-HDPAn-3\", \"(8E,10Z,13Z,16Z,19Z)-7-hydroxydocosapentaenoate\", \"(8E,10Z,13Z,16Z,19Z)-7-hydroxydocosapentaenoic acid\", \"7-hydroxy-omega3-docosapentaenoic acid\", \"7-hydroxy-docosapentaenoic acid\"], \"producedByEvent\": [9027633], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9028240\", \"stIdVersion\": \"R-ALL-9028240.5\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027633\", \"stIdVersion\": \"R-HSA-9027633.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9028216, \"displayName\": \"In human neutrophils, 5-lipoxygenase (ALOX5) can mediate the...\", \"schemaClass\": \"Summation\", \"text\": \"In human neutrophils, 5-lipoxygenase (ALOX5) can mediate the lipoxygenation of ω-3 docosapentaenoic acid (DPAn-3) to 7-hydroxy-ω-3-docosapentaenoic acid (7-HDPAn-3) (Cipollina et al. 2014). Neutrophils treated with an ALOX5 inhibitor completely suppressed the formation of 7-oxo-DPAn-3 and its hydroxy precursor 7-HDPAn-3, demonstrating that ALOX5 mediates the first step in 7-oxo-DPAn-3 biosynthesis (Cipollina et al. 2014).\"}]}" ;
