sease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP8B1 12-hydroxylates 4CHOL7aOLONE\", \"7alpha-hydroxycholest-4-en-3-one + O2 + reduced (NADPH--hemoprotein reductase) => 7alpha,12alpha-dihydroxycholest-4-en-3-one + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\", \"4-Cholesten-7alpha-ol-3-one is 12alpha-hydroxylated to 7-alpha,12-alpha-dihydroxycholest-4-en-3-one\", \"7-alpha-hydroxycholest-4-en-3-one + NADPH + H+ + O2 => 7-alpha,12-alpha-dihydroxycholest-4-en-3-one + NADP+ + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-192157\", \"stIdVersion\": \"R-MMU-192157.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192195, \"displayName\": \"4CHOL7a,12aDONE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4CHOL7a,12aDONE\", \"7alpha,12alpha-dihydroxycholest-4-en-3-one\", \"4-cholesten-7alpha, 12alpha-diol-3-one\"], \"producedByEvent\": [192157], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192195\", \"stIdVersion\": \"R-ALL-192195.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [192157], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [192157], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 192097, \"displayName\": \"7alpha-hydroxycholesterol is oxidized and isomerized to 4-cholesten-7alpha-ol-3-one\", \"followingEvent\": [192157], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"7alpha-hydroxycholesterol is oxidized and isomerized to 4-cholesten-7alpha-ol-3-one\", \"7alpha-hydroxycholesterol + NAD(+) => 7alpha-hydroxycholest-4-en-3-one + H(+) + NADH\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192097\", \"stIdVersion\": \"R-HSA-192097.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192157\", \"stIdVersion\": \"R-HSA-192157.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 192122, \"displayName\": \"Sterol 12alpha hydroxylase (CYP8B1), an enzyme associated wi...\", \"schemaClass\": \"Summation\", \"text\": \"Sterol 12alpha hydroxylase (CYP8B1), an enzyme associated with the endoplasmic reticulum membrane, catalyses the 12-alpha-hydroxylation of 7-Alpha-hydroxycholest-4-en-3-one (4CHOL7aOLONE) to 7-alpha,12-alpha-dihydroxycholest-4-en-3-one (4CHOL7a,12aDONE). The human gene has been cloned (Gafvels et al. 1999) and encodes an enzyme with CYP8B1 activity when overexpressed in cultured cells, in agreement with the enzymatic properties of its well-characterised rabbit homolog (Ishida et al. 1992).\"}]}" ;
