    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [6786650], \"className\": \"CatalystActivity\", \"dbId\": 6786648, \"displayName\": \"glycerophospholipase activity of DDHD1,2 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 6786650, \"displayName\": \"DDHD1,2 hydrolyse PA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [6786650], \"dbId\": 1602448, \"displayName\": \"PA [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PA\", \"phosphatidate(2-)\", \"phosphatidic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1602448\", \"stIdVersion\": \"R-ALL-1602448.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [6786650], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isChimeric\": false, \"isInDisea