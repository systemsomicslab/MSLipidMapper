redFrom\": [193824], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4-cholesten-7alpha,27-diol-3-one is reduced to 5beta-cholestan-7alpha,27-diol-3-one\", \"4-cholesten-7alpha,27-diol-3-one + NADPH + H+ => 5beta-cholestan-7alpha,27-diol-3-one + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-193824\", \"stIdVersion\": \"R-RNO-193824.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007653, \"displayName\": \"4-cholesten-7alpha,27-diol-3-one is reduced to 5beta-cholestan-7alpha,27-diol-3-one\", \"inferredFrom\": [193824], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4-cholesten-7alpha,27-diol-3-one is reduced to 5beta-cholestan-7alpha,27-diol-3-one\", \"4-cholesten-7alpha,27-diol-3-one + NADPH + H+ => 5beta-cholestan-7alpha,27-diol-3-one + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193824\", \"stIdVersion\": \"R-MMU-193824.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193830, \"displayName\": \"5beta-cholestan-7alpha,27-diol-3-one [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-7alpha,27-diol-3-one\", \"7alpha,26-dihydroxy-5beta-cholestan-3-one\"], \"producedByEvent\": [193824], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193830\", \"stIdVersion\": \"R-ALL-193830.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [193824], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193816, \"displayName\": \"Cholest-5-ene-3beta,7alpha,27-triol is oxidized and isomerized to 4-cholesten-7alpha,27-diol-3-one\", \"followingEvent\": [193824], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Cholest-5-ene-3beta,7alpha,27-triol is oxidized and isomerized to 4-cholesten-7alpha,27-diol-3-one\", \"Cholest-5-ene-3beta,7alpha,27-triol + NAD+ => 4-cholesten-7alpha,27-diol-3-one +NADH + H+\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193816\", \"stIdVersion\": \"R-HSA-193816.2\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193824\", \"stIdVersion\": \"R-HSA-193824.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193847, \"displayName\": \"4-Cholesten-7alpha,27-diol-3-one, NADPH, and H+ react to for...\", \"schemaClass\": \"Summation\", \"text\": \"4-Cholesten-7alpha,27-diol-3-one, NADPH, and H+ react to form 5beta-cholestan-7alpha,27-diol-3-one and NADP+. This reaction is catalyzed by AKR1D1 (3-oxo-5-beta-steroid 4-dehydrogenase). AKR1D1 is localized to the cytosol, and in the course of the reaction its steroid substrate moves from the endoplasmic reticulum membrane to the cytosol. It is unclear whether this translocation results simply from its increased hydrophilicity or is mediated by the enzyme or another transport protein (Russell 2003).\"}]}" ;
