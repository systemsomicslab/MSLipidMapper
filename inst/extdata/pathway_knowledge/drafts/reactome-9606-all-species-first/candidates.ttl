    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8866941], \"className\": \"CatalystActivity\", \"dbId\": 9954170, \"displayName\": \"molecular function activator activity of THRSP [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 8866941, \"displayName\": \"MID1IP1 binds THRSP\", \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [8866941], \"dbId\": 8867328, \"displayName\": \"MID1IP1 [cytosol]\", \"endCoordinate\": 183, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MID1IP1\", \"Mid1-interacting protein 1\", \"M1IP1_HUMAN\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8867328\", \"stIdVersion\": \"R-HSA-8867328.1\", \"startCoordinate\": 1}, {\"className\": \"Protein\", \"consumedByEvent\": [8866941], \"dbId\": 8867326, \"displayName\": \"THRSP [cytosol]\", \"endCoordinate\": 146, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"THRSP\", \"Thyroid hormone-inducible hepatic protein\", \"THRSP_HUMAN\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8867326\", \"stIdVersion\": \"R-HSA-8867326.1\", \"startCoordinate\": 1}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8866948, \"displayName\": \"Hepatic expression of the SPOT 14 (S14) paralog S14-related (Mid1 interacting protein) is regulated by dietary carbohydrate\", \"journal\": \"Endocrinology\", \"pages\": \"5155-61\", \"pubMedIdentifier\": 18556348, \"schemaClass\": \"LiteratureReference\", \"title\": \"Hepatic expression of the SPOT 14 (S14) paralog S14-related (Mid1 interacting protein) is regulated by dietary carbohydrate\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18556348\", \"volume\": 149, \"year\": 2008}, {\"className\": \"LiteratureReference\", \"dbId\": 8866946, \"displayName\": \"Overlapping roles of the glucose-responsive genes, S14 and S14R, in hepatic lipogenesis\", \"journal\": \"Endocrinology\", \"pages\": \"2071-7\", \"pubMedIdentifier\": 20233797, \"schemaClass\": \"LiteratureReference\", \"title\": \"Overlapping roles of the glucose-responsive genes, S14 and S14R, in hepatic lipogenesis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/20233797\", \"volume\": 151, \"year\": 2010}, {\"className\": \"LiteratureReference\", \"dbId\": 8867331, \"displayName\": \"Spot14/Mig12 heterocomplex sequesters polymerization and restrains catalytic function of human acetyl-CoA carboxylase 2\", \"journal\": \"J. Mol. Recognit.\", \"pages\": \"679-88\", \"pubMedIdentifier\": 24277613, \"schemaClass\": \"LiteratureReference\", \"title\": \"Spot14/Mig12 heterocomplex sequesters polymerization and restrains catalytic function of human acetyl-CoA carboxylase 2\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/24277613\", \"volume\": 26, \"year\": 2013}], \"maxDepth\": 1, \"name\": [\"MID1IP1 binds THRSP\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10903110, \"displayName\": \"MID1IP1 binds THRSP\", \"inferredFrom\": [8866941], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MID1IP1 binds THRSP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8866941\", \"stIdVersion\": \"R-DME-8866941.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10814846, \"displayName\": \"MID1IP1 binds THRSP\", \"inferredFrom\": [8866941], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MID1IP1 binds THRSP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-8866941\", \"stIdVersion\": \"R-GGA-8866941.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10721276, \"displayName\": \"MID1IP1 binds THRSP\", \"inferredFrom\": [8866941], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MID1IP1 binds THRSP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8866941\", \"stIdVersion\": \"R-XTR-8866941.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10638626, \"displayName\": \"MID1IP1 binds THRSP\", \"inferredFrom\": [8866941], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MID1IP1 binds THRSP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-8866941\", \"stIdVersion\": \"R-DRE-8866941.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10542688, \"displayName\": \"MID1IP1 binds THRSP\", \"inferredFrom\": [8866941], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MID1IP1 binds THRSP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8866941\", \"stIdVersion\": \"R-SSC-8866941.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10429001, \"displayName\": \"MID1IP1 binds THRSP\", \"inferredFrom\": [8866941], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MID1IP1 binds THRSP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8866941\", \"stIdVersion\": \"R-BTA-8866941.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10315553, \"displayName\": \"MID1IP1 binds THRSP\", \"inferredFrom\": [8866941], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MID1IP1 binds THRSP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8866941\", \"stIdVersion\": \"R-CFA-8866941.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10206909, \"displayName\": \"MID1IP1 binds THRSP\", \"inferredFrom\": [8866941], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MID1IP1 binds THRSP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8866941\", \"stIdVersion\": \"R-RNO-8866941.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10083926, \"displayName\": \"MID1IP1 binds THRSP\", \"inferredFrom\": [8866941], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MID1IP1 binds THRSP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8866941\", \"stIdVersion\": \"R-MMU-8866941.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 8867329, \"displayName\": \"MID1IP1:THRSP [cytosol]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"MID1IP1:THRSP\"], \"producedByEvent\": [8866941], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8867329\", \"stIdVersion\": \"R-HSA-8867329.1\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8866941\", \"stIdVersion\": \"R-HSA-8866941.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8867332, \"displayName\": \"Mid1-interacting protein 1 (MID1IP1, aka MIG12, SPOT14R, S14...\", \"schemaClass\": \"Summation\", \"text\": \"Mid1-interacting protein 1 (MID1IP1, aka MIG12, SPOT14R, S14R) plays a role in the regulation of lipogenesis in the liver. It is rapidly upregulated by processes that induce lipogenesis (enhanced glucose metabolism, thyroid hormone administration) (Tsatsos et al. 2008). MID1IP1 forms a heterodimer with thyroid hormone-inducible hepatic protein (THRSP, aka SPOT14, S14), proposed to play the same role in lipogenesis as MID1IP1 (Aipoalani et al. 2010). This complex can polymerize acetyl-CoA carboxylases 1 and 2 (ACACA and B), the first committed enzymes in fatty acid (FA) synthesis. Polymerization enhances ACACA and ACACB enzyme activities (Kim et al. 2010, Park et al. 2013).\"}]}" ;
