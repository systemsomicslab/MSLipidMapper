    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [2161768], \"className\": \"CatalystActivity\", \"dbId\": 2161978, \"displayName\": \"eoxin C4 synthase activity of ALOX5:ALOX5AP:LTC4S [nuclear envelope]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005635\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13231, \"definition\": \"The double lipid bilayer that encloses the nucleus, separating its contents from the cytoplasm. It consists of an inner and outer nuclear membrane, with an intermembrane space (20-40 nm wide, also called the perinuclear space) between them. The envelope is supported by the nuclear lamina and contains nuclear pore complexes, which regulate molecular transport.\", \"displayName\": \"nuclear envelope\", \"name\": \"nuclear envelope\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005635\"}], \"dbId\": 2161768, \"displayName\": \"EXA4 is converted to EXC4 by LTC4S\", \"followingEvent\": [2161945], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161768], \"dbId\": 2142772, \"displayName\": \"EXA4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"EXA4\", \"eoxin A4(1-)\", \"eoxin A4\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142772\", \"stIdVersion\": \"R-ALL-2142772.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161768], \"dbId\": 29450, \"displayName\": \"GSH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GSH\", \"glutathionate(1-)\", \"Reduced glutathione\", \"glutathione\", \"5-L-Glutamyl-L-cysteinylglycine\", \"N-(N-gamma-L-Glutamyl-L-cysteinyl)glycine\", \"gamma-L-Glutamyl-L-cysteinyl-glycine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29450\", \"stIdVersion\": \"R-ALL-29450.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 2161756, \"displayName\": \"Eoxins are proinflammatory arachidonic acid metabolites produced via the 15-lipoxygenase-1 pathway in human eosinophils and mast cells\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"680-5\", \"pubMedIdentifier\": 18184802, \"schemaClass\": \"LiteratureReference\", \"title\": \"Eoxins are proinflammatory arachidonic acid metabolites produced via the 15-lipoxygenase-1 pathway in human eosinophils and mast cells\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18184802\", \"volume\": 105, \"year\": 2008}, {\"className\": \"LiteratureReference\", \"dbId\": 2161760, \"displayName\": \"Hodgkin Reed-Sternberg cells express 15-lipoxygenase-1 and are putative producers of eoxins in vivo: novel insight into the inflammatory features of classical Hodgkin lymphoma\", \"journal\": \"FEBS J\", \"pages\": \"4222-34\", \"pubMedIdentifier\": 18647347, \"schemaClass\": \"LiteratureReference\", \"title\": \"Hodgkin Reed-Sternberg cells express 15-lipoxygenase-1 and are putative producers of eoxins in vivo: novel insight into the inflammatory features of classical Hodgkin lymphoma\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18647347\", \"volume\": 275, \"year\": 2008}], \"maxDepth\": 1, \"name\": [\"EXA4 is converted to EXC4 by LTC4S\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11027031, \"displayName\": \"EXA4 is converted to EXC4 by LTC4S\", \"i