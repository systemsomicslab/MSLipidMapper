    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9705713], \"className\": \"CatalystActivity\", \"dbId\": 9705712, \"displayName\": \"3-oxo-5-alpha-steroid 4-dehydrogenase activity of SRD5A2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690574, \"displayName\": \"RHEA:50822\", \"identifier\": \"50822\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/50822\"}], \"dbId\": 9705713, \"displayName\": \"SRD5A2 dehydrogenates TEST to DHTEST\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9705713], \"dbId\": 193057, \"displayName\": \"TEST [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TEST\", \"testosterone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193057\", \"stIdVersion\": \"R-ALL-193057.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9705713], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9705713], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 469675, \"displayName\": \"Deletion of steroid 5 alpha-reductase 2 gene in male pseudohermaphroditism\", \"journal\": \"Nature\", \"pages\": \"159-61\", \"pubMedIdentifier\": 1944596, \"schemaClass\": \"LiteratureReference\", \"title\": \"Deletion of steroid 5 alpha-reductase 2 gene in male pseudohermaphroditism\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/1944596\", \"volume\": 354, \"year\": 1991}, {\"className\": \"LiteratureReference\", \"dbId\": 469674, \"displayName\": \"Male pseudohermaphroditism resulting from a novel mutation in the human steroid 5 alpha-reductase type 2 gene (SRD5A2)\", \"journal\": \"Mol Pathol\", \"pages\": \"51-2\", \"pubMedIdentifier\": 9208814, \"schemaClass\": \"LiteratureReference\", \"title\": \"Male pseudohermaphroditism resulting from a novel mutation in the human steroid 5 alpha-reductase type 2 gene (SRD5A2)\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9208814\", \"volume\": 50, \"year\": 1997}, {\"className\": \"LiteratureReference\", \"dbId\": 1434477, \"displayName\": \"A critical review of the origin and control of adrenal androgens\", \"journal\": \"Baillieres Clin Obstet Gynaecol\", \"pages\": \"229-48\", \"pubMedIdentifier\": 9536209, \"schemaClass\": \"LiteratureReference\", \"title\": \"A critical review of the origin and cont