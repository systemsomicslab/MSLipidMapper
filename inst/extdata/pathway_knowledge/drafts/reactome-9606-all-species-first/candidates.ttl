    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [1605768], \"className\": \"CatalystActivity\", \"dbId\": 1605760, \"displayName\": \"exo-alpha-sialidase activity of NEU3 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 1605768, \"displayName\": \"NEU3 cleaves GM3 to form LacCer (plasma membrane)\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1605768], \"dbId\": 1605649, \"displayName\": \"GM3 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GM3\", \"alpha-N-acetylneuraminosyl-(2->3)-beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1')-N-acylsphingosine(1-)\", \"GM3 ganglioside\", \"alpha-N-acetylneuraminosyl-(2->3)-beta-D-galactosyl-(1->4)-beta-D-glucosylceramide\", \"alpha-N-acetylneuraminyl-(2->3)-beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1')-ceramide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605649\", \"stIdVersion\": \"R-ALL-1605649.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [1605768], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1605685, \"displayName\": \"Identification and expression of NEU3, a novel human sialidase associated to the plasma membrane\", \"journal\": \"Biochem J\", \"pages\": \"343-51\", \"pubMedIdentifier\": 10861246, \"schemaClass\": \"LiteratureReference\", \"title\": \"Identification and expression of NEU3, a novel human sialidase associated to the plasma membrane\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/10861246\", \"volume\": 349, \"year\": 2000}], \"maxDepth\": 1, \"name\": [\"NEU3 cleaves GM3 to form LacCer (plasma membrane)\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10276306, \"displayName\": \"NEU3 cleaves GM3 to form LacCer (plasma membrane)\", \"inferredFrom\": [1605768], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NEU3 cleaves GM3 to form LacCer (plasma membrane)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1605768\", \"stIdVersion\": \"R-CFA-1605768.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10780855, \"displayName\": \"NEU3 cleaves GM3 to form LacCer (plasma membrane)\", \"inferredFrom\": [1605768], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NEU3 cleaves GM3 to form LacCer (plasma membrane)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-1605768\", \"stIdVersion\": \"R-GGA-1605768.1\"}, {\"category\": \"transition\", \"className\": \"Reactio