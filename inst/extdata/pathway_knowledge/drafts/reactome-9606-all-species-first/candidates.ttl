eratureReference\", \"dbId\": 1612935, \"displayName\": \"Identification of point mutations in the steroid sulfatase gene of three patients with X-linked ichthyosis\", \"journal\": \"Am J Hum Genet\", \"pages\": \"483-91\", \"pubMedIdentifier\": 1539590, \"schemaClass\": \"LiteratureReference\", \"title\": \"Identification of point mutations in the steroid sulfatase gene of three patients with X-linked ichthyosis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/1539590\", \"volume\": 50, \"year\": 1992}, {\"className\": \"LiteratureReference\", \"dbId\": 1612937, \"displayName\": \"Characterization of point mutations in patients with X-linked ichthyosis. Effects on the structure and function of the steroid sulfatase protein\", \"journal\": \"J Biol Chem\", \"pages\": \"20756-63\", \"pubMedIdentifier\": 9252398, \"schemaClass\": \"LiteratureReference\", \"title\": \"Characterization of point mutations in patients with X-linked ichthyosis. Effects on the structure and function of the steroid sulfatase protein\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9252398\", \"volume\": 272, \"year\": 1997}], \"maxDepth\": 1, \"name\": [\"ARSC hydrolyzes steroid sulfates\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11070988, \"displayName\": \"ARSC hydrolyzes steroid sulfates\", \"inferredFrom\": [1606839], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARSC hydrolyzes steroid sulfates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-1606839\", \"stIdVersion\": \"R-SPO-1606839.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10780968, \"displayName\": \"ARSC hydrolyzes steroid sulfates\", \"inferredFrom\": [1606839], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARSC hydrolyzes steroid sulfates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-1606839\", \"stIdVersion\": \"R-GGA-1606839.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10691383, \"displayName\": \"ARSC hydrolyzes steroid sulfates\", \"inferredFrom\": [1606839], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARSC hydrolyzes steroid sulfates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-1606839\", \"stIdVersion\": \"R-XTR-1606839.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10603866, \"displayName\": \"ARSC hydrolyzes steroid sulfates\", \"inferredFrom\": [1606839], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARSC hydrolyzes steroid sulfates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-1606839\", \"stIdVersion\": \"R-DRE-1606839.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10501047, \"displayName\": \"ARSC hydrolyzes steroid sulfates\", \"inferredFrom\": [1606839], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARSC hydrolyzes steroid sulfates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1606839\", \"stIdVersion\": \"R-SSC-1606839.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10386475, \"displayName\": \"ARSC hydrolyzes steroid sulfates\", \"inferredFrom\": [1606839], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARSC hydrolyzes steroid sulfates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1606839\", \"stIdVersion\": \"R-BTA-1606839.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10276426, \"displayName\": \"ARSC hydrolyzes steroid sulfates\", \"inferredFrom\": [1606839], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARSC hydrolyzes steroid sulfates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1606839\", \"stIdVersion\": \"R-CFA-1606839.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10163118, \"displayName\": \"ARSC hydrolyzes steroid sulfates\", \"inferredFrom\": [1606839], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARSC hydrolyzes steroid sulfates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1606839\", \"stIdVersion\": \"R-RNO-1606839.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10040941, \"displayName\": \"ARSC hydrolyzes steroid sulfates\", \"inferredFrom\": [1606839], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARSC hydrolyzes steroid sulfates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1606839\", \"stIdVersion\": \"R-MMU-1606839.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1609649, \"displayName\": \"SO4(2-) [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SO4(2-)\", \"sulfate\", \"inorganic sulfate\", \"Sulphate\"], \"producedByEvent\": [1606839], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1609649\", \"stIdVersion\": \"R-ALL-1609649.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 9841230, \"displayName\": \"steroid [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"steroid\"], \"producedByEvent\": [1606839], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9841230\", \"stIdVersion\": \"R-ALL-9841230.1\"}], \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1606839\", \"stIdVersion\": \"R-HSA-1606839.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1606805, \"displayName\": \"Steryl sulfatase (formerly arylsulfatase C, ARSC) hydrolyses...\", \"schemaClass\": \"Summation\", \"text\": \"Steryl sulfatase (formerly arylsulfatase C, ARSC) hydrolyses sulfate from steroid sulfates (Noel et al. 1983, Vaccaro et al. 1987, Suzuki et al. 1992). It is located on the ER membrane (Stein et al. 1989) and functions as a homodimer, using calcium as a cofactor. Defects in STS are the cause of ichthyosis X-linked (IXL) (MIM:308100), a keratinisation disorder (Basler et al. 1992, Alperin & Shapiro 1997).\"}]}" ;
