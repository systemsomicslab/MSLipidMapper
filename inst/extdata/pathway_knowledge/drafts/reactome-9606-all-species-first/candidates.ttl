    mslm:equation "Gly, TAU [peroxisomal matrix] + choloyl-CoA [peroxisomal matrix] => cholate bile salts [peroxisomal matrix] + H+ [peroxisomal matrix] + CoA-SH [peroxisomal matrix]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [192312], \"className\": \"CatalystActivity\", \"dbId\": 193371, \"displayName\": \"acyltransferase activity, transferring groups other than amino-acyl groups of BAAT [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690653, \"displayName\": \"RHEA:47101\", \"identifier\": \"47101\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/47101\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690652, \"displayName\": \"RHEA:14002\", \"identifier\": \"14002\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/14002\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9987754, \"displayName\": \"RHEA:14002\", \"identifier\": \"14002\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/14002\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9987743, \"displayName\": \"RHEA:47101\", \"identifier\": \"47101\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/47101\"}], \"dbId\": 192312, \"displayName\": \"Choloyl CoA reacts with glycine or taurine to form glycocholate or taurocholate\", \"followingEvent\": [192315], \"input\": [{\"className\": \"Chemical Compound\", \"c