<https://reactome.org/content/detail/R-HSA-163551> a mslm:LipidReaction ;
    rdfs:label "triacylglycerol + H2O -> diacylglycerol + fatty acid" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "H2O [cytosol] + TAG [lipid droplet] => LCFA(-) [cytosol] + H+ [cytosol] + DAG [lipid droplet]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [163551], \"className\": \"CatalystActivity\", \"dbId\": 163447, \"displayName\": \"triacylglycerol lipase activity of phosphorylated HSL dimer:FABP4 complex [lipid droplet]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005811\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13977, \"definition\": \"An intracellular non-membrane-bounded organelle comprising a matrix of coalesced lipids surrounded by a phospholipid monolayer. May include associated proteins.\", \"displayName\": \"lipid droplet\", \"name\": \"lipid droplet\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005811\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9958496, \"displayName\": \"RHEA:12045\", \"identifier\": \"12045\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/12045\"}], \"dbId\": 163551, \"displayName\": \"triacylglycerol + H2O -> diacylglycerol + fatty acid\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [163551], \"dbId\": 163438, \"displayName\": \"TAG [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TAG\", \"triglyceride\", \"Triacylglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-163438\", \"stIdVersion\": \"R-ALL-163438.7\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [163551], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"triacylglycerol + H2O -> diacylglycerol + fatty acid\", \"a triacylglycerol + H2O => a diacylglycerol + a fatty acid + H(+)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 163414, \"displayName\": \"DAG [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DAG\", \"1,2-diacyl-sn-glycerol\", \"1,2-Diacylglycerol\"], \"producedByEvent\": [163551], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-163414\", \"stIdVersion\": \"R-ALL-163414.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 8876730, \"displayName\": \"LCFA(-) [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [163551], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8876730\", \"stIdVersion\": \"R-ALL-8876730.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [163551], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 163549, \"displayName\": \"phosphorylated HSL dimer + FABP4 -> phosphorylated HSL dimer:FABP4 complex\", \"followingEvent\": [163551], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"phosphorylated HSL dimer + FABP4 -> phosphorylated HSL dimer:FABP4 complex\"], \"releaseDate\": \"2005-06-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163549\", \"stIdVersion\": \"R-HSA-163549.4\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2005-06-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163551\", \"stIdVersion\": \"R-HSA-163551.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 163589, \"displayName\": \"Activated rat HSL at the lipid particle hydrolyzes triacylgl...\", \"schemaClass\": \"Summation\", \"text\": \"Activated rat HSL at the lipid particle hydrolyzes triacylglycerol to yield diacylglycerol + fatty acid. In vitro, activated partially purified HSL catalyzes this reaction at only about two times the rate measured with non-activated enzyme (Fredrikson et al. 1981). The much greater rate increase caused by HSL phosphorylation in vivo appears to be due to its phosphorylation-dependent translocation to the surface of the lipid particle (Birnbaum 2003).<p>HSL-mediated triacylglycerol hydrolysis in humans has not been studied in detail, so the human reaction is inferred from the well-studied rat one.\"}]}" ;
