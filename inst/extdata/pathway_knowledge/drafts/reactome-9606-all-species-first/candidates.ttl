    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [266012], \"className\": \"CatalystActivity\", \"dbId\": 266039, \"displayName\": \"dipeptidase activity of DPEP1,2 dimers [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690587, \"displayName\": \"RHEA:48617\", \"identifier\": \"48617\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/48617\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9915903, \"displayName\": \"RHEA:48617\", \"identifier\": \"48617\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/48617\"}], \"dbId\": 266012, \"displayName\": \"LTD4 is converted to LTE4 by DPEP1/2\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [266012], \"dbId\": 266074, \"displayName\": \"LTD4 [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LTD4\", \"leukotriene D4(1-)\", \"leukotriene D4\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-266074\", \"stIdVersion\": \"R-ALL-266074.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [266012], \"dbId\": 109276, \"displayName\": \"H2O [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109276\", \"stIdVersion\": \"R-ALL-109276.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 266028, \"displayName\": \"Release and functional characterization of the leukotriene D4-metabolizing enzyme (dipeptidase) from human polymorphonuclear leucocytes\", \"journal\": \"Scand J Immunol\", \"pages\": \"305-13\", \"pubMedIdentifier\": 3563417, \"schemaClass\": \"LiteratureReference\", \"title\": \"Release and functional characterization of the leukotriene D4-metabolizing enzyme (dipeptidase) from human polymorphonuclear leucocytes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/3563417\", \"volume\": 25, \"year\": 1987}, {\"className\": \"LiteratureReference\", \"dbId\": 266042, \"displayName\": \"Conversion of leukotriene D4 to leukotriene E4 by a dipeptidase released from the specific granule of human polymorphonuclear leucocytes\", \"journal\": \"Immunology\", \"pages\": \"27-35\", \"pubMedIdentifier\": 6293969, \"schemaClass\": \"LiteratureReference\", \"title\": \"Conversion of leukotriene D4 to leukotriene E4 by a dipeptidase released from the specific granule of human polymorphonuclear leucocytes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/6293969\", \"volume\": 48, \"year\": 1983}, {\"className\": \"LiteratureReference\", \"dbId\": 2162134, \"displayName\": \"Purification and cha