tion\", \"dbId\": 10550868, \"displayName\": \"ALOX5 oxidises 18(S)-HEPE to 5(S)-Hp-18(S)-HEPE\", \"inferredFrom\": [9018858], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 18(S)-HEPE to 5(S)-Hp-18(S)-HEPE\", \"(18S)-hydroxy-(5Z,8Z,11Z,14Z,16E)-eicosapentaenoate + O2 => (5S)-hydroperoxy-(18S)-hydroxy-(6E,8Z,11Z,14Z,16E)-eicosapentaenoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9018858\", \"stIdVersion\": \"R-SSC-9018858.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10437445, \"displayName\": \"ALOX5 oxidises 18(S)-HEPE to 5(S)-Hp-18(S)-HEPE\", \"inferredFrom\": [9018858], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 18(S)-HEPE to 5(S)-Hp-18(S)-HEPE\", \"(18S)-hydroxy-(5Z,8Z,11Z,14Z,16E)-eicosapentaenoate + O2 => (5S)-hydroperoxy-(18S)-hydroxy-(6E,8Z,11Z,14Z,16E)-eicosapentaenoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9018858\", \"stIdVersion\": \"R-BTA-9018858.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10323557, \"displayName\": \"ALOX5 oxidises 18(S)-HEPE to 5(S)-Hp-18(S)-HEPE\", \"inferredFrom\": [9018858], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 18(S)-HEPE to 5(S)-Hp-18(S)-HEPE\", \"(18S)-hydroxy-(5Z,8Z,11Z,14Z,16E)-eicosapentaenoate + O2 => (5S)-hydroperoxy-(18S)-hydroxy-(6E,8Z,11Z,14Z,16E)-eicosapentaenoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9018858\", \"stIdVersion\": \"R-CFA-9018858.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10215673, \"displayName\": \"ALOX5 oxidises 18(S)-HEPE to 5(S)-Hp-18(S)-HEPE\", \"inferredFrom\": [9018858], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 18(S)-HEPE to 5(S)-Hp-18(S)-HEPE\", \"(18S)-hydroxy-(5Z,8Z,11Z,14Z,16E)-eicosapentaenoate + O2 => (5S)-hydroperoxy-(18S)-hydroxy-(6E,8Z,11Z,14Z,16E)-eicosapentaenoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9018858\", \"stIdVersion\": \"R-RNO-9018858.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092448, \"displayName\": \"ALOX5 oxidises 18(S)-HEPE to 5(S)-Hp-18(S)-HEPE\", \"inferredFrom\": [9018858], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 18(S)-HEPE to 5(S)-Hp-18(S)-HEPE\", \"(18S)-hydroxy-(5Z,8Z,11Z,14Z,16E)-eicosapentaenoate + O2 => (5S)-hydroperoxy-(18S)-hydroxy-(6E,8Z,11Z,14Z,16E)-eicosapentaenoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9018858\", \"stIdVersion\": \"R-MMU-9018858.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9020602, \"displayName\": \"5(S)-Hp-18(S)-HEPE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5(S)-Hp-18(S)-HEPE\", \"(5S)-hydroperoxy-(18S)-hydroxy-(6E,8Z,11Z,14Z,16E)-icosapentaenoate\", \"18S-hydroxy-5S-HpEPE(1-)\", \"(5S)-hydroperoxy-(18S)-hydroxy-(6E,8Z,11Z,14Z,16E)-icosapentaenoic acid\"], \"producedByEvent\": [9018858], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9020602\", \"stIdVersion\": \"R-ALL-9020602.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9018868, \"displayName\": \"GPX4-2 reduces 18(S)-HpEPE to 18(S)-HEPE\", \"followingEvent\": [9018858], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GPX4-2 reduces 18(S)-HpEPE to 18(S)-HEPE\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9018868\", \"stIdVersion\": \"R-HSA-9018868.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9018858\", \"stIdVersion\": \"R-HSA-9018858.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9020580, \"displayName\": \"Unlike resolvin E3, which is biosynthesised in eosinophils o...\", \"schemaClass\": \"Summation\", \"text\": \"Unlike resolvin E3, which is biosynthesised in eosinophils or resident macrophages via the 15-lipoxygenase (ALOX15) pathway, resolvins E1 and E2 are biosynthesised by neutrophils via the 5-lipoxygenase pathway. In neutrophils, ALOX5 oxidises 18(S)-hydroxyeicosapentaenoic acid (18(S)-HEPE) to 5(S)-hydroperoxy-18(S)-hydroxyeicosapentaenoic acid (5(S)-Hp-18(S)-HEPE) (Tjonahen et al. 2006, Oh et al. 2012). \"}]}" ;
