<https://reactome.org/content/detail/R-HSA-6814797> a mslm:LipidReaction ;
    rdfs:label "ENPP6 hydrolyzes lysophosphatidylcholine" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
