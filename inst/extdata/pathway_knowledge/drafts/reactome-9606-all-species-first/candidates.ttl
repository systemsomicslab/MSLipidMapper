"dbId\": 10542938, \"displayName\": \"OSBPL5,8,10 exchange PS with PI4P from ER membrane to plasma membrane\", \"inferredFrom\": [8867876], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"OSBPL5,8,10 exchange PS with PI4P from ER membrane to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8867876\", \"stIdVersion\": \"R-SSC-8867876.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10429177, \"displayName\": \"OSBPL5,8,10 exchange PS with PI4P from ER membrane to plasma membrane\", \"inferredFrom\": [8867876], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"OSBPL5,8,10 exchange PS with PI4P from ER membrane to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8867876\", \"stIdVersion\": \"R-BTA-8867876.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10315795, \"displayName\": \"OSBPL5,8,10 exchange PS with PI4P from ER membrane to plasma membrane\", \"inferredFrom\": [8867876], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"OSBPL5,8,10 exchange PS with PI4P from ER membrane to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8867876\", \"stIdVersion\": \"R-CFA-8867876.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10207171, \"displayName\": \"OSBPL5,8,10 exchange PS with PI4P from ER membrane to plasma membrane\", \"inferredFrom\": [8867876], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"OSBPL5,8,10 exchange PS with PI4P from ER membrane to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8867876\", \"stIdVersion\": \"R-RNO-8867876.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10084180, \"displayName\": \"OSBPL5,8,10 exchange PS with PI4P from ER membrane to plasma membrane\", \"inferredFrom\": [8867876], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"OSBPL5,8,10 exchange PS with PI4P from ER membrane to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8867876\", \"stIdVersion\": \"R-MMU-8867876.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 33625, \"displayName\": \"PS [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PS\", \"3-sn-phosphatidyl-L-serine\", \"Phosphatidylserine\", \"phosphatidyl-L-serine\", \"1,2-Diacyl-sn-glycerol 3-phospho-L-serine\", \"3-O-sn-Phosphatidyl-L-serine\", \"O3-Phosphatidyl-L-serine\"], \"producedByEvent\": [8867876], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-33625\", \"stIdVersion\": \"R-ALL-33625.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1806234, \"displayName\": \"PI4P [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI4P\", \"1-phosphatidyl-1D-myo-inositol 4-phosphate\"], \"producedByEvent\": [8867876], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806234\", \"stIdVersion\": \"R-ALL-1806234.3\"}], \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8867876\", \"stIdVersion\": \"R-HSA-8867876.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8867843, \"displayName\": \"Phosphatidylserine (PS) is a lipid component of cellular mem...\", \"schemaClass\": \"Summation\", \"text\": \"Phosphatidylserine (PS) is a lipid component of cellular membranes. It is synthesised in the endoplasmic reticulum and then preferentially associates with the inner leaflet of the plasma membrane by as-yet unknown mechanisms. Intracellular lipids can travel through aqueous phases via transport vesicles or lipid-transfer proteins (LTPs). Oxysterol-binding protein-related proteins 5, 8 and 10 (OSBPL5, OSBPL8 and OSBPL10) bind and transport PS from ER compartments to the plasma membrane. They tether the ER to the plasma membrane via interaction of their pleckstrin homology domains with phosphatidylinositol 4-phosphate (PI4P) and mediate PI4P/PS countertransport between the ER and the plasma membrane (Du et al. 2011, Chung et al. 2015, Perttila et al. 2009, Maeda et al. 2013). OSBPL10 is also implicated in apolipoprotein B100 secretion (Nissila et al. 2012).\"}]}" ;
