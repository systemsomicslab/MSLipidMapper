    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9845587], \"className\": \"CatalystActivity\", \"dbId\": 9845593, \"displayName\": \"alpha-N-acetylneuraminate alpha-2,8-sialyltransferase activity of ST8SIA5 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}], \"dbId\": 9845587, \"displayName\": \"ST8SIA5 transfers Neu5Ac to gangliosides\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9845587], \"dbId\": 727815, \"displayName\": \"CMP-Neu5Ac [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CMP-Neu5Ac\", \"CMP-N-acetyl-beta-neuraminate(2-)\", \"CMP-sialic acid\", \"CMP-N-acetyl-beta-neuraminic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-727815\", \"stIdVersion\": \"R-ALL-727815.4\"}, {\"className\": \"Set\", \"consumedByEvent\": [9845587], \"dbId\": 9845581, \"displayName\": \"GM1b,GD1a,GD3,GT1b [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GM1b,GD1a,GD3,GT1b\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9845581\", \"stIdVersion\": \"R-ALL-9845581.1\"}