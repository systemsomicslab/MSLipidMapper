    mslm:directionality mslm:SourceForward ;
    mslm:equation "TPA-CoA [peroxisomal matrix] => DPA [peroxisomal matrix]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 2046101, \"displayName\": \"Peroxisomal beta-oxidation of tetracosapentaenoyl-CoA to Docosapentaenoyl-CoA\", \"goBiologicalProcess\": {\"accession\": \"0033539\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 260812, \"definition\": \"A fatty acid beta-oxidation pathway in which the initial step of each oxidation cycle, which converts an acyl-CoA to a trans-2-enoyl-CoA, is catalyzed by acyl-CoA dehydrogenase; the electrons removed by oxidation pass through the respiratory chain to oxygen and leave H2O as the product. Fatty acid beta-oxidation begins with the addition of coenzyme A to a fatty acid, and ends when only two or three carbons remain (as acetyl-CoA or propionyl-CoA respectively).\", \"displayName\": \"fatty acid beta-oxidation using acyl-CoA dehydrogenase\", \"name\": \"fatty acid beta-oxidation using acyl-CoA dehydrogenase\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0033539\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [2046101], \"dbId\": 2046055, \"displayName\": \"TPA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TPA-CoA\", \"(6Z,9Z,12Z,15Z,18Z)-tetracosapentaenoyl-CoA(4-)\", \"6Z,9Z,12Z,15Z,18Z-tetracosapentaenoyl-CoA (TPA-CoA)\", \"(6Z,9Z,12Z,15Z,18Z)-tetracosapentaenoyl-CoA\", \"Tetracosapentaenoyl-CoA\", \"24:5n-6\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046055\", \"stIdVersion\": \"R-ALL-2046055.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 2045969, \"displayName\": \"Analysis of the putative role of 24-carbon polyunsaturated fatty acids in the biosynthesis of docosapentaenoic (22:5n-6) and docosahexaenoic (22:6n-3) acids\", \"journal\": \"FEBS Lett\", \"pages\": \"1-6\", \"pubMedIdentifier\": 9684854, \"schemaClass\": \"LiteratureReference\", \"title\": \"Analysis of the putative role of 24-carbon polyunsaturated fatty acids in the biosynthesis of docosapentaenoic (22:5n-6) and docosahexaenoic (22:6n-3) acids\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9684854\", \"volume\": 431, \"year\": 1998}], \"maxDepth\": 1, \"name\": [\"Peroxisomal beta-oxidation of tetracosapentaenoyl-CoA to Docosapentaenoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2066764, \"displayName\": \"DPA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DPA\", \"(4Z,7Z,10Z,13Z,16Z)-docosapentaenoate\", \"Docosapentaenoic acid\", \"(4Z,7Z,10Z,13Z,16Z)-docosa-4,7,10,13,16-pentaenoic acid\", \"http://hmdb.ca/metabolites/HMDB01976\"], \"producedByEvent\": [2046101], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2066764\", \"stIdVersion\": \"R-ALL-2066764.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2046093, \"displayName\": \"Translocation of tetracosapentaenoyl-CoA to peroxisomes\", \"followingEvent\": [2046101], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Translocation of tetracosapentaenoyl-CoA to peroxisomes\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2046093\", \"stIdVersion\": \"R-HSA-2046093.3\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2046101\", \"stIdVersion\": \"R-HSA-2046101.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2045953, \"displayName\": \"One cycle of peroxisomal beta-oxidation shortens C24:5(n-6) ...\", \"schemaClass\": \"Summation\", \"text\": \"One cycle of peroxisomal beta-oxidation shortens C24:5(n-6) to C22:5(n-6), releasing one molecules of acetyl-CoA. Peroxisomal acyl-coenzyme A oxidase 1 (AOX), D-bifunctional protein (DBP/MFE2), and either peroxisomal 3-oxoacyl-CoA thiolase (Th) or SCPx thiolase (SCPx) enzymes have been proposed to be responsible for this partial beta-oxidation (Infante & Huszagh 1998, Su et al. 2001).\"}]}" ;
