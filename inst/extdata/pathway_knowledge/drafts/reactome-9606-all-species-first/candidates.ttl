    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [193065], \"className\": \"CatalystActivity\", \"dbId\": 193154, \"displayName\": \"cholesterol monooxygenase (side-chain-cleaving) activity of CYP11A1:FDXR:FDX1,FDX1L (red.) [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 193065, \"displayName\": \"Oxidation of 22beta-hydroxycholesterol to 20alpha,22beta-hydroxycholesterol\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193065], \"dbId\": 193019, \"displayName\": \"22b-HCHOL [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"22b-HCHOL\", \"(22S)-22-hydroxycholesterol\", \"22beta-hydroxycholesterol\", \"22_beta__minus_hydroxycholesterol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193019\", \"stIdVersion\": \"R-ALL-193019.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [193065], \"dbId\": 113600, \"displayName\": \"NADPH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113600\", \"stIdVersion\": \"R-ALL-113600.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [193065], \"dbId\": 113533, \"displayName\": \"O2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113533\", \"stIdVersion\": \"R-ALL-113533.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [193065], \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 193118, \"displayName\": \"Human cholesterol side-chain cleavage enzyme, P450scc: cDNA cloning, assignment of the gene to chromosome 15, and expression in the placenta\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"8962-6\", \"pubMedIdentifier\": 3024157, \"schemaClass\": \"LiteratureReference\", \"title\": \"Human cholesterol side-chain cleavage enzyme, P450scc: cDNA cloning, assignment of the gene to chromosome 15, and expression in the placenta\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/3024157\", \"volume\": 83, \"year\": 1986}, {\"className\": \"LiteratureReference\", \"dbId\": 193076, \"displayName\": \"Expression of catalytically active human cytochrome p450scc in Escherichia coli and mutagenesis of isoleucine-462\", \"journal\": \"Arch Biochem Biophys\", \"pages\": \"109-15\", \"pubMedIdentifier\": 9578606, \"schemaClass\": \"LiteratureReference\", \"title\": \"Expression of catalytically active human cytochrome p450scc in Escherichia coli and mutagenesis of isoleucine-462\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9578606\", \"volume\": 353, \"year\": 1998}], \"maxDepth\": 1, \"name\": [\"Oxidation of 22beta-hydroxycholesterol to 20alpha,22beta-hydroxycholesterol\", \"22beta-hydroxycholesterol + NADPH + H+ + O2 => 20alpha,22beta-hydroxycholesterol + NADP+ + H2O\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10753480, \"displayName\": \"Oxidation of 22beta-hydroxycholesterol to 20alpha,22beta-hydroxycholesterol\", \"inferredFrom\": [193065], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Oxidation of 22beta-hydroxycholesterol to 20alpha,22beta-hydroxycholesterol\", \"22beta-hydroxycholesterol + NADPH + H+ + O2 => 20alpha,22beta-hydroxycholesterol + NADP+ + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-193065\", \"stIdVersion\": \"R-GGA-193065.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10671187, \"displayName\": \"Oxidation of 22beta-hydroxycholesterol to 20alpha,22beta-hydroxycholesterol\", \"inferredFrom\": [193065], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Oxidation of 22beta-hydroxycholesterol to 20alpha,22beta-hydroxycholesterol\", \"22beta-hydroxycholesterol + NADPH + H+ + O2 => 20alpha,22beta-hydroxycholesterol + NADP+ + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-193065\", \"stIdVersion\": \"R-XTR-193065.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10580438, \"displayName\": \"Oxidation of 22beta-hydroxycholesterol to 20alpha,22beta-hydroxycholesterol\", \"inferredFrom\": [193065], \"isInDisease\": false, \"isInfe