\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1606273, \"displayName\": \"SMPD2 and 3 hydrolyze sphingomyelin (plasma membrane)\", \"followingEvent\": [1638845], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SMPD2 and 3 hydrolyze sphingomyelin (plasma membrane)\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1606273\", \"stIdVersion\": \"R-HSA-1606273.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1640164, \"displayName\": \"ENPP7 hydrolyzes sphingomyelin\", \"followingEvent\": [1638845], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ENPP7 hydrolyzes sphingomyelin\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1640164\", \"stIdVersion\": \"R-HSA-1640164.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1861788, \"displayName\": \"GBA2 hydrolyzes GlcCer (plasma membrane)\", \"followingEvent\": [1638845], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GBA2 hydrolyzes GlcCer (plasma membrane)\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1861788\", \"stIdVersion\": \"R-HSA-1861788.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1638845\", \"stIdVersion\": \"R-HSA-1638845.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1638836, \"displayName\": \"Ceramide kinase (CERK) mediates the phosphorylation of ceram...\", \"schemaClass\": \"Summation\", \"text\": \"Ceramide kinase (CERK) mediates the phosphorylation of ceramide (CERA) to the lipid second messenger, ceramide 1-phosphate (C1P). Although Cer species with N>12 carbon chains are better substrates, short-chain Cer species, including C2-Cer, can also be reacted. CERK is located in the plasma membrane, with CERA being supplied both by transporters from de-novo biosynthesis in the Golgi or by the hydrolysis of sphingomyelin in the plasma membrane (Sugiura et al. 2002; reviewed in Bornancin, 2011). The product C1P is involved in cancer cell growth, migration, survival, and inflammation (reviewed by Hait & Maiti, 2017).\"}]}" ;
