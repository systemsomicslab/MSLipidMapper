chemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-428690\", \"stIdVersion\": \"R-MMU-428690.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 109277, \"displayName\": \"Pi [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"inorganic phosphate\", \"phosphate\"], \"producedByEvent\": [428690], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109277\", \"stIdVersion\": \"R-ALL-109277.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1132148, \"displayName\": \"sphingosine [cytoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"sphingosine\", \"sphingosine(1+)\", \"sphing-4-enine\", \"phys-ent-participant33701\"], \"producedByEvent\": [428690], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1132148\", \"stIdVersion\": \"R-ALL-1132148.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9695890, \"displayName\": \"SPNS2,MFSD2B transport S1P from cytosol to extracellular region\", \"followingEvent\": [428690], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SPNS2,MFSD2B transport S1P from cytosol to extracellular region\"], \"releaseDate\": \"2020-09-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9695890\", \"stIdVersion\": \"R-HSA-9695890.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9843721, \"displayName\": \"ABCC1,ABCG2 transport C18-S1P to extracellular region\", \"followingEvent\": [428690], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ABCC1,ABCG2 transport C18-S1P to extracellular region\"], \"releaseDate\": \"2023-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9843721\", \"stIdVersion\": \"R-HSA-9843721.2\"}], \"releaseDate\": \"2009-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428690\", \"stIdVersion\": \"R-HSA-428690.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 428695, \"displayName\": \"Phospholipid phosphatase 2 (PLPP2, PPAP2A, LPP3) enzyme asso...\", \"schemaClass\": \"Summation\", \"text\": \"Phospholipid phosphatase 2 (PLPP2, PPAP2A, LPP3) enzyme associated with the plasma membrane catalyzes the hydrolysis of extracellular sphingosine 1-phosphate (S1P) to form sphingosine and orthophosphate. The reaction is essential for removing S1P from plasma and cell uptake of sphingosine (Roberts et al., 1998; Zhao et al., 2007; reviewed by Tang et al., 2015).\"}]}" ;
