ersion\": \"R-RNO-429798.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10022024, \"displayName\": \"SGMS1 transfers phosphocholine onto ceramide\", \"inferredFrom\": [429798], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SGMS1 transfers phosphocholine onto ceramide\", \"phosphatidylcholine + ceramide <=> sphingomyelin + diacylglycerol [SGMS1]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-429798\", \"stIdVersion\": \"R-MMU-429798.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 429789, \"displayName\": \"SPHM [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SPHM\", \"sphingomyelin\", \"sphingomyelins\", \"sphingomyelin d18:1\", \"ceramide phosphocholines\"], \"producedByEvent\": [429798], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-429789\", \"stIdVersion\": \"R-ALL-429789.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524057, \"displayName\": \"DAG [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DAG\", \"1,2-diacyl-sn-glycerol\", \"1,2-diacylglycerol\"], \"producedByEvent\": [429798], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524057\", \"stIdVersion\": \"R-ALL-1524057.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9956909, \"displayName\": \"CERT1-2 transfers CERA from the ER membrane to the Golgi membrane\", \"followingEvent\": [429798], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CERT1-2 transfers CERA from the ER membrane to the Golgi membrane\"], \"releaseDate\": \"2025-09-18\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9956909\", \"stIdVersion\": \"R-HSA-9956909.1\"}], \"releaseDate\": \"2009-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-429798\", \"stIdVersion\": \"R-HSA-429798.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 429803, \"displayName\": \"SGMS1 (sphingomyelin synthase 1) associated with the membran...\", \"schemaClass\": \"Summation\", \"text\": \"SGMS1 (sphingomyelin synthase 1) associated with the membrane of the Golgi apparatus catalyzes the reversible reaction of phosphatidylcholine and ceramide to form sphingomyelin and diacylglycerol. Phosphatidylcholine was identified as the source of the phosphocholine moiety donated to ceramide in this reaction in studies of the mouse enzyme in the 1970s (Diringer et al. 1972; Ullman and Radin 1974). SGMS1 is widely expressed in the body, and studies of cultured cells indicate that this reaction provides the primary source of cellular sphingomyelin (Yamaoka et al., 2004; Huitema et al., 2004; Tafesse et al., 2007; reviewed by Chen & Cao, 2017).\"}]}" ;
