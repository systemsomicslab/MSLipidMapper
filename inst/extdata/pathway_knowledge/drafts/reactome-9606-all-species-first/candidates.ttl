    mslm:equation "PLIN1 [lipid droplet] + ATP [cytosol] => p-S81,S277-PLIN1 [lipid droplet] + ADP [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [163418], \"className\": \"CatalystActivity\", \"dbId\": 163605, \"displayName\": \"protein serine/threonine kinase activity of PKA catalytic subunit [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005811\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13977, \"definition\": \"An intracellular non-membrane-bounded organelle comprising a matrix of coalesced lipids surrounded by a phospholipid monolayer. May include associated proteins.\", \"displayName\": \"lipid droplet\", \"name\": \"lipid droplet\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005811\"}], \"dbId\": 163418, \"displayName\": \"perilipin + 2 ATP -> phosphorylated perilipin + 2 ADP\", \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [163418], \"dbId\": 163460, \"displayName\": \"PLIN1 [lipid droplet]\", \"endCoordinate\": 522, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PLIN1\", \"perilipin\", \"PLIN\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163460\", \"stIdVersion\": \"R-HSA-163460.2\", \"startCoordinate\": 1}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [163418, 163418], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, 113592], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"perilipin + 2 ATP -> phosphorylated perilipin + 2 ADP\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 163561, \"displayName\": \"p-S81,S277-PLIN1 [lipid droplet]\", \"endCoordinate\": 522, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"p-S81,S277-PLIN1\", \"p-S277,S81-PLIN1\", \"phosphorylated perilipin\"], \"producedByEvent\": [163418], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163561\", \"stIdVersion\": \"R-HSA-163561.2\", \"startCoordinate\": 1}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [163418, 163418], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, 29370], \"precedingEvent\": [{\"category\": \"dissociation\", \"className\": \"Reaction\", \"dbId\": 163539, \"displayName\": \"perilipin:ABHD5 complex -> perilipin + ABHD5\", \"followingEvent\": [163418], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"perilipin:ABHD5 complex -> perilipin + ABHD5\"], \"releaseDate\": \"2005-06-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163539\", \"stIdVersion\": \"R-HSA-163539.4\"}], \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 163651, \"displayName\": \"Positive regulation by 'CAV1 [lipid droplet]'\", \"regulatedEntity\": [163418], \"schemaClass\": \"PositiveRegulation\", \"stId\": \"R-HSA-163651\", \"stIdVersion\": \"R-HSA-163651.1\"}], \"releaseDate\": \"2005-06-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163418\", \"stIdVersion\": \"R-HSA-163418.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 163590, \"displayName\": \"Rat perilipin, the major protein at the surfaces of cytosoli...\", \"schemaClass\": \"Summation\", \"text\": \"Rat perilipin, the major protein at the surfaces of cytosolic lipid particles in adipocytes and steroidogenic cells (Blanchette-Mackie et al. 1995), is phosphorylated by protein kinase A catalytic subunit (Greenberg et al. 1991) on serine residues 81, 223, and 277 (Tansey et al. 2003). All three serine residues and the adjoining sequences that mediate phosphorylation (Cohen 1988) are conserved in mouse perilipin, while only the first and third are conserved in human perilipin. By inference, PKA targets these three mouse and two human serines as well. Phosphorylated perilipin is redistributed on the droplet surfaces (Souza et al. 1998). While two isoforms of rat perilipin protein are found on lipid particles in adipocytes, only the larger isoform appears to regulate lipolysis (Tansey et al 2003). The single human and mouse isoforms of perilipin correspond to the large rat isoform. In mouse 3T3-L1 cells, perilipin phosphorylation requires the presence of caveolin-1 at the surface of the lipid particle (Cohen et al. 2004). This positive regulatory effect of caveolin-1 is inferred for rat and human.\"}]}" ;
