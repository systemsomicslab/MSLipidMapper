<https://reactome.org/content/detail/R-HSA-8878914> a mslm:LipidReaction ;
    rdfs:label "B3GALNT1 transfers GalNAc to Gb3Cer to form Gb4Cer" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "Gb3Cer [Golgi membrane] + UDP-GalNAc [Golgi lumen] => H+ [Golgi lumen] + UDP [Golgi lumen] + Gb4Cer [Golgi membrane]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8878914], \"className\": \"CatalystActivity\", \"dbId\": 8879103, \"displayName\": \"galactosylgalactosylglucosylceramide beta-D-acetylgalactosaminyltransferase activity of B3GALNT1 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}, {\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}], \"dbId\": 8878914, \"displayName\": \"B3GALNT1 transfers GalNAc to Gb3Cer to form Gb4Cer\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8878914], \"dbId\": 8879102, \"displayName\": \"Gb3Cer [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Gb3Cer\", \"alpha-D-galactosyl-(1->4)-beta-D-galactosyl-(1->4)-beta-D-glucosylceramide\", \"Globotriaosylceramide\", \"alpha-D-galactosyl-(1->4)-beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1)-ceramide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8879102\", \"stIdVersion\": \"R-ALL-8879102.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8878914], \"dbId\": 735700, \"displayName\": \"UDP-GalNAc [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP-GalNAc\", \"UDP-N-acetyl-D-galactosamine(2-)\", \"UDP--N-acetylgalactosamine\", \"UDP-N-acetyl-D-galactosamine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-735700\", \"stIdVersion\": \"R-ALL-735700.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8879098, \"displayName\": \"Expression cloning of human globoside synthase cDNAs. Identification of beta 3Gal-T3 as UDP-N-acetylgalactosamine:globotriaosylceramide beta 1,3-N-acetylgalactosaminyltransferase\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"40498-503\", \"pubMedIdentifier\": 10993897, \"schemaClass\": \"LiteratureReference\", \"title\": \"Expression cloning of human globoside synthase cDNAs. Identification of beta 3Gal-T3 as UDP-N-acetylgalactosamine:globotriaosylceramide beta 1,3-N-acetylgalactosaminyltransferase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/10993897\", \"volume\": 275, \"year\": 2000}, {\"className\": \"LiteratureReference\", \"dbId\": 977007, \"displayName\": \"A family of human beta3-galactosyltransferases. Characterization of four members of a UDP-galactose:beta-N-acetyl-glucosamine/beta-nacetyl-galactosamine beta-1,3-galactosyltransferase family\", \"journal\": \"J Biol Chem\", \"pages\": \"12770-8\", \"pubMedIdentifier\": 9582303, \"schemaClass\": \"LiteratureReference\", \"title\": \"A family of human beta3-galactosyltransferases. Characterization of four members of a UDP-galactose:beta-N-acetyl-glucosamine/beta-nacetyl-galactosamine beta-1,3-galactosyltransferase family\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9582303\", \"volume\": 273, \"year\": 1998}], \"maxDepth\": 1, \"name\": [\"B3GALNT1 transfers GalNAc to Gb3Cer to form Gb4Cer\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10317520, \"displayName\": \"B3GALNT1 transfers GalNAc to Gb3Cer to form Gb4