<https://reactome.org/content/detail/R-HSA-1482939> a mslm:LipidReaction ;
    rdfs:label "CDP-DAG is converted to PGP by PGS1" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "G3P [mitochondrial matrix] + CDP-DAG [mitochondrial inner membrane] => CMP [mitochondrial matrix] + PGP [mitochondrial inner membrane]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [1482939], \"className\": \"CatalystActivity\", \"dbId\": 1524058, \"displayName\": \"CDP-diacylglycerol-glycerol-3-phosphate 3-phosphatidyltransferase activity of PGS1 [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}, {\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12689774, \"displayName\": \"RHEA:12593\", \"identifier\": \"12593\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/12593\"}], \"dbId\": 1482939, \"displayName\": \"CDP-DAG is converted to PGP by PGS1\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1482939], \"dbId\": 1524064, \"displayName\": \"CDP-DAG [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CDP-DAG\", \"CDP-diacylglycerol(2-)\", \"Cytidine diphosphate diacylglycerol\", \"CDP-diacylglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524064\", \"stIdVersion\": \"R-ALL-1524064.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [1482939], \"dbId\": 188458, \"displayName\": \"G3P [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"G3P\", \"sn-glycerol 3-phosphate(2-)\", \"Glycerol-3-phosphate\", \"sn-glycerol 3-phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-188458\", \"stIdVersion\": \"R-ALL-188458.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1601989, \"displayName\": \"Complete sequencing and characterization of 21,243 full-length human cDNAs\", \"journal\": \"Nat Genet\", \"pages\": \"40-5\", \"pubMedIdentifier\": 14702039, \"schemaClass\": \"LiteratureReference\", \"title\": \"Complete sequencing and characterization of 21,243 full-length human cDNAs\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/14702039\", \"volume\": 36, \"year\": 2004}], \"maxDepth\": 1, \"name\": [\"CDP-DAG is converted to PGP by PGS1\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1524059, \"displayName\": \"PGP [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGP\", \"1-(3-sn-phosphatidyl)-sn-glycerol 3-phosphate(3-)\", \"3-(3-sn-phosphatidyl)-sn-glycerol 1-phosphate\", \"1-(3-sn-phosphatidyl)-sn-glycerol 3-phosphate\", \"Phosphatidylglycerophosphate\"], \"producedByEvent\": [1482939], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524059\", \"stIdVersion\": \"R-ALL-1524059.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524067, \"displayName\": \"CMP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CMP\", \"cytidine 5'-monophosphate(2-)\", \"cytidine 5'-monophosphate\", \"cytidylic acid\", \"Cytidine-5'-monophosphate\", \"CMP(2-)\"], \"producedByEvent\": [1482939], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524067\", \"stIdVersion\": \"R-ALL-1524067.6\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1483165, \"displayName\": \"PA is converted to CDP-DAG by CDS2\", \"followingEvent\": [1482939], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PA is converted to CDP-DAG by CDS2\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483165\", \"stIdVersion\": \"R-HSA-1483165.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482939\", \"stIdVersion\": \"R-HSA-1482939.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482944, \"displayName\": \"At the inner mitochondrial (IM) membrane, CDP-diacylglycerol...\", \"schemaClass\": \"Summation\", \"text\": \"At the inner mitochondrial (IM) membrane, CDP-diacylglycerol--glycerol-3-phosphate 3-phosphatidyltransferase (PGS1) converts cytidine diphosphate-diacylglycerol (CDP-DAG) and glycerol-3-phosphate (G3P) to phosphatidylglycerophosphate (PGP) and cytidine monophosphate (CMP).  This event is inferred from rats.  The enzyme PGS1 has been characterized in humans (Ota et al. 2004).\"}]}" ;
