{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10089817, \"displayName\": \"PLD6 dimer hydrolyses cardiolipin to PA and PG\", \"inferredFrom\": [8954398], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLD6 dimer hydrolyses cardiolipin to PA and PG\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8954398\", \"stIdVersion\": \"R-MMU-8954398.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1500590, \"displayName\": \"PA [mitochondrial outer membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PA\", \"phosphatidate(2-)\", \"phosphatidic acid\"], \"producedByEvent\": [8954398], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500590\", \"stIdVersion\": \"R-ALL-1500590.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 8954401, \"displayName\": \"PG [mitochondrial outer membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PG\", \"1,2-diacyl-sn-glycero-3-phospho-(1'-sn-glycerol)(1-)\", \"phosphatidylglycerol\"], \"producedByEvent\": [8954398], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8954401\", \"stIdVersion\": \"R-ALL-8954401.4\"}], \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 8954403, \"displayName\": \"Positive regulation by 'MIGA complexes [mitochondrial outer membrane]'\", \"regulatedEntity\": [8954398], \"schemaClass\": \"PositiveRegulation\", \"stId\": \"R-HSA-8954403\", \"stIdVersion\": \"R-HSA-8954403.1\"}], \"releaseDate\": \"2017-03-27\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8954398\", \"stIdVersion\": \"R-HSA-8954398.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8954428, \"displayName\": \"Mitochondrial cardiolipin hydrolase (PLD6 aka MitoPLD) is lo...\", \"schemaClass\": \"Summation\", \"text\": \"Mitochondrial cardiolipin hydrolase (PLD6 aka MitoPLD) is located on the outer mitochondrial membrane and promotes trans-mitochondrial membrane adherence (mitochondrial fusion) in a Mfn-dependent manner by hydrolysing cardiolipin to generate the acidic fusogenic lipid phosphatidic acid (PA) and phosphatidylglycerol (PG) (Choi et al. 2006). Although cardiolipin is primarily an inner mitochondrial membrane-located protein, the outer mitochondrial membrane also contains around 10-20% cardiolipin and cardiolipin has been shown to translocate in a regulatable manner between the compartments (Liu et al. 2003). Mitoguardin 1 and 2 (MIGA1 and MIGA2) are regulators of mitochondrial membrane fusion. They form homo- or hetero-dimers at the mitochondrial outer membrane where they interact with PLD6 to stabilise it and/or facilitate PLD6 dimer formation (Zhang et al. 2016).\"}]}" ;
