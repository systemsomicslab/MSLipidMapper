    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [6814797], \"className\": \"CatalystActivity\", \"dbId\": 6814792, \"displayName\": \"glycerophosphocholine cholinephosphodiesterase activity of ENPP6 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9643068, \"displayName\": \"glycerophosphocholine cholinephosphodiesterase activity of ENPP6 [plasma membrane] Biochemical and molecular characterization of a novel choline-specific glycerophosphodiester phosphodiesterase belonging to the nucleotide pyrophosphatase/phosphodiesterase family\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 6814797, \"displayName\": \"ENPP6 hydrolyzes lysophosphatidylcholine\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [6814797], \"dbId\": 2239407, \"displayName\": \"lysophosph