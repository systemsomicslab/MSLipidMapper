    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8954398], \"className\": \"CatalystActivity\", \"dbId\": 8954400, \"displayName\": \"cardiolipin phospholipase D activity of PLD6 dimer [mitochondrial outer membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005741\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17906, \"definition\": \"The outer, i.e. cytoplasm-facing, lipid bilayer of the mitochondrial envelope.\", \"displayName\": \"mitochondrial outer membrane\", \"name\": \"mitochondrial outer membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005741\"}, {\"accession\": \"0005758\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17927, \"definition\": \"The region between the inner and outer lipid bilayers of the mitochondrial envelope.\", \"displayName\": \"mitochondrial intermembrane space\", \"name\": \"mitochondrial intermembrane space\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005758\"}], \"dbId\": 8954398, \"displayName\": \"PLD6 dimer hydrolyses cardiolipin to PA and PG\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8954398], \"dbId\": 8954419, \"displayName\": \"cardiolipin [mitochondrial outer membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"cardiolipin\", \"CL\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8954419\", \"stIdVersion\": \"R-ALL-8954419.2\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8954398], \"dbId\": 189422, \"displayName\": \"H2O [mitochondrial intermembrane space]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-189422\", \"stIdVersion\": \"R-ALL-189422.3\"