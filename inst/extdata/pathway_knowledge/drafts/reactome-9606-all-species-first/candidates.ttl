bId\": 1500581, \"displayName\": \"PE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PE\", \"phosphatidylethanolamine zwitterion\", \"phosphatidylethanolamine\"], \"producedByEvent\": [1482646], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500581\", \"stIdVersion\": \"R-ALL-1500581.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [1482646], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482828, \"displayName\": \"PE is hydrolyzed to 2-acyl LPE by PLA2[4]\", \"followingEvent\": [1482646], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PE is hydrolyzed to 2-acyl LPE by PLA2[4]\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482828\", \"stIdVersion\": \"R-HSA-1482828.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482892, \"displayName\": \"PE is hydrolyzed to 2-acyl LPE by PLA2G4C\", \"followingEvent\": [1482646], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PE is hydrolyzed to 2-acyl LPE by PLA2G4C\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482892\", \"stIdVersion\": \"R-HSA-1482892.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482646\", \"stIdVersion\": \"R-HSA-1482646.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482638, \"displayName\": \"At the endoplasmic reticulum (ER) membrane, lysophospholipid...\", \"schemaClass\": \"Summation\", \"text\": \"At the endoplasmic reticulum (ER) membrane, lysophospholipid acyltransferases acylate 2-acyl lysophosphatidylethanolamine (LPE) to form phosphatidylethanolamine (PE).  The lysophospholipid acyltransferases involved are: lysophospholipid acyltransferase 1 (MBOAT1) aka LPEAT1 (Gijon et al. 2008, Hishikawa et al. 2008); lysophospholipid acyltransferase LPCAT4 (LPCAT4) aka LPEAT2 (Cao et al. 2008, Ye et al. 2005); lysophospholipid acyltransferase 2 (MBOAT2) aka LPCAT4 (Hishikawa et al. 2008, Gijon et al. 2008); lysophospholipid acyltransferase 5 (LPCAT3) (Hishikawa et al. 2008, Zhao et al. 2008, Gijon et al. 2008, Jain et al. 2009, Kazachkov et al. 2008).\"}]}" ;
