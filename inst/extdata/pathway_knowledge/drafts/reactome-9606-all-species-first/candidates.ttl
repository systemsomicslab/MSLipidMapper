    mslm:equation "17(S)-Hp-DHA [cytosol] + O2 [cytosol] => PDX [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9024872], \"className\": \"CatalystActivity\", \"dbId\": 9022673, \"displayName\": \"arachidonate 15-lipoxygenase activity of ALOX15 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9024872, \"displayName\": \"ALOX15 oxidises 17(S)-Hp-DHA to PDX\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9024872], \"dbId\": 9024012, \"displayName\": \"17(S)-Hp-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17(S)-Hp-DHA\", \"(4Z,7Z,10Z,13Z,15E,17S,19Z)-17-hydroperoxydocosahexaenoate\", \"(17S)-HPDHA(1-)\", \"(17S)-HPDoHE\", \"(4Z,7Z,10Z,13Z,15E,17S,19Z)-17-hydroperoxydocosahexaenoic acid\", \"17(S)-hydroperoxy-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024012\", \"stIdVersion\": \"R-ALL-9024012.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9024872], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9020250, \"displayName\": \"Anti-inflammatory actions of neuroprotectin D1/protectin D1 and its natural stereoisomers: assignments of dihydroxy-containing docosatrienes\", \"journal\": \"J. Immunol.\", \"pages\": \"1848-59\", \"pubMedIdentifier\": 16424216, \"schemaClass\": \"LiteratureReference\", \"title\": \"Anti-inflammatory actions of neuroprotectin D1/protectin D1 and its natural stereoisomers: assignments of dihydroxy-containing docosatrienes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/16424216\", \"volume\": 176, \"year\": 2006}, {\"className\": \"LiteratureReference\", \"dbId\": 9024475, \"displayName\": \"Novel docosatrienes and 17S-resolvins generated from docosahexaenoic acid in murine brain, human blood, and glial cells. Autacoids in anti-inflammation\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"14677-87\", \"pubMedIdentifier\": 12590139, \"schemaClass\": \"LiteratureReference\", \"title\": \"Novel docosatrienes and 17S-resolvins generated from docosahexaenoic acid in murine brain, human blood, and glial cells. Autacoids in anti-inflammation\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12590139\", \"volume\": 278, \"year\": 2003}, {\"className\": \"LiteratureReference\", \"dbId\": 9024888, \"displayName\": \"Full characterization of PDX, a neuroprotectin/protectin D1 isomer, which inhibits blood platelet aggregation\", \"journal\": \"FEBS Lett.\", \"pages\": \"3478-84\", \"pubMedIdentifier\": 19818771, \"schemaClass\": \"LiteratureReference\", \"title\": \"Full characterization of PDX, a neuroprotectin/protectin D1 isomer, which inhibits blood platelet aggregation\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/19818771\", \"volume\": 583, \"year\": 2009}], \"maxDepth\": 1, \"name\": [\"ALOX15 oxidises 17(S)-Hp-DHA to PDX\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11051136, \"displayName\": \"ALOX15 oxidises 17(S)-Hp-DHA to PDX\", \"inferredFrom\": [9024872], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX15 oxidises 17(S)-Hp-DHA to PDX\"], \"releaseDate\": \"