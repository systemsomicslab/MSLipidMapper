\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-1676203\", \"stIdVersion\": \"R-CEL-1676203.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10872039, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\", \"inferredFrom\": [1676203], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-1676203\", \"stIdVersion\": \"R-DME-1676203.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10781897, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\", \"inferredFrom\": [1676203], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-1676203\", \"stIdVersion\": \"R-GGA-1676203.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10692194, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\", \"inferredFrom\": [1676203], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-1676203\", \"stIdVersion\": \"R-XTR-1676203.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10604534, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\", \"inferredFrom\": [1676203], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-1676203\", \"stIdVersion\": \"R-DRE-1676203.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10502113, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\", \"inferredFrom\": [1676203], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1676203\", \"stIdVersion\": \"R-SSC-1676203.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10387504, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\", \"inferredFrom\": [1676203], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1676203\", \"stIdVersion\": \"R-BTA-1676203.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10277334, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\", \"inferredFrom\": [1676203], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1676203\", \"stIdVersion\": \"R-CFA-1676203.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10041955, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\", \"inferredFrom\": [1676203], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1676203\", \"stIdVersion\": \"R-MMU-1676203.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1806240, \"displayName\": \"PI5P [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI5P\", \"1-phosphatidyl-1D-myo-inositol 5-phosphate(3-)\", \"1-phosphatidyl-1D-myo-inositol 5-phosphate\"], \"producedByEvent\": [1676203], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806240\", \"stIdVersion\": \"R-ALL-1806240.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [1676203], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676134, \"displayName\": \"PI3P is phosphorylated to PI(3,5)P2 by PIP5K1A/B at the plasma membrane\", \"followingEvent\": [1676203], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI3P is phosphorylated to PI(3,5)P2 by PIP5K1A/B at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676134\", \"stIdVersion\": \"R-HSA-1676134.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676203\", \"stIdVersion\": \"R-HSA-1676203.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1676023, \"displayName\": \"At the plasma membrane, synaptojanin-1 aka Synaptic inositol...\", \"schemaClass\": \"Summation\", \"text\": \"At the plasma membrane, synaptojanin-1 aka Synaptic inositol-1,4,5-trisphosphate 5-phosphatase 1 (SYNJ1) (Guo et al. 1999), -2 (SYNJ2) and some myotubularins (MTMs) dephosphorylate phosphatidylinositol 3,5-bisphosphate (PI(3,5)P2) to phosphatidylinositol 5-phosphate (PI5P). The MTMs involved are: myotubularin (MTM1) (Cao et al. 2007, Tronchere et al. 2004, Schaletzky et al. 2003, Laporte et al. 2002) and myotubularin-related proteins 1 (MTMR1) (Tronchere et al. 2004), 3 (MTMR3) (Walker et al. 2001, Lorenzo et al. 2005), 6 (MTMR6) (Schaletzky et al. 2003, Choudhury et al. 2006), and 14 (MTMR14) (Tosch et al. 2006).\"}]}" ;
