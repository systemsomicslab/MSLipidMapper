edFrom\": [9705584], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCR dimer binds statins\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-9705584\", \"stIdVersion\": \"R-DME-9705584.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10825571, \"displayName\": \"HMGCR dimer binds statins\", \"inferredFrom\": [9705584], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCR dimer binds statins\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-9705584\", \"stIdVersion\": \"R-GGA-9705584.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10730059, \"displayName\": \"HMGCR dimer binds statins\", \"inferredFrom\": [9705584], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCR dimer binds statins\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9705584\", \"stIdVersion\": \"R-XTR-9705584.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10647671, \"displayName\": \"HMGCR dimer binds statins\", \"inferredFrom\": [9705584], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCR dimer binds statins\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9705584\", \"stIdVersion\": \"R-DRE-9705584.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10554386, \"displayName\": \"HMGCR dimer binds statins\", \"inferredFrom\": [9705584], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCR dimer binds statins\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9705584\", \"stIdVersion\": \"R-SSC-9705584.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10441060, \"displayName\": \"HMGCR dimer binds statins\", \"inferredFrom\": [9705584], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCR dimer binds statins\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9705584\", \"stIdVersion\": \"R-BTA-9705584.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10219508, \"displayName\": \"HMGCR dimer binds statins\", \"inferredFrom\": [9705584], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCR dimer binds statins\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9705584\", \"stIdVersion\": \"R-RNO-9705584.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10096231, \"displayName\": \"HMGCR dimer binds statins\", \"inferredFrom\": [9705584], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCR dimer binds statins\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9705584\", \"stIdVersion\": \"R-MMU-9705584.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 9705595, \"displayName\": \"HMGCR dimer:statins [endoplasmic reticulum membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 4, \"name\": [\"HMGCR dimer:statins\"], \"producedByEvent\": [9705584], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9705595\", \"stIdVersion\": \"R-HSA-9705595.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9757010, \"displayName\": \"SLCO1B1,1B3,2B1-3 transport ATV from extracelluar region to cytosol\", \"followingEvent\": [9705584], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SLCO1B1,1B3,2B1-3 transport ATV from extracelluar region to cytosol\", \"Organic anion transporters transport ATV from blood into hepatocytes\"], \"releaseDate\": \"2022-03-23\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9757010\", \"stIdVersion\": \"R-HSA-9757010.2\"}], \"releaseDate\": \"2022-06-09\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9705584\", \"stIdVersion\": \"R-HSA-9705584.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9705590, \"displayName\": \"Dimeric 3-hydroxy-3-methyl glutaryl coenzyme A reductase (HM...\", \"schemaClass\": \"Summation\", \"text\": \"Dimeric 3-hydroxy-3-methyl glutaryl coenzyme A reductase (HMGCR dimer) is the key enzyme in the cholesterol biosynthetic pathway and catalyzes the committed step of the reduction of beta-hydroxy-3-methylglutaryl CoA (bHMG-CoA) to mevalonate. HMGCR is regarded as one of the most important drug targets in the treatment of hypercholesterolemia. HMGCR inhibitors, commonly referred to as statins, are among the most widely prescribed drugs in the world. Statins work by their similarity to the substrate (bHMG-CoA), leading to competition towards the HMG binding site on the enzyme between substrate and statins (Istvan & Deisenhofer 2001). As statins also block the access of the substrate to the binding site, the affinity of HMGCR for statins is slightly higher than its affinity for the substrate (Istvan 2002, Carbonell & Ernesto Freire 2005, Gesto et al. 2020). Statins can be divided in two types, according to their origin. Type I statins e.g. lovastatin, pravastatin and simvastatin, are natural fungal products and Type II statins e.g. atorvastatin, rosuvastatin and fluvastatin, are fully synthetic.\"}]}" ;
