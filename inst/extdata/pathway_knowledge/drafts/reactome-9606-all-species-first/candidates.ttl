-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676168, \"displayName\": \"PI3P is phosphorylated to PI(3,5)P2 by PIKFYVE at the early endosome membrane\", \"followingEvent\": [1676174], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI3P is phosphorylated to PI(3,5)P2 by PIKFYVE at the early endosome membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676168\", \"stIdVersion\": \"R-HSA-1676168.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676174\", \"stIdVersion\": \"R-HSA-1676174.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1676064, \"displayName\": \"At the early endosome membrane, the PAS complex, consisting ...\", \"schemaClass\": \"Summation\", \"text\": \"At the early endosome membrane, the PAS complex, consisting of FYVE finger-containing phosphoinositide kinase (PIKFYVE), yeast VAC14 homologue (VAC14), and polyphosphoinositide phosphatase aka SAC3 (FIG4), binds to the membrane via PIKFYVE's FYVE finger.  The FIG4 phosphatase component dephosphorylates phosphatidylinositol 3,5-bisphosphate (PI(3,5)P2) to phosphatidylinositol 3-phosphate (PI3P) (Sbrissa et al. 2007, Sbrissa et al. 2008).\"}]}" ;
