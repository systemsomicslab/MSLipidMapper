<https://reactome.org/content/detail/R-HSA-191999> a mslm:LipidReaction ;
    rdfs:label "CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "NADPH [mitochondrial matrix] + H+ [mitochondrial matrix] + O2 [mitochondrial matrix] + 5bCHOL3a,7a,12a-triol [mitochondrial matrix] => NADP+ [mitochondrial matrix] + 5bCHOL3a,7a,12a,27-tetrol [mitochondrial matrix] + H2O [mitochondrial matrix]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [191999], \"className\": \"CatalystActivity\", \"dbId\": 192037, \"displayName\": \"oxidoreductase activity, acting on NAD(P)H as acceptor of CYP27A1 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 191999, \"displayName\": \"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"followingEvent\": [192042], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [191999], \"dbId\": 192078, \"displayName\": \"5bCHOL3a,7a,12a-triol [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5bCHOL3a,7a,12a-triol\", \"5beta-cholestane-3alpha,7alpha,12alpha-triol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192078\", \"stIdVersion\": \"R-ALL-192078.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [191999], \"dbId\": 113600, \"displayName\": \"NADPH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113600\", \"stIdVersion\": \"R-ALL-113600.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [191999], \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [191999], \"dbId\": 113533, \"displayName\": \"O2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113533\", \"stIdVersion\": \"R-ALL-113533.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 192197, \"displayName\": \"Characterization of human sterol 27-hydroxylase. A mitochondrial cytochrome P-450 that catalyzes multiple oxidation reaction in bile acid biosynthesis.\", \"journal\": \"J Biol Chem\", \"pages\": \"7774-8\", \"pubMedIdentifier\": 1708392, \"schemaClass\": \"LiteratureReference\", \"title\": \"Characterization of human sterol 27-hydroxylase. A mitochondrial cytochrome P-450 that catalyzes multiple oxidation reaction in bile acid biosynthesis.\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/1708392\", \"volume\": 266, \"year\": 1991}, {\"className\": \"LiteratureReference\", \"dbId\": 193487, \"displayName\": \"Mutations in the bile acid biosynthetic enzyme sterol 27-hydroxylase underlie cerebrotendinous xanthomatosis\", \"journal\": \"J Biol Chem\", \"pages\": \"7779-83\", \"pubMedIdentifier\": 2019602, \"schemaClass\": \"LiteratureReference\", \"title\": \"Mutations in the bile acid biosynthetic enzyme sterol 27-hydroxylase underlie cerebrotendinous xanthomatosis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/2019602\", \"volume\": 266, \"year\": 1991}, {\"className\": \"LiteratureReference\", \"dbId\": 193375, \"displayName\": \"Activities of recombinant human cytochrome P450c27 (CYP27) which produce intermediates of alternative bile acid biosynthetic pathways\", \"journal\": \"J Biol Chem\", \"pages\": \"18153-60\", \"pubMedIdentifier\": 9660774, \"schemaClass\": \"LiteratureReference\", \"title\": \"Activities of recombinant human cytochrome P450c27 (CYP27) which produce intermediates of alternative bile acid biosynthetic pathways\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9660774\", \"volume\": 273, \"year\": 1998}], \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol is hydroxylated to 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol + NADPH + H+ + O2 => 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol + NADP+ + H2O\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10580275, \"displayName\": \"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"inferredFrom\": [191999], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol is hydroxylated to 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol + NADPH + H+ + O2 => 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol + NADP+ + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-191999\", \"stIdVersion\": \"R-DRE-191999.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10470381, \"displayName\": \"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"inferredFrom\": [191999], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol is hydroxylated to 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol + NADPH + H+ + O2 => 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol + NADP+ + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-191999\", \"stIdVersion\": \"R-SSC-191999.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10355492, \"displayName\": \"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"inferredFrom\": [191999], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol is hydroxylated to 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol + NADPH + H+ + O2 => 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol + NADP+ + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-191999\", \"stIdVersion\": \"R-BTA-191999.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10248452, \"displayName\": \"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"inferredFrom\": [191999], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol is hydroxylated to 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol + NADPH + H+ + O2 => 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol + NADP+ + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-191999\", \"stIdVersion\": \"R-CFA-191999.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10127999, \"displayName\": \"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"inferredFrom\": [191999], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol is hydroxylated to 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol + NADPH + H+ + O2 => 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol + NADP+ + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-191999\", \"stIdVersion\": \"R-RNO-191999.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007080, \"displayName\": \"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"inferredFrom\": [191999], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP27A1 27-hydroxylates 5bCHOL3a,7a,12a-triol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol is hydroxylated to 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol\", \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol + NADPH + H+ + O2 => 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol + NADP+ + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-191999\", \"stIdVersion\": \"R-MMU-191999.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192201, \"displayName\": \"5bCHOL3a,7a,12a,27-tetrol [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5bCHOL3a,7a,12a,27-tetrol\", \"5beta-cholestane-3alpha,7alpha,12alpha,26-tetrol\", \"5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\"], \"producedByEvent\": [191999], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192201\", \"stIdVersion\": \"R-ALL-192201.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [191999], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113563, \"displayName\": \"NADP+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [191999], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113563\", \"stIdVersion\": \"R-ALL-113563.6\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 192010, \"displayName\": \"5beta-cholestan-3alpha, 7alpha, 12alpha-triol is translocated from the cytosol to the mitochondrial matrix\", \"followingEvent\": [191999], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha, 7alpha, 12alpha-triol is translocated from the cytosol to the mitochondrial matrix\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192010\", \"stIdVersion\": \"R-HSA-192010.4\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-191999\", \"stIdVersion\": \"R-HSA-191999.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 192093, \"displayName\": \"CYP27A1, a mitochondrial matrix sterol hydroxylase, catalyse...\", \"schemaClass\": \"Summation\", \"text\": \"CYP27A1, a mitochondrial matrix sterol hydroxylase, catalyses the 27-hydroxylation of side-chains of sterol intermediates (Cali et al. 1991). A specific reaction is the 27-hydroxylation of 5beta-cholestan-3alpha, 7alpha, 12alpha-triol (5bCHOL3a,7a,12a-triol) to form 5beta-cholestan-3alpha, 7alpha, 12alpha, 27-tetrol (5bCHOL3a,7a,12a, 27-tetrol) (Pikuleva et al. 1998). Defects in CYP27A1 can cause Cerebrotendinous xanthomatosis (CTX; MIM:213700), a rare sterol storage disorder characterised by progressive neurologic dysfunction, premature atherosclerosis and cataracts (Cali et al. 1991b).\"}]}" ;
