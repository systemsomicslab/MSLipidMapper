    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8878654], \"className\": \"CatalystActivity\", \"dbId\": 8878643, \"displayName\": \"lysophosphatidic acid phosphatase activity of ACP6 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 8878654, \"displayName\": \"ACP6 hydrolyses MYS-LPA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8878654], \"dbId\": 8878649, \"displayName\": \"MYS-LPA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MYS-LPA\", \"1-myristoyl-sn-glycerol 3-phosphate\", \"myristoyl lysophosphatidic acid\", \"LPA(14:0)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8878649\", \"stIdVersion\": \"R-ALL-8878649.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8878654], \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8878651, \"displayName\": \"Crystal structures and biochemical studies of human lysophosphatidic acid phosphatase type 6\", \"journal\": \"Protein Cell\", \"pages\": \"548-61\", \"pubMedIdentifier\": 23807634, \"schemaClass\": \"LiteratureReference\", \"title\": \"Crystal structures and biochemical studies of human lysophosphatidic acid phosphatase type 6\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/23807634\", \"volume\": 4, \"year\": 2013}, {\"className\": \"LiteratureReference\", \"dbId\": 8878647, \"displayName\": \"Isolation of a cDNA encoding human lysophosphatidic acid phosphatase that is involved in the regulation of mitochondrial lipid biosynthesis\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"29172-80\", \"pubMedIdentifier\": 10506173, \"schemaClass\": \"LiteratureReference\", \"title\": \"Isolation of a cDNA encoding human lysophosphatidic acid phosphatase that is involved in the regulation of mitochondrial lipid biosynthesis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/10506173\", \"volume\": 274, \"year\": 1999}], \"maxDepth\": 1, \"name\": [\"ACP6 hydrolyses MYS-LPA\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11081743, \"displayName\": \"ACP6 hydrolyses MYS-LPA\", \"inferredFrom\": [8878654], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACP6 hydrolyses MYS-LPA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-8878654\", \"stIdVersion\": \"R-SPO-8878654.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11048646, \"displayName\": \"ACP6 hydrolyses MYS-LPA\", \"inferredFrom\": [8878654], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACP6 hydrolyses MYS-LPA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-8878654\", \"stIdVersion\": \"R-DDI-8878654.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1