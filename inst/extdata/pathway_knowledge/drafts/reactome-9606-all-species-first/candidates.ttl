Event\": [1676185], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI3P is dephosphorylated to PI by SACM1L at the Golgi membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676114\", \"stIdVersion\": \"R-HSA-1676114.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676185\", \"stIdVersion\": \"R-HSA-1676185.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1675889, \"displayName\": \"At the Golgi membrane, phosphatidylinositol 4-kinase alpha (...\", \"schemaClass\": \"Summation\", \"text\": \"At the Golgi membrane, phosphatidylinositol 4-kinase alpha (PI4KA) (Gehrmann et al. 1999, Godi et al. 1999), or phosphatidylinositol 4-kinase type 2-alpha/beta (PI4K2A/B) (Balla et al. 2002, Minogue et al. 2001, Wei et al. 2002) phosphorylate phosphatidylinositol (PI) to produce phosphatidylinositol 4-phosphate (PI4P).\"}]}" ;
