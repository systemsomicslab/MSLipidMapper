", \"dbId\": 10558973, \"displayName\": \"ST3GAL2,3 transfer Neu5Ac to gangliosides\", \"inferredFrom\": [9845538], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ST3GAL2,3 transfer Neu5Ac to gangliosides\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9845538\", \"stIdVersion\": \"R-SSC-9845538.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10445720, \"displayName\": \"ST3GAL2,3 transfer Neu5Ac to gangliosides\", \"inferredFrom\": [9845538], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ST3GAL2,3 transfer Neu5Ac to gangliosides\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9845538\", \"stIdVersion\": \"R-BTA-9845538.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10224473, \"displayName\": \"ST3GAL2,3 transfer Neu5Ac to gangliosides\", \"inferredFrom\": [9845538], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ST3GAL2,3 transfer Neu5Ac to gangliosides\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9845538\", \"stIdVersion\": \"R-RNO-9845538.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10100944, \"displayName\": \"ST3GAL2,3 transfer Neu5Ac to gangliosides\", \"inferredFrom\": [9845538], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ST3GAL2,3 transfer Neu5Ac to gangliosides\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9845538\", \"stIdVersion\": \"R-MMU-9845538.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 727810, \"displayName\": \"CMP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CMP\", \"cytidine 5'-monophosphate(2-)\", \"cytidine 5'-monophosphate\", \"cytidylic acid\", \"Cytidine-5'-monophosphate\"], \"producedByEvent\": [9845538], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-727810\", \"stIdVersion\": \"R-ALL-727810.6\"}, {\"className\": \"Set\", \"dbId\": 9845541, \"displayName\": \"GD1a,GM1b,GT1b [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GD1a,GM1b,GT1b\"], \"producedByEvent\": [9845538], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9845541\", \"stIdVersion\": \"R-ALL-9845541.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [9845538], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9845516, \"displayName\": \"B3GALT4 transfers Gal to gangliosides\", \"followingEvent\": [9845538], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"B3GALT4 transfers Gal to gangliosides\"], \"releaseDate\": \"2023-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9845516\", \"stIdVersion\": \"R-HSA-9845516.2\"}], \"releaseDate\": \"2023-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9845538\", \"stIdVersion\": \"R-HSA-9845538.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9845534, \"displayName\": \"The alpha-2,3-sialyltransferases 2 and 3 (ST3GAL2,3) transfe...\", \"schemaClass\": \"Summation\", \"text\": \"The alpha-2,3-sialyltransferases 2 and 3 (ST3GAL2,3) transfer a sialic acid (Neu5Ac) moiety to the terminal galactosyl (Gal-R) residue of gangliosides GM1, GA1, and GD1b to produce GD1a, GM1b, and GT1a. Neu5Ac is added to Gal-R via an alpha-2,3 linkage (Kim et al., 1996; Grahn et al., 2002; Sturgill et al., 2012). Gangliosides localize to the plasma membrane via vesicle transport, endocytosis, and exocytosis. Defects in ST3GAL3 cause an intellectual developmental disorder (MRT12, MIM:611090; reviewed by Khamirani et al., 2021).\"}]}" ;
