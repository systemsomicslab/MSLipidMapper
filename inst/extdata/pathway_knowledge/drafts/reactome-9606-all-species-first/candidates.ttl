, \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1483256\", \"stIdVersion\": \"R-ALL-1483256.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [1482539], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482900, \"displayName\": \"PG is hydrolyzed to 1-acyl LPG by PLA2[1]\", \"followingEvent\": [1482539], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PG is hydrolyzed to 1-acyl LPG by PLA2[1]\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482900\", \"stIdVersion\": \"R-HSA-1482900.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482907, \"displayName\": \"PG is hydrolyzed to 1-acyl LPG by PLA2G2A\", \"followingEvent\": [1482539], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PG is hydrolyzed to 1-acyl LPG by PLA2G2A\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482907\", \"stIdVersion\": \"R-HSA-1482907.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482539\", \"stIdVersion\": \"R-HSA-1482539.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482552, \"displayName\": \"At the endoplasmic reticulum (ER) membrane, lysophospholipid...\", \"schemaClass\": \"Summation\", \"text\": \"At the endoplasmic reticulum (ER) membrane, lysophospholipid acyltransferases acylate 1-acyl lysophosphatidylglycerol (LPG) to form phosphatidylglycerol (PG).  The lysophospholipid acyltransferases involved are: lysophosphatidylcholine acyltransferase 1 (LPCAT1) (Nakanishi et al. 2006, Chen et al. 2006), lysophospholipid acyltransferase LPCAT4 (LPCAT4) aka LPEAT2 (Cao et al. 2008, Ye et al. 2005); or acyl-CoA:lysophosphatidylglycerol acyltransferase (LPGAT1) (Yang et al. 2004).\"}]}" ;
