    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9020274], \"className\": \"CatalystActivity\", \"dbId\": 9024992, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen, incorporation of two atoms of oxygen of ALOX12:Fe2+ [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9020274, \"displayName\": \"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9020274], \"dbId\": 9024011, \"displayName\": \"DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHA\", \"(4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoate\", \"Docosahexaenoic acid\", \"all-cis-docosa-4,7,10,13,16,19-hexaenoic acid\", \"cis-4,7,10,13,16,19-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024011\", \"stIdVersion\": \"R-ALL-9024011.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9020274], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9024988, \"displayName\": \"Maresins: novel macrophage mediators with potent antiinflammatory and proresolving actions\", \"journal\": \"J. Exp. Med.\", \"pages\": \"15-23\", \"pubMedIdentifier\": 19103881, \"schemaClass\": \"LiteratureReference\", \"title\": \"Maresins: novel macrophage mediators with potent antiinflammatory and proresolving actions\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/19103881\", \"volume\": 206, \"year\": 2009}, {\"className\": \"LiteratureReference\", \"dbId\": 9024996, \"displayName\": \"Maresin biosynthesis and identification of maresin 2, a new anti-inflammatory and pro-resolving mediator from human macrophages\", \"journal\": \"PLoS ONE\", \"pages\": \"e102362\", \"pubMedIdentifier\": 25036362, \"schemaClass\": \"LiteratureReference\", \"title\": \"Maresin biosynthesis and identification of maresin 2, a new anti-inflammatory and pro-resolving mediator from human macrophages\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25036362\", \"volume\": 9, \"year\": 2014}], \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11051093, \"displayName\": \"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\", \"inferredFrom\": [9020274], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-9020274\", \"stIdVersion\": \"R-DDI-9020274.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10645092, \"displayName\": \"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\", \"inferredFrom\": [9020274], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9020274\", \"stIdVersion\": \"R-DRE-9020274.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10550922, \"displayName\": \"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\", \"inferredFrom\": [9020274], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9020274\", \"stIdVersion\": \"R-SSC-9020274.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10437499, \"displayName\": \"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\", \"inferredFrom\": [9020274], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9020274\", \"stIdVersion\": \"R-BTA-9020274.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10323611, \"displayName\": \"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\", \"inferredFrom\": [9020274], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9020274\", \"stIdVersion\": \"R-CFA-9020274.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10215727, \"displayName\": \"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\", \"inferredFrom\": [9020274], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9020274\", \"stIdVersion\": \"R-RNO-9020274.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092502, \"displayName\": \"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\", \"inferredFrom\": [9020274], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DHA to 14(S)-Hp-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9020274\", \"stIdVersion\": \"R-MMU-9020274.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9025012, \"displayName\": \"14(S)-Hp-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"14(S)-Hp-DHA\", \"(4Z,8E,10Z,12E,14S,16Z,19Z)-14-hydroperoxydocosahexaenoate\", \"14(S)-HpDHA(1-)\", \"(4Z,8E,10Z,12E,14S,16Z,19Z)-14-hydroperoxydocosahexaenoic acid\", \"14(S)-hydroperoxy-docosahexaenoic acid\"], \"producedByEvent\": [9020274], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9025012\", \"stIdVersion\": \"R-ALL-9025012.5\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9020274\", \"stIdVersion\": \"R-HSA-9020274.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9024972, \"displayName\": \"Maresins are a family of anti-inflammatory and pro-resolving...\", \"schemaClass\": \"Summation\", \"text\": \"Maresins are a family of anti-inflammatory and pro-resolving lipid mediators biosynthesized from docosahexaenoic acid (DHA) by macrophages. In the first step, DHA is oxygenated by lipoxygenase 12 using Fe2+ cofactor (ALOX12:Fe2+) to 14(S)-hydroperoxy-docosahexaenoic acid (14(S)-Hp-DHA) (Serhan et al. 2009, Deng et al. 2014). Maresin-like mediators MaR-L1 and Mar-L2 are produced by leukocytes and platelets and have been shown to restore reparative functions of diabetic macrophages in wounds (Brem & Tomic-Canic 2007, Hong et al. 2014). The same reaction as above can occur in human leukocytes and platelets to produce MaR-L1 and MaR-L2. The 14(S)-Hp-DHA intermediate can also serve as a precursor for maresin conjugates in tissue regeneration (MCTR) (Dalli et al. 2016).\"}]}" ;
