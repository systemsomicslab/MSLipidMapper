or [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"hydrogen donor\", \"AH2\", \"reduced electron acceptor\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1131953\", \"stIdVersion\": \"R-ALL-1131953.1\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9023641, \"displayName\": \"Resolvin E2 formation and impact in inflammation resolution\", \"journal\": \"J. Immunol.\", \"pages\": \"4527-34\", \"pubMedIdentifier\": 22450811, \"schemaClass\": \"LiteratureReference\", \"title\": \"Resolvin E2 formation and impact in inflammation resolution\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/22450811\", \"volume\": 188, \"year\": 2012}, {\"className\": \"LiteratureReference\", \"dbId\": 9020605, \"displayName\": \"Resolvin E2: identification and anti-inflammatory actions: pivotal role of human 5-lipoxygenase in resolvin E series biosynthesis\", \"journal\": \"Chem. Biol.\", \"pages\": \"1193-202\", \"pubMedIdentifier\": 17114001, \"schemaClass\": \"LiteratureReference\", \"title\": \"Resolvin E2: identification and anti-inflammatory actions: pivotal role of human 5-lipoxygenase in resolvin E series biosynthesis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17114001\", \"volume\": 13, \"year\": 2006}, {\"className\": \"LiteratureReference\", \"dbId\": 9023711, \"displayName\": \"Substrate selectivity of 5-hydroxyeicosanoid dehydrogenase and its inhibition by 5-hydroxy-Delta6-long-chain fatty acids\", \"journal\": \"J. Pharmacol. Exp. Ther.\", \"pages\": \"335-41\", \"pubMedIdentifier\": 19164464, \"schemaClass\": \"LiteratureReference\", \"title\": \"Substrate selectivity of 5-hydroxyeicosanoid dehydrogenase and its inhibition by 5-hydroxy-Delta6-long-chain fatty acids\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/19164464\", \"volume\": 329, \"year\": 2009}], \"maxDepth\": 1, \"name\": [\"5-HEDH dehydrogenates 5(S)-Hp-18(R)-HEPE to 18(R)-RvE2\", \"(5S)-hydroperoxy-(18R)-hydroxy-(6E,8Z,11Z,14Z,16E)-eicosapentaenoate + AH2 => A + H2O + resolvin E2\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9023700, \"displayName\": \"18(R)-RvE2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"18(R)-RvE2\", \"resolvin E2(1-)\", \"(18R)-resolvin E2\", \"resolvin E2\"], \"producedByEvent\": [9018901], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9023700\", \"stIdVersion\": \"R-ALL-9023700.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1130886, \"displayName\": \"hydrogen acceptor [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"hydrogen acceptor\", \"A\", \"oxidized electron acceptor\"], \"producedByEvent\": [9018901], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1130886\", \"stIdVersion\": \"R-ALL-1130886.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [9018901], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9018863, \"displayName\": \"ALOX5 oxidises 18(R)-HEPE to 5(S)-Hp-18(R)-HEPE\", \"followingEvent\": [9018901], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 18(R)-HEPE to 5(S)-Hp-18(R)-HEPE\", \"(18R)-hydroxy-(5Z,8Z,11Z,14Z,16E)-eicosapentaenoate + O2 => (5S)-hydroperoxy-(18R)-hydroxy-(6E,8Z,11Z,14Z,16E)-eicosapentaenoate\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9018863\", \"stIdVersion\": \"R-HSA-9018863.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9018901\", \"stIdVersion\": \"R-HSA-9018901.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9023705, \"displayName\": \"An unknown dehydrogenase reduces 5(S)-hydroperoxy-18(R)-hydr...\", \"schemaClass\": \"Summation\", \"text\": \"An unknown dehydrogenase reduces 5(S)-hydroperoxy-18(R)-hydroxyeicosapentaenoic acid (5(S)-Hp-18(R)-HEPE) into the 18(R) stereoisomer of resolvin E2 (18(R)-RvE2). The unknown enzyme may be 5-hydroxyeicosanoid dehydrogenase (5-HEDH) or one similar to this (Patel et al. 2009). Human neutrophils biosynthesise RvE2 in greater amounts than RvE1, suggesting a significant role for RvE2 (Tjonahen et al. 2006, Oh et al. 2012).\"}]}" ;
