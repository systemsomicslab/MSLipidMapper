ed\": true, \"maxDepth\": 1, \"name\": [\"GPX4-2 reduces 17(S)-Hp-DHA to 17(S)-HDHA\", \"(17S)-hydroperoxy-(4Z,7Z,10Z,13Z,15E,19Z)-docosahexaenoate + 2 glutathione => (17S)-hydroxy-(4Z,7Z,10Z,13Z,15E,19Z)-docosahexaenoate + glutathione disulfide + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9020273\", \"stIdVersion\": \"R-RNO-9020273.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092500, \"displayName\": \"GPX4-2 reduces 17(S)-Hp-DHA to 17(S)-HDHA\", \"inferredFrom\": [9020273], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GPX4-2 reduces 17(S)-Hp-DHA to 17(S)-HDHA\", \"(17S)-hydroperoxy-(4Z,7Z,10Z,13Z,15E,19Z)-docosahexaenoate + 2 glutathione => (17S)-hydroxy-(4Z,7Z,10Z,13Z,15E,19Z)-docosahexaenoate + glutathione disulfide + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9020273\", \"stIdVersion\": \"R-MMU-9020273.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9024815, \"displayName\": \"17(S)-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17(S)-HDHA\", \"(17S)-HDHA(1-)\", \"17(S)-HDHA(1-)\", \"17(S)-hydroxydocosahexaenoic acid\", \"17(S)-HDoHE\"], \"producedByEvent\": [9020273], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024815\", \"stIdVersion\": \"R-ALL-9024815.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111745, \"displayName\": \"GSSG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GSSG\", \"glutathione disulfide(2-)\", \"oxidized glutathione\", \"glutathione disulfide\"], \"producedByEvent\": [9020273], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111745\", \"stIdVersion\": \"R-ALL-111745.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [9020273], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9020275, \"displayName\": \"ALOX15 oxidises DHA to 17(S)-Hp-DHA\", \"followingEvent\": [9020273], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX15 oxidises DHA to 17(S)-Hp-DHA\", \"4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoate + O2 => (17S)-hydroperoxy-(4Z,7Z,10Z,13Z,15E,19Z)-docosahexaenoate\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9020275\", \"stIdVersion\": \"R-HSA-9020275.3\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9020273\", \"stIdVersion\": \"R-HSA-9020273.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9024473, \"displayName\": \"Cytosolic phospholipid hydroperoxide glutathione peroxidase ...\", \"schemaClass\": \"Summation\", \"text\": \"Cytosolic phospholipid hydroperoxide glutathione peroxidase (GPX4 isoform 2, GPX4-2) (Yagi et al. 1996) is a likely candidate for the reduction of organic hydroperoxides such as 17(S)-hydroperoxy-docosahexaenoic acid (17(S)-Hp-DHA) to 17(S)-hydroxydocosahexaenoic acid (17(S)-HDHA) (Han et al. 2013) using glutathione (GSH) as an electron donor (Brigelius-Flohe & Maiorino 2013).\"}]}" ;
