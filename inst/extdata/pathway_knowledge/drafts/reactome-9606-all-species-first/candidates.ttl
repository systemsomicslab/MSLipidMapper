    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8875013], \"className\": \"CatalystActivity\", \"dbId\": 8875012, \"displayName\": \"medium-chain fatty acid-CoA ligase activity of ACSM3,ACSM6 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9977723, \"displayName\": \"RHEA:46173\", \"identifier\": \"46173\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/46173\"}], \"dbId\": 8875013, \"displayName\": \"ACSM3,ACSM6 ligate CoA to BUT\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8875013], \"dbId\": 8875042, \"displayName\": \"BUT [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"BUT\", \"butyrate\", \"Butyrate\", \"butyric acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8875042\", \"stIdVersion\": \"R-ALL-8875042.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8875013], \"dbId\": 113593, \"displayName\": \"ATP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113593\", \"stIdVersion\": \"R-ALL-113593.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8875013], \"dbId\": 29374, \"displayName\": \"CoA-SH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"CoA\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29374\", \"stIdVersion\": \"R-ALL-29374.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 177141, \"displayName\": \"Molecular identification and characterization of two medium-chain acyl-CoA synthetases, MACS1 and the Sa gene product\", \"journal\": \"J Biol Chem\", \"pages\": \"35961-6\", \"pubMedIdentifier\": 11470804, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular identification and characterization of two medium-chain acyl-CoA synthetases, MACS1 and the Sa gene product\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11470804\", \"volume\": 276, \"year\": 2001}, {\"className\": \"LiteratureReference\", \"dbId\": 8875031, \"displayName\": \"Human SA gene locus as a candidate locus for essential hypertension\", \"journal\": \"Hypertension\", \"pages\": \"375-80\", \"pubMedIdentifier\": 7907320, \"schemaClass\": \"LiteratureReference\", \"title\": \"Human SA gene locus as a candidate locus for essential hypertension\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/7907320\", \"volume\": 23, \"year\": 1994}, {\"className\": \"LiteratureReference\", \"dbId\": 8875043, \"displayName\": \"Association between SAH, an acyl-CoA synthetase gene, and hypertriglyceridemia, obesity, and hypertension\", \"journal\": \"Circulation\", \"pages\": \"41-7\", \"pubMedIdentifier\": 11772874, \"schemaClass\": \"LiteratureReference\", \"title\": \"Association between SAH, an acyl-CoA synthetase gene, and hypertriglyceridemia, obesity, and hypertension\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11772874\", \"volume\": 105, \"year\": 2002}, {\"className\": \"LiteratureReference\", \"dbId\": 8875008, \"displayName\": \"SAH gene variants are associated with obesity-related hypertension in Caucasians: the PEGASE Study\", \"journal\": \"J. Hypertens.\", \"pages\": \"557-64\", \"pubMedIdentifier\": 17278971, \"schemaClass\": \"LiteratureReference\", \"title\": \"SAH gene variants are associated with obesity-related hypertension in Caucasians: the PEGASE Study\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17278971\", \"volume\": 25, \"year\": 2007}, {\"className\": \"LiteratureReference\", \"dbId\": 8875026, \"displayName\": \"SAH gene variants revisited in the European Project On Genes in Hypertension\", \"journal\": \"J. Hypertens.\", \"pages\": \"244-50\", \"pubMedIdentifier\": 18192838, \"schemaClass\": \"LiteratureReference\", \"title\": \"SAH gene variants revisited in the European Project On Genes in Hypertension\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18192838\", \"volume\": 26, \"year\": 2008}], \"maxDepth\": 1, \"name\": [\"ACSM3,ACSM6 ligate CoA to BUT\", \"butanoate + ATP + CoA => butanoyl-CoA + AMP + diphosphate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 77318, \"displayName\": \"BT-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"BT-CoA\", \"butyryl-CoA(4-)\", \"Butanoyl-CoA\", \"butyryl-CoA\", \"beta-hydroxybutyryl-CoA\"], \"producedByEvent\": [8875013], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77318\", \"stIdVersion\": \"R-ALL-77318.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 159448, \"displayName\": \"AMP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AMP\", \"adenosine 5'-monophosphate(2-)\", \"adenosine 5'-monophosphate\", \"Adenylic acid\", \"Adenylate\", \"5'-AMP\", \"5'-Adenylic acid\", \"5'-Adenosine monophosphate\"], \"producedByEvent\": [8875013], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-159448\", \"stIdVersion\": \"R-ALL-159448.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 159450, \"displayName\": \"PPi [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [8875013], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-159450\", \"stIdVersion\": \"R-ALL-159450.5\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8875013\", \"stIdVersion\": \"R-HSA-8875013.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8875046, \"displayName\": \"Mitochondrial acyl-coenzyme A synthetase ACSM3 (aka protein ...\", \"schemaClass\": \"Summation\", \"text\": \"Mitochondrial acyl-coenzyme A synthetase ACSM3 (aka protein SAH homolog) is expressed in the mitochondrial matrix and possesses medium-chain fatty acid:CoA ligase activity. Based on characterisation experiments in mice, ACSM3 preferentially ligates C2-C6 fatty acids, especially butyrate (BUT, a C4 fatty acid) (Fujino et al. 2001). The product, butyryl-CoA (BT-CoA) is used in beta oxidation. ACSM3 gene variants may be associated with obesity-related hypertension (Iwai et al. 1994, 2002, Telgmann et al. 2007, Tikhonoff et al. 2008). The mechanisms by which ACSM3 gene variants affect blood pressure remain to be elucidated.<br><br>Mitochondrial acyl-coenzyme A synthetase ACSM6 is proposed to be located in the mitochondrial matrix and possess the same medium-chain fatty acid:CoA ligase activity as ACSM3. \"}]}" ;
