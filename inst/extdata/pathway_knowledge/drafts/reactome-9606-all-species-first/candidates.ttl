": [195690], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Zymosterone (cholesta-8(9),24-dien-3-one) is reduced to zymosterol (cholesta-8(9),24-dien-3beta-ol)\", \"zymosterone + NADPH + H(+) => zymosterol + NADP(+)\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194632\", \"stIdVersion\": \"R-HSA-194632.3\"}], \"releaseDate\": \"2007-02-20\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-195690\", \"stIdVersion\": \"R-HSA-195690.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 195656, \"displayName\": \"Isomerization of zymosterol to cholesta-7,24-dien-3beta-ol i...\", \"schemaClass\": \"Summation\", \"text\": \"Isomerization of zymosterol to cholesta-7,24-dien-3beta-ol is catalyzed by EBP in the endoplasmic reticulum. The biochemical details of the reaction have been established through studies of purified rat EBP; the role of the human enzyme has been established through studies of patients deficient in it (Derry et al. 1999; Braverman et al. 1999).\"}]}" ;
