gory\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10387322, \"displayName\": \"PI(3,4,5)P3 is dephosphorylated to PI(3,4)P2 by INPP5[2] at the plasma membrane\", \"inferredFrom\": [1675949], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,4,5)P3 is dephosphorylated to PI(3,4)P2 by INPP5[2] at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1675949\", \"stIdVersion\": \"R-BTA-1675949.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 202247, \"displayName\": \"PI(3,4)P2 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2\", \"1-phosphatidyl-1D-myo-inositol 3,4-bisphosphate\", \"1-phosphatidyl-1D-myo-inositol 3,4-bisphosphates\"], \"producedByEvent\": [1675949], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-202247\", \"stIdVersion\": \"R-ALL-202247.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [1675949], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676048, \"displayName\": \"PI(4,5)P2 is phosphorylated to PI(3,4,5)P3 by PIK3C[1] at the plasma membrane\", \"followingEvent\": [1675949], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2 is phosphorylated to PI(3,4,5)P3 by PIK3C[1] at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676048\", \"stIdVersion\": \"R-HSA-1676048.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1675773, \"displayName\": \"PI(3,4)P2 is phosphorylated to PI(3,4,5)P3 by PIP5K1A-C at the plasma membrane\", \"followingEvent\": [1675949], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2 is phosphorylated to PI(3,4,5)P3 by PIP5K1A-C at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675773\", \"stIdVersion\": \"R-HSA-1675773.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675949\", \"stIdVersion\": \"R-HSA-1675949.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1675912, \"displayName\": \"At the plasma membrane, phosphatidylinositol 5-phosphatases ...\", \"schemaClass\": \"Summation\", \"text\": \"At the plasma membrane, phosphatidylinositol 5-phosphatases dephosphorylate phosphatidylinositol 3,4,5-trisphosphate (PI(3,4,5)P3) to phosphatidylinositol 3,4-bisphosphate (PI(3,4)P2).  The phosphatidylinositol 5-phosphatases involved are:  inositol polyphosphate 5-phosphatase K (INPP5K) aka SKIP (Ijuin et al. 2000, Gurung et al. 2003), phosphatidylinositol 4,5-bisphosphate 5-phosphatase A (INPP5J) aka PIPP (Gurung et al. 2003, Mochizuki & Takenawa 1999), phosphatidylinositol-3,4,5-trisphosphate 5-phosphatase 1 (INPP5D) aka SHIP1 (Drayer et al. 1995, Kavanaugh et al. 1996, Dunant et al. 2000), and phosphatidylinositol-3,4,5-trisphosphate 5-phosphatase 2 (INPPL1) aka SHIP2 (Habib et al. 1998, Wisniewski et al. 1999, Pesesse et al. 2001).\"}]}" ;
