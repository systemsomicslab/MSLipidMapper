    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 9024785, \"displayName\": \"RvD1-6 translocate from cytosol to extracellular region\", \"goBiologicalProcess\": {\"accession\": \"0032309\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 262593, \"definition\": \"The controlled release of icosanoids, any of a group of C20 polyunsaturated fatty acids from a cell or a tissue.\", \"displayName\": \"icosanoid secretion\", \"name\": \"icosanoid secretion\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0032309\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [9024785], \"dbId\": 9024814, \"displayName\": \"RvD1-6 [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"RvD1-6\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9024814\", \"stIdVersion\": \"R-ALL-9024814.1\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReferenc