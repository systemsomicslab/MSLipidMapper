    mslm:equation "24OH-CHOL [endoplasmic reticulum membrane] => 24OH-CHOL [extracellular region]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 193776, \"displayName\": \"Efflux of 24-hydroxycholesterol\", \"followingEvent\": [193767], \"goBiologicalProcess\": {\"accession\": \"0015918\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 22603, \"definition\": \"The directed movement of sterols into, out of or within a cell, or between cells, by means of some agent such as a transporter or pore. Sterols are steroids with one or more hydroxyl groups and a hydrocarbon side-chain in the molecule.\", \"displayName\": \"sterol transport\", \"name\": \"sterol transport\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0015918\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193776], \"dbId\": 192060, \"displayName\": \"24OH-CHOL [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"24OH-CHOL\", \"(24S)-24-hydroxycholesterol\", \"24-hydroxycholesterol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192060\", \"stIdVersion\": \"R-ALL-192060.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 193748, \"displayName\": \"Cholesterol homeostasis in human brain: evidence for an age-dependent flux of 24S-hydroxycholesterol from the brain into the circulation\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"9799-804\", \"pubMedIdentifier\": 8790411, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cholesterol homeostasis in human brain: evidence for an age-dependent flux of 24S-hydroxycholesterol from the brain into the circulation\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8790411\", \"volume\": 93, \"year\": 1996}, {\"className\": \"LiteratureReference\", \"dbId\": 193791, \"displayName\": \"Cholesterol homeostasis in human brain: turnover of 24S-hydroxycholesterol and evidence for a cerebral origin of most of this oxysterol in the circulation\", \"journal\": \"J Lipid Res\", \"pages\": \"1594-600\", \"pubMedIdentifier\": 9717719, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cholesterol homeostasis in human brain: turnover of 24S-hydroxycholesterol and evidence for a cerebral origin of most of this oxysterol in the circulation\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9717719\", \"volume\": 39, \"year\": 1998}], \"maxDepth\": 1, \"name\": [\"Efflux of 24-hydroxycholesterol\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193717, \"displayName\": \"24OH-CHOL [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"24OH-CHOL\", \"(24S)-24-hydroxycholesterol\", \"24-hydroxycholesterol\"], \"producedByEvent\": [193776], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193717\", \"stIdVersion\": \"R-ALL-193717.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 192061, \"displayName\": \"CYP46A1 24-hydroxylates CHOL\", \"followingEvent\": [193776], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYP46A1 24-hydroxylates CHOL\", \"cholesterol + O2 + reduced (NADPH--hemoprotein reductase) => (24S)-hydroxycholesterol + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\", \"cholesterol + NADPH + H+ + O2 => 24-hydroxycholesterol + NADP+ + H2O\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192061\", \"stIdVersion\": \"R-HSA-192061.4\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193776\", \"stIdVersion\": \"R-HSA-193776.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193731, \"displayName\": \"24-hydroxycholesterol is transported from the endoplasmic re...\", \"schemaClass\": \"Summation\", \"text\": \"24-hydroxycholesterol is transported from the endoplasmic reticulum to the extracellular space. In humans, this event is the major source of 24-hydroxycholesterol in the blood and is the means by which the molecule, generated from cholesterol in the brain, is transported to the liver for conversion to bile acids and bile salts. While transport proteins are likely to play a role in this process, and the 24-hydroxycholesterol is likely to occur as part of a lipoprotein complex in the blood, the relevant proteins have not been identified (Lutjohann et al. 1996; Bjorkhem et al. 1998).\"}]}" ;
