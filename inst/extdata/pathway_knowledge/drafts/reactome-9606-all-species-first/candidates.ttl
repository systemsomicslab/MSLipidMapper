stIdVersion\": \"R-CFA-8848246.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10203462, \"displayName\": \"DBI, ACBD7 bind MCFA-CoA and LCFA-CoA\", \"inferredFrom\": [8848246], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DBI, ACBD7 bind MCFA-CoA and LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8848246\", \"stIdVersion\": \"R-RNO-8848246.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10080689, \"displayName\": \"DBI, ACBD7 bind MCFA-CoA and LCFA-CoA\", \"inferredFrom\": [8848246], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DBI, ACBD7 bind MCFA-CoA and LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8848246\", \"stIdVersion\": \"R-MMU-8848246.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 8848291, \"displayName\": \"DBI,ACBD7:MCFA-CoA,LCFA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"DBI,ACBD7:MCFA-CoA,LCFA-CoA\"], \"producedByEvent\": [8848246], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8848291\", \"stIdVersion\": \"R-HSA-8848291.2\"}], \"releaseDate\": \"2016-06-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8848246\", \"stIdVersion\": \"R-HSA-8848246.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8848280, \"displayName\": \"Acyl-CoA-binding protein (DBI, aka ACBP) can bind medium- an...\", \"schemaClass\": \"Summation\", \"text\": \"Acyl-CoA-binding protein (DBI, aka ACBP) can bind medium- and long-chain acyl-CoA esters (MCFA-CoA, LCFA-CoA) with very high affinity. It is localised to the ER (and Golgi) and may function as an intracellular carrier of acyl-CoA esters (Hansen et al. 2008, Bloksgaard et al. 2014). Acyl-CoA-binding domain-containing protein 7 (ACBD7) shares around 60% sequence homology with DBI and is proposed to also bind fatty acyl-CoAs but its function is yet to be determined.\"}]}" ;
