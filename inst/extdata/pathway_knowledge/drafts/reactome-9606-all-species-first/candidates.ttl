hemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9020251\", \"stIdVersion\": \"R-HSA-9020251.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9024480, \"displayName\": \"Lipoxygenase 5 (ALOX5) can oxidise 17(R)-hydroxydocosahexaen...\", \"schemaClass\": \"Summation\", \"text\": \"Lipoxygenase 5 (ALOX5) can oxidise 17(R)-hydroxydocosahexaenoic acid (17(R)-HDHA) into two hydroperoxy intermediates in human polymorphonuclear leukocytes (PMNs) (Serhan et al. 2002). The formation of 7(S)-hydroperoxy-17(R)-hydroxydocosahexaenoic acid (7(S)-Hp-17(R)-HDHA) is decribed here.\"}]}" ;
