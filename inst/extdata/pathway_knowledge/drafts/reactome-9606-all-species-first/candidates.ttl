\": [75848], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer transforms CIT to Ac-CoA\", \"ATP + citrate + CoA => acetyl-CoA + ADP + oxaloacetate + phosphate\", \"Generation of Cytoplasmic Acetyl CoA from Citrate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-75848\", \"stIdVersion\": \"R-RNO-75848.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9995902, \"displayName\": \"ACLY tetramer transforms CIT to Ac-CoA\", \"inferredFrom\": [75848], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer transforms CIT to Ac-CoA\", \"ATP + citrate + CoA => acetyl-CoA + ADP + oxaloacetate + phosphate\", \"Generation of Cytoplasmic Acetyl CoA from Citrate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-75848\", \"stIdVersion\": \"R-MMU-75848.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 76183, \"displayName\": \"Ac-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ac-CoA\", \"acetyl-CoA(4-)\", \"Acetyl coenzyme A\", \"acetyl-CoA\"], \"producedByEvent\": [75848], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76183\", \"stIdVersion\": \"R-ALL-76183.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [75848], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76213, \"displayName\": \"OA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"OA\", \"oxaloacetate(2-)\", \"Oxaloacetate\", \"oxaloacetic acid\", \"Oxalacetic acid\", \"2-oxobutanedioic acid\", \"Oxosuccinic acid\"], \"producedByEvent\": [75848], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76213\", \"stIdVersion\": \"R-ALL-76213.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [75848], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 75849, \"displayName\": \"SLC25A1 exchanges CIT and MAL\", \"followingEvent\": [75848], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SLC25A1 exchanges CIT and MAL\", \"SLC25A1 exports citrate from mitochondrion in exchange for malate\", \"Transport of Citrate from Mitochondrial Matrix to cytosol\"], \"releaseDate\": \"2004-07-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-75849\", \"stIdVersion\": \"R-HSA-75849.6\"}, {\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 163770, \"displayName\": \"Transcriptional activation of Citrate lyase monomer gene by ChREBP:MLX\", \"followingEvent\": [75848], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Transcriptional activation of Citrate lyase monomer gene by ChREBP:MLX\"], \"releaseDate\": \"2005-04-11\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163770\", \"stIdVersion\": \"R-HSA-163770.9\"}], \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 8954446, \"displayName\": \"Positive regulation by 'MORC2 [cytosol]'\", \"regulatedEntity\": [75848], \"schemaClass\": \"PositiveRegulation\", \"stId\": \"R-HSA-8954446\", \"stIdVersion\": \"R-HSA-8954446.1\"}], \"releaseDate\": \"2004-07-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-75848\", \"stIdVersion\": \"R-HSA-75848.7\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 76210, \"displayName\": \"While fatty acid synthesis from acetyl CoA (Ac-CoA) proceeds...\", \"schemaClass\": \"Summation\", \"text\": \"While fatty acid synthesis from acetyl CoA (Ac-CoA) proceeds in the cytosol, most Ac-CoA in the cell is generated within the mitochondria by oxidative decarboxylation of the pyruvate derived from glycolysis, as well as from several reactions of amino acid catabolism. Mitochondrial Ac-CoA is transported to the cytosol as citrate (CIT) to participate in fatty acid biosynthesis (for a review, see, e.g., Arnold & Finley, 2023). Cytosolic ATP-citrate synthase (ACLY), in tetrameric form, catalyzes the transformation of CIT to Ac-CoA and plays an essential role in lipogenesis, adipogenesis, and differentiation of 3T3-L1 preadipocyte cells (Elshourbagy et al. 1992, Sun et al., 2011; Lin et al. 2013). Cytosolic MORC family CW-type zinc finger protein 2 (MORC2) positively regulates the activity of ACLY. Thus, it could mediate lipogenesis, adipogenic differentiation, and lipid homeostasis (Sanchez-Solana et al. 2014). High glucose leads to overexpression and nuclear localization of ACLY, subsequently increasing histone acetylation (reviewed by Bradshaw, 2021). SLC25A1 citrate export and acetyl-CoA production by ACLY are sometimes called the citrate-malate shuttle (for a review, see Guo et al., 2023).\"}]}" ;
