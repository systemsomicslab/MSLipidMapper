    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [1606564], \"className\": \"CatalystActivity\", \"dbId\": 1606568, \"displayName\": \"galactosylceramidase activity of GALC [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 1606564, \"displayName\": \"GALC hydrolyzes GalCer\", \"followingEvent\": [1606602], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1606564], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [1606564], \"dbId\": 1606573, \"displayName\": \"GalCer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GalCer\", \"galactosylceramide\", \"D-galactosyl-N-acylsphingosine\", \"N-acyl-beta-D-galactosylsphingosine\", \"Galactocerebroside\", \"Galactosylceramide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1606573\", \"stIdVersion\": \"R-ALL-1606573.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1606576, \"displayName\": \"Purification and characterization of galactocerebrosidase from human lymphocytes\", \"journal\": \"J Biochem\", \"pages\": \"615-20\", \"pubMedIdentifier\": 7852280, \"schemaClass\": \"LiteratureRefer