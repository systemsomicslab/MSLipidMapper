ol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [192051], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [192051], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 192107, \"displayName\": \"Molecular cloning and sequence analysis of cDNA encoding human cholesterol 7 alpha-hydroxylase\", \"journal\": \"FEBS Lett\", \"pages\": \"137-40\", \"pubMedIdentifier\": 2384150, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular cloning and sequence analysis of cDNA encoding human cholesterol 7 alpha-hydroxylase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/2384150\", \"volume\": 268, \"year\": 1990}], \"maxDepth\": 1, \"name\": [\"CYP7A1 7-hydroxylates CHOL\", \"cholesterol + reduced (NADPH--hemoprotein reductase) + O2 => 7alpha-hydroxycholesterol + oxidized (NADPH--hemoprotein reductase) + H2O + H(+)\", \"Cholesterol is hydroxylated to 7alpha-hydroxycholesterol by CYP7A1\", \"Cholesterol + NADPH + H+ + O2 => 7-alpha-hydroxycholesterol + NADP+ + H2O\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10753305, \"displayName\": \"CYP7A1 7-hydr