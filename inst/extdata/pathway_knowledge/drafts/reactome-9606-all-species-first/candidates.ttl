 [1675994], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI3P is dephosphorylated to PI by SYNJ/MTMs at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1675994\", \"stIdVersion\": \"R-SSC-1675994.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10387350, \"displayName\": \"PI3P is dephosphorylated to PI by SYNJ/MTMs at the plasma membrane\", \"inferredFrom\": [1675994], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI3P is dephosphorylated to PI by SYNJ/MTMs at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1675994\", \"stIdVersion\": \"R-BTA-1675994.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10163934, \"displayName\": \"PI3P is dephosphorylated to PI by SYNJ/MTMs at the plasma membrane\", \"inferredFrom\": [1675994], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI3P is dephosphorylated to PI by SYNJ/MTMs at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1675994\", \"stIdVersion\": \"R-RNO-1675994.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 426658, \"displayName\": \"PI [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI\", \"1-phosphatidyl-1D-myo-inositol(1-)\", \"Phosphatidyl 1D-myo-inositol\", \"1-phosphatidyl-1D-myo-inositol\"], \"producedByEvent\": [1675994], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426658\", \"stIdVersion\": \"R-ALL-426658.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [1675994], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676164, \"displayName\": \"PI(3,4)P2 is dephosphorylated to PI3P by INPP4A/B at the plasma membrane\", \"followingEvent\": [1675994], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2 is dephosphorylated to PI3P by INPP4A/B at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676164\", \"stIdVersion\": \"R-HSA-1676164.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1675836, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI3P by SYNJ at the plasma membrane\", \"followingEvent\": [1675994], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI3P by SYNJ at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675836\", \"stIdVersion\": \"R-HSA-1675836.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675994\", \"stIdVersion\": \"R-HSA-1675994.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1676016, \"displayName\": \"At the plasma membrane, synaptojanin-1 aka Synaptic inositol...\", \"schemaClass\": \"Summation\", \"text\": \"At the plasma membrane, synaptojanin-1 aka Synaptic inositol-1,4,5-trisphosphate 5-phosphatase 1 (SYNJ1) (Guo et al. 1999), -2 (SYNJ2) and some myotubularins (MTMs) dephosphorylate phosphatidylinositol 3-phosphate (PI3P) to phosphatidylinositol (PI).  The MTMs involved are: myotubularin (MTM1) (Cao et al. 2007, Tronchere et al. 2004, Schaletzky et al. 2003, Laporte et al. 2002, Kim et al. 2002) and myotubularin-related proteins 1 (MTMR1) (Kim et al. 2002, Tronchere et al. 2004), 3 (MTMR3) (Kim et al. 2002, Zhao et al. 2001, Walker et al. 2001, Lorenzo et al. 2005), 6 (MTMR6) (Schaletzky et al. 2003, Kim et al. 2002, Choudhury et al. 2006), and 14 (MTMR14) (Tosch et al. 2006).\"}]}" ;
