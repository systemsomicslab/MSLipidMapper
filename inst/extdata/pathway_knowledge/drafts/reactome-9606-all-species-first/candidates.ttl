    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9027042], \"className\": \"CatalystActivity\", \"dbId\": 9020576, \"displayName\": \"monooxygenase activity of CYP4 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 9027042, \"displayName\": \"CPY4 ω-oxidises 14(S)-HDHA to MaR-L1\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027042], \"dbId\": 9027029, \"displayName\": \"14(S)-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"14(S)-HDHA\", \"(14S)-HDoHE(1-)\", \"(14S)-HDHA(1-)\", \"14(S)-hydroxy-docosahexaenoic acid\", \"(14S)-HDoHE\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9027029\", \"stIdVersion\": \"R-ALL-9027029.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027042], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027042], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027042], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9027018, \"displayName\": \"Maresin-like lipid mediators are produced by leukocytes and platelets and rescue reparative function of diabetes-impaired macrophages\", \"journal\": \"Chem. Biol.\", \"pages\": \"1318-1329\", \"pubMedIdentifier\": 25200603, \"schemaClass\": \"LiteratureReference\", \"title\": \"Maresin-like lipid mediators are produced by leukocytes and platelets and rescue reparative function of diabetes-impaired macrophages\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25200603\", \"volume\": 21, \"year\": 2014}], \"maxDepth\": 1, \"name\": [\"CPY4 ω-oxidises 14(S)-HDHA to MaR-L1\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9027040, \"displayName\": \"MaR-L1 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MaR-L1\", \"(4Z,7Z,10Z,12E,14S,16Z,19Z)-14,22-dihydroxydocosahexaenoate\", \"maresin-L1(1-)\", \"maresin-like mediator 1\", \"(4Z,7Z,10Z,12E,14S,16Z,19Z)-14,22-dihydroxydocosahexaenoic acid\", \"14(S),22-dihydroxy-docosahexaenoic acid\", \"14(S),22-diHDHA\"], \"producedByEvent\": [9027042], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9027040\", \"stIdVersion\": \"R-ALL-9027040.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [9027042], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [9027042], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9027033, \"displayName\": \"Hydroperoxy reducatase reduces 14(S)-Hp-DHA to 14(S)-HDHA\", \"followingEvent\": [9027042], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Hydroperoxy reducatase reduces 14(S)-Hp-DHA to 14(S)-HDHA\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027033\", \"stIdVersion\": \"R-HSA-9027033.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027042\", \"stIdVersion\": \"R-HSA-9027042.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9027312, \"displayName\": \"Cytochrome P450 (CYP) enzymes are thought to ω-hydroxylate (...\", \"schemaClass\": \"Summation\", \"text\": \"Cytochrome P450 (CYP) enzymes are thought to ω-hydroxylate (position 22) 14(S)-hydroxy-docosahexaenoic acid (14(S)-HDHA) to 14(S),22-dihydroxy-docosahexaenoic acid, namely maresin-like mediator 1 (MaR-L1) (Hong et al. 2014). CYP inhibition was found to decrease the amount of MaR-L1 formed (Hong et al. 2014). The exact CYP responsible for MaR-L1 formation is unknown but is likely to be a member of the CYP4 family as those enzymes mediate the ω-hydroxylation of fatty acids and eicosanoids (Kikuta et al. 2002). Diabetes results in delayed- or non-healing of wounds and is associated with impaired macrophage function (Brem & Tomic-Canic 2007). Leukocytes and platelets play critical roles in wound healing by mechanisms as yet unknown. Maresin-like mediators MaR-L1 and Mar-L2 are produced by leukocytes and platelets and have been shown (in vitro) to restore reparative functions of diabetic macrophages in wounds (Hong et al. 2014).\"}]}" ;
