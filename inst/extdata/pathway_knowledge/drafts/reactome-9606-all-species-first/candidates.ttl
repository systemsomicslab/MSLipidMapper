"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4H:Zn2+ hydrolyses 17R(16)-epoxy-DHA to AT-(N)PD1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9020257\", \"stIdVersion\": \"R-DRE-9020257.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10550904, \"displayName\": \"LTA4H:Zn2+ hydrolyses 17R(16)-epoxy-DHA to AT-(N)PD1\", \"inferredFrom\": [9020257], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4H:Zn2+ hydrolyses 17R(16)-epoxy-DHA to AT-(N)PD1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9020257\", \"stIdVersion\": \"R-SSC-9020257.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10437481, \"displayName\": \"LTA4H:Zn2+ hydrolyses 17R(16)-epoxy-DHA to AT-(N)PD1\", \"inferredFrom\": [9020257], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4H:Zn2+ hydrolyses 17R(16)-epoxy-DHA to AT-(N)PD1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9020257\", \"stIdVersion\": \"R-BTA-9020257.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10323593, \"displayName\": \"LTA4H:Zn2+ hydrolyses 17R(16)-epoxy-DHA to AT-(N)PD1\", \"inferredFrom\": [9020257], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4H:Zn2+ hydrolyses 17R(16)-epoxy-DHA to AT-(N)PD1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9020257\", \"stIdVersion\": \"R-CFA-9020257.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10215709, \"displayName\": \"LTA4H:Zn2+ hydrolyses 17R(16)-epoxy-DHA to AT-(N)PD1\", \"inferredFrom\": [9020257], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4H:Zn2+ hydrolyses 17R(16)-epoxy-DHA to AT-(N)PD1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9020257\", \"stIdVersion\": \"R-RNO-9020257.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092484, \"displayName\": \"LTA4H:Zn2+ hydrolyses 17R(16)-epoxy-DHA to AT-(N)PD1\", \"inferredFrom\": [9020257], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4H:Zn2+ hydrolyses 17R(16)-epoxy-DHA to AT-(N)PD1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9020257\", \"stIdVersion\": \"R-MMU-9020257.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9024879, \"displayName\": \"AT-(N)PD1 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AT-(N)PD1\", \"aspirin-triggered protectin D1(1-)\", \"AT-NPD1(1-)\", \"aspirin-triggered (neuro)protectin D1\", \"aspirin-triggered protectin D1\"], \"producedByEvent\": [9020257], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024879\", \"stIdVersion\": \"R-ALL-9024879.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9020262, \"displayName\": \"ALOX15 dehydrogenates 17(R)-Hp-DHA to 17R(16)-epoxy-DHA\", \"followingEvent\": [9020257], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX15 dehydrogenates 17(R)-Hp-DHA to 17R(16)-epoxy-DHA\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9020262\", \"stIdVersion\": \"R-HSA-9020262.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9020257\", \"stIdVersion\": \"R-HSA-9020257.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9020254, \"displayName\": \"Leukotriene A4 hydrolase (LTA4H) is a monomeric, soluble enz...\", \"schemaClass\": \"Summation\", \"text\": \"Leukotriene A4 hydrolase (LTA4H) is a monomeric, soluble enzyme that uses a Zn2+ cofactor to catalyse the hydrolysis of the allylic epoxide leukotriene A4 (LTA4) (McGee & Fitzpatrick 1985). LTA4H may also be able to catalyse the hydrolysis of 17R(6)-epoxy-docosahexaenoic acid (17R(16)-epoxy-DHA) to 10(R),17(R)-dihydroxydocosa-4Z,7Z,11E,13E,15Z,19Z-hexaenoic acid (aspirin-triggered (neuro)protectin D1, AT-(N)PD1) (Serhan et al. 2011). In human cells, AT-(N)PD1 decreased PMN migration as well as enhancing efferocytosis of apoptotic human PMN by macrophages, indicating AT-(N)PD1 as a potent anti-inflammatory proresolving molecule (Serhan et al. 2011).\"}]}" ;
