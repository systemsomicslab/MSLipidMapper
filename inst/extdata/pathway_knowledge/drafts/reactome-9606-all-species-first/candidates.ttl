3800\", \"stIdVersion\": \"R-BTA-193800.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10248890, \"displayName\": \"5Beta-cholestan-7alpha,12alpha,27-triol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\", \"inferredFrom\": [193800], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"5Beta-cholestan-7alpha,12alpha,27-triol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\", \"5Beta-cholestan-7alpha,12alpha,27-triol-3-one + NADPH + H+ => 5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol + NAPDP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-193800\", \"stIdVersion\": \"R-CFA-193800.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10128648, \"displayName\": \"5Beta-cholestan-7alpha,12alpha,27-triol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\", \"inferredFrom\": [193800], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"5Beta-cholestan-7alpha,12alpha,27-triol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\", \"5Beta-cholestan-7alpha,12alpha,27-triol-3-one + NADPH + H+ => 5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol + NAPDP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-193800\", \"stIdVersion\": \"R-RNO-193800.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007647, \"displayName\": \"5Beta-cholestan-7alpha,12alpha,27-triol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\", \"inferredFrom\": [193800], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"5Beta-cholestan-7alpha,12alpha,27-triol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\", \"5Beta-cholestan-7alpha,12alpha,27-triol-3-one + NADPH + H+ => 5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol + NAPDP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193800\", \"stIdVersion\": \"R-MMU-193800.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193843, \"displayName\": \"5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\", \"5beta-cholestane-3alpha,7alpha,12alpha,26-tetrol\"], \"producedByEvent\": [193800], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193843\", \"stIdVersion\": \"R-ALL-193843.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [193800], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193821, \"displayName\": \"4-cholesten-7alpha,12alpha,27-triol-3-one is reduced to 5beta-cholestan-7alpha,12alpha,27-triol-3-one\", \"followingEvent\": [193800], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"4-cholesten-7alpha,12alpha,27-triol-3-one is reduced to 5beta-cholestan-7alpha,12alpha,27-triol-3-one\", \"4-cholesten-7alpha,12alpha,27-triol-3-one + NADPH + H+ => 5beta-cholestan-7alpha,12alpha,27-triol-3-one + NADP+\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193821\", \"stIdVersion\": \"R-HSA-193821.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193800\", \"stIdVersion\": \"R-HSA-193800.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193825, \"displayName\": \"5Beta-cholesten-7alpha,12a,27-triol-3-one and NADPH + H+ for...\", \"schemaClass\": \"Summation\", \"text\": \"5Beta-cholesten-7alpha,12a,27-triol-3-one and NADPH + H+ form 5beta-cholestan-3alpha,7alpha,12a,27-tetrol and NAPDP+. The reaction is catalyzed by 3alpha-hydroxysteroid dehydrogenase (AKR1C4), a cytosolic enzyme belonging to the aldo-keto reductase family (Dufort et al. 2001). Biochemical studies with rat proteins raise the possibility that other related enzymes may also carry out this reaction in vivo (Russell 2003).\"}]}" ;
