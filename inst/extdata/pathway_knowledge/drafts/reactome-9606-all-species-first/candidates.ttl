speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161733\", \"stIdVersion\": \"R-HSA-2161733.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2161606, \"displayName\": \"Analogous to prostaglandin E2 (PGE2), dehydration of the pro...\", \"schemaClass\": \"Summation\", \"text\": \"Analogous to prostaglandin E2 (PGE2), dehydration of the prostaglandin D2 (PGD2) prostane ring forms prostaglandin J2 (PGJ2) (Monneret et al. 2002).\"}]}" ;
