<https://reactome.org/content/detail/R-HSA-9027631> a mslm:LipidReaction ;
    rdfs:label "5-HEDH dehydrogenates 7-HDHA to 7-oxo-DHA" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "NADP+ [cytosol] + 7-HDHA [cytosol] => H+ [cytosol] + 7-oxo-DHA [cytosol] + NADPH [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9027631], \"className\": \"CatalystActivity\", \"dbId\": 9028228, \"displayName\": \"oxidoreductase activity, acting on the CH-OH group of donors, NAD or NADP as acceptor of 5-HEDH [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 9027631, \"displayName\": \"5-HEDH dehydrogenates 7-HDHA to 7-oxo-DHA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027631], \"dbId\": 9028274, \"displayName\": \"7-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7-HDHA\", \"(4Z,8E,10Z,13Z,16Z,19Z)-7-hydroxydocosahexaenoate\", \"(4Z,8E,10Z,13Z,16Z,19Z)-7-hydroxydocosahexaenoic acid\", \"7-HDoHE\", \"7-hydroxy-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9028274\", \"stIdVersion\": \"R-ALL-9028274.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027631], \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9028212, \"displayName\": \"Generation and dietary modulation of anti-inflammatory electrophilic omega-3 fatty acid derivatives\", \"journal\": \"PLoS ONE\", \"pages\": \"e94836\", \"pubMedIdentifier\": 24736647, \"schemaClass\": \"LiteratureReference\", \"title\": \"Generation and dietary modulation of anti-inflammatory electrophilic omega-3 fatty acid derivatives\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/24736647\", \"volume\": 9, \"year\": 2014}, {\"className\": \"LiteratureReference\", \"dbId\": 9023711, \"displayName\": \"Substrate selectivity of 5-hydroxyeicosanoid dehydrogenase and its inhibition by 5-hydroxy-Delta6-long-chain fatty acids\", \"journal\": \"J. Pharmacol. Exp. Ther.\", \"pages\": \"335-41\", \"pubMedIdentifier\": 19164464, \"schemaClass\": \"LiteratureReference\", \"title\": \"Substrate selectivity of 5-hydroxyeicosanoid dehydrogenase and its inhibition by 5-hydroxy-Delta6-long-chain fatty acids\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/19164464\", \"volume\": 329, \"year\": 2009}], \"maxDepth\": 1, \"name\": [\"5-HEDH dehydrogenates 7-HDHA to 7-oxo-DHA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9028265, \"displayName\": \"7-oxo-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7-oxo-DHA\", \"(4Z,8E,10Z,13Z,16Z,19Z)-7-oxodocosahexaenoate\", \"(4Z,8E,10Z,13Z,16Z,19Z)-7-oxodocosahexaenoic acid\", \"7-oxo-docosahexaenoic acid\"], \"producedByEvent\": [9027631], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9028265\", \"stIdVersion\": \"R-ALL-9028265.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"producedByEvent\": [9027631], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [9027631], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9027624, \"displayName\": \"ALOX5 oxidises DHA to 7-HDHA\", \"followingEvent\": [9027631], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises DHA to 7-HDHA\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027624\", \"stIdVersion\": \"R-HSA-9027624.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027631\", \"stIdVersion\": \"R-HSA-9027631.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9028268, \"displayName\": \"In neutrophils, 5 hydroxyeicosanoid dehydrogenase (5-HEDH) a...\", \"schemaClass\": \"Summation\", \"text\": \"In neutrophils, 5 hydroxyeicosanoid dehydrogenase (5-HEDH) activity is localised in the microsomal fraction and requires NADP+ as a cofactor to oxidise 7-hydroxy docosahexaenoic acid (7-HDHA) to 7-oxo-docosahexaenoic acid (7-oxo-DHA) (Patel et al. 2009, Cipollina et al. 2014). Although 5-HEDH activity has been evaluated in a wide range of intact cells and in crude microsome preparations, it has not yet been purified and its structure and gene remain unknown. Dietary EPA supplementation significantly increases the formation of 7-oxo-DHA that transduces anti inflammatory actions rather than suppressing production of pro inflammatory AA metabolites (Cipollina et al. 2014).\"}]}" ;
