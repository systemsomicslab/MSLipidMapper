ion\": \"R-MMU-9024993.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9025011, \"displayName\": \"MaR2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MaR2\", \"(13R,14S)-dihydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate\", \"MaR2(1-)\", \"maresin 2\", \"(13R,14S)-dihydroxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoic acid\", \"13(R),14(S)-dihydroxy-docosahexaenoic acid\"], \"producedByEvent\": [9024993], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9025011\", \"stIdVersion\": \"R-ALL-9025011.5\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9024993\", \"stIdVersion\": \"R-HSA-9024993.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9024976, \"displayName\": \"Dimeric bifunctional epoxide hydrolase 2 (EPHX2 dimer, solub...\", \"schemaClass\": \"Summation\", \"text\": \"Dimeric bifunctional epoxide hydrolase 2 (EPHX2 dimer, soluble epoxide hydrolase, sEH) hydrolyses 13(S),14(S)-epoxy-docosahexaenoic acid (13(S),14(S)-epoxy-DHA) to form  13(R),14(S)-dihydroxy-docosahexaenoic acid, aka maresin 2 (MaR2) (Deng et al. 2014). Like MaR1, MaR2 possesses anti-inflammatory and pro-resolving activities although it is not as potent as MaR1 (Deng et al. 2014).\"}]}" ;
