    mslm:equation "bHMG-CoA [cytosol] => ACA [cytosol] + Ac-CoA [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [6788597], \"className\": \"CatalystActivity\", \"dbId\": 6788588, \"displayName\": \"hydroxymethylglutaryl-CoA lyase activity of HMGCLL1:Mg2+ [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690699, \"displayName\": \"RHEA:24405\", \"identifier\": \"24405\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/24405\"}], \"dbId\": 6788597, \"displayName\": \"HMGCLL1:Mg2+ cleaves bHMG-CoA to Ac-CoA and ACA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [6788597], \"dbId\": 191374, \"displayName\": \"bHMG-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"bHMG-CoA\", \"(3S)-3-hydroxy-3-methylglutaryl-CoA(5-)\", \"beta-hydroxy-beta-methylglutaryl-CoA\", \"(3S)-3-hydroxy-3-methylglutaryl-CoA\", \"3-hydroxy-3-methylglutaryl-CoA\", \"HMG-CoA\", \"HMG-C0A(5-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191374\", \"stIdVersion\": \"R-ALL-191374.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 6788593, \"displayName\": \"Identification and characterization of an extramitochondrial human 3-hydroxy-3-methylglutaryl-CoA lyase\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"33227-36\", \"pubMedIdenti