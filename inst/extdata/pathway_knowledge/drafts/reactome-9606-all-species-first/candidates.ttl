    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [109343], \"className\": \"CatalystActivity\", \"dbId\": 109993, \"displayName\": \"oxidoreductase activity, acting on NAD(P)H of DECR1 tetramer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 109343, \"displayName\": \"Reduction of 2-trans-4-cis-decadienoyl-CoA to form 3-trans-decenoyl-CoA\", \"figure\": [{\"className\": \"Figure\", \"dbId\": 109995, \"displayName\": \"/figures/unsatfattyacidbetao_5.jpg\", \"schemaClass\": \"Figure\", \"url\": \"/figures/unsatfattyacidbetao_5.jpg\"}], \"followingEvent\": [109998], \"goBiologicalProcess\": {\"accession\": \"0006635\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 20426, \"definition\": \"A fatty acid oxidation process that results in the complete oxidation of a long-chain fatty acid. Fatty acid beta-oxidation begins with the addition of coenzyme A to a fatty acid, and occurs by successive cycles of reactions during each of which the fatty acid is shortened by a two-carbon fragment removed as acetyl coenzyme A; the cycle continues until only two or three carbons remain (as acetyl-CoA or propionyl-CoA respectively).\", \"displayName\": \"fatty acid beta-oxidation\", \"name\": \"fatty acid beta-oxidation\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/