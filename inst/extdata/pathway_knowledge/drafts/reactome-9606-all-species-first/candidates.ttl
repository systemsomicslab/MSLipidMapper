\"transition\", \"className\": \"Reaction\", \"dbId\": 10648412, \"displayName\": \"PPARA binds fibrates\", \"inferredFrom\": [9734475], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA binds fibrates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9734475\", \"stIdVersion\": \"R-DRE-9734475.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10555672, \"displayName\": \"PPARA binds fibrates\", \"inferredFrom\": [9734475], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA binds fibrates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9734475\", \"stIdVersion\": \"R-SSC-9734475.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10442305, \"displayName\": \"PPARA binds fibrates\", \"inferredFrom\": [9734475], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA binds fibrates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9734475\", \"stIdVersion\": \"R-BTA-9734475.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10328227, \"displayName\": \"PPARA binds fibrates\", \"inferredFrom\": [9734475], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA binds fibrates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9734475\", \"stIdVersion\": \"R-CFA-9734475.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10220790, \"displayName\": \"PPARA binds fibrates\", \"inferredFrom\": [9734475], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA binds fibrates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9734475\", \"stIdVersion\": \"R-RNO-9734475.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10097558, \"displayName\": \"PPARA binds fibrates\", \"inferredFrom\": [9734475], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA binds fibrates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9734475\", \"stIdVersion\": \"R-MMU-9734475.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 9734456, \"displayName\": \"PPARA:RXRA:fibrates [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PPARA:RXRA:fibrates\", \"PPARA:PPARA agonists\"], \"producedByEvent\": [9734475], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9734456\", \"stIdVersion\": \"R-HSA-9734456.1\"}, {\"className\": \"Set\", \"dbId\": 400207, \"displayName\": \"Corepressors of PPARalpha [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Corepressors of PPARalpha\"], \"producedByEvent\": [9734475], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-400207\", \"stIdVersion\": \"R-HSA-400207.1\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 400183, \"displayName\": \"PPARA:RXRA binds Corepressors of PPARA\", \"followingEvent\": [9734475], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PPARA:RXRA binds Corepressors of PPARA\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-400183\", \"stIdVersion\": \"R-HSA-400183.4\"}], \"reactionType\": [{\"className\": \"DrugActionType\", \"dbId\": 9725061, \"displayName\": \"Agonist\", \"name\": [\"Agonist\"], \"schemaClass\": \"DrugActionType\"}], \"releaseDate\": \"2022-06-09\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9734475\", \"stIdVersion\": \"R-HSA-9734475.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9734517, \"displayName\": \"The peroxisome proliferator-activated receptor alpha (PPARA)...\", \"schemaClass\": \"Summation\", \"text\": \"The peroxisome proliferator-activated receptor alpha (PPARA) is a nuclear ligand-activated transcription factor that is a key regulator of fatty acid oxidation in the liver. Target genes of PPARA participate in fatty acid transport, fatty acid oxidation, triglyceride clearance, lipoprotein production, and cholesterol homeostasis. Its activation mediates lipid, glucose and amino acid homeostasis.<br><br>Fibrate drugs are derivatives of fibric acid which act as PPARA agonists and are widely used  to lower triglycerides, LDL-cholesterol, total-cholesterol and apolipoprotein C3 (Grundy & Vega 1987, Clavey et al. 1999) while increasing HDL-cholesterol concentrations in serum. They are used to treat hypercholesterolemia, dyslipidemia and hypertriglyceridemia (Katsiki et al. 2013, Laufs et al. 2020). Fibrate drugs include gemfibrozil (De Filippis et al. 2011), bezafibrate (Inoue et al. 2002), cipofibrate (Quang et al. 2012), clofibrate (Henke et al. 1998) and fenofibrate (Caldwell 1989).\\n\"}]}" ;
