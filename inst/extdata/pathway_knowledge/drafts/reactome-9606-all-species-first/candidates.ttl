755.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [75885], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 75886, \"displayName\": \"glycerol 3-phosphate + acyl-CoA => 1-acylglycerol 3-phosphate + CoASH [mitochondrial membrane-associated]\", \"followingEvent\": [75885], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"glycerol 3-phosphate + acyl-CoA => 1-acylglycerol 3-phosphate + CoASH [mitochondrial membrane-associated]\", \"Conversion of glycerol-3-phosphate to lysophosphatidic acid\"], \"releaseDate\": \"2004-07-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-75886\", \"stIdVersion\": \"R-HSA-75886.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 549112, \"displayName\": \"G3P is acylated to 1-acyl LPA by AGPAT6\", \"followingEvent\": [75885], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"G3P is acylated to 1-acyl LPA by AGPAT6\", \"glycerol 3-phosphate + acyl-CoA => 1-acylglycerol 3-phosphate + CoASH [ER membrane-associated]\", \"Conversion of glycerol-3-phosphate to lysophosphatidic acid\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-549112\", \"stIdVersion\": \"R-HSA-549112.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 75883, \"displayName\": \"DHRS7B reduces GO3P to HXDG3P\", \"followingEvent\": [75885], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"DHRS7B reduces GO3P to HXDG3P\", \"O-hexadecylglycerone phosphate + NADPH + H+ => 1-hexadecyl glycerol-3-phosphate + NADP+\", \"Conversion of acylated DHAP to lysophosphatidic acid\"], \"releaseDate\": \"2004-07-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-75883\", \"stIdVersion\": \"R-HSA-75883.4\"}, {\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 163748, \"displayName\": \"Transcriptional activation of AGPAT1 by ChREBP:MLX\", \"followingEvent\": [75885], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Transcriptional activation of AGPAT1 by ChREBP:MLX\"], \"releaseDate\": \"2005-09-26\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163748\", \"stIdVersion\": \"R-HSA-163748.7\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482656, \"displayName\": \"PA is hydrolysed to 1-acyl LPA by PLA2[1]\", \"followingEvent\": [75885], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PA is hydrolysed to 1-acyl LPA by PLA2[1]\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482656\", \"stIdVersion\": \"R-HSA-1482656.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482679, \"displayName\": \"PA is hydrolysed to 1-acyl LPA by PLA2G2A\", \"followingEvent\": [75885], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PA is hydrolysed to 1-acyl LPA by PLA2G2A\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482679\", \"stIdVersion\": \"R-HSA-1482679.2\"}], \"releaseDate\": \"2004-07-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-75885\", \"stIdVersion\": \"R-HSA-75885.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 178936, \"displayName\": \"At the endoplasmic reticulum (ER) membrane, 1-acyl-lysophosp...\", \"schemaClass\": \"Summation\", \"text\": \"At the endoplasmic reticulum (ER) membrane, 1-acyl-lysophosphatidic acid (LPA) is acylated to phosphatidic acid (PA) by the enzymes 1-acyl-sn-glycerol-3-phosphate acyltransferases (AGPAT1 through 11), and lysophosphatidylcholine acyltransferase (LPCAT1) (Aguado and Campbell 1998).<br><br>See recent review by Agarwal (2012, in press).<br><br>AGPAT1, 2, 3 and LPCAT1 have been characterized biochemically (AGPAT1, 2: Yamashita et al. 2007, West et al. 1997, Aguado and Campbell 1998, Gale et al. 2006; AGPAT3: Agarwal et al. 2006; LPCAT1: Nakanishi et al. 2006, Chen et al. 2006).  Two additional proteins, AGPAT4 and AGPAT5, are inferred to have such activity based on studies of homologous mouse enzymes (Lu et al. 2005).  These enzymes differ in their tissue specific patterns of expression in the body and in their preferences for specific acyl CoA molecules (Shindou and Shimizu 2009; Takeuchi and Reue 2009).<br>\"}]}" ;
