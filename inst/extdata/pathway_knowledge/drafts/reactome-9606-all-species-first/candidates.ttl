    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 193786, \"displayName\": \"3,7,24THCA is translocated from the mitochondrial matrix to the cytosol\", \"followingEvent\": [193743], \"goBiologicalProcess\": {\"accession\": \"0170037\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 9910496, \"definition\": \"The directed movement of substances from the mitochondrion to the cytosol.\", \"displayName\": \"export from the mitochondrion\", \"name\": \"export from the mitochondrion\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0170037\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193786], \"dbId\": 193757, \"displayName\": \"3,7,24THCA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3,7,24THCA\", \"3alpha,7alpha,24-trihydroxy-5beta-cholestan-26-oic acid\", \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate\", \"3alpha,7alpha,24-trihydroxy-5beta-cholestan-26-oyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193757\", \"stIdVersion\": \"R-ALL-193757.5\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 192080, \"displayName\": \"The enzymes, regulation, and genetics of bile acid synthesis\", \"journal\": \"Annu Rev Biochem\", \"pages\": \"137-74\", \"pubMedIdentifier\": 12543708, \"schemaClass\": \"LiteratureReference\", \"title\": \"The enzymes, regulation, and genetics of bile acid synthesis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12543708\", \"volume\": 72, \"year\": 2003}], \"maxDepth\": 1, \"name\": [\"3,7,24THCA is translocated from the mitochondrial matrix to the cytosol\", \"3,7,24THCA [mitochondrial matrix] => 3,7,24THCA [cytosol]\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193778, \"displayName\": \"3,7,24THCA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3,7,24THCA\", \"3alpha,7alpha,24-trihydroxy-5beta-cholestan-26-oic acid\", \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate\", \"3alpha,7alpha,24-trihydroxy-5beta-cholestan-26-oyl-CoA\"], \"producedByEvent\": [193786], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193778\", \"stIdVersion\": \"R-ALL-193778.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193737, \"displayName\": \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al is oxidized to 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate (3,7,24THCA)\", \"followingEvent\": [193786], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al is oxidized to 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate (3,7,24THCA)\", \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al + NADPH + H+ + O2 => 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate (3,7,24THCA) + NADP+ + H2O\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193737\", \"stIdVersion\": \"R-HSA-193737.2\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193786\", \"stIdVersion\": \"R-HSA-193786.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193765, \"displayName\": \"3,7,24THCA (3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoa...\", \"schemaClass\": \"Summation\", \"text\": \"3,7,24THCA (3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate) is translocated from the mitochondrial matrix to the cytosol. The transporter that mediates its passage across the inner mitochondrial membrane has not been identified (Russell 2003). VLCS (SLC27A2), one of the enzymes that catalyzes CoA conjugation of 3,7,24THCA, may also be present in peroxisomes, and Mihalik et al. (2002) have hypothesized that 3,7,24THCA could be translocated unchanged from the mitochondrial matrix to the peroxisomal matrix and undergo conjugation there.\"}]}" ;
