[\"M6PR transports activated ARSA to the lysosome\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2248891\", \"stIdVersion\": \"R-HSA-2248891.3\"}], \"releaseDate\": \"2023-09-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840949\", \"stIdVersion\": \"R-HSA-9840949.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9840950, \"displayName\": \"Sulfated sphingoglycolipid GM3 (SM3, sulfated LacCer, dihexo...\", \"schemaClass\": \"Summation\", \"text\": \"Sulfated sphingoglycolipid GM3 (SM3, sulfated LacCer, dihexosyl sulfatide) is desulfated by arylsulfatase A (ARSA) to lactosylceramide (LacCer). In metachromatic leukodystrophy (MLD, MIM:250100), SM3 and other sulfatides accumulate, usually because of ARSA deficiency (Philppart et al., 1971; Whitfield et al., 2001).\"}]}" ;
