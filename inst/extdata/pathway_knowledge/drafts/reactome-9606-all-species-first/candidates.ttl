<https://reactome.org/content/detail/R-HSA-2161775> a mslm:LipidReaction ;
    rdfs:label "ALOX12 oxidises LTA4 to LXA4" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "H2O [cytosol] + LTA4 [cytosol] + O2 [cytosol] => LXA4 [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [2161775], \"className\": \"CatalystActivity\", \"dbId\": 2161800, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen, incorporation of two atoms of oxygen of ALOX12:Fe2+ [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690742, \"displayName\": \"RHEA:48585\", \"identifier\": \"48585\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/48585\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9916378, \"displayName\": \"RHEA:48585\", \"identifier\": \"48585\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/48585\"}], \"dbId\": 2161775, \"displayName\": \"ALOX12 oxidises LTA4 to LXA4\", \"followingEvent\": [2161779], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161775, 2161775], \"dbId\": 9032038, \"displayName\": \"LTA4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LTA4\", \"leukotriene A4(1-)\", \"leukotriene A4\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9032038\", \"stIdVersion\": \"R-ALL-9032038.4\"}, 9032038, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161775], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161775, 2161775], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 2161873, \"displayName\": \"Lipoxin synthase activity of human platelet 12-lipoxygenase\", \"journal\": \"Biochem J\", \"pages\": \"127-33\", \"pubMedIdentifier\": 8250832, \"schemaClass\": \"LiteratureReference\", \"title\": \"Lipoxin synthase activity of human platelet 12-lipoxygenase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8250832\", \"volume\": 296, \"year\": 1993}, {\"className\": \"LiteratureReference\", \"dbId\": 2162054, \"displayName\": \"Lipoxin formation during human neutrophil-platelet interactions. Evidence for the transformation of leukotriene A4 by platelet 12-lipoxygenase in vitro\", \"journal\": \"J Clin Invest\", \"pages\": \"772-80\", \"pubMedIdentifier\": 2155925, \"schemaClass\": \"LiteratureReference\", \"title\": \"Lipoxin formation during human neutrophil-platelet interactions. Evidence for the transformation of leukotriene A4 by platelet 12-lipoxygenase in vitro\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/2155925\", \"volume\": 85, \"year\": 1990}, {\"className\": \"LiteratureReference\", \"dbId\": 2161812, \"displayName\": \"Evidence for a 5(6)-epoxytetraene intermediate in the biosynthesis of lipoxins in human leukocytes. Conversion into lipoxin A by cytosolic epoxide hydrolase\", \"journal\": \"FEBS Lett\", \"pages\": \"127-32\", \"pubMedIdentifier\": 3770188, \"schemaClass\": \"LiteratureReference\", \"title\": \"Evidence for a 5(6)-epoxytetraene intermediate in the biosynthesis of lipoxins in human leukocytes. Conversion into lipoxin A by cytosolic epoxide hydrolase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/3770188\", \"volume\": 207, \"year\": 1986}], \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXA4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin A4\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11027045, \"displayName\": \"ALOX12 oxidises LTA4 to LXA4\", \"inferredFrom\": [2161775], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXA4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin A4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-2161775\", \"stIdVersion\": \"R-DDI-2161775.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10609631, \"displayName\": \"ALOX12 oxidises LTA4 to LXA4\", \"inferredFrom\": [2161775], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXA4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin A4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-2161775\", \"stIdVersion\": \"R-DRE-2161775.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10508493, \"displayName\": \"ALOX12 oxidises LTA4 to LXA4\", \"inferredFrom\": [2161775], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXA4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin A4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-2161775\", \"stIdVersion\": \"R-SSC-2161775.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10393500, \"displayName\": \"ALOX12 oxidises LTA4 to LXA4\", \"inferredFrom\": [2161775], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXA4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin A4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-2161775\", \"stIdVersion\": \"R-BTA-2161775.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10283486, \"displayName\": \"ALOX12 oxidises LTA4 to LXA4\", \"inferredFrom\": [2161775], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXA4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin A4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-2161775\", \"stIdVersion\": \"R-CFA-2161775.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10170395, \"displayName\": \"ALOX12 oxidises LTA4 to LXA4\", \"inferredFrom\": [2161775], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXA4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin A4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-2161775\", \"stIdVersion\": \"R-RNO-2161775.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10048496, \"displayName\": \"ALOX12 oxidises LTA4 to LXA4\", \"inferredFrom\": [2161775], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12 oxidises LTA4 to LXA4\", \"2 H2O + 2 leukotriene A4 + O2 => 2 lipoxin A4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2161775\", \"stIdVersion\": \"R-MMU-2161775.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2161759, \"displayName\": \"LXA4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LXA4\", \"lipoxin A4(1-)\", \"lipoxin A4\"], \"producedByEvent\": [2161775, 2161775], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2161759\", \"stIdVersion\": \"R-ALL-2161759.4\"}, 2161759], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 9032036, \"displayName\": \"LTA4 translocates from neutrophil cytosol to platelet cytosol\", \"followingEvent\": [2161775], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"LTA4 translocates from neutrophil cytosol to platelet cytosol\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9032036\", \"stIdVersion\": \"R-HSA-9032036.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2012-03-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161775\", \"stIdVersion\": \"R-HSA-2161775.6\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2162021, \"displayName\": \"Arachidonate 12-lipoxygenase, 12S-type (ALOX12) catalyses th...\", \"schemaClass\": \"Summation\", \"text\": \"Arachidonate 12-lipoxygenase, 12S-type (ALOX12) catalyses the conversion of leukotriene A4 (LTA4) into the lipoxin LXA4, which has its third hydroxyl positioned at C-6 (Romano et al. 1993, Serhan & Sheppard  1990).  One of the reaction intermediates of this process might be 5S,6S-epoxy-15S-hydroxy-7E,9E,11Z,13E-eicosatetraenoic acid (5,6-Ep-15S-HETE) (Puustinen et al. 1986).  However, its generation from LTA4 is unclear but it can be hydrolysed to form the lipoxins.\"}]}" ;
