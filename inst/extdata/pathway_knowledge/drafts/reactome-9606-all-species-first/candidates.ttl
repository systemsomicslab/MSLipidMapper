<https://reactome.org/content/detail/R-HSA-1605595> a mslm:LipidReaction ;
    rdfs:label "bHEXA hydrolyzes GM2A:GM2 to GM2A:GM3" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
