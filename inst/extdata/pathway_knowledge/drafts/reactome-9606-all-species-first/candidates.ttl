    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8865637], \"className\": \"CatalystActivity\", \"dbId\": 8865644, \"displayName\": \"phospholipid transfer activity of MFSD2A [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}, {\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 8865637, \"displayName\": \"MFSD2A transports LPC from extracellular region to plasma membrane\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8865637], \"dbId\": 8865642, \"displayName\": \"LPC (22:6) [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LPC (22:6)\", \"lysophosphatidylcholine 22:6\", \"docosahexaenoyl-sn-glycero-3-phosphocholine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8865642\", \"stIdVersion\": \"R-ALL-8865642.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8865637], \"dbId\": 74113, \"displayName\": \"Na+ [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Na+\", \"sodium(1+)\", \"sodium ion\", \"Sodium\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-74113\", \"stIdVersion\": \"R-ALL-74113.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8865651, \"displayName\": \"Inactivating mutations in MFSD2A, required for omega-3 fatty acid transport in brain, cause a lethal microcephaly syndrome\", \"journal\": \"Nat. Genet.\", \"pages\": \"809-13\", \"pubMedIdentifier\": 26005868, \"schemaClass\": \"LiteratureReference\", \"title\": \"Inactivating mutations in MFSD2A, required for omega-3 fatty acid transport in brain, cause a lethal microcephaly syndrome\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/26005868\", \"volume\": 47, \"year\": 2015}, {\"className\": \"LiteratureReference\", \"dbId\": 8865632, \"displayName\": \"Structural insights into the transport mechanism of the human sodium-dependent lysophosphatidylcholine transporter Mfsd2a\", \"journal\": \"J. Biol. Chem.\", \"pubMedIdentifier\": 26945070, \"schemaClass\": \"LiteratureReference\", \"title\": \"Structural insights into the transport mechanism of the human sodium-dependent lysophosphatidylcholine transporter Mfsd2a\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/26945070\", \"year\": 2016}, {\"className\": \"LiteratureReference\", \"dbId\": 8865634, \"displayName\": \"Mfsd2a is a transporter for the essential omega-3 fatty