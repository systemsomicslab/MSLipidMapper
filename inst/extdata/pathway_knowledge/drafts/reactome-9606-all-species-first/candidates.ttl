ris\", \"stId\": \"R-CFA-196350\", \"stIdVersion\": \"R-CFA-196350.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10129089, \"displayName\": \"Pregnenolone is dehydrogenated to form pregn-5-ene-3,20-dione\", \"inferredFrom\": [196350], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Pregnenolone is dehydrogenated to form pregn-5-ene-3,20-dione\", \"Pregnenolone + NAD+ => pregn-5-ene-3,20-dione + NADH + H+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-196350\", \"stIdVersion\": \"R-RNO-196350.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10008029, \"displayName\": \"Pregnenolone is dehydrogenated to form pregn-5-ene-3,20-dione\", \"inferredFrom\": [196350], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Pregnenolone is dehydrogenated to form pregn-5-ene-3,20-dione\", \"Pregnenolone + NAD+ => pregn-5-ene-3,20-dione + NADH + H+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-196350\", \"stIdVersion\": \"R-MMU-196350.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 196344, \"displayName\": \"pregn-5-ene-3,20-dione [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"pregn-5-ene-3,20-dione\"], \"producedByEvent\": [196350], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-196344\", \"stIdVersion\": \"R-ALL-196344.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 73473, \"displayName\": \"NADH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [196350], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-73473\", \"stIdVersion\": \"R-ALL-73473.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [196350], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 193097, \"displayName\": \"Pregnenolone translocates from the mitochondrial matrix to the cytosol\", \"followingEvent\": [196350], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Pregnenolone translocates from the mitochondrial matrix to the cytosol\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193097\", \"stIdVersion\": \"R-HSA-193097.4\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-196350\", \"stIdVersion\": \"R-HSA-196350.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 196331, \"displayName\": \"Pregnenolone and NAD+ react to form pregn-5-ene-3,20-dione a...\", \"schemaClass\": \"Summation\", \"text\": \"Pregnenolone and NAD+ react to form pregn-5-ene-3,20-dione and NADH + H+. This reaction is catalyzed by the 3 beta-hydroxysteroid activity of 3-beta-hydroxysteroid dehydrogenase/isomerase (HSD3B) enzyme associated with the endoplasmic reticulum membrane. The active form of the enzyme is a homodimer. The enzyme occurs in two isoforms that are similar in their biochemical properties but differ in their tissue expression: type I (HSD3B1) is found in placenta and skin, while type II (HSD3B2) is found in the adrenal glands and gonads.\"}]}" ;
