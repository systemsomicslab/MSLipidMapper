, \"name\": [\"CDP-Cho and DAG are converted to PC by CEPT1 at the ER membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482961\", \"stIdVersion\": \"R-HSA-1482961.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482547, \"displayName\": \"1-acyl LPC is acylated to PC by LPCAT\", \"followingEvent\": [1482816], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPC is acylated to PC by LPCAT\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482547\", \"stIdVersion\": \"R-HSA-1482547.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482533, \"displayName\": \"2-acyl LPC is acylated to PC by LPCAT\", \"followingEvent\": [1482816], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"2-acyl LPC is acylated to PC by LPCAT\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482533\", \"stIdVersion\": \"R-HSA-1482533.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482816\", \"stIdVersion\": \"R-HSA-1482816.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482758, \"displayName\": \"At the endoplasmic reticulum (ER) membrane, phosphatidylchol...\", \"schemaClass\": \"Summation\", \"text\": \"At the endoplasmic reticulum (ER) membrane, phosphatidylcholine (PC) is hydrolyzed, and has one of its acyl chains cleaved off, by a membrane-associated phospholipase A2 to form 1-acyl lysophosphatidylcholine (LPC).  The phospholipases are either phospholipase A2 group II alpha (PLA2G2A) (Seihamer et al. 1989, Singer et al. 2002), cytosolic phospholipase A2 group IV gamma (PLA2G4C) (Yamashita et al. 2005, Pickard et al. 1999, Ghomashchi et al. 2010, Yamashita et al. 2009), or calcium-independent phospholipase A2-gamma (PNPLA8) (Murakami et al. 2005, Underwood et al. 1998).\"}]}" ;
