\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [1675776], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1675810, \"displayName\": \"PI is phosphorylated to PI5P by PIP5K1A/B at the plasma membrane\", \"followingEvent\": [1675776], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI is phosphorylated to PI5P by PIP5K1A/B at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675810\", \"stIdVersion\": \"R-HSA-1675810.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676203, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\", \"followingEvent\": [1675776], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI5P by SYNJ/MTMs at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676203\", \"stIdVersion\": \"R-HSA-1676203.4\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675776\", \"stIdVersion\": \"R-HSA-1675776.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1675956, \"displayName\": \"At the plasma membrane, phosphatidylinositol-5-phosphate 4-k...\", \"schemaClass\": \"Summation\", \"text\": \"At the plasma membrane, phosphatidylinositol-5-phosphate 4-kinase type-2 alpha (PIP4K2A), beta (PIP4K2B) and gamma (PIP4K2C) homodimers and heterodimers (Clarke et al. 2010, Clarke and Irvine 2013, Clarke et al. 2015) phosphorylate phosphatidylinositol 5-phosphate (PI5P) to phosphatidylinositol 4,5-bisphosphate (PI(4,5)P2).<br><br>The following lists the above proteins with their corresponding literature references: PIP4K2A (Rameh et al. 1997, Clarke et al. 2008, Clarke and Irvine 2013), PIP4K2B (Rameh et al. 1997, Clarke and Irvine 2013) and PIP4K2C (Clarke and Irvine 2013, Clarke et al. 2015).\"}]}" ;
