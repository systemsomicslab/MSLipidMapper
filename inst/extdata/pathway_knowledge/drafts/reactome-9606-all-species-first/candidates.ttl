    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [5696822], \"className\": \"CatalystActivity\", \"dbId\": 5696844, \"displayName\": \"estradiol 17-beta-dehydrogenase [NAD(P)+] activity of AKR1B15 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690627, \"displayName\": \"RHEA:24617\", \"identifier\": \"24617\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/24617\"}], \"dbId\": 5696822, \"displayName\": \"AKR1B15 reduces EST17b to E1\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [5696822], \"dbId\": 5696835, \"displayName\": \"EST17b [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"EST17b\", \"17beta-estradiol\", \"Estradiol-17beta\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5696835\", \"stIdVersion\": \"R-ALL-5696835.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [5696822], \"dbId\": 113563, \"displayName\": \"NADP+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triph