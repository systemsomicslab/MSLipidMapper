<https://reactome.org/content/detail/R-HSA-9018895> a mslm:LipidReaction ;
    rdfs:label "GPX4-2 reduces 18(R)-HpEPE to 18(R)-HEPE" ;
    mslm:curationStatus mslm:Draft ;
