    mslm:equation "lipid droplet [lipid droplet] + HSD17B13 [cytosol] => HSD17B13:lipid droplet [lipid droplet]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8862380], \"className\": \"CatalystActivity\", \"dbId\": 9956936, \"displayName\": \"lipid transfer activity of HSD17B13 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005811\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13977, \"definition\": \"An intracellular non-membrane-bounded organelle comprising a matrix of coalesced lipids surrounded by a phospholipid monolayer. May include associated proteins.\", \"displayName\": \"lipid droplet\", \"name\": \"lipid droplet\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005811\"}], \"dbId\": 8862380, \"displayName\": \"HSD17B13 binds lipid droplets\", \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [8862380], \"dbId\": 8862029, \"displayName\": \"HSD17B13 [cytosol]\", \"endCoordinate\": 300, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HSD17B13\", \"17-beta-hydroxysteroid dehydrogenase 13\", \"DHB13_HUMAN\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8862029\", \"stIdVersion\": \"R-HSA-8862029.2\", \"startCoordinate\": 20}, {\"className\": \"Complex\", \"consumedByEvent\": [8862380], \"dbId\": 8866926, \"displayName\": \"lipid droplet [lipid droplet]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"lipid droplet\"], \"schemaClass\": \"Complex\", \"stId\": \"R-ALL-8866926\", \"stIdVersion\": \"R-ALL-8866926.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8862388, \"displayName\": \"Comparative proteomic study reveals 17β-HSD13 as a pathogenic protein in nonalcoholic fatty liver disease\", \"journal\": \"Proc. Natl. Acad. Sci. U.S.A.\", \"pages\": \"11437-42\", \"pubMedIdentifier\": 25028495, \"schemaClass\": \"LiteratureReference\", \"title\": \"Comparative proteomic study reveals 17β-HSD13 as a pathogenic protein in nonalcoholic fatty liver disease\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25028495\", \"volume\": 111, \"year\": 2014}, {\"className\": \"LiteratureReference\", \"dbId\": 8862375, \"displayName\": \"Molecular cloning and expression analysis of a new gene for short-chain dehydrogenase/reductase 9\", \"journal\": \"Acta Biochim. Pol.\", \"pages\": \"213-8\", \"pubMedIdentifier\": 17311113, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular cloning and expression analysis of a new gene for short-chain dehydrogenase/reductase 9\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17311113\", \"volume\": 54, \"year\": 2007}], \"maxDepth\": 1, \"name\": [\"HSD17B13 binds lipid droplets\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11110151, \"displayName\": \"HSD17B13 binds lipid droplets\", \"inferredFrom\": [8862380], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B13 binds lipid droplets\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-8862380\", \"stIdVersion\": \"R-SCE-8862380.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10988969, \"displayName\": \"HSD17B13 binds lipid droplets\", \"inferredFrom\": [8862380], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B13 binds lipid droplets\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-8862380\", \"stIdVersion\": \"R-CEL-8862380.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10902569, \"displayName\": \"HSD17B13 binds lipid droplets\", \"inferredFrom\": [8862380], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B13 binds lipid droplets\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8862380\", \"stIdVersion\": \"R-DME-8862380.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10720741, \"displayName\": \"HSD17B13 binds lipid droplets\", \"inferredFrom\": [8862380], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B13 binds lipid droplets\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8862380\", \"stIdVersion\": \"R-XTR-8862380.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10428292, \"displayName\": \"HSD17B13 binds lipid droplets\", \"inferredFrom\": [8862380], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B13 binds lipid droplets\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8862380\", \"stIdVersion\": \"R-BTA-8862380.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10206016, \"displayName\": \"HSD17B13 binds lipid droplets\", \"inferredFrom\": [8862380], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B13 binds lipid droplets\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8862380\", \"stIdVersion\": \"R-RNO-8862380.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10083075, \"displayName\": \"HSD17B13 binds lipid droplets\", \"inferredFrom\": [8862380], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B13 binds lipid droplets\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8862380\", \"stIdVersion\": \"R-MMU-8862380.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 8862370, \"displayName\": \"HSD17B13:lipid droplet [lipid droplet]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"HSD17B13:lipid droplet\"], \"producedByEvent\": [8862380], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8862370\", \"stIdVersion\": \"R-HSA-8862370.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-06-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8862380\", \"stIdVersion\": \"R-HSA-8862380.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8862386, \"displayName\": \"The short-chain dehydrogenases/reductases (SDR) family is a ...\", \"schemaClass\": \"Summation\", \"text\": \"The short-chain dehydrogenases/reductases (SDR) family is a large family of NAD- or NADP-dependent oxidoreductase enzymes. 17-beta-hydroxysteroid dehydrogenase 13 (HSD17B13) is a recently-discovered member of this family whose physiological function is unknown (Liu et al. 2007). It has, however, been found to associate with lipid droplets and is significantly upregulated in patients with nonalcoholic fatty liver disease (NAFLD) which is characterised by an accumulation of lipid droplets in the liver. In a murine model of fatty liver and diabetes, mice with fatty livers show upregulated expression of HSD17B13, suggesting a pathogenic role for HSD17B13 in NAFLD development (Su et al. 2014). Its role in lipid droplet function under normal physiological conditions is unknown.\"}]}" ;
