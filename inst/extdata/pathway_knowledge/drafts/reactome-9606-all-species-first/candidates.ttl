stId\": \"R-MMU-109998\", \"stIdVersion\": \"R-MMU-109998.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 77343, \"displayName\": \"tdec2-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"tdec2-CoA\", \"trans-dec-2-enoyl-CoA(4-)\", \"trans-dec-2-enoyl-CoA\"], \"producedByEvent\": [109998], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77343\", \"stIdVersion\": \"R-ALL-77343.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 109343, \"displayName\": \"Reduction of 2-trans-4-cis-decadienoyl-CoA to form 3-trans-decenoyl-CoA\", \"followingEvent\": [109998], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Reduction of 2-trans-4-cis-decadienoyl-CoA to form 3-trans-decenoyl-CoA\"], \"releaseDate\": \"2004-07-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-109343\", \"stIdVersion\": \"R-HSA-109343.3\"}], \"releaseDate\": \"2004-07-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-109998\", \"stIdVersion\": \"R-HSA-109998.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 110000, \"displayName\": \"Once the second of the two double bonds has been reached 3,2...\", \"schemaClass\": \"Summation\", \"text\": \"Once the second of the two double bonds has been reached 3,2-trans-enoyl-CoA isomerase, changes the spatial conformation of the second double bond from cis