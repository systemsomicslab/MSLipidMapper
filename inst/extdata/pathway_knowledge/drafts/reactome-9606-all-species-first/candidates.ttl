    mslm:directionality mslm:SourceForward ;
    mslm:equation "LIN-CoA [mitochondrial matrix] + CoA-SH [mitochondrial matrix] + H2O [mitochondrial matrix] + FAD [mitochondrial matrix] + NAD+ [mitochondrial matrix] => cis,cis-3,6-Dodecadienoyl-CoA [mitochondrial matrix] + H+ [mitochondrial matrix] + Ac-CoA [mitochondrial matrix] + FADH2 [mitochondrial matrix] + NADH [mitochondrial matrix]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 109339, \"displayName\": \"Linoleoyl-CoA is converted to cis,cis-3,6- dodecadienoyl-CoA by three cycles of beta-oxidation\", \"figure\": [{\"className\": \"Figure\", \"dbId\": 109982, \"displayName\": \"/figures/unsatfattyacidbetao_1.jpg\", \"schemaClass\": \"Figure\", \"url\": \"/figures/unsatfattyacidbetao_1.jpg\"}], \"followingEvent\": [109338], \"goBiologicalProcess\": {\"accession\": \"0006635\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 20426, \"definition\": \"A fatty acid oxidation process that results in the complete oxidation of a long-chain fatty acid. Fatty acid beta-oxidation begins with the addition of coenzyme A to a fatty acid, and occurs by successive cycles of reactions during each of which the fatty acid is shortened by a two-carbon fragment removed as acetyl coenzyme A; the cycle continues until only two or three carbons remain (as acetyl-CoA or propionyl-CoA respectively).\", \"displayName\": \"fatty acid beta-oxidation\", \"name\": \"fatty acid beta-oxidation\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006635\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [109339], \"dbId\": 77359, \"displayName\": \"LIN-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LIN-CoA\", \"linoleoyl-CoA(4-)\", \"linoleoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77359\", \"stIdVersion\": \"R-ALL-77359.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [109339, 109339, 109339], \"dbId\": 113596, \"displayName\": \"FAD [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FAD\", \"FAD(3-)\", \"Flavin adenine dinucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113596\", \"stIdVersion\": \"R-ALL-113596.4\"}, 113596, 113596, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [109339, 109339, 109339], \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}, 113521, 113521, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [109339, 109339, 109339], \"dbId\": 113526, \"displayName\": \"NAD+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\", \"NAD+ \"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113526\", \"stIdVersion\": \"R-ALL-113526.6\"}, 113526, 113526, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [109339, 109339, 109339], \"dbId\": 29374, \"displayName\": \"CoA-SH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"CoA\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29374\", \"stIdVersion\": \"R-ALL-29374.5\"}, 29374, 29374], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"chapterTitle\": \"Mitochondrial fatty acid oxidation disorders\", \"className\": \"Book\", \"dbId\": 77402, \"displayName\": \"The Metabolic and Molecular Bases of Inherited Disease, 8th ed Scriver, CR Mitochondrial fatty acid oxidation disorders 0079130356\", \"isbn\": \"0079130356\", \"pages\": \"2297-2326\", \"schemaClass\": \"Book\", \"title\": \"The Metabolic and Molecular Bases of Inherited Disease, 8th ed\", \"year\": 2001}], \"maxDepth\": 1, \"name\": [\"Linoleoyl-CoA is converted to cis,cis-3,6- dodecadienoyl-CoA by three cycles of beta-oxidation\", \"Removal of six carbons from Linoleoyl-CoA to form cis,cis-3,6- Dodecadienoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 77358, \"displayName\": \"cis,cis-3,6-Dodecadienoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"cis,cis-3,6-Dodecadienoyl-CoA\", \"(3Z,6Z)-dodecadienoyl-CoA(4-)\", \"(3Z,6Z)-dodecadienoyl-CoA\"], \"producedByEvent\": [109339], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77358\", \"stIdVersion\": \"R-ALL-77358.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 31649, \"displayName\": \"FADH2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FADH2\", \"FADH2(2-)\"], \"producedByEvent\": [109339, 109339, 109339], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-31649\", \"stIdVersion\": \"R-ALL-31649.3\"}, 31649, 31649, {\"className\": \"Chemical Compound\", \"dbId\": 29362, \"displayName\": \"NADH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [109339, 109339, 109339], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29362\", \"stIdVersion\": \"R-ALL-29362.4\"}, 29362, 29362, {\"className\": \"Chemical Compound\", \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [109339, 109339, 109339], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}, 113529, 113529, {\"className\": \"Chemical Compound\", \"dbId\": 113559, \"displayName\": \"Ac-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ac-CoA\", \"acetyl-CoA(4-)\", \"Acetyl coenzyme A\", \"acetyl-CoA\"], \"producedByEvent\": [109339, 109339, 109339], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113559\", \"stIdVersion\": \"R-ALL-113559.5\"}, 113559, 113559], \"regulatedBy\": [{\"className\": \"Requirement\", \"dbId\": 5422852, \"displayName\": \"Requirement by 'ACADL tetramer [mitochondrial matrix]'\", \"regulatedEntity\": [109339], \"schemaClass\": \"Requirement\", \"stId\": \"R-HSA-5422852\", \"stIdVersion\": \"R-HSA-5422852.1\"}, {\"className\": \"Requirement\", \"dbId\": 5422853, \"displayName\": \"Requirement by 'Trifunctional Protein [mitochondrial matrix]'\", \"regulatedEntity\": [109339], \"schemaClass\": \"Requirement\", \"stId\": \"R-HSA-5422853\", \"stIdVersion\": \"R-HSA-5422853.1\"}], \"releaseDate\": \"2004-07-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-109339\", \"stIdVersion\": \"R-HSA-109339.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 109983, \"displayName\": \"Three cycles of beta oxidation, each mediated by the activit...\", \"schemaClass\": \"Summation\", \"text\": \"Three cycles of beta oxidation, each mediated by the activities of trifunctional protein and ACADL tetramer, convert linoleoyl-CoA to cis,cis-3,6-dodecadienoyl-CoA plus three molecules each of CoA-SH, FADH2, and NADH + H+.\"}]}" ;
