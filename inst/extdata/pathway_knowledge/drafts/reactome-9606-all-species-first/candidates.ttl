<https://reactome.org/content/detail/R-HSA-9956909> a mslm:LipidReaction ;
    rdfs:label "CERT1-2 transfers CERA from the ER membrane to the Golgi membrane" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "CERA [endoplasmic reticulum membrane] => CERA [Golgi membrane]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9956909], \"className\": \"CatalystActivity\", \"dbId\": 9956911, \"displayName\": \"ceramide transfer activity of CERT1-2:PPM1L:VAPA/B dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9956910, \"displayName\": \"ceramide transfer activity of CERT1-2:PPM1L:VAPA/B dimer [endoplasmic reticulum membrane] Structure, functions and regulation of CERT, a lipid-transfer protein for the delivery of ceramide at the ER-Golgi membrane contact sites\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 9956909, \"displayName\": \"CERT1-2 transfers CERA from the ER membrane to the Golgi membrane\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9956909], \"dbId\": 428256, \"displayName\": \"CERA [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CERA\", \"N-acylsphingoid\", \"ceramide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428256\", \"stIdVersion\": \"R-ALL-428256.6\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9843198, \"displayName\": \"Oxysterol-binding Protein Activation at Endoplasmic Reticulum-Golgi Contact Sites Reorganizes Phosphatidylinositol 4-Phosphate Pools\", \"journal\": \"J Biol Chem\", \"pages\": \"1336-47\", \"pubMedIdentifier\": 26601944, \"schemaClass\": \"LiteratureReference\", \"title\": \"Oxysterol-binding Protein Activation at Endoplasmic Reticulum-Golgi Contact Sites Reorganizes Phosphatidylinositol 4-Phosphate Pools\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/26601944\", \"volume\": 291, \"year\": 2016}, {\"className\": \"LiteratureReference\", \"dbId\": 429692, \"displayName\": \"Molecular machinery for non-vesicular trafficking of ceramide\", \"journal\": \"Nature\", \"pages\": \"803-9\", \"pubMedIdentifier\": 14685229, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular machinery for non-vesicular trafficking of ceramide\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/14685229\", \"volume\": 426, \"year\": 2003}, {\"className\": \"LiteratureReference\", \"dbId\": 429686, \"displayName\": \"Efficient trafficking of ceramide from the endoplasmic reticulum to the Golgi apparatus requires a VAMP-associated protein-interacting FFAT motif of CERT\", \"journal\": \"J Biol Chem\", \"pages\": \"30279-88\", \"pubMedIdentifier\": 16895911, \"schemaClass\": \"LiteratureReference\", \"title\": \"Efficient trafficking of ceramide from the endoplasmic reticulum to the Golgi apparatus requires a VAMP-associated protein-interacting FFAT motif of CERT\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/16895911\", \"volume\": 281, \"year\": 2006}, {\"className\": \"LiteratureReference\", \"dbId\": 429707, \"displayName\": \"Structural basis for specific lipid recognition by CERT responsible for nonvesicular trafficking of ceramide\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"488-93\", \"pubMedIdentifier\": 18184806, \"schemaClass\": \"LiteratureReference\", \"title\": \"Structural basis for specific lipid recognition by CERT responsible for nonvesicular trafficking of ceramide\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18184806\", \"volume\": 105, \"year\": 2008}, {\"className\": \"LiteratureReference\", \"dbId\": 9843187, \"displayName\": \"Structure, functions and regulation of CERT, a lipid-transfer protein for the delivery of ceramide at the ER-Golgi membrane contact sites\", \"journal\": \"FEBS Lett\", \"pages\": \"2366-2377\", \"pubMedIdentifier\": 31254361, \"schemaClass\": \"LiteratureReference\", \"title\": \"Structure, functions and regulation of CERT, a lipid-transfer protein for the delivery of ceramide at the ER-Golgi membrane contact sites\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/31254361\", \"volume\": 593, \"year\": 2019}, {\"className\": \"LiteratureReference\", \"dbId\": 9843190, \"displayName\": \"Integration of non-vesicular and vesicular transport processes at the Golgi complex by the PKD-CERT network\", \"journal\": \"Biochim Biophys Acta\", \"pages\": \"1096-103\", \"pubMedIdentifier\": 22226883, \"schemaClass\": \"LiteratureReference\", \"title\": \"Integration of non-vesicular and vesicular transport processes at the Golgi complex by the PKD-CERT network\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/22226883\", \"volume\": 1821, \"year\": 2012}, {\"className\": \"LiteratureReference\", \"dbId\": 429673, \"displayName\": \"Oxysterol-binding protein and vesicle-associated membrane protein-associated protein are required for sterol-dependent activation of the ceramide transport protein\", \"journal\": \"Mol Biol Cell\", \"pages\": \"2604-16\", \"pubMedIdentifier\": 16571669, \"schemaClass\": \"LiteratureReference\", \"title\": \"Oxysterol-binding protein and vesicle-associated membrane protein-associated protein are required for sterol-dependent activation of the ceramide transport protein\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/16571669\", \"volume\": 17, \"year\": 2006}, {\"className\": \"LiteratureReference\", \"dbId\": 429720, \"displayName\": \"Protein phosphatase 2Cepsilon is an endoplasmic reticulum integral membrane protein that dephosphorylates the ceramide transport protein CERT to enhance its association with organelle membranes\", \"journal\": \"J Biol Chem\", \"pages\": \"6584-93\", \"pubMedIdentifier\": 18165232, \"schemaClass\": \"LiteratureReference\", \"title\": \"Protein phosphatase 2Cepsilon is an endoplasmic reticulum integral membrane protein that dephosphorylates the ceramide transport protein CERT to enhance its association with organelle membranes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18165232\", \"volume\": 283, \"year\": 2008}], \"maxDepth\": 1, \"name\": [\"CERT1-2 transfers CERA from the ER membrane to the Golgi membrane\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10917973, \"displayName\": \"CERT1-2 transfers CERA from the ER membrane to the Golgi membrane\", \"inferredFrom\": [9956909], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CERT1-2 transfers CERA from the ER membrane to the Golgi membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-9956909\", \"stIdVersion\": \"R-DME-9956909.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10654255, \"displayName\": \"CERT1-2 transfers CERA from the ER membrane to the Golgi membrane\", \"inferredFrom\": [9956909], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CERT1-2 transfers CERA from the ER membrane to the Golgi membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9956909\", \"stIdVersion\": \"R-DRE-9956909.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10449044, \"displayName\": \"CERT1-2 transfers CERA from the ER membrane to the Golgi membrane\", \"inferredFrom\": [9956909], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CERT1-2 transfers CERA from the ER membrane to the Golgi membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9956909\", \"stIdVersion\": \"R-BTA-9956909.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 428270, \"displayName\": \"CERA [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CERA\", \"N-acylsphingoid\", \"ceramide\"], \"producedByEvent\": [9956909], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428270\", \"stIdVersion\": \"R-ALL-428270.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 429730, \"displayName\": \"PPM1L dephosphorylates multiphospho-CERT1-2\", \"followingEvent\": [9956909], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PPM1L dephosphorylates multiphospho-CERT1-2\", \"O-phospho-L-seryl/threonyl-(protein) + H2O => L-seryl/threonyl-(protein) + phosphate\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-429730\", \"stIdVersion\": \"R-HSA-429730.5\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821383, \"definition\": \"internally reviewed\", \"displayName\": \"three stars\", \"name\": [\"three stars\"], \"schemaClass\": \"ReviewStatus\"}, \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 429728, \"displayName\": \"Positive regulation by 'OSBP [cytosol]'\", \"regulatedEntity\": [9956909], \"schemaClass\": \"PositiveRegulation\", \"stId\": \"R-HSA-429728\", \"stIdVersion\": \"R-HSA-429728.1\"}], \"releaseDate\": \"2025-09-18\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9956909\", \"stIdVersion\": \"R-HSA-9956909.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9956912, \"displayName\": \"CERT1-2 (ceramide transfer protein, isoform 2), an isoform o...\", \"schemaClass\": \"Summation\", \"text\": \"CERT1-2 (ceramide transfer protein, isoform 2), an isoform of COL4A3BP, mediates the non-vesicular transfer of ceramide (CERA) from the endoplasmic reticulum (ER) membrane to the Golgi membrane at ER-Golgi membrane contact sites. This transfer is essential for cellular lipid homeostasis (Kumagai & Hanada 2019; Olayioye & Hausser 2012). CERT1-2 is associated with the cytosolic face of the ER membrane as part of a complex with PPM1L (protein phosphatase 1-like) (Saito et al. 2008) and VAPA or VAPB (VAMP-associated proteins A or B) (Kawano et al. 2006). The carboxyterminal START domain of CERT1-2 protein specifically binds ceramides (Hanada et al. 2003; Kudo et al. 2008). The PH domain of CERT1-2 can bridge the gap between the ER and the Golgi apparatus to transfer a CERA molecule extracted from the ER membrane to the Golgi (Hanada et al. 2003; Saito et al. 2008). CERT1-2-mediated ceramide transfer is positively regulated by OSBP (oxysterol binding protein), apparently through accumulation of phosphatidylinositol 4-phosphate (PI-4P) at membrane contact sites (Perry & Ridgway 2006; Goto et al. 2016).\"}]}" ;
