alse, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"B3GALNT1 transfers GalNAc to Gb3Cer to form Gb4Cer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8878914\", \"stIdVersion\": \"R-SSC-8878914.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10209187, \"displayName\": \"B3GALNT1 transfers GalNAc to Gb3Cer to form Gb4Cer\", \"inferredFrom\": [8878914], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"B3GALNT1 transfers GalNAc to Gb3Cer to form Gb4Cer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8878914\", \"stIdVersion\": \"R-RNO-8878914.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10086168, \"displayName\": \"B3GALNT1 transfers GalNAc to Gb3Cer to form Gb4Cer\", \"inferredFrom\": [8878914], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"B3GALNT1 transfers GalNAc to Gb3Cer to form Gb4Cer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8878914\", \"stIdVersion\": \"R-MMU-8878914.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8879101, \"displayName\": \"Gb4Cer [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Gb4Cer\", \"N-acetyl-beta-D-galactosaminyl-(1->3)-alpha-D-galactosyl-(1->4)-beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1')-ceramide\", \"N-acetyl-beta-D-galactosaminyl-(1->3)-alpha-D-galactosyl-(1->4)-beta-D-galactosyl-(1->4)-beta-D-glucosylceramide\"], \"producedByEvent\": [8878914], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8879101\", \"stIdVersion\": \"R-ALL-8879101.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 205687, \"displayName\": \"UDP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP\", \"UDP(3-)\", \"uridine 5'-diphosphate\"], \"producedByEvent\": [8878914], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-205687\", \"stIdVersion\": \"R-ALL-205687.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [8878914], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9846477, \"displayName\": \"A4GALT transfers galactose to LacCer\", \"followingEvent\": [8878914], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"A4GALT transfers galactose to LacCer\"], \"releaseDate\": \"2023-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9846477\", \"stIdVersion\": \"R-HSA-9846477.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8878914\", \"stIdVersion\": \"R-HSA-8878914.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8879107, \"displayName\": \"Globosides are a type of glycosphingolipid with more than on...\", \"schemaClass\": \"Summation\", \"text\": \"Globosides are a type of glycosphingolipid with more than one sugar as the side chain of ceramide, usually a combination of N-acetylgalactosamine, D-glucose or D-galactose. They are components of cellular membranes, especially of the kidneys, red blood cells, blood serum, liver and spleen. Globoside synthesis (and therefore accummulation) increases in pathological conditions including neurodegenerative disorders, immune diseases and cancer. UDP-GalNAc:beta-1,3-N-acetylgalactosaminyltransferase 1 (B3GALNT1, B3GALT3) is a Golgi membrane-associated protein that can add N-acetylgalactosamine (GalNAc) to globotriaosylceramide (Gb3Cer) to form Gb4Cer (Okajima et al. 2000, Amado et al. 1998).\"}]}" ;
