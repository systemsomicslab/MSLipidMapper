    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9024630], \"className\": \"CatalystActivity\", \"dbId\": 9024806, \"displayName\": \"oxidoreductase activity of Hydroperoxy reductase [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9024630, \"displayName\": \"Hydroperoxy reductase reduces 7(S)-Hp-17(R)-HDHA to AT-RvD5\", \"followingEvent\": [9024586], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9024630], \"dbId\": 9024479, \"displayName\": \"7(S)-Hp-17(R)-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7(S)-Hp-17(R)-HDHA\", \"7(S)-hydroperoxy-17(R)-hydroxydocosahexaenoate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024479\", \"stIdVersion\": \"R-ALL-9024479.4\"}, {\"className\": \"OtherEntity\", \"consumedByEvent\": [9024630], \"dbId\": 5359016, \"displayName\": \"reduced acceptor [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"reduced acceptor\", \"XH2\"], \"schemaClass\": \"OtherEntity\", \"stId\": \"R-ALL-5359016\", \"stIdVersion\": \"R-ALL-5359016.2\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9022657, \"displayName\": \"Resolvins: a family of bioactive products of omega-3 fatty acid transformation circuits initiated by aspirin treatment that counter proinflammation signals\", \"journal\": \"J. Exp. Med.\", \"pages\": \"1025-37\", \"pubMedIdentifier\": 12391014, \"schemaClass\": \"LiteratureReference\", \"title\": \"Resolvins: a family of bioactive products of omega-3 fatty acid transformation circuits initiated by aspirin treatment that counter proinflammation signals\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12391014\", \"volume\": 196, \"year\": 2002}, {\"className\": \"LiteratureReference\", \"dbId\": 9024634, \"displayName\": \"Total Synthesis of Resolvin D5\", \"journal\": \"J. Org. Chem.\", \"pages\": \"2032-2039\", \"pubMedIdentifier\": 28098462, \"schemaClass\": \"LiteratureReference\", \"title\": \"Total Synthesis of Resolvin D5\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/28098462\", \"volume\": 82, \"year\": 2017}], \"maxDepth\": 1, \"name\": [\"Hydroperoxy reductase reduces 7(S)-Hp-17(R)-HDHA to AT-RvD5\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9024639, \"displayName\": \"AT-RvD5 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AT-RvD5\", \"aspirin-triggered resolvin D5(1-)\", \"aspirin-triggered RvD5\"], \"producedByEvent\": [9024630], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024639\", \"stIdVersion\": \"R-ALL-9024639.4\"}, {\"className\": \"OtherEntity\", \"dbId\": 9024637, \"displayName\": \"oxidised acceptor [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"oxidised acceptor\"], \"producedByEvent\": [9024630], \"schemaClass\": \"OtherEntity\", \"stId\": \"R-ALL-9024637\", \"stIdVersion\": \"R-ALL-9024637.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9020251, \"displayName\": \"ALOX5 oxidises 17(R)-HDHA to 7(S)-Hp-17(R)-HDHA\", \"followingEvent\": [9024630], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 17(R)-HDHA to 7(S)-Hp-17(R)-HDHA\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9020251\", \"stIdVersion\": \"R-HSA-9020251.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9024630\", \"stIdVersion\": \"R-HSA-9024630.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9024642, \"displayName\": \"An unknown reductase mediates the reduction of 7(S)-hydroper...\", \"schemaClass\": \"Summation\", \"text\": \"An unknown reductase mediates the reduction of 7(S)-hydroperoxy-17(R)-hydroxydocosahexaenoic acid (7(S)-Hp-17(R)-HDHA) to AT-RvD5 (Serhan et al. 2002), the structure of which has been chemically synthesised as 7(S),17(R)-dihydroxydocosahexaenoic acid (Ogawa et al. 2017). In mice with E.coli infection, several specialized pro-resolving mediators (SPMs) including RvD5, together with antibiotics, accelerated resolution and heightened host antimicrobial responses (Chiang et al. 2012).\"}]}" ;
