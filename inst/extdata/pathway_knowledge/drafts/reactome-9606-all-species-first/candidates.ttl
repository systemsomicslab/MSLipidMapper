    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8951850], \"className\": \"CatalystActivity\", \"dbId\": 8951851, \"displayName\": \"cholesterol transfer activity of TSPO:BZRAP1 [mitochondrial outer membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005741\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17906, \"definition\": \"The outer, i.e. cytoplasm-facing, lipid bilayer of the mitochondrial envelope.\", \"displayName\": \"mitochondrial outer membrane\", \"name\": \"mitochondrial outer membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005741\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690371, \"displayName\": \"RHEA:39747\", \"identifier\": \"39747\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/39747\"}], \"dbId\": 8951850, \"displayName\": \"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8951850], \"dbId\": 8951853, \"displayName\": \"CHOL [mitochondrial outer membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CHOL\", \"cholesterol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8951853\", \"stIdVersion\": \"R-ALL-8951853.3\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8951858, \"displayName\": \"Cloning and characterization of PRAX-1. A new protein that specifically interacts with the peripheral benzodiazepine receptor\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"2938-52\", \"pubMedIdentifier\": 9915832, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cloning and characterization of PRAX-1. A new protein that specifically interacts with the peripheral benzodiazepine receptor\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9915832\", \"volume\": 274, \"year\": 1999}, {\"className\": \"LiteratureReference\", \"dbId\": 8951875, \"displayName\": \"The human peripheral benzodiazepine receptor gene: cloning and characterization of alternative splicing in normal tissues and in a patient with congenital lipoid adrenal hyperplasia\", \"journal\": \"Genomics\", \"pages\": \"643-50\", \"pubMedIdentifier\": 8307574, \"schemaClass\": \"LiteratureReference\", \"title\": \"The human peripheral benzodiazepine receptor gene: cloning and characterization of alternative splicing in normal tissues and in a patient with congenital lipoid adrenal hyperplasia\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8307574\", \"volume\": 18, \"year\": 1993}, {\"className\": \"LiteratureReference\", \"dbId\": 8951847, \"displayName\": \"Peripheral-type benzodiazepine receptors in endocrine organs: autoradiographic localization in rat pituitary, adrenal, and testis\", \"journal\": \"Endocrinology\", \"pages\": \"567-73\", \"pubMedIdentifier\": 2981667, \"schemaClass\": \"LiteratureReference\", \"title\": \"Peripheral-type benzodiazepine receptors in endocrine organs: autoradiographic localization in rat pituitary, adrenal, and testis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/2981667\", \"volume\": 116, \"year\": 1985}, {\"className\": \"LiteratureReference\", \"dbId\": 8951867, \"displayName\": \"The peripheral-type benzodiazepine receptor. Localization to the mitochondrial outer membrane\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"576-83\", \"pubMedIdentifier\": 3001071, \"schemaClass\": \"LiteratureReference\", \"title\": \"The peripheral-type benzodiazepine receptor. Localization to the mitochondrial outer membrane\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/3001071\", \"volume\": 261, \"year\": 1986}, {\"className\": \"LiteratureReference\", \"dbId\": 8951873, \"displayName\": \"Translocator protein-mediated pharmacology of cholesterol transport and steroidogenesis\", \"journal\": \"Mol. Cell. Endocrinol.\", \"pages\": \"90-8\", \"pubMedIdentifier\": 25818881, \"schemaClass\": \"LiteratureReference\", \"title\": \"Translocator protein-mediated pharmacology of cholesterol transport and steroidogenesis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25818881\", \"volume\": 408, \"year\": 2015}], \"maxDepth\": 1, \"name\": [\"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10992419, \"displayName\": \"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\", \"inferredFrom\": [8951850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-8951850\", \"stIdVersion\": \"R-CEL-8951850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10906995, \"displayName\": \"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\", \"inferredFrom\": [8951850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8951850\", \"stIdVersion\": \"R-DME-8951850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10819022, \"displayName\": \"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\", \"inferredFrom\": [8951850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-8951850\", \"stIdVersion\": \"R-GGA-8951850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10547012, \"displayName\": \"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\", \"inferredFrom\": [8951850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8951850\", \"stIdVersion\": \"R-SSC-8951850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10319787, \"displayName\": \"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\", \"inferredFrom\": [8951850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8951850\", \"stIdVersion\": \"R-CFA-8951850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10211663, \"displayName\": \"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\", \"inferredFrom\": [8951850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8951850\", \"stIdVersion\": \"R-RNO-8951850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10088565, \"displayName\": \"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\", \"inferredFrom\": [8951850], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TSPO:BZRAP1 transports CHOL from outer mitochondrial membrane to inner mitochondrial membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8951850\", \"stIdVersion\": \"R-MMU-8951850.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193156, \"displayName\": \"CHOL [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CHOL\", \"cholesterol\"], \"producedByEvent\": [8951850], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193156\", \"stIdVersion\": \"R-ALL-193156.5\"}], \"releaseDate\": \"2017-03-27\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8951850\", \"stIdVersion\": \"R-HSA-8951850.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8951849, \"displayName\": \"The 18 kDa translocator protein (TSPO), originally identifie...\", \"schemaClass\": \"Summation\", \"text\": \"The 18 kDa translocator protein (TSPO), originally identified as a peripheral-type benzodiazepine receptor (BZRP), is a drug- and cholesterol-binding protein found at particularly high levels in steroid synthesising cells such as those of the adrenal glands and testes (Lin et al. 1993, De Souza et al. 1985). TSPO is localised to the outer mitochondrial membrane (Anholt et al. 1986) and could facilitate the transport of cholesterol (CHOL) to the inner mitochondrial membrane where the first step of steroidogenesis occurs (review - Papadopoulos et al. 2015). The peripheral-type benzodiazepine receptor-associated protein 1 (TSPOAP1, aka BZRAP1, PRAX1) is a cytosolic protein that specifically interacts with TSPO (Galiegue et al. 1993) but its role is undetermined.\"}]}" ;
