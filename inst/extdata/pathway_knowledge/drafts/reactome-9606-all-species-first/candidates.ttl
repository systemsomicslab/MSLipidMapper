<https://reactome.org/content/detail/R-HSA-8957389> a mslm:LipidReaction ;
    rdfs:label "RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA" ;
    mslm:curationStatus mslm:Draft ;
