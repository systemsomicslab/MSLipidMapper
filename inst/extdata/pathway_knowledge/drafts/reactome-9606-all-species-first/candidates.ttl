    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [163595], \"className\": \"CatalystActivity\", \"dbId\": 163500, \"displayName\": \"monoacylglycerol lipase activity of MGLL [lipid droplet]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005811\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13977, \"definition\": \"An intracellular non-membrane-bounded organelle comprising a matrix of coalesced lipids surrounded by a phospholipid monolayer. May include associated proteins.\", \"displayName\": \"lipid droplet\", \"name\": \"lipid droplet\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005811\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9958491, \"displayName\": \"RHEA:44689\", \"identifier\": \"44689\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/44689\"}], \"dbId\": 163595, \"displayName\": \"2-acylglycerol + H2O -> glycerol + fatty acid\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [163595], \"dbId\": 163580, \"displayName\": \"2-acylglycerol [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2-acylglycerol\", \"2-monoglyceride\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-163580\", \"stIdVersion\": \"R-ALL-163580.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [163595], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-acylglycerol + H2O -> glycerol + fatty acid\", \"a 2-acylglycerol + H2O => glycerol + a fatty acid + H(+)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 76116, \"displayName\": \"Glycerol [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Glycerol\"], \"producedByEvent\": [163595], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76116\", \"stIdVersion\": \"R-ALL-76116.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 8876730, \"displayName\": \"LCFA(-) [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [163595], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8876730\", \"stIdVersion\": \"R-ALL-8876730.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [163595], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 163402, \"displayName\": \"diacylglycerol + H2O -> 2-acylglycerol + fatty acid\", \"followingEvent\": [163595], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"diacylglycerol + H2O -> 2-acylglycerol + fatty acid\", \"a 1,2-diacyl-sn-glycerol + H2O => a 2-acylglycerol + a fatty acid + H(+)\"], \"releaseDate\": \"2005-06-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163402\", \"stIdVersion\": \"R-HSA-163402.5\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2005-06-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163595\", \"stIdVersion\": \"R-HSA-163595.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 163458, \"displayName\": \"Rat monoacylglycerol lipase (MGLL) catalyzes the hydrolysis ...\", \"schemaClass\": \"Summation\", \"text\": \"Rat monoacylglycerol lipase (MGLL) catalyzes the hydrolysis of 2-acylglycerol to yield glycerol + fatty acid (Tornqvist and Belfrage 1976; Fredrikson et al. 1986). Localization of the enzyme to lipid particles is plausible, given its low solubility and its involvement in acylglycerol metabolism, but this localization has not been directly experimentally verified. The human reaction is inferred from the well-studied rat one.\"}]}" ;
