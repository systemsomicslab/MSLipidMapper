    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9024973], \"className\": \"CatalystActivity\", \"dbId\": 9025026, \"displayName\": \"epoxide hydrolase activity of Epoxide hydrolase [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9024973, \"displayName\": \"Epoxide hydrolase hydrolyses 13(S),14(S)-epoxy-DHA to MaR1\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9024973], \"dbId\": 9025001, \"displayName\": \"13(S),14(S)-epoxy-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"13(S),14(S)-epoxy-DHA\", \"(13S,14S)-epoxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate\", \"(13S,14S)-epoxy-DHA(1-)\", \"(13S,14S)-epoxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9025001\", \"stIdVersion\": \"R-ALL-9025001.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9024973], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9024980, \"displayName\": \"The novel 13S,14S-epoxy-maresin is converted by human macrophages to maresin 1 (MaR1), inhibits leukotriene A4 hydrolase (LTA4H), and shifts macrophage phenotype\", \"journal\": \"FASEB J.\", \"pages\": \"2573-83\", \"pubMedIdentifier\": 23504711, \"schemaClass\": \"LiteratureReference\", \"title\": \"The novel 13S,14S-epoxy-maresin is converted by human macrophages to maresin 1 (MaR1), inhibits leukotriene A4 hydrolase (LTA4H), and shifts macrophage phenotype\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/23504711\", \"volume\": 27, \"year\": 2013}, {\"className\": \"LiteratureReference\", \"dbId\": 9024988, \"displayName\": \"Maresins: novel macrophage mediators with potent antiinflammatory and proresolving actions\", \"journal\": \"J. Exp. Med.\", \"pages\": \"15-23\", \"pubMedIdentifier\": 19103881, \"schemaClass\": \"LiteratureReference\", \"title\": \"Maresins: novel macrophage mediators with potent antiinflammatory and proresolving actions\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/19103881\", \"volume\": 206, \"year\": 2009}, {\"className\": \"LiteratureReference\", \"dbId\": 9025004, \"displayName\": \"The pro-resolving lipid mediator maresin 1 (MaR1) attenuates inflammatory signaling pathways in vascular smooth muscle and endothelial cells\", \"journal\": \"PLoS ONE\", \"pages\": \"e113480\", \"pubMedIdentifier\": 25409514, \"schemaClass\": \"LiteratureReference\", \"title\": \"The pro-resolving lipid mediator maresin 1 (MaR1) attenuates inflammatory signaling pathways in vascular smooth muscle and endothelial cells\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25409514\", \"volume\": 9, \"year\": 2014}, {\"className\": \"LiteratureReference\", \"dbId\": 9024984, \"displayName\": \"Macrophage proresolving mediator maresin 1 stimulates tissue regeneration and controls pain\", \"journal\": \"FASEB J.\", \"pages\": \"1755-65\", \"pubMedIdentifier\": 22253477, \"schemaClass\": \"LiteratureReference\", \"title\": \"Macrophage proresolving mediator maresin 1 stimulates tissue regeneration and controls pain\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/22253477\", \"volume\": 26, \"year\": 2012}, {\"className\": \"LiteratureReference\", \"dbId\": 9024996, \"displayName\": \"Maresin biosynthesis and identification of maresin 2, a new anti-inflammatory and pro-resolving mediator from human macrophages\", \"journal\": \"PLoS ONE\", \"pages\": \"e102362\", \"pubMedIdentifier\": 25036362, \"schemaClass\": \"LiteratureReference\", \"title\": \"Maresin biosynthesis and identification of maresin 2, a new anti-inflammatory and pro-resolving mediator from human macrophages\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25036362\", \"volume\": 9, \"year\": 2014}], \"maxDepth\": 1, \"name\": [\"Epoxide hydrolase hydrolyses 13(S),14(S)-epoxy-DHA to MaR1\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9025000, \"displayName\": \"MaR1 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MaR1\", \"(7R,14S)-dihydroxy-(4Z,8E,10E,12Z,16Z,19Z)-docosahexaenoic acid\", \"maresin 1\", \"7R,14S-dihydroxy-4Z,8E,10E,12Z,16Z,19Z-docosahexaenoic acid\"], \"producedByEvent\": [9024973], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9025000\", \"stIdVersion\": \"R-ALL-9025000.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9024983, \"displayName\": \"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DHA to 13(S),14(S)-epoxy-DHA\", \"followingEvent\": [9024973], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DHA to 13(S),14(S)-epoxy-DHA\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9024983\", \"stIdVersion\": \"R-HSA-9024983.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9024973\", \"stIdVersion\": \"R-HSA-9024973.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9025002, \"displayName\": \"Maresin 1 (MaR1, 7(R),14(S)-dihydroxy-docosahexaenoic acid) ...\", \"schemaClass\": \"Summation\", \"text\": \"Maresin 1 (MaR1, 7(R),14(S)-dihydroxy-docosahexaenoic acid) is the first identified maresin. It is formed by hydrolysis of 13(R),14(S)-epoxy-docosahexaenoic acid (13(R),14(S)-epoxy-DHA) by an unknown epoxide hydrolase (Serhan et al. 2009). MaR1 displays potent anti-inflammatory and pro-resolving actions (Serhan et al. 2012, Chatterjee et al. 2014). MaR1 was found to inhibit proinflammatory mediator production by inhibiting LTA4 hydrolase, thereby shifting macrophage phenotype from proinflammatory mediator to proresolving mediator production (Dalli et al. 2013).<br><br>A novel double dioxygenation product can also be formed by non-enzymatic hydrolysis of 13(R),154(S)-epoxy-DHA, namely 7(S),14(S)-dihydroxy-docosahexaenoic acid (7-epi-MaR1).  Although 7-epi-MaR1 possesses some bioactivity, it displays lower anti-inflammatory and pro-resolving actions than MaR1 (Serhan et al. 2009).\"}]}" ;
