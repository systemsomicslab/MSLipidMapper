splayName\": \"bHEXA,bHEXS hydrolyze GM2A:SM2\", \"inferredFrom\": [9840884], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"bHEXA,bHEXS hydrolyze GM2A:SM2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-9840884\", \"stIdVersion\": \"R-GGA-9840884.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10558316, \"displayName\": \"bHEXA,bHEXS hydrolyze GM2A:SM2\", \"inferredFrom\": [9840884], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"bHEXA,bHEXS hydrolyze GM2A:SM2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9840884\", \"stIdVersion\": \"R-SSC-9840884.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10445061, \"displayName\": \"bHEXA,bHEXS hydrolyze GM2A:SM2\", \"inferredFrom\": [9840884], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"bHEXA,bHEXS hydrolyze GM2A:SM2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9840884\", \"stIdVersion\": \"R-BTA-9840884.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10330917, \"displayName\": \"bHEXA,bHEXS hydrolyze GM2A:SM2\", \"inferredFrom\": [9840884], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"bHEXA,bHEXS hydrolyze GM2A:SM2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9840884\", \"stIdVersion\": \"R-CFA-9840884.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605658, \"displayName\": \"GalNAc [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GalNAc\", \"N-acetyl-D-galactosamine\", \"N-acetylgalactosamine\"], \"producedByEvent\": [9840884], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605658\", \"stIdVersion\": \"R-ALL-1605658.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 9840879, \"displayName\": \"SM3 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SM3\", \"beta-D-3-sulfogalactosyl-(1->4)-beta-D-glucosyl-(1<->1')-ceramide(1-)\"], \"producedByEvent\": [9840884], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9840879\", \"stIdVersion\": \"R-ALL-9840879.1\"}, {\"className\": \"Protein\", \"dbId\": 1605614, \"displayName\": \"GM2A(32-193) [lysosomal lumen]\", \"endCoordinate\": 193, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GM2A(32-193)\", \"GM2A\", \"Ganglioside GM2 activator\", \"SAP3_HUMAN\"], \"producedByEvent\": [9840884], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605614\", \"stIdVersion\": \"R-HSA-1605614.1\", \"startCoordinate\": 32}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1605717, \"displayName\": \"GM2A binds and mobilizes ligands\", \"followingEvent\": [9840884], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GM2A binds and mobilizes ligands\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605717\", \"stIdVersion\": \"R-HSA-1605717.3\"}], \"regulatedBy\": [{\"className\": \"Requirement\", \"dbId\": 9840876, \"displayName\": \"Requirement by 'BMP [multivesicular body, internal vesicle membrane]'\", \"regulatedEntity\": [9840884], \"schemaClass\": \"Requirement\"}], \"regulationReference\": [{\"className\": \"RegulationReference\", \"dbId\": 9840877, \"displayName\": \"Requirement by 'BMP [multivesicular body, internal vesicle membrane]' Physiological substrates for human lysosomal beta -hexosaminidase S\", \"schemaClass\": \"RegulationReference\"}], \"releaseDate\": \"2023-09-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840884\", \"stIdVersion\": \"R-HSA-9840884.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9840887, \"displayName\": \"The beta-hexosaminidase isoforms A (bHEXA) and S (bHEXS) con...\", \"schemaClass\": \"Summation\", \"text\": \"The beta-hexosaminidase isoforms A (bHEXA) and S (bHEXS) contain an alpha subunit (HEXA) that cleaves negatively charged substrates. Each of bHEXA and bHEXS hydrolyze the charged sulfated glycosphingolipid SM2 to form SM3. Under lysosomal conditions the reaction takes place only in the presence of both BMP (lysobisphosphatidate) and GM2AP (Hepbildikler et al., 2002).<br/>There are three forms of hexosaminidase complexes: hexosaminidase A, B and S. The A form is a tetramer of the subunits alpha (HEXA, beta A) and beta (HEXB, beta B) dimers. The B form is a tetramer of two beta subunit dimers, and the S form a tetramer of two HEXA dimers.\"}]}" ;
