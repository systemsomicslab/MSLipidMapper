    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [1602399], \"className\": \"CatalystActivity\", \"dbId\": 1602379, \"displayName\": \"A2-type glycerophospholipase activity of PLB1 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}, {\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 1602399, \"displayName\": \"PC is hydrolyzed to 1-acyl LPC by PLB1\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1602399], \"dbId\": 429802, \"displayName\": \"PC [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PC\", \"1,2-diacyl-sn-glycero-3-phosphocholine\", \"Phosphatidyl choline\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-429802\", \"stIdVersion\": \"R-ALL-429802.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [1602399], \"dbId\": 109276, \"displayName\": \"H2O [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109276\", \"stIdVersion\": \"R-ALL-109276.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1602373, \"displayName\": \"Human epidermis is a novel site of phospholipase B expression\", \"journal\": \"Biochem Biophys Res Commun\", \"pages\": \"362-9\", \"pubMedIdentifier\": 12150957, \"schemaClass\": \"LiteratureReference\", \"title\": \"Human epidermis is a novel site of phospholipase B expression\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12150957\", \"volume\": 295, \"year\": 2002}, {\"className\": \"LiteratureReference\", \"dbId\": 1602395, \"displayName\": \"Substrate specificity of phospholipase B from guinea pig intestine. A glycerol ester lipase with broad specificity\", \"journal\": \"J Biol Chem\", \"pages\": \"13418-24\", \"pubMedIdentifier\": 1618844, \"schemaClass\": \"LiteratureReference\", \"title\": \"Substrate specificity of phospholipase B from guinea pig intestine. A glycerol ester lipase with broad specificity\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/1618844\", \"volume\": 267, \"year\": 1992}], \"maxDepth\": 1, \"name\": [\"PC is hydrolyzed to 1-acyl LPC by PLB1\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10957867, \"displayName\": \"PC is hydrolyzed to 1-acyl LPC by PLB1\", \"inferredFrom\": [1602399], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PC is hydrolyzed to 1-acyl LPC by PLB1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-1602399\", \"stIdVersion\": \"R-CEL-1602399.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10870967, \"displayName\": \"PC is hydrolyzed to 1-acyl LPC by PLB1\", \"inferredFr