    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8848247], \"className\": \"CatalystActivity\", \"dbId\": 9917327, \"displayName\": \"fatty-acyl-CoA binding activity of ACBD5,(ACBD4) [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005778\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17947, \"definition\": \"The lipid bilayer surrounding a peroxisome.\", \"displayName\": \"peroxisomal membrane\", \"name\": \"peroxisomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005778\"}, {\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 8848247, \"displayName\": \"ACBD4,5 bind MCFA-CoA and LCFA-CoA\", \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [8848247], \"dbId\": 8848234, \"displayName\": \"ACBD5,(ACBD4) [peroxisomal membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"ACBD5,(ACBD4)\"], \"schemaClass\": \"CandidateSet\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8848234\", \"stIdVersion\": \"R-HSA-8848234.2\"}, {\"className\": \"Set\", \"consumedByEvent\": [8848247], \"dbId\": 5690520, \"displayName\": \"MCFA-CoA, LCFA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"MCFA-CoA, LCFA-CoA\", \"medium/long chain fatty acyl-CoA\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-5690520\", \"stIdVersion\": \"R-ALL-5690520.2\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8848295, \"displayName\": \"Peroxisomal Atg37 binds Atg30 or palmitoyl-CoA to regulate phagophore formation during pexophagy\", \"journal\": \"J. Cell Biol.\", \"pages\": \"541-57\", \"pubMedIdentifier\": 24535825, \"schemaClass\": \"LiteratureReference\", \"title\": \"Peroxisomal Atg37 binds Atg30 or palmitoyl-CoA to regulate phagophore formation during pexophagy\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/24535825\", \"volume\": 204, \"year\": 2014}, {\"className\": \"LiteratureReference\", \"dbId\": 8848299, \"displayName\": \"Atg37 regulates the assembly of the pexophagic receptor protein complex\", \"journal\": \"Autophagy\", \"pages\": \"1348-9\", \"pubMedIdentifier\": 24905344, \"schemaClass\": \"LiteratureReference\", \"title\": \"Atg37 regulates the assembly of the pexophagic receptor protein complex\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/24905344\", \"volume\": 10, \"year\": 2014}], \"maxDepth\": 1, \"name\": [\"ACBD4,5 bind MCFA-CoA and LCFA-CoA\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10987584, \"displayName\": \"ACBD4,5 bind MCFA-CoA and LCFA-CoA\", \"inferredFrom\": [8848247], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD4,5 bind MCFA-CoA and LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-8848247\", \"stIdVersion\": \"R-CEL-8848247.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10901242, \"displayName\": \"ACBD4,5 bind MCFA-CoA and LCFA-CoA\", \"inferredFrom\": [8848247], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD4,5 bind MCFA-CoA and LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8848247\", \"stIdVersion\": \"R-DME-8848247.1\"}, {\"cat