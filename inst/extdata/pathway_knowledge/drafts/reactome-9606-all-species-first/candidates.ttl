10311101, \"displayName\": \"EHHADH hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"inferredFrom\": [6809263], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"EHHADH hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"(2E)-hexacosenoyl-CoA + H2O => (3R)-hydroxyhexacosanoyl-CoA\", \"trans-2,3-dehydrohexacosanoyl-CoA + H2O => 3-hydroxyhexacosanoyl-CoA (EHHADH)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-6809263\", \"stIdVersion\": \"R-CFA-6809263.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10078003, \"displayName\": \"EHHADH hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"inferredFrom\": [6809263], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"EHHADH hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"(2E)-hexacosenoyl-CoA + H2O => (3R)-hydroxyhexacosanoyl-CoA\", \"trans-2,3-dehydrohexacosanoyl-CoA + H2O => 3-hydroxyhexacosanoyl-CoA (EHHADH)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6809263\", \"stIdVersion\": \"R-MMU-6809263.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 390248, \"displayName\": \"3-hydroxyhexacosanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3-hydroxyhexacosanoyl-CoA\", \"(R)-3-hydroxyhexacosanoyl-CoA(4-)\"], \"producedByEvent\": [6809263], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390248\", \"stIdVersion\": \"R-ALL-390248.3\"}], \"releaseDate\": \"2016-03-23\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6809263\", \"stIdVersion\": \"R-HSA-6809263.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6809270, \"displayName\": \"Peroxisomal EHHADH catalyzes the reaction of trans-2,3-dehyd...\", \"schemaClass\": \"Summation\", \"text\": \"Peroxisomal EHHADH catalyzes the reaction of trans-2,3-dehydrohexacosanoyl-CoA and H2O to form 3-hydroxyhexacosanoyl-CoA. The enzyme is bifunctional - an aminoterminal domain catalyzes the dehydrogenation of a variety of 3-hydroxyacyl-CoA's and a carboxyterminal domain catalyzes the hydration of a variety of trans-2,3-dehydroacyl-CoA's, the reaction annotated here. The properties of the human enzyme are inferred from studies of its mouse and rat homologues and from enzymatic stdies of mutant yeast cells expressing the cloned human enzyme (Chen et al. 1991, Ferdinandusse et al. 2004; Houten et al. 2012; Lalwani et al. 1981; Osumi & Hashimoto 1979). The enzyme can also act on fatty dicarboxylic acids (not annotated here) (Houten et al, 2012).\"}]}" ;
