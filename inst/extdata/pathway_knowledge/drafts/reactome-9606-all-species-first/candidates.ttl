    mslm:equation "15R-HETE [cytosol] + O2 [cytosol] => 15epi-LXA4/B4 [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [2161907], \"className\": \"CatalystActivity\", \"dbId\": 2161852, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen, incorporation of two atoms of oxygen of ALOX5:ALOX5AP:LTC4S [nuclear envelope]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005635\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13231, \"definition\": \"The double lipid bilayer that encloses the nucleus, separating its contents from the cytoplasm. It consists of an inner and outer nuclear membrane, with an intermembrane space (20-40 nm wide, also called the perinuclear space) between them. The envelope is supported by the nuclear lamina and contains nuclear pore complexes, which regulate molecular transport.\", \"displayName\": \"nuclear envelope\", \"name\": \"nuclear envelope\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005635\"}], \"dbId\": 2161907, \"displayName\": \"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161907], \"dbId\": 2142738, \"displayName\": \"15R-HETE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"15R-HETE\", \"15(R)-HETE(1-)\", \"15(R)-HETE\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142738\", \"stIdVersion\": \"R-ALL-2142738.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161907], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 2161778, \"displayName\": \"Aspirin triggers previously undescribed bioactive eicosanoids by human endothelial cell-leukocyte interactions\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"9475-9\", \"pubMedIdentifier\": 7568157, \"schemaClass\": \"LiteratureReference\", \"title\": \"Aspirin triggers previously undescribed bioactive eicosanoids by human endothelial cell-leukocyte interactions\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/7568157\", \"volume\": 92, \"year\": 1995}], \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11027064, \"displayName\": \"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\", \"inferredFrom\": [2161907], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-2161907\", \"stIdVersion\": \"R-DDI-2161907.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10787390, \"displayName\": \"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\", \"inferredFrom\": [2161907], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-2161907\", \"stIdVersion\": \"R-GGA-2161907.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10696269, \"displayName\": \"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\", \"inferredFrom\": [2161907], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-2161907\", \"stIdVersion\": \"R-XTR-2161907.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10609666, \"displayName\": \"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\", \"inferredFrom\": [2161907], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-2161907\", \"stIdVersion\": \"R-DRE-2161907.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10508545, \"displayName\": \"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\", \"inferredFrom\": [2161907], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-2161907\", \"stIdVersion\": \"R-SSC-2161907.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10393538, \"displayName\": \"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\", \"inferredFrom\": [2161907], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-2161907\", \"stIdVersion\": \"R-BTA-2161907.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10170456, \"displayName\": \"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\", \"inferredFrom\": [2161907], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-2161907\", \"stIdVersion\": \"R-RNO-2161907.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10048551, \"displayName\": \"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\", \"inferredFrom\": [2161907], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 15R-HETE to 15epi-LXA4/B4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2161907\", \"stIdVersion\": \"R-MMU-2161907.1\"}], \"output\": [{\"className\": \"Set\", \"dbId\": 2161609, \"displayName\": \"15epi-LXA4/B4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"15epi-LXA4/B4\"], \"producedByEvent\": [2161907], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-2161609\", \"stIdVersion\": \"R-ALL-2161609.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2161951, \"displayName\": \"Arachidonate is oxidised to 15R-HETE by Acetyl-PTGS2\", \"followingEvent\": [2161907], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Arachidonate is oxidised to 15R-HETE by Acetyl-PTGS2\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate + O2 + reduced (NADPH--hemoprotein reductase) => (15R)-hydroxy-(5Z,8Z,11Z,13E)-eicosatetraenoate + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\"], \"releaseDate\": \"2012-12-04\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161951\", \"stIdVersion\": \"R-HSA-2161951.4\"}], \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161907\", \"stIdVersion\": \"R-HSA-2161907.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2162012, \"displayName\": \"Arachidonate 5-lipoxygenase (ALOX5) converts 15R-hydro-eicos...\", \"schemaClass\": \"Summation\", \"text\": \"Arachidonate 5-lipoxygenase (ALOX5) converts 15R-hydro-eicosatetraenoic acid (15R-HETE) to the epi-lipoxins, 15epi-lipoxin A4 (15epi-LXA4) and 15epi-lipoxin B4 (15epi-LXB4) (Claria & Serhan 1995).  These epi-lipoxins have altered configuration at the C-15 hydroxyl but similar biological potency.\"}]}" ;
