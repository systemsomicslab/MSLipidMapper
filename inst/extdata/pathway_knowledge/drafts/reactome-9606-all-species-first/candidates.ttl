"name\": [\"PNPLA6 hydrolyzes LysoPtdCho\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-6814254\", \"stIdVersion\": \"R-CFA-6814254.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10202837, \"displayName\": \"PNPLA6 hydrolyzes LysoPtdCho\", \"inferredFrom\": [6814254], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PNPLA6 hydrolyzes LysoPtdCho\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-6814254\", \"stIdVersion\": \"R-RNO-6814254.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10080082, \"displayName\": \"PNPLA6 hydrolyzes LysoPtdCho\", \"inferredFrom\": [6814254], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PNPLA6 hydrolyzes LysoPtdCho\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6814254\", \"stIdVersion\": \"R-MMU-6814254.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1498750, \"displayName\": \"GPCho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GPCho\", \"choline alfoscerate\", \"GroPCho\", \"Glycerol 3-phosphocholine\", \"glycerophosphocholine\"], \"producedByEvent\": [6814254], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498750\", \"stIdVersion\": \"R-ALL-1498750.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524021, \"displayName\": \"LCFA(-) [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [6814254], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524021\", \"stIdVersion\": \"R-ALL-1524021.3\"}], \"releaseDate\": \"2016-03-23\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6814254\", \"stIdVersion\": \"R-HSA-6814254.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6814245, \"displayName\": \"PNPLA6 (Patatin-like phospholipase domain-containing protein...\", \"schemaClass\": \"Summation\", \"text\": \"PNPLA6 (Patatin-like phospholipase domain-containing protein 6, also known as NTE - Neuropathy target esterase) associated with the endoplasmic reticulum membrane catalyzes the hydrolysis of LysoPtcCho (lysophosphatidylcholine) to GPCho (glycerophosphocholine) and LCFA (long chain fatty acid). The subcellular location of the enzyme and its specificity have been established through studies of recombinant human enzyme (Li et al. 2003; Zaccheo et al. 2004). Additional studies in a mouse system indicate that enzyme abundance and activity are regulated by osmotic stress in the kidney (Gallazzini et al. 2006).\"}]}" ;
