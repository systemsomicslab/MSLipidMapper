, \"maxDepth\": 1, \"name\": [\"ACBD4,5 bind MCFA-CoA and LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8848247\", \"stIdVersion\": \"R-BTA-8848247.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10312556, \"displayName\": \"ACBD4,5 bind MCFA-CoA and LCFA-CoA\", \"inferredFrom\": [8848247], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD4,5 bind MCFA-CoA and LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8848247\", \"stIdVersion\": \"R-CFA-8848247.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10203477, \"displayName\": \"ACBD4,5 bind MCFA-CoA and LCFA-CoA\", \"inferredFrom\": [8848247], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD4,5 bind MCFA-CoA and LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8848247\", \"stIdVersion\": \"R-RNO-8848247.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10080698, \"displayName\": \"ACBD4,5 bind MCFA-CoA and LCFA-CoA\", \"inferredFrom\": [8848247], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD4,5 bind MCFA-CoA and LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8848247\", \"stIdVersion\": \"R-MMU-8848247.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 8866017, \"displayName\": \"ACBD4,5:LCFA-CoA, MCFA-CoA [peroxisomal membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"ACBD4,5:LCFA-CoA, MCFA-CoA\"], \"producedByEvent\": [8848247], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8866017\", \"stIdVersion\": \"R-HSA-8866017.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-06-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8848247\", \"stIdVersion\": \"R-HSA-8848247.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8848300, \"displayName\": \"The selective autophagy of peroxisomes (pexophagy) is contro...\", \"schemaClass\": \"Summation\", \"text\": \"The selective autophagy of peroxisomes (pexophagy) is controlled by autophagy receptors through the assembly of a receptor protein complex (RPC). These receptors can recruit specific proteins required for pexophagy to occur. The human orthologue of the fungal acyl-CoA-binding protein Atg37, ACBD5, is a positive regulator of the pexophagic RPC process. Palmitoyl-CoA competes with autophagy receptors thus may affect the pexophagic RPC process. Acyl-CoA-binding domain-containing proteins 4 and 5 (ACBD4,5) are peroxisomal membrane-bound proteins and thought to bind medium- and long-chain acyl-CoA esters (MCFA-CoA, LCFA-CoA) (Nazarko et al. 2014, Nazarko 2014). The function of ACBD4 has not yet been determined.\"}]}" ;
