<https://reactome.org/content/detail/R-HSA-193519> a mslm:LipidReaction ;
    rdfs:label "DHCA is translocated from the mitochondrial matrix to the cytosol" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "DHCA [mitochondrial matrix] => DHCA [cytosol]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 193519, \"displayName\": \"DHCA is translocated from the mitochondrial matrix to the cytosol\", \"followingEvent\": [193424], \"goBiologicalProcess\": {\"accession\": \"0170037\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 9910496, \"definition\": \"The directed movement of substances from the mitochondrion to the cytosol.\", \"displayName\": \"export from the mitochondrion\", \"name\": \"export from the mitochondrion\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0170037\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193519], \"dbId\": 193440, \"displayName\": \"DHCA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHCA\", \"3alpha,7alpha-dihydroxy-5beta-cholestan-26-oic acid\", \"3alpha,7alpha-dihydroxy-5beta-cholestanoate\", \"3alpha,7alpha-Dihydroxy-5beta-cholestanate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193440\", \"stIdVersion\": \"R-ALL-193440.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 192080, \"displayName\": \"The enzymes, regulation, and genetics of bile acid synthesis\", \"journal\": \"Annu Rev Biochem\", \"pages\": \"137-74\", \"pubMedIdentifier\": 12543708, \"schemaClass\": \"LiteratureReference\", \"title\": \"The enzymes, regulation, and genetics of bile acid synthesis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12543708\", \"volume\": 72, \"year\": 2003}], \"maxDepth\": 1, \"name\": [\"DHCA is translocated from the mitochondrial matrix to the cytosol\", \"DHCA [mitochondrial matrix] => DHCA [cytosol]\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193505, \"displayName\": \"DHCA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHCA\", \"3alpha,7alpha-dihydroxy-5beta-cholestan-26-oic acid\", \"3alpha,7alpha-dihydroxy-5beta-cholestanoate\", \"3alpha,7alpha-Dihydroxy-5beta-cholestanate\"], \"producedByEvent\": [193519], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193505\", \"stIdVersion\": \"R-ALL-193505.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193460, \"displayName\": \"3alpha, 7alpha-dihydroxy-5beta-cholestan-26-al is oxidized to 3alpha, 7alpha-dihydroxy-5beta-cholestanoate (DHCA)\", \"followingEvent\": [193519], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"3alpha, 7alpha-dihydroxy-5beta-cholestan-26-al is oxidized to 3alpha, 7alpha-dihydroxy-5beta-cholestanoate (DHCA)\", \"3alpha, 7alpha-dihydroxy-5beta-cholestan-26-al + NADPH + H+ + O2 => 3alpha, 7alpha-dihydroxy-5beta-cholestanoate (DHCA) + NADP+ + H2O\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193460\", \"stIdVersion\": \"R-HSA-193460.2\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193519\", \"stIdVersion\": \"R-HSA-193519.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193373, \"displayName\": \"DHCA (3alpha, 7alpha-dihydroxy-5beta-cholestanoate) is trans...\", \"schemaClass\": \"Summation\", \"text\": \"DHCA (3alpha, 7alpha-dihydroxy-5beta-cholestanoate) is translocated from the mitochondrial matrix to the cytosol. The transporter that mediates its passage across the inner mitochondrial membrane has not been identified. In particular, despite the structural and functional similarities between DHCA and long chain fatty acids, searches for carnitine - DHCA have failed (Russell 2003). VLCS (SLC27A2), one of the enzymes that catalyzes CoA conjugation of DHCA, may also be present in peroxisomes, and Mihalik et al. (2002) have hypothesized that DHCA could be translocated unchanged from the mitochondrial matrix to the peroxisomal matrix and undergo conjugation there.\"}]}" ;
