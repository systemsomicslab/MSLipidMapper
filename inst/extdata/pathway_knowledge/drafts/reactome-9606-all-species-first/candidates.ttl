    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [159431], \"className\": \"CatalystActivity\", \"dbId\": 159410, \"displayName\": \"acyltransferase activity of BAAT [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 159431, \"displayName\": \"Cytosolic chenodeoxycholoyl-CoA or choloyl-CoA are conjugated with glycine or taurine\", \"goBiologicalProcess\": {\"accession\": \"0008206\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 12647, \"definition\": \"The chemical reactions and pathways involving bile acids, a group of steroid carboxylic acids occurring in bile, where they are present as the sodium salts of their amides with glycine or taurine.\", \"displayName\": \"bile acid metabolic process\", \"name\": \"bile acid metabolic process\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0008206\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [159431], \"dbId\": 194073, \"displayName\": \"choloyl-CoA; chenodeoxycholoyl-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"choloyl-CoA; chenodeoxycholoyl-CoA\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-194073\", \"stIdVersion\": \"R-ALL-194073.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [159431], \"dbId\": 194069, \"displayName\": \"Gly, TAU [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Gly, TAU\", \"glycine; taurine\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-