<https://reactome.org/content/detail/R-HSA-5690066> a mslm:LipidReaction ;
    rdfs:label "ACOT2,9,THEM4,5 hydrolyse MCFA-CoA, LCFA-CoA" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
