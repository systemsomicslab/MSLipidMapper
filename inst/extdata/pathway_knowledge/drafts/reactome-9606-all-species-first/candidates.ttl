Id\": \"R-MMU-193961\", \"stIdVersion\": \"R-MMU-193961.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193092, \"displayName\": \"17aHPROG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17aHPROG\", \"17alpha-hydroxyprogesterone\"], \"producedByEvent\": [193961], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193092\", \"stIdVersion\": \"R-ALL-193092.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 196372, \"displayName\": \"17-Hydroxypregnenolone is dehydrogenated to form pregn-5-ene-3,20-dione-17-ol\", \"followingEvent\": [193961], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"17-Hydroxypregnenolone is dehydrogenated to form pregn-5-ene-3,20-dione-17-ol\", \"17-hydroxypregnenolone + NAD+ => pregn-5-ene-3,20-dione-17-ol + NADH + H+\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-196372\", \"stIdVersion\": \"R-HSA-196372.2\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193961\", \"stIdVersion\": \"R-HSA-193961.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 196364, \"displayName\": \"Pregn-5-ene-3,20-dione-17-ol isomerizes to 17-hydroxyprogest...\", \"schemaClass\": \"Summation\", \"text\": \"Pregn-5-ene-3,20-dione-17-ol isomerizes to 17-hydroxyprogesterone. This reaction is catalyzed by the isomerase activity of 3 beta-HSD, associated with the endoplasmic reticulum membrane. The active form of the enzyme is a homodimer. The enzyme occurs in two isoforms that are similar in their biochemical properties but differ in their tissue expression: type I (HSD3B1) is found in placenta and skin, while type II (HSD3B2) is found in the adrenal glands and gonads.\"}]}" ;
