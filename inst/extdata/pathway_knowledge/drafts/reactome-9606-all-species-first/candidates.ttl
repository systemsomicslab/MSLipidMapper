    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [193997], \"className\": \"CatalystActivity\", \"dbId\": 193999, \"displayName\": \"steroid 11-beta-monooxygenase activity of Cytochrome P450 (CYP11B1 based) [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9907735, \"displayName\": \"RHEA:46101\", \"identifier\": \"46101\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/46101\"}], \"dbId\": 193997, \"displayName\": \"CYP11B1 oxidises 11DCORT\", \"followingEvent\": [194036], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193997], \"dbId\": 193998, \"displayName\": \"11DCORT [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"11DCORT\", \"11-deoxycortisol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass