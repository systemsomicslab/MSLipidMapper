epth\": 1, \"name\": [\"5,6-EET is hydrolysed to 5,6-DHET by EPHX2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-2161961\", \"stIdVersion\": \"R-RNO-2161961.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10048596, \"displayName\": \"5,6-EET is hydrolysed to 5,6-DHET by EPHX2\", \"inferredFrom\": [2161961], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"5,6-EET is hydrolysed to 5,6-DHET by EPHX2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2161961\", \"stIdVersion\": \"R-MMU-2161961.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142682, \"displayName\": \"5,6-DHET [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5,6-DHET\"], \"producedByEvent\": [2161961], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142682\", \"stIdVersion\": \"R-ALL-2142682.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2161890, \"displayName\": \"Arachidonate is epoxidated to 5,6-EET by CYP(4)\", \"followingEvent\": [2161961], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Arachidonate is epoxidated to 5,6-EET by CYP(4)\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate + O2 + reduced (NADPH--hemoprotein reductase) => 5,6-epoxy-(8Z,11Z,14Z)-eicosatrienoate + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\"], \"releaseDate\": \"2012-12-04\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161890\", \"stIdVersion\": \"R-HSA-2161890.4\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \