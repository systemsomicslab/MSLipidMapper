rl\": \"http://www.ncbi.nlm.nih.gov/pubmed/12709426\", \"volume\": 278, \"year\": 2003}, {\"className\": \"LiteratureReference\", \"dbId\": 2161774, \"displayName\": \"Metabolic transformations of leukotriene B4 in primary cultures of human hepatocytes\", \"journal\": \"J Pharmacol Exp Ther\", \"pages\": \"326-34\", \"pubMedIdentifier\": 9862787, \"schemaClass\": \"LiteratureReference\", \"title\": \"Metabolic transformations of leukotriene B4 in primary cultures of human hepatocytes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9862787\", \"volume\": 288, \"year\": 1999}], \"maxDepth\": 1, \"name\": [\"20cooh-LTB4 is converted to 18cooh-LTB4\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142676, \"displayName\": \"18cooh-LTB4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"18cooh-LTB4\", \"18-hydroxy-18-oxo-dinorleukotriene B4\"], \"producedByEvent\": [2161790], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142676\", \"stIdVersion\": \"R-ALL-2142676.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2161792, \"displayName\": \"20cho-LTB4 is oxidised to 20cooh-LTB4 by CYP4F2/4F3\", \"followingEvent\": [2161790], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"20cho-LTB4 is oxidised to 20cooh-LTB4 by CYP4F2/4F3\", \"20-oxo-leukotriene B4 + O2 + reduced (NADPH--hemoprotein reductase) => 20-carboxy-leukotriene B4 + 2 H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\"], \"releaseDate\": \"2012-12-04\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161792\", \"stIdVersion\": \"R-HSA-2161792.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2161979, \"displayName\": \"20cho-LTB4 is oxidised to 20cooh-LTB4 by ALDH\", \"followingEvent\": [2161790], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"20cho-LTB4 is oxidised to 20cooh-LTB4 by ALDH\", \"20-oxo-leukotriene B4 + O2 + reduced (NADPH--hemoprotein reductase) => 20-carboxy-leukotriene B4 + 2 H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\"], \"releaseDate\": \"2012-03-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161979\", \"stIdVersion\": \"R-HSA-2161979.4\"}], \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161790\", \"stIdVersion\": \"R-HSA-2161790.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2161859, \"displayName\": \"Once omega-oxidation has occurred, 20-carboxy leukotriene B4...\", \"schemaClass\": \"Summation\", \"text\": \"Once omega-oxidation has occurred, 20-carboxy leukotriene B4 (20cooh-LTB4) can be further metabolized by beta-oxidation at its omega end into 18-carboxy-LTB4 (18cooh-LTB4) (Berry et al. 2003, Wheelan et al. 1999).  The actual human enzyme or enzymes involved have yet to be identified.\"}]}" ;
