action\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-429786\", \"stIdVersion\": \"R-BTA-429786.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10144920, \"displayName\": \"SGMS2 transfers phosphocholine onto ceramide\", \"inferredFrom\": [429786], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SGMS2 transfers phosphocholine onto ceramide\", \"phosphatidylcholine + ceramide <=> sphingomyelin + diacylglycerol [SGMS2]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-429786\", \"stIdVersion\": \"R-RNO-429786.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10022017, \"displayName\": \"SGMS2 transfers phosphocholine onto ceramide\", \"inferredFrom\": [429786], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SGMS2 transfers phosphocholine onto ceramide\", \"phosphatidylcholine + ceramide <=> sphingomyelin + diacylglycerol [SGMS2]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-429786\", \"stIdVersion\": \"R-MMU-429786.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9843210, \"displayName\": \"SPHM [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SPHM\", \"sphingomyelin\", \"sphingomyelins\", \"ceramide phosphocholines\"], \"producedByEvent\": [429786], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9843210\", \"stIdVersion\": \"R-ALL-9843210.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 114519, \"displayName\": \"DAG [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DAG\", \"1,2-diacyl-sn-glycerol\", \"1,2-Diacylglycerol\"], \"producedByEvent\": [429786], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-114519\", \"stIdVersion\": \"R-ALL-114519.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1640164, \"displayName\": \"ENPP7 hydrolyzes sphingomyelin\", \"followingEvent\": [429786], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ENPP7 hydrolyzes sphingomyelin\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1640164\", \"stIdVersion\": \"R-HSA-1640164.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1861788, \"displayName\": \"GBA2 hydrolyzes GlcCer (plasma membrane)\", \"followingEvent\": [429786], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GBA2 hydrolyzes GlcCer (plasma membrane)\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1861788\", \"stIdVersion\": \"R-HSA-1861788.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1606273, \"displayName\": \"SMPD2 and 3 hydrolyze sphingomyelin (plasma membrane)\", \"followingEvent\": [429786], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SMPD2 and 3 hydrolyze sphingomyelin (plasma membrane)\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1606273\", \"stIdVersion\": \"R-HSA-1606273.3\"}], \"releaseDate\": \"2009-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-429786\", \"stIdVersion\": \"R-HSA-429786.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 429790, \"displayName\": \"SGMS2 (sphingomyelin synthase 2) catalyzes the reversible re...\", \"schemaClass\": \"Summation\", \"text\": \"SGMS2 (sphingomyelin synthase 2) catalyzes the reversible reaction of phosphatidylcholine and ceramide to form sphingomyelin and diacylglycerol. Most SGMS2 activity is associated with the plasma membrane, although active enzyme is also present in the Golgi apparatus (Tafesse et al. 2007; Villani et al. 2008; Ding et al. 2008). Phosphatidylcholine was identified as the source of the phosphocholine moiety donated to ceramide in this reaction in studies of the mouse enzyme in the 1970s (Diringer et al., 1972; Ullman and Radin, 1974). The association of SGMS2 with the plasma membrane appears to require palmitoylation of at least two cysteine residues near the carboxy terminus (Tani and Kuge, 2009). SGMS2 is widely expressed in the body, and while studies of cultured cells indicate that this is a minor source of cellular sphingomyelin, blockage of SGMS2 activity inhibits cell growth. SGMS2 deficiency causes forms of osteoporosis (CDL, MIM:126550; CDLSMD, MIM:126550) (Huitema et al., 2004; Tafesse et al., 2007; reviewed by Chen & Cao, 2017).\"}]}" ;
