ame\": \"Sus scrofa\", \"stId\": \"R-SSC-9026007\", \"stIdVersion\": \"R-SSC-9026007.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10437792, \"displayName\": \"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DPAn-3 to 13,14-epoxy-DPAn-3\", \"inferredFrom\": [9026007], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DPAn-3 to 13,14-epoxy-DPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9026007\", \"stIdVersion\": \"R-BTA-9026007.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10323912, \"displayName\": \"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DPAn-3 to 13,14-epoxy-DPAn-3\", \"inferredFrom\": [9026007], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DPAn-3 to 13,14-epoxy-DPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9026007\", \"stIdVersion\": \"R-CFA-9026007.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10216021, \"displayName\": \"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DPAn-3 to 13,14-epoxy-DPAn-3\", \"inferredFrom\": [9026007], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DPAn-3 to 13,14-epoxy-DPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9026007\", \"stIdVersion\": \"R-RNO-9026007.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092809, \"displayName\": \"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DPAn-3 to 13,14-epoxy-DPAn-3\", \"inferredFrom\": [9026007], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ dehydrogenates 14(S)-Hp-DPAn-3 to 13,14-epoxy-DPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9026007\", \"stIdVersion\": \"R-MMU-9026007.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9026307, \"displayName\": \"13,14(S)-epoxy-DPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"13,14(S)-epoxy-DPAn-3\", \"(7Z,9E,11E,16Z,19Z)-13,14-epoxydocosapentaenoate\", \"13,14(S)-epoxy-docosapentaenoic acid\", \"(7Z,9E,11E,16Z,19Z)-13,14-epoxydocosapentaenoic acid\"], \"producedByEvent\": [9026007], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9026307\", \"stIdVersion\": \"R-ALL-9026307.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"producedByEvent\": [9026007], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9026006, \"displayName\": \"ALOX12:Fe2+ oxidises DPAn-3 to 14(S)-Hp-DPAn-3\", \"followingEvent\": [9026007], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DPAn-3 to 14(S)-Hp-DPAn-3\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026006\", \"stIdVersion\": \"R-HSA-9026006.3\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026007\", \"stIdVersion\": \"R-HSA-9026007.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9026312, \"displayName\": \"In a reaction scheme that could be similar to the one for DH...\", \"schemaClass\": \"Summation\", \"text\": \"In a reaction scheme that could be similar to the one for DHA-derived maresins, a lipoxygenase mediates the abstraction of hydrogen from 14(S)-hydroperoxy-docosapentaenoic acid (14(S)-Hp-DPAn-3) to form the epoxy product 13,14(S)-epoxy-docosapentaenoic acid (13,14(S)-epoxy-DPAn-3) (Dalli et al. 2013). If, as assumed, DPA metabolism follows the same path as for DHA metabolism, the lipoxygenase could be 12-lipoxygenase (ALOX12).\"}]}" ;
