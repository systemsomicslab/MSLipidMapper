se, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol is reduced to 4,4-dimethylcholesta-8(9),24-dien-3beta-ol [TM7SF2]\", \"4,4-dimethyl-5alpha-cholesta-8,14,24-trien-3beta-ol + NADPH + H(+) => 4,4-dimethyl-5alpha-cholesta-8,24-dien-3beta-ol + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-194698\", \"stIdVersion\": \"R-BTA-194698.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10249106, \"displayName\": \"4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol is reduced to 4,4-dimethylcholesta-8(9),24-dien-3beta-ol [TM7SF2]\", \"inferredFrom\": [194698], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol is reduced to 4,4-dimethylcholesta-8(9),24-dien-3beta-ol [TM7SF2]\", \"4,4-dimethyl-5alpha-cholesta-8,14,24-trien-3beta-ol + NADPH + H(+) => 4,4-dimethyl-5alpha-cholesta-8,24-dien-3beta-ol + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-194698\", \"stIdVersion\": \"R-CFA-194698.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10128900, \"displayName\": \"4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol is reduced to 4,4-dimethylcholesta-8(9),24-dien-3beta-ol [TM7SF2]\", \"inferredFrom\": [194698], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol is reduced to 4,4-dimethylcholesta-8(9),24-dien-3beta-ol [TM7SF2]\", \"4,4-dimethyl-5alpha-cholesta-8,14,24-trien-3beta-ol + NADPH + H(+) => 4,4-dimethyl-5alpha-cholesta-8,24-dien-3beta-ol + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-194698\", \"stIdVersion\": \"R-RNO-194698.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007862, \"displayName\": \"4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol is reduced to 4,4-dimethylcholesta-8(9),24-dien-3beta-ol [TM7SF2]\", \"inferredFrom\": [194698], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol is reduced to 4,4-dimethylcholesta-8(9),24-dien-3beta-ol [TM7SF2]\", \"4,4-dimethyl-5alpha-cholesta-8,14,24-trien-3beta-ol + NADPH + H(+) => 4,4-dimethyl-5alpha-cholesta-8,24-dien-3beta-ol + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-194698\", \"stIdVersion\": \"R-MMU-194698.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 194633, \"displayName\": \"14DMLANOL [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"14DMLANOL\", \"14-demethyllanosterol\", \"4,4-dimethylcholesta-8(9),24-dien-3beta-ol\"], \"producedByEvent\": [194698], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194633\", \"stIdVersion\": \"R-ALL-194633.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [194698], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 194678, \"displayName\": \"CYP51A1 demethylates LAN\", \"followingEvent\": [194698], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYP51A1 demethylates LAN\", \"lanosterol + 3 O2 + 3 reduced (NADPH--hemoprotein reductase) => 4,4-dimethyl-5alpha-cholesta-8,14,24-trien-3beta-ol + formate + 4 H(+) + 4 H2O + 3 oxidized (NADPH--hemoprotein reductase)\", \"lanosterol + 3 NADPH + 3 H+ + 3 O2 => 4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol + 3 NADP+ + 4 H2O + formate\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194678\", \"stIdVersion\": \"R-HSA-194678.5\"}], \"releaseDate\": \"2007-02-20\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-194698\", \"stIdVersion\": \"R-HSA-194698.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 194730, \"displayName\": \"4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol and NADPH + H...\", \"schemaClass\": \"Summation\", \"text\": \"4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol and NADPH + H+ react to form 4,4-dimethylcholesta-8(9),24-dien-3beta-ol and NADP+, catalyzed by TM7SF2 in the endoplasmic reticulum. TM7SF2 protein has sterol delta14-reductase activity in vitro, and expression of the gene is induced by sterol starvation in human cells, as expected for a gene involved in sterol biosynthesis (Bennati et al. 2006). However, molecular studies of material from an individual with HEM/Greenberg skeletal dysplasia indicate that LBR, a protein that spans the inner nuclear membrane and has both laminin receptor and sterol delta14-reductase activities, is required for normal sterol 14delta-reductase activity in human cells. It remains to be determined whether both LBR and TM7SF2 catalyze this reaction in vivo, and whether the role of TM7SF2 is essential (Waterham et al. 2003).\"}]}" ;
