    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9020261], \"className\": \"CatalystActivity\", \"dbId\": 2161919, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen of Ac-PTGS2 dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9020261, \"displayName\": \"Ac-PTGS2 dimer oxidises DHA to 17(R)-Hp-DHA\", \"followingEvent\": [9020271], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9020261], \"dbId\": 9024011, \"displayName\": \"DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHA\", \"(4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoate\", \"Docosahexaenoic acid\", \"all-cis-docosa-4,7,10,13,16,19-hexaenoic acid\", \"cis-4,7,10,13,16,19-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024011\", \"stIdVersion\": \"R-ALL-9024011.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9020261], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9022657, \"displayName\": \"Resolvins: a family of b