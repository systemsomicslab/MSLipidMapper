ss\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1482685\", \"stIdVersion\": \"R-MMU-1482685.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1498750, \"displayName\": \"GPCho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GPCho\", \"choline alfoscerate\", \"GroPCho\", \"Glycerol 3-phosphocholine\", \"glycerophosphocholine\"], \"producedByEvent\": [1482685], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498750\", \"stIdVersion\": \"R-ALL-1498750.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524021, \"displayName\": \"LCFA(-) [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [1482685], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524021\", \"stIdVersion\": \"R-ALL-1524021.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482856, \"displayName\": \"PC is hydrolyzed to 1-acyl LPC by PLA2[5]\", \"followingEvent\": [1482685], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PC is hydrolyzed to 1-acyl LPC by PLA2[5]\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482856\", \"stIdVersion\": \"R-HSA-1482856.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482816, \"displayName\": \"PC is hydrolyzed to 1-acyl LPC by PLA2[6]\", \"followingEvent\": [1482685], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PC is hydrolyzed to 1-acyl LPC by PLA2[6]\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482816\", \"stIdVersion\": \"R-HSA-1482816.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482685\", \"stIdVersion\": \"R-HSA-1482685.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482655, \"displayName\": \"At the endoplasmic reticulum (ER) membrane, 1-acyl lysophosp...\", \"schemaClass\": \"Summation\", \"text\": \"At the endoplasmic reticulum (ER) membrane, 1-acyl lysophosphatidylcholine (LPC) is hydrolyzed to glycerophosphocholine (GPCho) by cytosolic phospholipase A2 alpha/beta/delta/epsilon/zeta (PLA2G4A/B/D/E/F) (Yamashita et al. 2005, Ghomashchi et al. 2010, Yamashita et al. 2009, Sharp et al. 1994) or by Phospholipase B1-like (PLBD1) (Xu et al. 2009).  PLBD1 also acts as a phospholipase A2 but in addition has the propensity to hydrolyze the lysophospholipid formed in its initial reaction.\"}]}" ;
