<https://reactome.org/content/detail/R-HSA-428990> a mslm:LipidReaction ;
    rdfs:label "SLC27A1 transports arachidonate across the ER membrane" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "AA [endoplasmic reticulum lumen] => AA [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [428990], \"className\": \"CatalystActivity\", \"dbId\": 9915567, \"displayName\": \"icosanoid transmembrane transporter activity of SLC27A1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12689787, \"displayName\": \"RHEA:71395\", \"identifier\": \"71395\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/71395\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9915558, \"displayName\": \"RHEA:71395\", \"identifier\": \"71395\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/71395\"}], \"dbId\": 428990, \"displayName\": \"SLC27A1 transports arachidonate across the ER membrane\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [428990], \"dbId\": 140356, \"displayName\": \"AA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AA\", \"arachidonate\", \"Arachidonate\", \"arachidonic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-140356\", \"stIdVersion\": \"R-ALL-140356.6\"}], \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9915550, \"displayName\": \"Impact on fatty acid metabolism and differential localization of FATP1 and FAT/CD36 proteins delivered in cultured human muscle cells\", \"journal\": \"Am J Physiol Cell Physiol\", \"pages\": \"C1264-72\", \"pubMedIdentifier\": 15897321, \"schemaClass\": \"LiteratureReference\", \"title\": \"Impact on fatty acid metabolism and differential localization of FATP1 and FAT/CD36 proteins delivered in cultured human muscle cells\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15897321\", \"volume\": 288, \"year\": 2005}, {\"className\": \"LiteratureReference\", \"dbId\": 428991, \"displayName\": \"How is the level of free arachidonic acid controlled in mammalian cells?\", \"journal\": \"Biochem J\", \"pages\": \"3-16\", \"pubMedIdentifier\": 6810878, \"schemaClass\": \"LiteratureReference\", \"title\": \"How is the level of free arachidonic acid controlled in mammalian cells?\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/6810878\", \"volume\": 204, \"year\": 1982}, {\"className\": \"LiteratureReference\", \"dbId\": 9915538, \"displayName\": \"Expression cloning and characterization of a novel adipocyte long chain fatty acid transport protein\", \"journal\": \"Cell\", \"pages\": \"427-36\", \"pubMedIdentifier\": 7954810, \"schemaClass\": \"LiteratureReference\", \"title\": \"Expression cloning and characterization of a novel adipocyte long chain fatty acid transport protein\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/7954810\", \"volume\": 79, \"year\": 1994}], \"maxDepth\": 1, \"name\": [\"SLC27A1 transports arachidonate across the ER membrane\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate(out) = (5Z,8Z,11Z,14Z)-eicosatetraenoate(in)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29768, \"displayName\": \"AA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AA\", \"arachidonate\", \"Arachidonate\", \"arachidonic acid\", \"cis-5,8,11,14-Eicosatetraenoic acid\"], \"producedByEvent\": [428990], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29768\", \"stIdVersion\": \"R-ALL-29768.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 111883, \"displayName\": \"PLA2G4A (cPLA2) hydrolyzes phosphatidylcholine\", \"followingEvent\": [428990], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PLA2G4A (cPLA2) hydrolyzes phosphatidylcholine\", \"1-acyl-2-(5Z,8Z,11Z,14Z-eicosatetraenoyl)-sn-glycero-3-phosphocholine + H2O => (5Z,8Z,11Z,14Z)-eicosatetraenoate + a 1-acyl-sn-glycero-3-phosphocholine + H+\"], \"releaseDate\": \"2008-12-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-111883\", \"stIdVersion\": \"R-HSA-111883.5\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428990\", \"stIdVersion\": \"R-HSA-428990.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 428987, \"displayName\": \"Cytosolic arachidonate (AA) released by phospholipases is tr...\", \"schemaClass\": \"Summation\", \"text\": \"Cytosolic arachidonate (AA) released by phospholipases is transported across the ER membrane by SLC27A1, providing input for eicosanoid synthetic reactions in the endoplasmic reticulum lumen as well as the cytosol. Human SLC27A1 has not been characterized experimentally; its subcellular location (Garcia-Martinez et al. 2005) and transporter activity (Shaffer and Lodish 1994) are inferred from the properties of the homologous mouse protein.\"}]}" ;
