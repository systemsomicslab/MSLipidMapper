maxDepth\": 1, \"name\": [\"Desaturation of Linoleoyl-CoA to gamma-linolenoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-2046096\", \"stIdVersion\": \"R-MMU-2046096.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2046042, \"displayName\": \"GLA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GLA-CoA\", \"gamma-linolenoyl-CoA\", \"gamma-linolenoyl-CoA (GLA-COA)\", \"octadecatrienoyl-CoA\", \"6Z,9Z,12Z-octadecatrienoyl-CoA\", \"18:3(n-6)\"], \"producedByEvent\": [2046096], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046042\", \"stIdVersion\": \"R-ALL-2046042.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113519, \"displayName\": \"H2O [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [2046096, 2046096], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113519\", \"stIdVersion\": \"R-ALL-113519.3\"}, 113519, {\"className\": \"Chemical Compound\", \"dbId\": 194653, \"displayName\": \"NAD+ [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\"], \"producedByEvent\": [2046096, 2046096], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194653\", \"stIdVersion\": \"R-ALL-194653.5\"}, 194653], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2046098, \"displayName\": \"Activation of linoleic acid to linoleoyl-CoA\", \"followingEvent\": [2046096], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Activation of linoleic acid to linoleoyl-CoA\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2046098\", \"stIdVersion\": \"R-HSA-2046098.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2046096\", \"stIdVersion\": \"R-HSA-2046096.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2045931, \"displayName\": \"The first major step in the metabolism of linoleic acid (LA)...\", \"schemaClass\": \"Summation\", \"text\": \"The first major step in the metabolism of linoleic acid (LA) is desaturation of delta 9,12-octadecadienoyl CoA/linoleoyl CoA (LA-CoA) to delta 6,9,12-octodecatrienoyl CoA/gamma-lenoleoyl CoA (GLA-CoA). This step is catalyzed by delta-6-destaurase (fatty acid desaturase-2, FADS2) which introduces a cis-double bond between carbons 6 and 7. This is the rate limiting step in LA metabolism (Horrobin 1993).\"}]}" ;
