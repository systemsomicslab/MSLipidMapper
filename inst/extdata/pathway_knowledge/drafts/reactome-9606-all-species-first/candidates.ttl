-CFA-8857686.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10205751, \"displayName\": \"FITM2 binds TAGs\", \"inferredFrom\": [8857686], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FITM2 binds TAGs\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8857686\", \"stIdVersion\": \"R-RNO-8857686.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10082860, \"displayName\": \"FITM2 binds TAGs\", \"inferredFrom\": [8857686], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FITM2 binds TAGs\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8857686\", \"stIdVersion\": \"R-MMU-8857686.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 9942194, \"displayName\": \"FITM2:TAGs [endoplasmic reticulum membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"FITM2:TAGs\"], \"producedByEvent\": [8857686], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9942194\", \"stIdVersion\": \"R-HSA-9942194.1\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-06-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8857686\", \"stIdVersion\": \"R-HSA-8857686.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9942186, \"displayName\": \"Lipid droplets (LDs) are cytosolic structures found in all e...\", \"schemaClass\": \"Summation\", \"text\": \"Lipid droplets (LDs) are cytosolic structures found in all eukaryotes, comprising a monolayer of phospholipids surrounding a core of uncharged lipids such as triglyceride (TAG) and sterol esters. They play an important role in both cellular physiology and disease. LD formation involves the partitioning of neutral lipids from their site of synthesis at the endoplasmic reticulum (ER) to the cytosol. The fat storage-inducing transmembrane protein 2 (FITM2) belongs to an evolutionarily-conserved gene family which mediates LD formation (Kadereit et al. 2008, Gross et al. 2011). FITM2 is an ER membrane associated protein that mediates binding (annotated here) and partitioning of TAGs into LDs (Gross et al. 2011, Miranda et al. 2014). FITM2 is expressed primarily in adipose tissue whereas its paralog FITM2 is expressed primarily in skeletal muscle, suggesting these proteins may have distinct functions (Gross et al. 2011).\"}]}" ;
