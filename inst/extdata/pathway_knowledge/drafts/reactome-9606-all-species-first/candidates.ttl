    mslm:equation "PA [mitochondrial inner membrane] + CTP [mitochondrial matrix] => CDP-DAG [mitochondrial inner membrane] + PPi [mitochondrial matrix]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [1483165], \"className\": \"CatalystActivity\", \"dbId\": 1524097, \"displayName\": \"phosphatidate cytidylyltransferase activity of CDS2 [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}, {\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 1483165, \"displayName\": \"PA is converted to CDP-DAG by CDS2\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1483165], \"dbId\": 1524101, \"displayName\": \"PA [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PA\", \"phosphatidate(2-)\", \"phosphatidic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524101\", \"stIdVersion\": \"R-ALL-1524101.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [1483165], \"dbId\": 110577, \"displayName\": \"CTP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CTP\", \"CTP(4-)\", \"cytidine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-110577\", \"stIdVersion\": \"R-ALL-110577.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1482952, \"displayName\": \"The role of CDP-diacylglycerol synthetase and phosphatidylinositol synthase activity levels in the regulation of cellular phosphatidylinositol content\", \"journal\": \"J Biol Chem\", \"pages\": \"33402-9\", \"pubMedIdentifier\": 9407135, \"schemaClass\": \"LiteratureReference\", \"title\": \"The role of CDP-diacylglycerol synthetase and phosphatidylinositol synthase activity levels in the regulation of cellular phosphatidylinositol content\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9407135\", \"volume\": 272, \"year\": 1997}, {\"className\": \"LiteratureReference\", \"dbId\": 1483032, \"displayName\": \"Cardiolipin is synthesized on the matrix side of the inner membrane in rat liver mitochondria\", \"journal\": \"J Biol Chem\", \"pages\": \"74-9\", \"pubMedIdentifier\": 8380172, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cardiolipin is synthesized on the matrix side of the inner membrane in rat liver mitochondria\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8380172\", \"volume\": 268, \"year\": 1993}, {\"className\": \"LiteratureReference\", \"dbId\": 1483143, \"displayName\": \"Participation of the microsomal CDP-diglycerides in the mitochondrial biosynthesis of phosphatidylglycerol\", \"journal\": \"Biochem Cell Biol\", \"pages\": \"309-14\", \"pubMedIdentifier\": 3718705, \"schemaClass\": \"LiteratureReference\", \"title\": \"Participation of the microsomal CDP-diglycerides in the mitochondrial biosynthesis of phosphatidylglycerol\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/3718705\", \"volume\": 64, \"year\": 1986}], \"maxDepth\": 1, \"name\": [\"PA is converted to CDP-DAG by CDS2\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11124233, \"displayName\": \"PA is converted to CDP-DAG by CDS2\", \"inferredFrom\": [1483165], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PA is converted to CDP-DAG by CDS2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Plasmodium falciparum\", \"stId\": \"R-PFA-1483165\", \"stIdVersion\": \"R-PFA-1483165.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11099952, \"displayName\": \"PA is converted to CDP-DAG by CDS2\", \"inferredFrom\": [1483165], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PA is converted to CDP-DAG by CDS2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1483165\", \"stIdVersion\": \"R-SCE-1483165.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11070906, \"displayName\": \"PA is converted to CDP-DAG by CDS2\", \"inferredFrom\": [1483165], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PA is converted to CDP-DAG by CDS2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-1483165\", \"stIdVersion\": \"R-SPO-1483165.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11024628, \"displayName\": \"PA is converted to CDP-DAG by CDS2\", \"inferredFrom\": [1483165], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PA is converted to CDP-DAG by CDS2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1483165\", \"stIdVersion\": \"R-DDI-1483165.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10956640, \"displayName\": \"PA is converted to CD