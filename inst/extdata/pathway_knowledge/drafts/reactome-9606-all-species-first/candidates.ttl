    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [1483197], \"className\": \"CatalystActivity\", \"dbId\": 3446787, \"displayName\": \"phosphatidylglycerophosphatase activity of PTPMT1 [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}, {\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12689773, \"displayName\": \"RHEA:33751\", \"identifier\": \"33751\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/33751\"}], \"dbId\": 1483197, \"displayName\": \"PTPMT1 dephosphorylates PGP to PG\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1483197], \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [1483197], \"dbId\": 1524059, \"displayName\": \"PGP [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGP\", \"1-(3-sn-phosphatidyl)-sn-glycerol 3-phosphate(3-)\", \"3-(3-sn-phosphatidyl)-sn-glycerol 1-phosphate\", \"1-(3-sn-phosphatidyl)-sn-glycerol 3-phosphate\", \"Phosphatidylglycerophosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524059\", \"stIdVersion\": \"R-ALL-1524059.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 3446788, \"displayName\": \"Mitochondrial phosphatase PTPMT1 is essential for cardiolipin biosynthesis\", \"journal\": \"Cell Metab.\", \"pages\": \"690-700\", \"pubMedIdentifier\": 21641550, \"schemaClass\": \"LiteratureReference\", \"title\": \"Mitochondrial phosphatase PTPMT1 is essential for cardiolipin biosynthesis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/21641550\", \"volume\": 13, \"year\": 2011}], \"maxDepth\": 1, \"name\": [\"PTPMT1 dephosphorylates PGP to PG\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1524042, \"displayName\": \"PG [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PG\", \"1,2-diacyl-sn-glycero-3-phospho-(1'-sn-glycerol)(1-)\", \"phosphatidylglycerol\"], \"producedByEvent\": [1483197], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524042\", \"stIdVersion\": \"R-ALL-1524042.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113548, \"displayName\": \"Pi [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\"], \"producedByEvent\": [1483197], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-