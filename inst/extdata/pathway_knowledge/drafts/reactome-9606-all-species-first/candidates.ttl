eDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-428681\", \"stIdVersion\": \"R-RNO-428681.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10021783, \"displayName\": \"PXLP-SGPL1 cleaves sphingoid-1-phosphates\", \"inferredFrom\": [428681], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PXLP-SGPL1 cleaves sphingoid-1-phosphates\", \"sphinganine 1-phosphate => phosphoethanolamine + hexadecanal\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-428681\", \"stIdVersion\": \"R-MMU-428681.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 428686, \"displayName\": \"PETA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PETA\", \"O-phosphoethanolamine\", \"phosphoethanolamine\", \"ethanolamine phosphate\"], \"producedByEvent\": [428681], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428686\", \"stIdVersion\": \"R-ALL-428686.4\"}, {\"className\": \"Set\", \"dbId\": 9844327, \"displayName\": \"HXAL,HD2NAL [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"HXAL,HD2NAL\"], \"producedByEvent\": [428681], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9844327\", \"stIdVersion\": \"R-ALL-9844327.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 428273, \"displayName\": \"SPHK1 phosphorylates sphingoid\", \"followingEvent\": [428681], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SPHK1 phosphorylates sphingoid\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428273\", \"stIdVersion\": \"R-HSA-428273.5\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9695949, \"displayName\": \"SPHK2 phosphorylates sphingoid\", \"followingEvent\": [428681], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SPHK2 phosphorylates sphingoid\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9695949\", \"stIdVersion\": \"R-HSA-9695949.4\"}], \"releaseDate\": \"2009-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428681\", \"stIdVersion\": \"R-HSA-428681.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 428684, \"displayName\": \"SGPL1 (sphingosine-1-phosphate lyase 1), associated with the...\", \"schemaClass\": \"Summation\", \"text\": \"SGPL1 (sphingosine-1-phosphate lyase 1), associated with the endoplasmic reticulum membrane, catalyzes the cleavage of cytosolic sphinganine (dihydrosphingosine) or sphngosin\\\\e 1-phosphate to form phosphoethanolamine and hexadecanal or hexadecenal, respectively (Van Veldhoven et al. 2000; reviewed by Fyrst and Saba 2008; Saba, 2019). The reaction has no reverse counterpart and, thus, irreversibly removes sphingoids from the lipid pool. SGPL1 deficiency causes a  form of nephrotic syndrome, a renal disease clinically characterized by severe proteinuria (NPHS14, MIM:617575; reviewed by Duarte Linhares et al., 2018).\"}]}" ;
