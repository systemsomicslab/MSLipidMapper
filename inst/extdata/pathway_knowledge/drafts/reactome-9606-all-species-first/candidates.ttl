    mslm:equation "H2O [endoplasmic reticulum lumen] + PGI2 [endoplasmic reticulum lumen] => 6k-PGF1a [endoplasmic reticulum lumen]" ;
    mslm:evidenceJson "{\"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}], \"dbId\": 2161619, \"displayName\": \"PGI2 is hydrolysed to 6k-PGF1a\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161619], \"dbId\": 31593, \"displayName\": \"PGI2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGI2\", \"prostaglandin I2(1-)\", \"Prostacyclin\", \"prostaglandin I2\", \"(5Z,13E)-(15S)-6,9alpha-Epoxy-11alpha,15-dihydroxyprosta-5,13-dienoate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-31593\", \"stIdVersion\": \"R-ALL-31593.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161619], \"dbId\": 113519, \"displayName\": \"H2O [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113519\", \"stIdVersion\": \"R-ALL-113519.3\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 215548, \"displayName\": \"Purification and characterization of recombinant human prostacyclin synthase\", \"journal\": \"J Biochem\", \"pages\": \"455-63\", \"pubMedIdentifier\": 15115769, \"schemaClass\": \"LiteratureReference\", \"title\": \"Purification and characterization of recombinant human prostacyclin synthase\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15115769\", \"volume\": 135, \"year\": 2004}], \"maxDepth\": 1, \"name\": [\"PGI2 is hydrolysed to 6k-PGF1a\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142786, \"displayName\": \"6k-PGF1a [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"6k-PGF1a\", \"6-oxoprostaglandin F1alpha(1-)\", \"6-oxo-prostaglandin F1alpha\", \"6-oxoprostaglandin F1alpha\"], \"producedByEvent\": [2161619], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142786\", \"stIdVersion\": \"R-ALL-2142786.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 76496, \"displayName\": \"PTGIS, CYP8A1 isomerise PGH2 to PGI2\", \"followingEvent\": [2161619], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PTGIS, CYP8A1 isomerise PGH2 to PGI2\", \"prostaglandin H2 => prostaglandin I2\", \"Prostacyclin synthase (CYP8A1) mediates the isomerization of prostaglandin H2 to prostaglandin I2\"], \"releaseDate\": \"2008-06-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-76496\", \"stIdVersion\": \"R-HSA-76496.4\"}], \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161619\", \"stIdVersion\": \"R-HSA-2161619.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2161610, \"displayName\": \"The ring in prostaglandin I2 (PGI2) aka prostacyclin is high...\", \"schemaClass\": \"Summation\", \"text\": \"The ring in prostaglandin I2 (PGI2) aka prostacyclin is highly labile and rapidly hydolyses to form the stable but biologically inactive 6-keto-prostaglandin F1alpha (6k-PGF1a) (Wada et al. 2004).  PGI2 and 6k-PGF1a are often used interchangeably in the literature.\"}]}" ;
