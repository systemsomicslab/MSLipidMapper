    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [2161735], \"className\": \"CatalystActivity\", \"dbId\": 9915637, \"displayName\": \"isomerase activity of isomerase [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9915668, \"displayName\": \"isomerase activity of isomerase [cytosol] Partial purification and characterization of prostaglandin A isomerase from rabbit serum\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690676, \"displayName\": \"RHEA:50545\", \"identifier\": \"50545\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/50545\"}, {\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9915651, \"displayName\": \"RHEA:50545\", \"identifier\": \"50545\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/50545\"}], \"dbId\": 2161735, \"displayName\": \"PGC2 is isomerised to PGB2\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [2161735], \"dbId\": 2299724, \"displayName\": \"PGC2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGC2\", \"prostaglandin C2(1-)\", \"prostaglandin C2\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2299724\", \"stIdVersion\": \"R-ALL-2299724.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 2161654, \"displayName\": \"Cyclopentenone prostaglandins: new insights on biological activities and cellular targets\", \"journal\": \"Med Res Rev\", \"pages\": \"185-210\", \"pubMedIdentifier\": 11301410, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cyclopentenone prostaglandins: new insights on biological activities and cellular targets\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11301410\", \"volume\": 21, \"year\": 2001}], \"maxDepth\": 1, \"name\": [\"PGC2 is isomerised to PGB2\", \"prostaglandin C2 => prostaglandin B2\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2299721, \"displayName\": \"PGB2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGB2\", \"prostaglandin B2(1-)\", \"prostaglandin B2\"], \"producedByEvent\": [2161735], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2299721\", \"stIdVersion\": \"R-ALL-2299721.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2161666, \"displayName\": \"PGA2 is isomerised to PGC2\", \"followingEvent\": [2161735], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PGA2 is isomerised to PGC2\", \"prostaglandin A2 => prostaglandin C2\"], \"releaseDate\": \"2012-12-04\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161666\", \"stIdVersion\": \"R-HSA-2161666.4\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2012-12-04\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2161735\", \"stIdVersion\": \"R-HSA-2161735.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2161586, \"displayName\": \"Isomerization of the double bond in prostaglandin A2 (PGA2) ...\", \"schemaClass\": \"Summation\", \"text\": \"Isomerization of the double bond in prostaglandin A2 (PGA2) forms prostaglandin C2 (PGC2).  This is an unstable compound which undergoes a second isomerization to yield prostaglandin B2 (PGB2) (Straus & Glass, 2001).\"}]}" ;
