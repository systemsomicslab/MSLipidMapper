d\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 13(R)-HDPAn-3 to RvT1-4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9026405\", \"stIdVersion\": \"R-CFA-9026405.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10216023, \"displayName\": \"ALOX5 oxidises 13(R)-HDPAn-3 to RvT1-4\", \"inferredFrom\": [9026405], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 13(R)-HDPAn-3 to RvT1-4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9026405\", \"stIdVersion\": \"R-RNO-9026405.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092811, \"displayName\": \"ALOX5 oxidises 13(R)-HDPAn-3 to RvT1-4\", \"inferredFrom\": [9026405], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 13(R)-HDPAn-3 to RvT1-4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9026405\", \"stIdVersion\": \"R-MMU-9026405.1\"}], \"output\": [{\"className\": \"Set\", \"dbId\": 9026394, \"displayName\": \"RvT1-4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"RvT1-4\"], \"producedByEvent\": [9026405], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9026394\", \"stIdVersion\": \"R-ALL-9026394.1\"}], \"precedingEvent\": [{\"category\": \"uncertain\", \"className\": \"Reaction\", \"dbId\": 9026411, \"displayName\": \"13(R)-HDPAn-3 translocates from endothelial cell to neutrophil\", \"followingEvent\": [9026405], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"13(R)-HDPAn-3 translocates from endothelial cell to neutrophil\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026411\", \"stIdVersion\": \"R-HSA-9026411.3\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026405\", \"stIdVersion\": \"R-HSA-9026405.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9026410, \"displayName\": \"In neutrophils, 5-lipoxygenase (ALOX5) oxidises 13(R)-hydrox...\", \"schemaClass\": \"Summation\", \"text\": \"In neutrophils, 5-lipoxygenase (ALOX5) oxidises 13(R)-hydroxy-docosapentaenoic acid (13(R)-DPAn-3) to the 13(R)-resolvins RvT1-4 (7,13,20-trihydroxy-docosapentaenoic acid, 7,12,13-trihydroxy-docosapentaenoic acid, 7,8,13-trihydroxy-docosapentaenoic acid and 7,13-dihydroxy-docosapentaenoic acid respectively) (Dalli et al. 2015, Primdahl et al. 2016). They were all shown to posses anti-inflammatory and proresolving activities (Dalli et al. 2015). Recently, RvTs have been shown to mediate the proresolving actions of several statins in mice with inflammatory arthritis (Walker et al. 2017).\"}]}" ;
