    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8874470], \"className\": \"CatalystActivity\", \"dbId\": 8874465, \"displayName\": \"phosphatidylinositol transfer activity of TNFAIP8 proteins [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0030659\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 437051, \"definition\": \"The lipid bilayer surrounding a cytoplasmic vesicle.\", \"displayName\": \"cytoplasmic vesicle membrane\", \"name\": \"cytoplasmic vesicle membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0030659\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690736, \"displayName\": \"RHEA:85915\", \"identifier\": \"85915\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/85915\"}], \"dbId\": 8874470, \"displayName\": \"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\", \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [8874470], \"dbId\": 8874484, \"displayName\": \"PI(4,5)P2, PI(3,4,5)P3 [cytoplasmic vesicle membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PI(4,5)P2, PI(3,4,5)P3\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-8874484\", \"stIdVersion\": \"R-ALL-8874484.1\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8874489, \"displayName\": \"The TIPE (TNFAIP8) family in inflammation, immunity, and cancer\", \"journal\": \"Mol. Immunol.\", \"pages\": \"4-7\", \"pubMedIdentifier\": 21924498, \"schemaClass\": \"LiteratureReference\", \"title\": \"The TIPE (TNFAIP8) family in inflammation, immunity, and cancer\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/21924498\", \"volume\": 49, \"year\": 2011}, {\"className\": \"LiteratureReference\", \"dbId\": 8874492, \"displayName\": \"Identical expression profiling of human and murine TIPE3 protein reveals links to its functions\", \"journal\": \"J. Histochem. Cytochem.\", \"pages\": \"206-16\", \"pubMedIdentifier\": 25479791, \"schemaClass\": \"LiteratureReference\", \"title\": \"Identical expression profiling of human and murine TIPE3 protein reveals links to its functions\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25479791\", \"volume\": 63, \"year\": 2015}, {\"className\": \"LiteratureReference\", \"dbId\": 8874474, \"displayName\": \"TIPE3 is the transfer protein of lipid second messengers that promote cancer\", \"journal\": \"Cancer Cell\", \"pages\": \"465-78\", \"pubMedIdentifier\": 25242044, \"schemaClass\": \"LiteratureReference\", \"title\": \"TIPE3 is the transfer protein of lipid second messengers that promote cancer\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25242044\", \"volume\": 26, \"year\": 2014}, {\"className\": \"LiteratureReference\", \"dbId\": 8874459, \"displayName\": \"A new TIPE of phosphoinositide regulator in cancer\", \"journal\": \"Cancer Cell\", \"pages\": \"443-4\", \"pubMedIdentifier\": 25314070, \"schemaClass\": \"LiteratureReference\", \"title\": \"A new TIPE of phosphoinositide regulator in cancer\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25314070\", \"volume\": 26, \"year\": 2014}], \"maxDepth\": 1, \"name\": [\"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10904205, \"displayName\": \"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\", \"inferredFrom\": [8874470], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8874470\", \"stIdVersion\": \"R-DME-8874470.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10815863, \"displayName\": \"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\", \"inferredFrom\": [8874470], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-8874470\", \"stIdVersion\": \"R-GGA-8874470.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10722116, \"displayName\": \"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\", \"inferredFrom\": [8874470], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8874470\", \"stIdVersion\": \"R-XTR-8874470.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10639361, \"displayName\": \"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\", \"inferredFrom\": [8874470], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-8874470\", \"stIdVersion\": \"R-DRE-8874470.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10543898, \"displayName\": \"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\", \"inferredFrom\": [8874470], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8874470\", \"stIdVersion\": \"R-SSC-8874470.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10430196, \"displayName\": \"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\", \"inferredFrom\": [8874470], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8874470\", \"stIdVersion\": \"R-BTA-8874470.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10316713, \"displayName\": \"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\", \"inferredFrom\": [8874470], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8874470\", \"stIdVersion\": \"R-CFA-8874470.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10208251, \"displayName\": \"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\", \"inferredFrom\": [8874470], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8874470\", \"stIdVersion\": \"R-RNO-8874470.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10085254, \"displayName\": \"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\", \"inferredFrom\": [8874470], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TNFAIP8 proteins transfer PI(4,5)P2, PI(3,4,5)P3 from cytosolic vesicles to plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8874470\", \"stIdVersion\": \"R-MMU-8874470.1\"}], \"output\": [{\"className\": \"Set\", \"dbId\": 8874460, \"displayName\": \"PI(4,5)P2, PI(3,4,5)P3 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PI(4,5)P2, PI(3,4,5)P3\"], \"producedByEvent\": [8874470], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-8874460\", \"stIdVersion\": \"R-ALL-8874460.1\"}], \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8874470\", \"stIdVersion\": \"R-HSA-8874470.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8874475, \"displayName\": \"The tumor necrosis factor alpha-induced protein 8 family are...\", \"schemaClass\": \"Summation\", \"text\": \"The tumor necrosis factor alpha-induced protein 8 family are all thought to be related to carcinogenesis (Lou & Liu 2011). TNFAIP8 and TNFAIP8L1 (aka TIPE1) may play roles in oncogenesis and TNFAIP8L2 (aka TIPE2) is an essential negative regulator of both innate and adaptive immunity and may play an important role in the development of inflammatory diseases. TNFAIP8L3 (aka TIPE3) is an important regulator of tumorigenesis through its activation of phospholipid signaling (Fayngerts et al. 2014). TNFAIP8 proteins are cytosolic proteins that contain a large hydrophobic cavity that is occupied by a phospholipid-like molecule. Although TNFAIP8 proteins can transport many phospholipids, they are thought to preferentially transport phosphoinositol-4,5-bisphosphate (PI(4,5)P2) and  phosphoinositol-3,4,5-trisphosphate (PI(3,4,5)P3) from cytoplasmic vesicle membranes to the plasma membrane (Moniz & Vanhaesebroeck 2014, Cui et al. 2015). TNFAIP8L3 is highly expressed in most human carcinoma cell lines and more than half of human cancers have aberrantly upregulated phosphoinositide signals. How phospholipid signals are controlled during tumorigenesis is not fully understood (Fayngerts et al. 2014).\"}]}" ;
