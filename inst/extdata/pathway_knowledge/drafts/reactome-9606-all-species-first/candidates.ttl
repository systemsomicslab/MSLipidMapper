rl\": \"http://www.ncbi.nlm.nih.gov/pubmed/28126847\", \"volume\": 58, \"year\": 2017}], \"maxDepth\": 1, \"name\": [\"GBA1:SAPC hydrolyzes GlcCer\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10276203, \"displayName\": \"GBA1:SAPC hydrolyzes GlcCer\", \"inferredFrom\": [1605591], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA1:SAPC hydrolyzes GlcCer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1605591\", \"stIdVersion\": \"R-CFA-1605591.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10958277, \"displayName\": \"GBA1:SAPC hydrolyzes GlcCer\", \"inferredFrom\": [1605591], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA1:SAPC hydrolyzes GlcCer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-1605591\", \"stIdVersion\": \"R-CEL-1605591.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10871224, \"displayName\": \"GBA1:SAPC hydrolyzes GlcCer\", \"inferredFrom\": [1605591], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA1:SAPC hydrolyzes GlcCer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-1605591\", \"stIdVersion\": \"R-DME-1605591.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10780733, \"displayName\": \"GBA1:SAPC hydrolyzes GlcCer\", \"inferredFrom\": [1605591], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA1:SAPC hydrolyzes GlcCer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-1605591\", \"stIdVersion\": \"R-GGA-1605591.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10603706, \"displayName\": \"GBA1:SAPC hydrolyzes GlcCer\", \"inferredFrom\": [1605591], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA1:SAPC hydrolyzes GlcCer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-1605591\", \"stIdVersion\": \"R-DRE-1605591.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10500783, \"displayName\": \"GBA1:SAPC hydrolyzes GlcCer\", \"inferredFrom\": [1605591], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA1:SAPC hydrolyzes GlcCer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1605591\", \"stIdVersion\": \"R-SSC-1605591.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10386217, \"displayName\": \"GBA1:SAPC hydrolyzes GlcCer\", \"inferredFrom\": [1605591], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA1:SAPC hydrolyzes GlcCer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1605591\", \"stIdVersion\": \"R-BTA-1605591.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10162833, \"displayName\": \"GBA1:SAPC hydrolyzes GlcCer\", \"inferredFrom\": [1605591], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA1:SAPC hydrolyzes GlcCer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1605591\", \"stIdVersion\": \"R-RNO-1605591.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10040677, \"displayName\": \"GBA1:SAPC hydrolyzes GlcCer\", \"inferredFrom\": [1605591], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA1:SAPC hydrolyzes GlcCer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1605591\", \"stIdVersion\": \"R-MMU-1605591.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605673, \"displayName\": \"CERA [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CERA\", \"N-acylsphingoid\", \"Ceramide\", \"N-acylsphingosine\"], \"producedByEvent\": [1605591], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605673\", \"stIdVersion\": \"R-ALL-1605673.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1605745, \"displayName\": \"Glc [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Glc\", \"D-glucopyranose\", \"alpha-D-glucose\"], \"producedByEvent\": [1605591], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605745\", \"stIdVersion\": \"R-ALL-1605745.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1606312, \"displayName\": \"GLB1 hydrolyzes SapB/C:LacCer\", \"followingEvent\": [1605591], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GLB1 hydrolyzes SapB/C:LacCer\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1606312\", \"stIdVersion\": \"R-HSA-1606312.3\"}], \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605591\", \"stIdVersion\": \"R-HSA-1605591.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1605596, \"displayName\": \"Human lysosomal glucosylceramidase (GBA1) hydrolyzes the glu...\", \"schemaClass\": \"Summation\", \"text\": \"Human lysosomal glucosylceramidase (GBA1) hydrolyzes the glucosidic bond of glucocerebrosides (GlcCer) to form ceramide (Dinur et al. 1986). GBA1 requires a low-weight, non-enzymatic protein (one of the sphingolipids activator proteins) called Saposin-C (SAP-C) which acts with GBA1 to form an activated complex (Salvioli et al. 2000; Abdul-Hammed et al., 2017). Defects in GBA1 are the cause of Gaucher disease (GD) (MIM:230800), the most common glycolipid storage disorder, characterized by storage of glucocerebroside in the liver, spleen, and marrow (Beutler & Gelbart 1996).\"}]}" ;
