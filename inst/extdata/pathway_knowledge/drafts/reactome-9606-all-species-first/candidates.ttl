Class\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-6786650\", \"stIdVersion\": \"R-CFA-6786650.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10195072, \"displayName\": \"DDHD1,2 hydrolyse PA\", \"inferredFrom\": [6786650], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DDHD1,2 hydrolyse PA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-6786650\", \"stIdVersion\": \"R-RNO-6786650.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10071773, \"displayName\": \"DDHD1,2 hydrolyse PA\", \"inferredFrom\": [6786650], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DDHD1,2 hydrolyse PA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-6786650\", \"stIdVersion\": \"R-MMU-6786650.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1602447, \"displayName\": \"1-acyl LPA [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPA\", \"1-acyl-sn-glycerol 3-phosphate\", \"1-acyl-glycerol 3-phosphate \", \"lysophosphatidic acid\"], \"producedByEvent\": [6786650], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1602447\", \"stIdVersion\": \"R-ALL-1602447.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1602366, \"displayName\": \"LCFA(-) [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [6786650], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1602366\", \"stIdVersion\": \"R-ALL-1602366.4\"}], \"releaseDate\": \"2015-12-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6786650\", \"stIdVersion\": \"R-HSA-6786650.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6786647, \"displayName\": \"Glycerophospholipids are important structural and functional...\", \"schemaClass\": \"Summation\", \"text\": \"Glycerophospholipids are important structural and functional components of biological membranes, of serum lipoproteins and pulmonary surfactant and act as precursors of lipid mediators such as platelet-activating factor and eicosanoids. Phosphatidic acid (PA) is a common glycerophospholipid and its hydrolysis can mediate its functions described above. Phospholipases DDHD1 and 2 can mediate the hydrolysis of PA (Inoue et al. 2012, Nakajima et al. 2002). Defects in DDHD1 or DDHD2 can cause autosomal recessive spastic paraplegias 28 or 54 respectively (SPG28, MIM:609340; SPG54, MIM:615033). These are forms of neurodegenerative spastic paraplegia, characterised by slow, gradual, progressive weakness and spasticity of the lower limbs (Tesson et al. 2012, Schuurs-Hoeijmakers et al. 2012).\"}]}" ;
