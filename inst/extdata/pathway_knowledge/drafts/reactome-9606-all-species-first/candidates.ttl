<https://reactome.org/content/detail/R-HSA-193097> a mslm:LipidReaction ;
    rdfs:label "Pregnenolone translocates from the mitochondrial matrix to the cytosol" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "PREG [mitochondrial matrix] => PREG [cytosol]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 193097, \"displayName\": \"Pregnenolone translocates from the mitochondrial matrix to the cytosol\", \"followingEvent\": [193068], \"goBiologicalProcess\": {\"accession\": \"0170037\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 9910496, \"definition\": \"The directed movement of substances from the mitochondrion to the cytosol.\", \"displayName\": \"export from the mitochondrion\", \"name\": \"export from the mitochondrion\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0170037\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193097], \"dbId\": 193164, \"displayName\": \"PREG [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PREG\", \"pregnenolone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193164\", \"stIdVersion\": \"R-ALL-193164.3\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8984522, \"displayName\": \"Cytosol stimulation of pregnenolone synthesis by isolated adrenal mitochondria\", \"journal\": \"Life Sci.\", \"pages\": \"1529-34\", \"pubMedIdentifier\": 6264249, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cytosol stimulation of pregnenolone synthesis by isolated adrenal mitochondria\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/6264249\", \"volume\": 28, \"year\": 1981}], \"maxDepth\": 1, \"name\": [\"Pregnenolone translocates from the mitochondrial matrix to the cytosol\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193103, \"displayName\": \"PREG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PREG\", \"pregnenolone\"], \"producedByEvent\": [193097], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193103\", \"stIdVersion\": \"R-ALL-193103.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193101, \"displayName\": \"CYP11A1 cleaves 20a,22b-DHCHOL\", \"followingEvent\": [193097], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYP11A1 cleaves 20a,22b-DHCHOL\", \"(20R,22R)-20,22-dihydroxycholesterol + 2 H(+) + O2 + 2 reduced (adrenodoxin) => 4-methylpentanal + 2 H2O + 2 oxidized (adrenodoxin) + pregnenolone\", \"20alpha,22beta-hydroxycholesterol is cleaved by CYP11A1 to yield pregnenolone and isocaproaldehyde\", \"20alpha,22beta-hydroxycholesterol + NADPH + H+ + O2 => pregnenolone + isocaproaldehyde + NADP+ + H2O\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193101\", \"stIdVersion\": \"R-HSA-193101.5\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193097\", \"stIdVersion\": \"R-HSA-193097.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193088, \"displayName\": \"Inferred from rat:\\nPregenolone is translocated from the mito...\", \"schemaClass\": \"Summation\", \"text\": \"Inferred from rat:\\nPregenolone is translocated from the mitochondrial matrix to the cytosol. Neither transport proteins to mediate its movement across the inner mitochondrial membrane nor carrier proteins to facilitate its movement in the cytosol have been identified, and the mechanism of this translocation is unknown (Ray and Strott 1991).\"}]}" ;
