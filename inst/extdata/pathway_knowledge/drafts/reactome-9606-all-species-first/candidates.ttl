    mslm:evidenceJson "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005635\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13231, \"definition\": \"The double lipid bilayer that encloses the nucleus, separating its contents from the cytoplasm. It consists of an inner and outer nuclear membrane, with an intermembrane space (20-40 nm wide, also called the perinuclear space) between them. The envelope is supported by the nuclear lamina and contains nuclear pore complexes, which regulate molecular transport.\", \"displayName\": \"nuclear envelope\", \"name\": \"nuclear envelope\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005635\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9707186, \"displayName\": \"ALOX5 binds ALOX5 inhibitors\", \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [9707186], \"dbId\": 2318764, \"displayName\": \"ALOX5:ALOX5AP:LTC4S [nuclear envelope]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"ALOX5:ALOX5AP:LTC4S\", \"ALOX5:FLAP:LTC4S\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2318764\", \"stIdVersion\": \"R-HSA-2318764.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [9707186], \"dbId\": 9707237, \"displayName\": \"ALOX5 inhibitors [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"ALOX5 inhibitors\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9707237\", \"stIdVersion\": \"R-ALL-9707237.1\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": 