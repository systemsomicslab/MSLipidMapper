", \"dbId\": 1655714, \"displayName\": \"SREBP1A,1C,2:NF-Y:TM7SF2 gene [nucleoplasm]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 4, \"name\": [\"SREBP1A,1C,2:NF-Y:TM7SF2 gene\", \"SREBF1A,1C,2:NF-Y:TM7SF2 gene\"], \"producedByEvent\": [2065966], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1655714\", \"stIdVersion\": \"R-HSA-1655714.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2065539, \"displayName\": \"SREBP1A,1C,2:Importin beta-1 dissociates\", \"followingEvent\": [2065966], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SREBP1A,1C,2:Importin beta-1 dissociates\", \"SREBF1A,1C,2:Importin beta-1 dissociates\"], \"releaseDate\": \"2012-09-18\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2065539\", \"stIdVersion\": \"R-HSA-2065539.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2012-09-18\", \"releaseStatus\": \"UPDATED\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2065966\", \"stIdVersion\": \"R-HSA-2065966.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2065969, \"displayName\": \"SREBP2 (SREBF2) binds and transactivates an unusual sterol r...\", \"schemaClass\": \"Summation\", \"text\": \"SREBP2 (SREBF2) binds and transactivates an unusual sterol regulatory element in the promoter of the TM7SF2 gene (Schiavoni et al. 2010). NF-Y binds the promoter and is important for activation by SREBP2. SREBP1A and SREBP1C can also bind the TM7SF2 promoter (Reed et al. 2008, Rome et al. 2008).\"}]}" ;
