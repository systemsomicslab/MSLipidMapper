    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9947148], \"className\": \"CatalystActivity\", \"dbId\": 9947144, \"displayName\": \"sterol 14-demethylase activity of CYP51A1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9947145, \"displayName\": \"sterol 14-demethylase activity of CYP51A1 [endoplasmic reticulum membrane] Purification of a human cytochrome P-450 isozyme catalyzing lanosterol 14 alpha-demethylation\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9969084, \"displayName\": \"RHEA:45961\", \"identifier\": \"45961\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/45961\"}], \"dbId\": 9947148, \"displayName\": \"CYP51A1 14-demethylates 24,25-dhLAN to 4,4-diMeCholesta-8,14-dien-3-ol\", \"followingEvent\": [9946140], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9947148], \"dbId\": 1130708, \"displayName\": \"24,25-dhLAN [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"24,25-dhLAN\", \"24,25-dihydrolanosterol\", \"phys-ent-participant80768\", \"phys-ent-participant85672\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1130708\", \"stIdVersion\": \"R-ALL-1130708.1\"}, {\"className\": \"Complex\", \"consumedByEvent\": [9947148, 9947148, 9947148], \"dbId\": 8957354, \"displayName\": \"CYP450:Fe2+ [endoplasmic reticulum membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"CYP450:Fe2+\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8957354\", \"stIdVersion\": \"R-HSA-8957354.2\"}, 8957354, 8957354, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9947148, 9947148, 9947148], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, 29368, 29368], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9947138, \"displayName\": \"Sterol 14-demethylase P450 (P45014DM*) is one of the most ancient and conserved P450 species\", \"journal\": \"J Biochem\", \"pages\": \"926-33\", \"pubMedIdentifier\": 8797093, \"schemaClass\": \"LiteratureReference\", \"title\": \"Sterol 14-demethylase P450 (P45014DM*) is one of the most ancient and conserved P450 species\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/8797093\", \"volume\": 119, \"year\": 1996}, {\"className\": \"LiteratureReference\", \"dbId\": 9947152, \"displayName\": \"Purification of a human cytochrome P-450 isozyme catalyzing lanosterol 14 alpha-demethylation\", \"journal\": \"Biochim Biophys Acta\", \"pages\": \"92-7\", \"pubMedIdentifier\": 8399332, \