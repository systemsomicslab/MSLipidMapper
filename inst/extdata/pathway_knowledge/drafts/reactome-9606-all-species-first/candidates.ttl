false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,24(S)-triol\", \"5beta-cholestan-7alpha,24(S)-diol-3-one+ NADPH + H+ => 5beta-cholestan-3alpha,7alpha,24(S)-triol + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-193758\", \"stIdVersion\": \"R-CFA-193758.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10128642, \"displayName\": \"5beta-cholestan-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,24(S)-triol\", \"inferredFrom\": [193758], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,24(S)-triol\", \"5beta-cholestan-7alpha,24(S)-diol-3-one+ NADPH + H+ => 5beta-cholestan-3alpha,7alpha,24(S)-triol + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-193758\", \"stIdVersion\": \"R-RNO-193758.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007641, \"displayName\": \"5beta-cholestan-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,24(S)-triol\", \"inferredFrom\": [193758], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,24(S)-triol\", \"5beta-cholestan-7alpha,24(S)-diol-3-one+ NADPH + H+ => 5beta-cholestan-3alpha,7alpha,24(S)-triol + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193758\", \"stIdVersion\": \"R-MMU-193758.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 213285, \"displayName\": \"5beta-cholestan-3alpha,7alpha,24(S)-triol [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha,7alpha,24(S)-triol\", \"(24S)-5beta-cholestane-3alpha,7alpha,24-triol\"], \"producedByEvent\": [193758], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-213285\", \"stIdVersion\": \"R-ALL-213285.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [193758], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193746, \"displayName\": \"4-cholesten-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-7alpha,24(S)-diol-3-one\", \"followingEvent\": [193758], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"4-cholesten-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-7alpha,24(S)-diol-3-one\", \"4-cholesten-7alpha,24(S)-diol-3-one + NADPH + H+ => 5beta-cholestan-7alpha,24(S)-diol-3-one + NADP+\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193746\", \"stIdVersion\": \"R-HSA-193746.2\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193758\", \"stIdVersion\": \"R-HSA-193758.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193759, \"displayName\": \"5Beta-cholesten-7alpha,24(S)-diol-3-one and NADPH + H+ form ...\", \"schemaClass\": \"Summation\", \"text\": \"5Beta-cholesten-7alpha,24(S)-diol-3-one and NADPH + H+ form 5beta-cholestan-3alpha,7alpha,24(S)-triol and NAPDP+. The reaction is catalyzed by 3alpha-hydroxysteroid dehydrogenase (AKR1C4), a cytosolic enzyme belonging to the aldo-keto reductase family (Dufort et al. 2001). Biochemical studies with rat proteins raise the possibility that other related enzymes may also carry out this reaction in vivo (Russell 2003).\"}]}" ;
