<https://reactome.org/content/detail/R-HSA-163549> a mslm:LipidReaction ;
    rdfs:label "phosphorylated HSL dimer + FABP4 -> phosphorylated HSL dimer:FABP4 complex" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "phosphorylated HSL dimer [lipid droplet] + FABP4 [lipid droplet] => phosphorylated HSL dimer:FABP4 complex [lipid droplet]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [163549], \"className\": \"CatalystActivity\", \"dbId\": 9958495, \"displayName\": \"lipase activator activity of FABP4 [lipid droplet]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005811\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13977, \"definition\": \"An intracellular non-membrane-bounded organelle comprising a matrix of coalesced lipids surrounded by a phospholipid monolayer. May include associated proteins.\", \"displayName\": \"lipid droplet\", \"name\": \"lipid droplet\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005811\"}], \"dbId\": 163549, \"displayName\": \"phosphorylated HSL dimer + FABP4 -> phosphorylated HSL dimer:FABP4 complex\", \"followingEvent\": [163551], \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [163549], \"dbId\": 163428, \"displayName\": \"FABP4 [lipid droplet]\", \"endCoordinate\": 132, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FABP4\", \"fatty acid binding protein, adipocyte\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163428\", \"stIdVersion\": \"R-HSA-163428.2\", \"startCoordinate\": 2}, {\"className\": \"Complex\", \"consumedByEvent\": [163549], \"dbId\": 163435, \"displayName\": \"phosphorylated HSL dimer [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"phosphorylated HSL dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163435\", \"stIdVersion\": \"R-HSA-163435.2\"}], \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 163430, \"displayName\": \"Physical association between the adipocyte fatty acid-binding protein and hormone-sensitive lipase: a fluorescence resonance energy transfer analysis\", \"journal\": \"J Biol Chem\", \"pages\": \"52399-405\", \"pubMedIdentifier\": 15456755, \"schemaClass\": \"LiteratureReference\", \"title\": \"Physical association between the adipocyte fatty acid-binding protein and hormone-sensitive lipase: a fluorescence resonance energy transfer analysis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15456755\", \"volume\": 279, \"year\": 2004}], \"maxDepth\": 1, \"name\": [\"phosphorylated HSL dimer + FABP4 -> phosphorylated HSL dimer:FABP4 complex\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 163535, \"displayName\": \"phosphorylated HSL dimer:FABP4 complex [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"phosphorylated HSL dimer:FABP4 complex\"], \"producedByEvent\": [163549], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163535\", \"stIdVersion\": \"R-HSA-163535.2\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 163554, \"displayName\": \"Phosphorylated HSL dimer translocates from the cytosol to the lipid particle\", \"followingEvent\": [163549], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Phosphorylated HSL dimer translocates from the cytosol to the lipid particle\"], \"releaseDate\": \"2005-06-13\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163554\", \"stIdVersion\": \"R-HSA-163554.4\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2005-06-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163549\", \"stIdVersion\": \"R-HSA-163549.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 163480, \"displayName\": \"Rat FABPA associates with HSL and increases the rate of tria...\", \"schemaClass\": \"Summation\", \"text\": \"Rat FABPA associates with HSL and increases the rate of triacylglycerol hydrolysis, possibly by sequestering the released fatty acids (Shen et al. 1999; Shen et al. 2001). A similar association of HSL and FABP4 at the lipid droplet surface has been demonstrated in human adipocytes (Smith et al. 2004). The stoichiometry of the fatty acid:FABP complex is unknown. This model implies that HSL-associated FABP loaded with fatty acid should exchange with unloaded, unassociated FABP, allowing HSL to continue to work efficiently while moving newly generated fatty acids away from the lipid particle. To date, there is no evidence for or against such a shuttling process.\"}]}" ;
