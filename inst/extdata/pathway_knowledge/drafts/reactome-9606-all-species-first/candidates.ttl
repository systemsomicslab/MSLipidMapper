r\", \"inferredFrom\": [1606564], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GALC hydrolyzes GalCer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1606564\", \"stIdVersion\": \"R-MMU-1606564.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605673, \"displayName\": \"CERA [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CERA\", \"N-acylsphingoid\", \"Ceramide\", \"N-acylsphingosine\"], \"producedByEvent\": [1606564], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605673\", \"stIdVersion\": \"R-ALL-1605673.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1605745, \"displayName\": \"Glc [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Glc\", \"D-glucopyranose\", \"alpha-D-glucose\"], \"producedByEvent\": [1606564], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605745\", \"stIdVersion\": \"R-ALL-1605745.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1606807, \"displayName\": \"ARSA removes sulfate from PSAP(195-273):Sulfatide\", \"followingEvent\": [1606564], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ARSA removes sulfate from PSAP(195-273):Sulfatide\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1606807\", \"stIdVersion\": \"R-HSA-1606807.4\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9841189, \"displayName\": \"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\", \"followingEvent\": [1606564], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\"], \"releaseDate\": \"2023-09-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9841189\", \"stIdVersion\": \"R-HSA-9841189.2\"}, {\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 9840334, \"displayName\": \"PSAP is cleaved\", \"followingEvent\": [1606564], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PSAP is cleaved\"], \"releaseDate\": \"2023-09-13\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840334\", \"stIdVersion\": \"R-HSA-9840334.3\"}], \"regulatedBy\": [{\"className\": \"Requirement\", \"dbId\": 9841129, \"displayName\": \"Requirement by 'PSAP(60-142) [lysosomal lumen]'\", \"regulatedEntity\": [1606564], \"schemaClass\": \"Requirement\"}], \"regulationReference\": [{\"className\": \"RegulationReference\", \"dbId\": 9841135, \"displayName\": \"Requirement by 'PSAP(60-142) [lysosomal lumen]' A mutation in the saposin A coding region of the prosaposin gene in an infant presenting as Krabbe disease: first report of saposin A deficiency in humans\", \"schemaClass\": \"RegulationReference\"}], \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1606564\", \"stIdVersion\": \"R-HSA-1606564.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1606566, \"displayName\": \"Galactocerebrosidase (GALC) hydrolyses the galactosyl moiety...\", \"schemaClass\": \"Summation\", \"text\": \"Galactocerebrosidase (GALC) hydrolyses the galactosyl moiety from galactocerebroside (also called galactosylceramide, GalCer) to form ceramide (Sakai et al. 1994). Saposin A stimulates the reaction (Sap A, PSAP(60-142)) (Morimoto et al., 1989). Defects in GALC are the cause of leukodystrophy globoid cell (GLD) (MIM:245200), also called Krabbe disease (Chen et al., 1993; Chen & Wenger, 1993; Wenger et al., 1997). Defects in Sap A cause an atypical form of Krabbe disease (KRBSAPA, MIM:611722) (Spiegel et a., 2005).\"}]}" ;
