<https://reactome.org/content/detail/R-HSA-9026008> a mslm:LipidReaction ;
    rdfs:label "Epoxide hydrolase hydrolyses 7,8-epoxy-HDPAn-3 to RvD1n-3DPA or RvD2n-3DPA" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "H2O [cytosol] + 7,8-epoxy,17-HDPAn-3 [cytosol] => RvD1n-3DPA, RvD2n-3DPA [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9026008], \"className\": \"CatalystActivity\", \"dbId\": 9025026, \"displayName\": \"epoxide hydrolase activity of Epoxide hydrolase [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9026008, \"displayName\": \"Epoxide hydrolase hydrolyses 7,8-epoxy-HDPAn-3 to RvD1n-3DPA or RvD2n-3DPA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9026008], \"dbId\": 9026050, \"displayName\": \"7,8-epoxy,17-HDPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7,8-epoxy,17-HDPAn-3\", \"7,8-epoxy,17-hydroxy-(9E,11E,13Z,15E,19Z)-docosapentaenoate\", \"7,8-epoxy,17-HDPA(n-3)(1-)\", \"7,8-epoxy,17-hydroxy-(9E,11E,13Z,15E,19Z)-docosapentaenoic acid\", \"7,8-epoxy, 17-hydroxy-omega3-docosapentaenoic acid\", \"7,8-epoxy, 17-hydroxydocosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9026050\", \"stIdVersion\": \"R-ALL-9026050.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9026008], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9025095, \"displayName\": \"Novel n-3 immunoresolvents: structures and actions\", \"journal\": \"Sci Rep\", \"pages\": \"1940\", \"pubMedIdentifier\": 23736886, \"schemaClass\": \"LiteratureReference\", \"title\": \"Novel n-3 immunoresolvents: structures and actions\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/23736886\", \"volume\": 3, \"year\": 2013}], \"maxDepth\": 1, \"name\": [\"Epoxide hydrolase hydrolyses 7,8-epoxy-HDPAn-3 to RvD1n-3DPA or RvD2n-3DPA\"], \"output\": [{\"className\": \"Set\", \"dbId\": 9026291, \"displayName\": \"RvD1n-3DPA, RvD2n-3DPA [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"RvD1n-3DPA, RvD2n-3DPA\"], \"producedByEvent\": [9026008], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9026291\", \"stIdVersion\": \"R-ALL-9026291.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9025995, \"displayName\": \"ALOX5 dehydrogenates 7,17-diHp-DPAn-3 to 7,8-epoxy,17-HDPAn-3\", \"followingEvent\": [9026008], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX5 dehydrogenates 7,17-diHp-DPAn-3 to 7,8-epoxy,17-HDPAn-3\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9025995\", \"stIdVersion\": \"R-HSA-9025995.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026008\", \"stIdVersion\": \"R-HSA-9026008.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9026042, \"displayName\": \"In neutrophils, an epoxide hydrolase is thought to hydrolyse...\", \"schemaClass\": \"Summation\", \"text\": \"In neutrophils, an epoxide hydrolase is thought to hydrolyse 7,8-epoxy-17-hydroxydocosapentaenoic acid (7,8-epoxy-HDPAn-3) to either of the resolvins 7,8,17-trihydroxy-docosapentaenoic acid (RvD1n-3DPA) or 7,16,17-trihydroxy-docosapentaenoic acid (RvD2n-3DPA) (Dalli et al. 2013). Treatment of induced inflammation in mice with RvD1n-3DPA and RvD2n-3DPA reduced neutrophil infiltration and adhesion and enhanced macrophage phagocytosis; all key steps in inflammatory resolution (Dalli et al. 2013, Gobbetti et al. 2017). Although this is a proposed biosynthetic route for the formation of DPA-n-3 resolvins, it is assumed DPAn-3-derived SPMs follow a similar synthesis route to DHA- and EPA-derived SPMs.\"}]}" ;
