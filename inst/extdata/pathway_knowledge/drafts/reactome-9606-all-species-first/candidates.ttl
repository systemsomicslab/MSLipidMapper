<https://reactome.org/content/detail/R-HSA-193832> a mslm:LipidReaction ;
    rdfs:label "5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol is translocated from the cytosol to the mitochondrial matrix" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol [cytosol] => 5bCHOL3a,7a,12a,27-tetrol [mitochondrial matrix]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [193832], \"className\": \"CatalystActivity\", \"dbId\": 9948409, \"displayName\": \"alcohol transmembrane transporter activity of unknown START protein [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"catalystActivityReference\": {\"className\": \"CatalystActivityReference\", \"dbId\": 9948410, \"displayName\": \"alcohol transmembrane transporter activity of unknown START protein [mitochondrial inner membrane] The enzymes, regulation, and genetics of bile acid synthesis\", \"schemaClass\": \"CatalystActivityReference\"}, \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 193832, \"displayName\": \"5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol is translocated from the cytosol to the mitochondrial matrix\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193832], \"dbId\": 193843, \"displayName\": \"5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\", \"5beta-cholestane-3alpha,7alpha,12alpha,26-tetrol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193843\", \"stIdVersion\": \"R-ALL-193843.4\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 192080, \"displayName\": \"The enzymes, regulation, and genetics of bile acid synthesis\", \"journal\": \"Annu Rev Biochem\", \"pages\": \"137-74\", \"pubMedIdentifier\": 12543708, \"schemaClass\": \"LiteratureReference\", \"title\": \"The enzymes, regulation, and genetics of bile acid synthesis\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12543708\", \"volume\": 72, \"year\": 2003}], \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol is translocated from the cytosol to the mitochondrial matrix\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192201, \"displayName\": \"5bCHOL3a,7a,12a,27-tetrol [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5bCHOL3a,7a,12a,27-tetrol\", \"5beta-cholestane-3alpha,7alpha,12alpha,26-tetrol\", \"5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\"], \"producedByEvent\": [193832], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192201\", \"stIdVersion\": \"R-ALL-192201.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193800, \"displayName\": \"5Beta-cholestan-7alpha,12alpha,27-triol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\", \"followingEvent\": [193832], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"5Beta-cholestan-7alpha,12alpha,27-triol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\", \"5Beta-cholestan-7alpha,12alpha,27-triol-3-one + NADPH + H+ => 5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol + NAPDP+\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193800\", \"stIdVersion\": \"R-HSA-193800.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193832\", \"stIdVersion\": \"R-HSA-193832.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193834, \"displayName\": \"5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol is transloca...\", \"schemaClass\": \"Summation\", \"text\": \"5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol is translocated from the cytosol to the mitochondrial matrix. The transporter that mediates its passage across the inner mitochondrial membrane is unknown: the StAR protein that performs this function for cholesterol at the start of steroid hormone biosynthesis is excluded as StAR is not expressed in liver. Other members of the START family of transporters are candidates, however (Russell 2003).\"}]}" ;
