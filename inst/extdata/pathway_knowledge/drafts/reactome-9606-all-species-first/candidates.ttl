    mslm:evidenceJson "{\"category\": \"uncertain\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 1368065, \"displayName\": \"RORA and PPARA positively regulate and NR1D1 negatively regulates expression of NPAS2\", \"goBiologicalProcess\": {\"accession\": \"0045944\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 17788, \"definition\": \"Any process that activates or increases the frequency, rate or extent of transcription from an RNA polymerase II promoter.\", \"displayName\": \"positive regulation of transcription by RNA polymerase II\", \"name\": \"positive regulation of transcription by RNA polymerase II\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0045944\"}, \"input\": [{\"className\": \"DNA Sequence\", \"consumedByEvent\": [1368065], \"dbId\": 5640176, \"displayName\": \"NPAS2 gene [nucleoplasm]\", \"endCoordinate\": -1, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NPAS2 gene\"], \"referenceType\": \"ReferenceDNASequence\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5640176\", \"stIdVersion\": \"R-HSA-5640176.1\", \"startCoordinate\": 1}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1368907, \"displayName\": \"Molecular characterization of two mammalian bHLH-PAS domain proteins selectively expressed in the central nervous system\", \"journal\": \"Proc Natl Acad Sci U S A\", \"pages\": \"713-8\", \"pubMedIdentifier\": 9012850, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular characterization of two mammalian bHLH-PAS domain proteins selectively expressed in the central nervous system\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/9012850\", \"volume\": 94, \"year\": 1997}, {\"className\": \"LiteratureReference\", \"dbId\": 5669329, \"displayName\": \"Nuclear receptor-mediated cell-autonomous oscillatory expression of the circadian transcription factor, neuronal PAS domain protein 2 (NPAS2)\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"36548-53\", \"pubMedIdentifier\": 24196956, \"schemaClass\": \"LiteratureReference\", \"title\": \"Nuclear receptor-mediated cell-autonomous oscillatory expression of the circadian transcription factor, neuronal PAS domain protein 2 (NPAS2)\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/24196956\", \"volume\": 288, \"year\": 2013}], \"maxDepth\": 1, \"name\": [\"RORA and PPARA positively regulate and NR1D1 negatively regulates expression of NPAS2\", \"NPAS2 gene produces NPAS2\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 400314, \"displayName\": \"NPAS2 [cytosol]\", \"endCoordinate\": 824, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NPAS2\", \"Neuronal PAS domain-containing protein 2\", \"NPAS2_HUMAN\"], \"producedByEvent\": [1368065], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-400314\", \"stIdVersion\": \"R-HSA-400314.1\", \"startCoordinate\": 1}], \"precedingEvent\": [{\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 5663246, \"displayName\": \"RORA and EP300 bind NPAS2 gene\", \"followingEvent\": [1368065], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"RORA and EP300 bind NPAS2 gene\"], \"releaseDate\": \"2015-03-19\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5663246\", \"stIdVersion\": \"R-HSA-5663246.3\"}, {\"category\": \"uncertain\", \"className\": \"Reaction\", \"dbId\": 400143, \"displayName\": \"Fatty acid ligands activate PPARA\", \"followingEvent\": [1368065], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Fatty acid ligands activate PPARA\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-400143\", \"stIdVersion\": \"R-HSA-400143.4\"}], \"regulatedBy\": [{\"className\": \"NegativeGeneExpressionRegulation\", \"dbId\": 1368161, \"displayName\": \"Negative gene expression regulation by 'NR1D1:heme:Corepressors:NPAS2 gene [nucleoplasm]'\", \"regulatedEntity\": [1368065], \"schemaClass\": \"NegativeGeneExpressionRegulation\", \"stId\": \"R-HSA-1368161\", \"stIdVersion\": \"R-HSA-1368161.3\"}, {\"className\": \"PositiveGeneExpressionRegulation\", \"dbId\": 1368165, \"displayName\": \"Positive gene expression regulation by 'RORA:EP300:NPAS2 gene [nucleoplasm]'\", \"regulatedEntity\": [1368065], \"schemaClass\": \"PositiveGeneExpressionRegulation\", \"stId\": \"R-HSA-1368165\", \"stIdVersion\": \"R-HSA-1368165.1\"}, {\"className\": \"PositiveGeneExpressionRegulation\", \"dbId\": 1989795, \"displayName\": \"Positive gene expression regulation by 'PPARA:RXRA Coactivator complex [nucleoplasm]'\", \"regulatedEntity\": [1368065], \"schemaClass\": \"PositiveGeneExpressionRegulation\", \"stId\": \"R-HSA-1989795\", \"stIdVersion\": \"R-HSA-1989795.1\"}], \"regulationReference\": [{\"className\": \"RegulationReference\", \"dbId\": 9642459, \"displayName\": \"Negative gene expression regulation by 'NR1D1:heme:Corepressors:NPAS2 gene [nucleoplasm]' Characterization of the core mammalian clock component, NPAS2, as a REV-ERBalpha/RORalpha target gene\", \"schemaClass\": \"RegulationReference\"}, {\"className\": \"RegulationReference\", \"dbId\": 9642726, \"displayName\": \"Positive gene expression regulation by 'RORA:EP300:NPAS2 gene [nucleoplasm]' Characterization of the core mammalian clock component, NPAS2, as a REV-ERBalpha/RORalpha target gene\", \"schemaClass\": \"RegulationReference\"}, {\"className\": \"RegulationReference\", \"dbId\": 9642870, \"displayName\": \"Positive gene expression regulation by 'PPARA:RXRA Coactivator complex [nucleoplasm]' Comparative analysis of gene regulation by the transcription factor PPARalpha between mouse and human\", \"schemaClass\": \"RegulationReference\"}], \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1368065\", \"stIdVersion\": \"R-HSA-1368065.11\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1368066, \"displayName\": \"The NPAS2 gene is transcribed to yield mRNA and the mRNA is ...\", \"schemaClass\": \"Summation\", \"text\": \"The NPAS2 gene is transcribed to yield mRNA and the mRNA is transcribed to yield NPAS2 protein (Zhou et al. 1997, Matsumura et al. 2013, also inferred from mouse homologs). Transcription of NPAS2 is enhanced by the RORA:coactivator complex and repressed by the NR1D1:corepressor complex (REV-ERBA:corepressor complex).<br>ROR-alpha (RORA) binds the promoter of the NPAS2 gene and enhances transcription (Matsumura et al. 2013, and inferred from mouse homologs). RORA binds ROR response elements (RRE, RORE) and recruits the coactivators PGC-1alpha (PPARGC1A) and p300 (EP300, a histone acetylase) (inferred from mouse homologs).\"}]}" ;
