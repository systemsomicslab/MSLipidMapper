on\": \"R-PFA-8952251.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11111433, \"displayName\": \"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\", \"inferredFrom\": [8952251], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-8952251\", \"stIdVersion\": \"R-SCE-8952251.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10992510, \"displayName\": \"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\", \"inferredFrom\": [8952251], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-8952251\", \"stIdVersion\": \"R-CEL-8952251.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10907156, \"displayName\": \"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\", \"inferredFrom\": [8952251], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8952251\", \"stIdVersion\": \"R-DME-8952251.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10819185, \"displayName\": \"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\", \"inferredFrom\": [8952251], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-8952251\", \"stIdVersion\": \"R-GGA-8952251.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10724608, \"displayName\": \"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\", \"inferredFrom\": [8952251], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8952251\", \"stIdVersion\": \"R-XTR-8952251.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10547063, \"displayName\": \"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\", \"inferredFrom\": [8952251], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8952251\", \"stIdVersion\": \"R-SSC-8952251.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10433731, \"displayName\": \"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\", \"inferredFrom\": [8952251], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8952251\", \"stIdVersion\": \"R-BTA-8952251.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10211858, \"displayName\": \"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\", \"inferredFrom\": [8952251], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8952251\", \"stIdVersion\": \"R-RNO-8952251.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10088738, \"displayName\": \"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\", \"inferredFrom\": [8952251], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8952251\", \"stIdVersion\": \"R-MMU-8952251.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8952253, \"displayName\": \"GPCho [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GPCho\", \"choline alfoscerate\", \"glycerophosphorylcholine\"], \"producedByEvent\": [8952251], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8952253\", \"stIdVersion\": \"R-ALL-8952253.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 8954142, \"displayName\": \"LCFA(-) [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [8952251], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8954142\", \"stIdVersion\": \"R-ALL-8954142.3\"}], \"releaseDate\": \"2017-03-27\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8952251\", \"stIdVersion\": \"R-HSA-8952251.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8952273, \"displayName\": \"Lecithin cholesterol acyltransferase (LCAT) is a key enzyme ...\", \"schemaClass\": \"Summation\", \"text\": \"Lecithin cholesterol acyltransferase (LCAT) is a key enzyme in the esterification of plasma cholesterol. Group XV phospholipase A2 (PLA2G15 aka LCAT-like lysophospholipase, LLPL or lysosomal phospholipase A2, LPLA2) bears 49% sequence similarity to LCAT (Taniyama et al. 1999) and is present in plasma. PLA2G15 possesses both calcium-independent phospholipase A(2) and transacylase activities (Abe & Shayman 1998) and could hydrolyse lysophosphatidylcholine (lysoPC), a proatherogenic lipid, to glycerophosphorylcholine (GPCho) and a free fatty acid anion (LCFA(-)) (Taniyama et al. 1999, Hiraoka et al. 2002).\"}]}" ;
