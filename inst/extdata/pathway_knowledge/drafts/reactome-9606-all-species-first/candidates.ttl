    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9037761], \"className\": \"CatalystActivity\", \"dbId\": 9037765, \"displayName\": \"monooxygenase activity of CYP1A1, CYP1A2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9037761, \"displayName\": \"CYP1, CYP2 hydroxylate (N)PD1 to 22-OH-(N)PD1\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9037761], \"dbId\": 9024886, \"displayName\": \"(N)PD1 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(N)PD1\", \"protectin D1(1-)\", \"10(R),17(S)-dihydroxy-docosa-4Z,7Z,11E,13E,15Z,19Z-hexaenoic acid\", \"protectin D1\", \"neuroprotectin D1\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024886\", \"stIdVersion\": \"R-ALL-9024886.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9037761], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9037761], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9037761], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9037760, \"displayName\": \"Synthesis and anti-inflammatory and pro-resolving activities of 22-OH-PD1, a monohydroxylated metabolite of protectin D1\", \"journal\": \"J. Nat. Prod.\", \"pages\": \"2241-7\", \"pubMedIdentifier\": 25247845, \"schemaClass\": \"LiteratureReference\", \"title\": \"Synthesis and anti-inflammatory and pro-resolving activities of 22-OH-PD1, a monohydroxylated metabolite of protectin D1\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25247845\", \"volume\": 77, \"year\": 2014}, {\"className\": \"LiteratureReference\", \"dbId\": 9037767, \"displayName\": \"Contributions of the three CYP1 monooxygenases to pro-inflammatory and inflammation-resolution lipid mediator pathways\", \"journal\": \"J. Immunol.\", \"pages\": \"3347-57\", \"pubMedIdentifier\": 23956430, \"schemaClass\": \"LiteratureReference\", \"title\": \"Contributions of the three CYP1 monooxygenases to pro-inflammatory and inflammation-resolution lipid mediator pathways\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/23956430\", \"volume\": 191, \"year\": 2013}], \"maxDepth\": 1, \"name\": [\"CYP1, CYP2 hydroxylate (N)PD1 to 22-OH-(N)PD1\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10645584, \"displayName\": \"CYP1, CYP2 hydroxylate (N)PD1 to 22-OH-(N)PD1\", \"inferredFrom\": [9037761], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP1, CYP2 hydroxylate (N)PD1 to 22-OH-(N)PD1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9037761\", \"stIdVersion\": \"R-DRE-9037761.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10551610, \"displayName\": \"CYP1, CYP2 hydroxylate (N)PD1 to 22-OH-(N)PD1\", \"inferredFrom\": [9037761], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP1, CYP2 hydroxylate (N)PD1 to 22-OH-(N)PD1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9037761\", \"stIdVersion\": \"R-SSC-9037761.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10438216, \"displayName\": \"CYP1, CYP2 hydroxylate (N)PD1 to 22-OH-(N)PD1\", \"inferredFrom\": [9037761], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP1, CYP2 hydroxylate (N)PD1 to 22-OH-(N)PD1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9037761\", \"stIdVersion\": \"R-BTA-9037761.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10216520, \"displayName\": \"CYP1, CYP2 hydroxylate (N)PD1 to 22-OH-(N)PD1\", \"inferredFrom\": [9037761], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP1, CYP2 hydroxylate (N)PD1 to 22-OH-(N)PD1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9037761\", \"stIdVersion\": \"R-RNO-9037761.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10093274, \"displayName\": \"CYP1, CYP2 hydroxylate (N)PD1 to 22-OH-(N)PD1\", \"inferredFrom\": [9037761], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP1, CYP2 hydroxylate (N)PD1 to 22-OH-(N)PD1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9037761\", \"stIdVersion\": \"R-MMU-9037761.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9037755, \"displayName\": \"22-OH-(N)PD1 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"22-OH-(N)PD1\", \"22-hydroxyprotectin D1(1-)\", \"22-OH-(N)PD1(1-)\", \"22-hydroxyprotectin D1\", \"22-hydroxy-(neuro)protectin D1\"], \"producedByEvent\": [9037761], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9037755\", \"stIdVersion\": \"R-ALL-9037755.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [9037761], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [9037761], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9024890, \"displayName\": \"LTA4H:Zn2+ hydrolyses 16S,17S-epoxy-DHA to (N)PD1\", \"followingEvent\": [9037761], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"LTA4H:Zn2+ hydrolyses 16S,17S-epoxy-DHA to (N)PD1\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9024890\", \"stIdVersion\": \"R-HSA-9024890.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9037761\", \"stIdVersion\": \"R-HSA-9037761.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9037778, \"displayName\": \"Protectin D1, identified as (N)PD1 (N signifies neuroprotect...\", \"schemaClass\": \"Summation\", \"text\": \"Protectin D1, identified as (N)PD1 (N signifies neuroprotectin when produced in neural tissues), is a natural product derived from docosahexaenoic acid (DHA) through the actions of 15 lipoxygenase followed by enzymatic hydrolysis by an unidentified hydrolase. (N)PD1 is one of the specialized proresolving mediators (SPMs) that show potent anti inflammatory and pro resolving actions (Molfino et al. 2017, Balas & Durand 2016). (N)PD1 has been the subject of many pharmacological studies for the development of potential new anti inflammatory drugs. The 22 hydroxylated metabolite of (N)PD1 (here signified as 22 OH (N)PD1) has been shown to exhibit potent pro resolving actions by inhibiting PMN chemotaxis in vivo with mice and in vitro with human cells and decreases pro inflammatory mediator levels in inflammatory exudates. These observations were comparable to those of its precursor (N)PD1 (Tungen et al. 2014). 22 OH (N)PD1 is most likely formed by the action of CYP1 monooxygenases, just like for some other SPMs (Divanovic et al. 2013).\"}]}" ;
