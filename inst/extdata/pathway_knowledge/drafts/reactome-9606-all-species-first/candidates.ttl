e\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [209868], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [209868], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 209766, \"displayName\": \"25(OH)D translocates from lysosomal lumen to cytosol\", \"followingEvent\": [209868], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"25(OH)D translocates from lysosomal lumen to cytosol\"], \"releaseDate\": \"2008-06-30\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-209766\", \"stIdVersion\": \"R-HSA-209766.6\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 209845, \"displayName\": \"CYP2R1 25-hydroxylates VD3 to 25(OH)D\", \"followingEvent\": [209868], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYP2R1 25-hydroxylates VD3 to 25(OH)D\"], \"releaseDate\": \"2008-06-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-209845\", \"stIdVersion\": \"R-HSA-209845.4\"}], \"regulatedBy\": [{\"className\": \"NegativeRegulation\", \"dbId\": 9692889, \"displayName\": \"Negative regulation by 'Fru [cytosol]'\", \"regulatedEntity\": [209868], \"schemaClass\": \"NegativeRegulation\"}], \"releaseDate\": \"2008-06-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-209868\", \"stIdVersion\": \"R-HSA-209868.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 215621, \"displayName\": \"The second step in vitamin D activation requires hydroxylati...\", \"schemaClass\": \"Summation\", \"text\": \"The second step in vitamin D activation requires hydroxylation of 25-hydroxyvitamin D (calcidiol, 25(OH)D) to 1-alpha, 25-dihydroxyvitamin D (1,25(OH)2D). This conversion is mediated by 25-hydroxyvitamin D-1-alpha hydroxylase (CYP27B1), an outer mitochondrial membrane-resident protein (Zehnder et al. 2002, Fritsche et al. 2003, Sawada et al. 1999).\"}]}" ;
