<https://reactome.org/content/detail/R-HSA-9028260> a mslm:LipidReaction ;
    rdfs:label "δ12-PGJ3 spontaneously dehydrates to  15d-PGJ3" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "δ12-PGJ3 [cytosol] => 15d-PGJ3 [cytosol] + H2O [cytosol]" ;
    mslm:evidenceJson "{\"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9028260, \"displayName\": \"δ12-PGJ3 spontaneously dehydrates to  15d-PGJ3\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9028260], \"dbId\": 9028201, \"displayName\": \"δ12-PGJ3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"δ12-PGJ3\", \"Delta(12)-prostaglandin J3(1-)\", \"Delta(12)-prostaglandin J3\", \"delta-12-prostaglandin-J3\", \"δ12-prostaglandin-J3\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9028201\", \"stIdVersion\": \"R-ALL-9028201.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9028221, \"displayName\": \"Albumin-catalyzed metabolism of prostaglandin D2. Identification of products formed in vitro\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"11713-8\", \"pubMedIdentifier\": 6578214, \"schemaClass\": \"LiteratureReference\", \"title\": \"Albumin-catalyzed metabolism of prostaglandin D2. Identification of products formed in vitro\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/6578214\", \"volume\": 258, \"year\": 1983}], \"maxDepth\": 1, \"name\": [\"δ12-PGJ3 spontaneously dehydrates to  15d-PGJ3\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9028207, \"displayName\": \"15d-PGJ3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"15d-PGJ3\", \"15-deoxy-Delta(12,14)-prostaglandin J3(1-)\", \"15-deoxy-Delta(12,14)-prostaglandin J3\", \"15-deoxy-prostaglandin J3\"], \"producedByEvent\": [9028260], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9028207\", \"stIdVersion\": \"R-ALL-9028207.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [9028260], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"precedingEvent\": [{\"category\": \"uncertain\", \"className\": \"Reaction\", \"dbId\": 9028263, \"displayName\": \"PGJ3 isomerises to δ12-PGJ3\", \"followingEvent\": [9028260], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PGJ3 isomerises to δ12-PGJ3\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9028263\", \"stIdVersion\": \"R-HSA-9028263.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9028260\", \"stIdVersion\": \"R-HSA-9028260.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9028293, \"displayName\": \"It is proposed that δ12-prostaglandin-J3 ( δ12-PGJ3) undergo...\", \"schemaClass\": \"Summation\", \"text\": \"It is proposed that δ12-prostaglandin-J3 ( δ12-PGJ3) undergoes a second dehydration to form 15-deoxy-prostaglandin J3 (15d-PGJ3) (Fitzpatrick et al. 1983, Shibata et al. 2002). Oxo-fatty acids, like 15d-PGJ3, can covalently bind and activate the peroxisome proliferator-activated receptor γ (PPARγ) and inhibit pro-inflammatory cytokine and nitric oxide production (Groeger et al. 2010, Waku et al. 2009, Shibata et al. 2002, Lefils-Lacourtablaise et al. 2013). In mice, oxo-prostaglandins such as 15d-PGJ3 may have a chemopreventative effect in myeloid leukemia (Finch et al. 2015, Hegde et al. 2011).\"}]}" ;
