eDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8858298\", \"stIdVersion\": \"R-CFA-8858298.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10205821, \"displayName\": \"HRASLS transfer acyl group from PC to PE to form NAPE\", \"inferredFrom\": [8858298], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HRASLS transfer acyl group from PC to PE to form NAPE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8858298\", \"stIdVersion\": \"R-RNO-8858298.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10082931, \"displayName\": \"HRASLS transfer acyl group from PC to PE to form NAPE\", \"inferredFrom\": [8858298], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HRASLS transfer acyl group from PC to PE to form NAPE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8858298\", \"stIdVersion\": \"R-MMU-8858298.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 6814253, \"displayName\": \"LysoPtdCho [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LysoPtdCho\", \"1-O-acyl-sn-glycero-3-phosphocholine\"], \"producedByEvent\": [8858298], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6814253\", \"stIdVersion\": \"R-ALL-6814253.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 5694568, \"displayName\": \"NAPE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAPE\", \"N-acylphosphatidylethanolamine\"], \"producedByEvent\": [8858298], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5694568\", \"stIdVersion\": \"R-ALL-5694568.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1483077, \"displayName\": \"PE transports from the mitochondrial membrane to the ER\", \"followingEvent\": [8858298], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PE transports from the mitochondrial membrane to the ER\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483077\", \"stIdVersion\": \"R-HSA-1483077.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482961, \"displayName\": \"CDP-Cho and DAG are converted to PC by CEPT1 at the ER membrane\", \"followingEvent\": [8858298], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CDP-Cho and DAG are converted to PC by CEPT1 at the ER membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482961\", \"stIdVersion\": \"R-HSA-1482961.2\"}], \"releaseDate\": \"2016-06-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8858298\", \"stIdVersion\": \"R-HSA-8858298.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8861997, \"displayName\": \"The H-RAS-like suppressor (HRASLS) subfamily consists of fiv...\", \"schemaClass\": \"Summation\", \"text\": \"The H-RAS-like suppressor (HRASLS) subfamily consists of five enzymes (1–5) in humans that share sequence homology with lecithin:retinol acyltransferase (LRAT). All HRASLS members possess in vitro phospholipid metabolizing abilities including phospholipase A1/2 (PLA1/2) activities and O-acyltransferase activities for the remodeling of glycerophospholipid acyl chains  (Golczak et al. 2012), as well as N-acyltransferase activities for the production of N-acylphosphatidylethanolamines (Mardian et al. 2015). Acyl chain remodelling can play a key role in regulating triglyceride accumulation and energy expenditure in adipocytes, making this process a potential target for treatment of metabolic disorders causing obesity. The example here describes the N-acyltransferase activity of HRASLSs for the production of N-acylphosphatidylethanolamines (NAPEs) (Uyama et al. 2012).\"}]}" ;
