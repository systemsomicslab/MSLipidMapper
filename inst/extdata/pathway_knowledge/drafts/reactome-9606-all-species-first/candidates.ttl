", \"volume\": 89, \"year\": 1992}], \"maxDepth\": 1, \"name\": [\"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10276290, \"displayName\": \"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\", \"inferredFrom\": [1605724], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1605724\", \"stIdVersion\": \"R-CFA-1605724.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10780839, \"displayName\": \"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\", \"inferredFrom\": [1605724], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-1605724\", \"stIdVersion\": \"R-GGA-1605724.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10603751, \"displayName\": \"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\", \"inferredFrom\": [1605724], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-1605724\", \"stIdVersion\": \"R-DRE-1605724.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10500909, \"displayName\": \"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\", \"inferredFrom\": [1605724], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1605724\", \"stIdVersion\": \"R-SSC-1605724.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10386343, \"displayName\": \"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\", \"inferredFrom\": [1605724], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1605724\", \"stIdVersion\": \"R-BTA-1605724.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10162966, \"displayName\": \"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\", \"inferredFrom\": [1605724], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1605724\", \"stIdVersion\": \"R-RNO-1605724.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10040803, \"displayName\": \"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\", \"inferredFrom\": [1605724], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NEU1,4 hydrolyze PSAP(195-273):GM3:PE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1605724\", \"stIdVersion\": \"R-MMU-1605724.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 428639, \"displayName\": \"Neu5Ac [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Neu5Ac\", \"N-acetylneuraminate\", \"SA\", \"N-acetylneuraminic acid\", \"sialic acid\"], \"producedByEvent\": [1605724], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428639\", \"stIdVersion\": \"R-ALL-428639.5\"}, {\"className\": \"Complex\", \"dbId\": 9840818, \"displayName\": \"PSAP(195-273):LacCer:PE [lysosomal lumen]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"PSAP(195-273):LacCer:PE\", \"mobilized LacCer\"], \"producedByEvent\": [1605724], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840818\", \"stIdVersion\": \"R-HSA-9840818.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1605595, \"displayName\": \"bHEXA hydrolyzes GM2A:GM2 to GM2A:GM3\", \"followingEvent\": [1605724], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"bHEXA hydrolyzes GM2A:GM2 to GM2A:GM3\"], \"releaseDate\": \"2011-12-06\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605595\", \"stIdVersion\": \"R-HSA-1605595.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9840470, \"displayName\": \"PSAP(195-273) dimer:PE binds and mobilizes ligands\", \"followingEvent\": [1605724], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PSAP(195-273) dimer:PE binds and mobilizes ligands\"], \"releaseDate\": \"2023-09-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840470\", \"stIdVersion\": \"R-HSA-9840470.2\"}], \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1605724\", \"stIdVersion\": \"R-HSA-1605724.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1605714, \"displayName\": \"Ganglioside GM3, mobilized by Saposin B (PSAP(195-273)), is ...\", \"schemaClass\": \"Summation\", \"text\": \"Ganglioside GM3, mobilized by Saposin B (PSAP(195-273)), is hydrolyzed by sialidases to lactosylceramide (LacCer). Sialidases (NEU, neuraminidases) hydrolyze sialic acids (N-acetylneuramic acid, Neu5Ac, NANA) to produce asialo compounds, a step in the degradation process of glycoproteins and gangliosides. NEU1 and NEU4 hydrolyse NANA in the lysosomal lumen. NEU1 is active in a multienzyme complex comprising cathepsin A protective protein (CTSA) and beta-galactosidase (Bonten et al. 1996, Rudenko et al. 1995). Defects in NEU1 cause Sialidosis (MIM:256550) (Bonten et al. 1996). CTSA appears to exert a protective function necessary for the stability and activity of these enzymes (Galjart et al. 1988). Defects in CTSA are the cause of galactosialidosis (GSL, MIM:256540) (Zhou et al. 1991). NEU4 is also a lysosomal sialidase which, unlike NEU1, does not require association with other proteins for enzymatic activity. Isoform 2 seems to be the lysosomal sialidase (Seyrantepe et al. 2004). Researchers observed elevated GM3 in prosaposin deficiency (PSAPD, MIM: 611721) cases, a rare disease with low levels of all saposins. The essential cofactor missing appears to be Saposin B (PSAP(195-273)) (Schmidt et al., 1992; Bradova et al., 1993).\"}]}" ;
