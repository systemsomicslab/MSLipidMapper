    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9025007], \"className\": \"CatalystActivity\", \"dbId\": 9024806, \"displayName\": \"oxidoreductase activity of Hydroperoxy reductase [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9025007, \"displayName\": \"Hydroperoxy reductase reduces 7(S),14(S)-diHp-DHA to 7-epi-MaR1\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9025007], \"dbId\": 9024989, \"displayName\": \"7(S),14(S)-diHp-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7(S),14(S)-diHp-DHA\", \"(7S,14S)-bis(hydroperoxy)-(4Z,8E,10Z,12E,16Z,19Z)-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024989\", \"stIdVersion\": \"R-ALL-9024989.4\"}, {\"className\": \"OtherEntity\", \"consumedByEvent\": [9025007], \"dbId\": 5359016, \"displayName\": \"reduced acceptor [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"reduced acceptor\", \"XH2\"], \"schemaClass\": \"OtherEntity\", \"stId\": \"R-ALL-5359016\", \"stIdVersion\": \"R-ALL-5359016.2\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9024988, \"displayName\": \"Maresins: novel macrophage mediators with potent antiinflammatory and proresolving actions\", \"journal\": \"J. Exp. Med.\", \"pages\": \"15-23\", \"pubMedIdentifier\": 19103881, \"schemaClass\": \"Literature