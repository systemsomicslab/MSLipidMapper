alse, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2 is dephosphorylated to PI4P by SYNJ/INPP5[1] at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1676177\", \"stIdVersion\": \"R-BTA-1676177.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 392417, \"displayName\": \"PI4P [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI4P\", \"1-phosphatidyl-1D-myo-inositol 4-phosphate\", \"Phosphatidylinositol 4-phosphate\", \"1-phosphatidyl-1D-myo-inositol 4-phosphates\"], \"producedByEvent\": [1676177], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-392417\", \"stIdVersion\": \"R-ALL-392417.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [1676177], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676082, \"displayName\": \"PI4P is phosphorylated to PI(4,5)P2 by PIP5K1A-C at the plasma membrane\", \"followingEvent\": [1676177], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI4P is phosphorylated to PI(4,5)P2 by PIP5K1A-C at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676082\", \"stIdVersion\": \"R-HSA-1676082.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 199456, \"displayName\": \"PTEN dephosphorylates PIP3\", \"followingEvent\": [1676177], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PTEN dephosphorylates PIP3\", \"PI(3,4,5)P3 is dephosphorylated to PI (4,5)P2 by PTEN at the plasma membrane\"], \"releaseDate\": \"2008-03-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-199456\", \"stIdVersion\": \"R-HSA-199456.5\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1675776, \"displayName\": \"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers at the plasma membrane\", \"followingEvent\": [1676177], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers at the plasma membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675776\", \"stIdVersion\": \"R-HSA-1675776.5\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676177\", \"stIdVersion\": \"R-HSA-1676177.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1676053, \"displayName\": \"At the plasma membrane, Synaptojanin-1 (SYNJ1) and -2 (SYNJ2...\", \"schemaClass\": \"Summation\", \"text\": \"At the plasma membrane, Synaptojanin-1 (SYNJ1) and -2 (SYNJ2), inositol polyphosphate 5-phosphatase K (INPP5K) aka SKIP, phosphatidylinositol 4,5-bisphosphate 5-phosphatase A (INPP5J) aka PIPP dephosphorylate phosphatidylinositol 4,5-bisphosphate (PI(4,5)P2) to form phosphatidylinositol 4-phosphate (PI4P).  SYNJ1/2 both have an N-terminal Sac1-like domain, a central 5-phosphatase domain and a C-terminal proline-rich segment, with this latter part being the most divergent part of the protein sequence.<br><br>The following lists the above proteins with their corresponding literature references: SYNJ1 (Johenning et al. 2004, Haffner et al. 1997, Guo et al. 1999, Mani et al. 2007), SYNJ2 (Malecz et al. 2000), INPP5K (Injuin et al. 2000, Gurung et al. 2003), and INPP5J (Gurung et al. 2003, Mochizuki & Takenawa 1999).\"}]}" ;
