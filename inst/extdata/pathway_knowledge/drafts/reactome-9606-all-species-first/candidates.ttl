<https://reactome.org/content/detail/R-HSA-163416> a mslm:LipidReaction ;
    rdfs:label "hormone-sensitive lipase (HSL) + 2 ATP -> phosphorylated HSL + 2 ADP" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "LIPE [cytosol] + ATP [cytosol] => p-S950,S951-LIPE [cytosol] + ADP [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [163416], \"className\": \"CatalystActivity\", \"dbId\": 163605, \"displayName\": \"protein serine/threonine kinase activity of PKA catalytic subunit [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 163416, \"displayName\": \"hormone-sensitive lipase (HSL) + 2 ATP -> phosphorylated HSL + 2 ADP\", \"followingEvent\": [163489], \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [163416], \"dbId\": 162503, \"displayName\": \"LIPE [cytosol]\", \"endCoordinate\": 1076, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LIPE\", \"Hormone Sensitve Lipase\", \"HSL\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-162503\", \"stIdVersion\": \"R-HSA-162503.1\", \"startCoordinate\": 1}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [163416, 163416], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, 113592], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"hormone-sensitive lipase (HSL) + 2 ATP -> phosphorylated HSL + 2 ADP\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 162472, \"displayName\": \"p-S950,S951-LIPE [cytosol]\", \"endCoordinate\": 1076, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"p-S950,S951-LIPE\", \"Phosphorylated Hormone Sensitive Lipase\"], \"producedByEvent\": [163416], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-162472\", \"stIdVersion\": \"R-HSA-162472.2\", \"startCoordinate\": 1}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [163416, 163416], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, 29370], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 111925, \"displayName\": \"cAMP induces dissociation of inactive PKA tetramers\", \"followingEvent\": [163416], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"cAMP induces dissociation of inactive PKA tetramers\"], \"releaseDate\": \"2008-12-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-111925\", \"stIdVersion\": \"R-HSA-111925.7\"}], \"releaseDate\": \"2005-06-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163416\", \"stIdVersion\": \"R-HSA-163416.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 163448, \"displayName\": \"Cytosolic rat HSL is phosphorylated on serine residues 659 a...\", \"schemaClass\": \"Summation\", \"text\": \"Cytosolic rat HSL is phosphorylated on serine residues 659 and 660 by protein kinase A catalytic subunit (Anthonsen et al. 1998; Su et al. 2003). Three isoforms of protein kinase A are known, but with no known differences in substrate specificity or tissue specific expression patterns, so a generic PKA (with all three forms as instances) is annotated as the catalyst of this reaction. Other serine residues in HSL can be phosphorylated both in vitro and in vivo, and while these other phosphorylations appear not to affect triacylglycerol hydrolysis by HSL directly, they may affect the efficiency with which serines 659 and 660 themselves are phosphorylated, or affect the efficiency with which HSL is translocated to cytosolic lipid particles (Holm et al. 2000).<p>Phosphorylation of human HSL has not been studied in detail, so the human reaction is inferred from the well-studied rat one. By BLAST alignment, human HSL residues 649 and 650 correspond to rat serines 659 and 660.\"}]}" ;
