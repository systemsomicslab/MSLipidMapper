    mslm:equation "ISCAL [mitochondrial matrix] => ISCAL [cytosol]" ;
    mslm:evidenceJson "{\"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 196125, \"displayName\": \"Translocation of isocaproaldehyde from the mitochondrial matrix to the cytosol\", \"followingEvent\": [196060], \"goBiologicalProcess\": {\"accession\": \"0170037\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 9910496, \"definition\": \"The directed movement of substances from the mitochondrion to the cytosol.\", \"displayName\": \"export from the mitochondrion\", \"name\": \"export from the mitochondrion\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0170037\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [196125], \"dbId\": 193046, \"displayName\": \"ISCAL [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ISCAL\", \"4-methylpentanal\", \"Isocaproic aldehyde\", \"isocaproaldehyde\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193046\", \"stIdVersion\": \"R-ALL-193046.4\"}], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Translocation of isocaproaldehyde from the mitochondrial matrix to the cytosol\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 196095, \"displayName\": \"ISCAL [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ISCAL\", \"4-methylpentanal\", \"Isocaproic aldehyde\", \"isocaproaldehyde\"], \"producedByEvent\": [196125], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-196095\", \"stIdVersion\": \"R-ALL-196095.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 193101, \"displayName\": \"CYP11A1 cleaves 20a,22b-DHCHOL\", \"followingEvent\": [196125], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYP11A1 cleaves 20a,22b-DHCHOL\", \"(20R,22R)-20,22-dihydroxycholesterol + 2 H(+) + O2 + 2 reduced (adrenodoxin) => 4-methylpentanal + 2 H2O + 2 oxidized (adrenodoxin) + pregnenolone\", \"20alpha,22beta-hydroxycholesterol is cleaved by CYP11A1 to yield pregnenolone and isocaproaldehyde\", \"20alpha,22beta-hydroxycholesterol + NADPH + H+ + O2 => pregnenolone + isocaproaldehyde + NADP+ + H2O\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193101\", \"stIdVersion\": \"R-HSA-193101.5\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-196125\", \"stIdVersion\": \"R-HSA-196125.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 196102, \"displayName\": \"Isocaproaldehyde (4-methylpentanal) is translocated from the...\", \"schemaClass\": \"Summation\", \"text\": \"Isocaproaldehyde (4-methylpentanal) is translocated from the mitochondrial matrix to the cytosol. The transporter that mediates this reaction is unknown. The reaction is inferred to exist because isocaproaldehyde is generated within the mitochondrion while the enzyme that reduces it to the corresponding alcohol is located in the cytosol (Matsuura et al. 1996).\"}]}" ;
