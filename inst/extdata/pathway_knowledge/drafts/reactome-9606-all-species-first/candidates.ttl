    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [194017], \"className\": \"CatalystActivity\", \"dbId\": 5600617, \"displayName\": \"steroid 11-beta-monooxygenase activity of CYP11B2 [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9907751, \"displayName\": \"RHEA:46105\", \"identifier\": \"46105\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/46105\"}], \"dbId\": 194017, \"displayName\": \"CYP11B2 oxidises 11DCORST to CORST\", \"followingEvent\": [193995], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [194017], \"dbId\": 193988, \"displayName\": \"11DCORST [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"11DCORST\", \"11-deoxycorticosterone\", \"cortexone\"], \"referenceType\": \"ReferenceMolecule\", \"s