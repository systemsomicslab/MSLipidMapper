    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [193052], \"className\": \"CatalystActivity\", \"dbId\": 193169, \"displayName\": \"steroid Delta-isomerase activity of HSD3B1 dimer, HSD3B2 dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690576, \"displayName\": \"RHEA:43929\", \"identifier\": \"43929\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/43929\"}], \"dbId\": 193052, \"displayName\": \"Pregn-5-ene-3,20-dione isomerizes to progesterone\", \"followingEvent\": [193072], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193052], \"dbId\": 196344, \"displayName\": \"pregn-5-ene-3,20-dione [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"pregn-5-ene-3,20-dione\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-196344\", \"stIdVersion\": \"R-ALL-196344.2\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\"