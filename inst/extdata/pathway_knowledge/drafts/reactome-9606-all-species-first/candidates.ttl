ate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-192067\", \"stIdVersion\": \"R-BTA-192067.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10248484, \"displayName\": \"4-cholesten-7alpha, 12alpha-diol-3-one is reduced to 5beta-cholesten-7alpha, 12alpha-diol-3-one\", \"inferredFrom\": [192067], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4-cholesten-7alpha, 12alpha-diol-3-one is reduced to 5beta-cholesten-7alpha, 12alpha-diol-3-one\", \"7alpha,12alpha-dihydroxycholest-4-en-3-one + H(+) + NADPH => 7alpha,12alpha-dihydroxy-5beta-cholestan-3-one + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-192067\", \"stIdVersion\": \"R-CFA-192067.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10128089, \"displayName\": \"4-cholesten-7alpha, 12alpha-diol-3-one is reduced to 5beta-cholesten-7alpha, 12alpha-diol-3-one\", \"inferredFrom\": [192067], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4-cholesten-7alpha, 12alpha-diol-3-one is reduced to 5beta-cholesten-7alpha, 12alpha-diol-3-one\", \"7alpha,12alpha-dihydroxycholest-4-en-3-one + H(+) + NADPH => 7alpha,12alpha-dihydroxy-5beta-cholestan-3-one + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-192067\", \"stIdVersion\": \"R-RNO-192067.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007155, \"displayName\": \"4-cholesten-7alpha, 12alpha-diol-3-one is reduced to 5beta-cholesten-7alpha, 12alpha-diol-3-one\", \"inferredFrom\": [192067], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4-cholesten-7alpha, 12alpha-diol-3-one is reduced to 5beta-cholesten-7alpha, 12alpha-diol-3-one\", \"7alpha,12alpha-dihydroxycholest-4-en-3-one + H(+) + NADPH => 7alpha,12alpha-dihydroxy-5beta-cholestan-3-one + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-192067\", \"stIdVersion\": \"R-MMU-192067.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192064, \"displayName\": \"5beta-cholesten-7alpha, 12alpha-diol-3-one [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholesten-7alpha, 12alpha-diol-3-one\", \"7alpha,12alpha-dihydroxy-5beta-cholestan-3-one\"], \"producedByEvent\": [192067], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192064\", \"stIdVersion\": \"R-ALL-192064.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [192067], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 192157, \"displayName\": \"CYP8B1 12-hydroxylates 4CHOL7aOLONE\", \"followingEvent\": [192067], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CYP8B1 12-hydroxylates 4CHOL7aOLONE\", \"7alpha-hydroxycholest-4-en-3-one + O2 + reduced (NADPH--hemoprotein reductase) => 7alpha,12alpha-dihydroxycholest-4-en-3-one + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\", \"4-Cholesten-7alpha-ol-3-one is 12alpha-hydroxylated to 7-alpha,12-alpha-dihydroxycholest-4-en-3-one\", \"7-alpha-hydroxycholest-4-en-3-one + NADPH + H+ + O2 => 7-alpha,12-alpha-dihydroxycholest-4-en-3-one + NADP+ + H2O\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192157\", \"stIdVersion\": \"R-HSA-192157.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192067\", \"stIdVersion\": \"R-HSA-192067.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 192052, \"displayName\": \"4-Cholesten-7alpha, 12alpha-diol-3-one and NADPH + H+ react ...\", \"schemaClass\": \"Summation\", \"text\": \"4-Cholesten-7alpha, 12alpha-diol-3-one and NADPH + H+ react to form 5beta-cholesten-7alpha,12alpha-diol-3-one + NADP+. This reaction is catalyzed by AKR1D1 (3-oxo-5-beta-steroid 4-dehydrogenase). AKR1D1 is localized to the cytosol, and in the course of the reaction its steroid substrate moves from the endoplasmic reticulum membrane to the cytosol. It is unclear whether this translocation results simply from its increased hydrophilicity or is mediated by the enzyme or another transport protein (Russell 2003).\"}]}" ;
