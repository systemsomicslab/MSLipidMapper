\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [5696448], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"releaseDate\": \"2015-09-22\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5696448\", \"stIdVersion\": \"R-HSA-5696448.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5696450, \"displayName\": \"Acyl-CoA wax alcohol acyltransferase 2 (AWAT2 aka MFAT) is a...\", \"schemaClass\": \"Summation\", \"text\": \"Acyl-CoA wax alcohol acyltransferase 2 (AWAT2 aka MFAT) is an enzyme highly expressed in skin and thought to play an important role in lipid metabolism in skin. AWAT2 can transfer an acyl group from acyl-CoA to monoacylglycerol, long-chain alcohol, and retinol to form diacylglycerols, wax monoesters and retinyl esters, respectively. Human skin surface lipids are mainly composed of triacylglycerol and wax monoesters (Yen et al. 2005, Turkish et al. 2005).\"}]}" ;
