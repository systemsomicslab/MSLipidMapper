\": \"Reaction\", \"dbId\": 10645307, \"displayName\": \"ALOX5 oxidises 17(S)-Hp-DPAn-3 to 7,17-diHp-DPAn-3\", \"inferredFrom\": [9025996], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 17(S)-Hp-DPAn-3 to 7,17-diHp-DPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9025996\", \"stIdVersion\": \"R-DRE-9025996.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10551191, \"displayName\": \"ALOX5 oxidises 17(S)-Hp-DPAn-3 to 7,17-diHp-DPAn-3\", \"inferredFrom\": [9025996], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 17(S)-Hp-DPAn-3 to 7,17-diHp-DPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9025996\", \"stIdVersion\": \"R-SSC-9025996.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10437782, \"displayName\": \"ALOX5 oxidises 17(S)-Hp-DPAn-3 to 7,17-diHp-DPAn-3\", \"inferredFrom\": [9025996], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 17(S)-Hp-DPAn-3 to 7,17-diHp-DPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9025996\", \"stIdVersion\": \"R-BTA-9025996.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10323902, \"displayName\": \"ALOX5 oxidises 17(S)-Hp-DPAn-3 to 7,17-diHp-DPAn-3\", \"inferredFrom\": [9025996], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 17(S)-Hp-DPAn-3 to 7,17-diHp-DPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9025996\", \"stIdVersion\": \"R-CFA-9025996.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10216011, \"displayName\": \"ALOX5 oxidises 17(S)-Hp-DPAn-3 to 7,17-diHp-DPAn-3\", \"inferredFrom\": [9025996], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 17(S)-Hp-DPAn-3 to 7,17-diHp-DPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9025996\", \"stIdVersion\": \"R-RNO-9025996.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10092799, \"displayName\": \"ALOX5 oxidises 17(S)-Hp-DPAn-3 to 7,17-diHp-DPAn-3\", \"inferredFrom\": [9025996], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 17(S)-Hp-DPAn-3 to 7,17-diHp-DPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9025996\", \"stIdVersion\": \"R-MMU-9025996.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9026034, \"displayName\": \"7,17-diHp-DPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7,17-diHp-DPAn-3\", \"(8E,10Z,13Z,15E,19Z)-7,17-bis(hydroperoxy)docosapentaenoate\", \"7,17-diHpDPA(n-3)(1-)\", \"(8E,10Z,13Z,15E,19Z)-7,17-bis(hydroperoxy)docosapentaenoic acid\", \"7,17-dihydroperoxy-omega3-docosapentaenoic acid\", \"7,17-dihydroperoxy-docosapentaenoic acid\"], \"producedByEvent\": [9025996], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9026034\", \"stIdVersion\": \"R-ALL-9026034.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9026003, \"displayName\": \"ALOX15 oxidises DPAn-3 to 17(S)-Hp-DPAn-3\", \"followingEvent\": [9025996], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX15 oxidises DPAn-3 to 17(S)-Hp-DPAn-3\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026003\", \"stIdVersion\": \"R-HSA-9026003.3\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9025996\", \"stIdVersion\": \"R-HSA-9025996.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9026052, \"displayName\": \"In an alternative route to the production of protectins PD1n...\", \"schemaClass\": \"Summation\", \"text\": \"In an alternative route to the production of protectins PD1n-3DPA and PD2n-3DPA, 17(S)-hydroperoxy-docosapentaenoic acid (17(S)-Hp-DPAn-3) can be further oxygenated by a lipoxygenase to form 7,17-dihydroperoxy-docosapentaenoic acid (7,17-diHp-DPAn-3) (Dalli et al. 2013). Although this is a proposed biosynthetic route, it is assumed DPAn-3-derived SPMs follow a similar synthesis route to DHA- and EPA-derived SPMs therefore the lipoxygenase could be the dual-functional 5-lipoxygenase (ALOX5).\"}]}" ;
