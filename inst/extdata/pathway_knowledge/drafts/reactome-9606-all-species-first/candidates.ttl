    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9020260], \"className\": \"CatalystActivity\", \"dbId\": 9024806, \"displayName\": \"oxidoreductase activity of Hydroperoxy reductase [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9020260, \"displayName\": \"Hydroperoxy reductase reduces 7(S)-Hp-17(S)-HDHA to RvD5\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9020260], \"dbId\": 9024765, \"displayName\": \"7(S)-Hp-17(S)-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7(S)-Hp-17(S)-HDHA\", \"7(S)-hydroperoxy-17(S)-hydroxydocosahexaenoate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024765\", \"stIdVersion\": \"R-ALL-9024765.4\"}, {\"className\": \"OtherEntity\", \"consumedByEvent\": [9020260], \"dbId\": 5359016, \"displayName\": \"reduced acceptor [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"reduced acceptor\", \"XH2\"], \"schemaClass\": \"OtherEntity\", \"stId\": \"R-ALL-5359016\", \"stIdVersion\": \"R-ALL-5359016.2\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9022657, \"displayName\": \"Resolvins: a family of bioactive products of omega-3 fatty acid transformation circuits initiated by aspirin treatment that counter proinflammation signals\", \"journal\": \"J. Exp. Med.\", \"pages\": \"1025-37\", \"pubMedIdentifier\": 12391014, \"schemaClass\": \"LiteratureReference\", \"title\": \"Resolvins: a family of bioactive products of omega-3 fatty acid transformation circuits initiated by aspirin treatment that counter proinflammation signals\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/12391014\", \"volume\": 196, \"year\": 2002}], \"maxDepth\": 1, \"name\": [\"Hydroperoxy reductase reduces 7(S)-Hp-17(S)-HDHA to RvD5\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9024795, \"displayName\": \"resolvin D5 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"resolvin D5\", \"resolvin D5(1-)\", \"RvD5\", \"17(S)-resolvin D5\"], \"producedByEvent\": [9020260], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024795\", \"stIdVersion\": \"R-ALL-9024795.3\"}, {\"className\": \"OtherEntity\", \"dbId\": 9024637, \"displayName\": \"oxidised acceptor [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"oxidised acceptor\"], \"producedByEvent\": [9020260], \"schemaClass\": \"OtherEntity\", \"stId\": \"R-ALL-9024637\", \"stIdVersion\": \"R-ALL-9024637.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9020282, \"displayName\": \"ALOX5 oxidises 17(S)-HDHA to 7(S)-Hp-17(S)-HDHA\", \"followingEvent\": [9020260], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 17(S)-HDHA to 7(S)-Hp-17(S)-HDHA\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9020282\", \"stIdVersion\": \"R-HSA-9020282.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9020260\", \"stIdVersion\": \"R-HSA-9020260.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9024808, \"displayName\": \"An unknown hydroperoxy reductase mediates the reduction of 7...\", \"schemaClass\": \"Summation\", \"text\": \"An unknown hydroperoxy reductase mediates the reduction of 7(S)-hydroperoxy-17(S)-hydroxydocosahexaenoic acid (7(S)-Hp-17(S)-HDHA) to 7(S),17(S)-dihydroxydocosahexaenoic acid (AT-RvD5) (Serhan et al. 2002).\"}]}" ;
