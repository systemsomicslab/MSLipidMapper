nd\", \"dbId\": 1606573, \"displayName\": \"GalCer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GalCer\", \"galactosylceramide\", \"D-galactosyl-N-acylsphingosine\", \"N-acyl-beta-D-galactosylsphingosine\", \"Galactocerebroside\", \"Galactosylceramide\"], \"producedByEvent\": [1606807], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1606573\", \"stIdVersion\": \"R-ALL-1606573.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1606845, \"displayName\": \"SO4(2-) [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SO4(2-)\", \"sulfate\"], \"producedByEvent\": [1606807], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1606845\", \"stIdVersion\": \"R-ALL-1606845.3\"}, {\"className\": \"Complex\", \"dbId\": 9840482, \"displayName\": \"PSAP(195-273) dimer [lysosomal lumen]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"PSAP(195-273) dimer\", \"Sap B dimer\"], \"producedByEvent\": [1606807], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840482\", \"stIdVersion\": \"R-HSA-9840482.1\"}, {\"className\": \"Set\", \"dbId\": 9840939, \"displayName\": \"PE 30,32,34 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PE 30,32,34\"], \"producedByEvent\": [1606807], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9840939\", \"stIdVersion\": \"R-ALL-9840939.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 428040, \"displayName\": \"H+ [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [1606807], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428040\", \"stIdVersion\": \"R-ALL-428040.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2248891, \"displayName\": \"M6PR transports activated ARSA to the lysosome\", \"followingEvent\": [1606807], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"M6PR transports activated ARSA to the lysosome\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2248891\", \"stIdVersion\": \"R-HSA-2248891.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9840470, \"displayName\": \"PSAP(195-273) dimer:PE binds and mobilizes ligands\", \"followingEvent\": [1606807], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PSAP(195-273) dimer:PE binds and mobilizes ligands\"], \"releaseDate\": \"2023-09-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840470\", \"stIdVersion\": \"R-HSA-9840470.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1606807\", \"stIdVersion\": \"R-HSA-1606807.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1606838, \"displayName\": \"Arylsulfatase A (ARSA) hydrolyses a sulfatide (cerebroside 3...\", \"schemaClass\": \"Summation\", \"text\": \"Arylsulfatase A (ARSA) hydrolyses a sulfatide (cerebroside 3-sulfate, SM4) to form a cerebroside and sulfate Stinshoff & Jatzkewitz, 1975). Saposin B (PSAP(195-273)) is a promiscuous lipid-binding and transfer protein and an essential cofactor for the lysosomal hydrolysis of sulfatide by ARSA. It binds sulfatides in soluble stoichiometric complexes, which ARSA recognizes as substrates (Fischer & Jatzkewitz, 1975). ARSA is present in the lysosomal lumen and comprises two chains, components B and C, linked by disulfide bonds (Stein et al. 1989, Fujii et al. 1992). The conversion to 3-oxoalanine (formylglycine, FGly) of a cysteine residue is critical for catalytic activity in all eukaryotes (Chruszcz et al. 2003, Lukatela et al. 1998).<br>Defects in ARSA are a cause of metachromatic leukodystrophy (MLD) (MIM:250100), characterized by lysosomal storage of cerebroside-3-sulfate in neural and non-neural tissues (Gieselmann et al. 1991, Polten et al. 1991). Arylsulfatase A activity is reduced in multiple sulfatase deficiency (MSD) (MIM:272200), a disorder characterized by decreased activity of sulfatases. The defect is due to the lack of post-translational modification of the critical cysteine needed for activity (Schmidt et al. 1995). In metachromatic leukodystrophy due to saposin B deficiency (MLDSAPB, MIM:249290) sulfatide accumulates because of the missing cofactor saposin B (Regis et al., 1999).\"}]}" ;
