    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}, {\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 1592238, \"displayName\": \"Expression of ALAS1\", \"goBiologicalProcess\": {\"accession\": \"0045944\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 17788, \"definition\": \"Any process that activates or increases the frequency, rate or extent of transcription from an RNA polymerase II promoter.\", \"displayName\": \"positive regulation of transcription by RNA polymerase II\", \"name\": \"positive regulation of transcription by RNA polymerase II\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0045944\"}, \"input\": [{\"className\": \"DNA Sequence\", \"consumedByEvent\": [1592238], \"dbId\": 2466373, \"displayName\": \"ALAS1 gene [nucleoplasm]\", \"endCoordinate\": -1, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ALAS1 gene\"], \"referenceType\": \"ReferenceDNASequence\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2466373\", \"stIdVersion\": \"R-HSA-2466373.1\", \"startCoordinate\": 1}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1605432, \"displayName\": \"Differential regulation of human ALAS1 mRNA and protein levels by heme and cobalt protoporphyrin\", \"journal\": \"Mol Cell Biochem\", \"pages\": \"153-61\", \"pubMedIdentifier\": 18719978, \"schemaClass\": \"LiteratureReference\", \"title\": \"Differential regulation of human ALAS1 mRNA and protein levels by heme and cobalt protoporphyrin\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18719978\", \"volume\": 319, \"year\": 2008}, {\"className\": \"LiteratureReference\", \"dbId\": 1605543, \"displayName\": \"Alternative splicing and tissue-specific transcription of human and rodent ubiquitous 5-aminolevulinate synthase (ALAS1) genes\", \"journal\": \"Biochim Biophys Acta\", \"pages\": \"95-105\", \"pubMedIdentifier\": 11267664, \"schemaClass\": \"LiteratureReference\", \"title\": \"Alternative splicing and tissue-specific transcription of human and rodent ubiquitous 5-aminolevulinate synthase (ALAS1) genes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/11267664\", \"volume\": 1518, \"year\": 2001}], \"maxDepth\": 1, \"name\": [\"Expression of ALAS1\", \"Expression of 5-aminolevulinate synthase 1\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 189438, \"displayName\": \"ALAS1 [mitochondrial matrix]\", \"endCoordinate\": 640, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ALAS1\", \"5-aminolevulinate synthase, non-specific\", \"HEM1_HUMAN\", \"5-aminolevulinate synthase, non-specific, mitochondrial\"], \"producedByEvent\": [1592238], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-189438\", \"stIdVersion\": \"R-HSA-189438.1\", \"startCoordinate\": 57}], \"precedingEvent\": [{\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 1592245, \"displayName\": \"NRF1:PPARGC1B binds the ALAS1 promoter\", \"followingEvent\": [1592238], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NRF1:PPARGC1B binds the ALAS1 promoter\"], \"releaseDate\": \"2014-03-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1592245\", \"stIdVersion\": \"R-HSA-1592245.2\"}, {\"category\": \"uncertain\", \"className\": \"Reaction\", \"dbId\": 400143, \"displayName\": \"Fatty acid ligands activate PPARA\", \"followingEvent\": [1592238], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Fatty acid ligands activate PPARA\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-400143\", \"stIdVersion\": \"R-HSA-400143.4\"}], \"regulatedBy\": [{\"className\": \"PositiveGeneExpressionRegulation\", \"dbId\": 1605570, \"displayName\": \"Positive gene expression regulation by 'ESRRA [nucleoplasm]'\", \"regulatedEntity\": [1592238], \"schemaClass\": \"PositiveGeneExpressionRegulation\", \"stId\": \"R-HSA-1605570\", \"stIdVersion\": \"R-HSA-1605570.1\"}, {\"className\": \"PositiveGeneExpressionRegulation\", \"dbId\": 1989808, \"displayName\": \"Positive gene expression regulation by 'PPARA:RXRA Coactivator complex [nucleoplasm]'\", \"regulatedEntity\": [1592238], \"schemaClass\": \"PositiveGeneExpressionRegulation\", \"stId\": \"R-HSA-1989808\", \"stIdVersion\": \"R-HSA-1989808.1\"}, {\"className\": \"PositiveGeneExpressionRegulation\", \"dbId\": 5649960, \"displayName\": \"Positive gene expression regulation by 'ALAS1 gene:NRF1:PPARGC1B [nucleoplasm]'\", \"regulatedEntity\": [1592238], \"schemaClass\": \"PositiveGeneExpressionRegulation\", \"stId\": \"R-HSA-5649960\", \"stIdVersion\": \"R-HSA-5649960.3\"}], \"regulationReference\": [{\"className\": \"RegulationReference\", \"dbId\": 9642030, \"displayName\": \"Positive gene expression regulation by 'PPARA:RXRA Coactivator complex [nucleoplasm]' Comparative analysis of gene regulation by the transcription factor PPARalpha between mouse and human\", \"schemaClass\": \"RegulationReference\"}, {\"className\": \"RegulationReference\", \"dbId\": 9642599, \"displayName\": \"Positive gene expression regulation by 'ESRRA [nucleoplasm]' PGC-1 beta-regulated mitochondrial biogenesis and function in myotubes is mediated by NRF-1 and ERR alpha\", \"schemaClass\": \"RegulationReference\"}, {\"className\": \"RegulationReference\", \"dbId\": 9642916, \"displayName\": \"Positive gene expression regulation by 'ALAS1 gene:NRF1:PPARGC1B [nucleoplasm]' Differential regulation of human ALAS1 mRNA and protein levels by heme and cobalt protoporphyrin\", \"schemaClass\": \"RegulationReference\"}], \"releaseDate\": \"2011-12-06\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1592238\", \"stIdVersion\": \"R-HSA-1592238.7\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1605456, \"displayName\": \"The ALAS1 gene is transcribed to yield mRNA and the mRNA is ...\", \"schemaClass\": \"Summation\", \"text\": \"The ALAS1 gene is transcribed to yield mRNA and the mRNA is translated in the cytosol to yield precursor protein. The ALAS1 precursor is imported into the mitochodrial matrix where it catalyzes the synthesis of 5-aminolevulinate from glycine and succinyl-CoA as part of heme biosynthesis.\"}, {\"className\": \"Summation\", \"dbId\": 1605581, \"displayName\": \"ERR1 (ERRalpha) probably interacts with coactivator PG-1beta...\", \"schemaClass\": \"Summation\", \"text\": \"ERR1 (ERRalpha) probably interacts with coactivator PG-1beta to activate ALAS1 (Shao et al. Shao et al. 2010).\"}]}" ;
