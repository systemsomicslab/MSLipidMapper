    mslm:equation "p-S950,S951-LIPE [cytosol] => phosphorylated HSL dimer [cytosol]" ;
    mslm:evidenceJson "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 163602, \"displayName\": \"2 phosphorylated HSL monomers -> phosphorylated HSL dimer\", \"followingEvent\": [163554], \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [163602, 163602], \"dbId\": 162472, \"displayName\": \"p-S950,S951-LIPE [cytosol]\", \"endCoordinate\": 1076, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"p-S950,S951-LIPE\", \"Phosphorylated Hormone Sensitive Lipase\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-162472\", \"stIdVersion\": \"R-HSA-162472.2\", \"startCoordinate\": 1}, 162472], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2 phosphorylated HSL monomers -> phosphorylated HSL dimer\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 163513, \"displayName\": \"phosphorylated HSL dimer [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"phosphorylated HSL dimer\"], \"producedByEvent\": [163602], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163513\", \"stIdVersion\": \"R-HSA-163513.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 163416, \"displayName\": \"hormone-sensitive lipase (HSL) + 2 ATP -> phosphorylated HSL + 2 ADP\", \"followingEvent\": [163602], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"hormone-sensitive lipase (HSL) + 2 ATP -> phosphorylated HSL + 2 ADP\"], \"releaseDate\": \"2005-06-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163416\", \"stIdVersion\": \"R-HSA-163416.3\"}], \"releaseDate\": \"2005-04-11\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163602\", \"stIdVersion\": \"R-HSA-163602.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 163486, \"displayName\": \"While both monomeric and homodimeric forms of rat HSL protei...\", \"schemaClass\": \"Summation\", \"text\": \"While both monomeric and homodimeric forms of rat HSL protein have been detected, the predominant species, and the one with substantially greater catalytic activity when activated by phosphorylation, is the homodimer so HSL-mediated lipolysis is annotated in Reactome with dimeric phosphorylated enzyme as the catalyst. Phosphorylation appears to be required for dimerization to proceed (Shen et al. 2000).<p>Dimerization of human HSL has not been studied in detail, so the human reaction is inferred from the well-studied rat one.\"}]}" ;
