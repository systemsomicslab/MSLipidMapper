    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [1605797], \"className\": \"CatalystActivity\", \"dbId\": 1605754, \"displayName\": \"sphingomyelin phosphodiesterase activity of SMPD1 [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 1605797, \"displayName\": \"SMPD1 hydrolyzes SPHM\", \"followingEvent\": [1606602], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1605797], \"dbId\": 1605713, \"displayName\": \"SPHM d18:1 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SPHM d18:1\", \"sphingomyelin d18:1\", \"sphingomyelins\", \"ceramide phosphocholines\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605713\", \"stIdVersion\": \"R-ALL-1605713.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [1605797], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1605680, \"displayName\": \"Human acid sphingomyelinase. Isolation, nucleotide sequence and expression of the full-length and alternatively spliced cDNAs\", \"journal\": \"J Biol Chem\", \"pages\": \"8531-9\", \"pubMedIdentifier\": 1840600, \"schemaClass\": \"LiteratureReference\", \"title\": \"Human acid sphingomyelinase. Isolation, nucleotide sequence and expression of the full-length and alternatively spliced cDNAs\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/1840600\", \"volume\": 266, \"year\": 1991}, {\"className\": \"LiteratureReference\", \"dbId\": 1605801, \"displayName\": \"Structural organization and complete nucleotide sequence of the gene encoding human acid sphingomyelinase (SMPD1)\", \"journal\": \"Genomics\", \"pages\": \"197-205\", \"pubMedIdentifier\": 1740330, \"schemaClass\": \"LiteratureReference\", \"title\": \"Structural organization and complete nucleotide sequence of the gene encoding human acid sphingomyelinase (SMPD1)\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/1740330\", \"volume\": 12, \"year\": 1992}, {\"className\": \"LiteratureReference\", \"dbId\": 1605648, \"displayName\": \"Molecular basis of acid sphingomyelinase deficiency in a patient with Niemann-Pick disease type A\", \"journal\": \"Biochem Biophys Res Commun\", \"pages\": \"1187-91\", \"pubMedIdentifier\": 1718266, \"schemaClass\": \"LiteratureReference\", \"title\": \"Molecular basis of acid sphingomyelinase deficiency in a patient with Niemann-Pick disease type A\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/1718266\", \"volume\": 179, \"year\": 1991}, {\"className\": \"LiteratureReference\", \"dbId\": 1605729, \"displayName\": \"Identification and characterization of SMPD1 mutations causing Niemann-Pick types A and B in Spanish patients\", \"journal\": \"Hum Mutat\", \"pages\": \"1117-22\", \"pubMedIdentifier\": 19405096, \"schemaClass\": \"LiteratureReference\", \"title\": \"Identification and characterization of SMPD1 mutations causing Niemann-Pick types A and B in Spanish patients\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/19405096\", \"volume\": 30, \"year\": 2009}], \"maxDepth\": 1, \"name\": [\"SMPD1 hydrolyzes SPHM\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10276313, \"dis