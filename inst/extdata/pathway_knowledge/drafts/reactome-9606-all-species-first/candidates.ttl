    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [193995], \"className\": \"CatalystActivity\", \"dbId\": 193967, \"displayName\": \"steroid hydroxylase activity of CYP11B2 [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 9907747, \"displayName\": \"RHEA:11873\", \"identifier\": \"11873\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/11873\"}], \"dbId\": 193995, \"displayName\": \"CYP11B2 18-hydroxylates CORST to 18HCORST\", \"followingEvent\": [193965], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [193995], \"dbId\": 194005, \"displayName\": \"CORST [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CORST\", \"corticosterone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \