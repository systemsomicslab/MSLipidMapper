on\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-193455\", \"stIdVersion\": \"R-RNO-193455.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10007425, \"displayName\": \"(24R, 25R) 3alpha,7alpha,12alpha,24-tetrahydroxy-5beta-cholestanoyl-CoA is oxidized to 3alpha,7alpha,12alpha-trihydroxy-5beta-cholest-24-one-CoA\", \"inferredFrom\": [193455], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"(24R, 25R) 3alpha,7alpha,12alpha,24-tetrahydroxy-5beta-cholestanoyl-CoA is oxidized to 3alpha,7alpha,12alpha-trihydroxy-5beta-cholest-24-one-CoA\", \"(24R,25R)-3alpha,7alpha,12alpha,24-tetrahydroxy-5beta-cholestan-26-oyl-CoA + NAD(+) = 3alpha,7alpha,12alpha-trihydroxy-24-oxo-5beta-cholestan-26-oyl-CoA + H(+) + NADH\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-193455\", \"stIdVersion\": \"R-MMU-193455.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192339, \"displayName\": \"3a,7a,12a-trihydroxy-5b-cholest-24-one-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3a,7a,12a-trihydroxy-5b-cholest-24-one-CoA\", \"3alpha,7alpha,12alpha-trihydroxy-24-oxo-5beta-cholestan-26-oyl-CoA(4-)\"], \"producedByEvent\": [193455], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192339\", \"stIdVersion\": \"R-ALL-192339.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 192305, \"displayName\": \"NADH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [193455], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192305\", \"stIdVersion\": \"R-ALL-192305.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [193455], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 192331, \"displayName\": \"3alpha,7alpha,12alpha-trihydroxy-5beta-cholest-24-enoyl-CoA (THCA-CoA) is hydrated to (24R, 25R) 3alpha,7alpha,12alpha,24-tetrahydroxy-5beta-cholestanoyl-CoA\", \"followingEvent\": [193455], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"3alpha,7alpha,12alpha-trihydroxy-5beta-cholest-24-enoyl-CoA (THCA-CoA) is hydrated to (24R, 25R) 3alpha,7alpha,12alpha,24-tetrahydroxy-5beta-cholestanoyl-CoA\", \"(24E)-3alpha,7alpha,12alpha-trihydroxy-5beta-cholest-24-en-26-oyl-CoA + H2O => (24R,25R)-3alpha,7alpha,12alpha,24-tetrahydroxy-5beta-cholestan-26-oyl-CoA\"], \"releaseDate\": \"2007-05-15\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-192331\", \"stIdVersion\": \"R-HSA-192331.3\"}], \"releaseDate\": \"2007-05-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-193455\", \"stIdVersion\": \"R-HSA-193455.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 193445, \"displayName\": \"(24R, 25R) 3alpha,7alpha,12alpha,24-tetrahydroxy-5beta-chole...\", \"schemaClass\": \"Summation\", \"text\": \"(24R, 25R) 3alpha,7alpha,12alpha,24-tetrahydroxy-5beta-cholestanoyl-CoA and NAD+ react to form 3alpha,7alpha,12alpha-trihydroxy-5beta-cholest-24-one-CoA,  NADH, and H+. This oxidation reaction, catalyzed by the peroxisomal D-bifunctional enzyme (Huyghe et al. 2006), occurs in the peroxisomal matrix (Ferdinandusse et al. 2000).\"}]}" ;
