    mslm:evidenceJson "{\"category\": \"uncertain\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9028263, \"displayName\": \"PGJ3 isomerises to δ12-PGJ3\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9028263], \"dbId\": 9028230, \"displayName\": \"PGJ3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGJ3\", \"prostaglandin J3(1-)\", \"prostaglandin J3\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9028230\", \"stIdVersion\": \"R-ALL-9028230.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9028221, \"displayName\": \"Albumin-catalyzed metabolism of prostaglandin D2. Identification of products formed in vitro\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"11713-8\", \"pubMedIdentifier\": 6578214, \"schemaClass\": \"LiteratureReference\", \"title\": \"Albumin-catalyzed metabolism of prostaglandin D2. Identification of products formed in vitro\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/6578214\", \"volume\": 258, \"year\": 1983}], \"maxDepth\": 1, \"name\": [\"PGJ3 isomerises to δ12-PGJ3\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9028201, \"displayName\": \"δ12-PGJ3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"δ12-PGJ3\", \"Delta(12)-prostaglandin J3(1-)\", \"Delta(12)-prostaglandin J3\", \"delta-12-prostaglandin-J3\", \"δ12-prostaglandin-J3\"], \"producedByEvent\": [9028263], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9028201\", \"stIdVersion\": \"R-ALL-9028201.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9028273, \"displayName\": \"PGH3 spontaneously dehydrates to PGJ3\", \"followingEvent\": [9028263], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PGH3 spontaneously dehydrates to PGJ3\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9028273\", \"stIdVersion\": \"R-HSA-9028273.2\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9028263\", \"stIdVersion\": \"R-HSA-9028263.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9028224, \"displayName\": \"It is proposed that prostaglandin J3 (PGJ3) isomerises to pr...\", \"schemaClass\": \"Summation\", \"text\": \"It is proposed that prostaglandin J3 (PGJ3) isomerises to prostaglandin δ12-PGJ3 (δ12-PGJ3) (Fitzpatrick et al. 1983, Shibata et al. 2002). EPA supplementation to mice resulted in enhanced endogenous production of δ12-PGJ3, which was found to possess chemoprotective activity against myleoid leukemia, ablating leukemia stem cells in mice (Hegde et al. 2011, Finch et al. 2015).\"}]}" ;
