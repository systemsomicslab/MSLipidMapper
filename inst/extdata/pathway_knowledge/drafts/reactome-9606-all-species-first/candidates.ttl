    mslm:equation "ACBD6 [cytosol] + LCFA-CoA [cytosol] => ACBD6:LCFA-CoA [cytosol]" ;
    mslm:evidenceJson "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 8848250, \"displayName\": \"ACBD6 binds LCFA-CoA\", \"goBiologicalProcess\": {\"accession\": \"0006637\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 8047, \"definition\": \"The chemical reactions and pathways involving acyl-CoA, any derivative of coenzyme A in which the sulfhydryl group is in thiolester linkage with an acyl group.\", \"displayName\": \"acyl-CoA metabolic process\", \"name\": \"acyl-CoA metabolic process\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006637\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [8848250], \"dbId\": 8848243, \"displayName\": \"ACBD6 [cytosol]\", \"endCoordinate\": 282, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ACBD6\", \"Acyl-CoA-binding domain-containing protein 6\", \"ACBD6_HUMAN\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8848243\", \"stIdVersion\": \"R-HSA-8848243.2\", \"startCoordinate\": 1}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8848250], \"dbId\": 164991, \"displayName\": \"LCFA-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA-CoA\", \"long-chain fatty acyl-CoA(4-)\", \"long-chain fatty acyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-164991\", \"stIdVersion\": \"R-ALL-164991.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8848277, \"displayName\": \"Characterization of an acyl-coenzyme A binding protein predominantly expressed in human primitive progenitor cells\", \"journal\": \"J. Lipid Res.\", \"pages\": \"1103-12\", \"pubMedIdentifier\": 18268358, \"schemaClass\": \"LiteratureReference\", \"title\": \"Characterization of an acyl-coenzyme A binding protein predominantly expressed in human primitive progenitor cells\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/18268358\", \"volume\": 49, \"year\": 2008}, {\"className\": \"LiteratureReference\", \"dbId\": 8848276, \"displayName\": \"Ligand binding to the ACBD6 protein regulates the acyl-CoA transferase reactions in membranes\", \"journal\": \"J. Lipid Res.\", \"pages\": \"1961-71\", \"pubMedIdentifier\": 26290611, \"schemaClass\": \"LiteratureReference\", \"title\": \"Ligand binding to the ACBD6 protein regulates the acyl-CoA transferase reactions in membranes\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/26290611\", \"volume\": 56, \"year\": 2015}], \"maxDepth\": 1, \"name\": [\"ACBD6 binds LCFA-CoA\"], \"orthologousEvent\": [{\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 11131986, \"displayName\": \"ACBD6 binds LCFA-CoA\", \"inferredFrom\": [8848250], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD6 binds LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Plasmodium falciparum\", \"stId\": \"R-PFA-8848250\", \"stIdVersion\": \"R-PFA-8848250.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 11045062, \"displayName\": \"ACBD6 binds LCFA-CoA\", \"inferredFrom\": [8848250], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD6 binds LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-8848250\", \"stIdVersion\": \"R-DDI-8848250.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10987593, \"displayName\": \"ACBD6 binds LCFA-CoA\", \"inferredFrom\": [8848250], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD6 binds LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-8848250\", \"stIdVersion\": \"R-CEL-8848250.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10901251, \"displayName\": \"ACBD6 binds LCFA-CoA\", \"inferredFrom\": [8848250], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD6 binds LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8848250\", \"stIdVersion\": \"R-DME-8848250.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10812272, \"displayName\": \"ACBD6 binds LCFA-CoA\", \"inferredFrom\": [8848250], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD6 binds LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-8848250\", \"stIdVersion\": \"R-GGA-8848250.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10718957, \"displayName\": \"ACBD6 binds LCFA-CoA\", \"inferredFrom\": [8848250], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD6 binds LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8848250\", \"stIdVersion\": \"R-XTR-8848250.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10636220, \"displayName\": \"ACBD6 binds LCFA-CoA\", \"inferredFrom\": [8848250], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD6 binds LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-8848250\", \"stIdVersion\": \"R-DRE-8848250.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10539525, \"displayName\": \"ACBD6 binds LCFA-CoA\", \"inferredFrom\": [8848250], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD6 binds LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8848250\", \"stIdVersion\": \"R-SSC-8848250.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10425934, \"displayName\": \"ACBD6 binds LCFA-CoA\", \"inferredFrom\": [8848250], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD6 binds LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8848250\", \"stIdVersion\": \"R-BTA-8848250.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10312564, \"displayName\": \"ACBD6 binds LCFA-CoA\", \"inferredFrom\": [8848250], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD6 binds LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8848250\", \"stIdVersion\": \"R-CFA-8848250.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10203485, \"displayName\": \"ACBD6 binds LCFA-CoA\", \"inferredFrom\": [8848250], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD6 binds LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8848250\", \"stIdVersion\": \"R-RNO-8848250.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10080706, \"displayName\": \"ACBD6 binds LCFA-CoA\", \"inferredFrom\": [8848250], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD6 binds LCFA-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8848250\", \"stIdVersion\": \"R-MMU-8848250.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 8848271, \"displayName\": \"ACBD6:LCFA-CoA [cytosol]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"ACBD6:LCFA-CoA\"], \"producedByEvent\": [8848250], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8848271\", \"stIdVersion\": \"R-HSA-8848271.2\"}], \"releaseDate\": \"2016-06-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8848250\", \"stIdVersion\": \"R-HSA-8848250.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8848272, \"displayName\": \"Acyl-CoA-binding domain-containing protein 6 (ACBD6) has an ...\", \"schemaClass\": \"Summation\", \"text\": \"Acyl-CoA-binding domain-containing protein 6 (ACBD6) has an acyl-CoA binding domain at its N terminus and two ankyrin motifs at its C terminus. ACBD6 binds long-chain acyl-CoAs (LCFA-CoA) with a strong preference for unsaturated, C18:1-CoA and C20:4-CoA, over saturated, C16:0-CoA substrates. ACBD6 is expressed in tissues and progenitor cells with functions in blood and vessel development (Soupene et al. 2008). A possible role of ACBD6 could be to protect membrane systems from the detergent nature of free acyl-CoAs by controlling their release to acyl-CoA-utilising enzymes (Soupene & Kuypers 2015).\"}]}" ;
