    mslm:evidenceJson "{\"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005741\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17906, \"definition\": \"The outer, i.e. cytoplasm-facing, lipid bilayer of the mitochondrial envelope.\", \"displayName\": \"mitochondrial outer membrane\", \"name\": \"mitochondrial outer membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005741\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 1483099, \"displayName\": \"PA translocates from the outer to the inner mitochondrial membrane\", \"followingEvent\": [1483165], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1483099], \"dbId\": 1500590, \"displayName\": \"PA [mitochondrial outer membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PA\", \"phosphatidate(2-)\", \"phosphatidic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500590\", \"stIdVersion\": \"R-ALL-1500590.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1483228, \"displayName\": \"Transport of phosphatidic acid within the mitochondrion\", \"journal\": \"Biochim Biophys Acta\", \"pages\": \"284-7\", \"pubMedIdentifier\": 2344448, \"schemaClass\": \"LiteratureReference\", \"title\": \"Transport of phosphatidic acid within the mitochondrion\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/2344448\", \"volume\": 1044, \"year\": 1990}, {\"className\": \"LiteratureReference\", \"dbId\": 1483151, \"displayName\": \"Phosphatidic acid synthesis in mitochondria. Topography of formation and transmembrane migration\", \"journal\": \"J Biol Chem\", \"pages\": \"29786-90\", \"pubMedIdentifier\": 10514455, \"schemaClass\": \"LiteratureReference\", \"title\": \"Phosphatidic acid synthesis in mitochondria. Topography of formation and transmembrane migration\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/10514455\", \"volume\": 274, \"year\": 1999}], \"maxDepth\": 1, \"name\": [\"PA translocates from the outer to the inner mitochondrial membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1524101, \"displayName\": \"PA [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PA\", \"phosphatidate(2-)\", \"phosphatidic acid\"], \"producedByEvent\": [1483099], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524101\", \"stIdVersion\": \"R-ALL-1524101.6\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482548, \"displayName\": \"1-acyl LPA is acylated to PA by AGPAT5 (OM)\", \"followingEvent\": [1483099], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPA is acylated to PA by AGPAT5 (OM)\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482548\", \"stIdVersion\": \"R-HSA-1482548.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 8954398, \"displayName\": \"PLD6 dimer hydrolyses cardiolipin to PA and PG\", \"followingEvent\": [1483099], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PLD6 dimer hydrolyses cardiolipin to PA and PG\"], \"releaseDate\": \"2017-03-27\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8954398\", \"stIdVersion\": \"R-HSA-8954398.3\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483099\", \"stIdVersion\": \"R-HSA-1483099.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1483176, \"displayName\": \"Phosphatidic acid (PA) transport within the mitochondrion oc...\", \"schemaClass\": \"Summation\", \"text\": \"Phosphatidic acid (PA) transport within the mitochondrion occurs as free diffusion through the aqueous phase and not mediated by phospholipid transfer proteins.  This event is inferred from rats (Chakraborty et al. 1999, Wojtczak et al. 1990).\"}]}" ;
