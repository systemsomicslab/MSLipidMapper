familiaris\", \"stId\": \"R-CFA-8871376\", \"stIdVersion\": \"R-CFA-8871376.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10208081, \"displayName\": \"p-Y389,400-RUFY1 binds PI3P\", \"inferredFrom\": [8871376], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"p-Y389,400-RUFY1 binds PI3P\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8871376\", \"stIdVersion\": \"R-RNO-8871376.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10085090, \"displayName\": \"p-Y389,400-RUFY1 binds PI3P\", \"inferredFrom\": [8871376], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"p-Y389,400-RUFY1 binds PI3P\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8871376\", \"stIdVersion\": \"R-MMU-8871376.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 8871354, \"displayName\": \"p-Y389,400-RUFY1:PI3P [early endosome membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"p-Y389,400-RUFY1:PI3P\"], \"producedByEvent\": [8871376], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8871354\", \"stIdVersion\": \"R-HSA-8871354.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8871376\", \"stIdVersion\": \"R-HSA-8871376.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8871365, \"displayName\": \"RUN and FYVE domain-containing protein 1 (RUFY1, aka RABIP4,...\", \"schemaClass\": \"Summation\", \"text\": \"RUN and FYVE domain-containing protein 1 (RUFY1, aka RABIP4, ZFYVE12) associates with phosphatidylinositol 3-phosphate in membranes of early endosomes and may participate in early endosomal membrane trafficking. RUFY1 is localised to the cytoplasm and early endosomal membrane, the latter being the predominant localisation after RUFY1 is phosphorylated. Cytoplasmic tyrosine-protein kinase BMX (BMX, aka ETK) is a a downstream tyrosine kinase of PI3-kinase which, through its SH2 and SH3 domains, binds to and phosphorylates RUFY1 at Tyr-389 and Tyr-400. These phosphorylations are essential for endosomal localisation (Yang et al. 2002).\"}]}" ;
