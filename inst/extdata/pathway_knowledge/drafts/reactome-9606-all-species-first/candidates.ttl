<https://reactome.org/content/detail/R-HSA-9026544> a mslm:LipidReaction ;
    rdfs:label "Non-enzymatic hydrolysis hydrolyses 13(S),14(S)-epoxy-DHA to 7-epi-MaR1" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "H2O [cytosol] + 13(S),14(S)-epoxy-DHA [cytosol] => 7-epi-MaR1 [cytosol]" ;
    mslm:evidenceJson "{\"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9026544, \"displayName\": \"Non-enzymatic hydrolysis hydrolyses 13(S),14(S)-epoxy-DHA to 7-epi-MaR1\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9026544], \"dbId\": 9025001, \"displayName\": \"13(S),14(S)-epoxy-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"13(S),14(S)-epoxy-DHA\", \"(13S,14S)-epoxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate\", \"(13S,14S)-epoxy-DHA(1-)\", \"(13S,14S)-epoxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9025001\", \"stIdVersion\": \"R-ALL-9025001.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9026544], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9024988, \"displayName\": \"Maresins: novel macrophage mediators with potent antiinflammatory and proresolving actions\", \"journal\": \"J. Exp. Med.\", \"pages\": \"15-23\", \"pubMedIdentifier\": 19103881, \"schemaClass\": \"LiteratureReference\", \"title\": \"Maresins: novel macrophage mediators with potent antiinflammatory and proresolving actions\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/19103881\", \"volume\": 206, \"year\": 2009}], \"maxDepth\": 1, \"name\": [\"Non-enzymatic hydrolysis hydrolyses 13(S),14(S)-epoxy-DHA to 7-epi-MaR1\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9025005, \"displayName\": \"7-epi-MaR1 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7-epi-MaR1\", \"(7S,14S)-dihydroxy-(4Z,8E,10E,12Z,16Z,19Z)-docosahexaenoate\", \"7-epi-maresin 1(1-)\", \"7(S),14(S)-diHDHA\", \"(7S,14S)-dihydroxy-(4Z,8E,10E,12Z,16Z,19Z)-docosahexaenoic acid\"], \"producedByEvent\": [9026544], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9025005\", \"stIdVersion\": \"R-ALL-9025005.6\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9026544\", \"stIdVersion\": \"R-HSA-9026544.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9027026, \"displayName\": \"Maresin 1 (MaR1, 7(R),14(S)-dihydroxy-docosahexaenoic acid) ...\", \"schemaClass\": \"Summation\", \"text\": \"Maresin 1 (MaR1, 7(R),14(S)-dihydroxy-docosahexaenoic acid) is the first identified maresin and displays potent anti-inflammatory and pro-resolving actions (Serhan et al. 2012, Chatterjee et al. 2014). MaR1 was found to inhibit proinflammatory mediator production by inhibiting LTA4 hydrolase, thereby shifting macrophage phenotype from proinflammatory mediator to proresolving mediator production (Dalli et al. 2013). A novel double dioxygenation product can also be formed by non-enzymatic hydrolysis of 13(R),154(S)-epoxy-DHA, namely 7(S),14(S)-dihydroxy-docosahexaenoic acid (7-epi-MaR1).  Although 7-epi-MaR1 possesses some bioactivity, it displays lower anti-inflammatory and pro-resolving actions than MaR1 (Serhan et al. 2009).\"}]}" ;
