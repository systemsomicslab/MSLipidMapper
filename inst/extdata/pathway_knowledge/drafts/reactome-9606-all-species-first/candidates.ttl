6, \"schemaClass\": \"LiteratureReference\", \"title\": \"Novel n-3 immunoresolvents: structures and actions\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/23736886\", \"volume\": 3, \"year\": 2013}], \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DPAn-3 to 14(S)-Hp-DPAn-3\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11051160, \"displayName\": \"ALOX12:Fe2+ oxidises DPAn-3 to 14(S)-Hp-DPAn-3\", \"inferredFrom\": [9026006], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DPAn-3 to 14(S)-Hp-DPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-9026006\", \"stIdVersion\": \"R-DDI-9026006.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10645315, \"displayName\": \"ALOX12:Fe2+ oxidises DPAn-3 to 14(S)-Hp-DPAn-3\", \"inferredFrom\": [9026006], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DPAn-3 to 14(S)-Hp-DPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9026006\", \"stIdVersion\": \"R-DRE-9026006.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10551199, \"displayName\": \"ALOX12:Fe2+ oxidises DPAn-3 to 14(S)-Hp-DPAn-3\", \"inferredFrom\": [9026006], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ oxidises DPAn-3 to 14(S)-Hp-DPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9026006\", \"stIdVersion\": \"R-SSC-9026006.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10437790, \"displayName\": \"ALOX12:Fe2+ oxidises DPAn-3 to 14(S)-Hp-DPAn-3\", \"inferredFrom\": [9026006], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX12:Fe2+ ox