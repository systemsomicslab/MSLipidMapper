    mslm:equation "5-HETEL [extracellular region] + H2O [extracellular region] => 5-HETE [extracellular region]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8932633], \"className\": \"CatalystActivity\", \"dbId\": 8932640, \"displayName\": \"acyl-L-homoserine-lactone lactonohydrolase activity of PON1,2,3:2xCa2+ dimers [extracellular region]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 8932633, \"displayName\": \"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8932633], \"dbId\": 8932801, \"displayName\": \"5-HETEL [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5-HETEL\", \"meadowlactone\", \"5-hydroxy-eicosatetraenoic acid 1,5-lactone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8932801\", \"stIdVersion\": \"R-ALL-8932801.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8932633], \"dbId\": 109276, \"displayName\": \"H2O [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109276\", \"stIdVersion\": \"R-ALL-109276.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8932646, \"displayName\": \"Human paraoxonases (PON1, PON2, and PON3) are lactonases with overlapping and distinct substrate specificities\", \"journal\": \"J. Lipid Res.\", \"pages\": \"1239-47\", \"pubMedIdentifier\": 15772423, \"schemaClass\": \"LiteratureReference\", \"title\": \"Human paraoxonases (PON1, PON2, and PON3) are lactonases with overlapping and distinct substrate specificities\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15772423\", \"volume\": 46, \"year\": 2005}, {\"className\": \"LiteratureReference\", \"dbId\": 8932630, \"displayName\": \"Paraoxonases (PON1, PON2, PON3) analyses in vitro and in vivo in relation to cardiovascular diseases\", \"journal\": \"Methods Mol. Biol.\", \"pages\": \"259-76\", \"pubMedIdentifier\": 19082953, \"schemaClass\": \"LiteratureReference\", \"title\": \"Paraoxonases (PON1, PON2, PON3) analyses in vitro and in vivo in relation to cardiovascular diseases\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/19082953\", \"volume\": 477, \"year\": 2008}], \"maxDepth\": 1, \"name\": [\"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10991246, \"displayName\": \"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\", \"inferredFrom\": [8932633], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Caenorhabditis elegans\", \"stId\": \"R-CEL-8932633\", \"stIdVersion\": \"R-CEL-8932633.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10816755, \"displayName\": \"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\", \"inferredFrom\": [8932633], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-8932633\", \"stIdVersion\": \"R-GGA-8932633.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10722775, \"displayName\": \"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\", \"inferredFrom\": [8932633], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8932633\", \"stIdVersion\": \"R-XTR-8932633.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10640098, \"displayName\": \"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\", \"inferredFrom\": [8932633], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-8932633\", \"stIdVersion\": \"R-DRE-8932633.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10544876, \"displayName\": \"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\", \"inferredFrom\": [8932633], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8932633\", \"stIdVersion\": \"R-SSC-8932633.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10431224, \"displayName\": \"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\", \"inferredFrom\": [8932633], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8932633\", \"stIdVersion\": \"R-BTA-8932633.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10317710, \"displayName\": \"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\", \"inferredFrom\": [8932633], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8932633\", \"stIdVersion\": \"R-CFA-8932633.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10209373, \"displayName\": \"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\", \"inferredFrom\": [8932633], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8932633\", \"stIdVersion\": \"R-RNO-8932633.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10086347, \"displayName\": \"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\", \"inferredFrom\": [8932633], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PON1,2,3:Ca2+ dimers hydrolyse 5-HETEL to 5-HETE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8932633\", \"stIdVersion\": \"R-MMU-8932633.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8932804, \"displayName\": \"5-HETE [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5-HETE\", \"5-HETE(1-)\", \"5-hydroxy-6E,8Z,11Z,14Z-eicosatetraenoic acid\"], \"producedByEvent\": [8932633], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8932804\", \"stIdVersion\": \"R-ALL-8932804.3\"}], \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8932633\", \"stIdVersion\": \"R-HSA-8932633.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8932803, \"displayName\": \"Serum paraoxonase/arylesterases 1, 2 and 3 (PON1,2 and 3) ar...\", \"schemaClass\": \"Summation\", \"text\": \"Serum paraoxonase/arylesterases 1, 2 and 3 (PON1,2 and 3) are extracellular lactonases/lactonysing enzymes with overlapping, but also distinct substrate specificity. PONs are homodimeric proteins which bind 2 Ca2+ ions per subunit, necessary for  enzyme stability and enzymatic activity. All three PONs can efficiently metabolise 5-hydroxy-eicosatetraenoic acid 1,5-lactone (5-HETEL), a product of both enzymatic and nonenzymatic oxidation of arachidonate and may represent one of the PONs' endogenous substrates (Draganov et al. 2005).\"}]}" ;
