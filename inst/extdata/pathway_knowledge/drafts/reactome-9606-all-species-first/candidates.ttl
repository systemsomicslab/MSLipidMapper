154, \"displayName\": \"PAP [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PAP\", \"adenosine 3',5'-bismonophosphate(4-)\", \"adenosine 3',5'-bisphosphate\", \"adenosine 3',5'-bismonophosphate\"], \"producedByEvent\": [6810474], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9641154\", \"stIdVersion\": \"R-ALL-9641154.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [6810474, 6810474], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}, 193465], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-03-23\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6810474\", \"stIdVersion\": \"R-HSA-6810474.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 6810533, \"displayName\": \"Coenzyme A (CoA-SH) and acyl-coenzyme A (acyl-CoA) can be de...\", \"schemaClass\": \"Summation\", \"text\": \"Coenzyme A (CoA-SH) and acyl-coenzyme A (acyl-CoA) can be degraded in peroxisomes by two members of the Nudix (nucleoside diphosphates linked to some moiety X) hydrolase superfamily; NUDT7 and NUDT19. NUDT19 hydrolyses free fatty acyl-CoA to form acyl-phosphopantetheine (acyl-PPANT) and 3′,5′-ADP. Human NUDT19 activity is inferred from mouse Nudt19 activity (Ofman et al. 2006).\"}]}" ;
