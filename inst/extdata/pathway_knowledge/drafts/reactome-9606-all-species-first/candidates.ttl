"R-ALL-1806200.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [1676162], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 1675834, \"displayName\": \"PI(3,4)P2 is transported from the plasma membrane to the early endosome membrane\", \"followingEvent\": [1676162], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2 is transported from the plasma membrane to the early endosome membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675834\", \"stIdVersion\": \"R-HSA-1675834.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676206, \"displayName\": \"PI4P is phosphorylated to PI(3,4)P2 by PIK3C2A at the early endosome membrane\", \"followingEvent\": [1676162], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI4P is phosphorylated to PI(3,4)P2 by PIK3C2A at the early endosome membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676206\", \"stIdVersion\": \"R-HSA-1676206.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676162\", \"stIdVersion\": \"R-HSA-1676162.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1675978, \"displayName\": \"At the early endosome membrane, type I (INPP4A) (Norris et a...\", \"schemaClass\": \"Summation\", \"text\": \"At the early endosome membrane, type I (INPP4A) (Norris et al. 1995, Ivetac et al. 2005) and type II inositol-3,4-bisphosphate 4-phosphatase (INPP4B) (Norris et al. 1997) colocalise with early and recycling endosomes through their C2 domains which bind to the phosphatidylinositol 3,4-bisphosphate (PI(3,4)P2) present in these membranes.  It is here that phosphatidylinositol 3,4-bisphosphate (PI(3,4)P2) is dephosphorylated by INPP4A/B to phosphatidylinositol 3-phosphate (PI3P).\"}]}" ;
