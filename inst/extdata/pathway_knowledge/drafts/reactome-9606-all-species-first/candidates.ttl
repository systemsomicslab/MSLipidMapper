me\": \"DGAT2L6,L7P transfer acyl group from acyl-CoA to DAG, forming TAG\", \"inferredFrom\": [8848580], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DGAT2L6,L7P transfer acyl group from acyl-CoA to DAG, forming TAG\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8848580\", \"stIdVersion\": \"R-RNO-8848580.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10080820, \"displayName\": \"DGAT2L6,L7P transfer acyl group from acyl-CoA to DAG, forming TAG\", \"inferredFrom\": [8848580], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DGAT2L6,L7P transfer acyl group from acyl-CoA to DAG, forming TAG\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8848580\", \"stIdVersion\": \"R-MMU-8848580.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1500594, \"displayName\": \"TAG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TAG\", \"triglyceride\", \"triacylglycerol\"], \"producedByEvent\": [8848580], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500594\", \"stIdVersion\": \"R-ALL-1500594.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [8848580], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"releaseDate\": \"2016-03-23\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8848580\", \"stIdVersion\": \"R-HSA-8848580.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8848589, \"displayName\": \"DGAT2L6 (Diacylglycerol O-acyltransferase 2-like protein 6, ...\", \"schemaClass\": \"Summation\", \"text\": \"DGAT2L6 (Diacylglycerol O-acyltransferase 2-like protein 6, also known as DC3) catalyzes the transfer of an acyl group from acyl-CoA to DAG (diacylglycerol) to form TAG (triacylglycerol). DGAT2L6 catalyzes this reaction with low efficiency in vitro so its physiological role is uncertain. Based on its similarity to other proteins of the DGAT family it is inferred to be localized to the endoplasmic reticulum membrane (Turkish et al. 2005). The putative diacylglycerol O-acyltransferase 2-like protein DGAT2L7P may also possess the same activity as DGAT2L6.\"}]}" ;
