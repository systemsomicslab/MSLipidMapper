inding\", \"className\": \"Reaction\", \"dbId\": 10912606, \"displayName\": \"ACLY tetramer binds ETC-1002-CoA\", \"inferredFrom\": [9734540], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer binds ETC-1002-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-9734540\", \"stIdVersion\": \"R-DME-9734540.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10826424, \"displayName\": \"ACLY tetramer binds ETC-1002-CoA\", \"inferredFrom\": [9734540], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer binds ETC-1002-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-9734540\", \"stIdVersion\": \"R-GGA-9734540.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10730833, \"displayName\": \"ACLY tetramer binds ETC-1002-CoA\", \"inferredFrom\": [9734540], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer binds ETC-1002-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9734540\", \"stIdVersion\": \"R-XTR-9734540.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10648416, \"displayName\": \"ACLY tetramer binds ETC-1002-CoA\", \"inferredFrom\": [9734540], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer binds ETC-1002-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9734540\", \"stIdVersion\": \"R-DRE-9734540.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10555678, \"displayName\": \"ACLY tetramer binds ETC-1002-CoA\", \"inferredFrom\": [9734540], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer binds ETC-1002-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9734540\", \"stIdVersion\": \"R-SSC-9734540.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10442311, \"displayName\": \"ACLY tetramer binds ETC-1002-CoA\", \"inferredFrom\": [9734540], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer binds ETC-1002-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9734540\", \"stIdVersion\": \"R-BTA-9734540.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10328233, \"displayName\": \"ACLY tetramer binds ETC-1002-CoA\", \"inferredFrom\": [9734540], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer binds ETC-1002-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9734540\", \"stIdVersion\": \"R-CFA-9734540.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10220796, \"displayName\": \"ACLY tetramer binds ETC-1002-CoA\", \"inferredFrom\": [9734540], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer binds ETC-1002-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9734540\", \"stIdVersion\": \"R-RNO-9734540.1\"}, {\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10097564, \"displayName\": \"ACLY tetramer binds ETC-1002-CoA\", \"inferredFrom\": [9734540], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer binds ETC-1002-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9734540\", \"stIdVersion\": \"R-MMU-9734540.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 9734534, \"displayName\": \"ACLY tetramer:ETC-1002-CoA [cytosol]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"ACLY tetramer:ETC-1002-CoA\"], \"producedByEvent\": [9734540], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9734534\", \"stIdVersion\": \"R-HSA-9734534.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9734535, \"displayName\": \"SLC27A2 ligates CoA to bempedoic acid to form ETC-1002-CoA\", \"followingEvent\": [9734540], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SLC27A2 ligates CoA to bempedoic acid to form ETC-1002-CoA\"], \"releaseDate\": \"2022-06-09\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9734535\", \"stIdVersion\": \"R-HSA-9734535.2\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821383, \"definition\": \"internally reviewed\", \"displayName\": \"three stars\", \"name\": [\"three stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2024-06-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9734540\", \"stIdVersion\": \"R-HSA-9734540.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9734653, \"displayName\": \"Cytosolic ATP-citrate synthase (ACLY) is an important enzyme...\", \"schemaClass\": \"Summation\", \"text\": \"Cytosolic ATP-citrate synthase (ACLY) is an important enzyme with significant effects on fatty acid and cholesterol metabolism. It is highly expressed in lipogenic tissues such as the liver and white adipose tissue and links energy metabolism from carbohydrates to the production of fatty acids through catalyzing acetyl CoA synthesis, the fundamental substrate for the biosynthesis of both fatty acids and cholesterol. Elevated LDL-C levels are a well-established risk factor for atherosclerotic cardiovascular disease (ACSVD) and hypercholesterolemia. Its crucial role in lipid biosynthesis makes ACLY a potential target for lipid-lowering intervention.<br><br>Bempedoic acid (ETC-1002) is first-in-class adenosine triphosphate-citrate lyase (ACLY) inhibitor used once a day for reducing LDL cholesterol levels in statin-refractory patients. ETC-1002 itself is a prodrug, which is converted to an active metabolite (ETC-1002–CoA) by endogenous liver acyl-CoA synthetase activity (Pinkosky et al. 2016), which then inhibits ACLY (Pinkosky et al. 2013, 2016).<br><br>By inhibiting cholesterol synthesis in the liver, ETC-1002 induces upregulation of the LDL receptor and stimulates the uptake of LDL particles by the liver, which contributes to reductions of LDL-C levels in the blood. Also, because the prodrug is converted to the active drug specifically in the liver, this may avoid potential adverse muscle effects as seen with cholesterol inhibition by statins in muscle (Susekov et al. 2021).\"}]}" ;
