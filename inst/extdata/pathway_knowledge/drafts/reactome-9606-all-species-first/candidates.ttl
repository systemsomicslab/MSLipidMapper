    mslm:equation "STARD10:LPCAT1:PC [endoplasmic reticulum membrane] => LPCAT1 [endoplasmic reticulum membrane] + STARD10:PC [lamellar body membrane]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8873834], \"className\": \"CatalystActivity\", \"dbId\": 9955875, \"displayName\": \"lipid carrier activity of STARD10:LPCAT1:PC [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0097232\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 2133233, \"definition\": \"The lipid bilayer surrounding a lamellar body. A lamellar body is a membrane-bounded organelle, specialized for the storage and secretion of various substances (surfactant phospholipids, glycoproteins and acid phosphates) which are arranged in the form of tightly packed, concentric, membrane sheets or lamellae. Has some similar properties to, but is distinct from, a lysosome.\", \"displayName\": \"lamellar body membrane\", \"name\": \"lamellar body membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0097232\"}], \"dbId\": 8873834, \"displayName\": \"STARD10 transports PC from ER membrane to lamellar body membrane\", \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [8873834], \"dbId\": 8873921, \"displayName\": \"STARD10:LPCAT1:PC [endoplasmic reticulum membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"STARD10:LPCAT1:PC\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8873921\", \"stIdVersion\": \"R-HSA-8873921.1\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8873861, \"displayName\": \"StarD10, a START domain protein overexpressed in breast cancer, functions as a phospholipid transfer protein\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"27436-42\", \"pubMedIdentifier\": 15911624, \"schemaClass\": \"LiteratureReference\", \"title\": \"StarD10, a START domain protein overexpressed in breast cancer, functions as a phospholipid transfer protein\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/15911624\", \"volume\": 280, \"year\": 2005}, {\"className\": \"LiteratureReference\", \"dbId\": 8873862, \"displayName\": \"Phosphorylation of StarD10 on serine 284 by casein kinase II modulates its lipid transfer activity\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"22492-8\", \"pubMedIdentifier\": 17561512, \"schemaClass\": \"LiteratureReference\", \"title\": \"Phosphorylation of StarD10 on serine 284 by casein kinase II modulates its lipid transfer activity\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/17561512\", \"volume\": 282, \"year\": 2007}, {\"className\": \"LiteratureReference\", \"dbId\": 8873836, \"displayName\": \"Lysophosphatidylcholine Acyltransferase 1 (LPCAT1) Specifically Interacts with Phospholipid Transfer Protein StarD10 to Facilitate Surfactant Phospholipid Trafficking in Alveolar Type II Cells\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"18559-74\", \"pubMedIdentifier\": 26048993, \"schemaClass\": \"LiteratureReference\", \"title\": \"Lysophosphatidylcholine Acyltransferase 1 (LPCAT1) Specifically Interacts with Phospholipid Transfer Protein StarD10 to Facilitate Surfactant Phospholipid Trafficking in Alveolar Type II Cells\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/26048993\", \"volume\": 290, \"year\": 2015}], \"maxDepth\": 1, \"name\": [\"STARD10 transports PC from ER membrane to lamellar body membrane\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10722026, \"displayName\": \"STARD10 transports PC from ER membrane to lamellar body membrane\", \"inferredFrom\": [8873834], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD10 transports PC from ER membrane to lamellar body membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-8873834\", \"stIdVersion\": \"R-XTR-8873834.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10639271, \"displayName\": \"STARD10 transports PC from ER membrane to lamellar body membrane\", \"inferredFrom\": [8873834], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD10 transports PC from ER membrane to lamellar body membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-8873834\", \"stIdVersion\": \"R-DRE-8873834.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10543766, \"displayName\": \"STARD10 transports PC from ER membrane to lamellar body membrane\", \"inferredFrom\": [8873834], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD10 transports PC from ER membrane to lamellar body membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8873834\", \"stIdVersion\": \"R-SSC-8873834.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10430047, \"displayName\": \"STARD10 transports PC from ER membrane to lamellar body membrane\", \"inferredFrom\": [8873834], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD10 transports PC from ER membrane to lamellar body membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8873834\", \"stIdVersion\": \"R-BTA-8873834.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10316564, \"displayName\": \"STARD10 transports PC from ER membrane to lamellar body membrane\", \"inferredFrom\": [8873834], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD10 transports PC from ER membrane to lamellar body membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8873834\", \"stIdVersion\": \"R-CFA-8873834.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10208097, \"displayName\": \"STARD10 transports PC from ER membrane to lamellar body membrane\", \"inferredFrom\": [8873834], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD10 transports PC from ER membrane to lamellar body membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8873834\", \"stIdVersion\": \"R-RNO-8873834.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10085106, \"displayName\": \"STARD10 transports PC from ER membrane to lamellar body membrane\", \"inferredFrom\": [8873834], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD10 transports PC from ER membrane to lamellar body membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8873834\", \"stIdVersion\": \"R-MMU-8873834.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 8873863, \"displayName\": \"STARD10:PC [lamellar body membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"STARD10:PC\"], \"producedByEvent\": [8873834], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8873863\", \"stIdVersion\": \"R-HSA-8873863.1\"}, {\"className\": \"Protein\", \"dbId\": 1498772, \"displayName\": \"LPCAT1 [endoplasmic reticulum membrane]\", \"endCoordinate\": 534, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LPCAT1\", \"Lysophosphatidylcholine acyltransferase 1\", \"PFAAP3\"], \"producedByEvent\": [8873834], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1498772\", \"stIdVersion\": \"R-HSA-1498772.1\", \"startCoordinate\": 1}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8873834\", \"stIdVersion\": \"R-HSA-8873834.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8873925, \"displayName\": \"The steroidogenic acute regulatory (StAR) protein-related li...\", \"schemaClass\": \"Summation\", \"text\": \"The steroidogenic acute regulatory (StAR) protein-related lipid transfer (START) domain proteins constitute a family of evolutionarily conserved and widely expressed proteins that have been implicated in lipid transport, metabolism, and signaling. Human PCTP-like protein (STARD10) (Olayioye et al. 2005) is thought to be a dual specificity lipid transfer protein capable of shuttling phosphatidylcholine (PC) (and phosphatidylethanolamine (PE), not shown here) between intracellular membranes, especially to lamellar body membranes. Saturated PC is a major component of pulmonary surfactant, a mixture of proteins and phospholipids that plays an important role in facilitating gas exchange by maintaining alveolar stability. After synthesis in the endoplasmic reticulum, saturated PC is transported to lamellar bodies (LBs) for storage prior to secretion. Lysophosphatidylcholine acyltransferase 1 (LPCAT1) mediated reacylation is a final step in saturated PC synthesis prior to transport and LPCAT1 is proposed to form a complex with STARD10 at the ER membrane to facilitate the synthesis then transport of saturated PC to LBs (Lin et al. 2015).\"}]}" ;
