\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [1675795], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676020, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI3P by FIG4 at the late endosome membrane\", \"followingEvent\": [1675795], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI3P by FIG4 at the late endosome membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676020\", \"stIdVersion\": \"R-HSA-1676020.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1676024, \"displayName\": \"PI is phosphorylated to PI3P by PIK3C2A/3 at the late endosome membrane\", \"followingEvent\": [1675795], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PI is phosphorylated to PI3P by PIK3C2A/3 at the late endosome membrane\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1676024\", \"stIdVersion\": \"R-HSA-1676024.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1675795\", \"stIdVersion\": \"R-HSA-1675795.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1675801, \"displayName\": \"At the late endosome membrane, myotubularin (MTM1), myotubul...\", \"schemaClass\": \"Summation\", \"text\": \"At the late endosome membrane, myotubularin (MTM1), myotubularin-related protein 2 (MTMR2), myotubularin-related protein 4 (MTMR4), and myotubularin-related protein 7 (MTMR7) dephosphorylate phosphatidylinositol 3-phosphate (PI3P) to phosphatidylinositol (PI).<br><br>The following lists the above proteins with their corresponding literature references: MTM1 (Cao et al. 2007, Cao et al. 2008, Tsujita et al. 2004, Tronchere et al. 2004, Kim et al. 2002); MTMR2 (Cao et al. 2008, Kim et al. 2002); MTMR4 (Lorenzo et al. 2006); and  MTMR7 (Mochizuki & Majerus 2003, Lorenzo et al. 2006).\"}]}" ;
