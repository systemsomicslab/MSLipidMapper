\"Reaction\", \"dbId\": 10321030, \"displayName\": \"PGP:Mg2+ dimer hydrolyses G3P to glycerol\", \"inferredFrom\": [8955794], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PGP:Mg2+ dimer hydrolyses G3P to glycerol\", \"sn-glycerol 3-phosphate + H2O => glycerol + phosphate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8955794\", \"stIdVersion\": \"R-CFA-8955794.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10213036, \"displayName\": \"PGP:Mg2+ dimer hydrolyses G3P to glycerol\", \"inferredFrom\": [8955794], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PGP:Mg2+ dimer hydrolyses G3P to glycerol\", \"sn-glycerol 3-phosphate + H2O => glycerol + phosphate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8955794\", \"stIdVersion\": \"R-RNO-8955794.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10089879, \"displayName\": \"PGP:Mg2+ dimer hydrolyses G3P to glycerol\", \"inferredFrom\": [8955794], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PGP:Mg2+ dimer hydrolyses G3P to glycerol\", \"sn-glycerol 3-phosphate + H2O => glycerol + phosphate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8955794\", \"stIdVersion\": \"R-MMU-8955794.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 76116, \"displayName\": \"Glycerol [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Glycerol\"], \"producedByEvent\": [8955794], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76116\", \"stIdVersion\": \"R-ALL-76116.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [8955794], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2017-03-27\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8955794\", \"stIdVersion\": \"R-HSA-8955794.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8955799, \"displayName\": \"Cytosolic PGP (Glycerol-3-phosphate phosphatase) catalyzes t...\", \"schemaClass\": \"Summation\", \"text\": \"Cytosolic PGP (Glycerol-3-phosphate phosphatase) catalyzes the hydrolysis of G3P (glycerol 3-phosphate) to glycerol and phosphate. This reaction is inferred from the properties of the human enzyme overexpressed in mouse cells (Mugabo et al. 2016). The enzyme is inferred to function as a homodimer with one Mg++ ion bound to each subunit, from the properties of the mouse enzyme (Seifried et al. 2014). Al-Maas et al. (2022a,b) hypothesize that PGP, by dissipating glucose-derived glycerol in the liver and pancreas, may play a role in minimizing the effects of hyperglycemia. In the male gonad, PGP activity may be required for normal spermatogenesis (Oppong et al. 2024).\"}]}" ;
