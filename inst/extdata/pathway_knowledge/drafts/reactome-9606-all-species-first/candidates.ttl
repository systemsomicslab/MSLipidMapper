hemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [195664], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [195664, 195664], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 195690, \"displayName\": \"Zymosterol is isomerized to cholesta-7,24-dien-3beta-ol\", \"followingEvent\": [195664], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Zymosterol is isomerized to cholesta-7,24-dien-3beta-ol\", \"zymosterol => 5alpha-cholesta-7,24-dien-3beta-ol\"], \"releaseDate\": \"2007-02-20\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-195690\", \"stIdVersion\": \"R-HSA-195690.4\"}], \"releaseDate\": \"2007-02-20\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-195664\", \"stIdVersion\": \"R-HSA-195664.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 195695, \"displayName\": \"Cholesta-7,24-dien-3beta-ol, NADPH + H+, and O2 react to for...\", \"schemaClass\": \"Summation\", \"text\": \"Cholesta-7,24-dien-3beta-ol, NADPH + H+, and O2 react to form cholesta-5,7,24-trien-3beta-ol, NADP+, and 2 H2O, catalyzed by SC5D. This reaction takes place in the endoplasmic reticulum. Its biochemical details are inferred from those of the reaction catalyzed by the purified rat protein (Kawata et al. 1985). The role of human SC5D in catalyzing this reaction in vivo is established from studies of patients in whom the enzyme is defective (Brunetti-Pierri et al. 2002; Krakowiak et al. 2003).\"}]}" ;
