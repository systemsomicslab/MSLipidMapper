erred\": true, \"maxDepth\": 1, \"name\": [\"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"OSTA:OSTB exports bile salts from enterocytes to the portal system\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9733964\", \"stIdVersion\": \"R-XTR-9733964.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10555660, \"displayName\": \"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"inferredFrom\": [9733964], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"OSTA:OSTB exports bile salts from enterocytes to the portal system\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9733964\", \"stIdVersion\": \"R-SSC-9733964.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10442293, \"displayName\": \"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"inferredFrom\": [9733964], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"OSTA:OSTB exports bile salts from enterocytes to the portal system\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9733964\", \"stIdVersion\": \"R-BTA-9733964.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10328221, \"displayName\": \"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"inferredFrom\": [9733964], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"OSTA:OSTB exports bile salts from enterocytes to the portal system\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9733964\", \"stIdVersion\": \"R-CFA-9733964.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10220778, \"displayName\": \"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"inferredFrom\": [9733964], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"OSTA:OSTB exports bile salts from enterocytes to the portal system\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9733964\", \"stIdVersion\": \"R-RNO-9733964.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10097546, \"displayName\": \"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"inferredFrom\": [9733964], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"OSTA:OSTB exports bile salts from enterocytes to the portal system\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-9733964\", \"stIdVersion\": \"R-MMU-9733964.1\"}], \"output\": [{\"className\": \"Set\", \"dbId\": 192483, \"displayName\": \"bile salts and acids [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts and acids\"], \"producedByEvent\": [9733964], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-192483\", \"stIdVersion\": \"R-ALL-192483.1\"}], \"releaseDate\": \"2021-09-15\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9733964\", \"stIdVersion\": \"R-HSA-9733964.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9733967, \"displayName\": \"Bile salt and acid uptake across the apical membrane of ilea...\", \"schemaClass\": \"Summation\", \"text\": \"Bile salt and acid uptake across the apical membrane of ileal enterocytes is mediated mainly by the apical sodium-dependent bile acid transporter, ASBT, whereas basolateral efflux into the portal blood system is mediated largely by the heterodimeric organic solute transporter SLC51A:SLC51B (OSTA:OSTB) (Seward et al. 2003, Ballatori et al. 2005). Heterodimerization of SLC51 alpha and beta subunits is required not only for plasma membrane localisation but also for increased stability of the proteins (Li et al. 2007).\"}]}" ;
