    mslm:equation "NADP+ [cytosol] + 17-HDPAn-3 [cytosol] => NADPH [cytosol] + 17-oxo-DPAn-3 [cytosol]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9027600], \"className\": \"CatalystActivity\", \"dbId\": 9027560, \"displayName\": \"alcohol dehydrogenase (NADP+) activity of Dehydrogenase [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9027600, \"displayName\": \"Dehydrogenase dehydrogenates 17-HDPAn-3 to 17-oxo-DPAn-3\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027600], \"dbId\": 9027614, \"displayName\": \"17-HDPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17-HDPAn-3\", \"(7Z,10Z,13Z,15E,19Z)-17-hydroperoxydocosapentaenoate\", \"(7Z,10Z,13Z,15E,19Z)-17-hydroperoxydocosapentaenoic acid\", \"17-hydroperoxy-omega3-docosapentaenoic acid\", \"17-hydroperoxy-docosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9027614\", \"stIdVersion\": \"R-ALL-9027614.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027600], \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9027533, \"displayName\": \"Cyclooxygenase-2 generates anti-inflammatory mediators from omega-3 fatty acids\", \"journal\": \"Nat. Chem. Biol.\", \"pages\": \"433-41\", \"pubMedIdentifier\": 20436486, \"schemaClass\": \"LiteratureReference\", \"title\": \"Cyclooxygenase-2 generates anti-inflammatory mediators from omega-3 fatty acids\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/20436486\", \"volume\": 6, \"year\": 2010}], \"maxDepth\": 1, \"name\": [\"Dehydrogenase dehydrogenates 17-HDPAn-3 to 17-oxo-DPAn-3\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9027601, \"displayName\": \"17-oxo-DPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17-oxo-DPAn-3\", \"(7Z,10Z,13Z,15E,19Z)-17-oxodocosapentaenoate\", \"(7Z,10Z,13Z,15E,19Z)-17-oxodocosapentaenoic acid\", \"17-oxo-omega3-docosapentaenoic acid\", \"17-EFOX-D5\", \"17-oxo-ω-3-docosapentaenoic acid\"], \"producedByEvent\": [9027600], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9027601\", \"stIdVersion\": \"R-ALL-9027601.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"producedByEvent\": [9027600], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9027607, \"displayName\": \"Ac-PTGS2 dimer oxidises DPAn-3 to 17-HDPAn-3\", \"followingEvent\": [9027600], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Ac-PTGS2 dimer oxidises DPAn-3 to 17-HDPAn-3\", \"(7Z,10Z,13Z,16Z,19Z)-docosapentaenoate + O2 => 17-hydroperoxy-(7Z,10Z,13Z,15E,19Z)-docosapentaenoate\"], \"releaseDate\": \"2018-03-21\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027607\", \"stIdVersion\": \"R-HSA-9027607.4\"}], \"releaseDate\": \"2018-03-21\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9027600\", \"stIdVersion\": \"R-HSA-9027600.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9027595, \"displayName\": \"In activated macrophages, an unknown dehdyrogenase abstracts...\", \"schemaClass\": \"Summation\", \"text\": \"In activated macrophages, an unknown dehdyrogenase abstracts hydrogen from 17-hydroxy-docosapentaenoic acid (17-HDPAn-3) to form the electrophilic oxo (EFOX) derivative 17-oxo-DPAn-3 (Groeger et al. 2010). Potential candidates are cellular dehydrogenases such as 3α-hydroxysteroid dehydrogenases (3α-HSDs), which can convert 13- and 17-HDHA into corresponding EFOXs in the presence of NAD(P)+ <i>in vitro</i>(supplementary data, Groeger et al. 2010) or 5- and 15-hydroxyeicosanoid dehydrogenases (5- and 15-HEDH, Wendell et al. 2015), which convert LOX products to 5-and 15-oxoETE (Erlemann et al. 2007). 17-oxo-DPAn-3 can act as a peroxisome proliferator-activated receptor-γ (PPARγ) agonist and inhibit pro-inflammatory cytokine and nitric oxide production, confirming its anti-inflammatory actions (Groeger et al. 2010).\"}]}" ;
