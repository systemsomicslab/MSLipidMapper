    mslm:equation "CERA [endoplasmic reticulum membrane] + UDP-Gal [endoplasmic reticulum lumen] => GalCer [endoplasmic reticulum membrane] + H+ [endoplasmic reticulum lumen] + UDP [endoplasmic reticulum lumen]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [6785933], \"className\": \"CatalystActivity\", \"dbId\": 6785918, \"displayName\": \"N-acylsphingosine galactosyltransferase activity of UGT8 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"crossReference\": [{\"className\": \"DatabaseIdentifier\", \"databaseName\": \"RHEA\", \"dbId\": 12690410, \"displayName\": \"RHEA:48344\", \"identifier\": \"48344\", \"schemaClass\": \"DatabaseIdentifier\", \"url\": \"https://www.rhea-db.org/rhea/48344\"}], \"dbId\": 6785933, \"displayName\": \"UGT8 transfers Gal from UDP-Gal to CERA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [6785933], \"dbId\": 428256, \"displayName\": \"CERA [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CERA\", \"N-acylsphingoid\", \"ceramide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428256\", \"stIdVersion\": \"R-ALL-428256.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [6785933], \"dbId\": 1981137, \"displayName\": \