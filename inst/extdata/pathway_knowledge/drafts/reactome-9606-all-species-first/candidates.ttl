<https://reactome.org/content/detail/R-HSA-8874745> a mslm:LipidReaction ;
    rdfs:label "ACAA2 tetramer transfers acyl group from Ac-CoA to acyl-CoA forming 3OA-CoA and CoA-SH" ;
    mslm:curationStatus mslm:Draft ;
