e\": [\"PE transports from the mitochondrial membrane to the ER\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1483077\", \"stIdVersion\": \"R-HSA-1483077.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482667, \"displayName\": \"1-acyl LPE is acylated to PE by LPEAT\", \"followingEvent\": [1482892], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPE is acylated to PE by LPEAT\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482667\", \"stIdVersion\": \"R-HSA-1482667.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482646, \"displayName\": \"2-acyl LPE is acylated to PE by LPEAT\", \"followingEvent\": [1482892], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"2-acyl LPE is acylated to PE by LPEAT\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482646\", \"stIdVersion\": \"R-HSA-1482646.2\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 1482962, \"displayName\": \"CDP-ETA and DAG are converted to PE by CEPT1/EPT1\", \"followingEvent\": [1482892], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"CDP-ETA and DAG are converted to PE by CEPT1/EPT1\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482962\", \"stIdVersion\": \"R-HSA-1482962.2\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1482892\", \"stIdVersion\": \"R-HSA-1482892.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1482831, \"displayName\": \"At the endoplasmic reticulum (ER) membrane, phosphatidyletha...\", \"schemaClass\": \"Summation\", \"text\": \"At the endoplasmic reticulum (ER) membrane, phosphatidylethanolamine (PE) is hydrolyzed, and has one of its acyl chains cleaved off by membrane-associated phospholipase A2 gamma 2A, PLA2G2A, to form 2-acyl lysophosphatidylethanolamine (LPE) (Yamashita et al. 2005, Ghomashchi et al. 2010, Yamashita et al. 2009).  Cytosolic phospholipase A2 enzymes show not only PLA2 hydrolyzing activity to form the 1-acyl lysophospholipid but also have a degree of PLA1 activity, producing a 2-acyl lysophospholipid.\"}]}" ;
