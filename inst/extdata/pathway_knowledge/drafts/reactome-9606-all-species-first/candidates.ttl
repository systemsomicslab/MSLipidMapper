<https://reactome.org/content/detail/R-HSA-8869241> a mslm:LipidReaction ;
    rdfs:label "PITPNM1,2,3 exchange PI for PA" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "PA [plasma membrane] + PI [endoplasmic reticulum membrane] => PA [endoplasmic reticulum membrane] + PI [plasma membrane]" ;
    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [8869241], \"className\": \"CatalystActivity\", \"dbId\": 8869233, \"displayName\": \"phosphatidylinositol transfer activity of PITPNM1,2,3 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 8869241, \"displayName\": \"PITPNM1,2,3 exchange PI for PA\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [8869241], \"dbId\": 426639, \"displayName\": \"PI [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI\", \"1-phosphatidyl-1D-myo-inositol(1-)\", \"Phosphatidyl 1D-myo-inositol\", \"1-phosphatidyl-1D-myo-inositol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426639\", \"stIdVersion\": \"R-ALL-426639.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [8869241], \"dbId\": 1602448, \"displayName\": \"PA [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PA\", \"phosphatidate(2-)\", \"phosphatidic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1602448\", \"stIdVersion\": \"R-ALL-1602448.4\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8869242, \"displayName\": \"Phosphatidylinositol-Phosphatidic Acid Exchange by Nir2 at ER-PM Contact Sites Maintains Phosphoinositide Signaling Competence\", \"journal\": \"Dev. Cell\", \"pages\": \"549-61\", \"pubMedIdentifier\": 26028218, \"schemaClass\": \"LiteratureReference\", \"title\": \"Phosphatidylinositol-Phosphatidic Acid Exchange by Nir2 at ER-PM Contact Sites Maintains Phosphoinositide Signaling Competence\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/26028218\", \"volume\": 33, \"year\": 2015}, {\"className\": \"LiteratureReference\", \"dbId\": 8869237, \"displayName\": \"Phosphatidylinositol 4,5-Bisphosphate Homeostasis Regulated by Nir2 and Nir3 Proteins at Endoplasmic Reticulum-Plasma Membrane Junctions\", \"journal\": \"J. Biol. Chem.\", \"pages\": \"14289-301\", \"pubMedIdentifier\": 25887399, \"schemaClass\": \"LiteratureReference\", \"title\": \"Phosphatidylinositol 4,5-Bisphosphate Homeostasis Regulated by Nir2 and Nir3 Proteins at Endoplasmic Reticulum-Plasma Membrane Junctions\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/25887399\", \"volume\": 290, \"year\": 2015}, {\"className\": \"LiteratureReference\", \"dbId\": 8869417, \"displayName\": \"Identification of a novel family of targets of PYK2 related to Drosophila retinal degeneration B (rdgB) protein\", \"journal\": \"Mol. Cell. Biol.\", \"pages\": \"2278-88\"