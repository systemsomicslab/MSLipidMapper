    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [1605632], \"className\": \"CatalystActivity\", \"dbId\": 1605761, \"displayName\": \"beta-N-acetylhexosaminidase activity of bHEXA,bHEXB [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 1605632, \"displayName\": \"bHEXA,bHEXB hydrolyze PSAP(195-273):Gb4Cer:PE\", \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [1605632], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}, {\"className\": \"Complex\", \"consumedByEvent\": [1605632], \"dbId\": 9840842, \"displayName\": \"PSAP(195-273):Gb4Cer:PE [lysosomal lumen]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"PSAP(195-273):Gb4Cer:PE\", \"mobilized Gb4Cer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840842\", \"stIdVersion\": \"R-HSA-9840842.1\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 1605770, \"displayName\": \"Oligosaccharide structure and amino acid sequence of the major glycopeptides of mature human beta-hexosaminidase\", \"journal\": \"Biochemistry\", \"pages\": \"5216-26\", \"pubMedIdentifier\": 2971395, \"schemaClass\": \"LiteratureReference\", \"title\": \"Oligosaccharide structure and