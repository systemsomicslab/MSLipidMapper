l Compound\", \"dbId\": 111294, \"displayName\": \"PPi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [9734535], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111294\", \"stIdVersion\": \"R-ALL-111294.5\"}], \"releaseDate\": \"2022-06-09\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9734535\", \"stIdVersion\": \"R-HSA-9734535.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9735487, \"displayName\": \"Bempedoic acid (ETC-1002) is first-in-class ATP-citrate lyas...\", \"schemaClass\": \"Summation\", \"text\": \"Bempedoic acid (ETC-1002) is first-in-class ATP-citrate lyase (ACLY) inhibitor used once a day for reducing LDL cholesterol levels in statin-refractory patients. ETC-1002 itself is a prodrug, which is converted to the active metabolite ETC-1002–CoA by endogenous liver acyl-CoA synthetase (SLC27A2, ACSVL1) activity (Pinkosky et al. 2016).\"}]}" ;
