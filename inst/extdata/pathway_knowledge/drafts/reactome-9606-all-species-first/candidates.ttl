    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9027633], \"className\": \"CatalystActivity\", \"dbId\": 9020578, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen of ALOX5 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 9027633, \"displayName\": \"ALOX5 oxidises DPAn-3 to 7-HDPAn-3\", \"followingEvent\": [9027625], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027633], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9027633], \"dbId\": 9608444, \"displayName\": \"DPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DPAn-3\", \"(7Z,10Z,13Z,16Z,19Z)-docosapentaenoate\", \"omega-3-docosapentaenoic acid\", \"(7Z,10Z,13Z,16Z,19Z)-docosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9608444\", \"stIdVersion\": \"R-ALL-9608444.5\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9028212, \"displayName\": \"Generation and dietary modulation of anti-inflammatory electrophilic omega-3 fatty acid derivatives\", \"journal\": \"PLoS ONE\", \"pages\": \"e94836\", \"pubMedIdentifier\": 24736647, \"schemaClass\": \"LiteratureReference\", \"title\": \"Generation and dietary modulation of anti-inflammatory electrophilic omega-3 fatty acid derivatives\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/24736647\", \"volume\": 9, \"year\": 2014}], \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises DPAn-3 to 7-HDPAn-3\"], \"orthologousEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11051189, \"displayName\": \"ALOX5 oxidises DPAn-3 to 7-HDPAn-3\", \"inferredFrom\": [9027633], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises DPAn-3 to 7-HDPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-9027633\", \"stIdVersion\": \"R-DDI-9027633.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10822977, \"displayName\": \"ALOX5 oxidises DPAn-3 to 7-HDPAn-3\", \"inferredFrom\": [9027633], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises DPAn-3 to 7-HDPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Gallus gallus\", \"stId\": \"R-GGA-9027633\", \"stIdVersion\": \"R-GGA-9027633.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10727799, \"displayName\": \"ALOX5 oxidises DPAn-3 to 7-HDPAn-3\", \"inferredFrom\": [9027633], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises DPAn-3 to 7-HDPAn-3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Xenopus tropicalis\", \"stId\": \"R-XTR-9027633\", \"stIdVersion\": \"R-XTR-9027633.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10645362, \"displayName\": \"ALOX5 oxidises DPAn-3 to 7-HDPAn-3\", \"inferredFrom\": [9027633], \"isInDisease\": false, \"isInferred\": true, 