<https://reactome.org/content/detail/R-HSA-209766> a mslm:LipidReaction ;
    rdfs:label "25(OH)D translocates from lysosomal lumen to cytosol" ;
    mslm:curationStatus mslm:Draft ;
    mslm:directionality mslm:SourceForward ;
    mslm:equation "25(OH)D [lysosomal lumen] => 25(OH)D [cytosol]" ;
    mslm:evidenceJson "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 209766, \"displayName\": \"25(OH)D translocates from lysosomal lumen to cytosol\", \"followingEvent\": [209868], \"goBiologicalProcess\": {\"accession\": \"0032365\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 258911, \"definition\": \"The directed movement of lipids within cells.\", \"displayName\": \"intracellular lipid transport\", \"name\": \"intracellular lipid transport\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0032365\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [209766], \"dbId\": 350136, \"displayName\": \"25(OH)D [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(OH)D\", \"calcidiol\", \"CDL\", \"25-hydroxyvitamin D3\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-350136\", \"stIdVersion\": \"R-ALL-350136.5\"}], \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 8963853, \"displayName\": \"The human HSP70 family of chaperones: where do we stand?\", \"journal\": \"Cell Stress Chaperones\", \"pages\": \"379-404\", \"pubMedIdentifier\": 26865365, \"schemaClass\": \"LiteratureReference\", \"title\": \"The human HSP70 family of chaperones: where do we stand?\", \"url\": \"http://www.ncbi.nlm.nih.gov/pubmed/26865365\", \"volume\": 21, \"year\": 2016}], \"maxDepth\": 1, \"name\": [\"25(OH)D translocates from lysosomal lumen to cytosol\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 209804, \"displayName\": \"25(OH)D [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(OH)D\", \"calcidiol\", \"CDL\", \"25-hydroxyvitamin D3\"], \"producedByEvent\": [209766], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-209804\", \"stIdVersion\": \"R-ALL-209804.6\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 350158, \"displayName\": \"LGMN hydrolyzes GC, releasing CUBN and 25(OH)D\", \"followingEvent\": [209766], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"LGMN hydrolyzes GC, releasing CUBN and 25(OH)D\"], \"releaseDate\": \"2008-06-30\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-350158\", \"stIdVersion\": \"R-HSA-350158.4\"}], \"releaseDate\": \"2008-06-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-209766\", \"stIdVersion\": \"R-HSA-209766.6\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 350113, \"displayName\": \"Once out of the lysosome, 25-hydroxyvitamin D (calcidiol, 25...\", \"schemaClass\": \"Summation\", \"text\": \"Once out of the lysosome, 25-hydroxyvitamin D (calcidiol, 25(OH)D) translocates to the mitochondion where it is made available to the mitochondrial membrane-resident protein CYP27B1 for further hydroxylation. The mechanism of mitochondrial targeting is unknown but may involve some kind of intracellular vitamin D binding protein (IDBP). IDBPs are related to the hsc-70 family of heat shock proteins and may function to localise vitamin D metabolites to specific areas. No human IDBP has yet been characterised (Radons 2016).\"}]}" ;
