ransition\", \"className\": \"Reaction\", \"dbId\": 10501145, \"displayName\": \"SUMF1 mediates the oxidation of cysteine to formylglycine, producing active arylsulfatases\", \"inferredFrom\": [1614362], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SUMF1 mediates the oxidation of cysteine to formylglycine, producing active arylsulfatases\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1614362\", \"stIdVersion\": \"R-SSC-1614362.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10386562, \"displayName\": \"SUMF1 mediates the oxidation of cysteine to formylglycine, producing active arylsulfatases\", \"inferredFrom\": [1614362], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SUMF1 mediates the oxidation of cysteine to formylglycine, producing active arylsulfatases\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1614362\", \"stIdVersion\": \"R-BTA-1614362.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10276513, \"displayName\": \"SUMF1 mediates the oxidation of cysteine to formylglycine, producing active arylsulfatases\", \"inferredFrom\": [1614362], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SUMF1 mediates the oxidation of cysteine to formylglycine, producing active arylsulfatases\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1614362\", \"stIdVersion\": \"R-CFA-1614362.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10163198, \"displayName\": \"SUMF1 mediates the oxidation of cysteine to formylglycine, producing active arylsulfatases\", \"inferredFrom\": [1614362], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SUMF1 mediates the oxidation of cysteine to formylglycine, producing active arylsulfatases\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1614362\", \"stIdVersion\": \"R-RNO-1614362.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10041007, \"displayName\": \"SUMF1 mediates the oxidation of cysteine to formylglycine, producing active arylsulfatases\", \"inferredFrom\": [1614362], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SUMF1 mediates the oxidation of cysteine to formylglycine, producing active arylsulfatases\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-1614362\", \"stIdVersion\": \"R-MMU-1614362.1\"}], \"output\": [{\"className\": \"Set\", \"dbId\": 1614309, \"displayName\": \"active ARS [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"active ARS\"], \"producedByEvent\": [1614362], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1614309\", \"stIdVersion\": \"R-HSA-1614309.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 194697, \"displayName\": \"NADH [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [1614362], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194697\", \"stIdVersion\": \"R-ALL-194697.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1663154, \"displayName\": \"H2S [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2S\", \"hydrosulfide\", \"hydrogen sulfide\"], \"producedByEvent\": [1614362], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1663154\", \"stIdVersion\": \"R-ALL-1663154.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 156540, \"displayName\": \"H+ [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [1614362], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-156540\", \"stIdVersion\": \"R-ALL-156540.3\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821384, \"definition\": \"structure updated after externally and internally reviewed\", \"displayName\": \"two stars\", \"name\": [\"two stars\"], \"schemaClass\": \"ReviewStatus\"}, \"regulatedBy\": [{\"className\": \"NegativeRegulation\", \"dbId\": 1623971, \"displayName\": \"Negative regulation by 'SUMF1:SUMF2 [endoplasmic reticulum lumen]'\", \"regulatedEntity\": [1614362], \"schemaClass\": \"NegativeRegulation\", \"stId\": \"R-HSA-1623971\", \"stIdVersion\": \"R-HSA-1623971.1\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-1614362\", \"stIdVersion\": \"R-HSA-1614362.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 1614366, \"displayName\": \"The sulfatase-modifying factor 1 (SUMF1, also called C-alpha...\", \"schemaClass\": \"Summation\", \"text\": \"The sulfatase-modifying factor 1 (SUMF1, also called C-alpha-formylglycine-generating enzyme, FGE) (Preusser-Kunze et al. 2005, Cosma et al. 2003, Landgrebe et al. 2003) oxidises the critical cysteine residue in arylsulfatases to an active site formylglycine (3-oxoalanine) residue thus conferring sulfatase activity (Roeser et al. 2006). Defects in SUMF1 cause multiple sulfatase deficiency (MSD) (MIM:272200), an impairment of arylsulfatase activity due to defective post-translational modification of the cysteine residue (Cosma et al. 2003, Dierks et al, 2003). This post-translational modification is thought to be highly conserved in eukaryotes (Selmer et al. 1996, von Figura et al. 1998).  SUMF1 is active as either a monomer or a homodimer. A monomer is described in this reaction.\"}]}" ;
