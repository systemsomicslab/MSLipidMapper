: \"R-ALL-389583\", \"stIdVersion\": \"R-ALL-389583.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 389536, \"displayName\": \"CO2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CO2\", \"carbon dioxide\"], \"producedByEvent\": [389639], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389536\", \"stIdVersion\": \"R-ALL-389536.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 389550, \"displayName\": \"isocitrate + NADP+ => 2-oxoglutarate + CO2 + NADPH + H+\", \"followingEvent\": [389639], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"isocitrate + NADP+ => 2-oxoglutarate + CO2 + NADPH + H+\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-389550\", \"stIdVersion\": \"R-HSA-389550.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 389622, \"displayName\": \"phytanate + CoA-SH + ATP => phytanoyl-CoA + AMP + pyrophosphate\", \"followingEvent\": [389639], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"phytanate + CoA-SH + ATP => phytanoyl-CoA + AMP + pyrophosphate\", \"3,7,11,15-tetramethylhexadecanoate + ATP + CoA => AMP + diphosphate + phytanoyl-CoA\"], \"releaseDate\": \"2009-04-01\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-389622\", \"stIdVersion\": \"R-HSA-389622.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 6809810, \"displayName\": \"PECR reduces 2E-phytenoyl-CoA to phytanoyl-CoA\", \"followingEvent\": [389639], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"PECR reduces 2E-phytenoyl-CoA to phytanoyl-CoA\", \"a (2E)-enoyl-CoA + H(+) + NADPH => a 2,3-saturated acyl-CoA + NADP(+)\"], \"releaseDate\": \"2016-03-23\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-6809810\", \"stIdVersion\": \"R-HSA-6809810.4\"}], \"releaseDate\": \"2009-04-01\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-389639\", \"stIdVersion\": \"R-HSA-389639.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 389617, \"displayName\": \"Peroxisomal phytanoyl-CoA dioxygenase catalyzes the reaction...\", \"schemaClass\": \"Summation\", \"text\": \"Peroxisomal phytanoyl-CoA dioxygenase catalyzes the reaction of phytanoyl-CoA, 2-oxoglutarate, and O2 to form 2-hydroxyphytanoyl-CoA, succinate, and CO2. The mature form of the enzyme lacks the first 30 amino acid residues of the full-length polypeptide and is complexed with Fe++. Mutations in this enzyme are the commonest cause of Refsum disease (Mukherji et al. 2001; McDonough et al. 2005).\"}]}" ;
