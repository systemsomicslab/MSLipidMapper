99], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLEKHA3,8 bind PI4P, ARF1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8870499\", \"stIdVersion\": \"R-RNO-8870499.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10085014, \"displayName\": \"PLEKHA3,8 bind PI4P, ARF1\", \"inferredFrom\": [8870499], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLEKHA3,8 bind PI4P, ARF1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-8870499\", \"stIdVersion\": \"R-MMU-8870499.1\"}], \"output\": [{\"className\": \"Complex\", \"dbId\": 8870493, \"displayName\": \"ARF1:PLEKHA3,8:PI4P [Golgi membrane]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 3, \"name\": [\"ARF1:PLEKHA3,8:PI4P\"], \"producedByEvent\": [8870499], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8870493\", \"stIdVersion\": \"R-HSA-8870493.1\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2016-09-19\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8870499\", \"stIdVersion\": \"R-HSA-8870499.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8870503, \"displayName\": \"Proteins with the plekstrin homology (PH) domain are able to...\", \"schemaClass\": \"Summation\", \"text\": \"Proteins with the plekstrin homology (PH) domain are able to bind specific phosphoinositides. Pleckstrin homology domain-containing family A members 3 and 8 (PLEKHA3 and PLEKHA8 aka FAPP1 and FAPP2) specifically bind phosphoinositide 4-phosphate (PI4P, PtdIns(4)P), a key intermediate in the synthesis of phosphoinositide 4,5-diphosphate (PIP2). PLEKHA3 and 8 are localised to the trans-Golgi network (TGN) where they interact with PI4P and the small GTPase ADP-ribosylation factor (ARF1) through their PH domains and mediate the transport of lipid cargo from the Golgi to the plasma membrane (Godi et al. 1999, Godi et al. 2004).\"}]}" ;
