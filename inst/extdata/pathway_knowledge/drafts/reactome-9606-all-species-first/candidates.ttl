: 10301966, \"displayName\": \"ACOT2,9,THEM4,5 hydrolyse MCFA-CoA, LCFA-CoA\", \"inferredFrom\": [5690066], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACOT2,9,THEM4,5 hydrolyse MCFA-CoA, LCFA-CoA\", \"a medium-chain fatty acyl-CoA + H2O => a medium-chain fatty acid + CoA + H(+)\", \"a long-chain fatty acyl-CoA + H2O => a long-chain fatty acid + CoA + H(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-5690066\", \"stIdVersion\": \"R-CFA-5690066.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10191434, \"displayName\": \"ACOT2,9,THEM4,5 hydrolyse MCFA-CoA, LCFA-CoA\", \"inferredFrom\": [5690066], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACOT2,9,THEM4,5 hydrolyse MCFA-CoA, LCFA-CoA\", \"a medium-chain fatty acyl-CoA + H2O => a medium-chain fatty acid + CoA + H(+)\", \"a long-chain fatty acyl-CoA + H2O => a long-chain fatty acid + CoA + H(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5690066\", \"stIdVersion\": \"R-RNO-5690066.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10068214, \"displayName\": \"ACOT2,9,THEM4,5 hydrolyse MCFA-CoA, LCFA-CoA\", \"inferredFrom\": [5690066], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACOT2,9,THEM4,5 hydrolyse MCFA-CoA, LCFA-CoA\", \"a medium-chain fatty acyl-CoA + H2O => a medium-chain fatty acid + CoA + H(+)\", \"a long-chain fatty acyl-CoA + H2O => a long-chain fatty acid + CoA + H(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Mus musculus\", \"stId\": \"R-MMU-5690066\", \"stIdVersion\": \"R-MMU-5690066.1\"}], \"output\": [{\"className\": \"Set\", \"dbId\": 5690519, \"displayName\": \"MCFA, LCFA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"MCFA, LCFA\", \"medium/long chain fatty acid\"], \"producedByEvent\": [5690066], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-5690519\", \"stIdVersion\": \"R-ALL-5690519.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29374, \"displayName\": \"CoA-SH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"CoA\", \"coenzyme A\"], \"producedByEvent\": [5690066], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29374\", \"stIdVersion\": \"R-ALL-29374.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [5690066], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}], \"previousReviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821385, \"definition\": \"structure upated after externally reviewed and then internally reviewed\", \"displayName\": \"four stars\", \"name\": [\"four stars\"], \"schemaClass\": \"ReviewStatus\"}, \"releaseDate\": \"2015-09-22\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-5690066\", \"stIdVersion\": \"R-HSA-5690066.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 5690546, \"displayName\": \"The maintenance/regulation of cellular levels of free fatty ...\", \"schemaClass\": \"Summation\", \"text\": \"The maintenance/regulation of cellular levels of free fatty acids and fatty acyl-CoAs (the activated form of free fatty acids) is extremely important, as imbalances in lipid metabolism can have serious consequences for human health. Acyl-coenzyme A thioesterases (ACOTs) hydrolyse the thioester bond in medium- to long-chain fatty acyl-CoAs (of C12-C18 lengths) (MCFA-CoA, LCFA-CoA) to their free fatty acids (MCFA, LCFA) (Cohen 2013, Hunt et al. 2012, Kirkby et al. 2010). ACOTs that function in the mitochondrion are ACOT2 (Hunt et al. 2006), ACOT9 (Kirkby et al. 2010), THEM4 dimer (Zhuravleva et al. 2012, Zhao et al. 2012) and THEM5 dimer (Zhuravleva et al. 2012). THEM4 is also functional in the cytosol and at the plasma membrane (Cohen 2013).\"}]}" ;
