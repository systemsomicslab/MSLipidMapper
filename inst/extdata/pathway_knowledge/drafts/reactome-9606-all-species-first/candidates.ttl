12394, \"displayName\": \"SCD5 desaturates ST-CoA to OLE-CoA\", \"inferredFrom\": [8847579], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SCD5 desaturates ST-CoA to OLE-CoA\", \"2 Fe(II)-(cytochrome b5) + 2 H(+) + O2 + octadecanoyl-CoA => (9Z)-octadecenoyl-CoA + 2 Fe(III)-(cytochrome b5) + 2 H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8847579\", \"stIdVersion\": \"R-CFA-8847579.1\"}], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 5690558, \"displayName\": \"OLE-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"OLE-CoA\", \"oleoyl-CoA(4-)\"], \"producedByEvent\": [8847579], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5690558\", \"stIdVersion\": \"R-ALL-5690558.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 4085425, \"displayName\": \"Fe(3+)Cb5 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Fe(3+)Cb5\", \"ferricytochrome b5\"], \"producedByEvent\": [8847579, 8847579], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-4085425\", \"stIdVersion\": \"R-ALL-4085425.3\"}, 4085425, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [8847579, 8847579], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 548831, \"displayName\": \"TECR,TECRL dehydrogenate TOD-CoA to ST-CoA\", \"followingEvent\": [8847579], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"TECR,TECRL dehydrogenate TOD-CoA to ST-CoA\", \"(2E)-octadecenoyl-CoA + H(+) + NADPH => NADP(+) + octadecanoyl-CoA\", \"trans-octadec-2-enoyl-CoA + NADPH + H+ => stearoyl-CoA + NADP+\"], \"releaseDate\": \"2008-12-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-548831\", \"stIdVersion\": \"R-HSA-548831.4\"}], \"releaseDate\": \"2016-03-23\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-8847579\", \"stIdVersion\": \"R-HSA-8847579.5\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 8847585, \"displayName\": \"Stearoyl-CoA desaturase 5 (SCD5, also known as acyl-CoA desa...\", \"schemaClass\": \"Summation\", \"text\": \"Stearoyl-CoA desaturase 5 (SCD5, also known as acyl-CoA desaturase 4), located on the ER membrane, utilises O2 and electrons from reduced ferrocytochrome b5 (Fe(2+)Cb5) to catalyse the insertion of a double bond into a range of fatty acyl-CoA substrates. SCD5 is most abundant in brain and pancreas. The reaction annotated here shows stearoyl-CoA (ST-CoA) desaturation to oleoyl-CoA (OLE-CoA). Studies of tagged recombinant enzyme overexpressed in transiently transfected cells suggest that the enzyme forms dimers and higher oligomers (Wang et al. 2005; Zhang et al. 2005).\"}]}" ;
