, \"producedByEvent\": [428696], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1132148, \"displayName\": \"sphingosine [cytoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"sphingosine\", \"sphingosine(1+)\", \"sphing-4-enine\", \"phys-ent-participant33701\"], \"producedByEvent\": [428696], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1132148\", \"stIdVersion\": \"R-ALL-1132148.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 428273, \"displayName\": \"SPHK1 phosphorylates sphingoid\", \"followingEvent\": [428696], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SPHK1 phosphorylates sphingoid\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428273\", \"stIdVersion\": \"R-HSA-428273.5\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 9695949, \"displayName\": \"SPHK2 phosphorylates sphingoid\", \"followingEvent\": [428696], \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"SPHK2 phosphorylates sphingoid\"], \"releaseDate\": \"2009-09-30\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9695949\", \"stIdVersion\": \"R-HSA-9695949.4\"}], \"releaseDate\": \"2009-09-30\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-428696\", \"stIdVersion\": \"R-HSA-428696.4\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 428692, \"displayName\": \"Phospholipid phosphatases 1 (PLPP1, PPAP2A, LPP1), 2 (PLPP2,...\", \"schemaClass\": \"Summation\", \"text\": \"Phospholipid phosphatases 1 (PLPP1, PPAP2A, LPP1), 2 (PLPP2, LPP2, PPAP2C), and 3 (PLPP3, LPP3, PPAP2B) associated with the plasma membrane catalyze the hydrolysis of cytosolic sphingosine 1-phosphate to form sphingosine and orthophosphate (Roberts et al. 1998). PLPPs have roles in angiogenesis and cancer (reviewed by Tang et al., 2015; Tang & Brindley, 2020).\"}]}" ;
