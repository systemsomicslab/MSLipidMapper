    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [163568], \"className\": \"CatalystActivity\", \"dbId\": 163421, \"displayName\": \"protein serine/threonine phosphatase activity of PP1 catalytic subunit [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005811\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13977, \"definition\": \"An intracellular non-membrane-bounded organelle comprising a matrix of coalesced lipids surrounded by a phospholipid monolayer. May include associated proteins.\", \"displayName\": \"lipid droplet\", \"name\": \"lipid droplet\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005811\"}], \"dbId\": 163568, \"displayName\": \"phosphorylated perilipin + H2O -> perilipin + orthophosphate\", \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [163568], \"dbId\": 163561, \"displayName\": \"p-S81,S277-PLIN1 [lipid droplet]\", \"endCoordinate\": 522, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"p-S81,S277-PLIN1\", \"p-S277,S81-PLIN1\", \"phosphorylated perilipin\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163561\", \"stIdVersion\": \"R-HSA-163561.2\", \"startCoordinate\": 1}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [163568], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"phosphorylated perilipin + H2O -> perilipin + orthophosphate\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 163460, \"displayName\": \"PLIN1 [lipid droplet]\", \"endCoordinate\": 522, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PLIN1\", \"perilipin\", \"PLIN\"], \"producedByEvent\": [163568], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163460\", \"stIdVersion\": \"R-HSA-163460.2\", \"startCoordinate\": 1}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [163568], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 163418, \"displayName\": \"perilipin + 2 ATP -> phosphorylated perilipin + 2 ADP\", \"followingEvent\": [163568], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"perilipin + 2 ATP -> phosphorylated perilipin + 2 ADP\"], \"releaseDate\": \"2005-06-13\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163418\", \"stIdVersion\": \"R-HSA-163418.4\"}], \"releaseDate\": \"2005-06-13\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-163568\", \"stIdVersion\": \"R-HSA-163568.3\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 163530, \"displayName\": \"Rat perilipin is dephosphorylated by protein phosphatase 1 (...\", \"schemaClass\": \"Summation\", \"text\": \"Rat perilipin is dephosphorylated by protein phosphatase 1 (Clifford et al. 1998). All three protein phosphatase 1 isoforms appear competent to carry out this reaction and there are no data to indicate which one preferentially acts on perilipin in vivo. Dephosphorylation of human perilipin has not been studied in detail, so the human reaction is inferred from the well-studied rat one.\"}]}" ;
