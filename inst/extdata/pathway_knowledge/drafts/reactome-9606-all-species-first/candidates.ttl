    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [9840884], \"className\": \"CatalystActivity\", \"dbId\": 9840888, \"displayName\": \"beta-N-acetylhexosaminidase activity of bHEXA,bHEXS [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 9840884, \"displayName\": \"bHEXA,bHEXS hydrolyze GM2A:SM2\", \"followingEvent\": [9840949], \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [9840884], \"dbId\": 9840882, \"displayName\": \"GM2A:SM2 [lysosomal lumen]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"GM2A:SM2\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-9840882\", \"stIdVersion\": \"R-HSA-9840882.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [9840884], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"literatureReference\": [{\"className\": \"LiteratureReference\", \"dbId\": 9840889, \"displayName\": \"Physiological substrates for human lysosomal beta -hexosaminidase S\", \"journal\": \"J Biol Chem\", \"pages\": \"2562-72\", \"pubMedIdentifier\": 11707436, \"schemaClass\": \"LiteratureReference\", \"title\": \"Physiological substrates for human lysosomal beta -hexosaminidase S\", \"url\": \"http://www.ncbi.nlm.nih.gov/