e\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2066763\", \"stIdVersion\": \"R-ALL-2066763.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [2066779], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2066781, \"displayName\": \"Formation of DHA-CoA catalysed by sterol carrier protein X (SCPx)\", \"followingEvent\": [2066779], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Formation of DHA-CoA catalysed by sterol carrier protein X (SCPx)\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2066781\", \"stIdVersion\": \"R-HSA-2066781.3\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 2066788, \"displayName\": \"Formation of DHA-CoA catalysed by 3-ketoacyl-CoA thiolase\", \"followingEvent\": [2066779], \"isChimeric\": false, \"isInDisease\": false, \"isInferred\": false, \"maxDepth\": 1, \"name\": [\"Formation of DHA-CoA catalysed by 3-ketoacyl-CoA thiolase\"], \"releaseDate\": \"2012-06-12\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2066788\", \"stIdVersion\": \"R-HSA-2066788.3\"}], \"releaseDate\": \"2012-06-12\", \"reviewStatus\": {\"className\": \"ReviewStatus\", \"dbId\": 9821382, \"definition\": \"externally reviewed\", \"displayName\": \"five stars\", \"name\": [\"five stars\"], \"schemaClass\": \"ReviewStatus\"}, \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"HSA\", \"className\": \"Species\", \"dbId\": 48887, \"displayName\": \"Homo sapiens\", \"name\": [\"Homo sapiens\", \"H. sapiens\", \"Hs\", \"human\", \"man\"], \"schemaClass\": \"Species\", \"taxId\": \"9606\"}], \"speciesName\": \"Homo sapiens\", \"stId\": \"R-HSA-2066779\", \"stIdVersion\": \"R-HSA-2066779.2\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 2066729, \"displayName\": \"DHA-CoA preferentially moves back to the ER, perhaps as a fr...\", \"schemaClass\": \"Summation\", \"text\": \"DHA-CoA preferentially moves back to the ER, perhaps as a free fatty acid. This conversion is usually catalysed by acyl-CoA thioesterases (ACOTs). No specific acyl-CoA thioesterase enzyme has been identified for the peroxisomal metabolism of DHA-CoA, but the peroxisomal ACOT8 has a wide substrate specificity and is likely to be responsible (Ferdinandusse et al. 2003, Hunt & Alexson. 2008).\"}]}" ;
