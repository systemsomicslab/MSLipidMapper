        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10207565], \"className\": \"CatalystActivity\", \"dbId\": 10207563, \"displayName\": \"phosphatidylinositol bisphosphate binding activity of PTPN13:PLEKHA1,2 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10207565, \"displayName\": \"PTPN13:PLEKHA1,2 bind PI(3,4)P2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10207565], \"dbId\": 10207560, \"displayName\": \"PTPN13:PLEKHA1,2 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PTPN13:PLEKHA1,2\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8870330\", \"stIdVersion\": \"R-RNO-8870330.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10207565], \"dbId\": 202247, \"displayName\": \"PI(3,4)P2 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2\", \"1-phosphatidyl-1D-myo-inositol 3,4-bisphosphate\", \"1-phosphatidyl-1D-myo-inositol 3,4-bisphosphates\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-202247\", \"stIdVersion\": \"R-ALL-202247.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTPN13:PL