    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10128336], \"className\": \"CatalystActivity\", \"dbId\": 10128332, \"displayName\": \"steroid 17-alpha-monooxygenase activity of CYP17A1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10128336, \"displayName\": \"CYP17A1 cleaves 17aHPREG to DHA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10128340], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10128336], \"dbId\": 193124, \"displayName\": \"17aHPREG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17aHPREG\", \"17alpha-hydroxypregnenolone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193124\", \"stIdVersion\": \"R-ALL-193124.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10128336], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false,