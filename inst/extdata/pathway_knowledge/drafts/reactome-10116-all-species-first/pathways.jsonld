        "@value": "bile salts and acids [cytosol] => bile salts and acids [extracellular region]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10220778], \"className\": \"CatalystActivity\", \"dbId\": 10220776, \"displayName\": \"bile acid transmembrane transporter activity of SLC51A:SLC51B [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 10220778, \"displayName\": \"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10220763], \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10220778], \"dbId\": 194156, \"displayName\": \"bile salts and acids [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts and acids\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-194156\", \"stIdVersion\": \"R-ALL-194156.2\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC51A:SLC51B transports bile salts from cytosol to extracellular region\", \"OSTA:OSTB exports bile salts from enterocytes to the portal system\"], \"output\": [{\"className\": \"Set\", \"dbId\": 192483, \"displayName\": \"bile salts and acids [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts and acids\"], \"producedByEvent\": [10220778], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-192483\", \"stIdVersion\": \"R-ALL-192483.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9733964\", \"stIdVersion\": \"R-RNO-9733964.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
