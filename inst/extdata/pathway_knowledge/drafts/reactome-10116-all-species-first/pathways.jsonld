        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "NADPH [mitochondrial matrix] + 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al [mitochondrial matrix] + H+ [mitochondrial matrix] + O2 [mitochondrial matrix] => NADP+ [mitochondrial matrix] + H2O [mitochondrial matrix] + 3,7,24THCA [mitochondrial matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10128634], \"className\": \"CatalystActivity\", \"dbId\": 10127997, \"displayName\": \"oxidoreductase activity, acting on NAD(P)H as acceptor of CYP27A1 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10128634, \"displayName\": \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al is oxidized to 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate (3,7,24THCA)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10128634], \"dbId\": 193716, \"displayName\": \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al\", \"(24S)-3alpha,7alpha,24-trihydroxy-5beta-cholestan-26-al\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193716\", \"stIdVersion\": \"R-ALL-193716.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10128634], \"dbId\": 113600, \"displayName\": \"NADPH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113600\", \"stIdVersion\": \"R-ALL-113600.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10128634], \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10128634], \"dbId\": 113533, \"displayName\": \"O2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113533\", \"stIdVersion\": \"R-ALL-113533.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al is oxidized to 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate (3,7,24THCA)\", \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al + NADPH + H+ + O2 => 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate (3,7,24THCA) + NADP+ + H2O\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193757, \"displayName\": \"3,7,24THCA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3,7,24THCA\", \"3alpha,7alpha,24-trihydroxy-5beta-cholestan-26-oic acid\", \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate\", \"3alpha,7alpha,24-trihydroxy-5beta-cholestan-26-oyl-CoA\"], \"producedByEvent\": [10128634], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193757\", \"stIdVersion\": \"R-ALL-193757.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113563, \"displayName\": \"NADP+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3