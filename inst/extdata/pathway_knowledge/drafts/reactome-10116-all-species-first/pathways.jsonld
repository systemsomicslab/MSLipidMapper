iesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1676082\", \"stIdVersion\": \"R-RNO-1676082.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10130224, \"displayName\": \"PTEN dephosphorylates PIP3\", \"followingEvent\": [10164086], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTEN dephosphorylates PIP3\", \"PI(3,4,5)P3 is dephosphorylated to PI (4,5)P2 by PTEN at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-199456\", \"stIdVersion\": \"R-RNO-199456.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10163761, \"displayName\": \"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers at the plasma membrane\", \"followingEvent\": [10164086], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1675776\", \"stIdVersion\": \"R-RNO-1675776.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1676177\", \"stIdVersion\": \"R-RNO-1676177.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes