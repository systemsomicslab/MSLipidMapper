    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10224486], \"className\": \"CatalystActivity\", \"dbId\": 10224484, \"displayName\": \"fucosyltransferase activity of FUT1,2 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}, {\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}], \"dbId\": 10224486, \"displayName\": \"FUT1,2 transfer fucose to gangliosides\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10224486], \"dbId\": 9846337, \"displayName\": \"GM1,GA1 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GM1,GA1\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9846337\", \"stIdVersion\": \"R-ALL-9846337.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10224486], \"dbId\": 205683, \"displayName\": \"GDP-Fuc [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GDP-Fuc\", \"GDP-beta-L-fucose(2-)\", \"GDP-L-fucose\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-205683\", \"stIdVersion\": \"R-ALL-205683.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FUT1,2 transfer fucose to gangliosides\"], \"output\": [{\"className\": \"Set\", \"dbId\": 9846331, \"displayName\": \"Fuc-GM1, Fuc-GA1 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Fuc-GM1, Fuc-GA1\"], \"producedByEvent\": [10224486], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9846331\", \"stIdVersion\": \"R-ALL-9846331.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 205689, \"displayName\": \"GDP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GDP\", \"GDP(3-)\"], \"producedByEvent\": [10224486], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-205689\", \"stIdVersion\": \"R-ALL-205689.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10224486], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10224468, \"displayName\": \"B3GALT4 transfers Gal to gangliosides\", \"followingEvent\": [10224486], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"B3GALT4 transfers Gal to gangliosides\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9845516\", \"stIdVersion\": \"R-RNO-9845516.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\