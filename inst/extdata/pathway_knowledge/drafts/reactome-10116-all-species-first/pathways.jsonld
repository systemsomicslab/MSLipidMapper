    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10208068], \"className\": \"CatalystActivity\", \"dbId\": 10208066, \"displayName\": \"protein-macromolecule adaptor activity of p-Y389,400-RUFY1 [early endosome membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0031901\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 171062, \"definition\": \"The lipid bilayer surrounding an early endosome.\", \"displayName\": \"early endosome membrane\", \"name\": \"early endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031901\"}], \"dbId\": 10208068, \"displayName\": \"p-Y389,400-RUFY1 binds RAB4A:GTP, RAB5:GTP, RAB14:GTP\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10208068], \"dbId\": 10208051, \"displayName\": \"phospho-Rufy1 [early endosome membrane]\", \"endCoordinate\": 708, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"phospho-Rufy1\", \"p-Y389,400-RUFY1\", \"F1LR42\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5215951\", \"stIdVersion\": \"R-RNO-5215951.1\", \"startCoordinate\": 1}, {\"className\": \"Complex\", \"consumedByEvent\": [10208068], \"dbId\": 10208055, \"displayName\": \"RAB14:GTP [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"RAB14:GTP\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8871377\", \"stIdVersion\": \"R-RNO-8871377.1\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10208068], \"dbId\": 10208059, \"displayName\": \"RAB4A:GTP [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"RAB4A:GTP\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8871367\", \"stIdVersion\": \"R-RNO-8871367.1\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10208068], \"dbId\": 10208063, \"displayName\": \"RAB5A:GTP [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"RAB5A:GTP\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-2130191\", \"stIdVersion\": \"R-RNO-2130191.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"p-Y389,400-RUFY1 binds RAB4A:GTP, RAB5:GTP, RAB14:GTP\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10208065, \"displayName\": \"p-Y389,400-RUFY1:p-Y389,400-RUFY1:RAB4A:GTP:RAB5:GTP:RAB14:GTP [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"p-Y389,400-RUFY1:p-Y389,400-RUFY1:RAB4A:GTP:RAB5:GTP:RAB14:GTP\"], \"producedByEvent\": [10208068], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8871353\", \"stIdVersion\": \"R-RNO-8871353.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8871366\", \"stIdVersion\": \"R-RNO-8871366.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
