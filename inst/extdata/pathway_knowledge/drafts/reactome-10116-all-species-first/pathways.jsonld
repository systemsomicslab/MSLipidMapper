        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10206016], \"className\": \"CatalystActivity\", \"dbId\": 10206014, \"displayName\": \"lipid transfer activity of HSD17B13 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005811\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13977, \"definition\": \"An intracellular non-membrane-bounded organelle comprising a matrix of coalesced lipids surrounded by a phospholipid monolayer. May include associated proteins.\", \"displayName\": \"lipid droplet\", \"name\": \"lipid droplet\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005811\"}], \"dbId\": 10206016, \"displayName\": \"HSD17B13 binds lipid droplets\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10206016], \"dbId\": 10206011, \"displayName\": \"HSD17B13 [cytosol]\", \"endCoordinate\": 300, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HSD17B13\", \"Q5M875\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8862029\", \"stIdVersion\": \"R-RNO-8862029.1\", \"startCoordinate\": 20}, {\"className\": \"Complex\", \"consumedByEvent\": [10206016], \"d