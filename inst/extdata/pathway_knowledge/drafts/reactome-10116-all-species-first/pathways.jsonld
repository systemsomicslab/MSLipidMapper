      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10216075], \"className\": \"CatalystActivity\", \"dbId\": 10170488, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen of Ac-PTGS2 dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10216075, \"displayName\": \"Ac-PTGS2 dimer oxidises DHA to 17-HDHA (macrophages)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10216075], \"dbId\": 9024011, \"displayName\": \"DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHA\", \"(4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoate\", \"Docosahexaenoic acid\", \"all-cis-docosa-4,7,10,13,16,19-hexaenoic acid\", \"cis-4,7,10,13,16,19-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024011\", \"stIdVersi