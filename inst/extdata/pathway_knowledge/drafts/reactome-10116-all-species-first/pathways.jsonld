    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10182528], \"className\": \"CatalystActivity\", \"dbId\": 10182526, \"displayName\": \"transcription coregulator activity of NCOA1,NCOA2,RXRA [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10182528, \"displayName\": \"NR1H4:DCA,CDCA,LCHA binds RXRA and NCOA1,2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10182528], \"dbId\": 10127968, \"displayName\": \"NR1H4:DCA,CDCA,LCHA [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"NR1H4:DCA,CDCA,LCHA\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5340186\", \"stIdVersion\": \"R-RNO-5340186.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10182528], \"dbId\": 10182525, \"displayName\": \"NCOA1,NCOA2,RXRA [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"NCOA1,NCOA2,RXRA\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9957259\", \"stIdVersion\": \"R-RNO-9957259.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NR1H4:DCA,CDCA,LCHA binds RXRA and NCOA1,2\", \"FXR:bile acids binds RXRA and NCOA1,2\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10127978, \"displayName\": \"NCOA1,2:RXRA:NR1H4:DCA,CDCA,LCHA [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"NCOA1,2:RXRA:NR1H4:DCA,CDCA,LCHA\"], \"producedByEvent\": [10182528], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5340274\", \"stIdVersion\": \"R-RNO-5340274.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10182500, \"displayName\": \"NR1H4 binds DCA, CDCA, LCHA\", \"followingEvent\": [10182528], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NR1H4 binds DCA, CDCA, LCHA\", \"FXR binds bile acids\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5340195\", \"stIdVersion\": \"R-RNO-5340195.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5340251\", \"stIdVersion\": \"R-RNO-5340251.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
