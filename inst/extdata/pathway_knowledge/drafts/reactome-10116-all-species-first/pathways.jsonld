    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10193310], \"className\": \"CatalystActivity\", \"dbId\": 10193308, \"displayName\": \"ethanolamine-phosphate phospho-lyase activity of PXLP-K278-ETNPPL tetramer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10193310, \"displayName\": \"PXLP-K278-ETNPPL tetramer hydrolyses PETA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10193310], \"dbId\": 5696414, \"displayName\": \"PETA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PETA\", \"O-phosphoethanolamine\", \"phosphoethanolamine\", \"ethanolamine phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5696414\", \"stIdVersion\": \"R-ALL-5696414.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10193310], \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PXLP-K278-ETNPPL tetramer hydrolyses PETA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 113532, \"displayName\": \"CH3CHO [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CH3CHO\", \"acetaldehyde\", \"Ethanal\"], \"producedByEvent\": [10193310], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113532\", \"stIdVersion\": \"R-ALL-113532.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 5693978, \"displayName\": \"NH3 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NH3\", \"ammonia\"], \"producedByEvent\": [10193310], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5693978\", \"stIdVersion\": \"R-ALL-5693978.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113548, \"displayName\": \"Pi [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\"], \"producedByEvent\": [10193310], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113548\", \"stIdVersion\": \"R-ALL-113548.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10161925, \"displayName\": \"ETA is phosphorylated to PETA by CHK/ETNK\", \"followingEvent\": [10193310], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ETA is phosphorylated to PETA by CHK/ETNK\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1483222\", \"stIdVersion\": \"R-RNO-1483222.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5696415\", \"stIdVersion\": \"R-RNO-5696415.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
