        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10128632], \"className\": \"CatalystActivity\", \"dbId\": 10128076, \"displayName\": \"racemase and epimerase activity of AMACR [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10128632, \"displayName\": \"Isomerization of 3,7,24THCA-CoA to (24R, 25R) 3alpha,7alpha,24-trihydroxy-5beta-cholestanoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10128404], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10128632], \"dbId\": 193732, \"displayName\": \"3,7,24THCA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3,7,24THCA-CoA\", \"3alpha,7alpha,24-trihydroxy-5beta-cholestan-26-oyl-CoA\", \"25(R) 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoyl-CoA\"], \"producedByEvent\": [10128632], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193732\", \"stIdVersion\": \"R-ALL-193732.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Isomerization of 3,7,24THCA-CoA to (24R, 25R) 3alpha,7alpha,24-trihydroxy-5beta-cholestanoyl-CoA\", \"3,7,24THCA-CoA => (24R, 25R) 3alpha,7alpha,24-trihydroxy-5beta-cholestanoyl-CoA\"], \"output\": [193732], \"preceding