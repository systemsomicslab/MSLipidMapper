      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10170344], \"className\": \"CatalystActivity\", \"dbId\": 10170342, \"displayName\": \"prostaglandin D2 11-ketoreductase activity of AKR1C3 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10170344, \"displayName\": \"PGD2 is reduced to 11-epi-PGF2a by AKRIC3\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10170344], \"dbId\": 879629, \"displayName\": \"PGD2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGD2\", \"prostaglandin D2(1-)\", \"prostaglandin D2\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-879629\", \"stIdVersion\": \"R-ALL-879629.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10170344], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10170344], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PGD2 is reduced to 11-epi-PGF2a by AKRIC3\", \"H(+) + NADPH + prostaglandin D2 => 11beta-prostaglandin F2 + NADP(+)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142710, \"displayName\": \"11epi-PGF2a [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"11epi-PGF2a\", \"11-epi-prostaglandin F2alpha(1-)\", \"11-epi-prostaglandin F2alpha\"], \"producedByEvent\": [10170344], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142710\", \"stIdVersion\": \"R-ALL-2142710.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [10170344], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10170380, \"displayName\": \"PGH2 is isomerised to PGD2 by HPGDS\", \"followingEvent\": [10170344], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PGH2 is isomerised to PGD2 by HPGDS\", \"prostaglandin H2 => prostaglandin D2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-2161701\", \"stIdVersion\": \"R-RNO-2161701.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus