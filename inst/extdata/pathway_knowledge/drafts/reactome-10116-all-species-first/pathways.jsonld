    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10135530], \"className\": \"CatalystActivity\", \"dbId\": 10135528, \"displayName\": \"cysteine-type endopeptidase activity of LGMN [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 10135530, \"displayName\": \"LGMN hydrolyzes GC, releasing CUBN and 25(OH)D\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10135530], \"dbId\": 10133497, \"displayName\": \"CUBN:GC:25(OH)D [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"CUBN:GC:25(OH)D\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-350085\", \"stIdVersion\": \"R-RNO-350085.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LGMN hydrolyzes GC, releasing CUBN and 25(OH)D\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 10133495, \"displayName\": \"CUBN [lysosomal lumen]\", \"endCoordinate\": 3623, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CUBN\", \"O70244\"], \"producedByEvent\": [10135530], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-350088\", \"stIdVersion\": \"R-RNO-350088.1\", \"startCoordinate\": 36}, {\"className\": \"Chemical Compound\", \"dbId\": 350136, \"displayName\": \"25(OH)D [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(OH)D\", \"calcidiol\", \"CDL\", \"25-hydroxyvitamin D3\"], \"producedByEvent\": [10135530], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-350136\", \"stIdVersion\": \"R-ALL-350136.5\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10133499, \"displayName\": \"Endocytic translocation of CUBN:GC:25(OH)D to lysosomal lumen\", \"followingEvent\": [10135530], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Endocytic translocation of CUBN:GC:25(OH)D to lysosomal lumen\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-209760\", \"stIdVersion\": \"R-RNO-209760.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-350158\", \"stIdVersion\": \"R-RNO-350158.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
