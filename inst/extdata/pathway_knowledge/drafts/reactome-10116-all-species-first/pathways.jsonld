        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10210805], \"className\": \"CatalystActivity\", \"dbId\": 10210803, \"displayName\": \"hydroperoxy icosatetraenoate isomerase activity of ALOXE3 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10210805, \"displayName\": \"ALOXE3 isomerises 12R-HpETE to HXA3\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10210805], \"dbId\": 2142790, \"displayName\": \"12R-HpETE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"12R-HpETE\", \"12(R)-HPETE(1-)\", \"12(R)-HPETE\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142790\", \"stIdVersion\": \"R-ALL-2142790.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOXE3 isomerises 12R-HpETE to HXA3\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8942209, \"displayName\": \"HXA3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HXA3\", \"hepoxilin A3(1-)\", \"hepoxilin A3\"], \"producedByEvent\": [10210805], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8942209\", \"stIdVersion\": \"R-ALL-8942209.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10170477, \"displayName\": \"Arachidonate is oxidised to 12R-HpETE by ALOX12B\", \"followingEvent\": [10210805], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Arachidonate is oxidised to 12R-HpETE by ALOX12B\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate + O2 => (12R)-hydroperoxy-(5Z,8Z,10E,14Z)-eicosatetraenoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-2161950\", \"stIdVersion\": \"R-RNO-2161950.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8942208\", \"stIdVersion\": \"R-RNO-8942208.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on