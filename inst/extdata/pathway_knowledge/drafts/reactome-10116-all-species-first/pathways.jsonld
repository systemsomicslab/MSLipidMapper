        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10202053], \"className\": \"CatalystActivity\", \"dbId\": 10202051, \"displayName\": \"phosphatase activator activity of MTMR12 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10202053, \"displayName\": \"MTMR12 binds MTM1\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10202060], \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10202053], \"dbId\": 10163784, \"displayName\": \"MTM1 [cytosol]\", \"endCoordinate\": 603, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MTM1\", \"Q6AXQ4\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1604646\", \"stIdVersion\": \"R-RNO-1604646.1\", \"startCoordinate\": 1}, {\"className\": \"Protein\", \"consumedByEvent\": [10202053], \"dbId\": 10202048, \"displayName\": \"Mtmr12 [cytosol]\", \"endCoordinate\": 747, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Mtmr12\", \"MTMR12\", \"Q5FVM6\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-6809657\", \"stIdVersion\": \"R-RNO-6809657.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInfer