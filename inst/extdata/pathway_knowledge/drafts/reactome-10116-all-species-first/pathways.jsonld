        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10215680], \"className\": \"CatalystActivity\", \"dbId\": 10215671, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen of ALOX5 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10215680, \"displayName\": \"ALOX5 oxidises 18(R)-HEPE to 5(S)-Hp-18(R)-HEPE\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10215692], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10215680], \"dbId\": 9023651, \"displayName\": \"18(R)-HEPE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"18(R)-HEPE\", \"18(R)-HEPE(1-)\", \"18(R)-hydroxyeicosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9023651\", \"stIdVersion\": \"R-ALL-9023651.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10215680], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 18(R)-