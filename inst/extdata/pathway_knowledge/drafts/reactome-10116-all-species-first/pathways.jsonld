      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10215729], \"className\": \"CatalystActivity\", \"dbId\": 10215695, \"displayName\": \"arachidonate 15-lipoxygenase activity of ALOX15 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10215729, \"displayName\": \"ALOX15 oxidises DHA to 17(S)-Hp-DHA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10215991], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10215729], \"dbId\": 9024011, \"displayName\": \"DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHA\", \"(4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoate\", \"Docosahexaenoic acid\", \"all-cis-docosa-4,7,10,13,16,19-hexaenoic acid\", \"cis-4,7,10,13,16,19-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024011\", \"stIdVersion\": \"R-ALL-9024011.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10215729], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX15 oxidises DHA to 17(S)-Hp-DHA\", \"4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoate + O2 => (17S)-hydroperoxy-(4Z,7Z,10Z,13Z,15E,19Z)-docosahexaenoate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9024012, \"displayName\": \"17(S)-Hp-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17(S)-Hp-DHA\", \"(4Z,7Z,10Z,13Z,15E,17S,19Z)-17-hydroperoxydocosahexaenoate\", \"(17S)-HPDHA(1-)\", \"(17S)-HPDoHE\", \"(4Z,7Z,10Z,13Z,15E,17S,19Z)-17-hydroperoxydocosahexaenoic acid\", \"17(S)-hydroperoxy-docosahexaenoic acid\"], \"producedByEvent\": [10215729], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024012\", \"stIdVersion\": \"R-ALL-9024012.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9020275\", \"stIdVersion\": \"R-RNO-9020275.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
