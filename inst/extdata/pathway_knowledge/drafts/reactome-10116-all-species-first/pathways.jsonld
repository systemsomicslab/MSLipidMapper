    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "Ac-CoA [peroxisomal matrix] + CAR [peroxisomal matrix] => CoA-SH [peroxisomal matrix] + ACAR [peroxisomal matrix]"
      }
