    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + 20OH-LTB4 [cytosol] + NADPH [cytosol] + O2 [cytosol] => H2O [cytosol] + 20cho-LTB4 [cytosol] + NADP+ [cytosol]"
