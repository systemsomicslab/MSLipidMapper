    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10144539], \"className\": \"CatalystActivity\", \"dbId\": 10144522, \"displayName\": \"serine C-palmitoyltransferase activity of SPTLC complexes [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10144539, \"displayName\": \"SPTLC complexes transfer acyl-CoA onto serine\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10144487], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10144539], \"dbId\": 200736, \"displayName\": \"L-Ser [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"L-Ser\", \"L-serine zwitterion\", \"Ser\", \"L-serine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-200736\", \"stIdVersion\": \"R-ALL-200736.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10144539], \"dbId\": 1500578, \"displayName\": \"acyl-