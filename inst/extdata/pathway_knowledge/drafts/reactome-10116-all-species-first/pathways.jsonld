    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10163198], \"className\": \"CatalystActivity\", \"dbId\": 10163196, \"displayName\": \"oxidoreductase activity of SUMF1 [endoplasmic reticulum lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}], \"dbId\": 10163198, \"displayName\": \"SUMF1 mediates the oxidation of cysteine to formylglycine, producing active arylsulfatases\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10163198], \"dbId\": 10163170, \"displayName\": \"ARS [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"ARS\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1614312\", \"stIdVersion\": \"R-RNO-1614312.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10163198], \"dbId\": 194653, \"displayName\": \"NAD+ [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194653\", \"stIdVersion\": \"R-ALL-194653.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SUMF1 mediates the oxidation of cysteine to formylglycine, producing active arylsulfatases\"], \"output\": [{\"className\": \"Set\", \"dbId\": 10163195, \"displayName\": \"active ARS [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"active ARS\"], \"producedByEvent\": [10163198], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1614309\", \"stIdVersion\": \"R-RNO-1614309.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 194697, \"displayName\": \"NADH [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [10163198], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194697\", \"stIdVersion\": \"R-ALL-194697.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1663154, \"displayName\": \"H2S [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2S\", \"hydrosulfide\", \"hydrogen sulfide\"], \"producedByEvent\": [10163198], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1663154\", \"stIdVersion\": \"R-ALL-1663154.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 156540, \"displayName\": \"H+ [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10163198], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-156540\", \"stIdVersion\": \"R-ALL-156540.3\"}], \"regulatedBy\": [{\"className\": \"NegativeRegulation\", \"dbId\": 10163199, \"displayName\": \"Negative regulation by 'SUMF1:SUMF2 [endoplasmic reticulum lumen]'\", \"regulatedEntity\": [10163198], \"schemaClass\": \"NegativeRegulation\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1614362\", \"stIdVersion\": \"R-RNO-1614362.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
