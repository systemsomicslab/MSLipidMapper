        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10116346], \"className\": \"CatalystActivity\", \"dbId\": 10116344, \"displayName\": \"acyl-CoA dehydrogenase activity of ACADS tetramer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10116346, \"displayName\": \"Butanoyl-CoA+FAD => Crotonoyl-CoA+FADH2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10116337], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10116346], \"dbId\": 113596, \"displayName\": \"FAD [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FAD\", \"FAD(3-)\", \"Flavin adenine dinucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113596\", \"stIdVersion\": \"R-ALL-113596.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10116346], \"dbId\": 77318, \"displayName\": \"BT-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"BT-CoA\", \"butyryl-CoA(4-)\", \"Butanoyl-CoA\", \"butyryl-CoA\", \"beta-hydroxybutyryl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77318\", \"stIdVersion\": \"R-ALL-77318.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10116346], \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Butanoyl-CoA+FAD => Crotonoyl-CoA+FADH2\", \"butanoyl-CoA + FAD + H(+) => (2E)-butenoyl-CoA + FADH2\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 31649, \"displayName\": \"FADH2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FADH2\", \"FADH2(2-)\"], \"producedByEvent\": [10116346], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-31649\", \"stIdVersion\": \"R-ALL-31649.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 77313, \"displayName\": \"Crotonoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Crotonoyl-CoA\", \"crotonoyl-CoA(4-)\"], \"producedByEvent\": [10116346], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77313\", \"stIdVersion\": \"R-ALL-77313.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10116348, \"displayName\": \"3-Oxohexanoyl-CoA+CoA-SH => Butanoyl-CoA + acetyl-CoA\", \"followingEvent\": [10116346], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-Oxohexanoyl-CoA+CoA-SH => Butanoyl-CoA + acetyl-CoA\", \"3-oxohexanoyl-CoA + CoA => butanoyl-CoA + acetyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-77321\", \"stIdVersion\": \"R-RNO-77321.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abb