    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10114064], \"className\": \"CatalystActivity\", \"dbId\": 10110890, \"displayName\": \"acetyl-CoA C-acetyltransferase activity of ACAT1 tetramer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10114064, \"displayName\": \"acetoacetyl-CoA + CoA <=> 2 acetyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10114064], \"dbId\": 73871, \"displayName\": \"ACA-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ACA-CoA\", \"acetoacetyl-CoA(4-)\", \"acetoacetyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-73871\", \"stIdVersion\": \"R-ALL-73871.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10114064], \"dbId\": 29374, \"displayName\": \"CoA-SH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"CoA\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29374\", \"stIdVersion\": \"R-ALL-29374.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"acetoacetyl-CoA + CoA <=> 2 acetyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 113559, \"displayName\": \"Ac-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ac-CoA\", \"acetyl-CoA(4-)\", \"Acetyl coenzyme A\", \"acetyl-CoA\"], \"producedByEvent\": [10114064, 10114064], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113559\", \"stIdVersion\": \"R-ALL-113559.5\"}, 113559], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10114053, \"displayName\": \"OXCT dimers transfer CoA from SUCC-CoA to ACA, forming ACA-CoA\", \"followingEvent\": [10114064], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"OXCT dimers transfer CoA from SUCC-CoA to ACA, forming ACA-CoA\", \"acetoacetate + succinyl-CoA <=> acetoacetyl-CoA + succinate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-74177\", \"stIdVersion\": \"R-RNO-74177.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-74181\", \"stIdVersion\": \"R-RNO-74181.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
