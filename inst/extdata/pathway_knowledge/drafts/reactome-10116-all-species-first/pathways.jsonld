    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10142187], \"className\": \"CatalystActivity\", \"dbId\": 10142185, \"displayName\": \"transcription corepressor activity of Corepressors of PPARalpha [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10142187, \"displayName\": \"PPARA:RXRA binds Corepressors of PPARA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10142184], \"goBiologicalProcess\": {\"accession\": \"0060633\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 422887, \"definition\": \"Any process that decreases the rate, frequency or extent of a process involved in starting transcription from an RNA polymerase II promoter.\", \"displayName\": \"negative regulation of transcription initiation by RNA polymerase II\", \"name\": \"negative regulation of transcription initiation by RNA polymerase II\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0060633\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10142187], \"dbId\": 10142142, \"displayName\": \"Corepressors of PPARalpha [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Corepressors of PPARalpha\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-400207\", \"stIdVersion\": \"R-RNO-400207.1\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10142187], \"dbId\": 10142144, \"displayName\": \"PPARA:RXRA heterodimer [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PPARA:RXRA heterodimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-400138\", \"stIdVersion\": \"R-RNO-400138.1\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10142187], \"dbId\": 10135480, \"displayName\": \"Tbl1x [nucleoplasm]\", \"endCoordinate\": 577, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Tbl1x\", \"TBL1X\", \"A0A0G2JY80\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-351644\", \"stIdVersion\": \"R-RNO-351644.1\", \"startCoordinate\": 1}, {\"className\": \"Protein\", \"consumedByEvent\": [10142187], \"dbId\": 10135484, \"displayName\": \"Tbl1xr1 [nucleoplasm]\", \"endCoordinate\": 514, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Tbl1xr1\", \"TBL1XR1\", \"D3ZNF4\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-351643\", \"stIdVersion\": \"R-RNO-351643.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA:RXRA binds Corepressors of PPARA\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10142146, \"displayName\": \"PPARA:RXRA:Corepressors [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PPARA:RXRA:Corepressors\"], \"producedByEvent\": [10142187], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-400196\", \"stIdVersion\": \"R-RNO-400196.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10142190, \"displayName\": \"PPARA binds RXRA\", \"followingEvent\": [10142187], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA binds RXRA\", \"PPARA binds RXRA forming PPARA:RXRA heterodimer at promoter of target gene\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-400204\", \"stIdVersion\": \"R-RNO-400204.1\"}, {\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10142184, \"displayName\": \"Fatty acid ligands activate PPARA\", \"followingEvent\": [10142187], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Fatty acid ligands activate PPARA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-400143\", \"stIdVersion\": \"R-RNO-400143.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10220790, \"displayName\": \"PPARA binds fibrates\", \"followingEvent\": [10142187], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA binds fibrates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9734475\", \"stIdVersion\": \"R-RNO-9734475.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-400183\", \"stIdVersion\": \"R-RNO-400183.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
