    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MOGAT1,2,3 transfer acyl group from acyl-CoA to 2-acylglycerol to form DAG"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/curationStatus": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/Draft"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/directionality": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "2AG [cytosol] + acyl-CoA [cytosol] => DAG [cytosol] + CoA-SH [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10199448], \"className\": \"CatalystActivity\", \"dbId\": 10199446, \"displayName\": \"2-acylglycerol O-acyltransferase activity of MOGAT1,2,3 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10199448, \"displayName\": \"MOGAT1,2,3 transfer acyl group from acyl-CoA to 2-acylglycerol to form DAG\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10199448], \"dbId\": 6800352, \"displayName\": \"2AG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2AG\", \"2-monoglyceride\", \"2-acylglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6800352\", \"stIdVersion\": \"R-ALL-6800352.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10199448], \"dbId\": 1500578, \"displayName\": \"acyl-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"acyl-CoA\", \"acyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500578\", \"stIdVersion\": \"R-ALL-1500578.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MOGAT1,2,3 transfer acyl group from acyl-CoA to 2-acylglycerol to form DAG\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 76103, \"displayName\": \"DAG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DAG\", \"1,2-diacyl-sn-glycerol\", \"1,2-diacylglycerol\"], \"producedByEvent\": [10199448], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76103\", \"stIdVersion\": \"R-ALL-76103.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10199448], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-6800334\", \"stIdVersion\": \"R-RNO-6800334.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
