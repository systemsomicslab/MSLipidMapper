    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10127745], \"className\": \"CatalystActivity\", \"dbId\": 10127743, \"displayName\": \"isopentenyl-diphosphate delta-isomerase activity of IDI1 or 2 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10127745, \"displayName\": \"Isopentenyl pyrophosphate rearranges to dimethylallyl pyrophosphate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10127694], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10127745], \"dbId\": 191362, \"displayName\": \"IPPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"IPPP\", \"isopentenyl diphosphate(3-)\", \"delta3-isopentenyl-PP\", \"isopentenyl diphosphate\", \"delta3-isopentenyl pyrophosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191362\", \"stIdVersion\": \"R-ALL-191362.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Isopentenyl pyrophosphate rearranges to dimethylallyl pyrophosphate\", \"isopentenyl diphosphate => dimethylallyl diphosphate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 191324, \"displayName\": \"DMAPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DMAPP\", \"prenyl diphosphate(3-)\", \"Dimethylallyl pyrophosphate\", \"prenyl diphosphate\"], \"producedByEvent\": [10127745], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191324\", \"stIdVersion\": \"R-ALL-191324.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10127766, \"displayName\": \"MVD decarboxylates MVA5PP to IPPP\", \"followingEvent\": [10127745], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MVD decarboxylates MVA5PP to IPPP\", \"(R)-5-diphosphomevalonate + ATP => isopentenyl diphosphate + ADP + phosphate + CO2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-191414\", \"stIdVersion\": \"R-RNO-191414.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-191382\", \"stIdVersion\": \"R-RNO-191382.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
