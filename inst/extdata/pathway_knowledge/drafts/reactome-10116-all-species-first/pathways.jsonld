    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10162938], \"className\": \"CatalystActivity\", \"dbId\": 10162936, \"displayName\": \"exo-alpha-sialidase activity of NEU2 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10162938, \"displayName\": \"NEU2 cleaves GM3 to form LacCer (cytosol)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10162938], \"dbId\": 1605590, \"displayName\": \"GM3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GM3\", \"alpha-N-acetylneuraminosyl-(2->3)-beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1')-N-acylsphingosine(1-)\", \"GM3 ganglioside\", \"alpha-N-acetylneuraminosyl-(2->3)-beta-D-galactosyl-(1->4)-beta-D-glucosylceramide\", \"alpha-N-acetylneuraminyl-(2->3)-beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1')-ceramide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605590\", \"stIdVersion\": \"R-ALL-1605590.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10162938], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NEU2 cleaves GM3 to form LacCer (cytosol)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 428633, \"displayName\": \"Neu5Ac [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Neu5Ac\", \"N-acetylneuraminate\", \"SA\", \"N-acetylneuraminic acid\", \"sialic acid\"], \"producedByEvent\": [10162938], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428633\", \"stIdVersion\": \"R-ALL-428633.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1605647, \"displayName\": \"LacCer [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LacCer\", \"beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1)-N-acylsphingoid\", \"Lactosylceramide\", \"beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1)-N-acylsphingosine\", \"beta-D-Galactosyl-1,4-beta-D-glucosylceramide\"], \"producedByEvent\": [10162938], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605647\", \"stIdVersion\": \"R-ALL-1605647.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1605723\", \"stIdVersion\": \"R-RNO-1605723.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of compone