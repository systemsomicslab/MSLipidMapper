        "@value": "GSH [cytosol] + 17(R)-Hp-DHA [cytosol] => H2O [cytosol] + GSSG [cytosol] + 17(R)-HDHA [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10215723], \"className\": \"CatalystActivity\", \"dbId\": 10215683, \"displayName\": \"phospholipid-hydroperoxide glutathione peroxidase activity of GPX4-2 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10215723, \"displayName\": \"GPX4-2 reduces 17(R)-Hp-DHA to 17(R)-HDHA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10215713], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10215723], \"dbId\": 9024522, \"displayName\": \"17(R)-Hp-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17(R)-Hp-DHA\", \"(4Z,7Z,10Z,13Z,15E,17R,19Z)-17-hydroperoxydocosahexaenoate\", \"17(R)-hydroperoxy-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024522\", \"stIdVersion\": \"R-ALL-9024522.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10215723, 10215723], \"dbId\": 29450, \"displayName\": \"GSH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GSH\", \"glutathionate(1-)\", \"Reduced glutathione\", \"glutathione\", \"5-L-Glutamyl-L-cysteinylglycine\", \"N-(N-gamma-L-Glutamyl-L-cysteinyl)glycine\", \"gamma-L-Glutamyl-L-cysteinyl-glycine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29450\", \"stIdVersion\": \"R-ALL-29450.5\"}, 29450], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GPX4-2 reduces 17(R)-Hp-DHA to 17(R)-HDHA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9024463, \"displayName\": \"17(R)-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17(R)-HDHA\", \"17(R)-HDoHE(1-)\", \"17(R)-hydroxydocosahexaenoic acid\", \"17(R)-HDoHE\"], \"producedByEvent\": [10215723], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024463\", \"stIdVersion\": \"R-ALL-9024463.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111745, \"displayName\": \"GSSG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GSSG\", \"glutathione disulfide(2-)\", \"oxidized glutathione\", \"glutathione disulfide\"], \"producedByEvent\": [10215723], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111745\", \"stIdVersion\": \"R-ALL-111745.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10215723], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10215715, \"displayName\": \"Ac-PTGS2 dimer oxidises DHA to 17(R)-Hp-DHA\", \"followingEvent\": [10215723], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Ac-PTGS2 dimer oxidises DHA to 17(R)-Hp-DHA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9020261\", \"stIdVersion\": \"R-RNO-9020261.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9020271\", \"stIdVersion\": \"R-RNO-9020271.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
