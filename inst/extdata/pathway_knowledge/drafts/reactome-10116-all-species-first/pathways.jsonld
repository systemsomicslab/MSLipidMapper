    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "Btn-ACACB:2Mn2+ polymer [mitochondrial outer membrane] + ATP [cytosol] => H+ [cytosol] + Btn-p-S222-ACACB:2Mn2+ polymer [mitochondrial outer membrane] + ADP [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10130559], \"className\": \"CatalystActivity\", \"dbId\": 10130557, \"displayName\": \"AMP-activated protein kinase activity of AMPK heterotrimer (active) [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005741\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17906, \"definition\": \"The outer, i.e. cytoplasm-facing, lipid bilayer of the mitochondrial envelope.\", \"displayName\": \"mitochondrial outer membrane\", \"name\": \"mitochondrial outer membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005741\"}], \"dbId\": 10130559, \"displayName\": \"pAMPK inactivates ACACB, inhibiting malonyl-CoA synthesis\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0055089\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 260763, \"definition\": \"Any process involved in the maintenance of an internal steady state of fatty acid within an organism or cell.\", \"displayName\": \"fatty acid homeostasis\", \"name\": \"fatty acid homeostasis\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0055089\"}, \"input\": [{\"className\": \"Polymer\", \"consumedByEvent\": [10130559], \"dbId\": 10130547, \"displayName\": \"Btn-ACACB:2Mn2+ polymer [mitochondrial outer membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"Btn-ACACB:2Mn2+ polymer\"], \"schemaClass\": \"Polymer\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8867341\", \"stIdVersion\": \"R-RNO-8867341.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10130559], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"pAMPK inactivates ACACB, inhibiting malonyl-CoA synthesis\", \"ATP + L-seryl-(protein) => ADP + H(+) + O-phospho-L-seryl-(protein)\"], \"output\": [{\"className\": \"Polymer\", \"dbId\": 10130554, \"displayName\": \"Btn-p-S222-ACACB:2Mn2+ polymer [mitochondrial outer membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"Btn-p-S222-ACACB:2Mn2+ polymer\"], \"producedByEvent\": [10130559], \"schemaClass\": \"Polymer\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-8876893\", \"stIdVersion\": \"R-RNO-8876893.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [10130559], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [10130559], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10130538, \"displayName\": \"Activation of cytosolic AMPK by phosphorylation\", \"followingEvent\": [10130559], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Activation of cytosolic AMPK by phosphorylation\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-200421\", \"stIdVersion\": \"R-RNO-200421.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10139751, \"displayName\": \"Phosphorylated AMPK binds AMP\", \"followingEvent\": [10130559], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Phosphorylated AMPK binds AMP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-380930\", \"stIdVersion\": \"R-RNO-380930.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-200423\", \"stIdVersion\": \"R-RNO-200423.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
