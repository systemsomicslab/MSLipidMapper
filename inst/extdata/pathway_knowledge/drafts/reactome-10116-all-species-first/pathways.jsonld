    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10224448], \"className\": \"CatalystActivity\", \"dbId\": 10224446, \"displayName\": \"galactosylceramide sulfotransferase activity of GAL3ST1 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}], \"dbId\": 10224448, \"displayName\": \"GAL3ST1 transfers sulfate to GalCer,LacCer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10224448], \"dbId\": 741440, \"displayName\": \"PAPS [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PAPS\", \"3'-phosphonato-5'-adenylyl sulfate(4-)\", \"3'-phospho-5'-adenylyl sulfate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-741440\", \"stIdVersion\": \"R-ALL-741440.5\"}, {\"className\": \"Set\", \"consumedByEvent\": [10224448], \"dbId\": 9845491, \"displayName\": \"GalCer,LacCer [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GalCer,LacCer\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9845491\", \"stIdVersion\": \"R-ALL-9845491.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GAL3ST1 transfers sulfate to GalCer,LacCer\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 742343, \"displayName\": \"PAP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PAP\", \"adenosine 3',5'-bismonophosphate(4-)\", \"adenosine 3',5'-bisphosphate\", \"adenosine 3',5'-bismonophosphate\"], \"producedByEvent\": [10224448], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-742343\", \"stIdVersion\": \"R-ALL-742343.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10224448], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}, {\"className\": \"Set\", \"dbId\": 9845488, \"displayName\": \"SM3,SM4 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"SM3,SM4\"], \"producedByEvent\": [10224448], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9845488\", \"stIdVersion\": \"R-ALL-9845488.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10194844, \"displayName\": \"UGT8 transfers Gal from UDP-Gal to CERA\", \"followingEvent\": [10224448], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"UGT8 transfers Gal from UDP-Gal to CERA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-6785933\", \"stIdVersion\": \"R-RNO-6785933.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10224506, \"displayName\": \"B4GALT5/6 transfer Gal to GlcCer\", \"followingEvent\": [10224448], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"B4GALT5/6 transfer Gal to GlcCer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9851347\", \"stIdVersion\": \"R-RNO-9851347.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9844587\", \"stIdVersion\": \"R-RNO-9844587.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
