    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10144606], \"className\": \"CatalystActivity\", \"dbId\": 10144604, \"displayName\": \"sphingolipid delta-4 desaturase activity of DEGS1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10144606, \"displayName\": \"DEGS1 dehydrogenates dihydroceramide\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10144585], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10144606, 10144606], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, 70106, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10144606], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10144606], \"dbId\": 428126, \"displayName\": \"DHCE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHCE\", \"dihydroceramide\", \"N-acylsphingoid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428126\", \"stIdVersion\": \"R-ALL-428126.4\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10144606, 10144606], \"dbId\": 10144594, \"displayName\": \"CYB5B:Fe2+ [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"CYB5B:Fe2+\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9842697\", \"stIdVersion\": \"R-RNO-9842697.1\"}, 10144594], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DEGS1 dehydrogenates dihydroceramide\", \"dihydroceramide + 2Fe(2+) + 2H+ + O2 => (4E)-ceramide + 2Fe(3+) + 2H2O\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10144606, 10144606], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356, {\"className\": \"Chemical Compound\", \"dbId\": 9842380, \"displayName\": \"(4E)-CERA [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(4E)-CERA\", \"(4E)-unsatiated ceramide\"], \"producedByEvent\": [10144606], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9842380\", \"stIdVersion\": \"R-ALL-9842380.1\"}, {\"className\": \"Complex\", \"dbId\": 10144596, \"displayName\": \"CYB