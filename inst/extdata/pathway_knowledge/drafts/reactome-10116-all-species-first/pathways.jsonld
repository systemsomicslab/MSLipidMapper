    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10116337], \"className\": \"CatalystActivity\", \"dbId\": 10110913, \"displayName\": \"enoyl-CoA hydratase activity of ECHS1 hexamer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10116337, \"displayName\": \"Crotonoyl-CoA+H2O => (S)-3-Hydroxybutanoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10116335], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10116337], \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10116337], \"dbId\": 77313, \"displayName\": \"Crotonoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Crotonoyl-CoA\", \"crotonoyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77313\", \"stIdVersion\": \"R-ALL-77313.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Crotonoyl-CoA+H2O => (S)-3-Hydroxybutanoyl-CoA\", \"(2E)-butenoyl-CoA + H2O => (3S)-3-hydroxybutanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 77251, \"displayName\": \"3HB-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3HB-CoA\", \"(S)-3-hydroxybutanoyl-CoA(4-)\", \"(S)-3-hydroxybutanoyl-CoA\"], \"producedByEvent\": [10116337], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77251\", \"stIdVersion\": \"R-ALL-77251.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10116346, \"displayName\": \"Butanoyl-CoA+FAD => Crotonoyl-CoA+FADH2\", \"followingEvent\": [10116337], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Butanoyl-CoA+FAD => Crotonoyl-CoA+FADH2\", \"butanoyl-CoA + FAD + H(+) => (2E)-butenoyl-CoA + FADH2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-77319\", \"stIdVersion\": \"R-RNO-77319.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10111188, \"displayName\": \"glutaryl-CoA + FAD => crotonyl-CoA + FADH2 + CO2\", \"followingEvent\": [10116337], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"glutaryl-CoA + FAD => crotonyl-CoA + FADH2 + CO2\", \"FAD + glutaryl-CoA + 2 H(+) => (2E)-butenoyl-CoA + CO2 + FADH2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-71046\", \"stIdVersion\": \"R-RNO-71046.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \