14\", \"stIdVersion\": \"R-ALL-193514.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Formation of DHA-CoA catalysed by sterol carrier protein X (SCPx)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2066765, \"displayName\": \"DHA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHA-CoA\", \"(4Z,7Z,10Z,13Z,16Z,19Z)-docosahexaenoyl-CoA\", \"4Z,7Z,10Z,13Z,16Z,19Z-docosahexaenoyl-CoA\"], \"producedByEvent\": [10169174], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2066765\", \"stIdVersion\": \"R-ALL-2066765.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 192314, \"displayName\": \"propionyl CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"propionyl CoA\", \"propionyl-CoA(4-)\", \"propionyl-CoA\"], \"producedByEvent\": [10169174], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192314\", \"stIdVersion\": \"R-ALL-192314.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10169171, \"displayName\": \"Dehydrogenation of 3-hydroxy tetracosahexaenoyl-CoA\", \"followingEvent\": [10169174], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Dehydrogenation of 3-hydroxy tetracosahexaenoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-2066780\", \"stIdVersion\": \"R-RNO-2066780.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-2066781\", \"stIdVersion\": \"R-RNO-20