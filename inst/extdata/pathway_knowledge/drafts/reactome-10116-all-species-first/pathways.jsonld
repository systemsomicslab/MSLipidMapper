        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10115627], \"className\": \"CatalystActivity\", \"dbId\": 10115625, \"displayName\": \"glycerone-phosphate O-acyltransferase activity of GNPAT:AGPS complex [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10115627, \"displayName\": \"palmitoyl-CoA + DHAP => 1-palmitoylglycerone phosphate + CoASH\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10115627], \"dbId\": 390426, \"displayName\": \"PalmCoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PalmCoA\", \"palmitoyl-CoA(4-)\", \"palmitoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390426\", \"stIdVersion\": \"R-ALL-390426.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10115627], \"dbId\": 390404, \"displayName\": \"DHAP [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHAP\", \"glycerone phosphate(2-)\", \"glycerone phosphate\", \"dihydroxyacetone phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390404\", \"stIdVersion\": \"R-ALL-390404.5\"}], \"isInDisease\": false, \"isInferre