Id\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10128103], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10128103], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP8B1 12-hydroxylates 4CHOL7aOLONE\", \"7alpha-hydroxycholest-4-en-3-one + O2 + reduced (NADPH--hemoprotein reductase) => 7alpha,12alpha-dihydroxycholest-4-en-3-one + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\", \"4-Cholesten-7alpha-ol-3-one is 12alpha-hydroxylated to 7-alpha,12-alpha-dihydroxycholest-4-en-3-one\", \"7-alpha-hydroxycholest-4-en-3-one + NADPH + H+ + O2 => 7-alpha,12-alpha-dihydroxycholest-4-en-3-one + NADP+ + H2O\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192195, \"displayName\": \"4CHOL7a,12aDONE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4CHOL7a,12aDONE\", \"7alpha,12alpha-dihydroxycholest-4-en-3-one\", \"4-cholesten-7alpha, 12alpha-diol-3-one\"], \"producedByEvent\": [10128103], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192195\", \"stIdVersion\": \"R-ALL-192195.4\"}, {\"className\": 