    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10169176], \"className\": \"CatalystActivity\", \"dbId\": 10140966, \"displayName\": \"acyl-CoA oxidase activity of ACOX1 dimer [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10169176, \"displayName\": \"Oxidation of tetracosapentaenoyl-CoA to delta2-tetracosaheptaenoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10169167], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10169176], \"dbId\": 2046047, \"displayName\": \"THA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"THA-CoA\", \"(6Z,9Z,12Z,15Z,18Z,21Z)-tetracosahexaenoyl-CoA\", \"6Z,9Z,12Z,15Z,18Z,21Z-tetracosahexaenoyl-CoA (THA-CoA)\", \"6,9,12,15,18,21-24:6(n-3)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046047\", \"stIdVersion\": \"R-ALL-2046047.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10169176], \"dbId\": 113535, \"displayName\": \"O2 [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113535\", \"stIdVersion\": \"R-A