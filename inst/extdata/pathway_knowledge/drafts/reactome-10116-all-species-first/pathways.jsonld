        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10220515, \"displayName\": \"holo-FDPS dimer binds NBPs\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10220515], \"dbId\": 10127688, \"displayName\": \"holo-FDPS dimer [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"holo-FDPS dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-981570\", \"stIdVersion\": \"R-RNO-981570.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10220515], \"dbId\": 9717840, \"displayName\": \"NBPs [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"NBPs\", \"FDPS inhibitors\", \"biphosphonates\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9717840\", \"stIdVersion\": \"R-ALL-9717840.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"holo-FDPS dimer binds NBPs\", \"holo-FDPS dimer binds FDPS inhibitors\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10220513, \"displayName\": \"holo-FDPS dimer:NBPs [cytosol]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"holo-FDPS dimer:NBPs\"], \"producedByEvent\": [10220515], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-9717836\", \"stIdVersion\": \"R-RNO-9717836.1\"}], \"releaseDate\": \"2026