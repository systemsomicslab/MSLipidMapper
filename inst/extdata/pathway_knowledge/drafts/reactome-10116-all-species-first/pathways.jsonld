      {
        "@value": "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}, {\"accession\": \"0005765\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17938, \"definition\": \"The lipid bilayer surrounding the lysosome and separating its contents from the cell cytoplasm.\", \"displayName\": \"lysosomal membrane\", \"name\": \"lysosomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005765\"}], \"dbId\": 10223620, \"displayName\": \"PSAP is cleaved\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10223660], \"goBiologicalProcess\": {\"accession\": \"0016485\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 6678, \"definition\": \"Any protein maturation process achieved by the cleavage of a peptide bond or bonds within a protein. Protein maturation is the process leading to the attainment of the full functional capacity of a protein.\", \"displayName\": \"protein processing\", \"name\": \"protein processing\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0016485\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10223620], \"dbId\": 10223618, \"displayName\": \"Psap [lysosomal lumen]\", \"endCoordinate\": 524, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Psap\", \"PSAP\", \"P10960\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"Entity