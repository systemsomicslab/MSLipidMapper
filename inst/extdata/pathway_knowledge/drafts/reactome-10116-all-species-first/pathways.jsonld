        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10140951], \"className\": \"CatalystActivity\", \"dbId\": 10140949, \"displayName\": \"acetyl-CoA C-acyltransferase activity of ACAA1 [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10140951, \"displayName\": \"3-ketohexacosanoyl-CoA + CoASH => tetracosanoyl-CoA + acetyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10140951], \"dbId\": 390241, \"displayName\": \"3-ketohexacosanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3-ketohexacosanoyl-CoA\", \"3-oxohexacosanoyl-CoA(4-)\", \"3-oxohexacosanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390241\", \"stIdVersion\": \"R-ALL-390241.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10140951], \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-ketohexacosanoyl-CoA + CoASH => tetracosanoyl-CoA + acetyl-CoA\", \"3-oxohexacosanoyl-CoA + CoA => acetyl-CoA + tetracosanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 390246, \"displayName\": \"tetracosanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"tetracosanoyl-CoA\", \"tetracosanoyl-CoA(4-)\", \"lignoceryl-CoA\"], \"producedByEvent\": [10140951], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390246\", \"stIdVersion\": \"R-ALL-390246.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 353123, \"displayName\": \"Ac-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ac-CoA\", \"acetyl-CoA(4-)\", \"Acetyl coenzyme A\", \"acetyl-CoA\"], \"producedByEvent\": [10140951], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-353123\", \"stIdVersion\": \"R-ALL-353123.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10140953, \"displayName\": \"HSD17B4 dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"followingEvent\": [10140951], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B4 dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"3R)-hydroxyhexacosanoyl-CoA + NAD(+) => 3-oxohexacosanoyl-CoA + H(+) + NADH\", \"3-hydroxyhexacosanoyl-CoA + NAD+ => 3-ketohexacosanoyl-CoA + NADH + H+ (HSD17B4)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-390251\", \"stIdVersion\": \"R-RNO-390251.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10201655, \"displayName\": \"EHHADH dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"followingEvent\": [10140951], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"EHHADH dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"3-hydroxyhexacosanoyl-CoA + NAD+ => 3-ketohexacosanoyl-CoA + NADH + H+ (EHHADH)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-6809264\", \"stIdVersion\": \"R-RNO-6809264.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-390250\", \"stIdVersion\": \"R-RNO-390250.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
