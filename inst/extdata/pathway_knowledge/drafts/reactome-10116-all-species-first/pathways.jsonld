    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10142184], \"className\": \"CatalystActivity\", \"dbId\": 10142182, \"displayName\": \"nuclear receptor activity of PPARA:RXRA:Corepressors [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10142184, \"displayName\": \"Fatty acid ligands activate PPARA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10142187], \"goBiologicalProcess\": {\"accession\": \"0045944\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 17788, \"definition\": \"Any process that activates or increases the frequency, rate or extent of transcription from an RNA polymerase II promoter.\", \"displayName\": \"positive regulation of transcription by RNA polymerase II\", \"name\": \"positive regulation of transcription by RNA polymerase II\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0045944\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10142184], \"dbId\": 10142146, \"displayName\": \"PPARA:RXRA:Corepressors [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PPARA:RXRA:Corepressors\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-400196\", \"stIdVersion\": \"R-RNO-400196.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10142184], \"dbId\": 10142165, \"displayName\": \"Coactivators of PPARalpha [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Coactivators of PPARalpha\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-400216\", \"stIdVersion\": \"R-RNO-400216.1\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10142184], \"dbId\": 10142175, \"displayName\": \"FABP1:ligands of PPARA [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"FABP1:ligands of PPARA\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-2026984\", \"stIdVersion\": \"R-RNO-2026984.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Fatty acid ligands activate PPARA\"], \"output\": [{\"className\": \"Set\", \"dbId\": 10142142, \"displayName\": \"Corepressors of PPARalpha [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Corepressors of PPARalpha\"], \"producedByEvent\": [10142184], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-400207\", \"stIdVersion\": \"R-RNO-400207.1\"}, {\"className\": \"Complex\", \"dbId\": 10142181, \"displayName\": \"PPARA:RXRA Coactivator complex [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 5, \"name\": [\"PPARA:RXRA Coactivator complex\"], \"producedByEvent\": [10142184], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-400154\", \"stIdVersion\": \"R-RNO-400154.1\"}, {\"className\": \"Protein\", \"dbId\": 10142173, \"displayName\": \"FABP1 [nucleoplasm]\", \"endCoordinate\": 127, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FABP1\", \"P02692\"], \"producedByEvent\": [10142184], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1989743\", \"stIdVersion\": \"R-RNO-1989743.1\", \"startCoordinate\": 1}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10142187, \"displayName\": \"PPARA:RXRA binds Corepressors of PPARA\", \"followingEvent\": [10142184], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA:RXRA binds Corepressors of PPARA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-400183\", \"stIdVersion\": \"R-RNO-400183.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10168275, \"displayName\": \"FABP1 transports fatty acids into the nucleus\", \"followingEvent\": [10142184], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FABP1 transports fatty acids into the nucleus\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-2026996\", \"stIdVersion\": \"R-RNO-2026996.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-400143\", \"stIdVersion\": \"R-RNO-400143.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
