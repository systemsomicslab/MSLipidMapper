        "@value": "HXOL [peroxisomal matrix] + 1-Palmitoyl dihydroxyacetone phosphate [peroxisomal matrix] => GO3P [peroxisomal matrix] + PALM [peroxisomal matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10141009], \"className\": \"CatalystActivity\", \"dbId\": 10141007, \"displayName\": \"alkylglycerone-phosphate synthase activity of GNPAT:AGPS complex [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10141009, \"displayName\": \"1-palmitoylglycerone phosphate + hexadecanol => O-hexadecylglycerone phosphate + palmitate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10141009], \"dbId\": 390419, \"displayName\": \"1-Palmitoyl dihydroxyacetone phosphate [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-Palmitoyl dihydroxyacetone phosphate\", \"1-palmitoylglycerone 3-phosphate(2-)\", \"Palmitoylglycerone phosphate\", \"1-palmitoylglycerone 3-phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390419\", \"stIdVersion\": \"R-ALL-390419.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10141009], \"dbId\": 390440, \"displayName\": \"HXOL [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HXOL\", \"hexadecan-1-ol\", \"Hexadecanol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390440\", \"stIdVersion\": \"R-ALL-390440.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1-palmitoylglycerone phosphate + hexadecanol => O-hexadecylglycerone phosphate + palmitate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 390409, \"displayName\": \"GO3P [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GO3P\", \"1-alkylglycerone 3-phosphate(2-)\", \"O-hexadecylglycerone phosphate\", \"1-alkylglycerone 3-phosphate\", \"O-hexadecyldihydroxyacetone phosphate\", \"O-alkylglycerone phosphate\"], \"producedByEvent\": [10141009], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390409\", \"stIdVersion\": \"R-ALL-390409.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 390435, \"displayName\": \"PALM [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PALM\", \"hexadecanoate\", \"palmitate\"], \"producedByEvent\": [10141009], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390435\", \"stIdVersion\": \"R-ALL-390435.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10115627, \"displayName\": \"palmitoyl-CoA + DHAP => 1-palmitoylglycerone phosphate + CoASH\", \"followingEvent\": [10141009], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"palmitoyl-CoA + DHAP => 1-palmitoylglycerone phosphate + CoASH\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-75879\", \"stIdVersion\": \"R-RNO-75879.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10140329, \"displayName\": \"ABCD1-3 dimers transfer LCFAs from cytosol to peroxisomal matrix\", \"followingEvent\": [10141009], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ABCD1-3 dimers transfer LCFAs from cytosol to peroxisomal matrix\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-382575\", \"stIdVersion\": \"R-RNO-382575.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-390427\", \"stIdVersion\": \"R-RNO-390427.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
