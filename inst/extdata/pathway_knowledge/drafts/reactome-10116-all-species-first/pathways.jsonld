    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10163994], \"className\": \"CatalystActivity\", \"dbId\": 10163992, \"displayName\": \"1-phosphatidylinositol-4,5-bisphosphate 3-kinase activity of PIK3C(1) [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10163994, \"displayName\": \"PI(4,5)P2 is phosphorylated to PI(3,4,5)P3 by PIK3C[1] at the plasma membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10163994], \"dbId\": 179856, \"displayName\": \"PI(4,5)P2 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2\", \"1-phosphatidyl-1D-myo-inositol 4,5-bisphosphate(5-)\", \"PIP2\", \"1-phosphatidyl-1D-myo-inositol 4,5-bisphosphate\", \"Phosphatidylinositol-4,5-bisphosphate\", \"1-phosphatidyl-1D-myo-inositol 4,5- bisphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-179856\", \"stIdVersion\": \"R-ALL-179856.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10163994], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2 is phosphorylated to PI(3,4,5)P3 by PIK3C[1] at the plasma membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 179838, \"displayName\": \"PI(3,4,5)P3 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4,5)P3\", \"1-phosphatidyl-1D-myo-inositol 3,4,5-trisphosphate(7-)\", \"PIP3\", \"1-phosphatidyl-1D-myo-inositol 3,4,5-trisphosphate\", \"Phosphatidylinositol-3,4,5-trisphosphate\"], \"producedByEvent\": [10163994], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-179838\", \"stIdVersion\": \"R-ALL-179838.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [10163994], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10164000, \"displayName\": \"PI4P is phosphorylated to PI(4,5)P2 by PIP5K1A-C at the plasma membrane\", \"followingEvent\": [10163994], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI4P is phosphorylated to PI(4,5)P2 by PIP5K1A-C at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1676082\", \"stIdVersion\": \"R-RNO-1676082.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10130224, \"displayName\": \"PTEN dephosphorylates PIP3\", \"followingEvent\": [10163994], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTEN dephosphorylates PIP3\", \"PI(3,4,5)P3 is dephosphorylated to PI (4,5)P2 by PTEN at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-199456\", \"stIdVersion\": \"R-RNO-199456.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10163761, \"displayName\": \"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers at the plasma membrane\", \"followingEvent\": [10163994], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI5P is phosphorylated to PI(4,5)P2 by PIP4K2 dimers at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1675776\", \"stIdVersion\": \"R-RNO-1675776.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-1676048\", \"stIdVersion\": \"R-RNO-1676048.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
