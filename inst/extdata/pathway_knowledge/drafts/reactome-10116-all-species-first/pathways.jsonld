    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "myristoyl-CoA+FAD => trans-tetradec-2-enoyl-CoA+FADH2"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/curationStatus": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/Draft"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/directionality": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "MYS-CoA [mitochondrial matrix] + H+ [mitochondrial matrix] + FAD [mitochondrial matrix] => trans-Tetradec-2-enoyl-CoA [mitochondrial matrix] + FADH2 [mitochondrial matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10116310], \"className\": \"CatalystActivity\", \"dbId\": 10116287, \"displayName\": \"acyl-CoA dehydrogenase activity of ACADL tetramer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10116310, \"displayName\": \"myristoyl-CoA+FAD => trans-tetradec-2-enoyl-CoA+FADH2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10116313], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10116310], \"dbId\": 113596, \"displayName\": \"FAD [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FAD\", \"FAD(3-)\", \"Flavin adenine dinucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113596\", \"stIdVersion\": \"R-ALL-113596.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10116310], \"dbId\": 77272, \"displayName\": \"MYS-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MYS-CoA\", \"myristoyl-CoA(4-)\", \"myristoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77272\", \"stIdVersion\": \"R-ALL-77272.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10116310], \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"myristoyl-CoA+FAD => trans-tetradec-2-enoyl-CoA+FADH2\", \"tetradecanoyl-CoA + oxidized (electron-transfer flavoprotein) + H(+) => (2E)-tetradecenoyl-CoA + reduced (electron-transfer flavoprotein)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 31649, \"displayName\": \"FADH2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FADH2\", \"FADH2(2-)\"], \"producedByEvent\": [10116310], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-31649\", \"stIdVersion\": \"R-ALL-31649.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 77273, \"displayName\": \"trans-Tetradec-2-enoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"trans-Tetradec-2-enoyl-CoA\", \"trans-tetradec-2-enoyl-CoA(4-)\"], \"producedByEvent\": [10116310], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77273\", \"stIdVersion\": \"R-ALL-77273.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10116331, \"displayName\": \"3-Oxopalmitoyl-CoA+CoA-SH => myristoyl-CoA+acetyl-CoA\", \"followingEvent\": [10116310], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-Oxopalmitoyl-CoA+CoA-SH => myristoyl-CoA+acetyl-CoA\", \"3-oxohexadecanoyl-CoA + CoA => tetradecanoyl-CoA + acetyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-77304\", \"stIdVersion\": \"R-RNO-77304.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-77274\", \"stIdVersion\": \"R-RNO-77274.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.