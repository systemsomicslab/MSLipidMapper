    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10128729], \"className\": \"CatalystActivity\", \"dbId\": 10128727, \"displayName\": \"bile acid transmembrane transporter activity of SLCO1B1 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10128729, \"displayName\": \"SLCO1B1 transports ALB:(GCCA,TCCA) from extracellular region to cytosol\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10128729], \"dbId\": 194117, \"displayName\": \"GCCA, TCCA [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GCCA, TCCA\", \"cholate bile salts\", \"glycocholate; taurocholate\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-194117\", \"stIdVersion\": \"R-ALL-194117.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLCO1B1 transports ALB:(GCCA,TCCA) from extracellular region to cytosol\", \"Transport (influx) of glycocholate and taurocholate by OATP-C\"], \"output\": [{\"className\": \"Set\", \"dbId\": 194097, \"displayName\": \"GCCA, TCCA [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GCCA, TCCA\", \"cholate bile salts\", \"glycocholate; taurocholate\"], \"producedByEvent\": [10128729], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-194097\", \"stIdVersion\": \"R-ALL-194097.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10128756, \"displayName\": \"ABCC3 transports bile salts from cytosol to extracellular region\", \"followingEvent\": [10128729], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ABCC3 transports bile salts from cytosol to extracellular region\", \"Efflux of bile salts from enterocytes to portal system by MRP3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-194153\", \"stIdVersion\": \"R-RNO-194153.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-194083\", \"stIdVersion\": \"R-RNO-194083.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
