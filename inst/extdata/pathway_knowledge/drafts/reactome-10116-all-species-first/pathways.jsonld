    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "Coactivators of PPARalpha [nucleoplasm] + PPARA:RXRA:Corepressors [nucleoplasm] + FABP1:ligands of PPARA [nucleoplasm] => Corepressors of PPARalpha [nucleoplasm] + PPARA:RXRA Coactivator complex [nucleoplasm] + FABP1 [nucleoplasm]"
