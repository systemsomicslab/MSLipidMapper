    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10170430], \"className\": \"CatalystActivity\", \"dbId\": 10170428, \"displayName\": \"20-aldehyde-leukotriene B4 20-monooxygenase activity of Cytochrome P450 (CYP4F2/4F3 based) [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10170430, \"displayName\": \"20cho-LTB4 is oxidised to 20cooh-LTB4 by CYP4F2/4F3\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10170430], \"dbId\": 2142740, \"displayName\": \"20cho-LTB4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"20cho-LTB4\", \"20-oxoleukotriene B4(1-)\", \"20-oxoleukotriene B4\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142740\", \"stIdVersion\": \"R-ALL-2142740.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10170430], \"dbId\": 29364