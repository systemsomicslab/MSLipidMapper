        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10182292], \"className\": \"CatalystActivity\", \"dbId\": 10182290, \"displayName\": \"protein-membrane adaptor activity of CPNEs [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10182292, \"displayName\": \"CPNEs bind PL\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10182292], \"dbId\": 10182287, \"displayName\": \"CPNEs [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"CPNEs\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5333699\", \"stIdVersion\": \"R-RNO-5333699.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10182292], \"dbId\": 171142, \"displayName\": \"PL [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PL\", \"phospholipid\", \"phospholipids\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-171142\", \"stIdVersion\": \"R-ALL-171142.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CPNEs bind PL\", \"Copines bind phospholipid\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10182289, \"displayName\": \"CPNEs:PL [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"CPNEs:PL\"], \"producedByEvent\": [10182292], \"schemaClass\": \"Complex\", \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5333679\", \"stIdVersion\": \"R-RNO-5333679.1\"}], \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 2684957, \"displayName\": \"Positive regulation by 'Ca2+ [cytosol]'\", \"regulatedEntity\": [10182292], \"schemaClass\": \"PositiveRegulation\", \"stId\": \"R-HSA-2684957\", \"stIdVersion\": \"R-HSA-2684957.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"RNO\", \"className\": \"Species\", \"dbId\": 48895, \"displayName\": \"Rattus norvegicus\", \"name\": [\"Rattus norvegicus\", \"R. norvegicus\", \"Rn\", \"brown rat\", \"Norway rat\"], \"schemaClass\": \"Species\", \"taxId\": \"10116\"}], \"speciesName\": \"Rattus norvegicus\", \"stId\": \"R-RNO-5333678\", \"stIdVersion\": \"R-RNO-5333678.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
