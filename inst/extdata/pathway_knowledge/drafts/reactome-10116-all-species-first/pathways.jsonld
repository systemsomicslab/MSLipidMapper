    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "(24R, 25R) 3alpha,7alpha,12alpha,24-tetrahydroxy-5beta-cholestanoyl-CoA is oxidized to 3alpha,7alpha,12alpha-trihydroxy-5beta-cholest-24-one-CoA"
      }
    ],
