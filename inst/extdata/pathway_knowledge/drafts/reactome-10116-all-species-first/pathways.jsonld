    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "(S)-3-Hydroxyhexadecanoyl-CoA [mitochondrial matrix] + NAD+ [mitochondrial matrix] => H+ [mitochondrial matrix] + NADH [mitochondrial matrix] + 3-Oxopalmitoyl-CoA [mitochondrial matrix]"
      }
