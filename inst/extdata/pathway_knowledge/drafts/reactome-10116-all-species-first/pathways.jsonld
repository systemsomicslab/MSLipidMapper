        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10168911], \"className\": \"CatalystActivity\", \"dbId\": 10149346, \"displayName\": \"fatty acid elongase activity of ELOVL1,2,3,5 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10168911, \"displayName\": \"Elongation of gamma-lenolenoyl-CoA to dihomo-gamma-lenolenoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10168907], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10168911], \"dbId\": 2046042, \"displayName\": \"GLA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GLA-CoA\", \"gamma-linolenoyl-CoA\", \"gamma-linolenoyl-CoA (GLA-COA)\", \"octadecatrienoyl-CoA\", \"6Z,9Z,12Z-octadecatrienoyl-CoA\", \"18:3(n-6)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046042\", \"stIdVersion\": \"R-ALL-2046042.4\"}, {\"className\": \"