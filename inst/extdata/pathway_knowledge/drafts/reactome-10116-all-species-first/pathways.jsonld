    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H2O [mitochondrial matrix] + MLCL [mitochondrial inner membrane] => DLCL [mitochondrial inner membrane] + LCFA(-) [mitochondrial inner membrane]"
      }
    ],
