        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10115523], \"className\": \"CatalystActivity\", \"dbId\": 10115517, \"displayName\": \"ATP citrate synthase activity of ACLY tetramer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10115523, \"displayName\": \"ACLY tetramer transforms CIT to Ac-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10115566], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10115523], \"dbId\": 76190, \"displayName\": \"CIT [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CIT\", \"citrate(3-)\", \"Citrate\", \"citric acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76190\", \"stIdVersion\": \"R-ALL-76190.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10115523], \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10115523], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\