        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11038299], \"className\": \"CatalystActivity\", \"dbId\": 11038297, \"displayName\": \"aldehyde dehydrogenase [NAD(P)+] activity of ALDH3B1 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11038299, \"displayName\": \"ALDH3B1 oxidises HXAL to PALM\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11038299], \"dbId\": 428663, \"displayName\": \"HXAL [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HXAL\", \"hexadecanal\", \"palmitaldehyde\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428663\", \"stIdVersion\": \"R-ALL-428663.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11038299], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDiseas