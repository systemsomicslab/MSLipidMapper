        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11032086], \"className\": \"CatalystActivity\", \"dbId\": 11032084, \"displayName\": \"protein-membrane adaptor activity of CPNEs [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 11032086, \"displayName\": \"CPNEs bind PL\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [11032086], \"dbId\": 11032081, \"displayName\": \"CPNEs [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"CPNEs\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-5333699\", \"stIdVersion\": \"R-DDI-5333699.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11032086], \"dbId\": 171142, \"displayName\": \"PL [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PL\", \"phospholipid\", \"phospholipids\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-171142\", \"stIdVersion\": \"R-ALL-171142.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CPNEs bind PL\", \"Copines bind phospholipid\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 11032083, \"displayName\": \"CPNEs:PL [plasma membran