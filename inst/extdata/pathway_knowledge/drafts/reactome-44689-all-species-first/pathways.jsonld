      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11025711], \"className\": \"CatalystActivity\", \"dbId\": 11025707, \"displayName\": \"1-phosphatidylinositol-3-kinase activity of PIK3C2A/3 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11025711, \"displayName\": \"PI is phosphorylated to PI3P by PIK3C2A/3 at the Golgi membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11025804], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11025711], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11025711], \"dbId\": 1524146, \"displayName\": \"PI [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI\", \"1-phosphatidyl-1D-myo-inositol(1-)\", \"Phosphatidyl 1D-myo-inositol\", \"1-phosphatidyl-1D-myo-inositol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524146\", \"stIdVersion\": \"R-ALL-1524146.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI is phosphorylated to PI3P by PIK3C2A/3 at the Golgi membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [11025711], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1806159, \"displayName\": \"PI3P [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI3P\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate(3-)\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate\"], \"producedByEvent\": [11025711], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806159\", \"stIdVersion\": \"R-ALL-1806159.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11024605, \"displayName\": \"PI is exchanged with PC by PITPNB\", \"followingEvent\": [11025711], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI is exchanged with PC by PITPNB\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1483087\", \"stIdVersion\": \"R-DDI-1483087.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11025812, \"displayName\": \"PI4P is dephosphorylated to PI by SACM1L at the Golgi membrane\", \"followingEvent\": [11025711], \"isInDisease\": false, \"isInferred\": true, \"