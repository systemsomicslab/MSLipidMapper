        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11021004], \"className\": \"CatalystActivity\", \"dbId\": 11021000, \"displayName\": \"fatty acid elongase activity of ELOVL3,6,7 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 11021004, \"displayName\": \"ELOVL7 elongates ICS-CoA and Mal-CoA to 3ODC-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11021004], \"dbId\": 548794, \"displayName\": \"ICS-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ICS-CoA\", \"icosanoyl-CoA(4-)\", \"arachidoyl-CoA\", \"icosanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-548794\", \"stIdVersion\": \"R-ALL-548794.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11021004], \"dbId\": 29508, \"displayName\": \"Mal-CoA [cytosol]\", \"inDisease\