    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11037665], \"className\": \"CatalystActivity\", \"dbId\": 11037663, \"displayName\": \"aldehyde dehydrogenase (NAD+) activity of ALDH3A2-1 dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 11037665, \"displayName\": \"ALDH3A2-1 oxidises HD2NAL to PALM\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11037665], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11037665], \"dbId\": 428671, \"displayName\": \"HD2NAL [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HD2NAL\", \"trans-hexadec-2-enal\", \"hexadec-2-enal\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428671\", \"stIdVersion\": \"R-ALL-428671.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11037665], \"dbId\": 29360, \"displayName\": \"NAD+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29360\", \"stIdVersion\": \"R-ALL-29360.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALDH3A2-1 oxidises HD2NAL to PALM\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [11037665], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 73473, \"displayName\": \"NADH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [11037665], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-73473\", \"stIdVersion\": \"R-ALL-73473.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 3632881, \"displayName\": \"PALM [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PALM\", \"hexadecanoate\", \"palmitate\"], \"producedByEvent\": [11037665], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-3632881\", \"stIdVersion\": \"R-ALL-3632881.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11018932, \"displayName\": \"PXLP-SGPL1 cleaves sphingoid-1-phosphates\", \"followingEvent\": [11037665], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PXLP-SGPL1 cleaves sphingoid-1-phosphates\", \"sphinganine 1-phosphate => phosphoethanolamine + hexadecanal\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-428681\", \"stIdVersion\": \"R-DDI-428681.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DDI\", \"className\": \"Species\", \"dbId\": 170941, \"displayName\": \"Dictyostelium discoideum\", \"name\": [\"Dictyostelium discoideum\"], \"schemaClass\": \"Species\", \"taxId\": \"44689\"}], \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-5692261\", \"stIdVersion\": \"R-DDI-5692261.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
