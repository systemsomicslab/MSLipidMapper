      {
        "@value": "PI(4,5)P2, PI(3,4)P2, PI(3,4,5)P3 [early endosome membrane] + H2O [cytosol] => Pi [cytosol] + PI5P, PI3P, PI(3,5)P2 [early endosome membrane]"
      }
    ],
