"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [11037428, 11037428], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11021019, \"displayName\": \"TECR,TECRL dehydrogenate TOD-CoA to ST-CoA\", \"followingEvent\": [11037428], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TECR,TECRL dehydrogenate TOD-CoA to ST-CoA\", \"(2E)-octadecenoyl-CoA + H(+) + NADPH => NADP(+) + octadecanoyl-CoA\", \"trans-octadec-2-enoyl-CoA + NADPH + H+ => stearoyl-CoA + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-548831\", \"stIdVersion\": \"R-DDI-548831.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DDI\", \"className\": \"Species\", \"dbId\": 170941, \"displayName\": \"Dictyostelium discoideum\", \"name\": [\"Dictyostelium discoideum\"], \"schemaClass\": \"Species\", \"taxId\": \"44689\"}], \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-5690565\", \"stIdVersion\": \"R-DDI-5690565.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
