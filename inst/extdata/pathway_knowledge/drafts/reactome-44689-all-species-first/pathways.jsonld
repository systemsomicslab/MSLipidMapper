        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11051158], \"className\": \"CatalystActivity\", \"dbId\": 11051053, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen of ALOX5 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11051158, \"displayName\": \"ALOX5 oxidises 14(S)-Hp-DPAn-3 to MaR3n-3 DPA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11051158], \"dbId\": 9026293, \"displayName\": \"14(S)-Hp-DPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"14(S)-Hp-DPAn-3\", \"(7Z,10Z,12E,14S,16Z,19Z)-14-hydroperoxydocosapentaenoate\", \"14(S)-HpDPA(n-3)(1-)\", \"(7Z,10Z,12E,14S,16Z,19Z)-14-hydroperoxydocosapentaenoic acid\", \"14(S)-hydroperoxy-omega3-docosapentaenoic acid\", \"14(S)-hydroperoxy-docosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9026293\", \"stIdVersion\": \"R-ALL-9026293.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11051158], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntit