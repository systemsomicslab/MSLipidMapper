    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11024567], \"className\": \"CatalystActivity\", \"dbId\": 11024565, \"displayName\": \"diacylglycerol cholinephosphotransferase activity of CHPT1:Mg2+/Mn2+ [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11024567, \"displayName\": \"CDP-Cho and DAG are converted to PC by CHPT1 at the Golgi membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11024605], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11024567], \"dbId\": 1524060, \"displayName\": \"CDP-Cho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CDP-Cho\", \"CDP-choline\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524060\", \"stIdVersion\": \"R-ALL-1524060.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11024567], \"dbId\": 1524057, \"displayName\": \"DAG [Golgi membrane]\", 