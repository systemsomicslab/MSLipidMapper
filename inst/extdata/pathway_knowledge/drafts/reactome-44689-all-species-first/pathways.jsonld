    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "ATP [cytosol] + Btn-ACACB:2Mn2+ polymer [mitochondrial outer membrane] => ADP [cytosol] + H+ [cytosol] + Btn-p-S222-ACACB:2Mn2+ polymer [mitochondrial outer membrane]"
