    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11024707], \"className\": \"CatalystActivity\", \"dbId\": 11024705, \"displayName\": \"phosphatidylcholine transfer activity of PC:PITPNB [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 11024707, \"displayName\": \"PC is exchanged with PI by PITPNB\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11024729], \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [11024707], \"dbId\": 11024699, \"displayName\": \"PC:PITPNB [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PC:PITPNB\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1524110\", \"stIdVersion\": \"R-DDI-1524110.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11024707], \"dbId\": 426639, \"displayName\": \"PI [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI\", \"1-phosphatidyl-1D-myo-inositol(1-)\", \"Phosphatidyl 1D-myo-inositol\", \"1-phosphatidyl-1D-myo-inositol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426639\", \"stIdVersion\": \"R-ALL-426639.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PC is exchanged with PI by PITPNB\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 11024704, \"displayName\": \"PI:PITPNB [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PI:PITPNB\"], \"producedByEvent\": [11024707], \"schemaClass\": \"Complex\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1524117\", \"stIdVersion\": \"R-DDI-1524117.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 426925, \"displayName\": \"PC [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PC\", \"1,2-diacyl-sn-glycero-3-phosphocholine\", \"Phosphatidyl choline\"], \"producedByEvent\": [11024707], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426925\", \"stIdVersion\": \"R-ALL-426925.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11024702, \"displayName\": \"PC:PITPNB is transported from the Golgi membrane to the ER membrane\", \"followingEvent\": [11024707], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PC:PITPNB is transported from the Golgi membrane to the ER membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1483211\", \"stIdVersion\": \"R-DDI-1483211.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11024577, \"displayName\": \"CDP-DAG is converted to PI by CDIPT\", \"followingEvent\": [11024707], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CDP-DAG is converted to PI by CDIPT\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1482976\", \"stIdVersion\": \"R-DDI-1482976.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11024330, \"displayName\": \"1-acyl LPI is acylated to PI by MBOAT7\", \"followingEvent\": [11024707], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1-acyl LPI is acylated to PI by MBOAT7\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1482598\", \"stIdVersion\": \"R-DDI-1482598.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11024390, \"displayName\": \"2-acyl LPI is acylated to PI by MBOAT7\", \"followingEvent\": [11024707], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-acyl LPI is acylated to PI by MBOAT7\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1482626\", \"stIdVersion\": \"R-DDI-1482626.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11025809, \"displayName\": \"PI4P is dephosphorylated to PI by SACM1L at the ER membrane\", \"followingEvent\": [11024707], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI4P is dephosphorylated to PI by SACM1L at the ER membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1676124\", \"stIdVersion\": \"R-DDI-1676124.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DDI\", \"className\": \"Species\", \"dbId\": 170941, \"displayName\": \"Dictyostelium discoideum\", \"name\": [\"Dictyostelium discoideum\"], \"schemaClass\": \"Species\", \"taxId\": \"44689\"}], \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1483219\", \"stIdVersion\": \"R-DDI-1483219.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
