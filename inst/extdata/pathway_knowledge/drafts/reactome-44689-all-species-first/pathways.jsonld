        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11037428], \"className\": \"CatalystActivity\", \"dbId\": 11037426, \"displayName\": \"stearoyl-CoA 9-desaturase activity of SCD dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11037428, \"displayName\": \"SCD desaturates ST-CoA to OLE-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11037428], \"dbId\": 428139, \"displayName\": \"ST-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ST-CoA\", \"stearoyl-CoA(4-)\", \"stearyl-CoA\", \"stearoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428139\", \"stIdVersion\": \"R-ALL-428139.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11037428, 11037428], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"