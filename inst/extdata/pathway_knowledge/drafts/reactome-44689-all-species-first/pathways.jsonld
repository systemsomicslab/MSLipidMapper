        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11027056], \"className\": \"CatalystActivity\", \"dbId\": 11027054, \"displayName\": \"monooxygenase activity of CYP(4) [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11027056, \"displayName\": \"Arachidonate is epoxidated to 5,6-EET by CYP(4)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11027056], \"dbId\": 29768, \"displayName\": \"AA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AA\", \"arachidonate\", \"Arachidonate\", \"arachidonic acid\", \"cis-5,8,11,14-Eicosatetraenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29768\", \"stIdVersion\": \"R-ALL-29768.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11027056], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11027056], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11027056], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Arachidonate is epoxidated to 5,6-EET by CYP(4)\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate + O2 + reduced (NADPH--hemoprotein reductase) => 5,6-epoxy-(8Z,11Z,14Z)-eicosatrienoate + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142739, \"displayName\": \"5,6-EET [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5,6-EET\", \"5,6-EET(1-)\"], \"producedByEvent\": [11027056], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142739\", \"stIdVersion\": \"R-ALL-2142739.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [11027056], \"referenceType\": \"