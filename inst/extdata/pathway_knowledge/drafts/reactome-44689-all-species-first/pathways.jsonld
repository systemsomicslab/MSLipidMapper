      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11016102], \"className\": \"CatalystActivity\", \"dbId\": 11016100, \"displayName\": \"leukotriene-C4 synthase activity of ALOX5:ALOX5AP:LTC4S [nuclear envelope]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005635\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13231, \"definition\": \"The double lipid bilayer that encloses the nucleus, separating its contents from the cytoplasm. It consists of an inner and outer nuclear membrane, with an intermembrane space (20-40 nm wide, also called the perinuclear space) between them. The envelope is supported by the nuclear lamina and contains nuclear pore complexes, which regulate molecular transport.\", \"displayName\": \"nuclear envelope\", \"name\": \"nuclear envelope\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005635\"}], \"dbId\": 11016102, \"displayName\": \"LTA4 is converted to LTC4 by LTC4S\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11016109], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11016102], \"dbId\": 265281, \"displayName\": \"LTA4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LTA4\", \"leukotriene A4(1-)\", \"leukotriene A4\"], \"referenceTyp