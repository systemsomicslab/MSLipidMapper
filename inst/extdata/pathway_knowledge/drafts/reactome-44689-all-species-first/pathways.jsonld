"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2, PI(3,4)P2 and PI(3,4,5)P3 are dephosphorylated to PI5P, PI3P and PI(3,4)P by INPP5F at the endosome membrane\"], \"output\": [{\"className\": \"Set\", \"dbId\": 8849958, \"displayName\": \"PI5P, PI3P, PI(3,5)P2 [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PI5P, PI3P, PI(3,5)P2\"], \"producedByEvent\": [11045202], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-8849958\", \"stIdVersion\": \"R-ALL-8849958.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [11045202], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11025785, \"displayName\": \"PI4P is phosphorylated to PI(4,5)P2 by PIP5K1A-C at the plasma membrane\", \"followingEvent\": [11045202], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI4P is phosphorylated to PI(4,5)P2 by PIP5K1A-C at the plasma membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1676082\", \"stIdVersion\": \"R-DDI-1676082.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11014166, \"displayName\": \"PTEN dephosphorylates PIP3\", \"followingEvent\": [11045202], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTEN dephosphorylates PIP3\", \"PI(3,4,5)P3 is