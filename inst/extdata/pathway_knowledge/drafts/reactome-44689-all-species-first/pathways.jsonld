        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11047886], \"className\": \"CatalystActivity\", \"dbId\": 11047884, \"displayName\": \"ether hydrolase activity of TMEM86B [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11047886, \"displayName\": \"THEM86B hydrolyses PMCHO, PMETAM\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [11047886], \"dbId\": 8874447, \"displayName\": \"PMCHO, PMETAM [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PMCHO, PMETAM\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-8874447\", \"stIdVersion\": \"R-ALL-8874447.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11047886], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"THEM86B hydrolyses PMCHO, PMETAM\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 5696116, \"displayName\": \"fatty aldehyde [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"fatty aldehyde\"], \"producedByEvent\": [11047886], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5696116\", \"stIdVersion\": \"R-ALL-5696116.2\"}, {\"className\": \"Set\", \"dbId\": 8874450, \"displayName\": \"GPCHO, GPETAM [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GPCHO, GPETAM\"], \"producedByEvent\": [11047886], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-8874450\", \"stIdVersion\": \"R-ALL-8874450.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DDI\", \"className\": \"Species\", \"dbId\": 170941, \"displayName\": \"Dictyostelium discoideum\", \"name\": [\"Dictyostelium discoideum\"], \"schemaClass\": \"Species\", \"taxId\": \"44689\"}], \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-8874435\", \"stIdVersion\": \"R-DDI-8874435.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
