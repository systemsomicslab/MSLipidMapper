        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11013531], \"className\": \"CatalystActivity\", \"dbId\": 11013525, \"displayName\": \"oxidoreductase activity, acting on the CH-OH group of donors, NAD or NADP as acceptor of HSD17B4 dimer [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 11013531, \"displayName\": \"(24R, 25R) 3alpha,7alpha,24-trihydroxy-5beta-cholestanoyl-CoA is oxidized to 3alpha,7alpha-dihydroxy-5beta-cholest-24-one-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11013531], \"dbId\": 193732, \"displayName\": \"3,7,24THCA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3,7,24THCA-CoA\", \"3alpha,7alpha,24-trihydroxy-5beta-cholestan-26-oyl-CoA\", \"25(R) 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193732\", \"stIdVersion\": \"R-ALL-193732.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11013531], \"dbId\": 192307, \"displayName\": \"NAD+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\",