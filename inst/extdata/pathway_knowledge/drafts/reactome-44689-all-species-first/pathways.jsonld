    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11017458], \"className\": \"CatalystActivity\", \"dbId\": 11017456, \"displayName\": \"aldehyde dehydrogenase (NAD+) activity of ALDH3A2-2 dimer [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 11017458, \"displayName\": \"ALDH3A2-2 oxidizes pristanal to pristanate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11017458], \"dbId\": 192307, \"displayName\": \"NAD+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192307\", \"stIdVersion\": \"R-ALL-192307.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11017458], \"dbId\": 389636, \"displayName\": \"Pristanal [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pristanal\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389636\", \"stIdVersion\": \"R-ALL-389636.2\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11017458], \"dbId\": 141343, \"displayName\": \"H2O [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-141343\", \"stIdVersion\": \"R-ALL-141343.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALDH3A2-2 oxidizes pristanal to pristanate\", \"pristanal + NAD+ => pristanate + NADH + H+\", \"2,6,10,14-tetramethylpentadecanal + H2O + NAD(+) => 2,6,10,14-tetramethylpentadecanoate + 2 H(+) + NADH\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 6811612, \"displayName\": \"pristanate [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"pristanate\"], \"producedByEvent\": [11017458], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6811612\", \"stIdVersion\": \"R-ALL-6811612.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 192305, \"displayName\": \"NADH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [11017458], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192305\", \"stIdVersion\": \"R-ALL-192305.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [11017458, 11017458], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}, 193465], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11017470, \"displayName\": \"2-hydroxyphytanoyl-CoA => pristanal + formyl-CoA\", \"followingEvent\": [11017458], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-hydroxyphytanoyl-CoA => pristanal + formyl-CoA\", \"2-hydroxyphytanoyl-CoA => 2,6,10,14-tetramethylpentadecanal + formyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-389611\", \"stIdVersion\": \"R-DDI-389611.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DDI\", \"className\": \"Species\", \"dbId\": 170941, \"displayName\": \"Dictyostelium discoideum\", \"name\": [\"Dictyostelium discoideum\"], \"schemaClass\": \"Species\", \"taxId\": \"44689\"}], \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-389609\", \"stIdVersion\": \"R-DDI-389609.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
