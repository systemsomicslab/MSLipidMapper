    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 11053687, \"displayName\": \"HMGCR dimer binds statins\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [11053687], \"dbId\": 11013240, \"displayName\": \"HMGCR dimer [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"HMGCR dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-191277\", \"stIdVersion\": \"R-DDI-191277.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [11053687], \"dbId\": 9705575, \"displayName\": \"statins [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"statins\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9705575\", \"stIdVersion\": \"R-ALL-9705575.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCR dimer binds statins\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 11053685, \"displayName\": \"HMGCR dimer:statins [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"HMGCR dimer:statins\"], \"producedByEvent\": [11053687], \"schemaClass\": \"Complex\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-9705595\", \"stIdVersion\": \"R-DDI-9705595.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DDI\", \"className\": \"Species\", \"dbId\": 170941, \"displayName\": \"Dictyostelium discoideum\", \"name\": [\"Dictyostelium discoideum\"], \"schemaClass\": \"Species\", \"taxId\": \"44689\"}], \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-9705584\", \"stIdVersion\": \"R-DDI-9705584.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
