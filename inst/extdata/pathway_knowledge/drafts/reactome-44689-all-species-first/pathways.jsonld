        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11051069], \"className\": \"CatalystActivity\", \"dbId\": 11051067, \"displayName\": \"arachidonate 15-lipoxygenase activity of ALOX15 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11051069, \"displayName\": \"ALOX15 oxidises 18(R)-HEPE to 18(R)-RvE3\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11051069], \"dbId\": 9023651, \"displayName\": \"18(R)-HEPE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"18(R)-HEPE\", \"18(R)-HEPE(1-)\", \"18(R)-hydroxyeicosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9023651\", \"stIdVersion\": \"R-ALL-9023651.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11051069], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX15 oxidises 18(R)-HEPE to 18(R)-RvE3\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9023644, \"displayName\": \"(18R)-resolvin E3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(18R)-resolvin E3\", \"(18R)-resolvin E3(1-)\", \"18(R)-RvE3\", \"18(R) resolvin-E3\"], \"producedByEvent\": [11051069], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9023644\", \"stIdVersion\": \"R-ALL-9023644.4\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DDI\", \"className\": \"Species\", \"dbId\": 170941, \"displayName\": \"Dictyostelium discoideum\", \"name\": [\"Dictyostelium discoideum\"], \"schemaClass\": \"Species\", \"taxId\": \"44689\"}], \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-9018907\", \"stIdVersion\": \"R-DDI-9018907.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a