      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11018886], \"className\": \"CatalystActivity\", \"dbId\": 11018884, \"displayName\": \"sphingolipid C4-monooxygenase activity of DEGS2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 11018886, \"displayName\": \"DEGS2 oxygenates dihydroceramide\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11018896], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11018886], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11018886], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\"