    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "DPA-CoA [endoplasmic reticulum lumen] + NADPH [endoplasmic reticulum lumen] + Malonyl-CoA [endoplasmic reticulum lumen] => NADP+ [endoplasmic reticulum lumen] + CoA-SH [endoplasmic reticulum lumen] + TPA-CoA [endoplasmic reticulum lumen] + CO2 [endoplasmic reticulum lumen] + H2O [endoplasmic reticulum lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11026771], \"className\": \"CatalystActivity\", \"dbId\": 11026769, \"displayName\": \"fatty acid elongase activity of ELOVL2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 11026771, \"displayName\": \"Elongation of docosapentaenoyl-CoA to tetracosapentaenoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11026771], \"dbId\": 2046057, \"displayName\": \"DPA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DPA-CoA\", \"(7Z,10Z,13Z,16Z,19Z)-docosapentaenoyl-CoA\", \"7Z,10Z,13Z,16Z,19Z-docosapentaenoyl-CoA (DPA-CoA)\", \"docosapentaenoyl-CoA\", \"7,10,13,16,19-22:5(n-3)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046057\", \"stIdVersion\": \"R-ALL-2046057.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11026771], \"dbId\": 2046066, \"displayName\": \"Malonyl-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Malonyl-CoA\", \"malonyl-CoA(5-)\", \"Malonyl coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046066\", \"stIdVersion\": \"R-ALL-2046066.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11026771, 11026771], \"dbId\": 113601, \"displayName\": \"NADPH [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113601\", \"stIdVersion\": \"R-ALL-113601.2\"}, 113601], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Elongation of docosapentaenoyl-CoA to tetracosapentaenoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2046065, \"displayName\": \"TPA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TPA-CoA\", \"(9Z,12Z,15Z,18Z,21Z)-tetracosapentaenoyl-CoA\", \"9Z,12Z,15Z,18Z,21Z-tetracosapentaenoyl-CoA (TPA-CoA)\", \"9,12,15,18,21-tetracosapentaenoyl-CoA\", \"9,12,15,18,21-24:5(n-3)\"], \"producedByEvent\": [11026771], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046065\", \"stIdVersion\": \"R-ALL-2046065.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 159751, \"displayName\": \"CO2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CO2\", \"carbon dioxide\"], \"producedByEvent\": [11026771], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-159751\", \"stIdVersion\": \"R-ALL-159751.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 162743, \"displayName\": \"CoA-SH [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [11026771], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-162743\", \"stIdVersion\": \"R-ALL-162743.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113519, \"displayName\": \"H2O [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [11026771], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113519\", \"stIdVersion\": \"R-ALL-113519.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113564, \"displayName\": \"NADP+ [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(+)\", \"NADP\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [11026771, 11026771], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113564\", \"stIdVersion\": \"R-ALL-113564.4\"}, 113564], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11026781, \"displayName\": \"Elongation of eicosapentaenoyl-CoA to docosapentaenoyl-CoA\", \"followingEvent\": [11026771], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Elongation of eicosapentaenoyl-CoA to docosapentaenoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-2046100\", \"stIdVersion\": \"R-DDI-2046100.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DDI\", \"className\": \"Species\", \"dbId\": 170941, \"displayName\": \"Dictyostelium discoideum\", \"name\": [\"Dictyostelium discoideum\"], \"schemaClass\": \"Species\", \"taxId\": \"44689\"}], \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-2046090\", \"stIdVersion\": \"R-DDI-2046090.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
