      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11024684], \"className\": \"CatalystActivity\", \"dbId\": 11024682, \"displayName\": \"ethanolamine-phosphate cytidylyltransferase activity of PCYT2 dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11024684, \"displayName\": \"PETA and CTP are condensed to CDP-ETA by PCY2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11024560], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11024684], \"dbId\": 428686, \"displayName\": \"PETA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PETA\", \"O-phosphoethanolamine\", \"phosphoethanolamine\", \"ethanolamine phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428686\", \"stIdVersion\": \"R-ALL-428686.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11024684], \"d