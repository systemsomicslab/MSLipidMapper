        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11025830], \"className\": \"CatalystActivity\", \"dbId\": 11025828, \"displayName\": \"1-phosphatidylinositol 4-kinase activator activity of ARF1/3:GTP [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11025830, \"displayName\": \"PI4KB binds to ARF1/3:GTP at the Golgi membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11025663], \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [11025830], \"dbId\": 11025658, \"displayName\": \"ARF1/3:GTP [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"ARF1/3:GTP\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1806258\", \"stIdVersion\": \"R-DDI-1806258.1\"}, {\"className\": \"Protein\", \"consumedByEvent\": [11025830], \"dbId\": 11025827, \"displayName\": \"pikD [cytosol]\", \"endCoordinate\": 816, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"pikD\", \"PI4KB\", \"P54677\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1604615\", \"stIdVersion\": \"R-DDI-1604615.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI4KB binds to ARF1/3:GTP at the Golgi membrane\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 11025660, \"displayName\": \"ARF1/3:GTP:PI4KB [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 5, \"name\": [\"ARF1/3:GTP:PI4KB\"], \"producedByEvent\": [11025830], \"schemaClass\": \"Complex\", \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1806287\", \"stIdVersion\": \"R-DDI-1806287.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DDI\", \"className\": \"Species\", \"dbId\": 170941, \"displayName\": \"Dictyostelium discoideum\", \"name\": [\"Dictyostelium discoideum\"], \"schemaClass\": \"Species\", \"taxId\": \"44689\"}], \"speciesName\": \"Dictyostelium discoideum\", \"stId\": \"R-DDI-1676152\", \"stIdVersion\": \"R-DDI-1676152.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
