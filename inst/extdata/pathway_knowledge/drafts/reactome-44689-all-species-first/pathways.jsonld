        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11051183], \"className\": \"CatalystActivity\", \"dbId\": 11051179, \"displayName\": \"monooxygenase activity of CYP2E1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 11051183, \"displayName\": \"CYP2E1 oxidises 14(R)-HDHA to 14(R),21(R)-diHDHA and 14(R),21(S)-diHDHA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11051183], \"dbId\": 9027049, \"displayName\": \"14(R)-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"14(R)-HDHA\", \"(14R)-HDoHE(1-)\", \"(14R)-HDHA(1-)\", \"14(R)-hydroxy-docosahexaenoic acid\", \"(14R)-HDoHE\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9027049\", \"stIdVersion\": \"R-ALL-9027049.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11051183], \"dbId\": 2