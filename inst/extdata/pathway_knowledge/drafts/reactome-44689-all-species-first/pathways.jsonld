        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11009212], \"className\": \"CatalystActivity\", \"dbId\": 11009210, \"displayName\": \"acetyl-CoA carboxylase activity of Btn-ACACA:2Mn2+ polymer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11009212, \"displayName\": \"Btn-ACACA:2Mn2+ polymer carboxylates Ac-CoA to form Mal-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0046949\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 78809, \"definition\": \"The chemical reactions and pathways resulting in the formation of a fatty-acyl-CoA, any derivative of coenzyme A in which the sulfhydryl group is in thiolester linkage with a fatty-acyl group.\", \"displayName\": \"fatty-acyl-CoA biosynthetic process\", \"name\": \"fatty-acyl-CoA biosynthetic process\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0046949\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11009212], \"dbId\": 76183, \"displayName\": \"Ac-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ac-CoA\", \"acetyl-CoA(4-)\", \"Acetyl coenzyme A\", \"acetyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76