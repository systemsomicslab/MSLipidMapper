      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + 4CHOL7a,24(S)DONE [endoplasmic reticulum membrane] + NADPH [cytosol] => NADP+ [cytosol] + 5beta-cholestan-7alpha,24(S)-diol-3-one [cytosol]"
      }
    ],
