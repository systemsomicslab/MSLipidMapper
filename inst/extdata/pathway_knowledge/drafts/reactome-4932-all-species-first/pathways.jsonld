    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11094634], \"className\": \"CatalystActivity\", \"dbId\": 11094632, \"displayName\": \"carnitine:O-acyl-L-carnitine antiporter activity of SLC25A20 [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005758\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17927, \"definition\": \"The region between the inner and outer lipid bilayers of the mitochondrial envelope.\", \"displayName\": \"mitochondrial intermembrane space\", \"name\": \"mitochondrial intermembrane space\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005758\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}, {\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 11094634, \"displayName\": \"Exchange of acylcarnitine and carnitine across the inner mitochondrial membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11094634], \"dbId\": 201023, \"displayName\": \"CAR [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CAR\", \"(R)-carnitine\", \"gamma-Trimethyl-hydroxybutyrobetaine\", \"carnitine\", \"3-Hydroxy-4-trimethylammoniobutanoate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-201023\", \"stIdVersion\": \"R-ALL-201023.4\"}, {\"className\": \"Set\", \"consumedByEvent\": [11094634], \"dbId\": 9971099, \"displayName\": \"Acyl-CAR [mitochondrial intermembrane space]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Acyl-CAR\", \"O-Acyl-L-carnitines\", \"acylcarnitines\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9971099\", \"stIdVersion\": \"R-ALL-9971099.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Exchange of acylcarnitine and carnitine across the inner mitochondrial membrane\", \"(R)-carnitine(in) + O-acyl-(R)-carnitine(out) = (R)-carnitine(out) + O-acyl-(R)-carnitine(in)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 549207, \"displayName\": \"CAR [mitochondrial intermembrane space]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CAR\", \"(R)-carnitine\", \"gamma-Trimethyl-hydroxybutyrobetaine\", \"carnitine\", \"3-Hydroxy-4-trimethylammoniobutanoate\"], \"producedByEvent\": [11094634], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-549207\", \"stIdVersion\": \"R-ALL-549207.4\"}, {\"className\": \"Set\", \"dbId\": 9971097, \"displayName\": \"Acyl-CAR [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Acyl-CAR\", \"O-Acyl-L-carnitines\", \"acylcarnitines\"], \"producedByEvent\": [11094634], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9971097\", \"stIdVersion\": \"R-ALL-9971097.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SCE\", \"className\": \"Species\", \"dbId\": 68322, \"displayName\": \"Saccharomyces cerevisiae\", \"name\": [\"Saccharomyces cerevisiae\", \"S.cerevisiae\", \"S. cerevisiae\", \"Sc\", \"baker's yeast\", \"brewer's yeast\", \"Saccharomyces cerevisiae (strain RM11-1a)\", \"Saccharomyces cerevisiae (strain YJM789)\"], \"schemaClass\": \"Species\", \"taxId\": \"4932\"}], \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-200424\", \"stIdVersion\": \"R-SCE-200424.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>