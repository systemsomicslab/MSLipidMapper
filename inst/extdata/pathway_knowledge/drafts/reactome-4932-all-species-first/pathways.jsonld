      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11099724], \"className\": \"CatalystActivity\", \"dbId\": 11099612, \"displayName\": \"phosphatidylcholine lysophospholipase A1 activity of PLA2G4C [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11099724, \"displayName\": \"1-acyl LPC is hydrolyzed to GPCho by PLA2G4C\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11099724], \"dbId\": 1524028, \"displayName\": \"1-acyl LPC [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPC\", \"1-O-acyl-sn-glycero-3-phosphocholine(1+)\", \"2-lysophosphatidylcholine\", \"1-acyl-sn-glycero-3-phosphocholines\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524028\", \"stIdVersion\": \"R-ALL-1524028.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11099724], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1-acyl LPC is hydrolyzed to GPCho by PLA2G4C\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1498750, \"displayName\": \"GPCho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GPCho\", \"choline alfoscerate\", \"GroPCho\", \"Glycerol 3-phosphocholine\", \"glycerophosphocholine\"], \"producedByEvent\": [11099724], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498750\", \"stIdVersion\": \"R-ALL-1498750.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524021, \"displayName\": \"LCFA(-) [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [11099724], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524021\", \"stIdVersion\": \"R-ALL-1524021.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11099813, \"displayName\": \"PC is hydrolyzed to 1-acyl LPC by PLA2[5]\", \"followingEvent\": [11099724], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PC is hydrolyzed to 1-acyl LPC by PLA2[5]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1482856\", \"stIdVersion\": \"R-SCE-1482856.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11099790, \"displayName\": \"PC is hydrolyzed to 1-acyl LPC by PLA2[6]\", \"followingEvent\": [11099724], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PC is hydrolyzed to 1-acyl LPC by PLA2[6]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1482816\", \"stIdVersion\": \"R-SCE-1482816.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SCE\", \"className\": \"Species\", \"dbId\": 68322, \"displayName\": \"Saccharomyces cerevisiae\", \"name\": [\"Saccharomyces cerevisiae\", \"S.cerevisiae\", \"S. cerevisiae\", \"Sc\", \"baker's yeast\", \"brewer's yeast\", \"Saccharomyces cerevisiae (strain RM11-1a)\", \"Saccharomyces cerevisiae (strain YJM789)\"], \"schemaClass\": \"Species\", \"taxId\": \"4932\"}], \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1482696\", \"stIdVersion\": \"R-SCE-1482696.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
