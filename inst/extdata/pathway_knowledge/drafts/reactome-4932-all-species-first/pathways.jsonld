    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11099787], \"className\": \"CatalystActivity\", \"dbId\": 11099785, \"displayName\": \"1-acylglycerophosphocholine O-acyltransferase activity of TAZ [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 11099787, \"displayName\": \"CL and 1-acyl LPC are converted to MLCL and PC by TAZ (IM) (Reversible)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11099774], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11099787], \"dbId\": 1524072, \"displayName\": \"cardiolipin [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"cardiolipin\", \"CL\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524072\", \"stIdVersion\": \"R-ALL-1524072.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11099787], \"dbId\": 1524079, \"displayName\": \"1-acyl LPC [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPC\", \"1-O-acyl-sn-glycero-3-phosphocholine(1+)\", \"2-lysophosphatidylcholine\", \"1-acyl-sn-glycero-3-phosphocholines\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524079\", \"stIdVersion\": \"R-ALL-1524079.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CL and 1-acyl LPC are converted to MLCL and PC by TAZ (IM) (Reversible)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1498773, \"displayName\": \"MLCL [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MLCL\", \"2-monolysocardiolipin\", \"Monolysocardiolipin\"], \"producedByEvent\": [11099787], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498773\", \"stIdVersion\": \"R-ALL-1498773.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524075, \"displayName\": \"PC [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PC\", \"1,2-diacyl-sn-glycero-3-phosphocholine\", \"Phosphatidyl choline\"], \"producedByEvent\": [11099787], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524075\", \"stIdVersion\": \"R-ALL-1524075.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11099784, \"displayName\": \"MLCL and PC are converted to CL and 1-acyl LPC by TAZ (IM) (Reversible)\", \"followingEvent\": [11099787], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MLCL and PC are converted to CL and 1-acyl LPC by TAZ (IM) (Reversible)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1482781\", \"stIdVersion\": \"R-SCE-1482781.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11099808, \"displayName\": \"MLCL and PE are converted to CL and 1-acyl LPE by TAZ (IM) (Reversible)\", \"followingEvent\": [11099787], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MLCL and PE are converted to CL and 1-acyl LPE by TAZ (IM) (Reversible)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1482850\", \"stIdVersion\": \"R-SCE-1482850.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11099921, \"displayName\": \"PG and CDP-DAG are converted to CL by CRLS1\", \"followingEvent\": [11099787], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PG and CDP-DAG are converted to CL by CRLS1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1483063\", \"stIdVersion\": \"R-SCE-1483063.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SCE\", \"className\": \"Species\", \"dbId\": 68322, \"displayName\": \"Saccharomyces cerevisiae\", \"name\": [\"Saccharomyces cerevisiae\", \"S.cerevisiae\", \"S. cerevisiae\", \"Sc\", \"baker's yeast\", \"brewer's yeast\", \"Saccharomyces cerevisiae (strain RM11-1a)\", \"Saccharomyces cerevisiae (strain YJM789)\"], \"schemaClass\": \"Species\", \"taxId\": \"4932\"}], \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1482794\", \"stIdVersion\": \"R-SCE-1482794.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
