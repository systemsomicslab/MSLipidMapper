    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11099970], \"className\": \"CatalystActivity\", \"dbId\": 11099968, \"displayName\": \"D-type glycerophospholipase activity of PLD1/2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11099970, \"displayName\": \"PC is hydrolyzed to PA and choline by PLD1/2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11099918], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11099970], \"dbId\": 426925, \"displayName\": \"PC [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PC\", \"1,2-diacyl-sn-glycero-3-phosphocholine\", \"Phosphatidyl choline\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426925\", \"stIdVersion\": \"R-ALL-426925.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11099970], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PC is hydrolyzed to PA and choline by PLD1/2\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 426755, \"displayName\": \"PA [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PA\", \"phosphatidate(2-)\", \"phosphatidic acid\"], \"producedByEvent\": [11099970], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426755\", \"stIdVersion\": \"R-ALL-426755.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 264618, \"displayName\": \"Cho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Cho\", \"choline\"], \"producedByEvent\": [11099970], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-264618\", \"stIdVersion\": \"R-ALL-264618.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11099863, \"displayName\": \"CDP-Cho and DAG are converted to PC by CEPT1 at the ER membrane\", \"followingEvent\": [11099970], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CDP-Cho and DAG are converted to PC by CEPT1 at the ER membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1482961\", \"stIdVersion\": \"R-SCE-1482961.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11099625, \"displayName\": \"1-acyl LPC is acylated to PC by LPCAT\", \"followingEvent\": [11099970], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1-acyl LPC is acylated to PC by LPCAT\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1482547\", \"stIdVersion\": \"R-SCE-1482547.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11099583, \"displayName\": \"2-acyl LPC is acylated to PC by LPCAT\", \"followingEvent\": [11099970], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-acyl LPC is acylated to PC by LPCAT\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1482533\", \"stIdVersion\": \"R-SCE-1482533.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SCE\", \"className\": \"Species\", \"dbId\": 68322, \"displayName\": \"Saccharomyces cerevisiae\", \"name\": [\"Saccharomyces cerevisiae\", \"S.cerevisiae\", \"S. cerevisiae\", \"Sc\", \"baker's yeast\", \"brewer's yeast\", \"Saccharomyces cerevisiae (strain RM11-1a)\", \"Saccharomyces cerevisiae (strain YJM789)\"], \"schemaClass\": \"Species\", \"taxId\": \"4932\"}], \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1483182\", \"stIdVersion\": \"R-SCE-1483182.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
