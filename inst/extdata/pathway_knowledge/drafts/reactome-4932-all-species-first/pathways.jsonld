        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11110087], \"className\": \"CatalystActivity\", \"dbId\": 11110085, \"displayName\": \"endoplasmic reticulum-lipid droplet tether activity of FITM2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11110087, \"displayName\": \"FITM2 binds TAGs\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11110087], \"dbId\": 549167, \"displayName\": \"TAG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TAG\", \"triglyceride\", \"triacylglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-549167\", \"stIdVersion\": \"R-ALL-549167.4\"}, {\"className\": \"Protein\", \"consumedByEvent\": [11110087], \"dbId\": 11110082, \"displayName\": \"SCS3 [endoplasmic reticulum membrane]\", \"endCoordinate\": 262, \"inDisease\": false