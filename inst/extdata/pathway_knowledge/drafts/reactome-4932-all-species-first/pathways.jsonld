    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11094008], \"className\": \"CatalystActivity\", \"dbId\": 11093990, \"displayName\": \"alcohol dehydrogenase (NADP+) activity of Aldo-keto reductase family [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11094008, \"displayName\": \"5beta-cholestan-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,24(S)-triol\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11094008], \"dbId\": 193760, \"displayName\": \"5beta-cholestan-7alpha,24(S)-diol-3-one [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-7alpha,24(S)-diol-3-one\", \"(24S)-7alpha,24-dihydroxy-5beta-cholestan-3-one\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193760\", \"stIdVersion\": \"R-ALL-193760.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11094008], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11094008], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,24(S)-triol\", \"5beta-cholestan-7alpha,24(S)-diol-3-one+ NADPH + H+ => 5beta-cholestan-3alpha,7alpha,24(S)-triol + NADP+\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 213285, \"displayName\": \"5beta-cholestan-3alpha,7alpha,24(S)-triol [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha,7alpha,24(S)-triol\", \"(24S)-5beta-cholestane-3alpha,7alpha,24-triol\"], \"producedByEvent\": [11094008], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-213285\", \"stIdVersion\": \"R-ALL-213285.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [11094008], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11094006, \"displayName\": \"4-cholesten-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-7alpha,24(S)-diol-3-one\", \"followingEvent\": [11094008], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"4-cholesten-7alpha,24(S)-diol-3-one is reduced to 5beta-cholestan-7alpha,24(S)-diol-3-one\", \"4-cholesten-7alpha,24(S)-diol-3-one + NADPH + H+ => 5beta-cholestan-7alpha,24(S)-diol-3-one + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-193746\", \"stIdVersion\": \"R-SCE-193746.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SCE\", \"className\": \"Species\", \"dbId\": 68322, \"displayName\": \"Saccharomyces cerevisiae\", \"name\": [\"Saccharomyces cerevisiae\", \"S.cerevisiae\", \"S. cerevisiae\", \"Sc\", \"baker's yeast\", \"brewer's yeast\", \"Saccharomyces cerevisiae (strain RM11-1a)\", \"Saccharomyces cerevisiae (strain YJM789)\"], \"schemaClass\": \"Species\", \"taxId\": \"4932\"}], \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-193758\", \"stIdVersion\": \"R-SCE-193758.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
