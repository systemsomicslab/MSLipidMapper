    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "ATP [cytosol] + PI [early endosome membrane] => PI4P [early endosome membrane] + ADP [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11100203], \"className\": \"CatalystActivity\", \"dbId\": 11100109, \"displayName\": \"1-phosphatidylinositol 4-kinase activity of PI4K2A/2B [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0031901\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 171062, \"definition\": \"The lipid bilayer surrounding an early endosome.\", \"displayName\": \"early endosome membrane\", \"name\": \"early endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031901\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11100203, \"displayName\": \"PI is phosphorylated to PI4P by PI4K2A/B at the early endosome membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11100203], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11100203], \"dbId\": 1806199, \"displayName\": \"PI [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI\", \"1-phosphatidyl-1D-myo-inositol(1-)\", \"Phosphatidyl 1D-myo-inositol\", \"1-phosphatidyl-1D-myo-inositol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806199\", \"stIdVersion\": \"R-ALL-1806199.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI is phosphorylated to PI4P by PI4K2A/B at the early endosome membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [11100203], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1806180, \"displayName\": \"PI4P [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI4P\", \"1-phosphatidyl-1D-myo-inositol 4-phosphate\", \"Phosphatidylinositol 4-phosphate\", \"1-phosphatidyl-1D-myo-inositol 4-phosphates\"], \"producedByEvent\": [11100203], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806180\", \"stIdVersion\": \"R-ALL-1806180.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11100246, \"displayName\": \"PI3P is dephosphorylated to PI by MTM proteins at the early endosome membrane\", \"followingEvent\": [11100203], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI3P is dephosphorylated to PI by MTM proteins at the early endosome membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1676141\", \"stIdVersion\": \"R-SCE-1676141.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SCE\", \"className\": \"Species\", \"dbId\": 68322, \"displayName\": \"Saccharomyces cerevisiae\", \"name\": [\"Saccharomyces cerevisiae\", \"S.cerevisiae\", \"S. cerevisiae\", \"Sc\", \"baker's yeast\", \"brewer's yeast\", \"Saccharomyces cerevisiae (strain RM11-1a)\", \"Saccharomyces cerevisiae (strain YJM789)\"], \"schemaClass\": \"Species\", \"taxId\": \"4932\"}], \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1675974\", \"stIdVersion\": \"R-SCE-1675974.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
