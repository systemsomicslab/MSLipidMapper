      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11099703], \"className\": \"CatalystActivity\", \"dbId\": 11099701, \"displayName\": \"2-acylglycerol-3-phosphate O-acyltransferase activity of LPGAT [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11099703, \"displayName\": \"2-acyl LPG is acylated to PG by LPGAT\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11099703], \"dbId\": 1498730, \"displayName\": \"2-acyl LPG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2-acyl LPG\", \"2-acyl-sn-glycero-3-phosphoglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498730\", \"stIdVersion\": \"R-ALL-1498730.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11099703], \"dbId\": 1500578, \"displayName\": \"acyl-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"acyl-CoA\", \"acyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500578\", \"stIdVersion\": \"R-ALL-1500578.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-acyl LPG is acylated to PG by LPGAT\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1483256, \"displayName\": \"PG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PG\", \"1,2-diacyl-sn-glycero-3-phospho-(1'-sn-glycerol)(1-)\", \"phosphatidylglycerol\"], \"producedByEvent\": [11099703], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1483256\", \"stIdVersion\": \"R-ALL-1483256.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [11099703], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11099841, \"displayName\": \"PG is hydrolyzed to 2-acyl LPG by PLA2[14]\", \"followingEvent\": [11099703], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PG is hydrolyzed to 2-acyl LPG by PLA2[14]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1482920\", \"stIdVersion\": \"R-SCE-1482920.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SCE\", \"className\": \"Species\", \"dbId\": 68322, \"displayName\": \"Saccharomyces cerevisiae\", \"name\": [\"Saccharomyces cerevisiae\", \"S.cerevisiae\", \"S. cerevisiae\", \"Sc\", \"baker's yeast\", \"brewer's yeast\", \"Saccharomyces cerevisiae (strain RM11-1a)\", \"Saccharomyces cerevisiae (strain YJM789)\"], \"schemaClass\": \"Species\", \"taxId\": \"4932\"}], \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-1482635\", \"stIdVersion\": \"R-SCE-1482635.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
