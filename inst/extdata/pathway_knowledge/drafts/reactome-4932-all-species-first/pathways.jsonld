        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11112175], \"className\": \"CatalystActivity\", \"dbId\": 11112165, \"displayName\": \"epoxide hydrolase activity of LTA4H:Zn2+ [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11112175, \"displayName\": \"LTA4H:Zn2+ hydrolyses 17R(16)-epoxy-DHA to AT-(N)PD1\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11112175], \"dbId\": 9024893, \"displayName\": \"17R(16)-epoxy-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17R(16)-epoxy-DHA\", \"17R,(16)-epoxy-(4Z,7Z,10Z,13Z,19Z)-docosahexa-4,7,10,13,15,19-enoate\", \"17R,(16)-epoxy-DHA(1-)\", \"17R,(16)-epoxy-(4Z,7Z,10Z,13Z,19Z)-docosahexa-4,7,10,13,15,19-enoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024893\", \"stIdVersion\": \"R-ALL-9024893.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11112175], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\":