    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + NADPH [cytosol] + O2 [cytosol] + CHOL [cytosol] => H2O [cytosol] + 25OH-CHOL [cytosol] + NADP+ [cytosol]"
