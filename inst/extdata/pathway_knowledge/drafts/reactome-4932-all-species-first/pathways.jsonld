    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11113249], \"className\": \"CatalystActivity\", \"dbId\": 11113247, \"displayName\": \"dimethylallyltranstransferase activity of holo-GGPS1 hexamer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11113249, \"displayName\": \"GGPS1 hexamer transfers IPPP to DMAPP\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11113246], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11113249], \"dbId\": 191324, \"displayName\": \"DMAPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DMAPP\", \"prenyl diphosphate(3-)\", \"Dimethylallyl pyrophosphate\", \"prenyl diphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191324\", \"stIdVersion\": \"R-ALL-191324.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11113249], \"dbId\": 191362, \"displayName\": \"IPPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"IPPP\", \"isopentenyl diphosphate(3-)\", \"delta3-isopentenyl-PP\", \"isopentenyl diphosphate\", \"delta3-isopentenyl pyrophosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191362\", \"stIdVersion\": \"R-ALL-191362.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GGPS1 hexamer transfers IPPP to DMAPP\", \"isopentenyl diphosphate + dimethylallyl diphosphate => (2E)-geranyl diphosphate + diphosphate\", \"Addition of isopentenyl pyrophosphate to DMAPP\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 191409, \"displayName\": \"GPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GPP\", \"geranyl diphosphate(3-)\", \"Geranyl pyrophosphate\", \"geranyl diphosphate\"], \"producedByEvent\": [11113249], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191409\", \"stIdVersion\": \"R-ALL-191409.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111294, \"displayName\": \"PPi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [11113249], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111294\", \"stIdVersion\": \"R-ALL-111294.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11093879, \"displayName\": \"Isopentenyl pyrophosphate rearranges to dimethylallyl pyrophosphate\", \"followingEvent\": [11113249], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Isopentenyl pyrophosphate rearranges to dimethylallyl pyrophosphate\", \"isopentenyl diphosphate => dimethylallyl diphosphate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-191382\", \"stIdVersion\": \"R-SCE-191382.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11093901, \"displayName\": \"MVD decarboxylates MVA5PP to IPPP\", \"followingEvent\": [11113249], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MVD decarboxylates MVA5PP to IPPP\", \"(R)-5-diphosphomevalonate + ATP => isopentenyl diphosphate + ADP + phosphate + CO2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-191414\", \"stIdVersion\": \"R-SCE-191414.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SCE\", \"className\": \"Species\", \"dbId\": 68322, \"displayName\": \"Saccharomyces cerevisiae\", \"name\": [\"Saccharomyces cerevisiae\", \"S.cerevisiae\", \"S. cerevisiae\", \"Sc\", \"baker's yeast\", \"brewer's yeast\", \"Saccharomyces cerevisiae (strain RM11-1a)\", \"Saccharomyces cerevisiae (strain YJM789)\"], \"schemaClass\": \"Species\", \"taxId\": \"4932\"}], \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-9717834\", \"stIdVersion\": \"R-SCE-9717834.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
