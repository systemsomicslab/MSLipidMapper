, \"name\": [\"FDPS dimer transfers IPPP to DMAPP\", \"isopentenyl diphosphate + dimethylallyl diphosphate => (2E)-geranyl diphosphate + diphosphate\", \"Addition of isopentenyl pyrophosphate to DMAPP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-191322\", \"stIdVersion\": \"R-SCE-191322.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11093901, \"displayName\": \"MVD decarboxylates MVA5PP to IPPP\", \"followingEvent\": [11113246], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MVD decarboxylates MVA5PP to IPPP\", \"(R)-5-diphosphomevalonate + ATP => isopentenyl diphosphate + ADP + phosphate + CO2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-191414\", \"stIdVersion\": \"R-SCE-191414.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SCE\", \"className\": \"Species\", \"dbId\": 68322, \"displayName\": \"Saccharomyces cerevisiae\", \"name\": [\"Saccharomyces cerevisiae\", \"S.cerevisiae\", \"S. cerevisiae\", \"Sc\", \"baker's yeast\", \"brewer's yeast\", \"Saccharomyces cerevisiae (strain RM11-1a)\", \"Saccharomyces cerevisiae (strain YJM789)\"], \"schemaClass\": \"Species\", \"taxId\": \"4932\"}], \"speciesName\": \"Saccharomyces cerevisiae\", \"stId\": \"R-SCE-9717830\", \"stIdVersion\": \"R-SCE-9717830.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High lev