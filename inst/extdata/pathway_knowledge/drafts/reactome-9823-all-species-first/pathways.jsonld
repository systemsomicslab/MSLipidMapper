        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10502085], \"className\": \"CatalystActivity\", \"dbId\": 10502083, \"displayName\": \"phosphatidylinositol-3,4-bisphosphate 4-phosphatase activity of INPP4A/B [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0031901\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 171062, \"definition\": \"The lipid bilayer surrounding an early endosome.\", \"displayName\": \"early endosome membrane\", \"name\": \"early endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031901\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10502085, \"displayName\": \"PI(3,4)P2 is dephosphorylated to PI3P by INPP4A/B at the early endosome membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10502059], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10502085], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10502085], \"dbId\": 1806238, \"displayName\": \"PI(3,4)P2 [early endosome membrane]\", \"in