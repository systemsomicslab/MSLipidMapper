        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10550912], \"className\": \"CatalystActivity\", \"dbId\": 10550890, \"displayName\": \"arachidonate 15-lipoxygenase activity of ALOX15 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10550912, \"displayName\": \"ALOX15 dehydrogenates 17(R)-Hp-DHA to 17R(16)-epoxy-DHA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10550904], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10550912], \"dbId\": 9024522, \"displayName\": \"17(R)-Hp-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17(R)-Hp-DHA\", \"(4Z,7Z,10Z,13Z,15E,17R,19Z)-17-hydroperoxydocosahexaenoate\", \"17(R)-hydroperoxy-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024522\", \"stIdVersion\": \"R-ALL-9024522.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10550912], \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"Sim