    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + CYB5B:Fe2+ [endoplasmic reticulum membrane] + 2-saturated fatty acid [cytosol] + O2 [cytosol] => H2O [cytosol] + CYB5B:Fe3+ [endoplasmic reticulum membrane] + 2-OH FA [cytosol]"
