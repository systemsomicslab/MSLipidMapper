        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10538249, \"displayName\": \"MTMR12 binds MTMR2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10538249], \"dbId\": 10501824, \"displayName\": \"MTMR2 [cytosol]\", \"endCoordinate\": 643, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MTMR2\", \"F1STI4\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1604662\", \"stIdVersion\": \"R-SSC-1604662.1\", \"startCoordinate\": 1}, {\"className\": \"Protein\", \"consumedByEvent\": [10538249], \"dbId\": 10538240, \"displayName\": \"MTMR12 [cytosol]\", \"endCoordinate\": 747, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MTMR12\", \"MTMR12\", \"A0A287AS86\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-6809657\", \"stIdVersion\": \"R-SSC-6809657.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MTMR12 binds MTMR2\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10538247, \"displayName\": \"MTMR2:MTMR12 [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"MTMR2:MTMR12\"], \"producedByEvent\": [10538