d\", \"consumedByEvent\": [10558998], \"dbId\": 914003, \"displayName\": \"UDP-GlcNAc [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP-GlcNAc\", \"UDP-N-acetyl-alpha-D-glucosamine(2-)\", \"UDP-N-acetyl-D-glucosamine\", \"UDP-N-acetyl-alpha-D-glucosamine\", \"UDP-N-acetylglucosamine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-914003\", \"stIdVersion\": \"R-ALL-914003.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"B3GNT5 transfers GlcNAc to LacCer\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9846503, \"displayName\": \"Lc3Cer [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Lc3Cer\", \"N-acetyl-beta-D-glucosaminyl-(1->3)-beta-D-galactosyl-(1->4)-beta-D-glucosylceramide(d18:1(4E))\"], \"producedByEvent\": [10558998], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9846503\", \"stIdVersion\": \"R-ALL-9846503.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 205687, \"displayName\": \"UDP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP\", \"UDP(3-)\", \"uridine 5'-diphosphate\"], \"producedByEvent\": [10558998], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-205687\", \"stIdVersion\": \"R-ALL-205687.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10558998], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10559003, \"displayName\": \"B4GALT5/6 transfer Gal to GlcCer\", \"followingEvent\": [10558998], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"n