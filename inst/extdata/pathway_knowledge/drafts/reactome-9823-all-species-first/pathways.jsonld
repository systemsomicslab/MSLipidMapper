    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "NADP+ [mitochondrial matrix] + 5beta-cholestan-3alpha,7alpha,26-triol [mitochondrial matrix] => NADPH [mitochondrial matrix] + H+ [mitochondrial matrix] + 3alpha,7alpha-dihydroxy-5beta-cholestan-26-al [mitochondrial matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10470654], \"className\": \"CatalystActivity\", \"dbId\": 10470379, \"displayName\": \"oxidoreductase activity, acting on NAD(P)H as acceptor of CYP27A1 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10470654, \"displayName\": \"5beta-cholestan-3alpha, 7alpha, 26-triol is oxidized to 3alpha, 7alpha-dihydroxy-5beta-cholestan-26-al\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10470648], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470654], \"dbId\": 193387, \"displayName\": \"5beta-cholestan-3alpha,7alpha,26-triol [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha,7alpha,26-triol\", \"5beta-cholestane-3alpha,7alpha,26-triol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193387\", \"stIdVersion\": \"R-ALL-193387.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470654], \"dbId\": 113563, \"displayName\": \"NADP+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113563\", \"stIdVersion\": \"R-ALL-113563.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha, 7alpha, 26-triol is oxidized to 3alpha, 7alpha-dihydroxy-5beta-cholestan-26-al\", \"5beta-cholestan-3alpha, 7alpha, 26-triol + NADP+ => 3alpha,7alpha-dihydroxy-5beta-cholestan-26-al + NADPH + H+\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193435, \"displayName\": \"3alpha,7alpha-dihydroxy-5beta-cholestan-26-al [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3alpha,7alpha-dihydroxy-5beta-cholestan-26-al\"], \"producedByEvent\": [10470654], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193435\", \"stIdVersion\": \"R-ALL-193435.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10470654], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113600, \"displayName\": \"NADPH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"producedByEvent\": [10470654], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113600\", \"stIdVersion\": \"R-ALL-113600.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10470635, \"displayName\": \"5beta-cholestan-3alpha, 7alpha-diol is hydroxylated to 5beta-cholestan-3alpha, 7alpha, 26-triol\", \"followingEvent\": [10470654], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha, 7alpha-diol is hydroxylated to 5beta-cholestan-3alpha, 7alpha, 26-triol\", \"5beta-cholestan-3alpha, 7alpha-diol + NADPH + H+ + O2 => 5beta-cholestan-3alpha, 7alpha, 26-triol + NADP+ + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-193393\", \"stIdVersion\": \"R-SSC-193393.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-193497\", \"stIdVersion\": \"R-SSC-193497.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
