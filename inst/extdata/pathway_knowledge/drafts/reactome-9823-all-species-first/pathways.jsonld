    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + NADPH [cytosol] + 4MZYMOL [endoplasmic reticulum membrane] + O2 [cytosol] => H2O [cytosol] + NADP+ [cytosol] + 4CZYMOL [endoplasmic reticulum membrane]"
