        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10501678], \"className\": \"CatalystActivity\", \"dbId\": 10480255, \"displayName\": \"serine-type endopeptidase activity of MBTPS1 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}], \"dbId\": 10501678, \"displayName\": \"S1P hydrolyzes SREBP1A,1C,2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10501680], \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10501678], \"dbId\": 10501668, \"displayName\": \"SREBP1A,1C,2:SCAP [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"SREBP1A,1C,2:SCAP\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1655742\", \"stIdVersion\": \"R-SSC-1655742.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"S1P hydrolyzes SREBP1A,1C,2\", \"SKI-1 hydrolyzes SREBP1A,1C,2\", \"S1P hydrolyzes SREBF1A,1C,2\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10501666, \"displayName\": \"SCAP tetramer [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"SCAP tetramer\"], \"producedByEvent\": [10501678], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1655737\", \"stIdVersion\": \"R-SSC-1655737.1\"}, {\"className\": \"Set\", \"dbId\": 10501676, \"displayName\": \"SREBF1A,1C,2 cleaved by S1P [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"SREBF1A,1C,2 cleaved by S1P\", \"SREBP1A,1C,2 cleaved by S1P\"], \"producedByEvent\": [10501678, 10501678, 10501678, 10501678], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1655726\", \"stIdVersion\": \"R-SSC-1655726.1\"}, 10501676, 10501676, 10501676], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1655842\", \"stIdVersion\": \"R-SSC-1655842.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other