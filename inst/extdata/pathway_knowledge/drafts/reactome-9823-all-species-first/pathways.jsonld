      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10500783], \"className\": \"CatalystActivity\", \"dbId\": 10500781, \"displayName\": \"glucosylceramidase activity of GBA1:SAPC [lysosomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005765\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17938, \"definition\": \"The lipid bilayer surrounding the lysosome and separating its contents from the cell cytoplasm.\", \"displayName\": \"lysosomal membrane\", \"name\": \"lysosomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005765\"}, {\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 10500783, \"displayName\": \"GBA1:SAPC hydrolyzes GlcCer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10500783], \"dbId\": 1605592, \"displayName\": \"GlcCer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GlcCer\", \"beta-D-glucosyl-N-acylsphingosine\", \"Glucosylceramide\", \"Glucocerebroside\", \"D-glucosyl-N-acylsphingosine\", \"D-glucosy-N-acylsphingosine\", \"D-glucosyl-N-acylsphingoid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605592\", \"stIdVersion\": \"R-ALL-1605592.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10500783], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA1:SAPC hydrolyzes GlcCer\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605673, \"displayName\": \"CERA [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CERA\", \"N-acylsphingoid\", \"Ceramide\", \"N-acylsphingosine\"], \"producedByEvent\": [10500783], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605673\", \"stIdVersion\": \"R-ALL-1605673.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1605745, \"displayName\": \"Glc [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Glc\", \"D-glucopyranose\", \"alpha-D-glucose\"], \"producedByEvent\": [10500783], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605745\", \"stIdVersion\": \"R-ALL-1605745.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10500982, \"displayName\": \"GLB1 hydrolyzes SapB/C:LacCer\", \"followingEvent\": [10500783], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GLB1 hydrolyzes SapB/C:LacCer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1606312\", \"stIdVersion\": \"R-SSC-1606312.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1605591\", \"stIdVersion\": \"R-SSC-1605591.1\