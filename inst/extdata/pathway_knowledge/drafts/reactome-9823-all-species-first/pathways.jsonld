    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10554083], \"className\": \"CatalystActivity\", \"dbId\": 10554081, \"displayName\": \"lipid kinase activity of SPHK2 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10554083, \"displayName\": \"SPHK2 phosphorylates sphingoid\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10554072], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10554083], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10554083], \"dbId\": 428682, \"displayName\": \"SPG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SPG\", \"sphingoid base(1+)\", \"sphingosine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428682\", \"stIdVersion\": \"R-ALL-428682.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SPHK2 phosphorylates sphingoid\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [10554083], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [10554083], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 5279322, \"displayName\": \"S1P [cytoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"S1P\", \"sphingoid 1-phosphate(1-)\", \"sphingoid 1-phosphate\", \"phys-ent-participant40241\", \"phys-ent-participant40259\"], \"producedByEvent\": [10554083], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5279322\", \"stIdVersion\": \"R-ALL-5279322.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10484566, \"displayName\": \"PLPP1,2,3 dephosphorylate cytosolic sphingosine-1-phosphate\", \"followingEvent\": [10554083], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLPP1,2,3 dephosphorylate cytosolic sphingosine-1-phosphate\", \"sphingosine 1-phosphate + H2O => sphingosine + orthophosphate [cytosolic - PPAP]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-428696\", \"stIdVersion\": \"R-SSC-428696.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10484356, \"displayName\": \"KDSR reduces 3-ketosphingoid\", \"followingEvent\": [10554083], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"KDSR reduces 3-ketosphingoid\", \"3-ketosphingoid + NADPH + H+ => sphingoid + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-428123\", \"stIdVersion\": \"R-SSC-428123.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10484448, \"displayName\": \"ACER1 hydrolyzes ceramide (endoplasmic reticulum)\", \"followingEvent\": [10554083], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACER1 hydrolyzes ceramide (endoplasmic reticulum)\", \"ceramide + H2O <=> fatty acid + sphingosine (endoplasmic reticulum)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-428231\", \"stIdVersion\": \"R-SSC-428231.1\"}], \"regulatedBy\": [{\"className\": \"NegativeRegulation\", \"dbId\": 10554084, \"displayName\": \"Negative regulation by 'SPHK2:SPHK2 inhibitors [cytosol]'\", \"regulatedEntity\": [10554083], \"schemaClass\": \"NegativeRegulation\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9695949\", \"stIdVersion\": \"R-SSC-9695949.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Bri