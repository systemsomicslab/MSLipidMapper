    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + (N)PD1 [cytosol] + NADPH [cytosol] + O2 [cytosol] => H2O [cytosol] + 22-OH-(N)PD1 [cytosol] + NADP+ [cytosol]"
