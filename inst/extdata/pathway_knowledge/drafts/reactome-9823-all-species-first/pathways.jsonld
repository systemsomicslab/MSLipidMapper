      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10538245], \"className\": \"CatalystActivity\", \"dbId\": 10538243, \"displayName\": \"phosphatase activator activity of MTMR12 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10538245, \"displayName\": \"MTMR12 binds MTM1\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10538252], \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10538245], \"dbId\": 10501820, \"displayName\": \"MTM1 [cytosol]\", \"endCoordinate\": 603, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MTM1\", \"A0A4X1SY68\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1604646\", \"stIdVersion\": \"R-SSC-1604646.1\", \"startCoordinate\": 1}, {\"className\": \"Protein\", \"consumedByEvent\": [10538245], \"dbId\": 10538240, \"displayName\": \"MTMR12 [cytosol]\", \"endCoordinate\": 747, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MTMR12\", \"MTMR12\", \"A0A287AS86\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-6809657\", \"stIdVersion\": \"R-SSC-6809657.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MTMR12 binds MTM1\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10538242, \"displayName\": \"MTM1:MTMR12 [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"MTM1:MTMR12\"], \"producedByEvent\": [10538245], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-6809679\", \"stIdVersion\": \"R-SSC-6809679.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-6809680\", \"stIdVersion\": \"R-SSC-6809680.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a m