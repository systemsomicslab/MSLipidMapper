    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + bHMG-CoA [cytosol] + NADPH [cytosol] => CoA-SH [cytosol] + NADP+ [cytosol] + MVA [cytosol]"
