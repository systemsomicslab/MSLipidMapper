    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10555678, \"displayName\": \"ACLY tetramer binds ETC-1002-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10555678], \"dbId\": 10459278, \"displayName\": \"ACLY tetramer [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"ACLY tetramer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-76188\", \"stIdVersion\": \"R-SSC-76188.1\"}, {\"className\": \"ChemicalDrug\", \"consumedByEvent\": [10555678], \"dbId\": 9734541, \"displayName\": \"ETC-1002-CoA [cytosol]\", \"inDisease\": true, \"maxDepth\": 1, \"name\": [\"ETC-1002-CoA\"], \"schemaClass\": \"ChemicalDrug\", \"stId\": \"R-ALL-9734541\", \"stIdVersion\": \"R-ALL-9734541.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer binds ETC-1002-CoA\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10555676, \"displayName\": \"ACLY tetramer:ETC-1002-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"ACLY tetramer:ETC-1002-CoA\"], \"producedByEvent\": [10555678], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9734534\", \"stIdVersion\": \"R-SSC-9734534.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10555674, \"displayName\": \"SLC27A2 ligates CoA to bempedoic acid to form ETC-1002-CoA\", \"followingEvent\": [10555678], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC27A2 ligates CoA to bempedoic acid to form ETC-1002-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9734535\", \"stIdVersion\": \"R-SSC-9734535.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9734540\", \"stIdVersion\": \"R-SSC-9734540.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
