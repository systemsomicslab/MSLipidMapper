    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10488902], \"className\": \"CatalystActivity\", \"dbId\": 10488900, \"displayName\": \"very-long-chain fatty acyl-CoA dehydrogenase activity of TECR,TECRL [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10488902, \"displayName\": \"TECR,TECRL dehydrogenate TOD-CoA to ST-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10488902], \"dbId\": 548809, \"displayName\": \"TOD-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TOD-CoA\", \"trans-2-octadecenoyl-CoA(4-)\", \"trans-octadec-2-enoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-548809\", \"stIdVersion\": \"R-ALL-548809.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10488902], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10488902], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TECR,TECRL dehydrogenate TOD-CoA to ST-CoA\", \"(2E)-octadecenoyl-CoA + H(+) + NADPH => NADP(+) + octadecanoyl-CoA\", \"trans-octadec-2-enoyl-CoA + NADPH + H+ => stearoyl-CoA + NADP+\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 428139, \"displayName\": \"ST-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ST-CoA\", \"stearoyl-CoA(4-)\", \"stearyl-CoA\", \"stearoyl-CoA\"], \"producedByEvent\": [10488902], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428139\", \"stIdVersion\": \"R-ALL-428139.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [10488902], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10525796, \"displayName\": \"PTPLs dehydrate VLC3HA-CoA to VLCTDA-CoA\", \"followingEvent\": [10488902], \"isInDisease\": false, \"isInferred