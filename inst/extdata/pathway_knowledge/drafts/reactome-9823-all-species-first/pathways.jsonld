    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H2O [cytosol] + bile salts [cytosol] + ATP [cytosol] => bile salts [extracellular region] + Pi [cytosol] + H+ [cytosol] + ADP [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10470624], \"className\": \"CatalystActivity\", \"dbId\": 10470622, \"displayName\": \"ABC-type bile acid transporter activity of ABCB11 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10470624, \"displayName\": \"ABCB11 transports bile salts from cytosol to extracellular region\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10470624], \"dbId\": 193416, \"displayName\": \"bile salts [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-193416\", \"stIdVersion\": \"R-ALL-193416.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470624], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470624], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ABCB11 transports bile salts from cytosol to extracellular region\", \"ATP + glycocholate(in) + H2O = ADP + glycocholate(out) + H(+) + phosphate\", \"ATP + glycochenodeoxycholate(in) + H2O = ADP + glycochenodeoxycholate(out) + H(+) + phosphate\", \"ATP + H2O + taurocholate(in) = ADP + H(+) + phosphate + taurocholate(out)\", \"ATP + H2O + taurochenodeoxycholate(in) = ADP + H(+) + phosphate + taurochenodeoxycholate(out)\"], \"output\": [{\"className\": \"Set\", \"dbId\": 193479, \"displayName\": \"bile salts [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts\"], \"producedByEvent\": [10470624], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-193479\", \"stIdVersion\": \"R-ALL-193479.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [10470624], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [10470624], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [10470624], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10470955, \"displayName\": \"SLC10A1 co-transport bile salts and Na+ from extracellular region to cytosol\", \"followingEvent\": [10470624], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC10A1 co-transport bile salts and Na+ from extracellular region to cytosol\", \"NTCP takes up bile salts and Na+ into the liver\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-194121\", \"stIdVersion\": \"R-SSC-194121.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10470962, \"displayName\": \"Transport (influx) of bile salts and acids by OATP-A\", \"followingEvent\": [10470624], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Transport (influx) of bile salts and acids by OATP-A\", \"SLCO1A2 transports\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-194130\", \"stIdVersion\": \"R-SSC-194130.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10470943, \"displayName\": \"SLCO1B3 transports ALB:(GCCA, TCCA) from extracellular region to cytosol\", \"followingEvent\": [10470624], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLCO1B3 transports ALB:(GCCA, TCCA) from extracellular region to cytosol\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-194079\", \"stIdVersion\": \"R-SSC-194079.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10470948, \"displayName\": \"SLCO1B1 transports ALB:(GCCA,TCCA) from extracellular region to cytosol\", \"followingEvent\": [10470624], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLCO1B1 transports ALB:(GCCA,TCCA) from extracellular region to cytosol\", \"Transport (influx) of glycocholate and taurocholate by OATP-C\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-194083\", \"stIdVersion\": \"R-SSC-194083.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10464266, \"displayName\": \"Cytosolic chenodeoxycholoyl-CoA or choloyl-CoA are conjugated with glycine or taurine\", \"followingEvent\": [10470624], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cytosolic chenodeoxycholoyl-CoA or choloyl-CoA are conjugated with glycine or taurine\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-159431\", \"stIdVersion\": \"R-SSC-159431.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-193362\", \"stIdVersion\": \"R-SSC-193362.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
