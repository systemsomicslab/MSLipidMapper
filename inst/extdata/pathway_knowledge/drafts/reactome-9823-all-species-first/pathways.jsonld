        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10470886], \"className\": \"CatalystActivity\", \"dbId\": 10470405, \"displayName\": \"alcohol dehydrogenase (NADP+) activity of Aldo-keto reductase family [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10470886, \"displayName\": \"5Beta-cholestan-7alpha,12alpha,27-triol-3-one is reduced to 5beta-cholestan-3alpha,7alpha,12alpha,27-tetrol\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470886], \"dbId\": 193829, \"displayName\": \"5beta-cholestan-7alpha,12alpha,27-triol-3-one [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-7alpha,12alpha,27-triol-3-one\", \"7alpha,12alpha,26-trihydroxy-5beta-cholestan-3-one\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193829\", \"stIdVersion\": \"R-ALL-193829.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470886], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Com