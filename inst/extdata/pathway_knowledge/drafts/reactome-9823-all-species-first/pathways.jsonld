    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "O2 [endoplasmic reticulum lumen] + NADH [endoplasmic reticulum lumen] + DGL-CoA [endoplasmic reticulum lumen] => H2O [endoplasmic reticulum lumen] + NAD+ [endoplasmic reticulum lumen] + AA-CoA [endoplasmic reticulum lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10506771], \"className\": \"CatalystActivity\", \"dbId\": 10506764, \"displayName\": \"omega-6 fatty acid desaturase activity of FADS1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10506771, \"displayName\": \"Desaturation of dihomo-gamma-lenolenoyl-CoA to arachidonoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10506742], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10506771], \"dbId\": 2046045, \"displayName\": \"DGL-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DGL-CoA\", \"all-cis-icosa-8,11,14-trienoyl-CoA\", \"dihomo-gamma-linoloyl CoA\", \"8Z,11Z,14Z-eicosatrienoyl-CoA\", \"eicosatrienoyl CoA\", \"20:3(n-6)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046045\", \"stIdVersion\": \"R-ALL-2046045.4\"}, {\"classNam