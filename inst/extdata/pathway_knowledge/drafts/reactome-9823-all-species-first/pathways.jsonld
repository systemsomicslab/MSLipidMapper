    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "4CHOL7a,27DONE [endoplasmic reticulum membrane] + H+ [cytosol] + NADPH [cytosol] + O2 [cytosol] => 4CHOL7a,12a,27TONE [endoplasmic reticulum membrane] + H2O [cytosol] + NADP+ [cytosol]"
