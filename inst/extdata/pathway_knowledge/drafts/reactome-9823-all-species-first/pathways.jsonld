    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10558322], \"className\": \"CatalystActivity\", \"dbId\": 10500916, \"displayName\": \"alpha-galactosidase activity of GLA dimer [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 10558322, \"displayName\": \"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10558322], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10558322], \"dbId\": 10558320, \"displayName\": \"PSAP(195-273):Gal2Cer:PE [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PSAP(195-273):Gal2Cer:PE\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9841186\", \"stIdVersion\": \"R-SSC-9841186.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GLA hydrolyzes PSAP(195-273):Gal2Cer:PE\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605637, \"displayName\": \"Gal [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Gal\", \"alpha-D-galactose\"], \"producedByEvent\": [10558322], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605637\", \"stIdVersion\": \"R-ALL-1605637.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1606573, \"displayName\": \"GalCer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GalCer\", \"galactosylceramide\", \"D-galactosyl-N-acylsphingosine\", \"N-acyl-beta-D-galactosylsphingosine\", \"Galactocerebroside\", \"Galactosylceramide\"], \"producedByEvent\": [10558322], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1606573\", \"stIdVersion\": \"R-ALL-1606573.5\"}, {\"className\": \"Complex\", \"dbId\": 10500828, \"displayName\": \"PSAP(195-273) dimer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PSAP(195-273) dimer\"], \"producedByEvent\": [10558322], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9840482\", \"stIdVersion\": \"R-SSC-9840482.1\"}, {\"className\": \"Set\", \"dbId\": 9840939, \"displayName\": \"PE 30,32,34 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PE 30,32,34\"], \"producedByEvent\": [10558322], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9840939\", \"stIdVersion\": \"R-ALL-9840939.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10558291, \"displayName\": \"PSAP(195-273) dimer:PE binds and mobilizes ligands\", \"followingEvent\": [10558322], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PSAP(195-273) dimer:PE binds and mobilizes ligands\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9840470\", \"stIdVersion\": \"R-SSC-9840470.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9841189\", \"stIdVersion\": \"R-SSC-9841189.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
