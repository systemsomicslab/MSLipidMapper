      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10500875], \"className\": \"CatalystActivity\", \"dbId\": 10500873, \"displayName\": \"sphingolipid activator protein activity of GM2A(32-193) [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}, {\"accession\": \"0097488\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 3828048, \"definition\": \"The lipid bilayer surrounding a multivesicular body internal vesicle.\", \"displayName\": \"multivesicular body, internal vesicle membrane\", \"name\": \"multivesicular body, internal vesicle membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0097488\"}], \"dbId\": 10500875, \"displayName\": \"GM2A binds and mobilizes ligands\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10500822], \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10500875], \"dbId\": 10500787, \"displayName\": \"GM2A [lysosomal lumen]\", \"endCoordinate\": 193, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GM2A\", \"GM2A(32-193)\", \"A0A5G2QVV6\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1605614\", \"stIdVersion\": \"R-SSC-1605614.1\", \"startCoordinate\": 32}, {\"className\": \"Set\", \"consumedByEvent\": [10500875], \"dbId\": 9840941, \"displayName\": \"GM2A ligands [multivesicular body, internal vesicle membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GM2A ligands\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9840941\", \"stIdVersion\": \"R-ALL-9840941.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GM2A binds and mobilizes ligands\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10500872, \"displayName\": \"GM2A:Ligands [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"GM2A:Ligands\"], \"producedByEvent\": [10500875], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9840631\", \"stIdVersion\": \"R-SSC-9840631.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10500822, \"displayName\": \"bHEXA hydrolyzes GM2A:GM2 to GM2A:GM3\", \"followingEvent\": [10500875], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"bHEXA hydrolyzes GM2A:GM2 to GM2A:GM3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1605595\", \"stIdVersion\": \"R-SSC-1605595.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10558316, \"displayName\": \"bHEXA,bHEXS hydrolyze GM2A:SM2\", \"followingEvent\": [10500875], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"bHEXA,bHEXS hydrolyze GM2A:SM2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9840884\", \"stIdVersion\": \"R-SSC-9840884.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1605717\", \"stIdVersion\": \"R-SSC-1605717.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
