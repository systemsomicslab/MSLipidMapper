    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ACSBG1,2 ligates CoA-SH to VLCFA, forming VLCFA-CoA"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/curationStatus": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/Draft"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/directionality": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "CoA-SH [cytosol] + VLCFA [cytosol] + ATP [cytosol] => VLCFA-CoA [cytosol] + AMP [cytosol] + PPi [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10529624], \"className\": \"CatalystActivity\", \"dbId\": 10529622, \"displayName\": \"very long-chain fatty acid-CoA ligase activity of ACSBG1,2 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10529624, \"displayName\": \"ACSBG1,2 ligates CoA-SH to VLCFA, forming VLCFA-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10529624], \"dbId\": 5695985, \"displayName\": \"VLCFA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"VLCFA\", \"very long-chain fatty acid anion\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5695985\", \"stIdVersion\": \"R-ALL-5695985.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10529624], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10529624], \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACSBG1,2 ligates CoA-SH to VLCFA, forming VLCFA-CoA\", \"a very long-chain fatty acid + ATP + CoA => a very long-chain fatty acyl-CoA + AMP + diphosphate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 5695971, \"displayName\": \"VLCFA-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"VLCFA-CoA\", \"very long-chain fatty acyl-CoA(4-)\"], \"producedByEvent\": [10529624], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5695971\", \"stIdVersion\": \"R-ALL-5695971.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76577, \"displayName\": \"AMP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AMP\", \"adenosine 5'-monophosphate(2-)\", \"adenosine 5'-monophosphate\", \"Adenylic acid\", \"Adenylate\", \"5'-AMP\", \"5'-Adenylic acid\", \"5'-Adenosine monophosphate\"], \"producedByEvent\": [10529624], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76577\", \"stIdVersion\": \"R-ALL-76577.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111294, \"displayName\": \"PPi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [10529624], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111294\", \"stIdVersion\": \"R-ALL-111294.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-5695957\", \"stIdVersion\": \"R-SSC-5695957.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
