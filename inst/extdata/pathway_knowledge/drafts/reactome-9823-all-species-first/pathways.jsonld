    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10502098], \"className\": \"CatalystActivity\", \"dbId\": 10502096, \"displayName\": \"phosphatidylinositol-3,5-bisphosphate 5-phosphatase activity of PIKFYVE:VAC14:FIG4 [early endosome membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0031901\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 171062, \"definition\": \"The lipid bilayer surrounding an early endosome.\", \"displayName\": \"early endosome membrane\", \"name\": \"early endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031901\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10502098, \"displayName\": \"PI(3,5)P2 is dephosphorylated to PI3P by FIG4 at the early endosome membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10502059], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10502098], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10502098], \"dbId\": 1806205, \"displayName\": \"PI(3,5)P2 [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2\", \"1-phosphatidyl-1D-myo-inositol 3,5-bisphosphate(5-)\", \"1-phosphatidyl-1D-myo-inositol 3,5-bisphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806205\", \"stIdVersion\": \"R-ALL-1806205.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,5)P2 is dephosphorylated to PI3P by FIG4 at the early endosome membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1806200, \"displayName\": \"PI3P [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI3P\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate(3-)\", \"PtdIns3P\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate\"], \"producedByEvent\": [10502098], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806200\", \"stIdVersion\": \"R-ALL-1806200.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [10502098], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1676174\", \"stIdVersion\": \"R-SSC-1676174.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
