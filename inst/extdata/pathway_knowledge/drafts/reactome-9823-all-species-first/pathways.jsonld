      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H2O [cytosol] + PE [endoplasmic reticulum membrane] => LCFA(-) [endoplasmic reticulum membrane] + 2-acyl LPE [endoplasmic reticulum membrane]"
      }
    ],
