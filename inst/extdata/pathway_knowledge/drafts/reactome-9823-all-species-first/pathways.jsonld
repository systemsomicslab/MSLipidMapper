        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10550875], \"className\": \"CatalystActivity\", \"dbId\": 10550866, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen of ALOX5 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10550875, \"displayName\": \"ALOX5 oxidises 18(R)-HEPE to 5(S)-Hp-18(R)-HEPE\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10550887], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10550875], \"dbId\": 9023651, \"displayName\": \"18(R)-HEPE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"18(R)-HEPE\", \"18(R)-HEPE(1-)\", \"18(R)-hydroxyeicosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9023651\", \"stIdVersion\": \"R-ALL-9023651.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10550875], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 oxidises 18(R)-HEPE to 5(S)-Hp-18(R)-HEPE\", \"(18R)-hydroxy-(5Z,8Z,11Z,14Z,16E)-eicosapentaenoate + O2 => (5S)-hydroperoxy-(18R)-hydroxy-(6E,8Z,11Z,14Z,16E)-eicosapentaenoate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9023702, \"displayName\": \"5(S)-Hp-18(R)-HEPE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5(S)-Hp-18(R)-HEPE\", \"5(S)-hydroperoxy-18(R)-hydroxy-(6E,8Z,11Z,14Z,16E)-icosapentaenoate\", \"5(S)-Hp-18(R)-HEPE(1-)\", \"5(S)-hydroperoxy-18(R)-hydroxy-(6E,8Z,11Z,14Z,16E)-icosapentaenoic acid\"], \"producedByEvent\": [10550875], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9023702\", \"stIdVersion\": \"R-ALL-9023702.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10550889, \"displayName\": \"GPX4-2 reduces 18(R)-HpEPE to 18(R)-HEPE\", \"followingEvent\": [10550875], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GPX4-2 reduces 18(R)-HpEPE to 18(R)-HEPE\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9018895\", \"stIdVersion\": \"R-SSC-9018895.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9018863\", \"stIdVersion\": \"R-SSC-9018863.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
