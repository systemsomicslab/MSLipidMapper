        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10539517], \"className\": \"CatalystActivity\", \"dbId\": 10539515, \"displayName\": \"fatty-acyl-CoA binding activity of ACBD5,(ACBD4) [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005778\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17947, \"definition\": \"The lipid bilayer surrounding a peroxisome.\", \"displayName\": \"peroxisomal membrane\", \"name\": \"peroxisomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005778\"}, {\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10539517, \"displayName\": \"ACBD4,5 bind MCFA-CoA and LCFA-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10539517], \"dbId\": 10539512, \"displayName\": \"ACBD5,(ACBD4) [peroxisomal membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"ACBD5,(ACBD4)\"], \"schemaClass\": \"CandidateSet\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8848234\", \"stIdVersion\": \"R-SSC-8848234.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10539517], \"dbId\": 5690520, \"displayName\": \"MCFA-CoA, LCFA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"MCFA-CoA, LCFA-CoA\", \