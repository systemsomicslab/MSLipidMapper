      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10470962], \"className\": \"CatalystActivity\", \"dbId\": 10470960, \"displayName\": \"bile acid transmembrane transporter activity of SLCO1A2 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10470962, \"displayName\": \"Transport (influx) of bile salts and acids by OATP-A\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10470962], \"dbId\": 192483, \"displayName\": \"bile salts and acids [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts and acids\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-192483\", \"stIdVersion\": \"R-ALL-192483.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Transport (influx) of bile salts and acids by OATP-A\", \"SLCO1A2 transports\"], \"output\": [{\"className\": \"Set\", \"dbId\": 194156, \"displayName\": \"bile salts and acids [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts and acids\"], \"producedByEvent\": [10470962], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-194156\", \"stIdVersion\": \"R-ALL-194156.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10470969, \"displayName\": \"ABCC3 transports bile salts from cytosol to extracellular region\", \"followingEvent\": [10470962], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ABCC3 transports bile salts from cytosol to extracellular region\", \"Efflux of bile salts from enterocytes to portal system by MRP3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-194153\", \"stIdVersion\": \"R-SSC-194153.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-194130\", \"stIdVersion\": \"R-SSC-194130.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
