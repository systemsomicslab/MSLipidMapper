    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10543766], \"className\": \"CatalystActivity\", \"dbId\": 10543764, \"displayName\": \"lipid carrier activity of STARD10:LPCAT1:PC [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0097232\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 2133233, \"definition\": \"The lipid bilayer surrounding a lamellar body. A lamellar body is a membrane-bounded organelle, specialized for the storage and secretion of various substances (surfactant phospholipids, glycoproteins and acid phosphates) which are arranged in the form of tightly packed, concentric, membrane sheets or lamellae. Has some similar properties to, but is distinct from, a lysosome.\", \"displayName\": \"lamellar body membrane\", \"name\": \"lamellar body membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0097232\"}], \"dbId\": 10543766, \"displayName\": \"STARD10 transports PC from ER membrane to lamellar body membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10543766], \"dbId\": 10543761, \"displayName\": \"STARD10:LPCAT1:PC [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"STARD10:LPCAT1:PC\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8873921\", \"stIdVersion\": \"R-SSC-8873921.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD10 transports PC from ER membrane to lamellar body membrane\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10543763, \"displayName\": \"STARD10:PC [lamellar body membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"STARD10:PC\"], \"producedByEvent\": [10543766], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8873863\", \"stIdVersion\": \"R-SSC-8873863.1\"}, {\"className\": \"Protein\", \"dbId\": 10459421, \"displayName\": \"LPCAT1 [endoplasmic reticulum membrane]\", \"endCoordinate\": 534, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LPCAT1\", \"LPCAT1\", \"F1S029\"], \"producedByEvent\": [10543766], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1498772\", \"stIdVersion\": \"R-SSC-1498772.1\", \"startCoordinate\": 1}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8873834\", \"stIdVersion\": \"R-SSC-8873834.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
