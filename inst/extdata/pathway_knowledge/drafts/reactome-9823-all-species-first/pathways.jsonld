        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10470601], \"className\": \"CatalystActivity\", \"dbId\": 10470599, \"displayName\": \"steroid 17-alpha-monooxygenase activity of CYP17A1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10470601, \"displayName\": \"CYP17A1 17-hydroxylates PREG\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10470603], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470601], \"dbId\": 193103, \"displayName\": \"PREG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PREG\", \"pregnenolone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193103\", \"stIdVersion\": \"R-ALL-193103.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470601], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\"