      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10543199], \"className\": \"CatalystActivity\", \"dbId\": 10543197, \"displayName\": \"glycerophospholipid phospholipase A1 activity of PLA1A [extracellular region]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}, {\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10543199, \"displayName\": \"PLA1A hydrolyses PS to 2-acyl LPS\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10543199], \"dbId\": 109276, \"displayName\": \"H2O [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109276\", \"stIdVersion\": \"R-ALL-109276.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10543199], \"dbId\": 33625, \"displayName\": \"PS [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PS\", \"3-sn-phosphatidyl-L-serine\", \"Phosphatidylserine\", \"phosphatidyl-L-serine\", \"1,2-Diacyl-sn-glycerol 3-phospho-L-serine\", \"3-O-sn-Phosphatidyl-L-serine\", \"O3-Phosphatidyl-L-serine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-33625\", \"stIdVersion\": \"R-ALL-33625.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLA1A hydrolyses PS to 2-acyl LPS\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8869427, \"displayName\": \"2-acyl LPS [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2-acyl LPS\", \"2-acyl-sn-glycero-3-phosphoserine\", \"2-acyl lysophosphatidylserine\"], \"producedByEvent\": [10543199], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8869427\", \"stIdVersion\": \"R-ALL-8869427.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1602366, \"displayName\": \"LCFA(-) [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [10543199], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1602366\", \"stIdVersion\": \"R-ALL-1602366.4\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-8869425\", \"stIdVersion\": \"R-SSC-8869425.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
