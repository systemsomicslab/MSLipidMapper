        "@value": "PIP4P1 [late endosome membrane] => PIP4P1 [nucleoplasm]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0031902\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 172574, \"definition\": \"The lipid bilayer surrounding a late endosome.\", \"displayName\": \"late endosome membrane\", \"name\": \"late endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031902\"}, {\"accession\": \"0005635\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13231, \"definition\": \"The double lipid bilayer that encloses the nucleus, separating its contents from the cytoplasm. It consists of an inner and outer nuclear membrane, with an intermembrane space (20-40 nm wide, also called the perinuclear space) between them. The envelope is supported by the nuclear lamina and contains nuclear pore complexes, which regulate molecular transport.\", \"displayName\": \"nuclear envelope\", \"name\": \"nuclear envelope\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005635\"}], \"dbId\": 10538374, \"displayName\": \"TMEM55B translocates to the nucleus\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10538377], \"goBiologicalProcess\": {\"accession\": \"0051170\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 160267, \"definition\": \"The directed movement of substances into the nucleus.\", \"displayName\": \"import into nucleus\", \"name\": \"import into nucleus\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0051170\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10538374], \"dbId\": 10538370, \"displayName\": \"PIP4P1 [late endosome membrane]\", \"endCoordinate\": 277, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PIP4P1\", \"TMEM55B\", \"A0A286ZUJ8\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-6810395\", \"stIdVersion\": \"R-SSC-6810395.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TMEM55B translocates to the nucleus\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 10538372, \"displayName\": \"PIP4P1 [nucleoplasm]\", \"endCoordinate\": 277, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PIP4P1\", \"TMEM55B\", \"A0A286ZUJ8\"], \"producedByEvent\": [10538374], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-6810405\", \"stIdVersion\": \"R-SSC-6810405.1\", \"startCoordinate\": 1}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-6810392\", \"stIdVersion\": \"R-SSC-6810392.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
