    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "UDP-Gal [Golgi lumen] + LacCer-d18 [Golgi membrane] => Gb3Cer [Golgi membrane] + H+ [Golgi lumen] + UDP [Golgi lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10558993], \"className\": \"CatalystActivity\", \"dbId\": 10558991, \"displayName\": \"lactosylceramide 4-alpha-galactosyltransferase activity of A4GALT [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}], \"dbId\": 10558993, \"displayName\": \"A4GALT transfers galactose to LacCer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10558993], \"dbId\": 9844874, \"displayName\": \"LacCer-d18 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LacCer-d18\", \"beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1)-N-acylsphingosine\", \"Lactosylceramide\", \"beta-D-Galactosyl-1,4-beta-D-glucosylceramide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9844874\", \"stIdVersion\": \"R-ALL-9844874.2\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10558993], \"dbId\": 735682, \"displayName\": \"UDP-Gal [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP-Gal\", \"UDP-alpha-D-galactose(2-)\", \"UDPgalactose\", \"UDP-D-galactose\", \"UDP-D-galactopyranose\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-735682\", \"stIdVersion\": \"R-ALL-735682.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"A4GALT transfers galactose to LacCer\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8879102, \"displayName\": \"Gb3Cer [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Gb3Cer\", \"alpha-D-galactosyl-(1->4)-beta-D-galactosyl-(1->4)-beta-D-glucosylceramide\", \"Globotriaosylceramide\", \"alpha-D-galactosyl-(1->4)-beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1)-ceramide\"], \"producedByEvent\": [10558993], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8879102\", \"stIdVersion\": \"R-ALL-8879102.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 205687, \"displayName\": \"UDP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP\", \"UDP(3-)\", \"uridine 5'-diphosphate\"], \"producedByEvent\": [10558993], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-205687\", \"stIdVersion\": \"R-ALL-205687.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10558993], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10559003, \"displayName\": \"B4GALT5/6 transfer Gal to GlcCer\", \"followingEvent\": [10558993], \"isInDisease\": false, \"isI