    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10499396], \"className\": \"CatalystActivity\", \"dbId\": 10499351, \"displayName\": \"A2-type glycerophospholipase activity of PLA2(6) [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10499396, \"displayName\": \"PE is hydrolyzed to 1-acyl LPE by PLA2[3]\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10499396], \"dbId\": 1500581, \"displayName\": \"PE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PE\", \"phosphatidylethanolamine zwitterion\", \"phosphatidylethanolamine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500581\", \"stIdVersion\": \"R-ALL-1500581.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10499396], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PE is hydrolyzed to 1-acyl LPE by PLA2[3]\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1498738, \"displayName\": \"1-acyl LPE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPE\", \"1-acyl-sn-glycero-3-phosphoethanolamine\", \"1-acyl lysophosphatidylethanolamine\", \"L-2-Lysophosphatidylethanolamine\"], \"producedByEvent\": [10499396], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498738\", \"stIdVersion\": \"R-ALL-1498738.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524021, \"displayName\": \"LCFA(-) [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [10499396], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524021\", \"stIdVersion\": \"R-ALL-1524021.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10499272, \"displayName\": \"1-acyl LPE is acylated to PE by LPEAT\", \"followingEvent\": [10499396], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1-acyl LPE is acylated to PE by LPEAT\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1482667\", \"stIdVersion\": \"R-SSC-1482667.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10499252, \"displayName\": \"2-acyl LPE is acylated to PE by LPEAT\", \"followingEvent\": [10499396], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-acyl LPE is acylated to PE by LPEAT\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1482646\", \"stIdVersion\": \"R-SSC-1482646.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10499443, \"displayName\": \"CDP-ETA and DAG are converted to PE by CEPT1/EPT1\", \"followingEvent\": [10499396], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CDP-ETA and DAG are converted to PE by CEPT1/EPT1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1482962\", \"stIdVersion\": \"R-SSC-1482962.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1482887\", \"stIdVersion\": \"R-SSC-1482887.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
