        "@value": "H2O [lysosomal lumen] + PSAP(195-273):Sulfatide:PE [lysosomal lumen] => GalCer [lysosomal lumen] + SO4(2-) [lysosomal lumen] + H+ [lysosomal lumen] + PSAP(195-273) dimer [lysosomal lumen] + PE 30,32,34 [lysosomal lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10501037], \"className\": \"CatalystActivity\", \"dbId\": 10501035, \"displayName\": \"cerebroside-sulfatase activity of active ARSA:Ca2+ [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 10501037, \"displayName\": \"ARSA removes sulfate from PSAP(195-273):Sulfatide\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10500989], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10501037], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10501037], \"dbId\": 10501025, \"displayName\": \"PSAP(195-273):Sulfatide:PE [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PSAP(195-273):Sulfatide:PE\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9840996\", \"stIdVersion\": \"R-SSC-9840996.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ARSA removes sulfate from PSAP(195-273):Sulfatide\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1606573, \"displayName\": \"GalCer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GalCer\", \"galactosylceramide\", \"D-galactosyl-N-acylsphingosine\", \"N-acyl-beta-D-galactosylsphingosine\", \"Galactocerebroside\", \"Galactosylceramide\"], \"producedByEvent\": [10501037], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1606573\", \"stIdVersion\": \"R-ALL-1606573.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1606845, \"displayName\": \"SO4(2-) [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SO4(2-)\", \"sulfate\"], \"producedByEvent\": [10501037], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1606845\", \"stIdVersion\": \"R-ALL-1606845.3\"}, {\"className\": \"Complex\", \"dbId\": 10500828, \"displayName\": \"PSAP(195-273) dimer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PSAP(195-273) dimer\"], \"producedByEvent\": [10501037], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9840482\", \"stIdVersion\": \"R-SSC-9840482.1\"}, {\"className\": \"Set\", \"dbId\": 9840939, \"displayName\": \"PE 30,32,34 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PE 30,32,34\"], \"producedByEvent\": [10501037], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9840939\", \"stIdVersion\": \"R-ALL-9840939.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 428040, \"displayName\": \"H+ [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10501037], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428040\", \"stIdVersion\": \"R-ALL-428040.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10509818, \"displayName\": \"M6PR transports activated ARSA to the lysosome\", \"followingEvent\": [10501037], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"M6PR transports activated ARSA to the lysosome\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-2248891\", \"stIdVersion\": \"R-SSC-2248891.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10558291, \"displayName\": \"PSAP(195-273) dimer:PE binds and mobilizes ligands\", \"followingEvent\": [10501037], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PSAP(195-273) dimer:PE binds and mobilizes ligands\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9840470\", \"stIdVersion\": \"R-SSC-9840470.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1606807\", \"stIdVersion\": \"R-SSC-1606807.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
