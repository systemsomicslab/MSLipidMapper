    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + NADPH [cytosol] + O2 [cytosol] + AA [cytosol] => H2O [cytosol] + NADP+ [cytosol] + 11,12-EET [cytosol]"
