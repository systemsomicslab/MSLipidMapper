    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10499265], \"className\": \"CatalystActivity\", \"dbId\": 10499263, \"displayName\": \"acylglycerol O-acyltransferase activity of PNPLA2/3 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10499265, \"displayName\": \"2-MAG and DAG are transacylated to TAG by PNPLA2/3\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10499331], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10499265], \"dbId\": 1498728, \"displayName\": \"2-MAG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2-MAG\", \"2-monoglyceride\", \"2-monoacylglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498728\", \"stIdVersion\": \"R-ALL-1498728.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10499265], \"dbId\": 1500596, \"displayName\": \"DAG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DAG\", \"1,2-diacyl-sn-glycerol\", \"1,2-diacylglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500596\", \"stIdVersion\": \"R-ALL-1500596.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-MAG and DAG are transacylated to TAG by PNPLA2/3\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1500594, \"displayName\": \"TAG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TAG\", \"triglyceride\", \"triacylglycerol\"], \"producedByEvent\": [10499265], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500594\", \"stIdVersion\": \"R-ALL-1500594.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76116, \"displayName\": \"Glycerol [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Glycerol\"], \"producedByEvent\": [10499265], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76116\", \"stIdVersion\": \"R-ALL-76116.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10499267, \"displayName\": \"2-MAG is transacylated to DAG by PNPLA2/3\", \"followingEvent\": [10499265], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-MAG is transacylated to DAG by PNPLA2/3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1482654\", \"stIdVersion\": \"R-SSC-1482654.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10499344, \"displayName\": \"DAG is hydrolyzed to 2-MAG by PNPLA2/3\", \"followingEvent\": [10499265], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DAG is hydrolyzed to 2-MAG by PNPLA2/3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1482811\", \"stIdVersion\": \"R-SSC-1482811.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10499331, \"displayName\": \"TAG is hydrolyzed to DAG by PNPLA2/3\", \"followingEvent\": [10499265], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TAG is hydrolyzed to DAG by PNPLA2/3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1482777\", \"stIdVersion\": \"R-SSC-1482777.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1482647\", \"stIdVersion\": \"R-SSC-1482647.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
