    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "GM2A:SM2 [lysosomal lumen] + H2O [lysosomal lumen] => GalNAc [lysosomal lumen] + SM3 [lysosomal lumen] + GM2A [lysosomal lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10558316], \"className\": \"CatalystActivity\", \"dbId\": 10558314, \"displayName\": \"beta-N-acetylhexosaminidase activity of bHEXA,bHEXS [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 10558316, \"displayName\": \"bHEXA,bHEXS hydrolyze GM2A:SM2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10558318], \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10558316], \"dbId\": 10558309, \"displayName\": \"GM2A:SM2 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GM2A:SM2\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9840882\", \"stIdVersion\": \"R-SSC-9840882.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10558316], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"bHEXA,bHEXS hydrolyze GM2A:SM2\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605658, \"displayName\": \"GalNAc [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GalNAc\", \"N-acetyl-D-galactosamine\", \"N-acetylgalactosamine\"], \"producedByEvent\": [10558316], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605658\", \"stIdVersion\": \"R-ALL-1605658.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 9840879, \"displayName\": \"SM3 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SM3\", \"beta-D-3-sulfogalactosyl-(1->4)-beta-D-glucosyl-(1<->1')-ceramide(1-)\"], \"producedByEvent\": [10558316], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9840879\", \"stIdVersion\": \"R-ALL-9840879.1\"}, {\"className\": \"Protein\", \"dbId\": 10500787, \"displayName\": \"GM2A [lysosomal lumen]\", \"endCoordinate\": 193, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GM2A\", \"GM2A(32-193)\", \"A0A5G2QVV6\"], \"producedByEvent\": [10558316], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1605614\", \"stIdVersion\": \"R-SSC-1605614.1\", \"startCoordinate\": 32}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10500875, \"displayName\": \"GM2A binds and mobilizes ligands\", \"followingEvent\": [10558316], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GM2A binds and mobilizes ligands\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-1605717\", \"stIdVersion\": \"R-SSC-1605717.1\"}], \"regulatedBy\": [{\"className\": \"Requirement\", \"dbId\": 9840876, \"displayName\": \"Requirement by 'BMP [multivesicular body, internal vesicle membrane]'\", \"regulatedEntity\": [10558316], \"schemaClass\": \"Requirement\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9840884\", \"stIdVersion\": \"R-SSC-9840884.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
