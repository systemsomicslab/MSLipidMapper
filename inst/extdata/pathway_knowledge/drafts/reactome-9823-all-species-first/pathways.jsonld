    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + NADPH [cytosol] + 4CHOL7a,12aDONE [endoplasmic reticulum membrane] => NADP+ [cytosol] + 5beta-cholesten-7alpha, 12alpha-diol-3-one [cytosol]"
