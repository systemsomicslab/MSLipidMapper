        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10506781], \"className\": \"CatalystActivity\", \"dbId\": 10506747, \"displayName\": \"acyl-CoA 6-desaturase activity of FADS2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10506781, \"displayName\": \"Desaturation of tetracosatetraenoyl-CoA to tetracosapentaenoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10506781], \"dbId\": 2046048, \"displayName\": \"TTA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TTA-CoA\", \"(9Z,12Z,15Z,18Z)-tetracosatetraenoyl-CoA\", \"9Z,12Z,15Z,18Z-Tetracosatetraenoyl-CoA (TTA-CoA)\", \"Tetracosatetraenoyl-CoA\", \"24:4n-6\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046048\", \"stIdVersion\": \"R-ALL-2046048.4\"}, {\"className\": \"Chemical Compound\", \"consumedBy