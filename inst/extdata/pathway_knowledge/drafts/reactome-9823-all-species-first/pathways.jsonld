    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10506785], \"className\": \"CatalystActivity\", \"dbId\": 10506740, \"displayName\": \"fatty acid elongase activity of ELOVL5/ELOVL2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}], \"dbId\": 10506785, \"displayName\": \"Elongation of eicosapentaenoyl-CoA to docosapentaenoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10506785], \"dbId\": 2046059, \"displayName\": \"EPA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"EPA-CoA\", \"(5Z,8Z,11Z,14Z,17Z)-icosapentaenoyl-CoA\", \"5Z,8Z,11Z,14Z,17Z-eicosapentaenoyl-CoA\", \"5,8,11,14,17-20:5(n-3)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046059\", \"stIdVersion\": \"R-ALL-2046059.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10506785], \"dbId\": 2046066, \"displayName\": \"Malonyl-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Malonyl-CoA\", \"malonyl-CoA(5-)\", \"Malonyl coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046066\", \"stIdVersion\": \"R-ALL-2046066.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10506785, 10506785], \"dbId\": 113601, \"displayName\": \"NADPH [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113601\", \"stIdVersion\": \"R-ALL-113601.2\"}, 113601], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Elongation of eicosapentaenoyl-CoA to docosapentaenoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2046057, \"displayName\": \"DPA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DPA-CoA\", \"(7Z,10Z,13Z,16Z,19Z)-docosapentaenoyl-CoA\", \"7Z,10Z,13Z,16Z,19Z-docosapentaenoyl-CoA (DPA-CoA)\", \"docosapentaenoyl-CoA\", \"7,10,13,16,19-22:5(n-3)\"], \"producedByEvent\": [10506785], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046057\", \"stIdVersion\": \"R-ALL-2046057.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 159751, \"displayName\": \"CO2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CO2\", \"carbon dioxide\"], \"producedByEvent\": [10506785], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-159751\", \"stIdVersion\": \"R-ALL-159751.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 162743, \"displayName\": \"CoA-SH [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10506785], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-162743\", \"stIdVersion\": \"R-ALL-162743.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113519, \"displayName\": \"H2O [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10506785], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113519\", \"stIdVersion\": \"R-ALL-113519.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113564, \"displayName\": \"NADP+ [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(+)\", \"NADP\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [10506785, 10506785], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113564\", \"stIdVersion\": \"R-ALL-113564.4\"}, 113564], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10506766, \"displayName\": \"Desaturation of eicosatetraenoyl-CoA to eicosapentaenoyl-CoA\", \"followingEvent\": [10506785], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Desaturation of eicosatetraenoyl-CoA to eicosapentaenoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-2046089\", \"stIdVersion\": \"R-SSC-2046089.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-2046100\", \"stIdVersion\": \"R-SSC-2046100.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
