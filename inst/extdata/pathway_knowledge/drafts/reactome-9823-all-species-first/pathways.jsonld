        "@value": "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10555664, \"displayName\": \"Bile salts dissociate from FABP6\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0015721\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 24849, \"definition\": \"The directed movement of bile acid and bile salts into, out of or within a cell, or between cells, by means of some agent such as a transporter or pore.\", \"displayName\": \"bile acid and bile salt transport\", \"name\": \"bile acid and bile salt transport\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0015721\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10555664], \"dbId\": 10555662, \"displayName\": \"bile salts and acids:FABP6 [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"bile salts and acids:FABP6\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-194191\", \"stIdVersion\": \"R-SSC-194191.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Bile salts dissociate from FABP6\"], \"output\": [{\"className\": \"Set\", \"dbId\": 194156, \"displayName\": \"bile salts and acids [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts and acids\"], \"producedByEvent\": [10555664], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-194156\", \"stIdVersion\": \"R-ALL-194156.2\"}, {\"className\": \"Protein\", \"dbId\": 10519764, \"displayName\": \"FABP6 [cytosol]\", \"endCoordinate\": 128, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FABP6\", \"FABP6\", \"F1RR40\"], \"producedByEvent\": [10555664], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-194158\", \"stIdVersion\": \"R-SSC-194158.1\", \"startCoordinate\": 2}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10555666, \"displayName\": \"Bile salts bind FABP6\", \"followingEvent\": [10555664], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Bile salts bind FABP6\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9733973\", \"stIdVersion\": \"R-SSC-9733973.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9733969\", \"stIdVersion\": \"R-SSC-9733969.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
