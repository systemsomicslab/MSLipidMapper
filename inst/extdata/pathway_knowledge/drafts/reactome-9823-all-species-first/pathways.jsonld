        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10470135], \"className\": \"CatalystActivity\", \"dbId\": 10470133, \"displayName\": \"mevalonate kinase activity of MVK dimer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10470135, \"displayName\": \"Mevalonate is phosphorylated to mevalonate-5-phosphate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10470171], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470135], \"dbId\": 191424, \"displayName\": \"MVA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MVA\", \"(R)-mevalonate\", \"Mevalonate\", \"(R)-mevalonic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191424\", \"stIdVersion\": \"R-ALL-191424.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470135], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Mevalonate is phosphorylated to mevalonate-5-phosphate\", \"(R)-m