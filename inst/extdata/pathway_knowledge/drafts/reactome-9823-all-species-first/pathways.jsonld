        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10470155], \"className\": \"CatalystActivity\", \"dbId\": 10470151, \"displayName\": \"squalene synthase [NAD(P)H] activity of FDFT:Mg2+ [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10470155, \"displayName\": \"Two FAPP molecules dimerize to form presqualene diphosphate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10470153], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470155, 10470155], \"dbId\": 191385, \"displayName\": \"FAPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FAPP\", \"2-trans,6-trans-farnesyl diphosphate(3-)\", \"Farnesyl pyrophosphate\", \"2-trans,6-trans-farnesyl diphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191385\", \"stIdVersion\": \"R-ALL-191385.4\"}, 191385], \"isInDisease\": false, 