        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10554538, \"displayName\": \"CYP19A1 binds Aromatase inhibitors\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10554538], \"dbId\": 10470573, \"displayName\": \"Homologues of CYP19A1 [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Homologues of CYP19A1\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-193137-3\", \"stIdVersion\": \"R-SSC-193137-3.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10554538], \"dbId\": 9707314, \"displayName\": \"Aromatase inhibitors [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Aromatase inhibitors\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9707314\", \"stIdVersion\": \"R-ALL-9707314.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP19A1 binds Aromatase inhibitors\"], \"output\": [{\"