  {
    "@id": "https://reactome.org/content/detail/R-SSC-2046093",
    "@type": [
      "https://systemomicslab.github.io/MSLipidMapper/ontology/LipidReaction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Translocation of tetracosapentaenoyl-CoA to peroxisomes"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/curationStatus": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/Draft"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/directionality": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "TPA-CoA [endoplasmic reticulum lumen] + ATP [endoplasmic reticulum membrane] => TPA-CoA [peroxisomal matrix] + ADP [endoplasmic reticulum membrane] + Pi [endoplasmic reticulum membrane]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10506773], \"className\": \"CatalystActivity\", \"dbId\": 10506755, \"displayName\": \"long-chain fatty acid transmembrane transporter activity of ABCD1 [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}, {\"accession\": \"0005778\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17947, \"definition\": \"The lipid bilayer surrounding a peroxisome.\", \"displayName\": \"peroxisomal membrane\", \"name\": \"peroxisomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005778\"}, {\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10506773, \"displayName\": \"Translocation of tetracosapentaenoyl-CoA to peroxisomes\"