    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10482385], \"className\": \"CatalystActivity\", \"dbId\": 10482383, \"displayName\": \"transcription corepressor activity of Corepressors of PPARalpha [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10482385, \"displayName\": \"PPARA:RXRA binds Corepressors of PPARA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0060633\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 422887, \"definition\": \"Any process that decreases the rate, frequency or extent of a process involved in starting transcription from an RNA polymerase II promoter.\", \"displayName\": \"negative regulation of transcription initiation by RNA polymerase II\", \"name\": \"negative regulation of transcription initiation by RNA polymerase II\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0060633\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10482385], \"dbId\": 10482358, \"displayName\": \"Corepressors of PPARalpha [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Corepressors of PPARalpha\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-400207\", \"stIdVersion\": \"R-SSC-400207.1\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10482385], \"dbId\": 10482360, \"displayName\": \"PPARA:RXRA heterodimer [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PPARA:RXRA heterodimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-400138\", \"stIdVersion\": \"R-SSC-400138.1\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10482385], \"dbId\": 10476997, \"displayName\": \"TBL1X [nucleoplasm]\", \"endCoordinate\": 577, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TBL1X\", \"TBL1X\", \"A0A5K1UVB9\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-351644\", \"stIdVersion\": \"R-SSC-351644.1\", \"startCoordinate\": 1}, {\"className\": \"Protein\", \"consumedByEvent\": [10482385], \"dbId\": 10477001, \"displayName\": \"TBL1XR1 [nucleoplasm]\", \"endCoordinate\": 514, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TBL1XR1\", \"TBL1XR1\", \"A0A4X1V5G1\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-351643\", \"stIdVersion\": \"R-SSC-351643.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA:RXRA binds Corepressors of PPARA\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10482362, \"displayName\": \"PPARA:RXRA:Corepressors [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PPARA:RXRA:Corepressors\"], \"producedByEvent\": [10482385], \"schemaClass\": \"Complex\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-400196\", \"stIdVersion\": \"R-SSC-400196.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10482388, \"displayName\": \"PPARA binds RXRA\", \"followingEvent\": [10482385], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA binds RXRA\", \"PPARA binds RXRA forming PPARA:RXRA heterodimer at promoter of target gene\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-400204\", \"stIdVersion\": \"R-SSC-400204.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10555672, \"displayName\": \"PPARA binds fibrates\", \"followingEvent\": [10482385], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA binds fibrates\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-9734475\", \"stIdVersion\": \"R-SSC-9734475.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"SSC\", \"className\": \"Species\", \"dbId\": 49633, \"displayName\": \"Sus scrofa\", \"name\": [\"Sus scrofa\", \"pig\", \"swine\"], \"schemaClass\": \"Species\", \"taxId\": \"9823\"}], \"speciesName\": \"Sus scrofa\", \"stId\": \"R-SSC-400183\", \"stIdVersion\": \"R-SSC-400183.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
