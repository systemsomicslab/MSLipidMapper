        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10470650], \"className\": \"CatalystActivity\", \"dbId\": 10470460, \"displayName\": \"ATPase-coupled transmembrane transporter activity of ABCD3 dimer [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005778\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17947, \"definition\": \"The lipid bilayer surrounding a peroxisome.\", \"displayName\": \"peroxisomal membrane\", \"name\": \"peroxisomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005778\"}], \"dbId\": 10470650, \"displayName\": \"25(R) DHCA-CoA is translocated from the cytosol to the peroxisome\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0015919\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 25870, \"definition\": \"The directed movement of substances to, from or across the peroxisomal membrane.\", \"displayName\": \"peroxisomal membrane transport\", \"name\": \"peroxisomal membrane transport\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0015919\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470650], \"dbId\": 193457, \"displayName\": \"25(R) DHCA-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(R) DHCA-CoA\", \"3alpha,7alpha-dihydroxy-5beta-cholestan-26-oyl-CoA\", \"3alpha,7alpha-Dihydroxy-5beta-cholestanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193457\", \"stIdVersion\": \"R-ALL-193457.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470650], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10470650], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"25(R) DHCA-CoA is translocated from the cytosol to the peroxisome\", \"25(R) DHCA-CoA [ cytosol] => 25(R) DHCA-CoA [peroxisome]\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193429, \"displayName\": \"25(R) DHCA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(R) DHCA-CoA\", \"3alpha,7alpha-dihydroxy-5beta-cholestan-26-oyl-CoA\", \"3alpha,7alpha-Dihydroxy-5beta-cholestanoyl-CoA\"], \"producedByEvent\": [10470650], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193429\", \"stIdVersion\": \"R-ALL-193429.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [10470650], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [10470650], \"referenceTy