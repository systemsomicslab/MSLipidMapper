    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "(S)-3-Hydroxydodecanoyl-CoA [mitochondrial matrix] + NAD+ [mitochondrial matrix] => H+ [mitochondrial matrix] + NADH [mitochondrial matrix] + 3-Oxododecanoyl-CoA [mitochondrial matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10459931], \"className\": \"CatalystActivity\", \"dbId\": 10459929, \"displayName\": \"(3S)-3-hydroxyacyl-CoA dehydrogenase (NAD+) activity of HADH dimer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10459931, \"displayName\": \"(S)-3-Hydroxydodecanoyl-CoA+NAD => 3-Oxododecanoyl-CoA+NADH+H\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10459980], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10459931], \"dbId\": 113526, \"displayName\": \"NAD+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\", \"NAD+ \"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113526\", \"stIdVersion\": \"R-ALL-113526.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10459931], \"dbId\": 77252, \"displayName\": \"(S)-3-Hydroxydodecanoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(S)-3-Hydroxydodecanoyl-CoA\", \"(S)-3-hydroxylauroyl-CoA(4-)\", \"(S)-3-hydroxylauroyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77252\", \"stIdVersion\": \"R-ALL-77252.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"(S)-3-Hydroxydodecanoyl-CoA+NAD => 3-Oxododecanoyl-CoA+NADH+H\", \"(3S)-3-hydroxydodecanoyl-CoA + NAD(+) => 3-oxododecanoyl-CoA + NADH + H(+)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29362, \"displayName\": \"NADH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [10459931], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29362\", \"stIdVersion\": \"R-ALL-29362.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10459931], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 77253, \"displayName\": \"3-Oxododecanoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3-Oxododecanoyl-CoA\", \"3-oxolauroyl-CoA(4-)\", \"3-oxolauroyl-CoA\"], \"producedByEvent\": [10459931], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77253\", \"stIdVersion\": \"R-ALL-77253.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10459933, \"displayName\": \"2-trans-Dodecenoyl-CoA+H2O =>( S)-3-Hydroxydodecanoyl-CoA\", \"followingEvent\": [10459931], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-trans-Dodecenoyl-CoA+H2O =>( S)-3-Hydroxydodecanoyl-CoA\", \"2E)-dodecenoyl-CoA + H2O => (3S)-3-hydroxydodecanoyl-CoA\"], \"releaseDate\": \"202