        "@value": "STARD3:STARD3NL, STARD4,6:CHOL [cytosol] => STARD3:STARD3NL, STARD4,6 [cytosol] + CHOL [mitochondrial inner membrane]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10356467], \"className\": \"CatalystActivity\", \"dbId\": 10356465, \"displayName\": \"molecular carrier activity of STAR [mitochondrial intermembrane space]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005741\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17906, \"definition\": \"The outer, i.e. cytoplasm-facing, lipid bilayer of the mitochondrial envelope.\", \"displayName\": \"mitochondrial outer membrane\", \"name\": \"mitochondrial outer membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005741\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005758\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17927, \"definition\": \"The region between the inner and outer lipid bilayers of the mitochondrial envelope.\", \"displayName\": \"mitochondrial intermembrane space\", \"name\": \"mitochondrial intermembrane space\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005758\"}], \"dbId\": 10356467, \"displayName\": \"STAR mediates CHOL translocation from cytosol to mitochondrial intermembrane space\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10356467], \"dbId\": 10356460, \"displayName\": \"STARD3:STARD3NL, STARD4,6:CHOL [cytosol]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"STARD3:STARD3NL, STARD4,6:CHOL\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-196124\", \"stIdVersion\": \"R-BTA-196124.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STAR mediates CHOL translocation from cytosol to mitochondrial intermembrane space\", \"cholesterol(in) = cholesterol(out)\"], \"output\": [{\"className\": \"Set\", \"dbId\": 10356458, \"displayName\": \"STARD3:STARD3NL, STARD4,6 [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"STARD3:STARD3NL, STARD4,6\", \"StAR-related cholesterol-binding proteins\"], \"producedByEvent\": [10356467], \"schemaClass\": \"CandidateSet\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-196094\", \"stIdVersion\": \"R-BTA-196094.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193156, \"displayName\": \"CHOL [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CHOL\", \"cholesterol\"], \"producedByEvent\": [10356467], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193156\", \"stIdVersion\": \"R-ALL-193156.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-196126\", \"stIdVersion\": \"R-BTA-196126.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
