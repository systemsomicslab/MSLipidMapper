        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10355794], \"className\": \"CatalystActivity\", \"dbId\": 10355792, \"displayName\": \"ABC-type bile acid transporter activity of ABCB11 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10355794, \"displayName\": \"ABCB11 transports bile salts from cytosol to extracellular region\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10355794], \"dbId\": 193416, \"displayName\": \"bile salts [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-193416\", \"stIdVersion\": \"R-ALL-193416.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10355794], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10355794], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ABCB11 transports bile salts from cytosol to extracellular region\", \"ATP + glycocholate(in) + H2O = ADP + glycocholate(out) + H(+) + phosphate\", \"ATP + glycochenodeoxycholate(in) + H2O = ADP + glycochenodeoxycholate(out) + H(+) + phosphate\", \"ATP + H2O + taurocholate(in) = ADP + H(+) + phosphate + taurocholate(out)\", \"ATP + H2O + taurochenodeoxycholate(in) = ADP + H(+) + phosphate + taurochenodeoxycholate(out)\"], \"output\": [{\"className\": \"Set\", \"dbId\": 193479, \"displayName\": \"bile salts [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts\"], \"producedByEvent\": [10355794], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-193479\", \"stIdVersion\": \"R-ALL-193479.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [10355794], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [10355794], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [10355794], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\":