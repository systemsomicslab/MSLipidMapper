    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10415607], \"className\": \"CatalystActivity\", \"dbId\": 10415605, \"displayName\": \"very long-chain fatty acid-CoA ligase activity of ACSF3 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10415607, \"displayName\": \"ACSF3 ligates CoA-SH to VLCFA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10415607], \"dbId\": 5696008, \"displayName\": \"VLCFA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"VLCFA\", \"very long-chain fatty acid anion\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5696008\", \"stIdVersion\": \"R-ALL-5696008.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10415607], \"dbId\": 113593, \"displayName\": \"ATP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113593\", \"stIdVersion\": \"R-ALL-113593.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10415607], \"dbId\": 29374, \"displayName\": \"CoA-SH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"CoA\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29374\", \"stIdVersion\": \"R-ALL-29374.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACSF3 ligates CoA-SH to VLCFA\", \"a very long-chain fatty acid + ATP + CoA => a very long-chain fatty acyl-CoA + AMP + diphosphate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 5696003, \"displayName\": \"VLCFA-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"VLCFA-CoA\", \"very long-chain fatty acyl-CoA(4-)\"], \"producedByEvent\": [10415607], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5696003\", \"stIdVersion\": \"R-ALL-5696003.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 159448, \"displayName\": \"AMP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AMP\", \"adenosine 5'-monophosphate(2-)\", \"adenosine 5'-monophosphate\", \"Adenylic acid\", \"Adenylate\", \"5'-AMP\", \"5'-Adenylic acid\", \"5'-Adenosine monophosphate\"], \"producedByEvent\": [10415607], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-159448\", \"stIdVersion\": \"R-ALL-159448.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 159450, \"displayName\": \"PPi [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [10415607], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-159450\", \"stIdVersion\": \"R-ALL-159450.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-5696007\", \"stIdVersion\": \"R-BTA-5696007.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
