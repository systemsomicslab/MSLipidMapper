 \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 192114, \"displayName\": \"7 alpha-hydroxycholesterol [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7 alpha-hydroxycholesterol\", \"7alpha-hydroxycholesterol\"], \"producedByEvent\": [10355555], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192114\", \"stIdVersion\": \"R-ALL-192114.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10405707, \"displayName\": \"NR1H4 binds DCA, CDCA, LCHA\", \"followingEvent\": [10355555], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NR1H4 binds DCA, CDCA, LCHA\", \"FXR binds bile acids\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-5340195\", \"stIdVersion\": \"R-BTA-5340195.1\"}], \"regulatedBy\": [{\"className\": \"NegativeRegulation\", \"dbId\": 10355485, \"displayName\": \"Negative regulation by 'NCOA1,2:RXRA:NR1H4:DCA,CDCA,LCHA [nucleoplasm]'\", \"regulatedEntity\": [10355555], \"schemaClass\": \"NegativeRegulation\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-192051\", \"stIdVersion\": \"R-BTA-192051.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
