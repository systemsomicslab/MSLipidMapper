    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10345620], \"className\": \"CatalystActivity\", \"dbId\": 10345618, \"displayName\": \"acyl-CoA dehydrogenase activity of ACADVL dimer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10345620, \"displayName\": \"palmitoyl-CoA+FAD => trans-Hexadec-2-enoyl-CoA+FADH2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10345620], \"dbId\": 77281, \"displayName\": \"PalmCoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PalmCoA\", \"palmitoyl-CoA(4-)\", \"palmitoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77281\", \"stIdVersion\": \"R-ALL-77281.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10345620], \"dbId\": 113596, \"displayName\": \"FAD [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FAD\", \"FAD(3-)\", \"Flavin adenine dinucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113596\", \"stIdVersion\": \"R-ALL-113596.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10345620], \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"palmitoyl-CoA+FAD => trans-Hexadec-2-enoyl-CoA+FADH2\", \"oxidized (electron-transfer flavoprotein) + hexadecanoyl-CoA + H(+) => (2E)-hexadecenoyl-CoA + reduced (electron-transfer flavoprotein)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 31649, \"displayName\": \"FADH2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FADH2\", \"FADH2(2-)\"], \"producedByEvent\": [10345620], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-31649\", \"stIdVersion\": \"R-ALL-31649.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 77284, \"displayName\": \"trans-Hexadec-2-enoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"trans-Hexadec-2-enoyl-CoA\", \"(E)-hexadec-2-enoyl-CoA(4-)\", \"(E)-hexadec-2-enoyl-CoA\"], \"producedByEvent\": [10345620], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77284\", \"stIdVersion\": \"R-ALL-77284.6\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-77299\", \"stIdVersion\": \"R-BTA-77299.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
