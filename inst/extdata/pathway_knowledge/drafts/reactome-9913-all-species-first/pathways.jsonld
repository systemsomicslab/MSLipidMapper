    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10435140], \"className\": \"CatalystActivity\", \"dbId\": 10435138, \"displayName\": \"nuclear steroid receptor activity of VDR [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10435140, \"displayName\": \"1,25(OH)2D binds VDR\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10435140], \"dbId\": 8963912, \"displayName\": \"1,25(OH)2D [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1,25(OH)2D\", \"calcitriol\", \"CTL\", \"1,25-dihydroxyD3\", \"1,25-dihydroxyvitamin D3\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8963912\", \"stIdVersion\": \"R-ALL-8963912.4\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10435140], \"dbId\": 10363708, \"displayName\": \"VDR [nucleoplasm]\", \"endCoordinate\": 427, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"VDR\", \"VDR\", \"G5E5J5\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-375512\", \"stIdVersion\": \"R-BTA-375512.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1,25(OH)2D binds VDR\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10435137, \"displayName\": \"1,25(OH)2D:VDR [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"1,25(OH)2D:VDR\"], \"producedByEvent\": [10435140], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8963916\", \"stIdVersion\": \"R-BTA-8963916.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8963915\", \"stIdVersion\": \"R-BTA-8963915.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
