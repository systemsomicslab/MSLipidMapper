        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10423211], \"className\": \"CatalystActivity\", \"dbId\": 10356425, \"displayName\": \"steroid Delta-isomerase activity of EBP [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10423211, \"displayName\": \"EBP isomerizes ZYMSTNL to LTHSOL\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10423211], \"dbId\": 6807048, \"displayName\": \"ZYMSTNL [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ZYMSTNL\", \"5alpha-cholest-8-en-3beta-ol\", \"zymostenol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6807048\", \"stIdVersion\": \"R-ALL-6807048.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"EBP isomerizes ZYMSTNL to LTHSOL\", \"5alpha-cholest-8-en-3beta-ol => lathosterol\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 6807054, \"displayName\": \"LTHSOL [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LTHSOL\", \"5alpha-cholest-7-en-3beta-ol\", \"lathosterol\"], \"producedByEvent\": [10423211], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6807054\", \"stIdVersion\": \"R-ALL-6807054.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10423215, \"displayName\": \"DHCR24 reduces ZYMOL to ZYMSTNL\", \"followingEvent\": [10423211], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DHCR24 reduces ZYMOL to ZYMSTNL\", \"zymosterol + NADPH + H(+) => 5alpha-cholest-8-en-3beta-ol + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-6807064\", \"stIdVersion\": \"R-BTA-6807064.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10448654, \"displayName\": \"HSD17B7 reduces 5a-cholest-8-en-3-one to ZYMSTNL\", \"followingEvent\": [10423211], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B7 reduces 5a-cholest-8-en-3-one to ZYMSTNL\", \"5alpha-cholest-8-en-3-one + NADPH + H(+) => 5alpha-cholest-8-en-3beta-ol + NADP(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9945804\", \"stIdVersion\": \"R-BTA-9945804.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-6807052\", \"stIdVersion\": \"R-BTA-6807052.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
