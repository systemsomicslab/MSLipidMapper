    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10384780], \"className\": \"CatalystActivity\", \"dbId\": 10384778, \"displayName\": \"acyltransferase activity, transferring groups other than amino-acyl groups of TAZ [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 10384780, \"displayName\": \"MLCL and PC are converted to CL and 1-acyl LPC by TAZ (IM) (Reversible)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10384783], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10384780], \"dbId\": 1498773, \"displayName\": \"MLCL [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MLCL\", \"2-monolysocardiolipin\", \"Monolysocardiolipin\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498773\", \"stIdVersion\": \"R-ALL-1498773.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10384780], \"dbId\": 1524075, \"displayName\": \"PC [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PC\", \"1,2-diacyl-sn-glycero-3-phosphocholine\", \"Phosphatidyl choline\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524075\", \"stIdVersion\": \"R-ALL-1524075.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MLCL and PC are converted to CL and 1-acyl LPC by TAZ (IM) (Reversible)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1524072, \"displayName\": \"cardiolipin [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"cardiolipin\", \"CL\"], \"producedByEvent\": [10384780], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524072\", \"stIdVersion\": \"R-ALL-1524072.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524079, \"displayName\": \"1-acyl LPC [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPC\", \"1-O-acyl-sn-glycero-3-phosphocholine(1+)\", \"2-lysophosphatidylcholine\", \"1-acyl-sn-glycero-3-phosphocholines\"], \"producedByEvent\": [10384780], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524079\", \"stIdVersion\": \"R-ALL-1524079.4\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1482781\", \"stIdVersion\": \"R-BTA-1482781.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level