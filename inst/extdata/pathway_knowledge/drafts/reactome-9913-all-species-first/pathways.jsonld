    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "3,7,24THCA-CoA [peroxisomal matrix] + NAD+ [peroxisomal matrix] => 3a,7a-dihydroxy-5b-cholest-24-one-CoA [peroxisomal matrix] + H+ [peroxisomal matrix] + NADH [peroxisomal matrix]"
