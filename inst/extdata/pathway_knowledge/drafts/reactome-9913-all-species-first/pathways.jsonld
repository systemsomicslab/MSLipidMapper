    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10357873], \"className\": \"CatalystActivity\", \"dbId\": 10357863, \"displayName\": \"carnitine O-palmitoyltransferase activity of CPT1A [mitochondrial outer membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005741\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17906, \"definition\": \"The outer, i.e. cytoplasm-facing, lipid bilayer of the mitochondrial envelope.\", \"displayName\": \"mitochondrial outer membrane\", \"name\": \"mitochondrial outer membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005741\"}, {\"accession\": \"0005758\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17927, \"definition\": \"The region between the inner and outer lipid bilayers of the mitochondrial envelope.\", \"displayName\": \"mitochondrial intermembrane space\", \"name\": \"mitochondrial intermembrane space\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005758\"}], \"dbId\": 10357873, \"displayName\": \"CPT1A transfers PALM to CAR\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10357978], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10357873], \"dbId\": 549207, \"displayName\": \"CAR [mitochondrial intermembrane space]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CAR\", \"(R)-carnitine\", \"gamma-Trimethyl-hydroxybutyrobetaine\", \"carnitine\", \"3-Hydroxy-4-trimethylammoniobutanoate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-549207\", \"stIdVersion\": \"R-ALL-549207.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10357873], \"dbId\": 200993, \"displayName\": \"PALM-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PALM-CoA\", \"palmitoyl-CoA(4-)\", \"palmitoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-200993\", \"stIdVersion\": \"R-ALL-200993.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CPT1A transfers PALM to CAR\", \"palmitoyl-CoA + carnitine => palmitoylcarnitine + CoASH\", \"(R)-carnitine + hexadecanoyl-CoA => CoA + O-hexadecanoyl-(R)-carnitine\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10357873], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 201034, \"displayName\": \"L-PCAR [mitochondrial intermembrane space]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"L-PCAR\", \"O-palmitoyl-L-carnitine\", \"L-Palmitoylcarnitine\", \"C16-CAR\"], \"producedByEvent\": [10357873], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-201034\", \"stIdVersion\": \"R-ALL-201034.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10371196, \"displayName\": \"ACSL3,4 ligates coenzyme A (CoA-SH) to a long chain fatty acid yielding fatty acyl-coenzyme A\", \"followingEvent\": [10357873], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACSL3,4 ligates coenzyme A (CoA-SH) to a long chain fatty acid yielding fatty acyl-coenzyme A\", \"a long-chain fatty acid + ATP + CoA => a long-chain fatty acyl-CoA + AMP + diphosphate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-434382\", \"stIdVersion\": \"R-BTA-434382.1\"}, {\"category\": \"dissociation\", \"className\": \"Reaction\", \"dbId\": 10408854, \"displayName\": \"FABP5 dissociates from RXRA:PPARD:atRA\", \"followingEvent\": [10357873], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FABP5 dissociates from RXRA:PPARD:atRA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-5634100\", \"stIdVersion\": \"R-BTA-5634100.1\"}], \"regulatedBy\": [{\"className\": \"NegativeRegulation\", \"dbId\": 200418, \"displayName\": \"Negative regulation by 'Mal-CoA [cytosol]'\", \"regulatedEntity\": [10357873], \"schemaClass\": \"NegativeRegulation\", \"stId\": \"R-HSA-200418\", \"stIdVersion\": \"R-HSA-200418.3\"}, {\"className\": \"PositiveRegulation\", \"dbId\": 10357874, \"displayName\": \"Positive regulation by 'RXRA:PPARD:atRA [nucleoplasm]'\", \"regulatedEntity\": [10357873], \"schemaClass\": \"PositiveRegulation\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-200406\", \"stIdVersion\": \"R-BTA-200406.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
