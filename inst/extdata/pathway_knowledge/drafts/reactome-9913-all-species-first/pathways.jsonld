        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10415666], \"className\": \"CatalystActivity\", \"dbId\": 10415664, \"displayName\": \"glyceryl-ether monooxygenase activity of AGMO [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}], \"dbId\": 10415666, \"displayName\": \"AGMO cleaves alkylglycerol into fatty aldehyde and glycerol\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10415666], \"dbId\": 5696122, \"displayName\": \"alkylglycerol [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"alkylglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5696122\", \"stIdVersion\": \"R-ALL-5696122.2\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10415666], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10415666], \"dbId\": 29870, \"displayName\": \"BH4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"BH4\", \"sapropterin\", \"Tetrahydrobiopterin\", \"5,6,7,8-tetrahydrobiopterin\", \"2-Amino-6-(1,2-dihydroxypropyl)-5,6,7,8-tetrahydoro-4(1H)-pteridinone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29870\", \"stIdVersion\": \"R-ALL-29870.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AGMO cleaves alkylglycerol into fatty aldehyde and glycerol\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 5696116, \"displayName\": \"fatty aldehyde [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"fatty aldehyde\"], \"producedByEvent\": [10415666], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5696116\", \"stIdVersion\": \"R-ALL-5696116.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76116, \"displayName\": \"Glycerol [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Glycerol\"], \"producedByEvent\": [10415666], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76116\", \"stIdVersion\": \"R-ALL-76116.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10415666], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1497857, \"displayName\": \"q-BH2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"q-BH2\", \"L-erythro-7,8-dihydrobiopterin\", \"