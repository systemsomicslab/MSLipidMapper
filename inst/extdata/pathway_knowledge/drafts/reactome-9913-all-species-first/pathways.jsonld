    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 10445034, \"displayName\": \"PSAP(195-273) forms a dimer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10445105], \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10445034, 10445034], \"dbId\": 10386260, \"displayName\": \"PSAP [lysosomal lumen]\", \"endCoordinate\": 273, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PSAP\", \"PSAP(195-273)\", \"A0A140T8C6\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9840336\", \"stIdVersion\": \"R-BTA-9840336.1\", \"startCoordinate\": 195}, 10386260], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PSAP(195-273) forms a dimer\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10386262, \"displayName\": \"PSAP(195-273) dimer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PSAP(195-273) dimer\"], \"producedByEvent\": [10445034], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9840482\", \"stIdVersion\": \"R-BTA-9840482.1\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10444994, \"displayName\": \"PSAP is cleaved\", \"followingEvent\": [10445034], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PSAP is cleaved\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9840334\", \"stIdVersion\": \"R-BTA-9840334.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9840488\", \"stIdVersion\": \"R-BTA-9840488.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
