  {
    "@id": "https://reactome.org/content/detail/R-BTA-193143",
    "@type": [
      "https://systemomicslab.github.io/MSLipidMapper/ontology/LipidReaction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "CYP19A1 hydroxylates TEST to EST17b"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/curationStatus": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/Draft"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/directionality": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + TEST [cytosol] + O2 [cytosol] + NADPH [cytosol] => NADP+ [cytosol] + HCOOH [cytosol] + H2O [cytosol] + EST17b [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10355787], \"className\": \"CatalystActivity\", \"dbId\": 10355734, \"displayName\": \"steroid hydroxylase activity of CYP19A1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10355787, \"displayName\": \"CYP19A1 hydroxylates TEST to EST17b\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10355787], \"dbId\": 193057, \"displayName\": \"TEST [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TEST\", \"testosterone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193057\", \"stIdVersion\": \"R-ALL-193057.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10355787], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10355787], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10355787], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP19A1 hydroxylates TEST to EST17b\", \"Testosterone is converted to estradiol\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193132, \"displayName\": \"EST17b [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"EST17b\", \"17beta-estradiol\", \"Estradiol-17beta\"], \"producedByEvent\": [10355787], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193132\", \"stIdVersion\": \"R-ALL-193132.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [10355787], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29460, \"displayName\": \"HCOOH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HCOOH\", \"formate\", \"Formate\", \"formic acid\", \"Methanoic acid\"], \"producedByEvent\": [10355787], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29460\", \"stIdVersion\": \"R-ALL-29460.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10355787], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10355751, \"displayName\": \"HSD17B3-like proteins reducde ANDST to TEST\", \"followingEvent\": [10355787], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B3-like proteins reducde ANDST to TEST\", \"Reduction of androstenedione to testosterone\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-193064\", \"stIdVersion\": \"R-BTA-193064.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-193143\", \"stIdVersion\": \"R-BTA-193143.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
