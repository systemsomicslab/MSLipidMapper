    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "GGT1, 5 dimers hydrolyse LTC4 to LTD4"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/curationStatus": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/Draft"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/directionality": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H2O [extracellular region] + LTC4 [extracellular region] => LTD4 [extracellular region] + L-Glu [extracellular region]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10362048], \"className\": \"CatalystActivity\", \"dbId\": 10362046, \"displayName\": \"glutathione gamma-glutamate hydrolase activity of GGT1, 5 dimers [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 10362048, \"displayName\": \"GGT1, 5 dimers hydrolyse LTC4 to LTD4\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10362048], \"dbId\": 266013, \"displayName\": \"LTC4 [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LTC4\", \"leukotriene C4(2-)\", \"leukotriene C4\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-266013\", \"stIdVersion\": \"R-ALL-266013.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10362048], \"dbId\": 109276, \"displayName\": \"H2O [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109276\", \"stIdVersion\": \"R-ALL-109276.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GGT1, 5 dimers hydrolyse LTC4 to LTD4\", \"H2O + leukotriene C4 => L-glutamate + leukotriene D4\", \"Cleavage of the gamma-glutamyl bond of LTC4 forms LTD4\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 266074, \"displayName\": \"LTD4 [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LTD4\", \"leukotriene D4(1-)\", \"leukotriene D4\"], \"producedByEvent\": [10362048], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-266074\", \"stIdVersion\": \"R-ALL-266074.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 210382, \"displayName\": \"L-Glu [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"L-Glu\", \"L-glutamate(1-)\", \"L-Glutamate\", \"L-glutamic acid\", \"L-Glutaminic acid\"], \"producedByEvent\": [10362048], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-210382\", \"stIdVersion\": \"R-ALL-210382.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10362060, \"displayName\": \"LTC4 is exported from the cytosol by ABCC1\", \"followingEvent\": [10362048], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTC4 is exported from the cytosol by ABCC1\", \"ATP + H2O + leukotriene C4(in) => ADP + H(+) + leukotriene C4(out) + phosphate\", \"ABCC1 mediates LTC4 export from the cell\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-266070\", \"stIdVersion\": \"R-BTA-266070.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-266046\", \"stIdVersion\": \"R-BTA-266046.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
