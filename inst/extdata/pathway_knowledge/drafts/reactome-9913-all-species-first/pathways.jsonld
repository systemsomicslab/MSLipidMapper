        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10430056], \"className\": \"CatalystActivity\", \"dbId\": 10430054, \"displayName\": \"bile acid binding activity of STARD5 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10430056, \"displayName\": \"STARD5 binds DCA, LCA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10430056], \"dbId\": 10430051, \"displayName\": \"STARD5 [cytosol]\", \"endCoordinate\": 213, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"STARD5\", \"STARD5\", \"A1A4M6\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-196114\", \"stIdVersion\": \"R-BTA-196114.1\", \"startCoordinate\": 1}, {\"className\": \"Set\", \"consumedByEvent\": [10430056], \"dbId\": 8873845, \"displayName\": \"DCA, LCA [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"DCA, LCA\", \"deoxycholic acid, lithocholic acid\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-8873845\", \"stIdVersion\": \"R-ALL-8873845.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"STARD5 binds DCA, LCA\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10430053, \"displayName\": \"STARD5:DCA/L