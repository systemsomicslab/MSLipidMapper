        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10387322], \"className\": \"CatalystActivity\", \"dbId\": 10387320, \"displayName\": \"phosphatidylinositol-3,4,5-trisphosphate 5-phosphatase activity of INPP5(2) [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10387322, \"displayName\": \"PI(3,4,5)P3 is dephosphorylated to PI(3,4)P2 by INPP5[2] at the plasma membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10387322], \"dbId\": 179838, \"displayName\": \"PI(3,4,5)P3 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(3,4,5)P3\", \"1-phosphatidyl-1D-myo-inositol 3,4,5-trisphosphate(7-)\", \"PIP3\", \"1-phosphatidyl-1D-myo-inositol 3,4,5-trisphosphate\", \"Phosphatidylinositol-3,4,5-trisphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\