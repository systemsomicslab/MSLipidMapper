      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10394875], \"className\": \"CatalystActivity\", \"dbId\": 10394871, \"displayName\": \"peroxidase activity of PTGS2 dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10394875, \"displayName\": \"PGG2 is reduced to PGH2 by PTGS2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10394875], \"dbId\": 140357, \"displayName\": \"PGG2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGG2\", \"prostaglandin G2(1-)\", \"prostaglandin G2\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-140357\", \"stIdVersion\": \"R-ALL-140357.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10394875], \"dbId\": 9915557, \"displayName\": \"hydrogen donor [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"hydrogen donor\", \"AH2\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9915557\", \"stIdVersion\": \"R-ALL-9915557.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PGG2 is reduced to PGH2 by PTGS2\", \"AH2 + prostaglandin G2 = A + H2O + prostaglandin H2\", \"Peroxidative reduction of PGG2 to PGH2\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 113519, \"displayName\": \"H2O [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10394875], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113519\", \"stIdVersion\": \"R-ALL-113519.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 30138, \"displayName\": \"PGH2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGH2\", \"prostaglandin H2(1-)\", \"(5Z,13E)-(15S)-9alpha,11alpha-Epidioxy-15-hydroxyprosta-5,13-dienoate\", \"prostaglandin H2\"], \"producedByEvent\": [10394875], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-30138\", \"stIdVersion\": \"R-ALL-30138.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 9915551, \"displayName\": \"hydrogen acceptor [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"hydrogen acceptor\", \"A\"], \"producedByEvent\": [10394875], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9915551\", \"stIdVersion\": \"R-ALL-9915551.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10394881, \"displayName\": \"Arachidonate is oxidised to PGG2 by PTGS2\", \"followingEvent\": [10394875], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Arachidonate is oxidised to PGG2 by PTGS2\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate + 2 O2 =>