        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10384609], \"className\": \"CatalystActivity\", \"dbId\": 10384607, \"displayName\": \"1-acylglycerol-3-phosphate O-acyltransferase activity of LPGAT [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10384609, \"displayName\": \"1-acyl LPG is acylated to PG by LPGAT\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10384609], \"dbId\": 1498740, \"displayName\": \"1-acyl LPG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPG\", \"1-acyl-sn-glycero-3-phosphoglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498740\", \"stIdVersion\": \"R-ALL-1498740.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10384609], \"dbId\": 1500578, \"displayName\": \"acyl-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"acyl-CoA\", \"acyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500578\", \"stIdVersion\": \"R-ALL-1500578.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1-acyl LPG is acylated to PG by LPGAT\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1483256, \"displayName\": \"PG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PG\", \"1,2-diacyl-sn-glycero-3-phospho-(1'-sn-glycerol)(1-)\", \"phosphatidylglycerol\"], \"producedByEvent\": [10384609], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1483256\", \"stIdVersion\": \"R-ALL-1483256.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10384609], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10384850, \"displayName\": \"PG is hydrolyzed to 1-acyl LPG by PLA2[1]\", \"followingEvent\": [10384609], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PG is hydrolyzed to 1-acyl LPG by PLA2[1]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1482900\", \"stIdVersion\": \"R-BTA-1482900.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10384852, \"displayName\": \"PG is hydrolyzed to 1-acyl LPG by PLA2G2A\", \"followingEvent\": [10384609], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PG is hydrolyzed to 1-acyl LPG by PLA2G2A\"], \"releaseDate\": \"2026-06-17\", \"schema