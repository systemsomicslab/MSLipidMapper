        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10360625], \"className\": \"CatalystActivity\", \"dbId\": 10360436, \"displayName\": \"molecular carrier activity of GC [extracellular region]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 10360625, \"displayName\": \"25(OH)D binds GC\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10360625], \"dbId\": 209906, \"displayName\": \"25(OH)D [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(OH)D\", \"calcidiol\", \"25-hydroxyvitamin D3\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-209906\", \"stIdVersion\": \"R-ALL-209906.5\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10360625], \"dbId\": 10360433, \"displayName\": \"GC [extracellular region]\", \"endCoordinate\": 474, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GC\", \"GC\", \"A0A3Q1LQ02\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-209886\", \"stIdVersion\": \"R-BTA-20988