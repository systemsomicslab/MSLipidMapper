    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "NADPH [mitochondrial matrix] + 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al [mitochondrial matrix] + O2 [mitochondrial matrix] + H+ [mitochondrial matrix] => NADP+ [mitochondrial matrix] + 3,7,24THCA [mitochondrial matrix] + H2O [mitochondrial matrix]"
