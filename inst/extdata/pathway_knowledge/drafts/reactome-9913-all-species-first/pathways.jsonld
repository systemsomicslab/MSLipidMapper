        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10441998, \"displayName\": \"PTGS1,2 dimers bind PTGS Inhibitors\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10441998], \"dbId\": 10348363, \"displayName\": \"PTGS1 dimer [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PTGS1 dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-428986\", \"stIdVersion\": \"R-BTA-428986.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10441998], \"dbId\": 9716837, \"displayName\": \"PTGS inhibitors [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PTGS inhibitors\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9716837\", \"stIdVersion\": \"R-ALL-9716837.1\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10441998], \"dbId\": 10394870, \"displayName\": \"PTGS2 dimer [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PTGS2 dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-140491\", \"stIdVersion\": \"R-BTA-140491.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS1,2 dimers bind PTGS Inhibitors\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10441996, \"displayName\": \"PTGS1 dimer:PTGS Inhibitors [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PTGS1 dimer:PTGS Inhibitors\"], \"producedByEvent\": [10441998], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9716834\", \"stIdVersion\": \"R-BTA-9716834.1\"}, {\"className\": \"Complex\", \"dbId\": 10441992, \"displayName\": \"PTGS2 dimer:PTGS inhibitors [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PTGS2 dimer:PTGS inhibitors\"], \"producedByEvent\": [10441998], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9716835\", \"stIdVersion\": \"R-BTA-9716835.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9716838\", \"stIdVersion\": \"R-BTA-9716838.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
