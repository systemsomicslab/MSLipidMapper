    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10370299], \"className\": \"CatalystActivity\", \"dbId\": 10370297, \"displayName\": \"protein serine/threonine kinase activity of p-S272,T222,T334-MAPKAPK2 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10370299, \"displayName\": \"ALOX5 is phosphorylated by MAPKAP2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10370299], \"dbId\": 10370292, \"displayName\": \"ALOX5:Ca2+:Fe2+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"ALOX5:Ca2+:Fe2+\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-2237880\", \"stIdVersion\": \"R-BTA-2237880.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10370299], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 is phosphorylated by MAPKAP2\", \"ATP + L-seryl-(protein) => ADP + H(+) + O-phospho-L-seryl-(protein)\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10370296, \"displayName\": \"p-S272-ALOX5:Ca2+:Fe2+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"p-S272-ALOX5:Ca2+:Fe2+\"], \"producedByEvent\": [10370299], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-265277\", \"stIdVersion\": \"R-BTA-265277.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [10370299], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [10370299], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-429016\", \"stIdVersion\": \"R-BTA-429016.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
