    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "11DCORST [mitochondrial matrix] + NADPH [mitochondrial matrix] + O2 [mitochondrial matrix] + H+ [mitochondrial matrix] => NADP+ [mitochondrial matrix] + H2O [mitochondrial matrix] + CORST [mitochondrial matrix]"
