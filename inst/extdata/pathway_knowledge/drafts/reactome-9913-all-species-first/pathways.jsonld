        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10366975], \"className\": \"CatalystActivity\", \"dbId\": 10366973, \"displayName\": \"carbon-carbon lyase activity of HACL1 tetramer [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10366975, \"displayName\": \"2-hydroxyphytanoyl-CoA => pristanal + formyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10366964], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10366975], \"dbId\": 389594, \"displayName\": \"3S2HPhy-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3S2HPhy-CoA\", \"2-hydroxyphytanoyl-CoA(4-)\", \"2-hydroxyphytanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389594\", \"stIdVersion\": \"R-ALL-389594.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-hydroxyphytanoyl-CoA => pristanal + formyl-CoA\", \"2-hydroxyphytanoyl-CoA => 2,6,10,14-tetramethylpentadecanal + formyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389636, \"displayName\": \"Pristanal [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pristanal\"], \"producedByEvent\": [10366975], \"referenceT