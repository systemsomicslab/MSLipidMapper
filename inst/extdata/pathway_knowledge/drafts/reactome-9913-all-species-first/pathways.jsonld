    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10362221], \"className\": \"CatalystActivity\", \"dbId\": 10362219, \"displayName\": \"cargo receptor activity of CUBN [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}, {\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10362221, \"displayName\": \"CUBN binds GC:25(OH)D\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10362218], \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10362221], \"dbId\": 10360623, \"displayName\": \"GC:25(OH)D [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GC:25(OH)D\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-209892\", \"stIdVersion\": \"R-BTA-209892.1\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10362221], \"dbId\": 10361720, \"displayName\": \"CUBN [plasma membrane]\", \"endCoordinate\": 3623, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CUBN\", \"CUBN\", \"F1MKV7\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-264843\", \"stIdVersion\": \"R-BTA-264843.1\", \"startCoordinate\": 36}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CUBN binds GC:25(OH)D\", \"DBP:Calcidiol is sequestered by cubilin on the cell surface\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10362209, \"displayName\": \"CUBN:GC:25(OH)D [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"CUBN:GC:25(OH)D\"], \"producedByEvent\": [10362221], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-350115\", \"stIdVersion\": \"R-BTA-350115.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10360625, \"displayName\": \"25(OH)D binds GC\", \"followingEvent\": [10362221], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"25(OH)D binds GC\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-209944\", \"stIdVersion\": \"R-BTA-209944.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-350186\", \"stIdVersion\": \"R-BTA-350186.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
