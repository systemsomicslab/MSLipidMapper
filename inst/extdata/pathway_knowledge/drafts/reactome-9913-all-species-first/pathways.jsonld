        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10341404], \"className\": \"CatalystActivity\", \"dbId\": 10341402, \"displayName\": \"propionyl-CoA carboxylase activity of 6x(Btn-PCCA:PCCB) [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10341404, \"displayName\": \"propionyl-CoA + CO2 + ATP <=> D-methylmalonyl-CoA + ADP + orthophosphate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10341388], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10341404], \"dbId\": 70843, \"displayName\": \"PROP-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PROP-CoA\", \"propionyl-CoA(4-)\", \"propionyl coenzyme A\", \"propionyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70843\", \"stIdVersion\": \"R-ALL-70843.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10341404], \"dbId\": 113593, \"displayName\": \"ATP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113593\", \"stIdVersion\": \"R-ALL-113593.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10341404], \"dbId\": 29896, \"displayName\": \"HCO3- [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HCO3-\", \"hydrogencarbonate\", \"Bicarbonate\", \"Acid carbonate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29896\", \"stIdVersion\": \"R-ALL-29896.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"propionyl-CoA + CO2 + ATP <=> D-methylmalonyl-CoA + ADP + orthophosphate\", \"propanoyl-CoA + hydrogencarbonate + ATP => (S)-methylmalonyl-CoA + ADP + phosphate + H(+)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 71019, \"displayName\": \"MEMA-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MEMA-CoA\", \"(S)-methylmalonyl-CoA(5-)\", \"(S)-2-methyl-3-oxopropanoyl-CoA\", \"D-methylmalonyl-CoA\", \"(S)-methylmalonyl-CoA\"], \"producedByEvent\": [10341404], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-71019\", \"stIdVersion\": \"R-ALL-71019.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113581, \"displayName\": \"ADP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [10341404], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113581\", \"stIdVersion\": \"R-ALL-113581.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113548, \"displayName\": \"Pi [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\"], \"producedByEvent\": [10341404], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113548\", \"stIdVersion\": \"R-ALL-113548.5\"}, 