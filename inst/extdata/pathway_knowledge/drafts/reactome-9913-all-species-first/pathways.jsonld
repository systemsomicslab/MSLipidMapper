ldehyde\", \"20alpha,22beta-hydroxycholesterol + NADPH + H+ + O2 => pregnenolone + isocaproaldehyde + NADP+ + H2O\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193164, \"displayName\": \"PREG [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PREG\", \"pregnenolone\"], \"producedByEvent\": [10355785], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193164\", \"stIdVersion\": \"R-ALL-193164.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193046, \"displayName\": \"ISCAL [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ISCAL\", \"4-methylpentanal\", \"Isocaproic aldehyde\", \"isocaproaldehyde\"], \"producedByEvent\": [10355785], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193046\", \"stIdVersion\": \"R-ALL-193046.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10355785, 10355785], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}, 113521, {\"className\": \"Complex\", \"dbId\": 10355783, \"displayName\": \"CYP11A1:FDXR:FDX1,FDX1L (ox.) [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"CYP11A1:FDXR:FDX1,FDX1L (ox.)\"], \"producedByEvent\": [10355785, 10355785], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-5580259\", \"stIdVersion\": \"R-BTA-5580259.1\"}, 10355783, {\"className\": \"Chemical Compound\", \"dbId\": 113563, \"displayName\": \"NADP+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphos