        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10383440], \"className\": \"CatalystActivity\", \"dbId\": 10383438, \"displayName\": \"molecular carrier activity of SERPINA6 [extracellular region]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 10383440, \"displayName\": \"Corticosteroids bind to CBG in blood\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10383440], \"dbId\": 10383435, \"displayName\": \"SERPINA6 [extracellular region]\", \"endCoordinate\": 405, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SERPINA6\", \"E1BF81\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1449658\", \"stIdVersion\": \"R-BTA-1449658.1\", \"startCoordinate\": 23}, {\"className\": \"Set\", \"consumedByEvent\": [10383440], \"dbId\": 1449707, \"displayName\": \"Corticosteroids [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Corticosteroids\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-1449707\", \"stIdVersion\": \"R-ALL-1449707.1\"}], \"isInDisease\": f