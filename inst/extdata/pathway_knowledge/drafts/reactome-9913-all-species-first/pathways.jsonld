    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "DHCE [endoplasmic reticulum membrane] + H+ [cytosol] + O2 [cytosol] + CYB5B:Fe2+ [endoplasmic reticulum membrane] => phytoceramide [endoplasmic reticulum membrane] + CYB5B:Fe3+ [endoplasmic reticulum membrane] + H2O [cytosol]"
