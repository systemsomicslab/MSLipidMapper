    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10341381], \"className\": \"CatalystActivity\", \"dbId\": 10341379, \"displayName\": \"methylmalonyl-CoA mutase activity of 2xMMAA:2xMUT:AdoCbl [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10341381, \"displayName\": \"MUT isomerises L-MM-CoA to SUCC-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10341381], \"dbId\": 71009, \"displayName\": \"L-MM-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"L-MM-CoA\", \"(R)-methylmalonyl-CoA(5-)\", \"L-methylmalonyl-CoA\", \"(R)-methylmalonyl-CoA\", \"(R)-2-methyl-3-oxopropanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-71009\", \"stIdVersion\": \"R-ALL-71009.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MUT isomerises L-MM-CoA to SUCC-CoA\", \"(R)-methylmalonyl-CoA => succinyl-CoA\", \"L-methylmalonyl-CoA <=> succinyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 70958, \"displayName\": \"SUCC-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SUCC-CoA\", \"succinyl-CoA(5-)\", \"Succinyl coenzyme A\"], \"producedByEvent\": [10341381], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70958\", \"stIdVersion\": \"R-ALL-70958.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10341388, \"displayName\": \"D-methylmalonyl-CoA <=> L-methylmalonyl-CoA\", \"followingEvent\": [10341381], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"D-methylmalonyl-CoA <=> L-methylmalonyl-CoA\", \"(S)-methylmalonyl-CoA => (R)-methylmalonyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-71020\", \"stIdVersion\": \"R-BTA-71020.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10398134, \"displayName\": \"MMAA:MUT binds AdoCbl\", \"followingEvent\": [10341381], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MMAA:MUT binds AdoCbl\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-3159259\", \"stIdVersion\": \"R-BTA-3159259.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-71010\", \"stIdVersion\": \"R-BTA-71010.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
