    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "NADH [mitochondrial matrix] + 2-trans-4-cis-decadienoyl-CoA [mitochondrial matrix] + H+ [mitochondrial matrix] => NAD+ [mitochondrial matrix] + 3-trans-decenoyl-CoA [mitochondrial matrix]"
