      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "7,17-diHp-DPAn-3 [cytosol] + NADP+ [cytosol] => NADPH [cytosol] + 7,8-epoxy,17-HDPAn-3 [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10437780], \"className\": \"CatalystActivity\", \"dbId\": 10437443, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen of ALOX5 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10437780, \"displayName\": \"ALOX5 dehydrogenates 7,17-diHp-DPAn-3 to 7,8-epoxy,17-HDPAn-3\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10437780], \"dbId\": 9026034, \"displayName\": \"7,17-diHp-DPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7,17-diHp-DPAn-3\", \"(8E,10Z,13Z,15E,19Z)-7,17-bis(hydroperoxy)docosapentaenoate\", \"7,17-diHpDPA(n-3)(1-)\", \"(8E,10Z,13Z,15E,19Z)-7,17-bis(hydroperoxy)docosapentaenoic acid\", \"7,17-dihydroperoxy-omega3-docosapentaenoic acid\", \"7,17-dihydroperoxy-docosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9026034\", \"stIdVersion\": \"R-ALL-9026034.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10437780], \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucl