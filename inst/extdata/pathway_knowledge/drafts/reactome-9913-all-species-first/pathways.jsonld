        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10437475], \"className\": \"CatalystActivity\", \"dbId\": 10437448, \"displayName\": \"epoxide hydrolase activity of LTA4H:Zn2+ [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10437475, \"displayName\": \"LTA4H:Zn2+ hydrolyses 4S(5)-epoxy-17(S)-HDHA to RvD3 or RvD4\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10437475], \"dbId\": 9024781, \"displayName\": \"4S(5)-epoxy-17(S)-HDHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4S(5)-epoxy-17(S)-HDHA\", \"4S(5)-epoxy-17(S)-hydroxydocosahexaenoate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024781\", \"stIdVersion\": \"R-ALL-9024781.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10437475], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4H:Zn2+ hydrolyses 4S(5)-epoxy-17(S)-HDHA to RvD3 or RvD4\"], \"output\": [{\"className\": \"Se