    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10368073], \"className\": \"CatalystActivity\", \"dbId\": 10368071, \"displayName\": \"nuclear receptor activity of PPARA:RXRA:Corepressors [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10368073, \"displayName\": \"Fatty acid ligands activate PPARA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10368076], \"goBiologicalProcess\": {\"accession\": \"0045944\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 17788, \"definition\": \"Any process that activates or increases the frequency, rate or extent of transcription from an RNA polymerase II promoter.\", \"displayName\": \"positive regulation of transcription by RNA polymerase II\", \"name\": \"positive regulation of transcription by RNA polymerase II\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0045944\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10368073], \"dbId\": 10368038, \"displayName\": \"PPARA:RXRA:Corepressors [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PPARA:RXRA:Corepressors\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-400196\", \"stIdVersion\": \"R-BTA-400196.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10368073], \"dbId\": 10368058, \"displayName\": \"Coactivators of PPARalpha [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Coactivators of PPARalpha\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-400216\", \"stIdVersion\": \"R-BTA-400216.1\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10368073], \"dbId\": 10368064, \"displayName\": \"FABP1:ligands of PPARA [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"FABP1:ligands of PPARA\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-2026984\", \"stIdVersion\": \"R-BTA-2026984.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Fatty acid ligands activate PPARA\"], \"output\": [{\"className\": \"Set\", \"dbId\": 10368034, \"displayName\": \"Corepressors of PPARalpha [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Corepressors of PPARalpha\"], \"producedByEvent\": [10368073], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-400207\", \"stIdVersion\": \"R-BTA-400207.1\"}, {\"className\": \"Complex\", \"dbId\": 10368070, \"displayName\": \"PPARA:RXRA Coactivator complex [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 5, \"name\": [\"PPARA:RXRA Coactivator complex\"], \"producedByEvent\": [10368073], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-400154\", \"stIdVersion\": \"R-BTA-400154.1\"}, {\"className\": \"Protein\", \"dbId\": 10368062, \"displayName\": \"FABP1 [nucleoplasm]\", \"endCoordinate\": 127, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FABP1\", \"FABP1\", \"P80425\"], \"producedByEvent\": [10368073], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1989743\", \"stIdVersion\": \"R-BTA-1989743.1\", \"startCoordinate\": 1}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\":