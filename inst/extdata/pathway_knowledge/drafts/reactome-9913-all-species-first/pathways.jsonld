    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10355818], \"className\": \"CatalystActivity\", \"dbId\": 10355562, \"displayName\": \"racemase and epimerase activity of AMACR [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10355818, \"displayName\": \"Isomerization of 25(R) DHCA-CoA to 25(S) DHCA-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10355796], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10355818], \"dbId\": 193429, \"displayName\": \"25(R) DHCA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(R) DHCA-CoA\", \"3alpha,7alpha-dihydroxy-5beta-cholestan-26-oyl-CoA\", \"3alpha,7alpha-Dihydroxy-5beta-cholestanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193429\", \"stIdVersion\": \"R-ALL-193429.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Isomerization of 25(R) DHCA-CoA to 25(S) DHCA-CoA\", \"25(R) DHCA-CoA => 25(S) DHCA-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193442, \"displayName\": \"25(S) DHCA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"25(S) DHCA-CoA\", \"3alpha,7alpha-dihydroxy-5beta-cholestan-26-oyl-CoA\", \"25(S) 3alpha,7alpha-dihydroxy-5beta-cholestanoyl-CoA\"], \"producedByEvent\": [10355818], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193442\", \"stIdVersion\": \"R-ALL-193442.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10355825, \"displayName\": \"25(R) DHCA-CoA is translocated from the cytosol to the peroxisome\", \"followingEvent\": [10355818], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"25(R) DHCA-CoA is translocated from the cytosol to the peroxisome\", \"25(R) DHCA-CoA [ cytosol] => 25(R) DHCA-CoA [peroxisome]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-193482\", \"stIdVersion\": \"R-BTA-193482.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-193452\", \"stIdVersion\": \"R-BTA-193452.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactom