        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10445745], \"className\": \"CatalystActivity\", \"dbId\": 10445743, \"displayName\": \"lactosylceramide 1,3-N-acetyl-beta-D-glucosaminyltransferase activity of B3GNT5 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}, {\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}], \"dbId\": 10445745, \"displayName\": \"B3GNT5 transfers GlcNAc to LacCer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10445745], \"dbId\": 9844874, \"displayName\": \"LacCer-d18 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LacCer-d18\", \"beta-D-galactosyl-(1->4)-beta-D-glucosyl-(1<->1)-N-acylsphingosine\", \"Lactosylceramide\", \"beta-D-Galactosyl-1,4-beta-D-glucosylceramide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9844874\", \"stIdVersion\": \"R-ALL-9844874.2\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10445745], \"dbId\": 914003, \"displayName\": \"UDP-GlcNAc [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP-GlcNAc\", \"UDP-N-acetyl-alpha-D-glucosamine(2-)\", \"UDP-N-acetyl-D-glucosamine\", \"UDP-N-acetyl-alpha-D-glucosamine\", \"UDP-N-acetylglucosamine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-914003\", \"stIdVersion\": \"R-ALL-914003.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"B3GNT5 transfers GlcNAc to LacCer\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9846503, \"displayName\": \"Lc3Cer [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Lc3Cer\", \"N-acetyl-beta-D-glucosaminyl-(1->3)-beta-D-galactosyl-(1->4)-beta-D-glucosylceramide(d18:1(4E))\"], \"producedByEvent\": [10445745], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9846503\", \"stIdVersion\": \"R-ALL-9846503.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 205687, \"displayName\": \"UDP [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP\", \"UDP(3-)\", \"uridine 5'-diphosphate\"], \"producedByEvent\": [10445745], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-205687\", \"stIdVersion\": \"R-ALL-205687.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 425969, \"displayName\": \"H+ [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10445745], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-425969\", \"stIdVersion\": \"R-ALL-425969.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10445750, \"displayName\": \"B4GALT5/6 transfer Gal to GlcCer\", \"followingEvent\": [10445745], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"n