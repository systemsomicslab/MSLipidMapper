        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10368079], \"className\": \"CatalystActivity\", \"dbId\": 10368077, \"displayName\": \"RNA polymerase II cis-regulatory region sequence-specific DNA binding activity of RXRA [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10368079, \"displayName\": \"PPARA binds RXRA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10368076], \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10368079], \"dbId\": 10363772, \"displayName\": \"PPARA [nucleoplasm]\", \"endCoordinate\": 468, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPARA\", \"PPARA\", \"Q5EA13\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-400186\", \"stIdVersion\": \"R-BTA-400186.1\", \"startCoordinate\": 1}, {\"className\": \"OtherEntity\", \"consumedByEvent\": [10368079], \"dbId\": 422139, \"displayName\": \"Peroxisome Proliferator Receptor Element (PPRE) [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Peroxisome Proliferator Receptor Element (PPRE)\"], \"schemaClass\": \"OtherEntity\", \"stId\": \"R-ALL-422139\", \"stIdVersion\": \"R-ALL-422139.2\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10368079], \"dbId\": 10355466, \"displayName\": \"RXRA [nucleopla