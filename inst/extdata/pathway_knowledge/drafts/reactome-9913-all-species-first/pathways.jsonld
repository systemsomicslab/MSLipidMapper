      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10405578], \"className\": \"CatalystActivity\", \"dbId\": 10405576, \"displayName\": \"lipid carrier activity of FABPs [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10405578, \"displayName\": \"FABPs bind LCFAs\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10405578], \"dbId\": 10405573, \"displayName\": \"FABPs [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"FABPs\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-5334833\", \"stIdVersion\": \"R-BTA-5334833.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10405578], \"dbId\": 8876730, \"displayName\": \"LCFA(-) [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8876730\", \"stIdVersion\": \"R-ALL-8876730.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FABPs bind LCFAs\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10405575, \"displayName\": \"FABPs:LCFA [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"FABPs:LCFA\"], \"producedByEvent\": [10405578], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-5334829\", \"stIdVersion\": \"R-BTA-5334829.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-5334794\", \"stIdVersion\": \"R-BTA-5334794.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = '