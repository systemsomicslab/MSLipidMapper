    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "ATP [cytosol] + HCO3- [cytosol] + Ac-CoA [cytosol] => ADP [cytosol] + H+ [cytosol] + Mal-CoA [cytosol] + Pi [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10430729], \"className\": \"CatalystActivity\", \"dbId\": 10430727, \"displayName\": \"acetyl-CoA carboxylase activity of Btn-ACACB:2Mn2+ polymer [mitochondrial outer membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005741\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17906, \"definition\": \"The outer, i.e. cytoplasm-facing, lipid bilayer of the mitochondrial envelope.\", \"displayName\": \"mitochondrial outer membrane\", \"name\": \"mitochondrial outer membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005741\"}], \"dbId\": 10430729, \"displayName\": \"Btn-ACACB:2Mn2+ polymer carboxylates Ac-CoA to form Mal-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0055089\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 260763, \"definition\": \"Any process involved in the maintenance of an internal steady state of fatty acid within an organism or cell.\", \"displayName\": \"fatty acid homeostasis\", \"name\": \"fatty acid homeostasis\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0055089\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10430729], \"dbId\": 76183, \"displayName\": \"Ac-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ac-CoA\", \"acetyl-CoA(4-)\", \"Acetyl coenzyme A\", \"acetyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76183\", \"stIdVersion\": \"R-ALL-76183.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10430729], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10430729], \"dbId\": 111627, \"displayName\": \"HCO3- [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HCO3-\", \"hydrogencarbonate\", \"bicarbonate\", \"acid carbonate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111627\", \"stIdVersion\": \"R-ALL-111627.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Btn-ACACB:2Mn2+ polymer carboxylates Ac-CoA to form Mal-CoA\", \"acetyl-CoA + ATP + hydrogencarbonate => ADP + H(+) + malonyl-CoA + phosphate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [10430729], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [10430729], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29508, \"displayName\": \"Mal-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Mal-CoA\", \"malonyl-CoA(5-)\", \"Malonyl coenzyme A\", \"malonyl-CoA\"], \"producedByEvent\": [10430729], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29508\", \"stIdVersion\": \"R-ALL-29508.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [10430729], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10344939, \"displayName\": \"ACLY tetramer transforms CIT to Ac-CoA\", \"followingEvent\": [10430729], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer transforms CIT to Ac-CoA\", \"ATP + citrate + CoA => acetyl-CoA + ADP + oxaloacetate + phosphate\", \"Generation of Cytoplasmic Acetyl CoA from Citrate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-75848\", \"stIdVersion\": \"R-BTA-75848.1\"}], \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 539127, \"displayName\": \"Positive regulation by 'CIT [cytosol]'\", \"regulatedEntity\": [10430729], \"schemaClass\": \"PositiveRegulation\", \"stId\": \"R-HSA-539127\", \"stIdVersion\": \"R-HSA-539127.1\"}, {\"className\": \"PositiveRegulation\", \"dbId\": 10344977, \"displayName\": \"Positive regulation by 'MID1IP1:THRSP [cytosol]'\", \"regulatedEntity\": [10430729], \"schemaClass\": \"PositiveRegulation\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-8876889\", \"stIdVersion\": \"R-BTA-8876889.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.panthe