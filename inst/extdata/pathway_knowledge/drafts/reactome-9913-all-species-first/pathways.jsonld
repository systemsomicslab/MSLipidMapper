      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "DPA-CoA [endoplasmic reticulum lumen] + NADPH [endoplasmic reticulum lumen] + Malonyl-CoA [endoplasmic reticulum lumen] => NADP+ [endoplasmic reticulum lumen] + CoA-SH [endoplasmic reticulum lumen] + TPA-CoA [endoplasmic reticulum lumen] + CO2 [endoplasmic reticulum lumen] + H2O [endoplasmic reticulum lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10391936], \"className\": \"CatalystActivity\", \"dbId\": 10391934, \"displayName\": \"fatty acid elongase activity of ELOVL2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10391936, \"displayName\": \"Elongation of docosapentaenoyl-CoA to tetracosapentaenoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10391936], \"dbId\": 2046057, \"displayName\": \"DPA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DPA-CoA\", \"(7Z,10Z,13Z,16Z,19Z)-docosapentaenoyl-CoA\", \"7Z,10Z,13Z,16Z,19Z-docosapentaenoyl-CoA (DPA-CoA)\", \"docosapentaenoyl-CoA\", \"7,10,13,16,19-22:5(n-3)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046057\", \"stIdVersion\": \"R-ALL-2046057.4\"}, {\"className\": \"Chemical Compound\", \"c