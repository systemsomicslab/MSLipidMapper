      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10341388], \"className\": \"CatalystActivity\", \"dbId\": 10341386, \"displayName\": \"methylmalonyl-CoA epimerase activity of MCEE [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10341388, \"displayName\": \"D-methylmalonyl-CoA <=> L-methylmalonyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10341381], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10341388], \"dbId\": 71019, \"displayName\": \"MEMA-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MEMA-CoA\", \"(S)-methylmalonyl-CoA(5-)\", \"(S)-2-methyl-3-oxopropanoyl-CoA\", \"D-methylmalonyl-CoA\", \"(S)-methylmalonyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-71019\", \"stIdVersion\": \"R-ALL-71019.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"D-methylmalonyl-CoA <=> L-methylmalonyl-CoA\", \"(S)-methylmalonyl-CoA => (R)-methylmalonyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 71009, \"displayName\": \"L-MM-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"L-MM-CoA\", \"(R)-methylmalonyl-CoA(5-)\", \"L-methylmalonyl-CoA\", \"(R)-methylmalonyl-CoA\", \"(R)-2-methyl-3-oxopropanoyl-CoA\"], \"producedByEvent\": [10341388], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-71009\", \"stIdVersion\": \"R-ALL-71009.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10341404, \"displayName\": \"propionyl-CoA + CO2 + ATP <=> D-methylmalonyl-CoA + ADP + orthophosphate\", \"followingEvent\": [10341388], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"propionyl-CoA + CO2 + ATP <=> D-methylmalonyl-CoA + ADP + orthophosphate\", \"propanoyl-CoA + hydrogencarbonate + ATP => (S)-methylmalonyl-CoA + ADP + phosphate + H(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-71031\", \"stIdVersion\": \"R-BTA-71031.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-71020\", \"stIdVersion\": \"R-BTA-71020.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to all