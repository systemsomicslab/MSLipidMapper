    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005635\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13231, \"definition\": \"The double lipid bilayer that encloses the nucleus, separating its contents from the cytoplasm. It consists of an inner and outer nuclear membrane, with an intermembrane space (20-40 nm wide, also called the perinuclear space) between them. The envelope is supported by the nuclear lamina and contains nuclear pore complexes, which regulate molecular transport.\", \"displayName\": \"nuclear envelope\", \"name\": \"nuclear envelope\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005635\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10441255, \"displayName\": \"ALOX5 binds ALOX5 inhibitors\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10441255], \"dbId\": 10361859, \"displayName\": \"ALOX5:ALOX5AP:LTC4S [nuclear envelope]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"ALOX5:ALOX5AP:LTC4S\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-2318764\", \"stIdVersion\": \"R-BTA-2318764.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10441255], \"dbId\": 9707237, \"displayName\": \"ALOX5 inhibitors [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"ALOX5 inhibitors\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9707237\", \"stIdVersion\": \"R-ALL-9707237.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX5 binds ALOX5 inhibitors\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10441253, \"displayName\": \"ALOX5:ALOX5 inhibitors [nuclear envelope]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"ALOX5:ALOX5 inhibitors\"], \"producedByEvent\": [10441255], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9707188\", \"stIdVersion\": \"R-BTA-9707188.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-9707186\", \"stIdVersion\": \"R-BTA-9707186.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
