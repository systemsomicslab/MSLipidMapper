    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10392165, \"displayName\": \"SREBP1A,1C,2 binds SREBP1A,1C,2 forming dimers\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10392168], \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10392165, 10392165], \"dbId\": 10387032, \"displayName\": \"SREBF1A,1C,2 cleaved by S2P [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"SREBF1A,1C,2 cleaved by S2P\", \"SREBP1A,1C,2 cleaved by S2P\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1655732\", \"stIdVersion\": \"R-BTA-1655732.1\"}, 10387032], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SREBP1A,1C,2 binds SREBP1A,1C,2 forming dimers\", \"SREBF1A,1C,2 binds SREBF1A,1C,2 forming dimers\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10387034, \"displayName\": \"SREBP1A,1C,2 dimer [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"SREBP1A,1C,2 dimer\"], \"producedByEvent\": [10392165], \"schemaClass\": \"Complex\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-2065548\", \"stIdVersion\": \"R-BTA-2065548.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10387076, \"displayName\": \"S2P hydrolyzes SREBP1A,1C,2\", \"followingEvent\": [10392165], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"S2P hydrolyzes SREBP1A,1C,2\", \"S2P hydrolyzes SREBF1A,1C,2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-1655851\", \"stIdVersion\": \"R-BTA-1655851.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"BTA\", \"className\": \"Species\", \"dbId\": 48898, \"displayName\": \"Bos taurus\", \"name\": [\"Bos taurus\", \"B. taurus\", \"Bt\", \"bovine\", \"cattle\", \"cow\", \"domestic cattle\", \"domestic cow\"], \"schemaClass\": \"Species\", \"taxId\": \"9913\"}], \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-2065549\", \"stIdVersion\": \"R-BTA-2065549.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
