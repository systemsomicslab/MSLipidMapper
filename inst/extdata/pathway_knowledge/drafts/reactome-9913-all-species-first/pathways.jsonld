        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10405707], \"className\": \"CatalystActivity\", \"dbId\": 10405705, \"displayName\": \"bile acid nuclear receptor activity of NR1H4 [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10405707, \"displayName\": \"NR1H4 binds DCA, CDCA, LCHA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10405732], \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10405707], \"dbId\": 5340249, \"displayName\": \"DCA,CDCA,LCHA [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"DCA,CDCA,LCHA\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-5340249\", \"stIdVersion\": \"R-ALL-5340249.1\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10405707], \"dbId\": 10355470, \"displayName\": \"NR1H4 [nucleoplasm]\", \"endCoordinate\": 486, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NR1H4\", \"NR1H4\", \"F1MTT1\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Bos taurus\", \"stId\": \"R-BTA-5340228\", \"stIdVersion\": \"R-BTA-5340228.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NR1H4 binds DCA, CDCA, LCHA\", \"FXR binds bile acids\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10355472, \"displayName\": \"NR1