    mslm:evidenceJson "{\"catalystActivity\": [{\"catalyzedEvent\": [10850311], \"className\": \"CatalystActivity\", \"dbId\": 10850309, \"displayName\": \"Delta14-sterol reductase activity of LBR [nuclear envelope]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005635\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13231, \"definition\": \"The double lipid bilayer that encloses the nucleus, separating its contents from the cytoplasm. It consists of an inner and outer nuclear membrane, with an intermembrane space (20-40 nm wide, also called the perinuclear space) between them. The envelope is supported by the nuclear lamina and contains nuclear pore complexes, which regulate molecular transport.\", \"displayName\": \"nuclear envelope\", \"name\": \"nuclear envelope\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005635\"}], \"dbId\": 10850311, \"displayName\": \"4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol is reduced to 4,4-dimethylcholesta-8(9),24-dien-3beta-ol [LBR]\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10850311], \"dbId\": 194681, \"displayName\": \"4,4DMCHtOL [nuclear envelope]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4,4DMCHtOL\", \"4,4-dimethyl-5alpha-cholesta-8,14,24-trien-3beta-ol\", \"4,4DMCHOLtrienol\", \"4,4-dimethylcholesta-8(9),14,24-trien-3beta-ol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194681\", \"stIdVersion\": \"R-ALL-194681.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10850311], \"dbId\": 194725, \"displayName\": \"NADPH [nuclear envelope]\", \"