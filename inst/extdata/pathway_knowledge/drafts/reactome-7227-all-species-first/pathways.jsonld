        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10850068], \"className\": \"CatalystActivity\", \"dbId\": 10850066, \"displayName\": \"steroid hydroxylase activity of CYP19A1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10850068, \"displayName\": \"CYP19A1 hydroxylates ANDST to E1\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10850068], \"dbId\": 193079, \"displayName\": \"ANDST [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ANDST\", \"androst-4-ene-3,17-dione\", \"4-Androstene-3, 17-dione\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193079\", \"stIdVersion\": \"R-ALL-193079.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10850068, 10850068, 10850068], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": fals