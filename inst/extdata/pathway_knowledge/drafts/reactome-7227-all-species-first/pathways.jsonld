      {
        "@value": "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10871582, \"displayName\": \"SREBP1A,1C,2 translocates to the nucleus\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0006606\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 11054, \"definition\": \"The directed movement of a protein from the cytoplasm to the nucleus.\", \"displayName\": \"protein import into nucleus\", \"name\": \"protein import into nucleus\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006606\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10871582], \"dbId\": 10871570, \"displayName\": \"SREBP1A,1C,2:Importin beta-1 [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"SREBP1A,1C,2:Importin beta-1\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-2065556\", \"stIdVersion\": \"R-DME-2065556.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SREBP1A,1C,2 translocates to the nucleus\", \"SREBF1A,1C,2 translocates to the nucleus\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10871580, \"displayName\": \"SREBP1A,1C,2:Importin beta-1 [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"SREBP1A,1C,2:Importin beta-1\"], \"producedByEvent\": [10871582], \"schemaClass\": \"Complex\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-2065543\", \"stIdVersion\": \"R-DME-2065543.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10877135, \"displayName\": \"SREBP1A,1C,2 binds Importin beta-1\", \"followingEvent\": [10871582], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SREBP1A,1C,2 binds Importin beta-1\", \"SREBF1A,1C,2 binds Importin beta-1\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-2065550\", \"stIdVersion\": \"R-DME-2065550.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"DME\", \"className\": \"Species\", \"dbId\": 56210, \"displayName\": \"Drosophila melanogaster\", \"name\": [\"Drosophila melanogaster\", \"D. melanogaster\", \"Dm\", \"fruit fly\"], \"schemaClass\": \"Species\", \"taxId\": \"7227\"}], \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-1655831\", \"stIdVersion\": \"R-DME-1655831.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level