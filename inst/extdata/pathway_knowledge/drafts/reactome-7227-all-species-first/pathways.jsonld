isplayName\": \"MCFA-CoA, LCFA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"MCFA-CoA, LCFA-CoA\", \"medium/long chain fatty acyl-CoA\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-5690520\", \"stIdVersion\": \"R-ALL-5690520.2\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD4,5 bind MCFA-CoA and LCFA-CoA\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10901239, \"displayName\": \"ACBD4,5:LCFA-CoA, MCFA-CoA [peroxisomal membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"ACBD4,5:LCFA-CoA, MCFA-CoA\"], \"producedByEvent\": [10901242], \"schemaClass\": \"Complex\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8866017\", \"stIdVersion\": \"R-DME-8866017.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DME\", \"className\": \"Species\", \"dbId\": 56210, \"displayName\": \"Drosophila melanogaster\", \"name\": [\"Drosophila melanogaster\", \"D. melanogaster\", \"Dm\", \"fruit fly\"], \"schemaClass\": \"Species\", \"taxId\": \"7227\"}], \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8848247\", \"stIdVersion\": \"R-DME-8848247.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' 