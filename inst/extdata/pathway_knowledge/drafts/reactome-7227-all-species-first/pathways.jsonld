    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "CoA-SH [cytosol] + ATP [cytosol] + THCA [cytosol] => 25(R) THCA-CoA [cytosol] + AMP [cytosol] + PPi [cytosol]"
      }
