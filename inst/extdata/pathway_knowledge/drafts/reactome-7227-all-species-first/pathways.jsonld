        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10857132], \"className\": \"CatalystActivity\", \"dbId\": 10850126, \"displayName\": \"oxidoreductase activity, acting on the CH-OH group of donors, NAD or NADP as acceptor of HSD17B4 dimer [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10857132, \"displayName\": \"HSD17B4 dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10857132], \"dbId\": 390248, \"displayName\": \"3-hydroxyhexacosanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3-hydroxyhexacosanoyl-CoA\", \"(R)-3-hydroxyhexacosanoyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390248\", \"stIdVersion\": \"R-ALL-390248.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10857132], \"dbId\": 192307, \"displayName\": \"NAD+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192307\", \"stIdVersion\": \"R-ALL-192307.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B4 dehydrogenates 3-hydroxyhexacosanoyl-CoA\", \"3R)-hydroxyhexacosanoyl-CoA + NAD(+) => 3-oxohexacosanoyl-CoA + H(+) + NADH\", \"3-hydroxyhexacosanoyl-CoA + NAD+ => 3-ketohexacosanoyl-CoA + NADH + H+ (HSD17B4)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 390241, \"displayName\": \"3-ketohexacosanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3-ketohexacosanoyl-CoA\", \"3-oxohexacosanoyl-CoA(4-)\", \"3-oxohexacosanoyl-CoA\"], \"producedByEvent\": [10857132], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-390241\", \"stIdVersion\": \"R-ALL-390241.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 192305, \"displayName\": \"NADH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [10857132], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192305\", \"stIdVersion\": \"R-ALL-192305.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10857132], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10857134, \"displayName\": \"HSD17B4 hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"followingEvent\": [10857132], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HSD17B4 hydrates trans-2,3-dehydrohexacosanoyl-CoA\", \"(2E)-hexacosenoyl-CoA + H2O => (3R)-hydroxyhexacosanoyl-CoA\", \"trans-2,3-dehydrohexacosanoyl-CoA + H2O => 3-hydroxyhexacosanoyl-CoA\"], \"releaseDate\": \"2026-