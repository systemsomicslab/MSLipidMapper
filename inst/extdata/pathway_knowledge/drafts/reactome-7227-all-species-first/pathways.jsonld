      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "NADPH [endoplasmic reticulum lumen] + Malonyl-CoA [endoplasmic reticulum lumen] + EPA-CoA [endoplasmic reticulum lumen] => NADP+ [endoplasmic reticulum lumen] + DPA-CoA [endoplasmic reticulum lumen] + H2O [endoplasmic reticulum lumen] + CoA-SH [endoplasmic reticulum lumen] + CO2 [endoplasmic reticulum lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10876814], \"className\": \"CatalystActivity\", \"dbId\": 10876796, \"displayName\": \"fatty acid elongase activity of ELOVL5/ELOVL2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}], \"dbId\": 10876814, \"displayName\": \"Elongation of eicosapentaenoyl-CoA to docosapentaenoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10876806], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10876814], \"dbId\": 2046059, \"displayName\": \"EPA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"EPA-CoA\", \"(5Z,8Z,11Z,14Z,17Z)-icosapentaenoyl-CoA\", \"5Z,8Z,11Z,14Z,17Z-eicosapentaenoyl-CoA\", \"5,8,11,14,17-20:5(n-3)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046059\", \"stIdVersion\": \"R-ALL-2046059.4\"}, {\"className\": \"Chemical Compound\", \"consu