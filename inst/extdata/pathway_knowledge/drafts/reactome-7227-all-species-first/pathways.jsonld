    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "NAD+ [peroxisomal matrix] + Pristanal [peroxisomal matrix] + H2O [peroxisomal matrix] => H+ [peroxisomal matrix] + NADH [peroxisomal matrix] + pristanate [peroxisomal matrix]"
