    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10872001], \"className\": \"CatalystActivity\", \"dbId\": 10871999, \"displayName\": \"phosphatidylinositol-3-phosphate phosphatase activity of MTM1,MTMR2,MTMR4 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0031901\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 171062, \"definition\": \"The lipid bilayer surrounding an early endosome.\", \"displayName\": \"early endosome membrane\", \"name\": \"early endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031901\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10872001, \"displayName\": \"PI3P is dephosphorylated to PI by MTM proteins at the early endosome membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10871898], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10872001], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10872001], \"dbId\": 1806200, \"displayName\": \"PI3P [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI3P\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate(3-)\", \"PtdIns3P\", \"1-phosphatidyl-1D-myo-inositol 3-phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806200\", \"stIdVersion\": \"R-ALL-1806200.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI3P is dephosphorylated to PI by MTM proteins at the early endosome membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1806199, \"displayName\": \"PI [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI\", \"1-phosphatidyl-1D-myo-inositol(1-)\", \"Phosphatidyl 1D-myo-inositol\", \"1-phosphatidyl-1D-myo-inositol\"], \"producedByEvent\": [10872001], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806199\", \"stIdVersion\": \"R-ALL-1806199.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [10872001], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10872024, \"displayName\": \"PI(3,4)P2 is dephosphorylated to PI3P by INPP4A/B at the early endosome membrane\", \"followingEvent\": [10872001], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(3,4)P2 is dephosphorylated to PI3P by INPP4A/B at the early endosome membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-1676162\", \"stIdVersion\": \"R-DME-1676162.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10871898, \"displayName\": \"PI is phosphorylated to PI3P by PIK3C2A/3 at the early endosome membrane\", \"followingEvent\": [10872001], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI is phosphorylated to PI3P by PIK3C2A/3 at the early endosome membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-1675939\", \"stIdVersion\": \"R-DME-1675939.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DME\", \"className\": \"Species\", \"dbId\": 56210, \"displayName\": \"Drosophila melanogaster\", \"name\": [\"Drosophila melanogaster\", \"D. melanogaster\", \"Dm\", \"fruit fly\"], \"schemaClass\": \"Species\", \"taxId\": \"7227\"}], \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-1676141\", \"stIdVersion\": \"R-DME-1676141.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntitie