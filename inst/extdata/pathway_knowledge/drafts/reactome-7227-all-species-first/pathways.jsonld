    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10872692], \"className\": \"CatalystActivity\", \"dbId\": 10872690, \"displayName\": \"glucosylceramidase activity of GBA3 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10872692, \"displayName\": \"GBA3 hydrolyzes GlcCer (cytosol)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10872692], \"dbId\": 1861764, \"displayName\": \"GlcCer [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GlcCer\", \"beta-D-glucosyl-N-acylsphingosine\", \"Glucosylceramide\", \"Glucocerebroside\", \"D-glucosyl-N-acylsphingosine\", \"D-glucosy-N-acylsphingosine\", \"D-glucosyl-N-acylsphingoid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1861764\", \"stIdVersion\": \"R-ALL-1861764.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10872692], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA3 hydrolyzes GlcCer (cytosol)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 194377, \"displayName\": \"CERA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CERA\", \"N-acylsphingoid\", \"Ceramide\"], \"producedByEvent\": [10872692], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194377\", \"stIdVersion\": \"R-ALL-194377.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70113, \"displayName\": \"Glc [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Glc\", \"D-glucopyranose\", \"D-glucose\"], \"producedByEvent\": [10872692], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70113\", \"stIdVersion\": \"R-ALL-70113.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DME\", \"className\": \"Species\", \"dbId\": 56210, \"displayName\": \"Drosophila melanogaster\", \"name\": [\"Drosophila melanogaster\", \"D. melanogaster\", \"Dm\", \"fruit fly\"], \"schemaClass\": \"Species\", \"taxId\": \"7227\"}], \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-1861789\", \"stIdVersion\": \"R-DME-1861789.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
