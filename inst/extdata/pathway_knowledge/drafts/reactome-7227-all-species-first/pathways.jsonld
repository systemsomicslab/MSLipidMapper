        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10850215], \"className\": \"CatalystActivity\", \"dbId\": 10849936, \"displayName\": \"steroid Delta-isomerase activity of HSD3B1 dimer, HSD3B2 dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10850215, \"displayName\": \"Pregn-5-ene-3,20-dione-17-ol isomerizes to 17-hydroxyprogesterone\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10850215], \"dbId\": 196366, \"displayName\": \"pregn-5-ene-3,20-dione-17-ol [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"pregn-5-ene-3,20-dione-17-ol\", \"17alpha-hydroxypregn-5-ene-3,20-dione\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-196366\", \"stIdVersion\": \"R-ALL-196366.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Preg