        "@value": "phospho-Dmel\\CG30392 [cytosol] + ATP [cytosol] => H+ [cytosol] + phospho-Dmel\\CG30392 [cytosol] + ADP [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10859799], \"className\": \"CatalystActivity\", \"dbId\": 10859797, \"displayName\": \"protein serine/threonine kinase activity of CSNK1G2 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10859799, \"displayName\": \"CSNK1G2 phosphorylates p-CERT1-2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10859799, 10859799], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}, 113592, {\"className\": \"Protein\", \"consumedByEvent\": [10859799], \"dbId\": 10859773, \"displayName\": \"phospho-Dmel\\\\CG30392 [cytosol]\", \"endCoordinate\": 598, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"phospho-Dmel\\\\CG30392\", \"p-S132-CERT1-2\", \"Q8MLW4\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-429704\", \"stIdVersion\": \"R-DME-429704.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \