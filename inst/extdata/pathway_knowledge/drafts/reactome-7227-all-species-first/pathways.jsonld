    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "20cho-LTB4 [cytosol] + H+ [cytosol] + NADPH [cytosol] + O2 [cytosol] => H2O [cytosol] + NADP+ [cytosol] + 20cooh-LTB4 [cytosol]"
