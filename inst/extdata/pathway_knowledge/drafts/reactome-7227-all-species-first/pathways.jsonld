ne]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"PPM1L:VAPA/B dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-429703\", \"stIdVersion\": \"R-DME-429703.1\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10859834], \"dbId\": 10859791, \"displayName\": \"phospho-Dmel\\\\CG30392 [cytosol]\", \"endCoordinate\": 624, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"phospho-Dmel\\\\CG30392\", \"p-S,S132,T-CERT1-2\", \"Q8MLW4\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-429695\", \"stIdVersion\": \"R-DME-429695.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPM1L dephosphorylates multiphospho-CERT1-2\", \"O-phospho-L-seryl/threonyl-(protein) + H2O => L-seryl/threonyl-(protein) + phosphate\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10859831, \"displayName\": \"CERT1-2:PPM1L:VAPA/B dimer [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 5, \"name\": [\"CERT1-2:PPM1L:VAPA/B dimer\"], \"producedByEvent\": [10859834], \"schemaClass\": \"Complex\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-429672\", \"stIdVersion\": \"R-DME-429672.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [10859834, 10859834, 10859834], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}, 29372, 29372], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DME\", \"className\": \"Species\", \"dbId\": 56210, \"displayName\": \"Drosophila melanogaster\", \"name\":