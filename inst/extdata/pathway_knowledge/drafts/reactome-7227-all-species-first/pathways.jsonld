    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10870310], \"className\": \"CatalystActivity\", \"dbId\": 10870308, \"displayName\": \"diacylglycerol cholinephosphotransferase activity of CEPT1:Mg2+/Mn2+ [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10870310, \"displayName\": \"CDP-Cho and DAG are converted to PC by CEPT1 at the ER membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10870293], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10870310], \"dbId\": 1500596, \"displayName\": \"DAG [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DAG\", \"1,2-diacyl-sn-glycerol\", \"1,2-diacylglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500596\", \"stIdVersion\": \"R-ALL-1500596.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10870310], \"dbId\": 1524060, \"displayName\": \"CDP-Cho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CDP-Cho\", \"CDP-choline\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524060\", \"stIdVersion\": \"R-ALL-1524060.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CDP-Cho and DAG are converted to PC by CEPT1 at the ER membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 426925, \"displayName\": \"PC [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PC\", \"1,2-diacyl-sn-glycero-3-phosphocholine\", \"Phosphatidyl choline\"], \"producedByEvent\": [10870310], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426925\", \"stIdVersion\": \"R-ALL-426925.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 109395, \"displayName\": \"CMP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CMP\", \"cytidine 5'-monophosphate(2-)\", \"cytidine 5'-monophosphate\", \"cytidylic acid\", \"Cytidine-5'-monophosphate\", \"CMP(2-)\"], \"producedByEvent\": [10870310], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109395\", \"stIdVersion\": \"R-ALL-109395.6\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10870395, \"displayName\": \"PCho and CTP are condensed to CDP-Cho by PCYT1 dimer\", \"followingEvent\": [10870310], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PCho and CTP are condensed to CDP-Cho by PCYT1 dimer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-1483081\", \"stIdVersion\": \"R-DME-1483081.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10870481, \"displayName\": \"PA is dephosphorylated to DAG by LPIN\", \"followingEvent\": [10870310], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PA is dephosphorylated to DAG by LPIN\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-1483203\", \"stIdVersion\": \"R-DME-1483203.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10870269, \"displayName\": \"TAG is hydrolyzed to DAG by PNPLA2/3\", \"followingEvent\": [10870310], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"TAG is hydrolyzed to DAG by PNPLA2/3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-1482777\", \"stIdVersion\": \"R-DME-1482777.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10870252, \"displayName\": \"2-MAG is transacylated to DAG by PNPLA2/3\", \"followingEvent\": [10870310], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-MAG is transacylated to DAG by PNPLA2/3\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-1482654\", \"stIdVersion\": \"R-DME-1482654.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DME\", \"className\": \"Species\", \"dbId\": 56210, \"displayName\": \"Drosophila melanogaster\", \"name\": [\"Drosophila melanogaster\", \"D. melanogaster\", \"Dm\", \"fruit fly\"], \"schemaClass\": \"Species\", \"taxId\": \"7227\"}], \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-1482961\", \"stIdVersion\": \"R-DME-1482961.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
