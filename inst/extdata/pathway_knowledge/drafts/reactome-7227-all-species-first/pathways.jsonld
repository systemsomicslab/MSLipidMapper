    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10912600, \"displayName\": \"PPARA binds fibrates\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10912600], \"dbId\": 9734495, \"displayName\": \"fibrates [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"fibrates\", \"PPARA agonists\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9734495\", \"stIdVersion\": \"R-ALL-9734495.1\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10912600], \"dbId\": 10857824, \"displayName\": \"PPARA:RXRA:Corepressors [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PPARA:RXRA:Corepressors\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-400196\", \"stIdVersion\": \"R-DME-400196.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA binds fibrates\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10912598, \"displayName\": \"PPARA:RXRA:fibrates [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PPARA:RXRA:fibrates\"], \"producedByEvent\": [10912600], \"schemaClass\": \"Complex\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-9734456\", \"stIdVersion\": \"R-DME-9734456.1\"}, {\"className\": \"Set\", \"dbId\": 10857820, \"displayName\": \"Corepressors of PPARalpha [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Corepressors of PPARalpha\"], \"producedByEvent\": [10912600], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-400207\", \"stIdVersion\": \"R-DME-400207.1\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10857879, \"displayName\": \"PPARA:RXRA binds Corepressors of PPARA\", \"followingEvent\": [10912600], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA:RXRA binds Corepressors of PPARA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-400183\", \"stIdVersion\": \"R-DME-400183.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DME\", \"className\": \"Species\", \"dbId\": 56210, \"displayName\": \"Drosophila melanogaster\", \"name\": [\"Drosophila melanogaster\", \"D. melanogaster\", \"Dm\", \"fruit fly\"], \"schemaClass\": \"Species\", \"taxId\": \"7227\"}], \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-9734475\", \"stIdVersion\": \"R-DME-9734475.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
