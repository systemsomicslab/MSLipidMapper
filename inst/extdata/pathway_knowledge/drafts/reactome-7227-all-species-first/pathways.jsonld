      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10857882], \"className\": \"CatalystActivity\", \"dbId\": 10857880, \"displayName\": \"RNA polymerase II cis-regulatory region sequence-specific DNA binding activity of RXRA [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10857882, \"displayName\": \"PPARA binds RXRA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10857879], \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10857882], \"dbId\": 10855989, \"displayName\": \"Eip75B [nucleoplasm]\", \"endCoordinate\": 468, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Eip75B\", \"PPARA\", \"P13055\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-400186\", \"stIdVersion\": \"R-DME-400186.1\", \"startCoordinate\": 1}, {\"className\": \"OtherEntity\", \"consumedByEvent\": [10857882], \"dbId\": 422139, \"displayName\": \"Peroxisome Proliferator Receptor Element (PPRE) [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Peroxisome Proliferator Receptor Element (PPRE)\"], \"schemaClass\": \"OtherEntity\", \"stId\": \"R-ALL-422139\", \"stIdVersion\": \"R-ALL-422139.2\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10857882], \"dbId\": 10850276, \"displayName\": \"