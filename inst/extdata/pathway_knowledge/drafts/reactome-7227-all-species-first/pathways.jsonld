    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10900091, \"displayName\": \"MTMR12 binds MTMR2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10900091], \"dbId\": 10871817, \"displayName\": \"MTMR2 [cytosol]\", \"endCoordinate\": 643, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MTMR2\", \"Q9VMI9\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-1604662\", \"stIdVersion\": \"R-DME-1604662.1\", \"startCoordinate\": 1}, {\"className\": \"Protein\", \"consumedByEvent\": [10900091], \"dbId\": 10900082, \"displayName\": \"Dmel\\\\CG14411 [cytosol]\", \"endCoordinate\": 747, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Dmel\\\\CG14411\", \"MTMR12\", \"Q9VY15\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-6809657\", \"stIdVersion\": \"R-DME-6809657.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MTMR12 binds MTMR2\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10900089, \"displayName\": \"MTMR2:MTMR12 [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"MTMR