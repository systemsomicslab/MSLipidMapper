    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10842962], \"className\": \"CatalystActivity\", \"dbId\": 10842954, \"displayName\": \"acyl-CoA dehydrogenase activity of ACADS tetramer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10842962, \"displayName\": \"Hexanoyl-CoA+FAD => trans-Hex-2-enoyl-CoA+FADH2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10842960], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10842962], \"dbId\": 113596, \"displayName\": \"FAD [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FAD\", \"FAD(3-)\", \"Flavin adenine dinucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113596\", \"stIdVersion\": \"R-ALL-113596.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10842962], \"dbId\": 77326, \"displayName\": \"HX-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HX-CoA\", \"hexanoyl-CoA(4-)\", \"hexanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77326\", \"stIdVersion\": \"R-ALL-77326.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10842962], \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Hexanoyl-CoA+FAD => trans-Hex-2-enoyl-CoA+FADH2\", \"hexanoyl-CoA + FAD + H(+) => (2E)-hexenoyl-CoA + FADH2\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 31649, \"displayName\": \"FADH2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FADH2\", \"FADH2(2-)\"], \"producedByEvent\": [10842962], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-31649\", \"stIdVersion\": \"R-ALL-31649.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 77324, \"displayName\": \"trans-Hex-2-enoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"trans-Hex-2-enoyl-CoA\", \"trans-hex-2-enoyl-CoA(4-)\"], \"producedByEvent\": [10842962], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77324\", \"stIdVersion\": \"R-ALL-77324.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10842964, \"displayName\": \"3-Oxooctanoyl-CoA+CoA-SH => Hexanoyl-CoA + acetyl-CoA\", \"followingEvent\": [10842962], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3-Oxooctanoyl-CoA+CoA-SH => Hexanoyl-CoA + acetyl-CoA\", \"3-oxooctanoyl-CoA + CoA => hexanoyl-CoA + acetyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-77329\", \"stIdVersion\": \"R-DME-77329.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DME\", \"className\": \"Species\", \"dbId\": 56210, \"displayName\": \"Drosophila melanogaster\", \"name\": [\"Drosophila melanogaster\", \"D. melanogaster\", \"Dm\", \"fruit fly\"], \"schemaClass\": \"Species\", \"taxId\": \"7227\"}], \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-77327\", \"stIdVersion\": \"R-DME-77327.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
