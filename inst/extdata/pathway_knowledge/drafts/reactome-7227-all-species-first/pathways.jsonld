    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10870351], \"className\": \"CatalystActivity\", \"dbId\": 10870349, \"displayName\": \"glycerone-phosphate O-acyltransferase activity of GNPAT [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005778\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17947, \"definition\": \"The lipid bilayer surrounding a peroxisome.\", \"displayName\": \"peroxisomal membrane\", \"name\": \"peroxisomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005778\"}], \"dbId\": 10870351, \"displayName\": \"DHAP is converted to 1-acyl GO3P by GNPAT\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10870351], \"dbId\": 75970, \"displayName\": \"DHAP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHAP\", \"glycerone phosphate(2-)\", \"glycerone phosphate\", \"dihydroxyacetone phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-75970\", \"stIdVersion\": \"R-ALL-75970.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10870351], \"dbId\": 1500578, \"displayName\": \"acyl-CoA [cytosol]\", \"inDisease\": false, \"maxDept