        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10870280], \"className\": \"CatalystActivity\", \"dbId\": 10870278, \"displayName\": \"1-acylglycerophosphocholine O-acyltransferase activity of TAZ [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 10870280, \"displayName\": \"CL and 1-acyl LPC are converted to MLCL and PC by TAZ (IM) (Reversible)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10870280], \"dbId\": 1524072, \"displayName\": \"cardiolipin [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"cardiolipin\", \"CL\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524072\", \"stIdVersion\": \"R-ALL-1524072.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10870280], \"dbId\": 1524079, \"displayName\": \"1-acyl LPC [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPC\", \"1-O-acyl-sn-glycero-3-phosphocholine(1+)\", \"2-lysophosphatidylcholine\", \"1-acyl-sn-glycero-3-phosphocholines\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524079\", \"stIdVersion\": \"R-ALL-1524079.4