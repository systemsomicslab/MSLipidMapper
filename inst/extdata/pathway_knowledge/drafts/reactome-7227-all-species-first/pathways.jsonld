ucedByEvent\": [10876812], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-162743\", \"stIdVersion\": \"R-ALL-162743.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113519, \"displayName\": \"H2O [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10876812], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113519\", \"stIdVersion\": \"R-ALL-113519.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10876798, \"displayName\": \"Elongation of arachidonyl-CoA to docosatetraenoyl-CoA\", \"followingEvent\": [10876812], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Elongation of arachidonyl-CoA to docosatetraenoyl-CoA\", \"arachidonoyl-CoA + malonyl-CoA => 3-oxo-(7,10,13,16)-docosatetraenoyl-CoA + CO2 + CoASH [ELOVL5]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-2046083\", \"stIdVersion\": \"R-DME-2046083.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DME\", \"className\": \"Species\", \"dbId\": 56210, \"displayName\": \"Drosophila melanogaster\", \"name\": [\"Drosophila melanogaster\", \"D. melanogaster\", \"Dm\", \"fruit fly\"], \"schemaClass\": \"Species\", \"taxId\": \"7227\"}], \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-2046095\", \"stIdVersion\": \"R-DME-2046095.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at