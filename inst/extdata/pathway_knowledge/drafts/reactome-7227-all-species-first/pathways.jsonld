    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10854935], \"className\": \"CatalystActivity\", \"dbId\": 10854931, \"displayName\": \"acetylcholinesterase activity of Cholinesterase [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}, {\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10854935, \"displayName\": \"AcCho is hydrolyzed to Cho and acetate by ACHE\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0006581\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 19389, \"definition\": \"The chemical reactions and pathways resulting in the breakdown of acetylcholine, the acetic acid ester of the organic base choline.\", \"displayName\": \"acetylcholine catabolic process\", \"name\": \"acetylcholine catabolic process\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006581\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10854935], \"dbId\": 372533, \"displayName\": \"AcCho [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AcCho\", \"acetylcholine\", \"O-acetylcholine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-372533\", \"stIdVersion\": \"R-ALL-372533.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10854935], \"dbId\": 109276, \"displayName\": \"H2O [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109276\", \"stIdVersion\": \"R-ALL-109276.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AcCho is hydrolyzed to Cho and acetate by ACHE\", \"Acetylcholine clearance from synaptic cleft\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 264638, \"displayName\": \"Cho [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Cho\", \"choline\"], \"producedByEvent\": [10854935], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-264638\", \"stIdVersion\": \"R-ALL-264638.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524044, \"displayName\": \"acetate [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"acetate\"], \"producedByEvent\": [10854935], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524044\", \"stIdVersion\": \"R-ALL-1524044.2\"}], \"regulatedBy\": [{\"className\": \"NegativeRegulation\", \"dbId\": 10854936, \"displayName\": \"Negative regulation by 'ACHE:ACHEIs [plasma membrane]'\", \"regulatedEntity\": [10854935], \"schemaClass\": \"NegativeRegulation\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DME\", \"className\": \"Species\", \"dbId\": 56210, \"displayName\": \"Drosophila melanogaster\", \"name\": [\"Drosophila melanogaster\", \"D. melanogaster\", \"Dm\", \"fruit fly\"], \"schemaClass\": \"Species\", \"taxId\": \"7227\"}], \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-372519\", \"stIdVersion\": \"R-DME-372519.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pan