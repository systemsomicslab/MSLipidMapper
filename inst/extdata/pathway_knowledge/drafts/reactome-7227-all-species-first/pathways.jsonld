    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10915004], \"className\": \"CatalystActivity\", \"dbId\": 10915002, \"displayName\": \"phosphatidylethanolamine binding activity of PSAP(195-273) dimer [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}, {\"accession\": \"0097488\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 3828048, \"definition\": \"The lipid bilayer surrounding a multivesicular body internal vesicle.\", \"displayName\": \"multivesicular body, internal vesicle membrane\", \"name\": \"multivesicular body, internal vesicle membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0097488\"}], \"dbId\": 10915004, \"displayName\": \"PSAP(195-273) dimer binds PE\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10914935], \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10915004], \"dbId\": 10871228, \"displayName\": \"PSAP(195-273) dimer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PSAP(195-273) dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-9840482\", \"stIdVersion\": \"R-DME-9840482.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10915004], \"dbId\": 9840942, \"displayName\": \"PE 30,32,34 [multivesicular body, internal vesicle membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PE 30,32,34\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9840942\", \"stIdVersion\": \"R-ALL-9840942.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PSAP(195-273) dimer binds PE\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10914930, \"displayName\": \"PSAP(195-273):PE [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"PSAP(195-273):PE\"], \"producedByEvent\": [10915004], \"schemaClass\": \"Complex\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-9842117\", \"stIdVersion\": \"R-DME-9842117.1\"}], \"precedingEvent\": [{\"category\": \"binding\", \"className\": \"Reaction\", \"dbId\": 10914937, \"displayName\": \"PSAP(195-273) forms a dimer\", \"followingEvent\": [10915004], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PSAP(195-273) forms a dimer\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-9840488\", \"stIdVersion\": \"R-DME-9840488.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DME\", \"className\": \"Species\", \"dbId\": 56210, \"displayName\": \"Drosophila melanogaster\", \"name\": [\"Drosophila melanogaster\", \"D. melanogaster\", \"Dm\", \"fruit fly\"], \"schemaClass\": \"Species\", \"taxId\": \"7227\"}], \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-9842115\", \"stIdVersion\": \"R-DME-9842115.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
