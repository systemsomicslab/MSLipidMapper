    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H+ [cytosol] + 1,25(OH)2D [cytosol] + NADPH [cytosol] + O2 [cytosol] => H2O [cytosol] + NADP+ [cytosol] + CTA [cytosol]"
