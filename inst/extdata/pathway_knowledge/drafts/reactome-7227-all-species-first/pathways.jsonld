    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10907156], \"className\": \"CatalystActivity\", \"dbId\": 10907154, \"displayName\": \"A2-type glycerophospholipase activity of PLA2G15 [extracellular region]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 10907156, \"displayName\": \"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10907156], \"dbId\": 2173763, \"displayName\": \"lysoPC [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"lysoPC\", \"lysophosphatidylcholine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2173763\", \"stIdVersion\": \"R-ALL-2173763.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10907156], \"dbId\": 109276, \"displayName\": \"H2O [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109276\", \"stIdVersion\": \"R-ALL-109276.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLA2G15 hydrolyses LPC to GPCho and LCFA(-)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8952253, \"displayName\": \"GPCho [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GPCho\", \"choline alfoscerate\", \"glycerophosphorylcholine\"], \"producedByEvent\": [10907156], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8952253\", \"stIdVersion\": \"R-ALL-8952253.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 8954142, \"displayName\": \"LCFA(-) [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LCFA(-)\", \"long-chain fatty acid anion\"], \"producedByEvent\": [10907156], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8954142\", \"stIdVersion\": \"R-ALL-8954142.3\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DME\", \"className\": \"Species\", \"dbId\": 56210, \"displayName\": \"Drosophila melanogaster\", \"name\": [\"Drosophila melanogaster\", \"D. melanogaster\", \"Dm\", \"fruit fly\"], \"schemaClass\": \"Species\", \"taxId\": \"7227\"}], \"speciesName\": \"Drosophila melanogaster\", \"stId\": \"R-DME-8952251\", \"stIdVersion\": \"R-DME-8952251.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
