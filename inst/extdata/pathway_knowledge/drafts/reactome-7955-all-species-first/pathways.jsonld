      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10580708], \"className\": \"CatalystActivity\", \"dbId\": 10580303, \"displayName\": \"steroid dehydrogenase activity, acting on the CH-OH group of donors, NAD or NADP as acceptor of HSD3B7 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10580708, \"displayName\": \"Cholest-5-ene-3beta,7alpha,27-triol is oxidized and isomerized to 4-cholesten-7alpha,27-diol-3-one\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10580710], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10580708], \"dbId\": 192194, \"displayName\": \"Cholest-5-ene-3beta,7alpha,27-triol [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Cholest-5-ene-3beta,7alpha,27-triol\", \"7alpha,26-dihydroxycholesterol\", \"5-Cholesten-3beta,7alpha,27-triol\"], \"referenceType\": \"ReferenceMolecule\", \"schema