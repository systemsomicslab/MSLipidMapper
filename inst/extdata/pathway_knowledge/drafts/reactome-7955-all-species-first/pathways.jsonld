    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "acyl-CoA [mitochondrial matrix] + Ac-CoA [mitochondrial matrix] => CoA-SH [mitochondrial matrix] + 3OA-CoA [mitochondrial matrix]"
