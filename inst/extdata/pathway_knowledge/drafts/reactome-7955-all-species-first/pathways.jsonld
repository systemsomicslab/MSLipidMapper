    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H2O [peroxisomal matrix] + Pristanal [peroxisomal matrix] + NAD+ [peroxisomal matrix] => pristanate [peroxisomal matrix] + H+ [peroxisomal matrix] + NADH [peroxisomal matrix]"
