        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10574771], \"className\": \"CatalystActivity\", \"dbId\": 10574769, \"displayName\": \"peroxidase activity of PTGS1 dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10574771, \"displayName\": \"PGG2 is reduced to PGH2 by PTGS1\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10574771], \"dbId\": 140357, \"displayName\": \"PGG2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGG2\", \"prostaglandin G2(1-)\", \"prostaglandin G2\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-140357\", \"stIdVersion\": \"R-ALL-140357.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10574771], \"dbId\": 9915557, \"displayName\": \"hydrogen donor [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\":