      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10654541], \"className\": \"CatalystActivity\", \"dbId\": 10582344, \"displayName\": \"carnitine:O-acyl-L-carnitine antiporter activity of SLC25A20 [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 10654541, \"displayName\": \"SLC25A20 exports excess acyl-CAR\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10654541], \"dbId\": 9971097, \"displayName\": \"Acyl-CAR [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Acyl-CAR\", \"O-Acyl-L-carnitines\", \"acylcarnitines\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9971097\", \"stIdVersion\": \"R-ALL-9971097.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10654541], \"dbId\": 549207, \"displayName\": \"CAR [mitochondrial intermembrane space]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CAR\", \"(R)-carnitine\", \"gamma-Trimethyl-hydroxybutyrobetaine\", \"carnitine\", \"3-Hydroxy-4-trimethylammoniobutanoate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-549207\", \"stIdVersion\": \"R-ALL-549207.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC25A20 exports excess acyl-CAR\"], \"output\": [{\"className\": \"Set\", \"dbId\": 9971099, \"displayName\": \"Acyl-CAR [mitochondrial intermembrane space]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Acyl-CAR\", \"O-Acyl-L-carnitines\", \"acylcarnitines\"], \"producedByEvent\": [10654541], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9971099\", \"stIdVersion\": \"R-ALL-9971099.1\"}, {\"className\": \"Chemical Compound\", \"dbId\": 201023, \"displayName\": \"CAR [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CAR\", \"(R)-carnitine\", \"gamma-Trimethyl-hydroxybutyrobetaine\", \"carnitine\", \"3-Hydroxy-4-trimethylammoniobutanoate\"], \"producedByEvent\": [10654541], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-201023\", \"stIdVersion\": \"R-ALL-201023.4\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DRE\", \"className\": \"Species\", \"dbId\": 68323, \"displayName\": \"Danio rerio\", \"name\": [\"Danio rerio\", \"D.rerio\", \"D. rerio\", \"Dr\", \"Brachydanio rerio\", \"zebrafish\", \"zebra fish\"], \"schemaClass\": \"Species\", \"taxId\": \"7955\"}], \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9971094\", \"stIdVersion\": \"R-DRE-9971094.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reac