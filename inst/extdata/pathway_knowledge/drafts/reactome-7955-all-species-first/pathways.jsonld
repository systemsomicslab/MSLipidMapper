        "@value": "H+ [cytosol] + O2 [cytosol] + NADPH [cytosol] + ANDST [cytosol] => H+ [cytosol] + NADP+ [cytosol] + HCOOH [cytosol] + H2O [cytosol] + E1 [cytosol]"
