        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10635532], \"className\": \"CatalystActivity\", \"dbId\": 10635530, \"displayName\": \"glycerophosphoinositol glycerophosphodiesterase activity of GDE1 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10635532, \"displayName\": \"GDE1 hydrolyzes GroPIns\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10635532], \"dbId\": 6813734, \"displayName\": \"GroPIns [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GroPIns\", \"1-(sn-glycero-3-O-phosphonato)-1D-myo-inositol\", \"sn-glycero-3-phospho-1D-myo-inositol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6813734\", \"stIdVersion\": \"R-ALL-6813734.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10