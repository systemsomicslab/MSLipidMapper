        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10648182], \"className\": \"CatalystActivity\", \"dbId\": 10648180, \"displayName\": \"(2E,6E)-farnesyl diphosphate synthase activity of holo-GGPS1 hexamer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10648182, \"displayName\": \"GGPS1 hexamer transfers IPPP to GPP\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10648182], \"dbId\": 191409, \"displayName\": \"GPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GPP\", \"geranyl diphosphate(3-)\", \"Geranyl pyrophosphate\", \"geranyl diphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191409\", \"stIdVersion\": \"R-ALL-191409.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10648182], \"dbId\": 191362, \"displayName\": \"IPPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"IPPP\", \"isopentenyl diphosphate(3-)\", \"delta3-isopentenyl-PP\", \"isopentenyl diphosphate\", \"delta3-isopentenyl pyrophosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191362\", \"stIdVersion\": \"R-ALL-191362.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GGPS1 hexamer transfers IPPP to GPP\", \"isopentenyl diphosphate + (2E)-geranyl diphosphate => (2E,6E)-farnesyl diphosphate + diphosphate\", \"Another isopentenyl pyrophosphate is added to geranyl pyrophosphate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 191385, \"displayName\": \"FAPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FAPP\", \"2-trans,6-trans-farnesyl diphosphate(3-)\", \"Farnesyl pyrophosphate\", \"2-trans,6-trans-farnesyl diphosphate\"], \"producedByEvent\": [10648182], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191385\", \"stIdVersion\": \"R-ALL-191385.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111294, \"displayName\": \"PPi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [10648182], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111294\", \"stIdVersion\": \"R-ALL-111294.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10648185, \"displayName\": \"GGPS1 hexamer transfers IPPP to DMAPP\", \"followingEvent\": [10648182], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GGPS1 hexamer transfers IPPP to DMAPP\", \"isopentenyl diphosphate + dimethylallyl diphosphate => (2E)-geranyl diphosphate + diphosphate\", \"Addition of isopentenyl pyrophosphate to DMAPP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9717834\", \"stIdVersion\": \"R-DRE-9717834.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10580059, \"displayName\": \"FDPS dimer transfers IPPP to DMAPP\", \"followingEvent\": [10648182], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FDPS dimer transfers IPPP to DMAPP\", \"isopentenyl diphosphate + dimethylallyl diphosphate => (2E)-geranyl diphosphate + diphosphate\", \"Addition of isopentenyl pyrophosphate to DMAPP\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-191322\", \"stIdVersion\": \"R-DRE-191322.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10580102, \"displayName\": \"MVD decarboxylates MVA5PP to IPPP\", \"followingEvent\": [10648182], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MVD decarboxylates MVA5PP to IPPP\", \"(R)-5-diphosphomevalonate + ATP => isopentenyl diphosphate + ADP + phosphate + CO2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-191414\", \"stIdVersion\": \"R-DRE-191414.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DRE\", \"className\": \"Species\", \"dbId\": 68323, \"displayName\": \"Danio rerio\", \"name\": [\"Danio rerio\", \"D.rerio\", \"D. rerio\", \"Dr\", \"Brachydanio rerio\", \"zebrafish\", \"zebra fish\"], \"schemaClass\": \"Species\", \"taxId\": \"7955\"}], \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9717830\", \"stIdVersion\": \"R-DRE-9717830.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
