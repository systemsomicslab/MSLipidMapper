    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "ATP [cytosol] + CoA-SH [cytosol] + CIT [cytosol] => ADP [cytosol] + OA [cytosol] + Pi [cytosol] + Ac-CoA [cytosol]"
