        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10647191, \"displayName\": \"PTGS1 dimer binds PTGS1 Inhibitors\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10647191], \"dbId\": 10574765, \"displayName\": \"PTGS1 dimer [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PTGS1 dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-428986\", \"stIdVersion\": \"R-DRE-428986.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10647191], \"dbId\": 9677343, \"displayName\": \"PTGS1 Inhibitors [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PTGS1 Inhibitors\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9677343\", \"stIdVersion\": \"R-ALL-9677343.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGS1 dimer binds PTGS1 Inhibitors\"], \"output\": [{\"className\": \"Complex\", \"db