      {
        "@value": "H+ [cytosol] + 4,4-diMe-8,14-cholestadien-3b-ol [endoplasmic reticulum membrane] + NADPH [cytosol] => 4,4-diMe-5-cholest-8-en-3-ol [endoplasmic reticulum membrane] + NADP+ [cytosol]"
      }
