        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10576118], \"className\": \"CatalystActivity\", \"dbId\": 10576116, \"displayName\": \"long-chain fatty acid-CoA ligase activity of SLC27A5 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10576118, \"displayName\": \"Cytosolic cholate and chenodeoxycholate are conjugated with Coenzyme A (SLC27A5 BACS)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10576118], \"dbId\": 194096, \"displayName\": \"CCA,CDCA [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"CCA,CDCA\", \"cholate; chenodeoxycholate\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-194096\", \"stIdVersion\": \"R-ALL-194096.2\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10576118], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AT