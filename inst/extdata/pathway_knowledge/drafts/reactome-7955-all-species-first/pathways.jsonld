        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10626951], \"className\": \"CatalystActivity\", \"dbId\": 10626949, \"displayName\": \"long-chain fatty acid-CoA ligase activity of ACSF2 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10626951, \"displayName\": \"ACSF2 ligates CoA-SH to MCFA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0006637\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 8047, \"definition\": \"The chemical reactions and pathways involving acyl-CoA, any derivative of coenzyme A in which the sulfhydryl group is in thiolester linkage with an acyl group.\", \"displayName\": \"acyl-CoA metabolic process\", \"name\": \"acyl-CoA metabolic process\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006637\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10626951], \"dbId\": 5690531, \"displayName\": \"MCFA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MCFA\", \"medium-chain fatty acid anion\", \"medium-chain fatty acid\"], \"referenceType\": \"R