        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10645315], \"className\": \"CatalystActivity\", \"dbId\": 10609674, \"displayName\": \"arachidonate 12(S)-lipoxygenase activity of ALOX12:Fe2+ [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10645315, \"displayName\": \"ALOX12:Fe2+ oxidises DPAn-3 to 14(S)-Hp-DPAn-3\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10645317], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10645315], \"dbId\": 9608444, \"displayName\": \"DPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DPAn-3\", \"(7Z,10Z,13Z,16Z,19Z)-docosapentaenoate\", \"omega-3-docosapentaenoic acid\", \"(7Z,10Z,13Z,16Z,19Z)-docosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9608444\", \"stIdVersion\": \"R-ALL-9608444.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10645315], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALOX