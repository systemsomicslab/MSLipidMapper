        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10580894], \"className\": \"CatalystActivity\", \"dbId\": 10580892, \"displayName\": \"3-beta-hydroxysteroid dehydrogenase [NAD(P)+]/C4-decarboxylase activity of NSDHL [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10580894, \"displayName\": \"4-methyl,4-carboxycholesta-8(9),24-dien-3beta-ol is decarboxylated and oxidized to form 4-methylcholesta-8(9),24-dien-3-one\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10580912], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10580894], \"dbId\": 194735, \"displayName\": \"4C4MZYMOL [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4C4MZYMOL\", \"4beta-methylzymosterol-4alpha-carboxylate\", \"4-methyl,4-carboxycholesta-8(9),24-dien-3beta-ol\", \"4-carboxy-4-methylzymosterol\"], \"referenceType\": \"ReferenceMolecule\