      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10607725], \"className\": \"CatalystActivity\", \"dbId\": 10607703, \"displayName\": \"long-chain fatty acid-CoA ligase activity of ACSL1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}], \"dbId\": 10607725, \"displayName\": \"Activation of linoleic acid to linoleoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10607725], \"dbId\": 2046044, \"displayName\": \"LINA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LINA\", \"linoleic acid\", \"LA\", \"linoleic acid (LA)\", \"linoleate\", \"18:2(n-6)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046044\", \"stIdVersion\": \"R-ALL-2046044.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10607725], \"dbId\": 211579, \"displayName\": \"ATP [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-211579\", \"stIdVersion\": \"R-ALL-211579.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10607725], \"dbId\": 162743, \"displayName\": \"CoA-SH [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-162743\", \"stIdVersion\": \"R-ALL-162743.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Activation of linoleic acid to linoleoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2046063, \"displayName\": \"LA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LA-CoA\", \"linoleoyl-CoA(4-)\", \"linoleoyl-CoA (LA-CoA)\", \"linoleoyl-CoA\", \"(9Z,12Z)-Octadecadienoyl-CoA\", \"18:2(n-6)\"], \"producedByEvent\": [10607725], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046063\", \"stIdVersion\": \"R-ALL-2046063.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 2046049, \"displayName\": \"PPi [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"pyrophosphate\", \"diphosphoric acid\", \"pyrophosphoric acid\", \"diphosphate\"], \"producedByEvent\": [10607725], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046049\", \"stIdVersion\": \"R-ALL-2046049.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 2046064, \"displayName\": \"adenosine 5'-monophosphate [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"adenosine 5'-monophosphate\", \"adenosine 5'-monophosphate(2-)\", \"AMP\"], \"producedByEvent\": [1060772