    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10628582], \"className\": \"CatalystActivity\", \"dbId\": 10628580, \"displayName\": \"trans-2-enoyl-CoA reductase (NADPH) activity of DECR2 [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}, {\"accession\": \"0005778\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17947, \"definition\": \"The lipid bilayer surrounding a peroxisome.\", \"displayName\": \"peroxisomal membrane\", \"name\": \"peroxisomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005778\"}], \"dbId\": 10628582, \"displayName\": \"DECR2 reduces a (2E,4E)-dienoyl-CoA to a 4,5-saturated-(3E)-enoyl-CoA \", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10628582], \"dbId\": 113602, \"displayName\": \"NADPH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113602\", \"stIdVersion\": \"R-ALL-113602.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10628582], \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10628582], \"dbId\": 9914117, \"displayName\": \"(2E,4E)-dienoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(2E,4E)-dienoyl-CoA\", \"trans,trans-2,4-dienoyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9914117\", \"stIdVersion\": \"R-ALL-9914117.2\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DECR2 reduces a (2E,4E)-dienoyl-CoA to a 4,5-saturated-(3E)-enoyl-CoA \", \"a (2E,4E)-dienoyl-CoA + H(+) + NADPH => a 4,5-saturated-(3E)-enoyl-CoA + NADP(+)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389556, \"displayName\": \"NADP+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [10628582], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389556\", \"stIdVersion\": \"R-ALL-389556.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 9914123, \"displayName\": \"4,5-saturated-(3E)-enoyl-CoA(4-) [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4,5-saturated-(3E)-enoyl-CoA(4-)\", \"4-saturated-trans-3-enoyl-CoA(4-)\"], \"producedByEvent\": [10628582], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9914123\", \"stIdVersion\": \"R-ALL-9914123.2\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DRE\", \"className\": \"Species\", \"dbId\": 68323, \"displayName\