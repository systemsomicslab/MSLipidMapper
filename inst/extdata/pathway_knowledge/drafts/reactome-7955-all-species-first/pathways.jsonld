    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10635232], \"className\": \"CatalystActivity\", \"dbId\": 10635230, \"displayName\": \"coenzyme A diphosphatase activity of NUDT19 [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10635232, \"displayName\": \"NUDT19 hydrolyses acyl-CoA to 3',5'-ADP and acyl-PPANT\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10635232], \"dbId\": 6810523, \"displayName\": \"acyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"acyl-CoA\", \"acyl-CoA(4-)\", \"fatty acyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6810523\", \"stIdVersion\": \"R-ALL-6810523.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10635232], \"dbId\": 141343, \"displayName\": \"H2O [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-141343\", \"stIdVersion\": \"R-ALL-141343.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NUDT19 hydrolyses acyl-CoA to 3',5'-ADP and acyl-PPANT\", \"an acyl-CoA + H2O => adenosine 3',5'-bisphosphate + an acyl-4'-phosphopantetheine + 2 H(+)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 6810530, \"displayName\": \"acyl-PPANT [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"acyl-PPANT\", \"S-acyl-4'-phosphopantetheine(2-)\", \"S-acylpantetheine 4'-phosphate\"], \"producedByEvent\": [10635232], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6810530\", \"stIdVersion\": \"R-ALL-6810530.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 9641154, \"displayName\": \"PAP [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PAP\", \"adenosine 3',5'-bismonophosphate(4-)\", \"adenosine 3',5'-bisphosphate\", \"adenosine 3',5'-bismonophosphate\"], \"producedByEvent\": [10635232], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9641154\", \"stIdVersion\": \"R-ALL-9641154.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 193465, \"displayName\": \"H+ [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"producedByEvent\": [10635232, 10635232], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193465\", \"stIdVersion\": \"R-ALL-193465.3\"}, 193465], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DRE\", \"className\": \"Species\", \"dbId\": 68323, \"displayName\": \"Danio rerio\", \"name\": [\"Danio rerio\", \"D.rerio\", \"D. rerio\", \"Dr\", \"Brachydanio rerio\", \"zebrafish\", \"zebra fish\"], \"schemaClass\": \"Species\", \"taxId\": \"7955\"}], \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-6810474\", \"stIdVersion\": \"R-DRE-6810474.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another spec