      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/directionality": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "H2O [lysosomal lumen] + GlcCer [lysosomal lumen] => Glc [lysosomal lumen] + CERA [lysosomal lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10603706], \"className\": \"CatalystActivity\", \"dbId\": 10603704, \"displayName\": \"glucosylceramidase activity of GBA1:SAPC [lysosomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005765\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17938, \"definition\": \"The lipid bilayer surrounding the lysosome and separating its contents from the cell cytoplasm.\", \"displayName\": \"lysosomal membrane\", \"name\": \"lysosomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005765\"}, {\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 10603706, \"displayName\": \"GBA1:SAPC hydrolyzes GlcCer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10603853], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10603706], \"dbId\": 1605592, \"displayName\": \"GlcCer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GlcCer\", \"beta-D-glucosyl-N-acylsphingosine\", \"Glucosylceramide\", \"Glucocerebroside\", \"D-glucosyl-N-acylsphingosine\", \"D-glucosy-N-acylsphingosine\", \"D-glucosyl-N-acylsphingoid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605592\", \"stIdVersion\": \"R-ALL-1605592.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10603706], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA1:SAPC hydrolyzes GlcCer\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605673, \"displayName\": \"CERA [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CERA\", \"N-acylsphingoid\", \"Ceramide\", \"N-acylsphingosine\"], \"producedByEvent\": [10603706], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605673\", \"stIdVersion\": \"R-ALL-1605673.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1605745, \"displayName\": \"Glc [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Glc\", \"D-glucopyranose\", \"alpha-D-glucose\"], \"producedByEvent\": [10603706], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605745\", \"stIdVersion\": \"R-ALL-1605745.4\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DRE\", \"className\": \"Species\", \"dbId\": 68323, \"displayName\": \"Danio rerio\", \"name\": [\"Danio rerio\", \"D.rerio\", \"D. rerio\", \"Dr\", \"Brachydanio rerio\", \"zebrafish\", \"zebra fish\"], \"schemaClass\": \"Species\", \"taxId\": \"7955\"}], \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-1605591\", \"stIdVersion\": \"R-DRE-1605591.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
