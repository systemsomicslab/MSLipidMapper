        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10580385], \"className\": \"CatalystActivity\", \"dbId\": 10580370, \"displayName\": \"steroid Delta-isomerase activity of HSD3B1 dimer, HSD3B2 dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10580385, \"displayName\": \"Pregn-5-ene-3,20-dione isomerizes to progesterone\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10580449], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10580385], \"dbId\": 196344, \"displayName\": \"pregn-5-ene-3,20-dione [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"pregn-5-ene-3,20-dione\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-196344\", \"stIdVersion\": \"R-ALL-196344.2\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Pregn-5-ene-3,20-dione isomerizes to progesterone\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193055, \"displayName\": \"P4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"P4\", \"progesterone\"], \"producedByEvent\": [10580385], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193055\", \"stIdVersion\": \"R-ALL-193055.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10581119, \"displayName\": \"Pregnenolone is dehydrogenated to form pregn-5-ene-3,20-dione\", \"followingEvent\": [10580385], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Pregnenolone is dehydrogenated to form pregn-5-ene-3,20-dione\", \"Pregnenolone + NAD+ => pregn-5-ene-3,20-dione + NADH + H+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-196350\", \"stIdVersion\": \"R-DRE-196350.1\"}], \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 10580386, \"displayName\": \"Positive regulation by 'glyco-Lutropin [extracellular region]'\", \"regulatedEntity\": [10580385], \"schemaClass\": \"PositiveRegulation\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DRE\", \"className\": \"Species\", \"dbId\": 68323, \"displayName\": \"Danio rerio\", \"name\": [\"Danio rerio\", \"D.rerio\", \"D. rerio\", \"Dr\", \"Brachydanio rerio\", \"zebrafish\", \"zebra fish\"], \"schemaClass\": \"Species\", \"taxId\": \"7955\"}], \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-193052\", \"stIdVersion\": \"R-DRE-193052.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have