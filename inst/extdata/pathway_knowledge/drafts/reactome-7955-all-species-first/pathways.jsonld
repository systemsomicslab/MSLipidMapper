    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10570725], \"className\": \"CatalystActivity\", \"dbId\": 10570723, \"displayName\": \"hydroxymethylglutaryl-CoA lyase activity of HMGCL dimer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10570725, \"displayName\": \"HMG CoA => acetoacetic acid + acetyl CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10570469], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10570725], \"dbId\": 73917, \"displayName\": \"HMG CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HMG CoA\", \"(3S)-3-hydroxy-3-methylglutaryl-CoA\", \"beta-Hydroxy-beta-methylglutaryl coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-73917\", \"stIdVersion\": \"R-ALL-73917.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMG CoA => acetoacetic acid + acetyl CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 113559, \"displayName\": \"Ac-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Ac-CoA\", \"acetyl-CoA(4-)\", \"Acetyl coenzyme A\", \"acetyl-CoA\"], \"producedByEvent\": [10570725], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113559\", \"stIdVersion\": \"R-ALL-113559.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 73909, \"displayName\": \"ACA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ACA\", \"acetoacetic acid\", \"acetoacetate\"], \"producedByEvent\": [10570725], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-73909\", \"stIdVersion\": \"R-ALL-73909.4\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DRE\", \"className\": \"Species\", \"dbId\": 68323, \"displayName\": \"Danio rerio\", \"name\": [\"Danio rerio\", \"D.rerio\", \"D. rerio\", \"Dr\", \"Brachydanio rerio\", \"zebrafish\", \"zebra fish\"], \"schemaClass\": \"Species\", \"taxId\": \"7955\"}], \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-74180\", \"stIdVersion\": \"R-DRE-74180.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
