        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10645584], \"className\": \"CatalystActivity\", \"dbId\": 10645582, \"displayName\": \"monooxygenase activity of CYP1A1, CYP1A2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10645584, \"displayName\": \"CYP1, CYP2 hydroxylate (N)PD1 to 22-OH-(N)PD1\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10645584], \"dbId\": 9024886, \"displayName\": \"(N)PD1 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(N)PD1\", \"protectin D1(1-)\", \"10(R),17(S)-dihydroxy-docosa-4Z,7Z,11E,13E,15Z,19Z-hexaenoic acid\", \"protectin D1\", \"neuroprotectin D1\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024886\", \"stIdVersion\": \"R-ALL-9024886.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10645584], \