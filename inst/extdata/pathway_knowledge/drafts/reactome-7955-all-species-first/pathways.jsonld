    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "DTA-CoA [endoplasmic reticulum lumen] + NADPH [endoplasmic reticulum lumen] + Malonyl-CoA [endoplasmic reticulum lumen] => CoA-SH [endoplasmic reticulum lumen] + CO2 [endoplasmic reticulum lumen] + TTA-CoA [endoplasmic reticulum lumen] + H2O [endoplasmic reticulum lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10607719], \"className\": \"CatalystActivity\", \"dbId\": 10607711, \"displayName\": \"fatty acid elongase activity of ELOVL2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10607719, \"displayName\": \"Elongation of docosatetraenoyl-CoA to tetracosatetraenoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10607723], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10607719], \"dbId\": 2046060, \"displayName\": \"DTA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DTA-CoA\", \"(7Z,10Z,13Z,16Z)-docosatetraenoyl-CoA\", \"7Z,10Z,13Z,16Z-docosatetraenoyl-CoA (DTA-CoA)\", \"3-oxo-(7,10,13,16)-docosatetraenoyl-CoA\", \"Adrenic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046060\", \"stIdVersion\": \"R-ALL-2046060.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10607719], \"dbId\": 2046066, \"displayName\": \"Malonyl-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Malonyl-CoA\", \"malonyl-CoA(5-)\", \"Malonyl coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046066\", \"stIdVersion\": \"R-ALL-2046066.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10607719, 10607719], \"dbId\": 113601, \"displayName\": \"NADPH [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113601\", \"stIdVersion\": \"R-ALL-113601.2\"}, 113601], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Elongation of docosatetraenoyl-CoA to tetracosatetraenoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2046048, \"displayName\": \"TTA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TTA-CoA\", \"(9Z,12Z,15Z,18Z)-tetracosatetraenoyl-CoA\", \"9Z,12Z,15Z,18Z-Tetracosatetraenoyl-CoA (TTA-CoA)\", \"Tetracosatetraenoyl-CoA\", \"24:4n-6\"], \"producedByEvent\": [10607719], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046048\", \"stIdVersion\": \"R-ALL-2046048.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 159751, \"displayName\": \"CO2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CO2\", \"carbon dioxide\"], \"producedByEvent\": [10607719], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-159751\", \"stIdVersion\": \"R-ALL-159751.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 162743, \"displayName\": \"CoA-SH [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10607719], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-162743\", \"stIdVersion\": \"R-ALL-162743.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113519, \"displayName\": \"H2O [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10607719], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113519\", \"stIdVersion\": \"R-ALL-113519.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10607693, \"displayName\": \"Elongation of arachidonyl-CoA to docosatetraenoyl-CoA\", \"followingEvent\": [10607719], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Elongation of arachidonyl-CoA to docosatetraenoyl-CoA\", \"arachidonoyl-CoA + malonyl-CoA => 3-oxo-(7,10,13,16)-docosatetraenoyl-CoA + CO2 + CoASH [ELOVL5]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-2046083\", \"stIdVersion\": \"R-DRE-2046083.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DRE\", \"className\": \"Species\", \"dbId\": 68323, \"displayName\": \"Danio rerio\", \"name\": [\"Danio rerio\", \"D.rerio\", \"D. rerio\", \"Dr\", \"Brachydanio rerio\", \"zebrafish\", \"zebra fish\"], \"schemaClass\": \"Species\", \"taxId\": \"7955\"}], \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-2046095\", \"stIdVersion\": \"R-DRE-2046095.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
