    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "NADP+ [mitochondrial matrix] + EST17b [mitochondrial matrix] => NADPH [mitochondrial matrix] + H+ [mitochondrial matrix] + E1 [mitochondrial matrix]"
