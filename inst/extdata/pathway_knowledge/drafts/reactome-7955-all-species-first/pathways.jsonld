        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10607359], \"className\": \"CatalystActivity\", \"dbId\": 10607357, \"displayName\": \"long-chain fatty acid transmembrane transporter activity of FABP1:ligands of PPARA [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10607359, \"displayName\": \"FABP1 transports fatty acids into the nucleus\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10607359], \"dbId\": 10607356, \"displayName\": \"FABP1:ligands of PPARA [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"FABP1:ligands of PPARA\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-2026985\", \"stIdVersion\": \"R-DRE-2026985.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FABP1 transports fatty acids into the nucleus\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10590665, \"displayName\": \"FABP1:ligands of PPARA [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"FABP1:ligands of PPARA\"], \"producedByEvent\": [10607359], \"schemaClass\": \"Complex\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-2026984\", \"stIdVersion\": \"R-DRE-2026984.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DRE\", \"className\": \"Species\", \"dbId\": 68323, \"displayName\": \"Danio rerio\", \"name\": [\"Danio rerio\", \"D.rerio\", \"D. rerio\", \"Dr\", \"Brachydanio rerio\", \"zebrafish\", \"zebra fish\"], \"schemaClass\": \"Species\", \"taxId\": \"7955\"}], \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-2026996\", \"stIdVersion\": \"R-DRE-2026996.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the o