        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10580109], \"className\": \"CatalystActivity\", \"dbId\": 10580107, \"displayName\": \"phosphomevalonate kinase activity of PMVK [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10580109, \"displayName\": \"Mevalonate-5-phosphate is further phosphorylated\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10580102], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10580109], \"dbId\": 191296, \"displayName\": \"MVA5P [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MVA5P\", \"(R)-5-phosphonatomevalonate(3-)\", \"Mevalonate-5-phosphate\", \"(R)-5-phosphomevalonic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191296\", \"stIdVersion\": \"R-ALL-191296.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10580109], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Mevalonate-5-phosphate is f