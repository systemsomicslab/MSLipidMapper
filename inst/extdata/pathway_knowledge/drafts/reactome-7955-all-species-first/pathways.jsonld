      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "PGH2 [endoplasmic reticulum lumen] => PGI2 [endoplasmic reticulum lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10572313], \"className\": \"CatalystActivity\", \"dbId\": 10572311, \"displayName\": \"prostaglandin-I synthase activity of PTGIS,CYP8B1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}], \"dbId\": 10572313, \"displayName\": \"PTGIS, CYP8A1 isomerise PGH2 to PGI2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10572313], \"dbId\": 30138, \"displayName\": \"PGH2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGH2\", \"prostaglandin H2(1-)\", \"(5Z,13E)-(15S)-9alpha,11alpha-Epidioxy-15-hydroxyprosta-5,13-dienoate\", \"prostaglandin H2\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-30138\", \"stIdVersion\": \"R-ALL-30138.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PTGIS, CYP8A1 isomerise PGH2 to PGI2\", \"prostaglandin H2 => prostaglandin I2\", \"Prostacyclin synthase (CYP8A1) mediates the isomerization of prostaglandin H2 to prostaglandin I2\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 31593, \"displayName\": \"PGI2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PGI2\", \"prostaglandin I2(1-)\", \"Prostacyclin\", \"prostaglandin I2\", \"(5Z,13E)-(15S)-6,9alpha-Epoxy-11alpha,15-dihydroxyprosta-5,13-dienoate\"], \"producedByEvent\": [10572313], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-31593\", \"stIdVersion\": \"R-ALL-31593.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10574771, \"displayName\": \"PGG2 is reduced to PGH2 by PTGS1\", \"followingEvent\": [10572313], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PGG2 is reduced to PGH2 by PTGS1\", \"AH2 + prostaglandin G2 = A + H2O + prostaglandin H2\", \"Peroxidative reduction of PGG2 to PGH2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-140359\", \"stIdVersion\": \"R-DRE-140359.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10610473, \"displayName\": \"PGG2 is reduced to PGH2 by PTGS2\", \"followingEvent\": [10572313], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PGG2 is reduced to PGH2 by PTGS2\", \"AH2 + prostaglandin G2 = A + H2O + prostaglandin H2\", \"Peroxidative reduction of PGG2 to PGH2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-2309773\", \"stIdVersion\": \"R-DRE-2309773.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DRE\", \"className\": \"Species\", \"dbId\": 68323, \"displayName\": \"Danio rerio\", \"name\": [\"Danio rerio\", \"D.rerio\", \"D. rerio\", \"Dr\", \"Brachydanio rerio\", \"zebrafish\", \"zebra fish\"], \"schemaClass\": \"Species\", \"taxId\": \"7955\"}], \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-76496\", \"stIdVersion\": \"R-DRE-76496.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
