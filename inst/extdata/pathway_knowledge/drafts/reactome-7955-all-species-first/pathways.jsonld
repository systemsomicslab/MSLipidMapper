        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10602923], \"className\": \"CatalystActivity\", \"dbId\": 10602921, \"displayName\": \"phosphatidylcholine lysophospholipase A1 activity of PLA2(8) [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10602923, \"displayName\": \"2-acyl LPC is hydrolyzed to GPCho by PLA2[8]\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10602923], \"dbId\": 975614, \"displayName\": \"2-acyl LPC [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2-acyl LPC\", \"2-acyl-sn-glycero-3-phosphocholine(1+)\", \"2-acyl-sn-glycero-3-phosphocholine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-975614\", \"stIdVersion\": \"R-ALL-975614.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10602923], \"dbId\": 29356, \"displayN