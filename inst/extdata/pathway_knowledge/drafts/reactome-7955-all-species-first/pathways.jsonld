    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10592385], \"className\": \"CatalystActivity\", \"dbId\": 10592383, \"displayName\": \"sphingomyelin synthase activity of 2xPalmC-SGMS2 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10592385, \"displayName\": \"SGMS2 transfers phosphocholine onto ceramide\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10592385], \"dbId\": 429802, \"displayName\": \"PC [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PC\", \"1,2-diacyl-sn-glycero-3-phosphocholine\", \"Phosphatidyl choline\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-429802\", \"stIdVersion\": \"R-ALL-429802.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10592385], \"dbId\": 429807, \"displayName\": \"CERA [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CERA\", \"N-acylsphingoid\", \"ceramide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-429807\", \"stIdVersion\": \"R-ALL-429807.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SGMS2 transfers phosphocholine onto ceramide\", \"phosphatidylcholine + ceramide <=> sphingomyelin + diacylglycerol [SGMS2]\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9843210, \"displayName\": \"SPHM [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SPHM\", \"sphingomyelin\", \"sphingomyelins\", \"ceramide phosphocholines\"], \"producedByEvent\": [10592385], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9843210\", \"stIdVersion\": \"R-ALL-9843210.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 114519, \"displayName\": \"DAG [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DAG\", \"1,2-diacyl-sn-glycerol\", \"1,2-Diacylglycerol\"], \"producedByEvent\": [10592385], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-114519\", \"stIdVersion\": \"R-ALL-114519.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10604143, \"displayName\": \"ENPP7 hydrolyzes sphingomyelin\", \"followingEvent\": [10592385], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ENPP7 hydrolyzes sphingomyelin\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-1640164\", \"stIdVersion\": \"R-DRE-1640164.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10605126, \"displayName\": \"GBA2 hydrolyzes GlcCer (plasma membrane)\", \"followingEvent\": [10592385], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"GBA2 hydrolyzes GlcCer (plasma membrane)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-1861788\", \"stIdVersion\": \"R-DRE-1861788.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10603802, \"displayName\": \"SMPD2 and 3 hydrolyze sphingomyelin (plasma membrane)\", \"followingEvent\": [10592385], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SMPD2 and 3 hydrolyze sphingomyelin (plasma membrane)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-1606273\", \"stIdVersion\": \"R-DRE-1606273.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DRE\", \"className\": \"Species\", \"dbId\": 68323, \"displayName\": \"Danio rerio\", \"name\": [\"Danio rerio\", \"D.rerio\", \"D. rerio\", \"Dr\", \"Brachydanio rerio\", \"zebrafish\", \"zebra fish\"], \"schemaClass\": \"Species\", \"taxId\": \"7955\"}], \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-429786\", \"stIdVersion\": \"R-DRE-429786.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
