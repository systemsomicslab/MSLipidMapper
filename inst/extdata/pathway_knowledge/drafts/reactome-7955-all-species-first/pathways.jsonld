        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10595494], \"className\": \"CatalystActivity\", \"dbId\": 10595492, \"displayName\": \"very-long-chain 3-oxoacyl-CoA reductase activity of HSD17B3,12 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10595494, \"displayName\": \"HSD17B3,12 hydrogenates 3OOD-CoA to 3HODC-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10623485], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10595494], \"dbId\": 548812, \"displayName\": \"3OOD-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3OOD-CoA\", \"3-oxooctadecanoyl-CoA(4-)\", \"3-oxostearoyl-CoA\", \"3-oxooctadecanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-548812\", \"stIdVersion\": \"R-ALL-548812.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10595494],