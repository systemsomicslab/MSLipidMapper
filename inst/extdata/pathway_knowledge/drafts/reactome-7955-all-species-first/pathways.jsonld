    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10609727], \"className\": \"CatalystActivity\", \"dbId\": 10609725, \"displayName\": \"leukotriene-C4 synthase activity of ALOX15:Fe2+ [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10609727, \"displayName\": \"LTA4 is converted to EXA4 by ALOX15\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10609622], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10609727], \"dbId\": 265281, \"displayName\": \"LTA4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LTA4\", \"leukotriene A4(1-)\", \"leukotriene A4\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-265281\", \"stIdVersion\": \"R-ALL-265281.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LTA4 is converted to EXA4 by ALOX15\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142772, \"displayName\": \"EXA4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"EXA4\", \"eoxin A4(1-)\", \"eoxin A4\"], \"producedByEvent\": [10609727], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142772\", \"stIdVersion\": \"R-ALL-2142772.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10585320, \"displayName\": \"5S-HpETE is dehydrated to LTA4 by ALOX5\", \"followingEvent\": [10609727], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"5S-HpETE is dehydrated to LTA4 by ALOX5\", \"(5S)-hydroperoxy-(6E,8Z,11Z,14Z)-eicosatetraenoate => H2O + leukotriene A4\", \"Dehydration of 5-HpETE to leukotriene A4\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-266051\", \"stIdVersion\": \"R-DRE-266051.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DRE\", \"className\": \"Species\", \"dbId\": 68323, \"displayName\": \"Danio rerio\", \"name\": [\"Danio rerio\", \"D.rerio\", \"D. rerio\", \"Dr\", \"Brachydanio rerio\", \"zebrafish\", \"zebra fish\"], \"schemaClass\": \"Species\", \"taxId\": \"7955\"}], \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-2162019\", \"stIdVersion\": \"R-DRE-2162019.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
