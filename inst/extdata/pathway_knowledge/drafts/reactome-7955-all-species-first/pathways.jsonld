        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10635049], \"className\": \"CatalystActivity\", \"dbId\": 10635047, \"displayName\": \"phosphatase activator activity of MTMR9 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10635049, \"displayName\": \"MTMR8 binds MTMR9\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10635049], \"dbId\": 10635040, \"displayName\": \"MTMR8 [cytosol]\", \"endCoordinate\": 704, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MTMR8\", \"Q6TEL0\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-1604671\", \"stIdVersion\": \"R-DRE-1604671.1\", \"startCoordinate\": 1}, {\"className\": \"Protein\", \"consumedByEvent\": [10635049], \"dbId\": 10635044, \"displayName\": \"mtmr9 [cytosol]\", \"endCoordinate\": 549, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"mtmr9\", \"MTMR9\", \"Q5RHK5\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-6809239\", \"stIdVersion\": \"R-DRE-6809239.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MTM