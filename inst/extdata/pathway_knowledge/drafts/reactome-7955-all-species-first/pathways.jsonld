    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "NADPH [mitochondrial matrix] + 3alpha,7alpha-dihydroxy-5beta-cholestan-26-al [mitochondrial matrix] + O2 [mitochondrial matrix] + H+ [mitochondrial matrix] => NADP+ [mitochondrial matrix] + H2O [mitochondrial matrix] + DHCA [mitochondrial matrix]"
