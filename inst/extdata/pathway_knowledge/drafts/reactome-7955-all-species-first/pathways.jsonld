        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10652806], \"className\": \"CatalystActivity\", \"dbId\": 10609704, \"displayName\": \"epoxide hydrolase activity of EPHX2 dimer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10652806, \"displayName\": \"14,15-EET is hydrolysed to 14,15-DHET by EPHX2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10652806], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10652806], \"dbId\": 2142792, \"displayName\": \"14,15-EET [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"14,15-EET\", \"14,15-EET(1-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142792\", \"stIdVersion\": \"R-ALL-2142792.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"14,15-EET is hydrolysed to 14,15-DHET by EPHX2\", \"14,15-epoxy-(5Z,8Z,11Z)-eicosatrienoate + H2O => 14,15-dihydroxy-(5Z,8Z,11Z)-eicosatrienoate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142783, \"displayName\": \"14,15-DHET [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"14,15-DHET\", \"(5Z,8Z,11Z)-14,15-dihydroxyicosatrienoate\", \"14,15-DHET(1-)\", \"(5Z,8Z,11Z)-14,15-dihydroxyicosatrienoic acid\"], \"producedByEvent\": [10652806], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142783\", \"stIdVersion\": \"R-ALL-2142783.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10652808, \"displayName\": \"Arachidonate is epoxidated to 14,15-EET by CYP(5)\", \"followingEvent\": [10652806], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Arachidonate is epoxidated to 14,15-EET by CYP(5)\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate + O2 + reduced (NADPH--hemoprotein reductase) => 14,15-epoxy-(5Z,8Z,11Z)-eicosatrienoate + H(+) + H2O + oxidized (NADPH--hemoprotein reductase)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9915997\", \"stIdVersion\": \"R-DRE-9915997.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"DRE\", \"className\": \"Species\", \"dbId\": 68323, \"displayName\": \"Danio rerio\", \"name\": [\"Danio rerio\", \"D.rerio\", \"D. rerio\", \"Dr\", \"Brachydanio rerio\", \"zebrafish\", \"zebra fish\"], \"schemaClass\": \"Species\", \"taxId\": \"7955\"}], \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-9915994\", \"stIdVersion\": \"R-DRE-9915994.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes a