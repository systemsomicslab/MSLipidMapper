        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10603735], \"className\": \"CatalystActivity\", \"dbId\": 10603733, \"displayName\": \"sphingolipid activator protein activity of GM2A(32-193) [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}, {\"accession\": \"0097488\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 3828048, \"definition\": \"The lipid bilayer surrounding a multivesicular body internal vesicle.\", \"displayName\": \"multivesicular body, internal vesicle membrane\", \"name\": \"multivesicular body, internal vesicle membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0097488\"}], \"dbId\": 10603735, \"displayName\": \"GM2A binds and mobilizes ligands\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10603735], \"dbId\": 10603710, \"displayName\": \"LOC100534777 [lysosomal lumen]\", \"endCoordinate\": 193, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LOC100534777\", \"GM2A(32-193)\", \"A0A286YA46\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Danio rerio\", \"stId\": \"R-DRE-1605614\", \"stIdVersion\": \"R-DRE-1605614.1\", \"startCoordinate\": 32}, {\"className\": \"Set\", \"consumedByEvent\": [10603735], \"dbId\": 9840941, \"displayName\"