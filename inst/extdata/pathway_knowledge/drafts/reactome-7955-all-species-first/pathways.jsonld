        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10580056], \"className\": \"CatalystActivity\", \"dbId\": 10580054, \"displayName\": \"(2E,6E)-farnesyl diphosphate synthase activity of holo-FDPS dimer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10580056, \"displayName\": \"FDPS dimer transfers IPPP to GPP\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10580056], \"dbId\": 191409, \"displayName\": \"GPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GPP\", \"geranyl diphosphate(3-)\", \"Geranyl pyrophosphate\", \"geranyl diphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191409\", \"stIdVersion\": \"R-ALL-191409.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10580056], \"dbId\": 191362, \"displayName\": \"IPPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"IPPP\", \"isopentenyl diphosphate(3-)\", \"delta3-isopentenyl-PP\", \"isopentenyl diphosphate\", \"delta3-isopentenyl pyrophosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191362\", \"stIdVersion\": \"R-ALL-191362.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, 