        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11132018], \"className\": \"CatalystActivity\", \"dbId\": 11132016, \"displayName\": \"phosphatidylinositol phosphate 4-phosphatase activity of INPP5F [early endosome membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0031901\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 171062, \"definition\": \"The lipid bilayer surrounding an early endosome.\", \"displayName\": \"early endosome membrane\", \"name\": \"early endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031901\"}], \"dbId\": 11132018, \"displayName\": \"PI(4,5)P2, PI(3,4)P2 and PI(3,4,5)P3 are dephosphorylated to PI5P, PI3P and PI(3,4)P by INPP5F at the endosome membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [11132018], \"dbId\": 8849959, \"displayName\": \"PI(4,5)P2, PI(3,4)P2, PI(3,4,5)P3 [early endosome membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PI(4,5)P2, PI(3,4)P2, PI(3,4,5)P3\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-8849959\", \"stIdVersion\": \"R-ALL-8849959.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11132018], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \