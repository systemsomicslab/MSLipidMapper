    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11128165], \"className\": \"CatalystActivity\", \"dbId\": 11128163, \"displayName\": \"fatty acyl-CoA hydrolase activity of ACOT2,9, THEM4,5 dimer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 11128165, \"displayName\": \"ACOT2,9,THEM4,5 hydrolyse MCFA-CoA, LCFA-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0006637\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 8047, \"definition\": \"The chemical reactions and pathways involving acyl-CoA, any derivative of coenzyme A in which the sulfhydryl group is in thiolester linkage with an acyl group.\", \"displayName\": \"acyl-CoA metabolic process\", \"name\": \"acyl-CoA metabolic process\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006637\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [11128165], \"dbId\": 5690540, \"displayName\": \"MCFA-CoA, LCFA-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"MCFA-CoA, LCFA-CoA\", \"medium/long chain fatty acyl-CoA\"], \"schemaC