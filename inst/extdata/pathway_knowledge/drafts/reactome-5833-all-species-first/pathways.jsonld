    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "DHAP is converted to G3P by GPD1/GPD1L"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/curationStatus": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/Draft"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/directionality": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "DHAP [cytosol] + NADH [cytosol] + H+ [cytosol] => NAD+ [cytosol] + G3P [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11119073], \"className\": \"CatalystActivity\", \"dbId\": 11119071, \"displayName\": \"glycerol-3-phosphate dehydrogenase [NAD(P)+] activity of GPD1/GPD1L homodimer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11119073, \"displayName\": \"DHAP is converted to G3P by GPD1/GPD1L\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11119073], \"dbId\": 75970, \"displayName\": \"DHAP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHAP\", \"glycerone phosphate(2-)\", \"glycerone phosphate\", \"dihydroxyacetone phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-75970\", \"stIdVersion\": \"R-ALL-75970.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11119073], \"dbId\": 73473, \"displayName\": \"NADH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-73473\", \"stIdVersion\": \"R-ALL-73473.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11119073], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DHAP is converted to G3P by GPD1/GPD1L\", \"Conversion of Dihydroxyacetone Phosphate to Glycerol -3- phosphate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 76114, \"displayName\": \"G3P [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"G3P\", \"sn-glycerol 3-phosphate(2-)\", \"Glycerol-3-phosphate\", \"sn-glycerol 3-phosphate\"], \"producedByEvent\": [11119073], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76114\", \"stIdVersion\": \"R-ALL-76114.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29360, \"displayName\": \"NAD+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\"], \"producedByEvent\": [11119073], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29360\", \"stIdVersion\": \"R-ALL-29360.6\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"PFA\", \"className\": \"Species\", \"dbId\": 170928, \"displayName\": \"Plasmodium falciparum\", \"name\": [\"Plasmodium falciparum\", \"malaria parasite P. falciparum\"], \"schemaClass\": \"Species\", \"taxId\": \"5833\"}], \"speciesName\": \"Plasmodium falciparum\", \"stId\": \"R-PFA-75889\", \"stIdVersion\": \"R-PFA-75889.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
