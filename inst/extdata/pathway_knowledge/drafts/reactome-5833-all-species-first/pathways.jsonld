        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11124210], \"className\": \"CatalystActivity\", \"dbId\": 11124208, \"displayName\": \"phosphatidylcholine transfer activity of PI:PITPNB [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}], \"dbId\": 11124210, \"displayName\": \"PI is exchanged with PC by PITPNB\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [11124210], \"dbId\": 11124205, \"displayName\": \"PI:PITPNB [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PI:PITPNB\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Plasmodium falciparum\", \"stId\": \"R-PFA-1524150\", \"stIdVersion\": \"R-PFA-1524150.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11124210], \"dbId\": 429785, \"displayName\": \"PC [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PC\", \"1,2-diacyl-sn-glycero-3-phosphocholine\", \"Phosphatidyl choline\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-429785\", \"stIdVersion\": \"R-ALL-429785.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI is exchanged with PC by PITPNB\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1524146, \"displayName\": \"PI [Golgi membrane]\", \"inDisease