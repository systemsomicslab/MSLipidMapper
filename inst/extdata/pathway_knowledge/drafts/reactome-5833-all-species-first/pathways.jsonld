  {
    "@id": "https://reactome.org/content/detail/R-PFA-188467",
    "@type": [
      "https://systemomicslab.github.io/MSLipidMapper/ontology/LipidReaction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/curationStatus": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/Draft"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/directionality": [
      {
        "@id": "https://systemomicslab.github.io/MSLipidMapper/ontology/SourceForward"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "FAD [mitochondrial matrix] + G3P [mitochondrial matrix] => FADH2 [mitochondrial matrix] + DHAP [mitochondrial matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11120418], \"className\": \"CatalystActivity\", \"dbId\": 11120416, \"displayName\": \"glycerol-3-phosphate dehydrogenase (quinone) activity of GPD2 [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}, {\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 11120418, \"displayName\": \"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0006127\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 15824, \"definition\": \"The process of transferring reducing equivalents from NADH in the cytosol into the mitochondria via glycerol-3-phosphate. Cytosolic glycerol-3-phosphate dehydrogenase uses NADH to convert dihydroxyacetone phosphate (DHAP) to glycerol-3-phosphate (G3P) in the cytosol; G3P then diffuses into the mitochondria where mitochondrial glycerol-3-phosphate dehydrogenase uses FAD to convert G3P back to DHAP; the electrons on the reduced FADH2 are then available for use in the electron transport chain, and DHAP returns to the cytosol to complete the cycle.\", \"displayName\": \"glycerol-3-phosphate shuttle\", \"name\": \"glycerol-3-phosphate shuttle\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006127\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11120418], \"dbId\": 188458, \"displayName\": \"G3P [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"G3P\", \"sn-glycerol 3-phosphate(2-)\", \"Glycerol-3-phosphate\", \"sn-glycerol 3-phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-188458\", \"stIdVersion\": \"R-ALL-188458.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11120418], \"dbId\": 113596, \"displayName\": \"FAD [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FAD\", \"FAD(3-)\", \"Flavin adenine dinucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113596\", \"stIdVersion\": \"R-ALL-113596.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Gly-3-P+FAD->DHAP+FADH2 (catalyzed by mitochondrial Gly-Phos dehydrogenase)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 188451, \"displayName\": \"DHAP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHAP\", \"glycerone phosphate(2-)\", \"glycerone phosphate\", \"dihydroxyacetone phosphate\"], \"producedByEvent\": [11120418], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-188451\", \"stIdVersion\": \"R-ALL-188451.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 31649, \"displayName\": \"FADH2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"FADH2\", \"FADH2(2-)\"], \"producedByEvent\": [11120418], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-31649\", \"stIdVersion\": \"R-ALL-31649.3\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"PFA\", \"className\": \"Species\", \"dbId\": 170928, \"displayName\": \"Plasmodium falciparum\", \"name\": [\"Plasmodium falciparum\", \"malaria parasite P. falciparum\"], \"schemaClass\": \"Species\", \"taxId\": \"5833\"}], \"speciesName\": \"Plasmodium falciparum\", \"stId\": \"R-PFA-188467\", \"stIdVersion\": \"R-PFA-188467.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
