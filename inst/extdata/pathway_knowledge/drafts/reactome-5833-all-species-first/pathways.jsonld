    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11134251, \"displayName\": \"holo-FDPS dimer binds NBPs\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [11134251], \"dbId\": 11120526, \"displayName\": \"holo-FDPS dimer [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"holo-FDPS dimer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Plasmodium falciparum\", \"stId\": \"R-PFA-981570\", \"stIdVersion\": \"R-PFA-981570.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [11134251], \"dbId\": 9717840, \"displayName\": \"NBPs [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"NBPs\", \"FDPS inhibitors\", \"biphosphonates\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9717840\", \"stIdVersion\": \"R-ALL-9717840.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"holo-FDPS dimer binds NBPs\", \"holo-FDPS dimer binds FDPS inhibitors\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 11134249, \"displayName\": \"holo-FDPS dimer:NBPs [cytosol]\", \"inDisease\": false, \"maxDepth\": 4, \"name\": [\"holo-FDPS dimer:NBPs\"], \"producedByEvent\": [11134251], \"schemaClass\": \"Complex\", \"speciesName\": \"Plasmodium falciparum\", \"stId\": \"R-PFA-9717836\", \"stIdVersion\": \"R-PFA-9717836.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"PFA\", \"className\": \"Species\", \"dbId\": 170928, \"displayName\": \"Plasmodium falciparum\", \"name\": [\"Plasmodium falciparum\", \"malaria parasite P. falciparum\"], \"schemaClass\": \"Species\", \"taxId\": \"5833\"}], \"speciesName\": \"Plasmodium falciparum\", \"stId\": \"R-PFA-9717841\", \"stIdVersion\": \"R-PFA-9717841.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.panthe