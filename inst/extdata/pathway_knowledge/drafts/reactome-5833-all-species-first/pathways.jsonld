        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11131999], \"className\": \"CatalystActivity\", \"dbId\": 11131997, \"displayName\": \"retinyl-palmitate esterase activity of PNPLA4 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11131999, \"displayName\": \"PNPLA4 hydrolyzes retinyl palmitate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11131999], \"dbId\": 2534407, \"displayName\": \"atR-PALM [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"atR-PALM\", \"all-trans-retinyl palmitate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2534407\", \"stIdVersion\": \"R-ALL-2534407.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11131999], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PNPLA4 hydrolyzes retinyl palmitate\", \"all-trans-retinyl hexadecanoate + H2O => all-trans-retinol + hexadecanoate + H(+)\"], \"output\": [{\"className\": \"Ch