      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11124466], \"className\": \"CatalystActivity\", \"dbId\": 11124464, \"displayName\": \"phosphatidylinositol-4,5-bisphosphate 5-phosphatase activity of SYNJ/INPP5(1) [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11124466, \"displayName\": \"PI(4,5)P2 is dephosphorylated to PI4P by SYNJ/INPP5[1] at the plasma membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11124466], \"dbId\": 179856, \"displayName\": \"PI(4,5)P2 [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2\", \"1-phosphatidyl-1D-myo-inositol 4,5-bisphosphate(5-)\", \"PIP2\", \"1-phosphatidyl-1D-myo-inositol 4,5-bisphosphate\", \"Phosphatidylinositol-4,5-bisphosphate\", \"1-phosphatidyl-1D-myo-inositol 4,5- bisphosphate\"], \"referenceType