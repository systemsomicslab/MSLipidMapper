        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11124434], \"className\": \"CatalystActivity\", \"dbId\": 11124432, \"displayName\": \"1-phosphatidylinositol-4-phosphate 5-kinase activity of PIP5K1A-C [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11124434, \"displayName\": \"PI4P is phosphorylated to PI(4,5)P2 by PIP5K1A-C at the plasma membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11124434], \"dbId\": 392417, \"displayName\": \"PI4P [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI4P\", \"1-phosphatidyl-1D-myo-inositol 4-phosphate\", \"Phosphatidylinositol 4-phosphate\", \"1-phosphatidyl-1D-myo-inositol 4-phosphates\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-392417\", \"stIdVersion\": \"R