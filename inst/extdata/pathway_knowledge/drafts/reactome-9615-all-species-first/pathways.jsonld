        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10275031], \"className\": \"CatalystActivity\", \"dbId\": 10275029, \"displayName\": \"2-acylglycerol-3-phosphate O-acyltransferase activity of LPSAT [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10275031, \"displayName\": \"2-acyl LPS is acylated to PS by LPSAT\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10275063], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10275031], \"dbId\": 1498722, \"displayName\": \"2-acyl LPS [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2-acyl LPS\", \"2-acyl-sn-glycero-3-phosphoserine\", \"2-acyl lysophosphatidylserine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498722\", \"stIdVersion\": \"R-ALL-1498722.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent