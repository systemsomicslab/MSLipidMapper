        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10275336], \"className\": \"CatalystActivity\", \"dbId\": 10275334, \"displayName\": \"phosphatidylcholine transfer activity of PC:PITPNB [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10275336, \"displayName\": \"PC:PITPNB is transported from the Golgi membrane to the ER membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10275341], \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10275336], \"dbId\": 10275244, \"displayName\": \"PC:PITPNB [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PC:PITPNB\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1524122\", \"stIdVersion\": \"R-CFA-1524122.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PC:PITPNB is transported from the Golgi membrane to the ER membrane\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10275