        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10248980], \"className\": \"CatalystActivity\", \"dbId\": 10248978, \"displayName\": \"bile acid:sodium symporter activity of SLC10A2 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10248980, \"displayName\": \"SLC10A2 transports bile salts and acids and Na+ from extracellular region to cytosol\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10248980], \"dbId\": 74113, \"displayName\": \"Na+ [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Na+\", \"sodium(1+)\", \"sodium ion\", \"Sodium\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-74113\", \"stIdVersion\": \"R-ALL-74113.4\"}, {\"className\": \"Set\", \"consumedByEvent\": [10248980], \"dbId\": 192483, \"displayName\": \"bile salts and acids [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts and acids\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-192483\", \"stIdVersion\": \"R-ALL-192483.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SLC10A2 transports bile salts and acids and Na+ from extracellular region to cytosol\", \"Co-transport (influx) of bile salts and acids and sodium ions by ASBT\"], \"output\": [{\"className\": \"Set\", \"dbId\": 194156, \"displayName\": \"bile salts and acids [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"bile salts and acids\"], \"producedByEvent\": [10248980], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-194156\", \"stIdVersion\": \"R-ALL-194156.2\"}, {\"className\": \"Chemical Compound\", \"dbId\": 83910, \"displayName\": \"Na+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Na+\", \"sodium(1+)\", \"sodium ion\", \"Sodium\"], \"producedByEvent\": [10248980], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-83910\", \"stIdVersion\": \"R-ALL-83910.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10293839, \"displayName\": \"NR1H4 binds DCA, CDCA, LCHA\", \"followingEvent\": [10248980], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NR1H4 binds DCA, CDCA, LCHA\", \"FXR binds bile acids\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-5340195\", \"stIdVersion\": \"R-CFA-5340195.1\"}], \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 10248981, \"displayName\": \"Positive regulation by 'NCOA1,2:RXRA:NR1H4:DCA,CDCA,LCHA [nucleoplasm]'\", \"regulatedEntity\": [10248980], \"schemaClass\": \"PositiveRegulation\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-194187\", \"stIdVersion\": \"R-CFA-194187.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
