        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10331622], \"className\": \"CatalystActivity\", \"dbId\": 10331620, \"displayName\": \"beta-galactoside (CMP) alpha-2,3-sialyltransferase activity of ST3GAL5 [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}], \"dbId\": 10331622, \"displayName\": \"ST3GAL5 transfers NeuNAc to ceramides\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10331622], \"dbId\": 9844855, \"displayName\": \"LacCer/GalCer/GA1/GA2 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"LacCer/GalCer/GA1/GA2\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-9844855\", \"stIdVersion\": \"R-ALL-9844855.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10331622], \"dbId\": 727815, \"displayName\": \"CMP-Neu5Ac [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CMP-Neu5Ac\", \"CMP-N-acetyl-be