        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10248900], \"className\": \"CatalystActivity\", \"dbId\": 10248496, \"displayName\": \"sterol 12-alpha-hydroxylase activity of CYP8B1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10248900, \"displayName\": \"CYP8B1 12-hydroxylates 4CHOL7a,27DONE\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10248894], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10248900], \"dbId\": 193835, \"displayName\": \"4CHOL7a,27DONE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4CHOL7a,27DONE\", \"7alpha,26-dihydroxycholest-4-en-3-one\", \"4-cholesten-7alpha,27-diol-3-one\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193835\", \"stIdVersion\": \"R-ALL-193835.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": 