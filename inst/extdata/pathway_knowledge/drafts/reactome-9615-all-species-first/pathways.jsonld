"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10260281, \"displayName\": \"PPARA:RXRA binds Corepressors of PPARA\", \"followingEvent\": [10260278], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PPARA:RXRA binds Corepressors of PPARA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-400183\", \"stIdVersion\": \"R-CFA-400183.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10281425, \"displayName\": \"FABP1 transports fatty acids into the nucleus\", \"followingEvent\": [10260278], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FABP1 transports fatty acids into the nucleus\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-2026996\", \"stIdVersion\": \"R-CFA-2026996.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-400143\", \"stIdVersion\": \"R-CFA-400143.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
