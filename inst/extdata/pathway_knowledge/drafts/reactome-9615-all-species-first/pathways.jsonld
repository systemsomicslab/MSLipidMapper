      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "(S)-3-Hydroxyhexadecanoyl-CoA [mitochondrial matrix] + NAD+ [mitochondrial matrix] => 3-Oxopalmitoyl-CoA [mitochondrial matrix] + NADH [mitochondrial matrix] + H+ [mitochondrial matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10238806], \"className\": \"CatalystActivity\", \"dbId\": 10238791, \"displayName\": \"(3S)-3-hydroxyacyl-CoA dehydrogenase (NAD+) activity of Trifunctional Protein [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10238806, \"displayName\": \"(S)-3-Hydroxyhexadecanoyl-CoA+NAD => 3-Oxopalmitoyl-CoA+NADH+H\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10238808], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10238806], \"dbId\": 77300, \"displayName\": \"(S)-3-Hydroxyhexadecanoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(S)-3-Hydroxyhexadecanoyl-CoA\", \"(S)-3-hydroxypalmitoyl-CoA(4-)\", \"(S)-3-hydroxypalmitoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77300\", \"stIdVersion\": \"R-ALL-77300.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10238806], \"dbId\": 113526, \"displayName\": \"NAD+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide 