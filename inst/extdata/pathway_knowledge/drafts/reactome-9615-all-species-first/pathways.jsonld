    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10323902], \"className\": \"CatalystActivity\", \"dbId\": 10323555, \"displayName\": \"oxidoreductase activity, acting on single donors with incorporation of molecular oxygen of ALOX5 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10323902, \"displayName\": \"ALOX5 oxidises 17(S)-Hp-DPAn-3 to 7,17-diHp-DPAn-3\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10323900], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10323902], \"dbId\": 9026047, \"displayName\": \"17(S)-Hp-DPAn-3 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"17(S)-Hp-DPAn-3\", \"(7Z,10Z,13Z,15E,17S,19Z)-17-hydroperoxydocosapentaenoate\", \"17(S)-HpDoPE(n-3)(1-)\", \"(7Z,10Z,13Z,15E,17S,19Z)-17-hydroperoxydocosapentaenoic acid\", \"17(S)-hydroperoxy-omega3-docosapentaenoic acid\", \"17(S)-hydroperoxy-docosapentaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9026047\", \"stIdVersion\": \"R-ALL-9026047.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10323902], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMole