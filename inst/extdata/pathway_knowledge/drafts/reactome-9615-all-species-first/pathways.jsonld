    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "3a,7a,12a-trihydroxy-5b-cholest-24-one-CoA [peroxisomal matrix] + CoA-SH [peroxisomal matrix] => propionyl CoA [peroxisomal matrix] + choloyl-CoA [peroxisomal matrix]"
      }
    ],
