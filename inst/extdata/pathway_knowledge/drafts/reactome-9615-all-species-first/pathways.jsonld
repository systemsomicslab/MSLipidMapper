    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10302966], \"className\": \"CatalystActivity\", \"dbId\": 10302964, \"displayName\": \"fatty acid 2-hydroxylase activity of FA2H [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10302966, \"displayName\": \"FA2H hydroxylates 1,2-saturated fatty acids\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10302966], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10302966], \"dbId\": 9843199, \"displayName\": \"2-saturated fatty acid [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2-saturated fatty acid\", \"2-saturated fatty acid anion\", \"FA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9843199\", \"stIdVersion\": \"R-ALL-9843199.2\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10302966, 10302966], \"dbId\": 10262145, \"displayName\": \"CYB5B:Fe2+ [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"CYB5B:Fe2+\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9842697\", \"stIdVersion\": \"R-CFA-9842697.1\"}, 10262145, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10302966, 10302966], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, 70106], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"FA2H hydroxylates 1,2-saturated fatty acids\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10302966], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 9843201, \"displayName\": \"2-OH FA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2-OH FA\", \"(2R)-2-hydroxy fatty acid anion\"], \"producedByEvent\": [10302966], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9843201\", \"stIdVersion\": \"R-ALL-9843201.2\"}, {\"className\": \"Complex\", \"dbId\": 10262147, \"displayName\": \"CYB5B:Fe3+ [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"CYB5B:Fe3+\"], \"producedByEvent\": [10302966, 10302966], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9842694\", \"stIdVersion\": \"R-CFA-9842694.1\"}, 10262147], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-5693761\", \"stIdVersion\": \"R-CFA-5693761.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
