      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "ATP [peroxisomal matrix] + CoA-SH [peroxisomal matrix] + pristanate [peroxisomal matrix] => PPi [peroxisomal matrix] + AMP [peroxisomal matrix] + (2R) Pristanoyl-CoA [peroxisomal matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10259193], \"className\": \"CatalystActivity\", \"dbId\": 10259191, \"displayName\": \"pristanate-CoA ligase activity of SLC27A2 [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10259193, \"displayName\": \"pristanate + CoA-SH + ATP => pristanoyl-CoA + AMP + pyrophosphate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10259193], \"dbId\": 389573, \"displayName\": \"ATP [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389573\", \"stIdVersion\": \"R-ALL-389573.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10259193], \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10259193], \"dbId\": 6811612, \"displayName\": \"pristanate [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"pristanate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6811612\", \"stIdVersion\": \"R-ALL-6811612.2\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"pristanate + CoA-SH + ATP => pristanoyl-CoA + AMP + pyrophosphate\", \"2,6,10,14-tetramethylpentadecanoate + ATP + CoA => AMP + diphosphate + pristanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389620, \"displayName\": \"AMP [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AMP\", \"adenosine 5'-monophosphate(2-)\", \"adenosine 5'-monophosphate\"], \"producedByEvent\": [10259193], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389620\", \"stIdVersion\": \"R-ALL-389620.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 389569, \"displayName\": \"(2R) Pristanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(2R) Pristanoyl-CoA\", \"pristanoyl-CoA(4-)\", \"pristanoyl-CoA\"], \"producedByEvent\": [10259193], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389569\", \"stIdVersion\": \"R-ALL-389569.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 389593, \"displayName\": \"PPi [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"Pyrophosphate\", \"diphosphoric acid\"], \"producedByEvent\": [10259193], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389593\", \"stIdVersion\": \"R-ALL-389593.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10259174, \"displayName\": \"ALDH3A2-2 oxidizes pristanal to pristanate\", \"followingEvent\": [10259193], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ALDH3A2-2 oxidizes pristanal to