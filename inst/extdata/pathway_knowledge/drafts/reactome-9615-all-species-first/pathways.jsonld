    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10293839], \"className\": \"CatalystActivity\", \"dbId\": 10293837, \"displayName\": \"bile acid nuclear receptor activity of NR1H4 [nucleoplasm]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005654\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 7660, \"definition\": \"That part of the nuclear content other than the chromosomes or the nucleolus.\", \"displayName\": \"nucleoplasm\", \"name\": \"nucleoplasm\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005654\"}], \"dbId\": 10293839, \"displayName\": \"NR1H4 binds DCA, CDCA, LCHA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10293864], \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10293839], \"dbId\": 5340249, \"displayName\": \"DCA,CDCA,LCHA [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"DCA,CDCA,LCHA\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-5340249\", \"stIdVersion\": \"R-ALL-5340249.1\"}, {\"className\": \"Protein\", \"consumedByEvent\": [10293839], \"dbId\": 10248430, \"displayName\": \"NR1H4 [nucleoplasm]\", \"endCoordinate\": 486, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NR1H4\", \"NR1H4\", \"A0A8I3N2S7\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-5340228\", \"stIdVersion\": \"R-CFA-5340228.1\", \"startCoordinate\": 1}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"NR1H4 binds DCA, CDCA, LCHA\", \"FXR binds bile acids\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10248432, \"displayName\": \"NR1H4:DCA,CDCA,LCHA [nucleoplasm]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"NR1H4:DCA,CDCA,LCHA\"], \"producedByEvent\": [10293839], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-5340186\", \"stIdVersion\": \"R-CFA-5340186.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-5340195\", \"stIdVersion\": \"R-CFA-5340195.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
