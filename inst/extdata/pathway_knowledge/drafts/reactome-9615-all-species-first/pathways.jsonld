        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10283587], \"className\": \"CatalystActivity\", \"dbId\": 10283585, \"displayName\": \"arachidonate 12(S)-lipoxygenase activity of ALOX12/15 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10283587, \"displayName\": \"Arachidonate is oxidised to 12S-HpETE by ALOX12/15\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10283589], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10283587], \"dbId\": 29768, \"displayName\": \"AA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AA\", \"arachidonate\", \"Arachidonate\", \"arachidonic acid\", \"cis-5,8,11,14-Eicosatetraenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29768\", \"stIdVersion\": \"R-ALL-29768.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10283587], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Arachidonate is oxidised to 12S-HpETE by ALO