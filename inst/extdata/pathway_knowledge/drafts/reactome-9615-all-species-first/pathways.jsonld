    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0031902\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 172574, \"definition\": \"The lipid bilayer surrounding a late endosome.\", \"displayName\": \"late endosome membrane\", \"name\": \"late endosome membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0031902\"}, {\"accession\": \"0005635\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13231, \"definition\": \"The double lipid bilayer that encloses the nucleus, separating its contents from the cytoplasm. It consists of an inner and outer nuclear membrane, with an intermembrane space (20-40 nm wide, also called the perinuclear space) between them. The envelope is supported by the nuclear lamina and contains nuclear pore complexes, which regulate molecular transport.\", \"displayName\": \"nuclear envelope\", \"name\": \"nuclear envelope\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005635\"}], \"dbId\": 10311458, \"displayName\": \"TMEM55B translocates to the nucleus\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10311461], \"goBiologicalProcess\": {\"accession\": \"0051170\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 160267, \"definition\": \"The directed movement of substances into the nucleus.\", \"displayName\": \"import into nucleus\", \"name\": \"import into nucleus\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0051170\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10311458], \"dbId\": 10311454, \"displayName\": \"PIP4P1 [late endosome membrane]\", \"endCoordinate\": 277, \