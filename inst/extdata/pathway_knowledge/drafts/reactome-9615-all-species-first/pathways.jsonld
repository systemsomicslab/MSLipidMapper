 \"Canis familiaris\", \"stId\": \"R-CFA-428696\", \"stIdVersion\": \"R-CFA-428696.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10262053, \"displayName\": \"KDSR reduces 3-ketosphingoid\", \"followingEvent\": [10262173], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"KDSR reduces 3-ketosphingoid\", \"3-ketosphingoid + NADPH + H+ => sphingoid + NADP+\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-428123\", \"stIdVersion\": \"R-CFA-428123.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10262139, \"displayName\": \"ACER1 hydrolyzes ceramide (endoplasmic reticulum)\", \"followingEvent\": [10262173], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACER1 hydrolyzes ceramide (endoplasmic reticulum)\", \"ceramide + H2O <=> fatty acid + sphingosine (endoplasmic reticulum)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-428231\", \"stIdVersion\": \"R-CFA-428231.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-428273\", \"stIdVersion\": \"R-CFA-428273.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are in