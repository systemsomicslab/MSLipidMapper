      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10303492], \"className\": \"CatalystActivity\", \"dbId\": 10303490, \"displayName\": \"long-chain fatty acid-CoA ligase activity of ACSF2 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10303492, \"displayName\": \"ACSF2 ligates CoA-SH to MCFA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"0006637\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 8047, \"definition\": \"The chemical reactions and pathways involving acyl-CoA, any derivative of coenzyme A in which the sulfhydryl group is in thiolester linkage with an acyl group.\", \"displayName\": \"acyl-CoA metabolic process\", \"name\": \"acyl-CoA metabolic process\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0006637\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10303492], \"dbId\": 5690531, \"displayName\": \"MCFA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MCFA\", \"medium-chain fatty acid anion\", \"medium-chain fatty acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5690531\", \"stIdVersion\": \"R-ALL-5690531.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10303492], \"dbId\": 113593, \"displayName\": \"ATP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113593\", \"stIdVersion\": \"R-ALL-113593.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10303492], \"dbId\": 29374, \"displayName\": \"CoA-SH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"CoA\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29374\", \"stIdVersion\": \"R-ALL-29374.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACSF2 ligates CoA-SH to MCFA\", \"a medium-chain fatty acid + ATP + CoA => a medium-chain fatty acyl-CoA + AMP + diphosphate\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 5690542, \"displayName\": \"MCFA-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MCFA-CoA\", \"medium-chain fatty acyl-CoA(4-)\", \"medium-chain fatty acyl-CoA\"], \"producedByEvent\": [10303492], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-5690542\", \"stIdVersion\": \"R-ALL-5690542.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 159448, \"displayName\": \"AMP [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AMP\", \"adenosine 5'-monophosphate(2-)\", \"adenosine 5'-monophosphate\", \"Adenylic acid\", \"Adenylate\", \"5'-AMP\", \"5'-Adenylic acid\", \"5'-Adenosine monophosphate\"], \"producedByEvent\": [10303492], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R