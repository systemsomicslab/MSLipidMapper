        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10282256], \"className\": \"CatalystActivity\", \"dbId\": 10282254, \"displayName\": \"propionyl-CoA C2-trimethyltridecanoyltransferase activity of SCP2 [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10282256, \"displayName\": \"Formation of DHA-CoA catalysed by sterol carrier protein X (SCPx)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10282251], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10282256], \"dbId\": 2066762, \"displayName\": \"1-3-oxo-THA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-3-oxo-THA-CoA\", \"(6Z,9Z,12Z,15Z,18Z,21Z)-3-oxotetracosahexaenoyl-CoA\", \"1-(3-oxo-6Z,9Z,12Z,15Z,18Z,21Z-tetracosahexaenoyl)-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2066762\", \"stIdVersion\": \"R-ALL-2066762.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10282256], \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1935