    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "GC [extracellular region] + VD3 [extracellular region] => GC:VD3 [extracellular region]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10253072], \"className\": \"CatalystActivity\", \"dbId\": 10253070, \"displayName\": \"molecular carrier activity of GC [extracellular region]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 10253072, \"displayName\": \"VD3 binds GC\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10253072], \"dbId\": 10253067, \"displayName\": \"GC [extracellular region]\", \"endCoordinate\": 474, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GC\", \"GC\", \"A0A8I3NFP8\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-209886\", \"stIdVersion\": \"R-CFA-209886.1\", \"startCoordinate\": 17}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10253072], \"dbId\": 209767, \"displayName\": \"VD3 [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"VD3\", \"calciol\", \"Vitamin D3\", \"Cholecalciferol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-209767\", \"stIdVersion\": \"R-ALL-209767.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"VD3 binds GC\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10253069, \"displayName\": \"GC:VD3 [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"GC:VD3\"], \"producedByEvent\": [10253072], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-352339\", \"stIdVersion\": \"R-CFA-352339.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-209738\", \"stIdVersion\": \"R-CFA-209738.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
