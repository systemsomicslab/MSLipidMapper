    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10248876], \"className\": \"CatalystActivity\", \"dbId\": 10248450, \"displayName\": \"oxidoreductase activity, acting on NAD(P)H as acceptor of CYP27A1 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10248876, \"displayName\": \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al is oxidized to 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate (3,7,24THCA)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10248876], \"dbId\": 193716, \"displayName\": \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al\", \"(24S)-3alpha,7alpha,24-trihydroxy-5beta-cholestan-26-al\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193716\", \"stIdVersion\": \"R-ALL-193716.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10248876], \"dbId\": 113600, \"displayName\": \"NADPH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113600\", \"stIdVersion\": \"R-ALL-113600.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10248876], \"dbId\": 113529, \"displayName\": \"H+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113529\", \"stIdVersion\": \"R-ALL-113529.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10248876], \"dbId\": 113533, \"displayName\": \"O2 [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113533\", \"stIdVersion\": \"R-ALL-113533.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al is oxidized to 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate (3,7,24THCA)\", \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al + NADPH + H+ + O2 => 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate (3,7,24THCA) + NADP+ + H2O\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 193757, \"displayName\": \"3,7,24THCA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3,7,24THCA\", \"3alpha,7alpha,24-trihydroxy-5beta-cholestan-26-oic acid\", \"3alpha,7alpha,24(S)-trihydroxy-5beta-cholestanoate\", \"3alpha,7alpha,24-trihydroxy-5beta-cholestan-26-oyl-CoA\"], \"producedByEvent\": [10248876], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193757\", \"stIdVersion\": \"R-ALL-193757.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113563, \"displayName\": \"NADP+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [10248876], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113563\", \"stIdVersion\": \"R-ALL-113563.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10248876], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10248874, \"displayName\": \"5beta-cholestan-3alpha,7alpha,24(S),27-tetrol is oxidized to 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al\", \"followingEvent\": [10248876], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha,7alpha,24(S),27-tetrol is oxidized to 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al\", \"5beta-cholestan-3alpha,7alpha,24(S),27-tetrol + NADPH + H+ + O2 => 3alpha,7alpha,24(S)-trihydroxy-5beta-cholestan-27-al + NADP+ + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-193719\", \"stIdVersion\": \"R-CFA-193719.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-193737\", \"stIdVersion\": \"R-CFA-193737.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
