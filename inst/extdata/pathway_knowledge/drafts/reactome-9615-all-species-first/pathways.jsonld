        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10276677], \"className\": \"CatalystActivity\", \"dbId\": 10276675, \"displayName\": \"ceramide glucosyltransferase activity of UGCG [Golgi membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005796\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17963, \"definition\": \"The volume enclosed by the membranes of any cisterna or subcompartment of the Golgi apparatus, including the cis- and trans-Golgi networks.\", \"displayName\": \"Golgi lumen\", \"name\": \"Golgi lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005796\"}], \"dbId\": 10276677, \"displayName\": \"UGCG transfers glucose to ceramide\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10276677], \"dbId\": 744227, \"displayName\": \"UDP-Glc [Golgi lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"UDP-Glc\", \"UDP-alpha-D-glucose(2-)\", \"UDP-glucose\", \"UDP-D-glucose\", \"UDPglucose\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-744227\", \"stIdVersion\": \"R-ALL-744227.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10276677], \"dbId\": 9844975, \"displayName\": \"CERA-d18 [Golgi membrane]\", \"in