      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10283495], \"className\": \"CatalystActivity\", \"dbId\": 10283493, \"displayName\": \"15-hydroxyprostaglandin dehydrogenase (NAD+) activity of HPGD dimer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10283495, \"displayName\": \"LXA4 is oxidised to 15k-LXA4 by HPGD\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10283495], \"dbId\": 2161759, \"displayName\": \"LXA4 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"LXA4\", \"lipoxin A4(1-)\", \"lipoxin A4\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2161759\", \"stIdVersion\": \"R-ALL-2161759.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10283495], \"dbId\": 29360, \"displayName\": \"NAD+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29360\", \"stIdVersion\": \"R-ALL-29360.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"LXA4 is oxidised to 15k-LXA4 by HPG