    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10282013], \"className\": \"CatalystActivity\", \"dbId\": 10282006, \"displayName\": \"omega-6 fatty acid desaturase activity of FADS1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005788\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17957, \"definition\": \"The volume enclosed by the membranes of the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum lumen\", \"name\": \"endoplasmic reticulum lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005788\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10282013, \"displayName\": \"Desaturation of dihomo-gamma-lenolenoyl-CoA to arachidonoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10281984], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10282013], \"dbId\": 2046045, \"displayName\": \"DGL-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DGL-CoA\", \"all-cis-icosa-8,11,14-trienoyl-CoA\", \"dihomo-gamma-linoloyl CoA\", \"8Z,11Z,14Z-eicosatrienoyl-CoA\", \"eicosatrienoyl CoA\", \"20:3(n-6)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046045\", \"stIdVersion\": \"R-ALL-2046045.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10282013], \"dbId\": 113534, \"displayName\": \"O2 [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113534\", \"stIdVersion\": \"R-ALL-113534.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10282013, 10282013], \"dbId\": 194697, \"displayName\": \"NADH [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194697\", \"stIdVersion\": \"R-ALL-194697.4\"}, 194697], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Desaturation of dihomo-gamma-lenolenoyl-CoA to arachidonoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2046053, \"displayName\": \"AA-CoA [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AA-CoA\", \"arachidonoyl-CoA(4-)\", \"arachidonoyl-CoA (AA-CoA)\", \"arachidonoyl-CoA\", \"5Z,8Z,11Z,14Z-eicosatetraenoyl-CoA\"], \"producedByEvent\": [10282013], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2046053\", \"stIdVersion\": \"R-ALL-2046053.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 113519, \"displayName\": \"H2O [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10282013, 10282013], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113519\", \"stIdVersion\": \"R-ALL-113519.3\"}, 113519, {\"className\": \"Chemical Compound\", \"dbId\": 194653, \"displayName\": \"NAD+ [endoplasmic reticulum lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\"], \"producedByEvent\": [10282013, 10282013], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194653\", \"stIdVersion\": \"R-ALL-194653.5\"}, 194653], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10282017, \"displayName\": \"Elongation of gamma-lenolenoyl-CoA to dihomo-gamma-lenolenoyl-CoA\", \"followingEvent\": [10282013], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Elongation of gamma-lenolenoyl-CoA to dihomo-gamma-lenolenoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-2046094\", \"stIdVersion\": \"R-CFA-2046094.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-2046092\", \"stIdVersion\": \"R-CFA-2046092.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
