        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10259190], \"className\": \"CatalystActivity\", \"dbId\": 10259188, \"displayName\": \"phytanate-CoA ligase activity of SLC27A2 [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10259190, \"displayName\": \"phytanate + CoA-SH + ATP => phytanoyl-CoA + AMP + pyrophosphate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10259202], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10259190], \"dbId\": 389573, \"displayName\": \"ATP [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389573\", \"stIdVersion\": \"R-ALL-389573.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10259190], \"dbId\": 193514, \"displayName\": \"CoA-SH [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193514\", \"stIdVersion\": \"R-ALL-193514.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10259190], \"dbId\": 389596, \"displayName\": \"Phytanate [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Phytanate\", \"phytanic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389596\", \"stIdVersion\": \"R-ALL-389596.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"phytanate + CoA-SH + ATP => phytanoyl-CoA + AMP + pyrophosphate\", \"3,7,11,15-tetramethylhexadecanoate + ATP + CoA => AMP + diphosphate + phytanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 389620, \"displayName\": \"AMP [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AMP\", \"adenosine 5'-monophosphate(2-)\", \"adenosine 5'-monophosphate\"], \"producedByEvent\": [10259190], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389620\", \"stIdVersion\": \"R-ALL-389620.6\"}, {\"className\": \"Chemical Compound\", \"dbId\": 389615, \"displayName\": \"Phytanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Phytanoyl-CoA\", \"phytanoyl-CoA(4-)\"], \"producedByEvent\": [10259190], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389615\", \"stIdVersion\": \"R-ALL-389615.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 389593, \"displayName\": \"PPi [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PPi\", \"diphosphate(3-)\", \"Pyrophosphate\", \"diphosphoric acid\"], \"producedByEvent\": [10259190], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389593\", \"stIdVersion\": \"R-ALL-389593.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10259209, \"displayName\": \"PMP34-mediated exchange of cytosolic ATP for peroxisomal AMP\", \"followingEvent\": [10259190], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PMP34-m