      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10312556], \"className\": \"CatalystActivity\", \"dbId\": 10312554, \"displayName\": \"fatty-acyl-CoA binding activity of ACBD5,(ACBD4) [peroxisomal membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005778\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17947, \"definition\": \"The lipid bilayer surrounding a peroxisome.\", \"displayName\": \"peroxisomal membrane\", \"name\": \"peroxisomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005778\"}, {\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10312556, \"displayName\": \"ACBD4,5 bind MCFA-CoA and LCFA-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [10312556], \"dbId\": 10312551, \"displayName\": \"ACBD5,(ACBD4) [peroxisomal membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"ACBD5,(ACBD4)\"], \"schemaClass\": \"CandidateSet\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8848234\", \"stIdVersion\": \"R-CFA-8848234.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [10312556], \"dbId\": 5690520, \"displayName\": \"MCFA-CoA, LCFA-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"MCFA-CoA, LCFA-CoA\", \"medium/long chain fatty acyl-CoA\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-5690520\", \"stIdVersion\": \"R-ALL-5690520.2\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACBD4,5 bind MCFA-CoA and LCFA-CoA\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10312553, \"displayName\": \"ACBD4,5:LCFA-CoA, MCFA-CoA [peroxisomal membrane]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"ACBD4,5:LCFA-CoA, MCFA-CoA\"], \"producedByEvent\": [10312556], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8866017\", \"stIdVersion\": \"R-CFA-8866017.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8848247\", \"stIdVersion\": \"R-CFA-8848247.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been 