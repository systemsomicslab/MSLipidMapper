      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10323890], \"className\": \"CatalystActivity\", \"dbId\": 10283574, \"displayName\": \"epoxide hydrolase activity of EPHX2 dimer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10323890, \"displayName\": \"EPHX2 dimer hydrolyses 13(S),14(S)-epoxy-DHA to MaR2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10323890], \"dbId\": 9025001, \"displayName\": \"13(S),14(S)-epoxy-DHA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"13(S),14(S)-epoxy-DHA\", \"(13S,14S)-epoxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoate\", \"(13S,14S)-epoxy-DHA(1-)\", \"(13S,14S)-epoxy-(4Z,7Z,9E,11E,16Z,19Z)-docosahexaenoic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9025001\", \"stIdVersion\": \"R-ALL-9025001.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10323890], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\