      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10309223], \"className\": \"CatalystActivity\", \"dbId\": 10309221, \"displayName\": \"2-acylglycerol O-acyltransferase activity of MOGAT1,2,3 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10309223, \"displayName\": \"MOGAT1,2,3 transfer acyl group from acyl-CoA to 2-acylglycerol to form DAG\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10309223], \"dbId\": 6800352, \"displayName\": \"2AG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2AG\", \"2-monoglyceride\", \"2-acylglycerol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6800352\", \"stIdVersion\": \"R-ALL-6800352.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10309223], \"dbId\": 1500578, \"displayName\": \"acyl-CoA [cytosol]