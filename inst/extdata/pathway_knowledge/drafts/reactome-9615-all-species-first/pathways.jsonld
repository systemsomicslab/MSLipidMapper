    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10262154], \"className\": \"CatalystActivity\", \"dbId\": 10262152, \"displayName\": \"sphingolipid delta-4 desaturase activity of DEGS1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10262154, \"displayName\": \"DEGS1 dehydrogenates dihydroceramide\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10262139], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10262154, 10262154], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, 70106, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10262154], \"dbId\": 29368, \"displayName\": \"O2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"O2\", \"dioxygen\", \"Oxygen\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29368\", \"stIdVersion\": \"R-ALL-29368.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10262154], \"dbId\": 428126, \"displayName\": \"DHCE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DHCE\", \"dihydroceramide\", \"N-acylsphingoid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428126\", \"stIdVersion\": \"R-ALL-428126.4\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10262154, 10262154], \"dbId\": 10262145, \"displayName\": \"CYB5B:Fe2+ [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"CYB5B:Fe2+\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9842697\", \"stIdVersion\": \"R-CFA-9842697.1\"}, 10262145], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DEGS1 dehydrogenates dihydroceramide\", \"dihydroceramide + 2Fe(2+) + 2H+ + O2 => (4E)-ceramide + 2Fe(3+) + 2H2O\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10262154, 10262154], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, 29356, {\"className\": \"Chemical Compound\", \"dbId\": 9842380, \"displayName\": \"(4E)-CERA [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(4E)-CERA\", \"(4E)-unsatiated ceramide\"], \"producedByEvent\": [10262154], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9842380\", \"stIdVersion\": \"R-ALL-9842380.1\"}, {\"className\": \"Complex\", \"dbId\": 10262147, \"displayName\": \"CYB5B:Fe3+ [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"CYB5B:Fe3+\"], \"producedByEvent\": [10262154, 10262154], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9842694\", \"stIdVersion\": \"R-CFA-9842694.1\"}, 10262147], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10262125, \"displayName\": \"Ceramide synthases transfer acyl-CoA onto sphingoid\", \"followingEvent\": [10262154], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Ceramide synthases transfer acyl-CoA onto sphingoid\", \"sphingoid + acyl-CoA => dihydroceramide + CoASH\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-428185\", \"stIdVersion\": \"R-CFA-428185.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-428259\", \"stIdVersion\": \"R-CFA-428259.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
