    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "MLCL [mitochondrial inner membrane] + acyl-CoA [mitochondrial matrix] => CoA-SH [mitochondrial matrix] + cardiolipin [mitochondrial inner membrane]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10275068], \"className\": \"CatalystActivity\", \"dbId\": 10275066, \"displayName\": \"acyltransferase activity, transferring groups other than amino-acyl groups of HADH octamer [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}, {\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10275068, \"displayName\": \"MLCL is acylated to CL by HADH (IM)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10275081], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10275068], \"dbId\": 1498773, \"displayName\": \"MLCL [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MLCL\", \"2-monolysocardiolipin\", \"Monolysocardiolipin\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498773\", \"stIdVersion\": \"R-ALL-1498773.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10275068], \"dbId\": 1524038, \"displayName\": \"acyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"acyl-CoA\", \"acyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524038\", \"stIdVersion\": \"R-ALL-1524038.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MLCL is acylated to CL by HADH (IM)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1524072, \"displayName\": \"cardiolipin [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"cardiolipin\", \"CL\"], \"producedByEvent\": [10275068], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524072\", \"stIdVersion\": \"R-ALL-1524072.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29374, \"displayName\": \"CoA-SH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"CoA\", \"coenzyme A\"], \"producedByEvent\": [10275068], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29374\", \"stIdVersion\": \"R-ALL-29374.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10275081, \"displayName\": \"CL and 1-acyl LPC are converted to MLCL and PC by TAZ (IM) (Reversible)\", \"followingEvent\": [10275068], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CL and 1-acyl LPC are converted to MLCL and PC by TAZ (IM) (Reversible)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1482794\", \"stIdVersion\": \"R-CFA-1482794.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10275140, \"displayName\": \"CL and 1-acyl LPE are converted to MLCL and PE by TAZ (IM) (Reversible)\", \"followingEvent\": [10275068], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CL and 1-acyl LPE are converted to MLCL and PE by TAZ (IM) (Reversible)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1482894\", \"stIdVersion\": \"R-CFA-1482894.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1482775\", \"stIdVersion\": \"R-CFA-1482775.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
