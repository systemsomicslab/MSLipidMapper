      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10273748], \"className\": \"CatalystActivity\", \"dbId\": 10273746, \"displayName\": \"molecular carrier activity of SERPINA6 [extracellular region]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 10273748, \"displayName\": \"Corticosteroids bind to CBG in blood\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10273748], \"dbId\": 10273743, \"displayName\": \"SERPINA6 [extracellular region]\", \"endCoordinate\": 405, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SERPINA6\", \"SERPINA6\", \"A0A8I3MUM2\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1449658\", \"stIdVersion\": \"R-CFA-1449658.1\", \"startCoordinate\": 23}, {\"className\": \"Set\", \"consumedByEvent\": [10273748], \"dbId\": 1449707, \"displayName\": \"Corticosteroids [extracellular region]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Corticosteroids\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-1449707\", \"stIdVersion\": \"R-ALL-1449707.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Corticosteroids bind to CBG in blood\", \"Corticosteroids are transported in blood bound to Transcortin\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10273745, \"displayName\": \"CBG:Corticosteroids [extracellular region]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"CBG:Corticosteroids\"], \"producedByEvent\": [10273748], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1449677\", \"stIdVersion\": \"R-CFA-1449677.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1449687\", \"stIdVersion\": \"R-CFA-1449687.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
