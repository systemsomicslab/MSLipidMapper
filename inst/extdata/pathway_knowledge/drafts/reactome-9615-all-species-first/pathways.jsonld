        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10243723], \"className\": \"CatalystActivity\", \"dbId\": 10243721, \"displayName\": \"fatty acid synthase activity of FASN [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10243723, \"displayName\": \"Formation of fatty acid synthase (FAS) dimer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10243723, 10243723], \"dbId\": 10238266, \"displayName\": \"phospho-FASN [cytosol]\", \"endCoordinate\": 2511, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"phospho-FASN\", \"FASN\", \"A0A8I3MVX3\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-54659\", \"stIdVersion\": \"R-CFA-54659.1\", \"startCoordinate\": 1}, 10238266], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Formation of fatty acid synthase (FAS) dimer\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10238268, \"displayName\": \"FASN dimer [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"FASN dimer\"], \"producedByEvent\": [10243723], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-77380\", \"stIdVersion\": \"R-CFA-77380.