    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"omitted\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}, {\"accession\": \"0005765\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17938, \"definition\": \"The lipid bilayer surrounding the lysosome and separating its contents from the cell cytoplasm.\", \"displayName\": \"lysosomal membrane\", \"name\": \"lysosomal membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005765\"}], \"dbId\": 10330852, \"displayName\": \"PSAP is cleaved\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10330892], \"goBiologicalProcess\": {\"accession\": \"0016485\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 6678, \"definition\": \"Any protein maturation process achieved by the cleavage of a peptide bond or bonds within a protein. Protein maturation is the process leading to the attainment of the full functional capacity of a protein.\", \"displayName\": \"protein processing\", \"name\": \"protein processing\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0016485\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10330852], \"dbId\": 10330850, \"displayName\": \"PSAP [lysosomal lumen]\", \"endCoordinate\": 524, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PSAP\", \"PSAP\", \"A0A8I3MQM8\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9840325\", \"stIdVersion\": \"R-CFA-9840325.1\", \"startCoordinate\": 17}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PSAP is cleaved\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 10276246, \"displayName\": \"PSAP [lysosomal lumen]\", \"endCoordinate\": 273, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PSAP\", \"PSAP(195-273)\", \"A0A8I3MQM8\"], \"producedByEvent\": [10330852], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9840336\", \"stIdVersion\": \"R-CFA-9840336.1\", \"startCoordinate\": 195}, {\"className\": \"Protein\", \"dbId\": 10276198, \"displayName\": \"PSAP [lysosomal membrane]\", \"endCoordinate\": 391, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PSAP\", \"PSAP(311-391)\", \"A0A8I3MQM8\"], \"producedByEvent\": [10330852], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1605602\", \"stIdVersion\": \"R-CFA-1605602.1\", \"startCoordinate\": 311}, {\"className\": \"Protein\", \"dbId\": 10276389, \"displayName\": \"PSAP [lysosomal lumen]\", \"endCoordinate\": 486, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PSAP\", \"PSAP(405-486)\", \"A0A8I3MQM8\"], \"producedByEvent\": [10330852], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9840328\", \"stIdVersion\": \"R-CFA-9840328.1\", \"startCoordinate\": 405}, {\"className\": \"Protein\", \"dbId\": 10254899, \"displayName\": \"PSAP [lysosomal lumen]\", \"endCoordinate\": 142, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PSAP\", \"PSAP(60-142)\", \"A0A8I3MQM8\"], \"producedByEvent\": [10330852], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-351333\", \"stIdVersion\": \"R-CFA-351333.1\", \"startCoordinate\": 60}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"BlackBoxEvent\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9840334\", \"stIdVersion\": \"R-CFA-9840334.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
