      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10249099], \"className\": \"CatalystActivity\", \"dbId\": 10249059, \"displayName\": \"3-beta-hydroxysteroid 3-dehydrogenase (NADP+) activity of HSD17B7 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10249099, \"displayName\": \"4-methylcholesta-8(9),24-dien-3-one is reduced to 4-methylcholesta-8(9),24-dien-3beta-ol\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10249083], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10249099], \"dbId\": 194667, \"displayName\": \"dh4MZYMOL [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"dh4MZYMOL\", \"3-dehydro-4-methylzymosterol\", \"4-methylcholesta-8(9),24-dien-3-one\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-194667\", \"stIdVersion\": \"R-ALL-194667.4\"}, {\"cla