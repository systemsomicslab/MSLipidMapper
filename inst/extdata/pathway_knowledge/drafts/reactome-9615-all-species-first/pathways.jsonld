    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10311331, \"displayName\": \"MTMR12 binds MTMR2\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10311331], \"dbId\": 10277045, \"displayName\": \"MTMR2 [cytosol]\", \"endCoordinate\": 643, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MTMR2\", \"A0A8I3S2P4\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1604662\", \"stIdVersion\": \"R-CFA-1604662.1\", \"startCoordinate\": 1}, {\"className\": \"Set\", \"consumedByEvent\": [10311331], \"dbId\": 10311322, \"displayName\": \"Homologues of MTMR12 [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Homologues of MTMR12\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-6809657-3\", \"stIdVersion\": \"R-CFA-6809657-3.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MTMR12 binds MTMR2\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10311329, \"displayName\": \"MTMR2:MTMR12 [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"MTMR2:MTMR12\"], \"producedByEvent\": [10311331], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-6809705\", \"stIdVersion\": \"R-CFA-6809705.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-6809707\", \"stIdVersion\": \"R-CFA-6809707.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
