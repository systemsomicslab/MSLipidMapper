        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10327950], \"className\": \"CatalystActivity\", \"dbId\": 10327948, \"displayName\": \"dimethylallyltranstransferase activity of holo-GGPS1 hexamer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10327950, \"displayName\": \"GGPS1 hexamer transfers IPPP to DMAPP\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10327947], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10327950], \"dbId\": 191324, \"displayName\": \"DMAPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DMAPP\", \"prenyl diphosphate(3-)\", \"Dimethylallyl pyrophosphate\", \"prenyl diphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191324\", \"stIdVersion\": \"R-ALL-191324.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10327950], \"dbId\": 191362, \"displayName\": \"IPPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"IPPP\", \"isopentenyl diphosphate(3-)\", \"delta3-isopentenyl-PP\", \"isopentenyl diphosphate\", \"delta3-isopentenyl pyrophosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191362\", \"stIdVersion\": \"R-ALL-191362.4\"}], \"isInDisease\": false,