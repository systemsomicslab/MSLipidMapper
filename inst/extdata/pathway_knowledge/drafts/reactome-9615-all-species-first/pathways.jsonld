    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "2-trans-Dodecenoyl-CoA [mitochondrial matrix] + H2O [mitochondrial matrix] => (S)-3-Hydroxydodecanoyl-CoA [mitochondrial matrix]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10238763], \"className\": \"CatalystActivity\", \"dbId\": 10234464, \"displayName\": \"enoyl-CoA hydratase activity of ECHS1 hexamer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10238763, \"displayName\": \"2-trans-Dodecenoyl-CoA+H2O =>( S)-3-Hydroxydodecanoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10238761], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10238763], \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10238763], \"dbId\": 77255, \"displayName\": \"2-trans-Dodecenoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"2-trans-Dodecenoyl-CoA\", \"trans-dodec-2-enoyl-CoA(4-)\", \"trans-dodec-2-enoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77255\", \"stIdVersion\": \"R-ALL-77255.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"2-trans-Dodecenoyl-CoA+H2O =>( S)-3-Hydroxydodecanoyl-CoA\", \"2E)-dodecenoyl-CoA + H2O => (3S)-3-hydroxydodecanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 77252, \"displayName\": \"(S)-3-Hydroxydodecanoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(S)-3-Hydroxydodecanoyl-CoA\", \"(S)-3-hydroxylauroyl-CoA(4-)\", \"(S)-3-hydroxylauroyl-CoA\"], \"producedByEvent\": [10238763], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77252\", \"stIdVersion\": \"R-ALL-77252.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10238772, \"displayName\": \"lauroyl-CoA+FAD => 2-trans-Dodecenoyl-CoA+FADH2\", \"followingEvent\": [10238763], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"lauroyl-CoA+FAD => 2-trans-Dodecenoyl-CoA+FADH2\", \"dodecanoyl-CoA + FAD + H(+) => (2E)-dodecenoyl-CoA + FADH2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-77263\", \"stIdVersion\": \"R-CFA-77263.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-77256\", \"stIdVersion\": \"R-CFA-77256.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
