    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "bHMG-CoA [cytosol] + NADPH [cytosol] + H+ [cytosol] => CoA-SH [cytosol] + MVA [cytosol] + NADP+ [cytosol]"
