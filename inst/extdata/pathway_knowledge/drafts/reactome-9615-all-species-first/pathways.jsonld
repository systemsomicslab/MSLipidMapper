    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "cardiolipin [mitochondrial outer membrane] + H2O [mitochondrial intermembrane space] => PG [mitochondrial outer membrane] + PA [mitochondrial outer membrane]"
      }
    ],
