        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10248667], \"className\": \"CatalystActivity\", \"dbId\": 10248450, \"displayName\": \"oxidoreductase activity, acting on NAD(P)H as acceptor of CYP27A1 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10248667, \"displayName\": \"5beta-cholestan-3alpha, 7alpha, 26-triol is oxidized to 3alpha, 7alpha-dihydroxy-5beta-cholestan-26-al\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10248661], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10248667], \"dbId\": 193387, \"displayName\": \"5beta-cholestan-3alpha,7alpha,26-triol [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"5beta-cholestan-3alpha,7alpha,26-triol\", \"5beta-cholestane-3alpha,7alpha,26-triol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193387\", \"stIdVersion\": \"R-ALL-193387.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10248667], \"dbId\": 113563, \"displayName\": \"NADP+ [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\