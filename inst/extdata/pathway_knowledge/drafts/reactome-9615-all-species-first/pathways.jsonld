    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "Ac-CoA [cytosol] + NADPH [cytosol] + Mal-CoA [cytosol] + H+ [cytosol] => PALM [cytosol] + CoA-SH [cytosol] + H2O [cytosol] + CO2 [cytosol] + NADP+ [cytosol]"
