        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10312675], \"className\": \"CatalystActivity\", \"dbId\": 10312673, \"displayName\": \"long-chain-alcohol O-fatty-acyltransferase activity of AWAT2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10312675, \"displayName\": \"AWAT2 transfers PALM from PALM-CoA to HXOL, forming palmityl palmitate ester\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10312675], \"dbId\": 8848577, \"displayName\": \"HXOL [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"HXOL\", \"hexadecan-1-ol\", \"Hexadecanol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8848577\", \"stIdVersion\": \"R-ALL-8848577.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10312675], \"dbId\": 200993, \"displayName\": \"PALM-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PALM-CoA\", \"palmitoyl-CoA(4-)\", \"palmitoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-200993\", \"stIdVersion\": \"R-ALL-200993.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"AWAT2 transfers PALM from PALM-CoA to HXOL, forming palmityl palmitate ester\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10312675], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 8848499, \"displayName\": \"PALM-PALM [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PALM-PALM\", \"palmityl palmitate\"], \"producedByEvent\": [10312675], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8848499\", \"stIdVersion\": \"R-ALL-8848499.3\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8848582\", \"stIdVersion\": \"R-CFA-8848582.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components m