        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10314413], \"className\": \"CatalystActivity\", \"dbId\": 10314411, \"displayName\": \"lipid transfer activity of CIDEA:CIDEC [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005811\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 13977, \"definition\": \"An intracellular non-membrane-bounded organelle comprising a matrix of coalesced lipids surrounded by a phospholipid monolayer. May include associated proteins.\", \"displayName\": \"lipid droplet\", \"name\": \"lipid droplet\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005811\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10314413, \"displayName\": \"CIDEA:CIDEC binds lipid droplets\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [10314413], \"dbId\": 10314408, \"displayName\": \"CIDEA:CIDEC [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"CIDEA:CIDEC\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8856629\", \"stIdVersion\": \"R-CFA-8856629.1\"}, {\"className\": \"Complex\", \"consumedByEvent\": [10314413], \"dbId\": 8866926, \"displayName\": \"lipid droplet [lipid droplet]\", \"inDisease\": false, \"isChimeric\": false, \"maxDepth\": 2, \"name\": [\"lipid droplet\"], \"schemaClass\": \"Complex\", \"stId\": \"R-ALL-8866926\", \"stIdVersion\": \"R-ALL-8866926.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CIDEA:CIDEC binds lipid droplets\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10314410, \"displayName\": \"CIDEA:CIDEC:lipid droplet [lipid droplet]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"CIDEA:CIDEC:lipid droplet\"], \"producedByEvent\": [10314413], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8856647\", \"stIdVersion\": \"R-CFA-8856647.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-8856630\", \"stIdVersion\": \"R-CFA-8856630.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated i