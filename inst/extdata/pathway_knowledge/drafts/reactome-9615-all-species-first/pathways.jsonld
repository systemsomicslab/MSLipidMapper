alse, \"maxDepth\": 1, \"name\": [\"PI\", \"1-phosphatidyl-1D-myo-inositol(1-)\", \"Phosphatidyl 1D-myo-inositol\", \"1-phosphatidyl-1D-myo-inositol\"], \"producedByEvent\": [10275247], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524146\", \"stIdVersion\": \"R-ALL-1524146.4\"}, {\"className\": \"Complex\", \"dbId\": 10275244, \"displayName\": \"PC:PITPNB [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PC:PITPNB\"], \"producedByEvent\": [10275247], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1524122\", \"stIdVersion\": \"R-CFA-1524122.1\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10275357, \"displayName\": \"PI:PITPNB is transported from the ER membrane to the Golgi membrane\", \"followingEvent\": [10275247], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI:PITPNB is transported from the ER membrane to the Golgi membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1483229\", \"stIdVersion\": \"R-CFA-1483229.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10275186, \"displayName\": \"CDP-Cho and DAG are converted to PC by CHPT1 at the Golgi membrane\", \"followingEvent\": [10275247], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CDP-Cho and DAG are converted to PC by CHPT1 at the Golgi membrane\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1482973\", \"stIdVersion\": \"R-CFA-1482973.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"S