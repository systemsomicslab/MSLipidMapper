      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "1-acyl LPA [cytosol] + acyl-CoA [cytosol] => CoA-SH [cytosol] + PA [endoplasmic reticulum membrane]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10238342], \"className\": \"CatalystActivity\", \"dbId\": 10238340, \"displayName\": \"1-acylglycerol-3-phosphate O-acyltransferase activity of AGPAT [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10238342, \"displayName\": \"1-acyl LPA is acylated to PA by AGPAT (LPAAT)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10238342], \"dbId\": 1500604, \"displayName\": \"1-acyl LPA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPA\", \"1-acyl-sn-glycerol 3-phosphate\", \"1-acyl-glycerol 3-phosphate \", \"lysophosphatidic acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500604\", \"stIdVersion\": \"R-ALL-1500604.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10238342], \"dbId\": 1500578, \"displayName\": \"acyl-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"acyl-CoA\", \"acyl-CoA(4-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1500578\", \"stIdVersion\": \"R-ALL-1500578.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"1-acyl LPA is acylated to PA by AGPAT (LPAAT)\", \"1-acyl-glycerol 3-phosphate + acyl-CoA => 1,2-diacyl-glycerol 3-phosphate + CoASH\", \"lysophosphatidic acid + fatty acyl CoA  => phosphatidic acid + CoA (1) \"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 426755, \"displayName\": \"PA [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PA\", \"phosphatidate(2-)\", \"phosphatidic acid\"], \"producedByEvent\": [10238342], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-426755\", \"stIdVersion\": \"R-ALL-426755.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [10238342], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10238355, \"displayName\": \"glycerol 3-phosphate + acyl-CoA => 1-acylglycerol 3-phosphate + CoASH [mitochondrial membrane-associated]\", \"followingEvent\": [10238342], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"glycerol 3-phosphate + acyl-CoA => 1-acylglycerol 3-phosphate + CoASH [mitochondrial membrane-associated]\", \"Conversion of glycerol-3-phosphate to lysophosphatidic acid\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-75886\", \"stIdVersion\": \"R-CFA-75886.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10266357, \"displayName\": \"G3P is acylated to 1-acyl LPA by AGPAT6\", \"followingEvent\": [10238342], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"G3P is acylated to 1-acyl LPA by AGPAT6\", \"glycerol 3-phosphate + acyl-CoA => 1-acylglycerol 3-phosphate + CoASH [ER membrane-associated]\", \"Conversion of glycerol-3-phosphate to lysophosphatidic acid\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-549112\", \"stIdVersion\": \"R-CFA-549112.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10238297, \"displayName\": \"DHRS7B reduces GO3P to HXDG3P\", \"followingEvent\": [10238342], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"DHRS7B reduces GO3P to HXDG3P\", \"O-hexadecylglycerone phosphate + NADPH + H+ => 1-hexadecyl glycerol-3-phosphate + NADP+\", \"Conversion of acylated DHAP to lysophosphatidic acid\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-75883\", \"stIdVersion\": \"R-CFA-75883.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10275023, \"displayName\": \"PA is hydrolysed to 1-acyl LPA by PLA2[1]\", \"followingEvent\": [10238342], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PA is hydrolysed to 1-acyl LPA by PLA2[1]\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1482656\", \"stIdVersion\": \"R-CFA-1482656.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-75885\", \"stIdVersion\": \"R-CFA-75885.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
