        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10321181], \"className\": \"CatalystActivity\", \"dbId\": 10321179, \"displayName\": \"3-hydroxyacyl-CoA dehydratase activity of HTD2 [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10321181, \"displayName\": \"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10321181], \"dbId\": 8957387, \"displayName\": \"3HA-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"3HA-CoA\", \"(R)-3-hydroxyacyl-CoA(4-)\", \"3-hydroxyacyl-CoA\", \"(R)-3-hydroxyacyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-8957387\", \"stIdVersion\": \"R-ALL-8957387.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"RPP14 (HTD2) dehydrates 3HA-CoA to t2E-CoA\", \"a (3R)-3-hydroxyacyl-CoA => a (2E)-enoyl-CoA + H2O\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 8957386, \"displayName\": \"t2E-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"t