        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10243888], \"className\": \"CatalystActivity\", \"dbId\": 10243886, \"displayName\": \"carnitine transmembrane transporter activity of SLC22A5 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 10243888, \"displayName\": \"OCTN2 / SLC22A5 transports CAR from extracellular space to cytosol\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"goBiologicalProcess\": {\"accession\": \"1902603\", \"className\": \"GO_BiologicalProcess\", \"databaseName\": \"GO\", \"dbId\": 5263434, \"definition\": \"The directed movement of carnitine across a membrane.\", \"displayName\": \"carnitine transmembrane transport\", \"name\": \"carnitine transmembrane transport\", \"schemaClass\": \"GO_BiologicalProcess\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:1902603\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10243888], \"dbId\": 164988, \"displayName\": \"CAR [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CAR\", \"(R)-carnitine\", \"gamma-Trimethyl-hydroxybutyrobetaine\", \"carnitine\", \"3-Hydroxy-4-trimethylammoniobutanoate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-164988\", \"stIdVersion\": \"R-ALL