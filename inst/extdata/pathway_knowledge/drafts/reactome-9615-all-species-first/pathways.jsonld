        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10248227], \"className\": \"CatalystActivity\", \"dbId\": 10248225, \"displayName\": \"squalene synthase [NAD(P)H] activity of FDFT:Mg2+ [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10248227, \"displayName\": \"Reduction of presqualene diphosphate to form squalene\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10248163], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10248227], \"dbId\": 191265, \"displayName\": \"PSQPP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PSQPP\", \"presqualene diphosphate(3-)\", \"PSDP\", \"presqualene diphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191265\", \"stIdVersion\": \"R-ALL-191265.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10248227], \"dbId\": 70106, \"