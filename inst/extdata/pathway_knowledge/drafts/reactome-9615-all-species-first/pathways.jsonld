    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10238852], \"className\": \"CatalystActivity\", \"dbId\": 10234464, \"displayName\": \"enoyl-CoA hydratase activity of ECHS1 hexamer [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 10238852, \"displayName\": \"trans-Dec-2-enoyl-CoA+H2O => (S)-Hydroxydecanoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10238850], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10238852], \"dbId\": 113521, \"displayName\": \"H2O [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113521\", \"stIdVersion\": \"R-ALL-113521.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10238852], \"dbId\": 77343, \"displayName\": \"tdec2-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"tdec2-CoA\", \"trans-dec-2-enoyl-CoA(4-)\", \"trans-dec-2-enoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77343\", \"stIdVersion\": \"R-ALL-77343.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"trans-Dec-2-enoyl-CoA+H2O => (S)-Hydroxydecanoyl-CoA\", \"(2E)-decenoyl-CoA + H2O => (3S)-hydroxydecanoyl-CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 77341, \"displayName\": \"(S)-Hydroxydecanoyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"(S)-Hydroxydecanoyl-CoA\", \"(S)-3-hydroxydecanoyl-CoA(4-)\", \"(S)-3-hydroxydecanoyl-CoA\"], \"producedByEvent\": [10238852], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-77341\", \"stIdVersion\": \"R-ALL-77341.4\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10238854, \"displayName\": \"Decanoyl-CoA+FAD => trans-Dec-2-enoyl-CoA+FADH2\", \"followingEvent\": [10238852], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Decanoyl-CoA+FAD => trans-Dec-2-enoyl-CoA+FADH2\", \"decanoyl-CoA + FAD + H(+) => (2E)-decenoyl-CoA + FADH2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-77345\", \"stIdVersion\": \"R-CFA-77345.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10239795, \"displayName\": \"Isomerization of 3-trans-decenoyl-CoA to form trans-dec-2-enoyl-CoA\", \"followingEvent\": [10238852], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Isomerization of 3-trans-decenoyl-CoA to form trans-dec-2-enoyl-CoA\", \"3E)-decenoyl-CoA => (2E)-decenoyl-CoA\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-109998\", \"stIdVersion\": \"R-CFA-109998.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiar