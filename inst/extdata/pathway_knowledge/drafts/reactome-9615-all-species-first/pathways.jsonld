    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "15S-HpETE [cytosol] + GSH [cytosol] => 15S-HETE [cytosol] + GSSG [cytosol] + H2O [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10283512], \"className\": \"CatalystActivity\", \"dbId\": 10283510, \"displayName\": \"glutathione peroxidase activity of GPX1/2/4 [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 10283512, \"displayName\": \"15S-HpETE is reduced to 15S-HETE by GPX1/2/4\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10283512], \"dbId\": 2142718, \"displayName\": \"15S-HpETE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"15S-HpETE\", \"15(S)-HPETE(1-)\", \"15(S)-HPETE\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142718\", \"stIdVersion\": \"R-ALL-2142718.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10283512, 10283512], \"dbId\": 29450, \"displayName\": \"GSH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GSH\", \"glutathionate(1-)\", \"Reduced glutathione\", \"glutathione\", \"5-L-Glutamyl-L-cysteinylglycine\", \"N-(N-gamma-L-Glutamyl-L-cysteinyl)glycine\", \"gamma-L-Glutamyl-L-cysteinyl-glycine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29450\", \"stIdVersion\": \"R-ALL-29450.5\"}, 29450], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"15S-HpETE is reduced to 15S-HETE by GPX1/2/4\", \"(15S)-hydroperoxy-(5Z,8Z,11Z,13E)-eicosatetraenoate + 2 glutathione => (15S)-hydroxy-(5Z,8Z,11Z,13E)-eicosatetraenoate + glutathione disulfide + H2O\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 2142707, \"displayName\": \"15S-HETE [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"15S-HETE\", \"15(S)-HETE(1-)\", \"15(S)-HETE\"], \"producedByEvent\": [10283512], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2142707\", \"stIdVersion\": \"R-ALL-2142707.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 111745, \"displayName\": \"GSSG [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"GSSG\", \"glutathione disulfide(2-)\", \"oxidized glutathione\", \"glutathione disulfide\"], \"producedByEvent\": [10283512], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-111745\", \"stIdVersion\": \"R-ALL-111745.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"producedByEvent\": [10283512], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10283600, \"displayName\": \"Arachidonate is oxidised to 15S-HpETE by ALOX15/15B\", \"followingEvent\": [10283512], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Arachidonate is oxidised to 15S-HpETE by ALOX15/15B\", \"(5Z,8Z,11Z,14Z)-eicosatetraenoate + O2 => (15S)-hydroperoxy-(5Z,8Z,11Z,13E)-eicosatetraenoate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-2162002\", \"stIdVersion\": \"R-CFA-2162002.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-2161791\", \"stIdVersion\": \"R-CFA-2161791.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
