      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "7 alpha-hydroxycholesterol [endoplasmic reticulum membrane] + NAD+ [cytosol] => NADH [cytosol] + 4CHOL7aOLONE [endoplasmic reticulum membrane] + H+ [cytosol]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10248491], \"className\": \"CatalystActivity\", \"dbId\": 10248489, \"displayName\": \"steroid dehydrogenase activity, acting on the CH-OH group of donors, NAD or NADP as acceptor of HSD3B7 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10248491, \"displayName\": \"7alpha-hydroxycholesterol is oxidized and isomerized to 4-cholesten-7alpha-ol-3-one\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10248498], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10248491], \"dbId\": 192114, \"displayName\": \"7 alpha-hydroxycholesterol [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"7 alpha-hydroxycholesterol\", \"7alpha-hydroxycholesterol\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192114\", \"stIdVersion\": \"R-ALL-192114.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10248491], \"dbId\": 29360, \"displayName\": \"NAD+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NAD+\", \"NAD(1-)\", \"NAD\", \"NAD(+)\", \"Nicotinamide adenine dinucleotide\", \"DPN\", \"Diphosphopyridine nucleotide\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29360\", \"stIdVersion\": \"R-ALL-29360.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"7alpha-hydroxycholesterol is oxidized and isomerized to 4-cholesten-7alpha-ol-3-one\", \"7alpha-hydroxycholesterol + NAD(+) => 7alpha-hydroxycholest-4-en-3-one + H(+) + NADH\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 192136, \"displayName\": \"4CHOL7aOLONE [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"4CHOL7aOLONE\", \"7alpha-hydroxycholest-4-en-3-one\", \"4-cholesten-7alpha-ol-3-one\"], \"producedByEvent\": [10248491], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-192136\", \"stIdVersion\": \"R-ALL-192136.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 73473, \"displayName\": \"NADH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADH\", \"NADH(2-)\"], \"producedByEvent\": [10248491], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-73473\", \"stIdVersion\": \"R-ALL-73473.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"producedByEvent\": [10248491], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 10248471, \"displayName\": \"CYP7A1 7-hydroxylates CHOL\", \"followingEvent\": [10248491], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"CYP7A1 7-hydroxylates CHOL\", \"cholesterol + reduced (NADPH--hemoprotein reductase) + O2 => 7alpha-hydroxycholesterol + oxidized (NADPH--hemoprotein reductase) + H2O + H(+)\", \"Cholesterol is hydroxylated to 7alpha-hydroxycholesterol by CYP7A1\", \"Cholesterol + NADPH + H+ + O2 => 7-alpha-hydroxycholesterol + NADP+ + H2O\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-192051\", \"stIdVersion\": \"R-CFA-192051.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-192097\", \"stIdVersion\": \"R-CFA-192097.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
