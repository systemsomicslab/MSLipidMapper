        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10327019], \"className\": \"CatalystActivity\", \"dbId\": 10327017, \"displayName\": \"3-oxo-5-alpha-steroid 4-dehydrogenase activity of SRD5A2 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 10327019, \"displayName\": \"SRD5A2 dehydrogenates TEST to DHTEST\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10327019], \"dbId\": 193057, \"displayName\": \"TEST [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"TEST\", \"testosterone\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-193057\", \"stIdVersion\": \"R-ALL-193057.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10327019], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \