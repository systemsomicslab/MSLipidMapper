        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 10330892, \"displayName\": \"PSAP(195-273) forms a dimer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Protein\", \"consumedByEvent\": [10330892, 10330892], \"dbId\": 10276246, \"displayName\": \"PSAP [lysosomal lumen]\", \"endCoordinate\": 273, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PSAP\", \"PSAP(195-273)\", \"A0A8I3MQM8\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9840336\", \"stIdVersion\": \"R-CFA-9840336.1\", \"startCoordinate\": 195}, 10276246], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PSAP(195-273) forms a dimer\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 10276248, \"displayName\": \"PSAP(195-273) dimer [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"PSAP(195-273) dimer\"], \"producedByEvent\": [10330892], \"schemaClass\": \"Complex\", \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-9840482\", \"stIdVersion\": \"R-CFA-9840482.1\"}], \"precedingEvent\": [{\"category\": \"omitted\", \"className\": \"Reaction\", \"dbId\": 10330852, \"displayName\": \"PSAP is cleaved\", \"followingEvent\": [10330892], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PSAP is cleaved\"], \"releaseDate\": \"2