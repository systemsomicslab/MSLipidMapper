    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10275106], \"className\": \"CatalystActivity\", \"dbId\": 10275076, \"displayName\": \"acyltransferase activity, transferring groups other than amino-acyl groups of TAZ [mitochondrial inner membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}], \"dbId\": 10275106, \"displayName\": \"MLCL and PE are converted to CL and 1-acyl LPE by TAZ (IM) (Reversible)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [10275081], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10275106], \"dbId\": 1498773, \"displayName\": \"MLCL [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MLCL\", \"2-monolysocardiolipin\", \"Monolysocardiolipin\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1498773\", \"stIdVersion\": \"R-ALL-1498773.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10275106], \"dbId\": 1524083, \"displayName\": \"PE [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PE\", \"phosphatidylethanolamine zwitterion\", \"phosphatidylethanolamine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524083\", \"stIdVersion\": \"R-ALL-1524083.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MLCL and PE are converted to CL and 1-acyl LPE by TAZ (IM) (Reversible)\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1524072, \"displayName\": \"cardiolipin [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"cardiolipin\", \"CL\"], \"producedByEvent\": [10275106], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524072\", \"stIdVersion\": \"R-ALL-1524072.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1524089, \"displayName\": \"1-acyl LPE [mitochondrial inner membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"1-acyl LPE\", \"1-acyl-sn-glycero-3-phosphoethanolamine\", \"1-acyl lysophosphatidylethanolamine\", \"L-2-Lysophosphatidylethanolamine\"], \"producedByEvent\": [10275106], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524089\", \"stIdVersion\": \"R-ALL-1524089.4\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"CFA\", \"className\": \"Species\", \"dbId\": 49646, \"displayName\": \"Canis familiaris\", \"name\": [\"Canis familiaris\", \"Canis lupus familiaris\"], \"schemaClass\": \"Species\", \"taxId\": \"9615\"}], \"speciesName\": \"Canis familiaris\", \"stId\": \"R-CFA-1482850\", \"stIdVersion\": \"R-CFA-1482850.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events