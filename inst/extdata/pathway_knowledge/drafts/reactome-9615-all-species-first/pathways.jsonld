        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [10259348], \"className\": \"CatalystActivity\", \"dbId\": 10259346, \"displayName\": \"3-hydroxyacyl-CoA dehydratase activity of HSD17B4 dimer [peroxisomal matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005782\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17951, \"definition\": \"The volume contained within the membranes of a peroxisome; in many cells the matrix contains a crystalloid core largely composed of urate oxidase.\", \"displayName\": \"peroxisomal matrix\", \"name\": \"peroxisomal matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005782\"}], \"dbId\": 10259348, \"displayName\": \"trans-2,3-dehydropristanoyl-CoA + H2O => 3-hydroxypristanoyl-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [10259348], \"dbId\": 389894, \"displayName\": \"trans-2,3-dehydropristanoyl-CoA [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"trans-2,3-dehydropristanoyl-CoA\", \"(E)-2,3-didehydropristanoyl-CoA(4-)\", \"(E)-2,3-didehydropristanoyl-CoA\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-389894\", \"stIdVersion\": \"R-ALL-389894.4\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [10259348], \"dbId\": 141343, \"displayName\": \"H2O [peroxisomal matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-141343\", \"stIdVersion\": \"R-ALL-141343.3\"}], \"isInDisease\": false, \"isInferred\":