 1, \"name\": [\"LTA4H:Zn2+ hydrolyses 17R(16)-epoxy-DHA to AT-(N)PD1\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 9024879, \"displayName\": \"AT-(N)PD1 [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"AT-(N)PD1\", \"aspirin-triggered protectin D1(1-)\", \"AT-NPD1(1-)\", \"aspirin-triggered (neuro)protectin D1\", \"aspirin-triggered protectin D1\"], \"producedByEvent\": [11082967], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-9024879\", \"stIdVersion\": \"R-ALL-9024879.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SPO\", \"className\": \"Species\", \"dbId\": 68324, \"displayName\": \"Schizosaccharomyces pombe\", \"name\": [\"Schizosaccharomyces pombe\", \"S.pombe\", \"S. pombe\", \"fission yeast\", \"Sp\"], \"schemaClass\": \"Species\", \"taxId\": \"4896\"}], \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-9020257\", \"stIdVersion\": \"R-SPO-9020257.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another spec