    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11081894], \"className\": \"CatalystActivity\", \"dbId\": 11081892, \"displayName\": \"[acyl-carrier-protein] S-malonyltransferase activity of MCAT [mitochondrial matrix]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005743\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70616, \"definition\": \"The inner, i.e. lumen-facing, lipid bilayer of the mitochondrial envelope. It is highly folded to form cristae.\", \"displayName\": \"mitochondrial inner membrane\", \"name\": \"mitochondrial inner membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005743\"}, {\"accession\": \"0005759\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 5460, \"definition\": \"The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.\", \"displayName\": \"mitochondrial matrix\", \"name\": \"mitochondrial matrix\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005759\"}], \"dbId\": 11081894, \"displayName\": \"MCAT transfers Mal from Mal-CoA to NDUFAB1\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11081894], \"dbId\": 977314, \"displayName\": \"Malonyl-CoA [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Malonyl-CoA\", \"malonyl-CoA(5-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-977314\", \"stIdVersion\": \"R-ALL-977314.4\"}, {\"className\": \"Protein\", \"consumedByEvent\": [11081894], \"dbId\": 11077974, \"displayName\": \"phospho-NDUFAB1 [mitochondrial inner membrane]\", \"endCoordinate\": 156, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"phospho-NDUFAB1\", \"Q10217\"], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-163925\", \"stIdVersion\": \"R-SPO-163925.1\", \"startCoordinate\": 69}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"MCAT transfers Mal from Mal-CoA to NDUFAB1\"], \"output\": [{\"className\": \"Protein\", \"dbId\": 11081886, \"displayName\": \"phospho-Mal-PPANT-S112-NDUFAB1 [mitochondrial inner membrane]\", \"endCoordinate\": 156, \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"phospho-Mal-PPANT-S112-NDUFAB1\", \"Q10217\"], \"producedByEvent\": [11081894], \"referenceType\": \"ReferenceGeneProduct\", \"schemaClass\": \"EntityWithAccessionedSequence\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-8934586\", \"stIdVersion\": \"R-SPO-8934586.1\", \"startCoordinate\": 69}, {\"className\": \"Chemical Compound\", \"dbId\": 29374, \"displayName\": \"CoA-SH [mitochondrial matrix]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"CoA\", \"coenzyme A\"], \"producedByEvent\": [11081894], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29374\", \"stIdVersion\": \"R-ALL-29374.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SPO\", \"className\": \"Species\", \"dbId\": 68324, \"displayName\": \"Schizosaccharomyces pombe\", \"name\": [\"Schizosaccharomyces pombe\", \"S.pombe\", \"S. pombe\", \"fission yeast\", \"Sp\"], \"schemaClass\": \"Species\", \"taxId\": \"4896\"}], \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-8933547\", \"stIdVersion\": \"R-SPO-8933547.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
