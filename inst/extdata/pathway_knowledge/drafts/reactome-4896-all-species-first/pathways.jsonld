    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11076612], \"className\": \"CatalystActivity\", \"dbId\": 11076610, \"displayName\": \"acylglycerol kinase activity of AGK:Mg2+ [mitochondrial outer membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005741\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17906, \"definition\": \"The outer, i.e. cytoplasm-facing, lipid bilayer of the mitochondrial envelope.\", \"displayName\": \"mitochondrial outer membrane\", \"name\": \"mitochondrial outer membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005741\"}, {\"accession\": \"0005758\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 17927, \"definition\": \"The region between the inner and outer lipid bilayers of the mitochondrial envelope.\", \"displayName\": \"mitochondrial intermembrane space\", \"name\": \"mitochondrial intermembrane space\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005758\"}], \"dbId\": 11076612, \"displayName\": \"AGK:Mg2+ phosphorylates MAG, DAG\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [11076612], \"dbId\": 5696066, \"displayName\": \"MAG,DAG [mitochondrial intermembrane space]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"MAG,DAG\"], \"schemaClass\": \"DefinedSet\", \"stId\": \"R-ALL-5696066\", \"stIdVersion\": \"R-ALL-5696066.1\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11076612], \"dbId\": 5696069, \"displayName\": \"ATP [mitochondrial intermembrane space]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adeno