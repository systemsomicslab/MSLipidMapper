    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11070872], \"className\": \"CatalystActivity\", \"dbId\": 11070870, \"displayName\": \"choline kinase activity of CHK dimer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11070872, \"displayName\": \"Cho is phosphorylated to PCho by CHK dimer\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11070891], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11070872], \"dbId\": 264618, \"displayName\": \"Cho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Cho\", \"choline\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-264618\", \"stIdVersion\": \"R-ALL-264618.3\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11070872], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ATP\", \"ATP(4-)\", \"Adenosine 5'-triphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-113592\", \"stIdVersion\": \"R-ALL-113592.6\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"Cho is phosphorylated to PCho by CHK dimer\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1524071, \"displayName\": \"PCho [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PCho\", \"phosphocholines\", \"Phosphocholine\"], \"producedByEvent\": [11070872], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524071\", \"stIdVersion\": \"R-ALL-1524071.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29370, \"displayName\": \"ADP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ADP\", \"ADP(3-)\", \"Adenosine 5'-diphosphate\"], \"producedByEvent\": [11070872], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29370\", \"stIdVersion\": \"R-ALL-29370.6\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11070924, \"displayName\": \"PC is hydrolyzed to PA and choline by PLD1/2\", \"followingEvent\": [11070872], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PC is hydrolyzed to PA and choline by PLD1/2\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-1483182\", \"stIdVersion\": \"R-SPO-1483182.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SPO\", \"className\": \"Species\", \"dbId\": 68324, \"displayName\": \"Schizosaccharomyces pombe\", \"name\": [\"Schizosaccharomyces pombe\", \"S.pombe\", \"S. pombe\", \"fission yeast\", \"Sp\"], \"schemaClass\": \"Species\", \"taxId\": \"4896\"}], \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-1483004\", \"stIdVersion\": \"R-SPO-1483004.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
