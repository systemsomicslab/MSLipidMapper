        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11070796], \"className\": \"CatalystActivity\", \"dbId\": 11070789, \"displayName\": \"acyltransferase activity, transferring groups other than amino-acyl groups of LCLAT1 [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11070796, \"displayName\": \"DLCL is acylated to MLCL by LCLAT1 (ER)\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11070791], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11070796], \"dbId\": 1524080, \"displayName\": \"DLCL [endoplasmic reticulum membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"DLCL\", \"2,2'-dilysocardiolipin(2-)\", \"Dilysocardiolipin\", \"2,2'-dilysocardiolipin\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1524080\", \"stIdVersion\": \"R-ALL-1524080.4\"}, {\"className\": \"Chemical Compound