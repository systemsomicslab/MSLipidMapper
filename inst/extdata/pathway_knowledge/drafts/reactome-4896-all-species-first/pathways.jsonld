        "@value": "Malonyl-CoA [mitochondrial matrix] + phospho-NDUFAB1 [mitochondrial inner membrane] => CoA-SH [mitochondrial matrix] + phospho-Mal-PPANT-S112-NDUFAB1 [mitochondrial inner membrane]"
      }
