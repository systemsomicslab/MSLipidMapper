: \"transition\", \"className\": \"Reaction\", \"dbId\": 11062979, \"displayName\": \"ACLY tetramer transforms CIT to Ac-CoA\", \"followingEvent\": [11066332], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer transforms CIT to Ac-CoA\", \"ATP + citrate + CoA => acetyl-CoA + ADP + oxaloacetate + phosphate\", \"Generation of Cytoplasmic Acetyl CoA from Citrate\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-75848\", \"stIdVersion\": \"R-SPO-75848.1\"}], \"regulatedBy\": [{\"className\": \"PositiveRegulation\", \"dbId\": 8876897, \"displayName\": \"Positive regulation by 'CIT [cytosol]'\", \"regulatedEntity\": [11066332], \"schemaClass\": \"PositiveRegulation\", \"stId\": \"R-HSA-8876897\", \"stIdVersion\": \"R-HSA-8876897.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SPO\", \"className\": \"Species\", \"dbId\": 68324, \"displayName\": \"Schizosaccharomyces pombe\", \"name\": [\"Schizosaccharomyces pombe\", \"S.pombe\", \"S. pombe\", \"fission yeast\", \"Sp\"], \"schemaClass\": \"Species\", \"taxId\": \"4896\"}], \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-200555\", \"stIdVersion\": \"R-SPO-200555.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
