    "https://systemomicslab.github.io/MSLipidMapper/ontology/equation": [
      {
        "@value": "SPHM d18:1 [lysosomal lumen] + H2O [lysosomal lumen] => ChoP [lysosomal lumen] + H+ [lysosomal lumen] + CERA [lysosomal lumen]"
      }
    ],
    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11070967], \"className\": \"CatalystActivity\", \"dbId\": 11070965, \"displayName\": \"sphingomyelin phosphodiesterase activity of SMPD1 [lysosomal lumen]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0043202\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 161320, \"definition\": \"The volume enclosed within the lysosomal membrane.\", \"displayName\": \"lysosomal lumen\", \"name\": \"lysosomal lumen\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0043202\"}], \"dbId\": 11070967, \"displayName\": \"SMPD1 hydrolyzes SPHM\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11070967], \"dbId\": 1605713, \"displayName\": \"SPHM d18:1 [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"SPHM d18:1\", \"sphingomyelin d18:1\", \"sphingomyelins\", \"ceramide phosphocholines\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605713\", \"stIdVersion\": \"R-ALL-1605713.6\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11070967], \"dbId\": 1605715, \"displayName\": \"H2O [lysosomal lumen]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1605715\", \"stIdVersion\": \"R-ALL-1605715.3\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SMPD1 hydrolyzes SPHM\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1605673, \"displayName\": \"CERA [lysosomal lumen]\", \"inDisease\": fals