    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11071214], \"className\": \"CatalystActivity\", \"dbId\": 11071212, \"displayName\": \"phosphatidylinositol-4,5-bisphosphate 5-phosphatase activity of OCRL/INPP5E [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0000139\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 20699, \"definition\": \"The lipid bilayer surrounding any of the compartments of the Golgi apparatus.\", \"displayName\": \"Golgi membrane\", \"name\": \"Golgi membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0000139\"}, {\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11071214, \"displayName\": \"PI(4,5)P2 is dephosphorylated to PI4P by OCRL/INPP5E at the Golgi membrane\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11071214], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11071214], \"dbId\": 1806165, \"displayName\": \"PI(4,5)P2 [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2\", \"1-phosphatidyl-1D-myo-inositol 4,5-bisphosphate(5-)\", \"PIP2\", \"1-phosphatidyl-1D-myo-inositol 4,5-bisphosphate\", \"Phosphatidylinositol-4,5-bisphosphate\", \"1-phosphatidyl-1D-myo-inositol 4,5- bisphosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806165\", \"stIdVersion\": \"R-ALL-1806165.5\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PI(4,5)P2 is dephosphorylated to PI4P by OCRL/INPP5E at the Golgi membrane\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 1806217, \"displayName\": \"PI4P [Golgi membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"PI4P\", \"1-phosphatidyl-1D-myo-inositol 4-phosphate\"], \"producedByEvent\": [11071214], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1806217\", \"stIdVersion\": \"R-ALL-1806217.3\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [11071214], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SPO\", \"className\": \"Species\", \"dbId\": 68324, \"displayName\": \"Schizosaccharomyces pombe\", \"name\": [\"Schizosaccharomyces pombe\", \"S.pombe\", \"S. pombe\", \"fission yeast\", \"Sp\"], \"schemaClass\": \"Species\", \"taxId\": \"4896\"}], \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-1675824\", \"stIdVersion\": \"R-SPO-1675824.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
