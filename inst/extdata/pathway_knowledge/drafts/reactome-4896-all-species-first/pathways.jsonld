        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11084174, \"displayName\": \"ACLY tetramer binds ETC-1002-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Complex\", \"consumedByEvent\": [11084174], \"dbId\": 11062976, \"displayName\": \"ACLY tetramer [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"ACLY tetramer\"], \"schemaClass\": \"Complex\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-76188\", \"stIdVersion\": \"R-SPO-76188.1\"}, {\"className\": \"ChemicalDrug\", \"consumedByEvent\": [11084174], \"dbId\": 9734541, \"displayName\": \"ETC-1002-CoA [cytosol]\", \"inDisease\": true, \"maxDepth\": 1, \"name\": [\"ETC-1002-CoA\"], \"schemaClass\": \"ChemicalDrug\", \"stId\": \"R-ALL-9734541\", \"stIdVersion\": \"R-ALL-9734541.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ACLY tetramer binds ETC-1002-CoA\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 11084172, \"displayName\": \"ACLY tetramer:ETC-1002-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"ACLY tetramer:ETC-1002-CoA\"], \"producedByEvent\": [11084174], \"schemaClass\": \"Complex\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-9734534\", \"stIdVersion\": \"R-SPO-9734534.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\