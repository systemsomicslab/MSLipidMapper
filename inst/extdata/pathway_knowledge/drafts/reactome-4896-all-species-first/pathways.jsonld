    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11080473], \"className\": \"CatalystActivity\", \"dbId\": 11080471, \"displayName\": \"glycerophosphocholine cholinephosphodiesterase activity of ENPP6 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}, {\"accession\": \"0005576\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 984, \"definition\": \"The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.\", \"displayName\": \"extracellular region\", \"name\": \"extracellular region\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005576\"}], \"dbId\": 11080473, \"displayName\": \"ENPP6 hydrolyzes lysophosphatidylcholine\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11080473], \"dbId\": 2239407, \"displayName\": \"lysophosphatidylcholine [plasma membrane]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"lysophosphatidylcholine\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-2239407\", \"stIdVersion\": \"R-ALL-2239407.2\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11080473], \"dbId\": 109276, \"displayName\": \"H2O [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-109276\", \"stIdVersion\": \"R-ALL-109276.4\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"ENPP6 hydrolyzes lysophosphatidylcholine\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 6814794, \"displayName\": \"ChoP [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"ChoP\", \"phosphocholine\", \"Choline phosphate\"], \"producedByEvent\": [11080473], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6814794\", \"stIdVersion\": \"R-ALL-6814794.4\"}, {\"className\": \"Chemical Compound\", \"dbId\": 6814795, \"displayName\": \"MAG [extracellular region]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MAG\", \"monoacylglycerol\", \"monoglyceride\"], \"producedByEvent\": [11080473], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-6814795\", \"stIdVersion\": \"R-ALL-6814795.3\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SPO\", \"className\": \"Species\", \"dbId\": 68324, \"displayName\": \"Schizosaccharomyces pombe\", \"name\": [\"Schizosaccharomyces pombe\", \"S.pombe\", \"S. pombe\", \"fission yeast\", \"Sp\"], \"schemaClass\": \"Species\", \"taxId\": \"4896\"}], \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-6814797\", \"stIdVersion\": \"R-SPO-6814797.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on 