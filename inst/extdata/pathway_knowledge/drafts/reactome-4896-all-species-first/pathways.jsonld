      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11065576], \"className\": \"CatalystActivity\", \"dbId\": 11065574, \"displayName\": \"hydroxymethylglutaryl-CoA reductase (NADPH) activity of HMGCR dimer [endoplasmic reticulum membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005789\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 12045, \"definition\": \"The lipid bilayer surrounding the endoplasmic reticulum.\", \"displayName\": \"endoplasmic reticulum membrane\", \"name\": \"endoplasmic reticulum membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005789\"}], \"dbId\": 11065576, \"displayName\": \"HMGCR dimer reduces bHMG-CoA to MVA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11065594], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11065576], \"dbId\": 191374, \"displayName\": \"bHMG-CoA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"bHMG-CoA\", \"(3S)-3-hydroxy-3-methylglutaryl-CoA(5-)\", \"beta-hydroxy-beta-methylglutaryl-CoA\", \"(3S)-3-hydroxy-3-methylglutaryl-CoA\", \"3-hydroxy-3-methylglutaryl-CoA\", \"HMG-CoA\", \"HMG-C0A(5-)\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191374\", \"stIdVersion\": \"R-ALL-191374.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11065576, 11065576], \"dbId\": 29364, \"displayName\": \"NADPH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADPH\", \"NADPH(4-)\", \"TPNH\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29364\", \"stIdVersion\": \"R-ALL-29364.4\"}, 29364, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11065576, 11065576], \"dbId\": 70106, \"displayName\": \"H+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H+\", \"hydron\", \"proton\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-70106\", \"stIdVersion\": \"R-ALL-70106.5\"}, 70106], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCR dimer reduces bHMG-CoA to MVA\", \"(3S)-3-hydroxy-3-methylglutaryl-CoA + 2 NADPH + 2 H(+) => (R)-mevalonate + 2 NADP(+) + CoA\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 191424, \"displayName\": \"MVA [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"MVA\", \"(R)-mevalonate\", \"Mevalonate\", \"(R)-mevalonic acid\"], \"producedByEvent\": [11065576], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-191424\", \"stIdVersion\": \"R-ALL-191424.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"producedByEvent\": [11065576], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 29366, \"displayName\": \"NADP+ [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"NADP+\", \"NADP(3-)\", \"NADP\", \"NADP(+)\", \"Nicotinamide adenine dinucleotide phosphate\", \"beta-Nicotinamide adenine dinucleotide phosphate\", \"TPN\", \"Triphosphopyridine nucleotide\"], \"producedByEvent\": [11065576, 11065576], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29366\", \"stIdVersion\": \"R-ALL-29366.5\"}, 29366], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11065566, \"displayName\": \"HMGCS1 condenses Ac-CoA and ACA-CoA to form bHMG-CoA\", \"followingEvent\": [11065576], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"HMGCS1 condenses Ac-CoA and ACA-CoA to form bHMG-CoA\", \"acetoacetyl-CoA + acetyl-CoA + H2O => (3S)-3-hydroxy-3-methylglutaryl-CoA + CoA + H(+)\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-191323\", \"stIdVersion\": \"R-SPO-191323.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SPO\", \"className\": \"Species\", \"dbId\": 68324, \"displayName\": \"Schizosaccharomyces pombe\", \"name\": [\"Schizosaccharomyces pombe\", \"S.pombe\", \"S. pombe\", \"fission yeast\", \"Sp\"], \"schemaClass\": \"Species\", \"taxId\": \"4896\"}], \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-191352\", \"stIdVersion\": \"R-SPO-191352.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details