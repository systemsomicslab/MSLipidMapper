    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"category\": \"binding\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11084016, \"displayName\": \"SPHK2 binds SPHK2 inhibitors\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Set\", \"consumedByEvent\": [11084016], \"dbId\": 11084012, \"displayName\": \"Homologues of SPHK2 [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"Homologues of SPHK2\"], \"schemaClass\": \"DefinedSet\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-428236-3\", \"stIdVersion\": \"R-SPO-428236-3.1\"}, {\"className\": \"Set\", \"consumedByEvent\": [11084016], \"dbId\": 9695954, \"displayName\": \"SPHK2 inhibitors [cytosol]\", \"inDisease\": false, \"maxDepth\": 2, \"name\": [\"SPHK2 inhibitors\"], \"schemaClass\": \"CandidateSet\", \"stId\": \"R-ALL-9695954\", \"stIdVersion\": \"R-ALL-9695954.1\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SPHK2 binds SPHK2 inhibitors\"], \"output\": [{\"className\": \"Complex\", \"dbId\": 11084014, \"displayName\": \"SPHK2:SPHK2 inhibitors [cytosol]\", \"inDisease\": false, \"maxDepth\": 3, \"name\": [\"SPHK2:SPHK2 inhibitors\"], \"producedByEvent\": [11084016], \"schemaClass\": \"Complex\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-9695910\", \"stIdVersion\": \"R-SPO-9695910.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SPO\", \"className\": \"Species\", \"dbId\": 68324, \"displayName\": \"Schizosaccharomyces pombe\", \"name\": [\"Schizosaccharomyces pombe\", \"S.pombe\", \"S. pombe\", \"fission yeast\", \"Sp\"], \"schemaClass\": \"Species\", \"taxId\": \"4896\"}], \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-9695917\", \"stIdVersion\": \"R-SPO-9695917.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\"}]}"
      }
    ],
