        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11062979], \"className\": \"CatalystActivity\", \"dbId\": 11062977, \"displayName\": \"ATP citrate synthase activity of ACLY tetramer [cytosol]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}], \"dbId\": 11062979, \"displayName\": \"ACLY tetramer transforms CIT to Ac-CoA\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"followingEvent\": [11063007], \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11062979], \"dbId\": 76190, \"displayName\": \"CIT [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CIT\", \"citrate(3-)\", \"Citrate\", \"citric acid\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76190\", \"stIdVersion\": \"R-ALL-76190.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11062979], \"dbId\": 76194, \"displayName\": \"CoA-SH [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"CoA-SH\", \"coenzyme A(4-)\", \"coenzyme A\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-76194\", \"stIdVersion\": \"R-ALL-76194.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11062979], \"dbId\": 113592, \"displayName\": \"ATP [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\