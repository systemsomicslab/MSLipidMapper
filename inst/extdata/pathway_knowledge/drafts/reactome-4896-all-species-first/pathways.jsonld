    "https://systemomicslab.github.io/MSLipidMapper/ontology/evidenceJson": [
      {
        "@value": "{\"catalystActivity\": [{\"catalyzedEvent\": [11068354], \"className\": \"CatalystActivity\", \"dbId\": 11068346, \"displayName\": \"sphingosine-1-phosphate phosphatase activity of PLPP1 [plasma membrane]\", \"schemaClass\": \"CatalystActivity\"}], \"category\": \"transition\", \"className\": \"Reaction\", \"compartment\": [{\"accession\": \"0005829\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 70101, \"definition\": \"The part of the cytoplasm that does not contain organelles but which does contain other particulate matter, such as protein complexes.\", \"displayName\": \"cytosol\", \"name\": \"cytosol\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005829\"}, {\"accession\": \"0005886\", \"className\": \"Compartment\", \"databaseName\": \"GO\", \"dbId\": 876, \"definition\": \"The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.\", \"displayName\": \"plasma membrane\", \"name\": \"plasma membrane\", \"schemaClass\": \"Compartment\", \"url\": \"https://www.ebi.ac.uk/QuickGO/term/GO:0005886\"}], \"dbId\": 11068354, \"displayName\": \"PLPP1,2,3 dephosphorylate cytosolic sphingosine-1-phosphate\", \"evidenceType\": {\"className\": \"EvidenceType\", \"dbId\": 9990865, \"displayName\": \"inferred by electronic annotation\", \"name\": [\"inferred by electronic annotation\", \"IEA\"], \"schemaClass\": \"EvidenceType\"}, \"input\": [{\"className\": \"Chemical Compound\", \"consumedByEvent\": [11068354], \"dbId\": 29356, \"displayName\": \"H2O [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"H2O\", \"water\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29356\", \"stIdVersion\": \"R-ALL-29356.5\"}, {\"className\": \"Chemical Compound\", \"consumedByEvent\": [11068354], \"dbId\": 428203, \"displayName\": \"C18-S1P [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"C18-S1P\", \"sphingosine 1-phosphate(1-)\", \"S1P\", \"SPGP\", \"sphingosine 1-phosphate\", \"Sphingosine-1-phosphate\"], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-428203\", \"stIdVersion\": \"R-ALL-428203.7\"}], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"PLPP1,2,3 dephosphorylate cytosolic sphingosine-1-phosphate\", \"sphingosine 1-phosphate + H2O => sphingosine + orthophosphate [cytosolic - PPAP]\"], \"output\": [{\"className\": \"Chemical Compound\", \"dbId\": 29372, \"displayName\": \"Pi [cytosol]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"Pi\", \"hydrogenphosphate\", \"Orthophosphate\", \"Phosphate\", \"Inorganic Phosphate\"], \"producedByEvent\": [11068354], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-29372\", \"stIdVersion\": \"R-ALL-29372.5\"}, {\"className\": \"Chemical Compound\", \"dbId\": 1132148, \"displayName\": \"sphingosine [cytoplasm]\", \"inDisease\": false, \"maxDepth\": 1, \"name\": [\"sphingosine\", \"sphingosine(1+)\", \"sphing-4-enine\", \"phys-ent-participant33701\"], \"producedByEvent\": [11068354], \"referenceType\": \"ReferenceMolecule\", \"schemaClass\": \"SimpleEntity\", \"stId\": \"R-ALL-1132148\", \"stIdVersion\": \"R-ALL-1132148.2\"}], \"precedingEvent\": [{\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11068328, \"displayName\": \"SPHK1 phosphorylates sphingoid\", \"followingEvent\": [11068354], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SPHK1 phosphorylates sphingoid\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-428273\", \"stIdVersion\": \"R-SPO-428273.1\"}, {\"category\": \"transition\", \"className\": \"Reaction\", \"dbId\": 11084019, \"displayName\": \"SPHK2 phosphorylates sphingoid\", \"followingEvent\": [11068354], \"isInDisease\": false, \"isInferred\": true, \"maxDepth\": 1, \"name\": [\"SPHK2 phosphorylates sphingoid\"], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-9695949\", \"stIdVersion\": \"R-SPO-9695949.1\"}], \"releaseDate\": \"2026-06-17\", \"schemaClass\": \"Reaction\", \"species\": [{\"abbreviation\": \"SPO\", \"className\": \"Species\", \"dbId\": 68324, \"displayName\": \"Schizosaccharomyces pombe\", \"name\": [\"Schizosaccharomyces pombe\", \"S.pombe\", \"S. pombe\", \"fission yeast\", \"Sp\"], \"schemaClass\": \"Species\", \"taxId\": \"4896\"}], \"speciesName\": \"Schizosaccharomyces pombe\", \"stId\": \"R-SPO-428696\", \"stIdVersion\": \"R-SPO-428696.1\", \"summation\": [{\"className\": \"Summation\", \"dbId\": 9990864, \"displayName\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>\", \"schemaClass\": \"Summation\", \"text\": \"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping)