@prefix mslm: <https://systemomicslab.github.io/MSLipidMapper/ontology/> .
@prefix res: <https://systemomicslab.github.io/MSLipidMapper/resource/> .
@prefix ex: <https://systemomicslab.github.io/MSLipidMapper/example/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Synthetic values used only to demonstrate the graph contract.
ex:study_001 a mslm:Study .
ex:dataset_001 a mslm:Dataset ; mslm:inStudy ex:study_001 .
ex:comparison_aged_vs_young a mslm:Comparison ;
  mslm:conditionA "aged" ; mslm:conditionB "young" .

ex:obs_PE a mslm:LipidSubclassObservation ;
  mslm:inDataset ex:dataset_001 ; mslm:inComparison ex:comparison_aged_vs_young ;
  mslm:observedLipidSubclass res:Phosphatidylethanolamine ;
  mslm:detectionStatus mslm:Observed ;
  mslm:effectSize "-0.35"^^xsd:decimal ; mslm:effectSizeType "log2_fold_change" ;
  mslm:pValue "0.012"^^xsd:decimal ; mslm:adjustedPValue "0.041"^^xsd:decimal ;
  mslm:sampleSizeA 8 ; mslm:sampleSizeB 8 ;
  mslm:aggregationMethod "sum molecular-species abundance by MS-DIAL Ontology" .

ex:obs_PMME a mslm:LipidSubclassObservation ;
  mslm:inDataset ex:dataset_001 ; mslm:inComparison ex:comparison_aged_vs_young ;
  mslm:observedLipidSubclass res:Phosphatidylmonomethylethanolamine ;
  mslm:detectionStatus mslm:NotMeasured .
ex:obs_PDME a mslm:LipidSubclassObservation ;
  mslm:inDataset ex:dataset_001 ; mslm:inComparison ex:comparison_aged_vs_young ;
  mslm:observedLipidSubclass res:Phosphatidyldimethylethanolamine ;
  mslm:detectionStatus mslm:NotMeasured .

ex:obs_PC a mslm:LipidSubclassObservation ;
  mslm:inDataset ex:dataset_001 ; mslm:inComparison ex:comparison_aged_vs_young ;
  mslm:observedLipidSubclass res:Phosphatidylcholine ;
  mslm:detectionStatus mslm:Observed ;
  mslm:effectSize "0.42"^^xsd:decimal ; mslm:effectSizeType "log2_fold_change" ;
  mslm:pValue "0.004"^^xsd:decimal ; mslm:adjustedPValue "0.019"^^xsd:decimal ;
  mslm:sampleSizeA 8 ; mslm:sampleSizeB 8 ;
  mslm:aggregationMethod "sum molecular-species abundance by MS-DIAL Ontology" .
