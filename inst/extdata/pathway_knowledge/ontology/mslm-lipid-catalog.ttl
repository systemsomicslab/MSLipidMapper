@prefix mslm: <https://systemomicslab.github.io/MSLipidMapper/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mslm:LipidReaction rdfs:comment "Source reaction involving a lipid or its conjugate acid/base. This type does not assert that a class projection has been reviewed."@en .
mslm:leftParticipant a owl:ObjectProperty ; rdfs:range mslm:ReactionParticipant ;
  rdfs:comment "Participant on the canonical Rhea equation left side; not a physiological substrate assertion."@en .
mslm:rightParticipant a owl:ObjectProperty ; rdfs:range mslm:ReactionParticipant ;
  rdfs:comment "Participant on the canonical Rhea equation right side; not a physiological product assertion."@en .
mslm:leftClass a owl:ObjectProperty ;
  rdfs:comment "Lipid compound with a class assignment on the equation left side."@en .
mslm:rightClass a owl:ObjectProperty ;
  rdfs:comment "Lipid compound with a class assignment on the equation right side."@en .
mslm:reactionKind a owl:DatatypeProperty ; rdfs:range xsd:string .
mslm:supportedByProtein a owl:ObjectProperty .
mslm:reviewed a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
  rdfs:comment "Review status of the source UniProt protein entry, not experimental proof in mouse."@en .
mslm:evidenceJson a owl:DatatypeProperty ; rdfs:range xsd:string ;
  rdfs:comment "Unmodified structured source evidence, serialized as JSON."@en .
mslm:mappingMethod a owl:DatatypeProperty ; rdfs:range xsd:string .
mslm:equation a owl:DatatypeProperty ; rdfs:range xsd:string .
mslm:coefficientExpression a owl:DatatypeProperty ; rdfs:range xsd:string ;
  rdfs:comment "Symbolic source coefficient such as N; never converted to a guessed number."@en .
mslm:EquationLeft a mslm:ParticipantRole .
mslm:EquationRight a mslm:ParticipantRole .
mslm:SourceChemicalResolution a mslm:ResolutionLevel ;
  rdfs:comment "Resolution is retained from the source: generic classes, polymers and molecular species can coexist."@en .
mslm:DatabaseAnnotation a mslm:AssertionMethod .
mslm:classMappingComplete a owl:DatatypeProperty ; rdfs:range xsd:boolean .
mslm:sourceChemicalReference a owl:ObjectProperty ;
  rdfs:comment "ChEBI reference supplied by Rhea for the compound, its reactive part or underlying polymer. The full source compound remains the participant entity."@en .
mslm:hasSourceReaction a owl:ObjectProperty ; rdfs:range mslm:LipidReaction .
mslm:hasProjectionReaction a owl:ObjectProperty ; rdfs:range mslm:ReactionTraversalProjection .
