@prefix mslm: <https://systemomicslab.github.io/MSLipidMapper/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mslm:OrganismPathwayDataset a owl:Class .
mslm:OrganismPathwayDatasetSeries a owl:Class .
mslm:LipidMapsClassification a owl:Class .
mslm:lipidMapsClassification a owl:ObjectProperty ; rdfs:range mslm:LipidMapsClassification .
mslm:lipidMapsMappingRelation a owl:ObjectProperty .
mslm:EquivalentClassification a owl:NamedIndividual .
mslm:BroaderClassification a owl:NamedIndividual ;
  rdfs:comment "The LIPID MAPS classification encompasses, but does not uniquely identify, this biochemical class."@en .
mslm:Pathway a owl:Class .
mslm:ClassReaction a owl:Class ; rdfs:subClassOf mslm:Reaction ;
  rdfs:comment "An explicitly curated lipid class reaction or reaction-stage projection; not a molecular-species reaction."@en .
mslm:hasPathway a owl:ObjectProperty ; rdfs:range mslm:Pathway .
mslm:hasReaction a owl:ObjectProperty ; rdfs:range mslm:ClassReaction .
mslm:hasOrganismAssertion a owl:ObjectProperty ; rdfs:range mslm:OrganismReactionAssertion .
mslm:classReaction a owl:ObjectProperty ; rdfs:range mslm:ClassReaction .
mslm:classLabel a owl:DatatypeProperty ; rdfs:range xsd:string .
mslm:membershipMethod a owl:DatatypeProperty ; rdfs:range xsd:string .
mslm:sourceRelease a owl:DatatypeProperty ; rdfs:range xsd:string .
mslm:sourceVersionKnown a owl:DatatypeProperty ; rdfs:range xsd:boolean .
mslm:retrievedOn a owl:DatatypeProperty ; rdfs:range xsd:date .
mslm:uniprotReviewed a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
  rdfs:comment "Swiss-Prot review status, not proof of experimentally demonstrated reaction activity."@en .
mslm:annotationEvidence a owl:DatatypeProperty ; rdfs:range xsd:string ;
  rdfs:comment "Lossless source catalytic-activity JSON, including original evidence codes and reaction references."@en .
mslm:knowledgeDataset a owl:ObjectProperty ; rdfs:range mslm:OrganismPathwayDataset .
mslm:knowledgeRelease a owl:DatatypeProperty ; rdfs:range xsd:string .
mslm:mappingRulesVersion a owl:DatatypeProperty ; rdfs:range xsd:string .
mslm:KnowledgeProjection a mslm:AssertionMethod .
