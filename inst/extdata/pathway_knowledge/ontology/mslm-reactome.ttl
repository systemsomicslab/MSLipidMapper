@prefix mslm: <https://systemomicslab.github.io/MSLipidMapper/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mslm:SourceForward a mslm:Directionality ;
  rdfs:comment "Left-to-right in the source SBML model; does not establish physiological flux."@en .
mslm:OrthologyInference a mslm:AssertionMethod .
mslm:isInferred a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
  rdfs:comment "Reactome's source isInferred flag. True is not experimental confirmation in this organism."@en .
mslm:sourceStableIdVersion a owl:DatatypeProperty ; rdfs:range xsd:string .
mslm:sourceEventType a owl:DatatypeProperty ; rdfs:range xsd:string .
mslm:sourceEntityType a owl:DatatypeProperty ; rdfs:range xsd:string .
mslm:sourceCompartment a owl:DatatypeProperty ; rdfs:range xsd:string .
mslm:sourceComponentReference a owl:ObjectProperty ;
  rdfs:comment "Archived component reference. Does not assert a free reaction substrate or a simultaneous set member."@en .
mslm:sourceModifier a owl:ObjectProperty .
mslm:hasPathway a owl:ObjectProperty .
mslm:hasEvent a owl:ObjectProperty ;
  rdfs:comment "Direct pathway containment, preserving the source hierarchy."@en .
mslm:projectedClass a owl:ObjectProperty ; rdfs:range mslm:LipidEntity .
mslm:mappingEvidenceJson a owl:DatatypeProperty ; rdfs:range xsd:string .
