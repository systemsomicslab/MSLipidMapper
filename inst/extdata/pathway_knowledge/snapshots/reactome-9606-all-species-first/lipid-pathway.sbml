      <reaction compartment="compartment_70101" fast="false" id="reaction_6809254" metaid="metaid_1886" name="MTMR8 binds MTMR9" reversible="false">
        <notes>
          <p xmlns="http://www.w3.org/1999/xhtml">MTMR8 binds to MTMR9, an enzymatically inactive myotubularin family member, which results in increased stability and increased catalytic activity of MTMR8 (Zou et al. 2012).</p>
        </notes>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/">
