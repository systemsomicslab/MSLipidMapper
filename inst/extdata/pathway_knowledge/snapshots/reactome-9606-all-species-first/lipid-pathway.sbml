      <reaction compartment="compartment_7660" fast="false" id="reaction_2426155" metaid="metaid_2073" name="SREBP1A,2 binds the DHCR7 promoter" reversible="false">
        <notes>
          <p xmlns="http://www.w3.org/1999/xhtml">SREBP1A (SREBF1A) and SREBP2, together with NF-Y and SP1, bind and transactivate the promoter of the DHCR7 gene (Reed et al. 2008).</p>
        </notes>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/">
            <rdf:Description rdf:about="#metaid_2073">
              <dc:creator>
                <rdf:Bag>
                  <rdf:li rdf:parseType="Resource">
                    <vCard:N rdf:parseType="Resource">
                      <vCard:Family>May</vCard:Family>
                      <vCard:Given>Bruce</vCard:Given>
                    </vCard:N>
