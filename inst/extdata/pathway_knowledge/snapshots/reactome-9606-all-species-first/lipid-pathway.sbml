      <reaction compartment="compartment_12045" fast="false" id="reaction_1482696" metaid="metaid_2757" name="1-acyl LPC is hydrolyzed to GPCho by PLA2G4C" reversible="false">
        <notes>
          <p xmlns="http://www.w3.org/1999/xhtml">At the endoplasmic reticulum (ER) membrane, 1-acyl lysophosphatidylcholine (LPC) is hydrolyzed to glycerophosphocholine (GPCho) by membrane-bound cytosolic phospholipase A2 gamma (PLA2G4C) (Yamashita et al. 2005, Ghomashchi et al. 2010, Yamashita et al. 2009).</p>
        </notes>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/">
            <rdf:Description rdf:about="#metaid_2757">
              <dc:creator>
                <rdf:Bag>
                  <rdf:li rdf:parseType="Resource">
                    <vCard:N rdf:parseType="Resource">
                      <vCard:Family>Williams</vCard:Family>
                      <vCard:Given></vCard:Given>
                    </vCard:N>
                  </rdf:li>
                  <rdf:li rdf:parseType="Resource">
                    <vCard:N rdf:parseType="Resource">
                      <vCard:Family>Williams</vCard:Family>
                      <vCard:Given></vCard:Given>
                    </vCard:N>
                  </rdf:li>
                  <rdf:li rdf:parseType="Resource">
