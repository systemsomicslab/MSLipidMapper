      <reaction compartment="compartment_70101" fast="false" id="reaction_9027033" metaid="metaid_1873" name="Hydroperoxy reducatase reduces 14(S)-Hp-DHA to 14(S)-HDHA" reversible="false">
        <notes>
          <p xmlns="http://www.w3.org/1999/xhtml">An unidentified hydroperoxy reductase reduces 14(S)-hydroperoxy-docosahexaenoic acid (14(S)-Hp-DHA) to form 14(S)-hydroxy-docosahexaenoic acid (14(S)-HDHA), the precursor for the formation of maresin-like mediator Mar-L1 (Hong et al. 2014) and 14(S),21-dihydroxy-docosahexaenoic acids (Lu et al. 2010).</p>
        </notes>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/">
            <rdf:Description rdf:about="#metaid_1873">
              <dc:creator>
                <rdf:Bag>
                  <rdf:li rdf:parseType="Resource">
                    <vCard:N rdf:parseType="Resource">
                      <vCard:Family>Jassal</vCard:Family>
                      <vCard:Given>Bijay</vCard:Given>
                    </vCard:N>
                    <vCard:ORG rdf:parseType="Resource">
