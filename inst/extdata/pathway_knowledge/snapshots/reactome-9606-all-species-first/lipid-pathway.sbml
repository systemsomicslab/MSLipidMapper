      <reaction compartment="compartment_5460" fast="false" id="reaction_77283" metaid="metaid_2120" name="(S)-3-Hydroxytetradecanoyl-CoA+NAD =&gt; 3-Oxotetradecanoyl-CoA+NADH+H" reversible="false">
