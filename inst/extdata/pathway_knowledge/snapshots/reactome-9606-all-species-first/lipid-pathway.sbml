      <reaction compartment="compartment_70101" fast="false" id="reaction_2026996" metaid="metaid_2204" name="FABP1 transports fatty acids into the nucleus" reversible="false">
        <notes>
          <p xmlns="http://www.w3.org/1999/xhtml">FABP1 binds fatty acids in the cytosol and shuttles to the nucleus.</p>
        </notes>
