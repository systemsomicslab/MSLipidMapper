      <reaction compartment="compartment_70101" fast="false" id="reaction_2161779" metaid="metaid_2572" name="LXA4 is oxidised to 15k-LXA4 by HPGD" reversible="false">
        <notes>
          <p xmlns="http://www.w3.org/1999/xhtml">15-Hydroxyprostaglandin dehydrogenase (HPGD) converts lipoxin A4 (LXA4) to 15-oxo lipoxin A4 aka 15-keto-LXA4 (15k-LXA4) (Clish et al. 2000).</p>
        </notes>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/">
            <rdf:Description rdf:about="#metaid_2572">
              <dc:creator>
                <rdf:Bag>
                  <rdf:li rdf:parseType="Resource">
                    <vCard:N rdf:parseType="Resource">
                      <vCard:Family>Williams</vCard:Family>
