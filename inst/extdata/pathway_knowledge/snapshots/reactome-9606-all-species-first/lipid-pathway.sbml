      <reaction compartment="compartment_70101" fast="false" id="reaction_193964" metaid="metaid_2022" name="CYP21A2 21-hydroxylates PROG" reversible="false">
        <notes>
          <p xmlns="http://www.w3.org/1999/xhtml">Progesterone, NAPDH + H+, and O2 react to form 11-deoxycorticosterone, NADP+ and H2O. This reaction is catalyzed by CYP21A2 associated with the endoplasmic reticulum membrane.</p>
        </notes>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/">
