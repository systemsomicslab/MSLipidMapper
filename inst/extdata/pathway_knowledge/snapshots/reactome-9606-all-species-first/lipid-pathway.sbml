      <reaction compartment="compartment_17951" fast="false" id="reaction_2066782" metaid="metaid_2404" name="Translocation of DPA to the ER" reversible="false">
        <notes>
          <p xmlns="http://www.w3.org/1999/xhtml">The resulted free DPA is transported back to ER, where it is incorporated into membrane lipids.</p>
        </notes>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/">
