      <reaction compartment="compartment_7660" fast="false" id="reaction_2426151" metaid="metaid_1913" name="SREBP1A,2 binds the SQLE promoter" reversible="false">
        <notes>
          <p xmlns="http://www.w3.org/1999/xhtml">SREBP1A (SREBF1A) or SREBP2 binds and transactivates the promoter of the SQLE gene (Reed et al. 2008). The promoter also contains a consensus binding site for NF-Y (Nagai et al. 2002).</p>
        </notes>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/">
            <rdf:Description rdf:about="#metaid_1913">
              <dc:creator>
                <rdf:Bag>
                  <rdf:li rdf:parseType="Resource">
                    <vCard:N rdf:parseType="Resource">
                      <vCard:Family>May</vCard:Family>
                      <vCard:Given>Bruce</vCard:Given>
                    </vCard:N>
                    <vCard:ORG rdf:parseType="Resource">
                      <vCard:Orgname>CSHL</vCard:Orgname>
                    </vCard:ORG>
                  </rdf:li>
                  <rdf:li rdf:parseType="Resource">
                    <vCard:N rdf:parseType="Resource">
                      <vCard:Family>May</vCard:Family>
