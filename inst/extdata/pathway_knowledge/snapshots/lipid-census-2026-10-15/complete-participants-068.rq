PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:80235 rh:80239 rh:80243 rh:80247 rh:80279 rh:80283 rh:80291 rh:80295 rh:80299 rh:80303 rh:80307 rh:80311 rh:80315 rh:80327 rh:80335 rh:80343 rh:80347 rh:80351 rh:80387 rh:80391 rh:80395 rh:80399 rh:80403 rh:80407 rh:80535 rh:80591 rh:80663 rh:80719 rh:80723 rh:80731 rh:80735 rh:80751 rh:80755 rh:80803 rh:80815 rh:80819 rh:80823 rh:80831 rh:80859 rh:80863 rh:80867 rh:80871 rh:80875 rh:80879 rh:80883 rh:80895 rh:80947 rh:80951 rh:80955 rh:80959 rh:80971 rh:80979 rh:80983 rh:80987 rh:81091 rh:81095 rh:81099 rh:81103 rh:81111 rh:81151 rh:81155 rh:81159 rh:81163 rh:81167 rh:81171 rh:81219 rh:81223 rh:81231 rh:81351 rh:81371 rh:81443 rh:81447 rh:81451 rh:81463 rh:81475 rh:81479 rh:81539 rh:81543 rh:81551 rh:81567 rh:81571 rh:81575 rh:81583 rh:81587 rh:81591 rh:81599 rh:81603 rh:81627 rh:81667 rh:81695 rh:81699 rh:81703 rh:81711 rh:81715 rh:81723 rh:81727 rh:81731 rh:81735 rh:81739 rh:81743 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated