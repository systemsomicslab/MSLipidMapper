PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:17977 rh:18001 rh:18009 rh:18021 rh:18081 rh:18109 rh:18137 rh:18161 rh:18177 rh:18209 rh:18221 rh:18225 rh:18265 rh:18269 rh:18325 rh:18329 rh:18361 rh:18373 rh:18385 rh:18409 rh:18417 rh:18461 rh:18485 rh:18501 rh:18557 rh:18561 rh:18593 rh:18689 rh:18721 rh:18725 rh:18741 rh:18761 rh:18765 rh:18785 rh:18801 rh:18837 rh:18857 rh:18865 rh:18913 rh:18949 rh:18957 rh:18969 rh:18993 rh:19041 rh:19045 rh:19057 rh:19113 rh:19137 rh:19141 rh:19165 rh:19181 rh:19185 rh:19193 rh:19233 rh:19241 rh:19253 rh:19281 rh:19285 rh:19293 rh:19329 rh:19341 rh:19345 rh:19349 rh:19353 rh:19361 rh:19405 rh:19409 rh:19417 rh:19441 rh:19481 rh:19485 rh:19525 rh:19557 rh:19561 rh:19565 rh:19585 rh:19605 rh:19641 rh:19665 rh:19673 rh:19677 rh:19697 rh:19705 rh:19709 rh:19713 rh:19721 rh:19729 rh:19825 rh:19857 rh:19861 rh:19873 rh:19877 rh:20025 rh:20081 rh:20101 rh:20137 rh:20233 rh:20253 rh:20261 rh:20373 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated