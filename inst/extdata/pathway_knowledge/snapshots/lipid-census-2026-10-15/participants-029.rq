PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:52876 rh:52880 rh:52916 rh:52920 rh:52924 rh:53000 rh:53004 rh:53008 rh:53032 rh:53036 rh:53040 rh:53048 rh:53052 rh:53060 rh:53064 rh:53068 rh:53072 rh:53080 rh:53088 rh:53092 rh:53096 rh:53100 rh:53104 rh:53108 rh:53112 rh:53116 rh:53124 rh:53128 rh:53132 rh:53140 rh:53144 rh:53148 rh:53152 rh:53156 rh:53168 rh:53176 rh:53184 rh:53188 rh:53192 rh:53196 rh:53200 rh:53204 rh:53212 rh:53216 rh:53220 rh:53224 rh:53228 rh:53232 rh:53236 rh:53240 rh:53244 rh:53248 rh:53252 rh:53256 rh:53260 rh:53264 rh:53276 rh:53308 rh:53312 rh:53324 rh:53332 rh:53388 rh:53400 rh:53404 rh:53408 rh:53412 rh:53424 rh:53444 rh:53448 rh:53452 rh:53456 rh:53460 rh:53464 rh:53468 rh:53472 rh:53476 rh:53480 rh:53484 rh:53488 rh:53496 rh:53500 rh:53508 rh:53512 rh:53516 rh:53520 rh:53524 rh:53528 rh:53532 rh:53536 rh:53540 rh:53548 rh:53552 rh:53556 rh:53560 rh:53564 rh:53568 rh:53572 rh:53576 rh:53580 rh:53584 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated