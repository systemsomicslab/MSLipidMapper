PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:10000 rh:10052 rh:10100 rh:10128 rh:10140 rh:10172 rh:10200 rh:10212 rh:10244 rh:10272 rh:10332 rh:10340 rh:10344 rh:10356 rh:10428 rh:10460 rh:10472 rh:10520 rh:10600 rh:10604 rh:10652 rh:10664 rh:10696 rh:10700 rh:10856 rh:10868 rh:10884 rh:10896 rh:10928 rh:10940 rh:11048 rh:11156 rh:11168 rh:11248 rh:11256 rh:11384 rh:11388 rh:11448 rh:11452 rh:11468 rh:11488 rh:11520 rh:11524 rh:11552 rh:11624 rh:11636 rh:11648 rh:11664 rh:11700 rh:11712 rh:11736 rh:11796 rh:11824 rh:11872 rh:11876 rh:11884 rh:11896 rh:11908 rh:11912 rh:11916 rh:11924 rh:11932 rh:11956 rh:11964 rh:11984 rh:12016 rh:12032 rh:12044 rh:12052 rh:12088 rh:12192 rh:12296 rh:12468 rh:12508 rh:12516 rh:12548 rh:12584 rh:12661 rh:12677 rh:12729 rh:12869 rh:12873 rh:12893 rh:12897 rh:12913 rh:12937 rh:12961 rh:13025 rh:13045 rh:13093 rh:13133 rh:13137 rh:13189 rh:13269 rh:13273 rh:13301 rh:13321 rh:13329 rh:13349 rh:13369 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated