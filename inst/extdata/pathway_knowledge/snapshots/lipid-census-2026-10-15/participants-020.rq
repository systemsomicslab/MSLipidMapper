PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:43984 rh:43992 rh:44004 rh:44008 rh:44016 rh:44020 rh:44032 rh:44036 rh:44040 rh:44044 rh:44048 rh:44052 rh:44056 rh:44060 rh:44064 rh:44068 rh:44072 rh:44076 rh:44080 rh:44084 rh:44088 rh:44092 rh:44096 rh:44100 rh:44104 rh:44108 rh:44112 rh:44116 rh:44120 rh:44124 rh:44128 rh:44136 rh:44168 rh:44172 rh:44176 rh:44192 rh:44196 rh:44200 rh:44204 rh:44208 rh:44212 rh:44216 rh:44220 rh:44224 rh:44228 rh:44232 rh:44236 rh:44240 rh:44244 rh:44248 rh:44252 rh:44256 rh:44288 rh:44292 rh:44308 rh:44312 rh:44316 rh:44320 rh:44324 rh:44328 rh:44376 rh:44408 rh:44416 rh:44420 rh:44424 rh:44428 rh:44432 rh:44436 rh:44440 rh:44444 rh:44456 rh:44460 rh:44464 rh:44468 rh:44472 rh:44476 rh:44496 rh:44500 rh:44508 rh:44512 rh:44516 rh:44520 rh:44524 rh:44528 rh:44532 rh:44536 rh:44540 rh:44544 rh:44548 rh:44552 rh:44556 rh:44564 rh:44584 rh:44588 rh:44596 rh:44600 rh:44604 rh:44616 rh:44620 rh:44648 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated