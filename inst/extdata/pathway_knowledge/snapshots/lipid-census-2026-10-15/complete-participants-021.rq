PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:38247 rh:38251 rh:38255 rh:38259 rh:38263 rh:38267 rh:38271 rh:38275 rh:38279 rh:38283 rh:38287 rh:38291 rh:38295 rh:38299 rh:38307 rh:38323 rh:38327 rh:38331 rh:38335 rh:38339 rh:38343 rh:38363 rh:38375 rh:38379 rh:38383 rh:38387 rh:38391 rh:38395 rh:38399 rh:38403 rh:38407 rh:38411 rh:38415 rh:38419 rh:38423 rh:38427 rh:38431 rh:38435 rh:38439 rh:38443 rh:38455 rh:38459 rh:38463 rh:38467 rh:38483 rh:38487 rh:38491 rh:38495 rh:38499 rh:38503 rh:38507 rh:38511 rh:38515 rh:38519 rh:38523 rh:38527 rh:38551 rh:38555 rh:38559 rh:38563 rh:38567 rh:38571 rh:38575 rh:38579 rh:38583 rh:38595 rh:38623 rh:38627 rh:38631 rh:38635 rh:38639 rh:38643 rh:38647 rh:38651 rh:38655 rh:38659 rh:38663 rh:38667 rh:38671 rh:38675 rh:38679 rh:38683 rh:38687 rh:38691 rh:38695 rh:38699 rh:38703 rh:38707 rh:38711 rh:38723 rh:38727 rh:38731 rh:38735 rh:38739 rh:38743 rh:38747 rh:38751 rh:38755 rh:38759 rh:38763 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated