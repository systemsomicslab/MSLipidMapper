PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:60096 rh:60108 rh:60120 rh:60124 rh:60128 rh:60140 rh:60168 rh:60172 rh:60252 rh:60356 rh:60424 rh:60432 rh:60488 rh:60496 rh:60500 rh:60504 rh:60572 rh:60580 rh:60604 rh:60608 rh:60612 rh:60620 rh:60624 rh:60632 rh:60636 rh:60644 rh:60652 rh:60656 rh:60668 rh:60672 rh:60676 rh:60680 rh:60684 rh:60688 rh:60692 rh:60696 rh:60700 rh:60704 rh:60708 rh:60712 rh:60716 rh:60720 rh:60724 rh:60728 rh:60736 rh:60740 rh:60752 rh:60756 rh:60760 rh:60764 rh:60768 rh:60772 rh:60776 rh:60780 rh:60784 rh:60788 rh:60792 rh:60796 rh:60800 rh:60804 rh:60808 rh:60812 rh:60816 rh:60904 rh:60928 rh:60932 rh:60936 rh:60940 rh:60956 rh:60960 rh:60964 rh:60968 rh:60972 rh:60976 rh:60980 rh:60984 rh:61028 rh:61060 rh:61064 rh:61192 rh:61216 rh:61220 rh:61252 rh:61268 rh:61272 rh:61308 rh:61312 rh:61316 rh:61320 rh:61324 rh:61328 rh:61340 rh:61348 rh:61364 rh:61416 rh:61420 rh:61424 rh:61428 rh:61432 rh:61472 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated