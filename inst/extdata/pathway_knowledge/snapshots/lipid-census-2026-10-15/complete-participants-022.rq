PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:38767 rh:38771 rh:38775 rh:38779 rh:38783 rh:38787 rh:38791 rh:38795 rh:38799 rh:38803 rh:38807 rh:38811 rh:38815 rh:38819 rh:38823 rh:38827 rh:38831 rh:38835 rh:38839 rh:38843 rh:38847 rh:38855 rh:38859 rh:38879 rh:38883 rh:38887 rh:38891 rh:38899 rh:38903 rh:38911 rh:38915 rh:38919 rh:38927 rh:38931 rh:38939 rh:38943 rh:38947 rh:38951 rh:38955 rh:38959 rh:38963 rh:38967 rh:38971 rh:38975 rh:38979 rh:38983 rh:38987 rh:38991 rh:38995 rh:38999 rh:39003 rh:39007 rh:39011 rh:39015 rh:39019 rh:39023 rh:39027 rh:39031 rh:39035 rh:39039 rh:39043 rh:39047 rh:39051 rh:39055 rh:39059 rh:39067 rh:39071 rh:39075 rh:39079 rh:39083 rh:39087 rh:39091 rh:39095 rh:39099 rh:39103 rh:39107 rh:39119 rh:39123 rh:39127 rh:39131 rh:39135 rh:39139 rh:39143 rh:39147 rh:39151 rh:39155 rh:39159 rh:39163 rh:39167 rh:39171 rh:39175 rh:39179 rh:39183 rh:39187 rh:39191 rh:39195 rh:39199 rh:39203 rh:39207 rh:39211 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated