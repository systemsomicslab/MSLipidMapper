PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:15921 rh:15949 rh:15965 rh:15973 rh:15989 rh:16021 rh:16033 rh:16045 rh:16053 rh:16065 rh:16093 rh:16105 rh:16117 rh:16177 rh:16197 rh:16229 rh:16245 rh:16273 rh:16297 rh:16305 rh:16309 rh:16329 rh:16345 rh:16393 rh:16405 rh:16473 rh:16477 rh:16537 rh:16541 rh:16561 rh:16605 rh:16629 rh:16641 rh:16645 rh:16665 rh:16685 rh:16693 rh:16701 rh:16705 rh:16717 rh:16725 rh:16741 rh:16773 rh:16781 rh:16861 rh:16865 rh:16869 rh:16897 rh:16905 rh:16913 rh:16933 rh:16937 rh:16965 rh:16977 rh:16981 rh:16985 rh:16997 rh:17057 rh:17073 rh:17093 rh:17101 rh:17137 rh:17177 rh:17181 rh:17193 rh:17209 rh:17285 rh:17317 rh:17329 rh:17341 rh:17349 rh:17369 rh:17373 rh:17377 rh:17381 rh:17449 rh:17469 rh:17485 rh:17505 rh:17517 rh:17549 rh:17617 rh:17621 rh:17637 rh:17653 rh:17657 rh:17689 rh:17701 rh:17709 rh:17721 rh:17729 rh:17777 rh:17849 rh:17857 rh:17861 rh:17929 rh:17945 rh:17957 rh:17961 rh:17965 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated