PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:55504 rh:55508 rh:55512 rh:55516 rh:55556 rh:55560 rh:55588 rh:55596 rh:55604 rh:55608 rh:55616 rh:55620 rh:55656 rh:55660 rh:55664 rh:55668 rh:55688 rh:55692 rh:55696 rh:55700 rh:55712 rh:55716 rh:55740 rh:55788 rh:55800 rh:55804 rh:55808 rh:55828 rh:55832 rh:55836 rh:55840 rh:55844 rh:55920 rh:55936 rh:55940 rh:55956 rh:55968 rh:56060 rh:56088 rh:56104 rh:56124 rh:56128 rh:56148 rh:56152 rh:56156 rh:56164 rh:56168 rh:56184 rh:56228 rh:56236 rh:56240 rh:56244 rh:56248 rh:56336 rh:56340 rh:56408 rh:56412 rh:56424 rh:56428 rh:56432 rh:56436 rh:56440 rh:56444 rh:56448 rh:56460 rh:56464 rh:56484 rh:56496 rh:56504 rh:56532 rh:56536 rh:56540 rh:56544 rh:56548 rh:56556 rh:56568 rh:56572 rh:56576 rh:56596 rh:56632 rh:56636 rh:56640 rh:56708 rh:56724 rh:56728 rh:56732 rh:56736 rh:56740 rh:56748 rh:56752 rh:56756 rh:56760 rh:56768 rh:56772 rh:56820 rh:56824 rh:56880 rh:56900 rh:56916 rh:56920 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated