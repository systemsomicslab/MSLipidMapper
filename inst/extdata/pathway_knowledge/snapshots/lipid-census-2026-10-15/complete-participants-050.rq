PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:58964 rh:58980 rh:58988 rh:59000 rh:59004 rh:59012 rh:59016 rh:59020 rh:59024 rh:59028 rh:59032 rh:59036 rh:59040 rh:59044 rh:59060 rh:59104 rh:59108 rh:59156 rh:59160 rh:59164 rh:59168 rh:59192 rh:59200 rh:59208 rh:59220 rh:59224 rh:59232 rh:59236 rh:59248 rh:59284 rh:59288 rh:59292 rh:59332 rh:59336 rh:59340 rh:59364 rh:59368 rh:59372 rh:59388 rh:59428 rh:59432 rh:59444 rh:59448 rh:59452 rh:59456 rh:59460 rh:59464 rh:59488 rh:59492 rh:59496 rh:59504 rh:59520 rh:59524 rh:59528 rh:59536 rh:59540 rh:59580 rh:59728 rh:59736 rh:59740 rh:59744 rh:59748 rh:59752 rh:59764 rh:59768 rh:59796 rh:59800 rh:59812 rh:59816 rh:59904 rh:59908 rh:59912 rh:59916 rh:59920 rh:59936 rh:59940 rh:59948 rh:59952 rh:59964 rh:59968 rh:59972 rh:60016 rh:60020 rh:60024 rh:60028 rh:60036 rh:60040 rh:60044 rh:60048 rh:60052 rh:60056 rh:60060 rh:60064 rh:60068 rh:60072 rh:60076 rh:60080 rh:60084 rh:60088 rh:60092 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated