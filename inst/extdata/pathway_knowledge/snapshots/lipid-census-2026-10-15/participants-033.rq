PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:56928 rh:56932 rh:56936 rh:56984 rh:56992 rh:57084 rh:57088 rh:57108 rh:57112 rh:57116 rh:57120 rh:57136 rh:57140 rh:57144 rh:57148 rh:57352 rh:57476 rh:57480 rh:57516 rh:57520 rh:57544 rh:57548 rh:57552 rh:57556 rh:57560 rh:57564 rh:57568 rh:57572 rh:57652 rh:57656 rh:57660 rh:57664 rh:57668 rh:57672 rh:57676 rh:57684 rh:57732 rh:57736 rh:57832 rh:57924 rh:57964 rh:57968 rh:57972 rh:57976 rh:57980 rh:57984 rh:57988 rh:57992 rh:57996 rh:58000 rh:58004 rh:58008 rh:58016 rh:58020 rh:58032 rh:58036 rh:58040 rh:58044 rh:58048 rh:58076 rh:58080 rh:58084 rh:58088 rh:58092 rh:58096 rh:58100 rh:58104 rh:58160 rh:58164 rh:58168 rh:58172 rh:58176 rh:58180 rh:58188 rh:58192 rh:58200 rh:58264 rh:58296 rh:58312 rh:58316 rh:58324 rh:58328 rh:58332 rh:58336 rh:58364 rh:58368 rh:58372 rh:58376 rh:58380 rh:58384 rh:58388 rh:58400 rh:58404 rh:58408 rh:58416 rh:58420 rh:58428 rh:58432 rh:58460 rh:58464 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated