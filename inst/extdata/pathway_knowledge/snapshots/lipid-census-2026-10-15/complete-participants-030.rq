PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:43468 rh:43472 rh:43476 rh:43480 rh:43484 rh:43548 rh:43552 rh:43556 rh:43560 rh:43576 rh:43588 rh:43592 rh:43596 rh:43604 rh:43640 rh:43644 rh:43648 rh:43652 rh:43656 rh:43660 rh:43664 rh:43668 rh:43672 rh:43676 rh:43680 rh:43700 rh:43704 rh:43708 rh:43712 rh:43720 rh:43724 rh:43728 rh:43732 rh:43740 rh:43748 rh:43764 rh:43776 rh:43780 rh:43796 rh:43800 rh:43804 rh:43808 rh:43812 rh:43816 rh:43820 rh:43824 rh:43828 rh:43832 rh:43836 rh:43840 rh:43844 rh:43852 rh:43856 rh:43860 rh:43864 rh:43872 rh:43876 rh:43880 rh:43896 rh:43904 rh:43908 rh:43912 rh:43916 rh:43920 rh:43924 rh:43928 rh:43932 rh:43936 rh:43952 rh:43956 rh:43960 rh:43964 rh:43968 rh:43972 rh:43976 rh:43980 rh:43984 rh:43988 rh:43992 rh:43996 rh:44000 rh:44004 rh:44008 rh:44012 rh:44016 rh:44020 rh:44024 rh:44032 rh:44036 rh:44040 rh:44044 rh:44048 rh:44052 rh:44056 rh:44060 rh:44064 rh:44068 rh:44072 rh:44076 rh:44080 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated