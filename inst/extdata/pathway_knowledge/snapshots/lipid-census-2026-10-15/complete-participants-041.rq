PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:50848 rh:50852 rh:50856 rh:50860 rh:50864 rh:50868 rh:50872 rh:50876 rh:50880 rh:50884 rh:50888 rh:50896 rh:50900 rh:50912 rh:50924 rh:50928 rh:50932 rh:50936 rh:50972 rh:50976 rh:50980 rh:50984 rh:50988 rh:50992 rh:51012 rh:51048 rh:51052 rh:51056 rh:51060 rh:51064 rh:51076 rh:51080 rh:51084 rh:51088 rh:51092 rh:51096 rh:51100 rh:51104 rh:51108 rh:51112 rh:51120 rh:51136 rh:51140 rh:51144 rh:51184 rh:51192 rh:51200 rh:51204 rh:51208 rh:51212 rh:51216 rh:51228 rh:51232 rh:51240 rh:51244 rh:51248 rh:51252 rh:51256 rh:51272 rh:51276 rh:51280 rh:51284 rh:51288 rh:51300 rh:51304 rh:51312 rh:51316 rh:51324 rh:51328 rh:51332 rh:51336 rh:51340 rh:51344 rh:51352 rh:51356 rh:51360 rh:51364 rh:51368 rh:51372 rh:51376 rh:51380 rh:51384 rh:51388 rh:51392 rh:51396 rh:51400 rh:51408 rh:51412 rh:51440 rh:51444 rh:51448 rh:51452 rh:51456 rh:51460 rh:51464 rh:51472 rh:51480 rh:51484 rh:51488 rh:51492 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated