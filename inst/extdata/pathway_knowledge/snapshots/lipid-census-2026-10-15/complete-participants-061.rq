PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:70507 rh:70527 rh:70579 rh:70583 rh:70591 rh:70595 rh:70599 rh:70623 rh:70671 rh:70723 rh:70747 rh:70759 rh:70771 rh:71083 rh:71087 rh:71091 rh:71095 rh:71275 rh:71295 rh:71351 rh:71355 rh:71359 rh:71363 rh:71367 rh:71371 rh:71375 rh:71391 rh:71395 rh:71399 rh:71403 rh:71407 rh:71499 rh:71503 rh:71647 rh:71703 rh:71743 rh:71747 rh:71751 rh:71759 rh:71775 rh:71783 rh:71787 rh:71795 rh:71835 rh:71839 rh:71843 rh:71847 rh:71851 rh:71855 rh:71859 rh:71863 rh:71867 rh:71871 rh:71875 rh:71911 rh:71915 rh:71923 rh:71927 rh:71935 rh:71955 rh:71963 rh:71967 rh:71979 rh:71983 rh:71987 rh:71991 rh:71995 rh:71999 rh:72051 rh:72055 rh:72059 rh:72063 rh:72087 rh:72099 rh:72103 rh:72123 rh:72139 rh:72151 rh:72155 rh:72159 rh:72163 rh:72167 rh:72171 rh:72175 rh:72179 rh:72191 rh:72211 rh:72239 rh:72307 rh:72311 rh:72315 rh:72351 rh:72355 rh:72359 rh:72367 rh:72371 rh:72399 rh:72423 rh:72447 rh:72451 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated