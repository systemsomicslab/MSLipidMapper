PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:39619 rh:39623 rh:39627 rh:39631 rh:39635 rh:39639 rh:39643 rh:39651 rh:39655 rh:39659 rh:39671 rh:39675 rh:39679 rh:39683 rh:39687 rh:39691 rh:39695 rh:39699 rh:39703 rh:39707 rh:39715 rh:39719 rh:39723 rh:39727 rh:39731 rh:39735 rh:39739 rh:39743 rh:39747 rh:39751 rh:39755 rh:39759 rh:39767 rh:39771 rh:39775 rh:39779 rh:39783 rh:39787 rh:39791 rh:39795 rh:39799 rh:39803 rh:39807 rh:39811 rh:39815 rh:39819 rh:39823 rh:39835 rh:39839 rh:39843 rh:39847 rh:39851 rh:39855 rh:39859 rh:39863 rh:39871 rh:39875 rh:39879 rh:39895 rh:39899 rh:39915 rh:39919 rh:39923 rh:39927 rh:39931 rh:39935 rh:39939 rh:39943 rh:39947 rh:39951 rh:39955 rh:39959 rh:39963 rh:39975 rh:39983 rh:39987 rh:39991 rh:39995 rh:39999 rh:40003 rh:40007 rh:40011 rh:40015 rh:40019 rh:40023 rh:40027 rh:40031 rh:40047 rh:40055 rh:40059 rh:40063 rh:40067 rh:40079 rh:40083 rh:40087 rh:40091 rh:40095 rh:40099 rh:40103 rh:40107 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated