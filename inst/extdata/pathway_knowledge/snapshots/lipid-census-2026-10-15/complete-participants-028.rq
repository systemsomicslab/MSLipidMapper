PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:41688 rh:41692 rh:41696 rh:41700 rh:41704 rh:41708 rh:41712 rh:41716 rh:41720 rh:41724 rh:41728 rh:41736 rh:41744 rh:41748 rh:41752 rh:41756 rh:41760 rh:41764 rh:41768 rh:41772 rh:41776 rh:41780 rh:41784 rh:41796 rh:41816 rh:41932 rh:41936 rh:41940 rh:41960 rh:41964 rh:41968 rh:41972 rh:41976 rh:41980 rh:41984 rh:41988 rh:41992 rh:41996 rh:42000 rh:42004 rh:42008 rh:42012 rh:42016 rh:42020 rh:42024 rh:42028 rh:42036 rh:42040 rh:42044 rh:42048 rh:42052 rh:42056 rh:42060 rh:42072 rh:42076 rh:42080 rh:42084 rh:42088 rh:42092 rh:42108 rh:42112 rh:42116 rh:42120 rh:42124 rh:42128 rh:42136 rh:42140 rh:42144 rh:42148 rh:42152 rh:42156 rh:42160 rh:42164 rh:42168 rh:42172 rh:42176 rh:42180 rh:42184 rh:42188 rh:42192 rh:42196 rh:42200 rh:42204 rh:42212 rh:42216 rh:42220 rh:42224 rh:42228 rh:42232 rh:42236 rh:42240 rh:42244 rh:42248 rh:42252 rh:42256 rh:42260 rh:42264 rh:42268 rh:42272 rh:42276 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated