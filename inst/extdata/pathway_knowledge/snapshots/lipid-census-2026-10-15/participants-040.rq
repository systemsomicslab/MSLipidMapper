PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:66880 rh:66884 rh:66888 rh:66892 rh:66896 rh:66908 rh:66916 rh:66980 rh:66984 rh:66988 rh:66992 rh:66996 rh:67032 rh:67072 rh:67080 rh:67084 rh:67088 rh:67092 rh:67144 rh:67156 rh:67160 rh:67164 rh:67196 rh:67248 rh:67256 rh:67260 rh:67272 rh:67276 rh:67332 rh:67384 rh:67396 rh:67400 rh:67404 rh:67408 rh:67412 rh:67416 rh:67420 rh:67424 rh:67428 rh:67432 rh:67436 rh:67456 rh:67488 rh:67500 rh:67504 rh:67508 rh:67512 rh:67516 rh:67520 rh:67584 rh:67596 rh:67660 rh:67664 rh:67668 rh:67672 rh:67676 rh:67680 rh:67684 rh:67688 rh:67700 rh:67704 rh:67708 rh:67712 rh:67744 rh:67756 rh:67760 rh:67764 rh:67768 rh:67780 rh:67820 rh:67836 rh:67848 rh:67900 rh:67904 rh:67912 rh:67932 rh:67940 rh:67944 rh:67952 rh:67972 rh:67976 rh:67980 rh:68016 rh:68020 rh:68024 rh:68060 rh:68064 rh:68068 rh:68104 rh:68112 rh:68116 rh:68120 rh:68124 rh:68128 rh:68132 rh:68144 rh:68148 rh:68152 rh:68180 rh:68184 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated