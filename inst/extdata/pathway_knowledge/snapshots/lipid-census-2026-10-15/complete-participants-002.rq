PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:12048 rh:12052 rh:12088 rh:12124 rh:12136 rh:12192 rh:12276 rh:12280 rh:12284 rh:12296 rh:12304 rh:12308 rh:12316 rh:12360 rh:12416 rh:12468 rh:12508 rh:12516 rh:12548 rh:12584 rh:12588 rh:12593 rh:12601 rh:12657 rh:12661 rh:12677 rh:12709 rh:12729 rh:12829 rh:12869 rh:12873 rh:12893 rh:12897 rh:12913 rh:12937 rh:12961 rh:12989 rh:12993 rh:13025 rh:13045 rh:13085 rh:13093 rh:13133 rh:13137 rh:13141 rh:13189 rh:13269 rh:13273 rh:13281 rh:13289 rh:13301 rh:13321 rh:13329 rh:13345 rh:13349 rh:13353 rh:13357 rh:13369 rh:13385 rh:13389 rh:13397 rh:13401 rh:13405 rh:13449 rh:13457 rh:13493 rh:13525 rh:13529 rh:13545 rh:13561 rh:13565 rh:13577 rh:13585 rh:13589 rh:13609 rh:13629 rh:13685 rh:13721 rh:13785 rh:13789 rh:13793 rh:13797 rh:13805 rh:13809 rh:13821 rh:13857 rh:13865 rh:13873 rh:13905 rh:13917 rh:13921 rh:13933 rh:13997 rh:14001 rh:14005 rh:14009 rh:14013 rh:14021 rh:14037 rh:14049 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated