PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:20377 rh:20381 rh:20489 rh:20521 rh:20529 rh:20565 rh:20573 rh:20585 rh:20589 rh:20613 rh:20649 rh:20653 rh:20669 rh:20673 rh:20700 rh:20712 rh:20720 rh:20724 rh:20744 rh:20764 rh:20804 rh:20812 rh:20816 rh:20828 rh:20856 rh:20860 rh:20872 rh:20880 rh:20888 rh:20892 rh:20912 rh:20936 rh:20952 rh:20972 rh:20984 rh:20996 rh:21036 rh:21044 rh:21104 rh:21112 rh:21128 rh:21136 rh:21184 rh:21204 rh:21224 rh:21240 rh:21252 rh:21284 rh:21292 rh:21300 rh:21304 rh:21308 rh:21316 rh:21352 rh:21364 rh:21380 rh:21396 rh:21420 rh:21424 rh:21472 rh:21496 rh:21508 rh:21516 rh:21524 rh:21536 rh:21544 rh:21552 rh:21628 rh:21676 rh:21680 rh:21752 rh:21756 rh:21760 rh:21776 rh:21792 rh:21800 rh:21812 rh:21852 rh:21856 rh:21888 rh:21920 rh:21952 rh:21996 rh:22028 rh:22056 rh:22064 rh:22108 rh:22128 rh:22160 rh:22164 rh:22176 rh:22200 rh:22220 rh:22228 rh:22232 rh:22252 rh:22256 rh:22272 rh:22288 rh:22296 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated