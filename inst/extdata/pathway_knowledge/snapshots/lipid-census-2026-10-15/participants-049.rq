PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:81943 rh:81951 rh:81959 rh:81963 rh:81975 rh:81999 rh:82011 rh:82055 rh:82111 rh:82271 rh:82347 rh:82351 rh:82411 rh:82419 rh:82435 rh:82447 rh:82471 rh:82475 rh:82483 rh:82487 rh:82491 rh:82495 rh:82499 rh:82503 rh:82563 rh:82567 rh:82587 rh:82723 rh:82727 rh:82735 rh:82739 rh:82747 rh:82751 rh:82755 rh:82759 rh:82763 rh:82767 rh:82771 rh:82847 rh:82875 rh:83043 rh:83111 rh:83131 rh:83163 rh:83167 rh:83179 rh:83255 rh:83287 rh:83295 rh:83299 rh:83471 rh:83523 rh:83527 rh:83663 rh:83759 rh:83787 rh:83855 rh:83903 rh:83907 rh:83919 rh:83923 rh:83987 rh:84067 rh:84071 rh:84075 rh:84079 rh:84083 rh:84099 rh:84103 rh:84143 rh:84155 rh:84159 rh:84163 rh:84175 rh:84179 rh:84183 rh:84187 rh:84191 rh:84195 rh:84199 rh:84203 rh:84239 rh:84243 rh:84247 rh:84251 rh:84255 rh:84259 rh:84263 rh:84267 rh:84271 rh:84767 rh:84847 rh:84879 rh:84883 rh:84923 rh:84927 rh:84935 rh:84939 rh:84943 rh:84947 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated