PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:54520 rh:54524 rh:54536 rh:54544 rh:54552 rh:54596 rh:54600 rh:54604 rh:54612 rh:54616 rh:54620 rh:54624 rh:54628 rh:54632 rh:54636 rh:54640 rh:54648 rh:54652 rh:54656 rh:54664 rh:54668 rh:54672 rh:54676 rh:54684 rh:54692 rh:54740 rh:54744 rh:54808 rh:54812 rh:54844 rh:54852 rh:54856 rh:54860 rh:54872 rh:54876 rh:54880 rh:54888 rh:54896 rh:54908 rh:54912 rh:54916 rh:54920 rh:54952 rh:54956 rh:54960 rh:54968 rh:54972 rh:54976 rh:54980 rh:55004 rh:55008 rh:55012 rh:55016 rh:55044 rh:55048 rh:55052 rh:55064 rh:55072 rh:55084 rh:55088 rh:55096 rh:55164 rh:55172 rh:55176 rh:55180 rh:55184 rh:55192 rh:55196 rh:55208 rh:55212 rh:55216 rh:55220 rh:55224 rh:55228 rh:55232 rh:55236 rh:55240 rh:55244 rh:55248 rh:55252 rh:55256 rh:55260 rh:55264 rh:55272 rh:55276 rh:55280 rh:55284 rh:55288 rh:55296 rh:55300 rh:55304 rh:55308 rh:55312 rh:55320 rh:55324 rh:55328 rh:55340 rh:55344 rh:55348 rh:55352 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated