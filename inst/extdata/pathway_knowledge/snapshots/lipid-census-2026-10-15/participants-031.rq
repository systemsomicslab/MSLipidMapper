PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:54484 rh:54488 rh:54492 rh:54496 rh:54500 rh:54504 rh:54508 rh:54512 rh:54516 rh:54520 rh:54524 rh:54536 rh:54544 rh:54552 rh:54636 rh:54640 rh:54656 rh:54664 rh:54668 rh:54672 rh:54740 rh:54744 rh:54812 rh:54844 rh:54852 rh:54856 rh:54860 rh:54872 rh:54876 rh:54880 rh:54888 rh:54896 rh:54912 rh:54916 rh:54920 rh:54952 rh:54956 rh:54960 rh:54976 rh:55004 rh:55008 rh:55012 rh:55016 rh:55044 rh:55048 rh:55052 rh:55064 rh:55072 rh:55084 rh:55088 rh:55096 rh:55216 rh:55220 rh:55224 rh:55228 rh:55232 rh:55236 rh:55240 rh:55244 rh:55248 rh:55252 rh:55256 rh:55264 rh:55272 rh:55276 rh:55280 rh:55284 rh:55288 rh:55296 rh:55300 rh:55308 rh:55312 rh:55320 rh:55324 rh:55328 rh:55340 rh:55344 rh:55348 rh:55352 rh:55356 rh:55360 rh:55372 rh:55424 rh:55428 rh:55432 rh:55436 rh:55440 rh:55452 rh:55456 rh:55460 rh:55464 rh:55468 rh:55472 rh:55476 rh:55480 rh:55484 rh:55488 rh:55492 rh:55496 rh:55500 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated