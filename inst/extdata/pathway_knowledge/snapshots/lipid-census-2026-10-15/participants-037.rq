PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:63080 rh:63120 rh:63124 rh:63128 rh:63140 rh:63144 rh:63148 rh:63152 rh:63156 rh:63160 rh:63164 rh:63204 rh:63224 rh:63264 rh:63284 rh:63288 rh:63304 rh:63308 rh:63312 rh:63316 rh:63320 rh:63324 rh:63328 rh:63376 rh:63380 rh:63384 rh:63432 rh:63436 rh:63456 rh:63460 rh:63464 rh:63468 rh:63472 rh:63476 rh:63480 rh:63508 rh:63576 rh:63580 rh:63584 rh:63592 rh:63596 rh:63620 rh:63628 rh:63648 rh:63652 rh:63656 rh:63708 rh:63712 rh:63760 rh:63764 rh:63772 rh:63776 rh:63780 rh:63784 rh:63788 rh:63832 rh:63836 rh:63852 rh:63856 rh:63860 rh:63864 rh:63868 rh:63888 rh:63920 rh:63928 rh:63940 rh:63944 rh:63948 rh:63952 rh:63956 rh:63996 rh:64000 rh:64008 rh:64044 rh:64048 rh:64052 rh:64108 rh:64112 rh:64116 rh:64120 rh:64124 rh:64128 rh:64132 rh:64136 rh:64140 rh:64144 rh:64156 rh:64176 rh:64180 rh:64184 rh:64188 rh:64192 rh:64196 rh:64200 rh:64208 rh:64212 rh:64220 rh:64308 rh:64320 rh:64324 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated