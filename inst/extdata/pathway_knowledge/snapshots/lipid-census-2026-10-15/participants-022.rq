PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:45392 rh:45396 rh:45400 rh:45404 rh:45412 rh:45416 rh:45420 rh:45424 rh:45428 rh:45432 rh:45436 rh:45440 rh:45444 rh:45448 rh:45452 rh:45456 rh:45460 rh:45468 rh:45472 rh:45476 rh:45528 rh:45532 rh:45536 rh:45540 rh:45544 rh:45552 rh:45556 rh:45576 rh:45588 rh:45592 rh:45596 rh:45608 rh:45612 rh:45616 rh:45620 rh:45644 rh:45720 rh:45780 rh:45788 rh:45820 rh:45892 rh:45896 rh:45960 rh:45968 rh:45988 rh:46016 rh:46024 rh:46028 rh:46032 rh:46092 rh:46100 rh:46104 rh:46108 rh:46120 rh:46124 rh:46128 rh:46132 rh:46140 rh:46144 rh:46152 rh:46156 rh:46168 rh:46172 rh:46176 rh:46180 rh:46184 rh:46192 rh:46196 rh:46200 rh:46204 rh:46208 rh:46216 rh:46220 rh:46236 rh:46240 rh:46252 rh:46256 rh:46260 rh:46264 rh:46268 rh:46272 rh:46280 rh:46284 rh:46288 rh:46296 rh:46300 rh:46304 rh:46308 rh:46332 rh:46340 rh:46356 rh:46360 rh:46364 rh:46368 rh:46372 rh:46376 rh:46380 rh:46384 rh:46388 rh:46392 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated