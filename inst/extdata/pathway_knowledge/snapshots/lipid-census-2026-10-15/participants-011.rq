PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:34463 rh:34467 rh:34475 rh:34479 rh:34495 rh:34503 rh:34535 rh:34571 rh:34599 rh:34603 rh:34607 rh:34611 rh:34627 rh:34631 rh:34643 rh:34647 rh:34651 rh:34655 rh:34659 rh:34663 rh:34667 rh:34671 rh:34695 rh:34699 rh:34703 rh:34711 rh:34715 rh:34723 rh:34727 rh:34731 rh:34735 rh:34739 rh:34747 rh:34751 rh:34755 rh:34771 rh:34775 rh:34779 rh:34783 rh:34787 rh:34831 rh:34835 rh:35263 rh:35455 rh:35459 rh:35463 rh:35467 rh:35483 rh:35499 rh:35503 rh:35507 rh:35511 rh:35519 rh:35563 rh:35567 rh:35651 rh:35663 rh:35667 rh:35683 rh:35687 rh:35739 rh:35747 rh:35847 rh:35983 rh:35987 rh:35991 rh:35995 rh:35999 rh:36003 rh:36043 rh:36063 rh:36071 rh:36079 rh:36083 rh:36087 rh:36107 rh:36111 rh:36115 rh:36119 rh:36123 rh:36127 rh:36135 rh:36139 rh:36171 rh:36179 rh:36183 rh:36187 rh:36191 rh:36195 rh:36199 rh:36203 rh:36207 rh:36211 rh:36215 rh:36219 rh:36223 rh:36227 rh:36231 rh:36235 rh:36239 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated