PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:84951 rh:84955 rh:84959 rh:84963 rh:84967 rh:85135 rh:85163 rh:85167 rh:85251 rh:85283 rh:85303 rh:85307 rh:85491 rh:85523 rh:85531 rh:85535 rh:85539 rh:85543 rh:85551 rh:85555 rh:85559 rh:85563 rh:85591 rh:85599 rh:85607 rh:85615 rh:85619 rh:85623 rh:85627 rh:85631 rh:85635 rh:85639 rh:85651 rh:85691 rh:85707 rh:85711 rh:85715 rh:85767 rh:85771 rh:85775 rh:85935 rh:85943 rh:85951 rh:85959 rh:85967 rh:85971 rh:85975 rh:85979 rh:85987 rh:85991 rh:85995 rh:85999 rh:86003 rh:86007 rh:86011 rh:86015 rh:86019 rh:86055 rh:86067 rh:86071 rh:86079 rh:86083 rh:86087 rh:86091 rh:86095 rh:86103 rh:86111 rh:86115 rh:86119 rh:86127 rh:86135 rh:86139 rh:86159 rh:86163 rh:86247 rh:86259 rh:86263 rh:86299 rh:86303 rh:86327 rh:86371 rh:86375 rh:86379 rh:86383 rh:86395 rh:86411 rh:86415 rh:86439 rh:86451 rh:86455 rh:86471 rh:86475 rh:86479 rh:86483 rh:86675 rh:86711 rh:86771 rh:86775 rh:86839 rh:86847 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated