PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:20381 rh:20521 rh:20529 rh:20565 rh:20573 rh:20585 rh:20589 rh:20613 rh:20649 rh:20653 rh:20669 rh:20673 rh:20712 rh:20744 rh:20856 rh:20860 rh:20872 rh:20880 rh:20912 rh:20936 rh:20972 rh:20984 rh:21044 rh:21104 rh:21112 rh:21128 rh:21136 rh:21204 rh:21224 rh:21284 rh:21300 rh:21304 rh:21308 rh:21316 rh:21352 rh:21380 rh:21420 rh:21496 rh:21508 rh:21516 rh:21524 rh:21536 rh:21552 rh:21628 rh:21680 rh:21752 rh:21756 rh:21792 rh:21800 rh:21812 rh:21852 rh:21888 rh:21952 rh:21996 rh:22028 rh:22056 rh:22064 rh:22108 rh:22128 rh:22164 rh:22220 rh:22228 rh:22232 rh:22252 rh:22272 rh:22288 rh:22316 rh:22400 rh:22436 rh:22520 rh:22524 rh:22544 rh:22580 rh:22592 rh:22640 rh:22660 rh:22696 rh:22716 rh:22724 rh:22756 rh:22780 rh:22800 rh:22804 rh:22912 rh:22944 rh:22952 rh:22956 rh:23004 rh:23012 rh:23040 rh:23048 rh:23084 rh:23128 rh:23148 rh:23260 rh:23264 rh:23276 rh:23328 rh:23432 rh:23456 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated