PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:63764 rh:63772 rh:63776 rh:63780 rh:63784 rh:63788 rh:63832 rh:63836 rh:63852 rh:63856 rh:63860 rh:63864 rh:63868 rh:63888 rh:63920 rh:63928 rh:63932 rh:63940 rh:63944 rh:63948 rh:63952 rh:63956 rh:63960 rh:63964 rh:63996 rh:64000 rh:64008 rh:64044 rh:64048 rh:64052 rh:64108 rh:64112 rh:64116 rh:64120 rh:64124 rh:64128 rh:64132 rh:64136 rh:64140 rh:64144 rh:64156 rh:64176 rh:64180 rh:64184 rh:64188 rh:64192 rh:64196 rh:64200 rh:64204 rh:64208 rh:64212 rh:64220 rh:64228 rh:64240 rh:64244 rh:64248 rh:64252 rh:64256 rh:64260 rh:64308 rh:64320 rh:64324 rh:64328 rh:64340 rh:64352 rh:64364 rh:64368 rh:64376 rh:64380 rh:64388 rh:64504 rh:64532 rh:64536 rh:64540 rh:64572 rh:64580 rh:64592 rh:64596 rh:64600 rh:64624 rh:64628 rh:64632 rh:64636 rh:64644 rh:64652 rh:64656 rh:64660 rh:64668 rh:64672 rh:64676 rh:64708 rh:64712 rh:64724 rh:64728 rh:64732 rh:64844 rh:64852 rh:64856 rh:64860 rh:64888 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated