PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:49384 rh:49392 rh:49396 rh:49440 rh:49452 rh:49468 rh:49484 rh:49596 rh:49600 rh:49616 rh:49796 rh:49808 rh:49832 rh:49836 rh:49856 rh:49860 rh:49876 rh:49880 rh:49884 rh:49908 rh:49912 rh:49916 rh:49920 rh:49928 rh:49936 rh:49968 rh:49972 rh:49984 rh:49988 rh:49992 rh:49996 rh:50000 rh:50076 rh:50088 rh:50096 rh:50124 rh:50128 rh:50132 rh:50136 rh:50140 rh:50144 rh:50148 rh:50152 rh:50164 rh:50196 rh:50200 rh:50204 rh:50208 rh:50212 rh:50216 rh:50236 rh:50244 rh:50256 rh:50260 rh:50264 rh:50268 rh:50272 rh:50276 rh:50280 rh:50284 rh:50288 rh:50292 rh:50296 rh:50300 rh:50304 rh:50308 rh:50312 rh:50316 rh:50320 rh:50324 rh:50328 rh:50332 rh:50336 rh:50340 rh:50376 rh:50424 rh:50432 rh:50436 rh:50440 rh:50444 rh:50448 rh:50452 rh:50456 rh:50460 rh:50536 rh:50540 rh:50544 rh:50548 rh:50552 rh:50556 rh:50584 rh:50588 rh:50592 rh:50696 rh:50700 rh:50704 rh:50708 rh:50792 rh:50796 rh:50800 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated