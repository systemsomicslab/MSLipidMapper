PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:46400 rh:46404 rh:46408 rh:46412 rh:46428 rh:46432 rh:46436 rh:46440 rh:46456 rh:46460 rh:46464 rh:46468 rh:46472 rh:46476 rh:46480 rh:46488 rh:46496 rh:46512 rh:46520 rh:46532 rh:46536 rh:46540 rh:46544 rh:46548 rh:46552 rh:46556 rh:46560 rh:46576 rh:46580 rh:46584 rh:46588 rh:46592 rh:46612 rh:46616 rh:46620 rh:46628 rh:46632 rh:46636 rh:46640 rh:46644 rh:46648 rh:46652 rh:46656 rh:46660 rh:46664 rh:46668 rh:46672 rh:46700 rh:46736 rh:46740 rh:46752 rh:46756 rh:46764 rh:46768 rh:46772 rh:46776 rh:46780 rh:46784 rh:46788 rh:46792 rh:46796 rh:46804 rh:46812 rh:46816 rh:46820 rh:46824 rh:46828 rh:46832 rh:46836 rh:46840 rh:46844 rh:46848 rh:46852 rh:46856 rh:46864 rh:46868 rh:46872 rh:46896 rh:46900 rh:46904 rh:46908 rh:46912 rh:46916 rh:46928 rh:46968 rh:46972 rh:47044 rh:47052 rh:47056 rh:47060 rh:47064 rh:47068 rh:47072 rh:47076 rh:47080 rh:47116 rh:47120 rh:47124 rh:47132 rh:47156 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated