PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:61772 rh:61776 rh:61812 rh:61816 rh:61820 rh:61824 rh:61828 rh:61832 rh:61836 rh:61840 rh:61848 rh:61852 rh:61868 rh:61872 rh:61876 rh:61880 rh:61884 rh:61888 rh:61940 rh:61944 rh:61956 rh:61960 rh:61964 rh:61968 rh:61972 rh:62020 rh:62024 rh:62028 rh:62032 rh:62036 rh:62040 rh:62044 rh:62048 rh:62052 rh:62096 rh:62100 rh:62160 rh:62180 rh:62184 rh:62188 rh:62192 rh:62196 rh:62204 rh:62268 rh:62404 rh:62420 rh:62464 rh:62472 rh:62480 rh:62484 rh:62488 rh:62508 rh:62516 rh:62532 rh:62536 rh:62540 rh:62544 rh:62548 rh:62552 rh:62560 rh:62564 rh:62592 rh:62596 rh:62600 rh:62604 rh:62616 rh:62644 rh:62648 rh:62700 rh:62744 rh:62748 rh:62752 rh:62756 rh:62760 rh:62764 rh:62768 rh:62776 rh:62780 rh:62820 rh:62920 rh:62960 rh:62976 rh:62980 rh:62984 rh:62988 rh:62992 rh:62996 rh:63000 rh:63004 rh:63008 rh:63012 rh:63016 rh:63020 rh:63024 rh:63028 rh:63032 rh:63036 rh:63040 rh:63048 rh:63052 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated