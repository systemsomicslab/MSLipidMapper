PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:52392 rh:52428 rh:52436 rh:52440 rh:52444 rh:52448 rh:52452 rh:52456 rh:52460 rh:52464 rh:52468 rh:52472 rh:52476 rh:52488 rh:52492 rh:52496 rh:52500 rh:52504 rh:52508 rh:52520 rh:52524 rh:52544 rh:52548 rh:52568 rh:52572 rh:52576 rh:52600 rh:52608 rh:52620 rh:52628 rh:52640 rh:52652 rh:52656 rh:52664 rh:52696 rh:52716 rh:52800 rh:52804 rh:52812 rh:52824 rh:52828 rh:52832 rh:52860 rh:52868 rh:52872 rh:52876 rh:52880 rh:52916 rh:52920 rh:52924 rh:52940 rh:52944 rh:52948 rh:52952 rh:52956 rh:52960 rh:52964 rh:52968 rh:53000 rh:53004 rh:53008 rh:53028 rh:53032 rh:53036 rh:53040 rh:53048 rh:53052 rh:53060 rh:53064 rh:53068 rh:53072 rh:53080 rh:53088 rh:53092 rh:53096 rh:53100 rh:53104 rh:53108 rh:53112 rh:53116 rh:53120 rh:53124 rh:53128 rh:53132 rh:53136 rh:53140 rh:53144 rh:53148 rh:53152 rh:53156 rh:53160 rh:53164 rh:53168 rh:53172 rh:53176 rh:53184 rh:53188 rh:53192 rh:53196 rh:53200 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated