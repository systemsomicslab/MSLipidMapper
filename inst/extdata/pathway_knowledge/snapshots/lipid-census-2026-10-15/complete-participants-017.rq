PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:35363 rh:35367 rh:35371 rh:35375 rh:35379 rh:35391 rh:35411 rh:35439 rh:35455 rh:35459 rh:35463 rh:35467 rh:35483 rh:35499 rh:35503 rh:35507 rh:35511 rh:35519 rh:35563 rh:35567 rh:35651 rh:35659 rh:35663 rh:35667 rh:35675 rh:35679 rh:35683 rh:35687 rh:35723 rh:35727 rh:35731 rh:35739 rh:35747 rh:35779 rh:35839 rh:35843 rh:35847 rh:35851 rh:35855 rh:35859 rh:35863 rh:35867 rh:35871 rh:35875 rh:35879 rh:35883 rh:35887 rh:35891 rh:35895 rh:35899 rh:35903 rh:35907 rh:35911 rh:35915 rh:35939 rh:35943 rh:35971 rh:35979 rh:35983 rh:35987 rh:35991 rh:35995 rh:35999 rh:36003 rh:36007 rh:36011 rh:36015 rh:36019 rh:36023 rh:36027 rh:36035 rh:36039 rh:36043 rh:36063 rh:36071 rh:36079 rh:36083 rh:36087 rh:36107 rh:36111 rh:36115 rh:36119 rh:36123 rh:36127 rh:36135 rh:36139 rh:36143 rh:36159 rh:36171 rh:36175 rh:36179 rh:36183 rh:36187 rh:36191 rh:36195 rh:36199 rh:36203 rh:36207 rh:36211 rh:36215 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated