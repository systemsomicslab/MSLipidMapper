PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:81747 rh:81751 rh:81755 rh:81759 rh:81763 rh:81767 rh:81771 rh:81775 rh:81779 rh:81783 rh:81791 rh:81795 rh:81803 rh:81807 rh:81811 rh:81815 rh:81819 rh:81823 rh:81851 rh:81855 rh:81859 rh:81863 rh:81879 rh:81887 rh:81895 rh:81899 rh:81903 rh:81915 rh:81919 rh:81923 rh:81927 rh:81931 rh:81935 rh:81939 rh:81943 rh:81951 rh:81959 rh:81963 rh:81975 rh:81999 rh:82011 rh:82047 rh:82055 rh:82111 rh:82271 rh:82291 rh:82295 rh:82331 rh:82347 rh:82351 rh:82411 rh:82419 rh:82435 rh:82447 rh:82471 rh:82475 rh:82483 rh:82487 rh:82491 rh:82495 rh:82499 rh:82503 rh:82563 rh:82567 rh:82587 rh:82615 rh:82675 rh:82695 rh:82723 rh:82727 rh:82735 rh:82739 rh:82747 rh:82751 rh:82755 rh:82759 rh:82763 rh:82767 rh:82771 rh:82847 rh:82875 rh:83043 rh:83051 rh:83059 rh:83111 rh:83119 rh:83131 rh:83163 rh:83167 rh:83179 rh:83255 rh:83287 rh:83295 rh:83299 rh:83471 rh:83523 rh:83527 rh:83663 rh:83759 rh:83787 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated