PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
PREFIX o: <http://www.geneontology.org/formats/oboInOwl#>
SELECT DISTINCT ?chebi ?xref WHERE { GRAPH <http://sparql.rhea-db.org/chebi> {
 ?chebi o:hasDbXref ?xref . FILTER(STRSTARTS(LCASE(STR(?xref)), "lipidmaps:"))
 }} ORDER BY ?chebi ?xref