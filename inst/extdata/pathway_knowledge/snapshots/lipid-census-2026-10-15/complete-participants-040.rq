PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:50084 rh:50088 rh:50092 rh:50096 rh:50100 rh:50104 rh:50108 rh:50112 rh:50116 rh:50120 rh:50124 rh:50128 rh:50132 rh:50136 rh:50140 rh:50144 rh:50148 rh:50152 rh:50164 rh:50168 rh:50172 rh:50176 rh:50180 rh:50184 rh:50188 rh:50196 rh:50200 rh:50204 rh:50208 rh:50212 rh:50216 rh:50236 rh:50244 rh:50256 rh:50260 rh:50264 rh:50268 rh:50272 rh:50276 rh:50280 rh:50284 rh:50288 rh:50292 rh:50296 rh:50300 rh:50304 rh:50308 rh:50312 rh:50316 rh:50320 rh:50324 rh:50328 rh:50332 rh:50336 rh:50340 rh:50344 rh:50348 rh:50372 rh:50376 rh:50396 rh:50400 rh:50424 rh:50432 rh:50436 rh:50440 rh:50444 rh:50448 rh:50452 rh:50456 rh:50460 rh:50536 rh:50540 rh:50544 rh:50548 rh:50552 rh:50556 rh:50584 rh:50588 rh:50592 rh:50608 rh:50620 rh:50696 rh:50700 rh:50704 rh:50708 rh:50740 rh:50792 rh:50796 rh:50800 rh:50804 rh:50808 rh:50812 rh:50816 rh:50820 rh:50824 rh:50828 rh:50832 rh:50836 rh:50840 rh:50844 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated