PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?neutral ?charged WHERE { GRAPH <http://sparql.rhea-db.org/chebi> {
 ?neutral rdfs:subClassOf* ch:18059 ; rdfs:subClassOf ?restriction .
 ?restriction a owl:Restriction ; owl:onProperty chebihash:has_major_microspecies_at_pH_7_3 ; owl:someValuesFrom ?charged
 }} ORDER BY ?neutral ?charged