PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:36255 rh:36259 rh:36303 rh:36315 rh:36319 rh:36323 rh:36363 rh:36371 rh:36379 rh:36391 rh:36395 rh:36399 rh:36403 rh:36411 rh:36479 rh:36491 rh:36535 rh:36539 rh:36547 rh:36555 rh:36571 rh:36575 rh:36615 rh:36619 rh:36627 rh:36647 rh:36667 rh:36671 rh:36675 rh:36687 rh:36691 rh:36715 rh:36719 rh:36739 rh:36743 rh:36767 rh:36827 rh:36943 rh:37035 rh:37111 rh:37115 rh:37123 rh:37167 rh:37207 rh:37219 rh:37227 rh:37259 rh:37383 rh:37387 rh:37391 rh:37395 rh:37475 rh:37479 rh:37483 rh:37487 rh:37511 rh:37515 rh:37519 rh:37527 rh:37559 rh:37563 rh:37627 rh:37631 rh:37635 rh:37655 rh:37699 rh:37703 rh:37707 rh:37711 rh:37715 rh:37719 rh:37723 rh:37747 rh:37755 rh:37759 rh:37763 rh:37775 rh:37783 rh:37787 rh:37803 rh:37811 rh:37819 rh:37839 rh:37843 rh:37855 rh:37859 rh:37863 rh:37867 rh:37895 rh:37907 rh:37911 rh:37915 rh:37919 rh:37923 rh:37927 rh:37931 rh:37935 rh:37939 rh:37943 rh:37947 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated