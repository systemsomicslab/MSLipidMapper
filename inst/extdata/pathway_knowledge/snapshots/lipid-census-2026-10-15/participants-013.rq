PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:37951 rh:37955 rh:37959 rh:38011 rh:38019 rh:38039 rh:38047 rh:38051 rh:38055 rh:38059 rh:38063 rh:38067 rh:38071 rh:38075 rh:38079 rh:38083 rh:38087 rh:38115 rh:38119 rh:38123 rh:38127 rh:38131 rh:38135 rh:38139 rh:38155 rh:38163 rh:38167 rh:38171 rh:38175 rh:38179 rh:38183 rh:38187 rh:38191 rh:38195 rh:38199 rh:38203 rh:38207 rh:38211 rh:38219 rh:38223 rh:38227 rh:38231 rh:38235 rh:38239 rh:38243 rh:38247 rh:38251 rh:38255 rh:38263 rh:38267 rh:38271 rh:38291 rh:38299 rh:38307 rh:38323 rh:38327 rh:38331 rh:38335 rh:38339 rh:38343 rh:38363 rh:38375 rh:38379 rh:38383 rh:38387 rh:38391 rh:38395 rh:38399 rh:38403 rh:38407 rh:38411 rh:38415 rh:38419 rh:38423 rh:38427 rh:38431 rh:38435 rh:38439 rh:38443 rh:38455 rh:38459 rh:38463 rh:38467 rh:38483 rh:38487 rh:38491 rh:38495 rh:38499 rh:38503 rh:38507 rh:38511 rh:38515 rh:38519 rh:38523 rh:38527 rh:38551 rh:38555 rh:38559 rh:38563 rh:38571 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated