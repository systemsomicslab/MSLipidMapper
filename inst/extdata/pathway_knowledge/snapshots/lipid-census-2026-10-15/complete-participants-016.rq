PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:34399 rh:34403 rh:34411 rh:34415 rh:34455 rh:34459 rh:34463 rh:34467 rh:34471 rh:34475 rh:34479 rh:34483 rh:34487 rh:34495 rh:34499 rh:34503 rh:34511 rh:34515 rh:34519 rh:34523 rh:34535 rh:34543 rh:34559 rh:34571 rh:34575 rh:34579 rh:34583 rh:34587 rh:34595 rh:34599 rh:34603 rh:34607 rh:34611 rh:34619 rh:34627 rh:34631 rh:34635 rh:34639 rh:34643 rh:34647 rh:34651 rh:34655 rh:34659 rh:34663 rh:34667 rh:34671 rh:34691 rh:34695 rh:34699 rh:34703 rh:34711 rh:34715 rh:34719 rh:34723 rh:34727 rh:34731 rh:34735 rh:34739 rh:34743 rh:34747 rh:34751 rh:34755 rh:34771 rh:34775 rh:34779 rh:34783 rh:34787 rh:34799 rh:34803 rh:34831 rh:34835 rh:34851 rh:34951 rh:35099 rh:35103 rh:35115 rh:35119 rh:35139 rh:35247 rh:35251 rh:35255 rh:35259 rh:35263 rh:35271 rh:35275 rh:35279 rh:35291 rh:35299 rh:35303 rh:35311 rh:35315 rh:35319 rh:35327 rh:35335 rh:35339 rh:35343 rh:35347 rh:35351 rh:35355 rh:35359 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated