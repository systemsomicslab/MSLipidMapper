PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:76555 rh:76559 rh:76563 rh:76599 rh:76603 rh:76607 rh:76623 rh:76627 rh:76647 rh:76651 rh:76655 rh:76659 rh:76663 rh:76675 rh:76687 rh:76691 rh:76695 rh:76699 rh:76703 rh:76707 rh:76711 rh:76715 rh:76719 rh:76723 rh:76727 rh:76731 rh:76735 rh:76739 rh:76743 rh:76747 rh:76751 rh:76755 rh:76759 rh:76763 rh:76771 rh:76775 rh:76779 rh:76783 rh:76787 rh:76791 rh:76967 rh:76971 rh:76975 rh:76979 rh:76983 rh:76987 rh:77071 rh:77075 rh:77103 rh:77107 rh:77195 rh:77199 rh:77203 rh:77207 rh:77211 rh:77219 rh:77243 rh:77255 rh:77259 rh:77263 rh:77267 rh:77271 rh:77275 rh:77279 rh:77283 rh:77287 rh:77291 rh:77295 rh:77339 rh:77351 rh:77355 rh:77359 rh:77363 rh:77375 rh:77379 rh:77383 rh:77435 rh:77439 rh:77443 rh:77539 rh:77543 rh:77547 rh:77551 rh:77555 rh:77559 rh:77563 rh:77567 rh:77571 rh:77575 rh:77579 rh:77583 rh:77587 rh:77591 rh:77595 rh:77599 rh:77603 rh:77607 rh:77611 rh:77615 rh:77619 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated