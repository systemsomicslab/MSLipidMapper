PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:48952 rh:49048 rh:49060 rh:49064 rh:49068 rh:49088 rh:49092 rh:49160 rh:49192 rh:49196 rh:49204 rh:49208 rh:49212 rh:49228 rh:49244 rh:49268 rh:49272 rh:49276 rh:49288 rh:49304 rh:49308 rh:49312 rh:49316 rh:49320 rh:49324 rh:49328 rh:49332 rh:49336 rh:49340 rh:49344 rh:49348 rh:49352 rh:49356 rh:49360 rh:49376 rh:49380 rh:49384 rh:49392 rh:49396 rh:49432 rh:49436 rh:49440 rh:49452 rh:49460 rh:49468 rh:49476 rh:49480 rh:49484 rh:49592 rh:49596 rh:49600 rh:49612 rh:49616 rh:49632 rh:49772 rh:49780 rh:49784 rh:49788 rh:49792 rh:49796 rh:49808 rh:49828 rh:49832 rh:49836 rh:49852 rh:49856 rh:49860 rh:49876 rh:49880 rh:49884 rh:49908 rh:49912 rh:49916 rh:49920 rh:49928 rh:49932 rh:49936 rh:49968 rh:49972 rh:49976 rh:49980 rh:49984 rh:49988 rh:49992 rh:49996 rh:50000 rh:50016 rh:50020 rh:50024 rh:50028 rh:50032 rh:50048 rh:50052 rh:50056 rh:50060 rh:50064 rh:50068 rh:50072 rh:50076 rh:50080 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated