PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:53204 rh:53212 rh:53216 rh:53220 rh:53224 rh:53228 rh:53232 rh:53236 rh:53240 rh:53244 rh:53248 rh:53252 rh:53256 rh:53260 rh:53264 rh:53276 rh:53296 rh:53308 rh:53312 rh:53316 rh:53320 rh:53324 rh:53332 rh:53388 rh:53396 rh:53400 rh:53404 rh:53408 rh:53412 rh:53424 rh:53436 rh:53440 rh:53444 rh:53448 rh:53452 rh:53456 rh:53460 rh:53464 rh:53468 rh:53472 rh:53476 rh:53480 rh:53484 rh:53488 rh:53496 rh:53500 rh:53508 rh:53512 rh:53516 rh:53520 rh:53524 rh:53528 rh:53532 rh:53536 rh:53540 rh:53548 rh:53552 rh:53556 rh:53560 rh:53564 rh:53568 rh:53572 rh:53576 rh:53580 rh:53584 rh:53588 rh:53592 rh:53596 rh:53600 rh:53604 rh:53608 rh:53616 rh:53620 rh:53624 rh:53628 rh:53632 rh:53636 rh:53640 rh:53644 rh:53648 rh:53652 rh:53656 rh:53660 rh:53664 rh:53668 rh:53676 rh:53680 rh:53684 rh:53688 rh:53692 rh:53696 rh:53700 rh:53704 rh:53708 rh:53748 rh:53752 rh:53756 rh:53760 rh:53764 rh:53768 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated