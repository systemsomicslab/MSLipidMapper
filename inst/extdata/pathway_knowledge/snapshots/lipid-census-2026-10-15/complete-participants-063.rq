PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:74319 rh:74323 rh:74327 rh:74331 rh:74335 rh:74339 rh:74343 rh:74351 rh:74379 rh:74383 rh:74395 rh:74399 rh:74403 rh:74407 rh:74411 rh:74419 rh:74423 rh:74427 rh:74431 rh:74435 rh:74443 rh:74447 rh:74451 rh:74455 rh:74459 rh:74467 rh:74519 rh:74531 rh:74535 rh:74543 rh:74547 rh:74559 rh:74563 rh:74587 rh:74591 rh:74595 rh:74631 rh:74635 rh:74675 rh:74683 rh:74687 rh:74691 rh:74695 rh:74699 rh:74703 rh:74707 rh:74711 rh:74751 rh:74799 rh:74803 rh:74807 rh:74811 rh:74815 rh:74823 rh:74843 rh:74899 rh:74903 rh:74923 rh:74931 rh:74935 rh:74939 rh:74943 rh:74947 rh:74951 rh:74955 rh:74959 rh:74967 rh:74979 rh:75011 rh:75015 rh:75019 rh:75023 rh:75027 rh:75031 rh:75035 rh:75051 rh:75079 rh:75083 rh:75087 rh:75103 rh:75107 rh:75111 rh:75115 rh:75119 rh:75147 rh:75151 rh:75155 rh:75179 rh:75183 rh:75275 rh:75279 rh:75283 rh:75427 rh:75431 rh:75435 rh:75439 rh:75447 rh:75451 rh:75455 rh:75459 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated