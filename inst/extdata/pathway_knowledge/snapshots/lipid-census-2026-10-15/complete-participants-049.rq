PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:57992 rh:57996 rh:58000 rh:58004 rh:58008 rh:58016 rh:58020 rh:58024 rh:58028 rh:58032 rh:58036 rh:58040 rh:58044 rh:58048 rh:58076 rh:58080 rh:58084 rh:58088 rh:58092 rh:58096 rh:58100 rh:58104 rh:58160 rh:58164 rh:58168 rh:58172 rh:58176 rh:58180 rh:58184 rh:58188 rh:58192 rh:58200 rh:58264 rh:58296 rh:58312 rh:58316 rh:58324 rh:58328 rh:58332 rh:58336 rh:58340 rh:58344 rh:58364 rh:58368 rh:58372 rh:58376 rh:58380 rh:58384 rh:58388 rh:58400 rh:58404 rh:58408 rh:58416 rh:58420 rh:58428 rh:58432 rh:58460 rh:58464 rh:58476 rh:58484 rh:58512 rh:58536 rh:58540 rh:58544 rh:58548 rh:58592 rh:58600 rh:58608 rh:58612 rh:58616 rh:58620 rh:58624 rh:58632 rh:58636 rh:58644 rh:58664 rh:58752 rh:58760 rh:58764 rh:58768 rh:58772 rh:58828 rh:58832 rh:58836 rh:58840 rh:58844 rh:58848 rh:58852 rh:58856 rh:58860 rh:58864 rh:58868 rh:58872 rh:58876 rh:58880 rh:58896 rh:58916 rh:58936 rh:58940 rh:58952 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated