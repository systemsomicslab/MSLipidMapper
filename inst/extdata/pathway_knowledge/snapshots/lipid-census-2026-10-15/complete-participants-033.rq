PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:45260 rh:45264 rh:45268 rh:45272 rh:45276 rh:45280 rh:45284 rh:45288 rh:45292 rh:45296 rh:45300 rh:45304 rh:45312 rh:45316 rh:45320 rh:45324 rh:45336 rh:45340 rh:45344 rh:45348 rh:45352 rh:45356 rh:45360 rh:45364 rh:45368 rh:45372 rh:45376 rh:45380 rh:45384 rh:45388 rh:45392 rh:45396 rh:45400 rh:45404 rh:45408 rh:45412 rh:45416 rh:45420 rh:45424 rh:45428 rh:45432 rh:45436 rh:45440 rh:45444 rh:45448 rh:45452 rh:45456 rh:45460 rh:45464 rh:45468 rh:45472 rh:45476 rh:45528 rh:45532 rh:45536 rh:45540 rh:45544 rh:45552 rh:45556 rh:45576 rh:45584 rh:45588 rh:45592 rh:45596 rh:45608 rh:45612 rh:45616 rh:45620 rh:45632 rh:45636 rh:45640 rh:45644 rh:45648 rh:45652 rh:45656 rh:45660 rh:45664 rh:45668 rh:45672 rh:45676 rh:45680 rh:45684 rh:45688 rh:45692 rh:45696 rh:45720 rh:45736 rh:45748 rh:45752 rh:45780 rh:45788 rh:45796 rh:45812 rh:45820 rh:45828 rh:45832 rh:45836 rh:45840 rh:45844 rh:45848 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated