PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:48308 rh:48316 rh:48320 rh:48324 rh:48328 rh:48332 rh:48336 rh:48340 rh:48344 rh:48352 rh:48356 rh:48360 rh:48364 rh:48368 rh:48372 rh:48376 rh:48380 rh:48384 rh:48388 rh:48392 rh:48412 rh:48416 rh:48420 rh:48428 rh:48436 rh:48440 rh:48444 rh:48448 rh:48452 rh:48456 rh:48460 rh:48464 rh:48468 rh:48472 rh:48476 rh:48480 rh:48484 rh:48488 rh:48492 rh:48496 rh:48500 rh:48508 rh:48516 rh:48524 rh:48528 rh:48532 rh:48536 rh:48540 rh:48552 rh:48584 rh:48588 rh:48596 rh:48608 rh:48616 rh:48620 rh:48624 rh:48632 rh:48636 rh:48640 rh:48644 rh:48648 rh:48652 rh:48656 rh:48660 rh:48664 rh:48668 rh:48672 rh:48676 rh:48680 rh:48692 rh:48696 rh:48700 rh:48704 rh:48708 rh:48716 rh:48736 rh:48776 rh:48792 rh:48796 rh:48800 rh:48804 rh:48808 rh:48812 rh:48816 rh:48820 rh:48824 rh:48832 rh:48836 rh:48840 rh:48844 rh:48848 rh:48852 rh:48856 rh:48860 rh:48888 rh:48912 rh:48916 rh:48924 rh:48928 rh:48932 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated