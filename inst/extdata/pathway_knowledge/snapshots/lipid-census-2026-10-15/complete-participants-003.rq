PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:14057 rh:14085 rh:14129 rh:14137 rh:14153 rh:14161 rh:14169 rh:14173 rh:14225 rh:14233 rh:14261 rh:14297 rh:14333 rh:14341 rh:14373 rh:14385 rh:14397 rh:14425 rh:14445 rh:14457 rh:14461 rh:14469 rh:14473 rh:14477 rh:14485 rh:14501 rh:14517 rh:14521 rh:14541 rh:14561 rh:14585 rh:14597 rh:14601 rh:14621 rh:14693 rh:14697 rh:14709 rh:14753 rh:14761 rh:14781 rh:14789 rh:14793 rh:14817 rh:14825 rh:14833 rh:14841 rh:14889 rh:14901 rh:14917 rh:14929 rh:14937 rh:14945 rh:14969 rh:14981 rh:14985 rh:14997 rh:15005 rh:15013 rh:15057 rh:15101 rh:15113 rh:15129 rh:15177 rh:15205 rh:15217 rh:15221 rh:15241 rh:15245 rh:15253 rh:15261 rh:15281 rh:15285 rh:15325 rh:15353 rh:15361 rh:15393 rh:15401 rh:15405 rh:15409 rh:15421 rh:15433 rh:15437 rh:15465 rh:15477 rh:15505 rh:15521 rh:15545 rh:15573 rh:15585 rh:15629 rh:15661 rh:15673 rh:15677 rh:15693 rh:15801 rh:15805 rh:15809 rh:15829 rh:15853 rh:15857 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated