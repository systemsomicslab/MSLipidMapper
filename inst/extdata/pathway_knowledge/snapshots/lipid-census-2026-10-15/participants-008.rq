PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:31495 rh:31499 rh:31515 rh:31519 rh:31543 rh:31547 rh:31551 rh:31555 rh:31579 rh:31607 rh:31611 rh:31687 rh:31691 rh:31695 rh:31699 rh:31703 rh:31707 rh:31711 rh:31715 rh:31719 rh:31731 rh:31771 rh:31775 rh:31779 rh:31783 rh:31787 rh:31791 rh:31795 rh:31807 rh:31811 rh:31815 rh:31819 rh:31823 rh:31827 rh:31831 rh:31847 rh:31851 rh:31855 rh:31859 rh:31863 rh:31867 rh:31871 rh:31875 rh:31879 rh:31883 rh:31887 rh:31895 rh:31943 rh:31947 rh:31951 rh:31955 rh:31959 rh:31963 rh:31967 rh:31971 rh:31975 rh:31983 rh:31987 rh:31991 rh:31995 rh:31999 rh:32003 rh:32007 rh:32011 rh:32015 rh:32019 rh:32023 rh:32027 rh:32031 rh:32075 rh:32079 rh:32131 rh:32135 rh:32151 rh:32175 rh:32183 rh:32187 rh:32195 rh:32199 rh:32219 rh:32239 rh:32295 rh:32299 rh:32307 rh:32323 rh:32327 rh:32331 rh:32335 rh:32339 rh:32343 rh:32371 rh:32375 rh:32379 rh:32383 rh:32387 rh:32391 rh:32395 rh:32399 rh:32403 rh:32407 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated