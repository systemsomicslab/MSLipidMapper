PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:80403 rh:80407 rh:80535 rh:80591 rh:80719 rh:80723 rh:80731 rh:80735 rh:80751 rh:80755 rh:80803 rh:80815 rh:80819 rh:80823 rh:80831 rh:80859 rh:80863 rh:80867 rh:80871 rh:80875 rh:80879 rh:80883 rh:80971 rh:80979 rh:80983 rh:80987 rh:81103 rh:81111 rh:81151 rh:81155 rh:81159 rh:81163 rh:81167 rh:81171 rh:81219 rh:81223 rh:81231 rh:81351 rh:81371 rh:81443 rh:81447 rh:81451 rh:81463 rh:81475 rh:81479 rh:81539 rh:81543 rh:81567 rh:81571 rh:81575 rh:81583 rh:81587 rh:81599 rh:81603 rh:81627 rh:81695 rh:81699 rh:81703 rh:81711 rh:81715 rh:81723 rh:81727 rh:81731 rh:81735 rh:81739 rh:81743 rh:81747 rh:81751 rh:81755 rh:81759 rh:81763 rh:81767 rh:81771 rh:81775 rh:81779 rh:81783 rh:81791 rh:81795 rh:81803 rh:81807 rh:81811 rh:81815 rh:81819 rh:81823 rh:81851 rh:81855 rh:81859 rh:81863 rh:81879 rh:81887 rh:81895 rh:81899 rh:81903 rh:81915 rh:81919 rh:81923 rh:81927 rh:81931 rh:81935 rh:81939 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated