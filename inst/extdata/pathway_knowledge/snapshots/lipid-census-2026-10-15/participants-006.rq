PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:25948 rh:25976 rh:25980 rh:25984 rh:25988 rh:25992 rh:26023 rh:26081 rh:26085 rh:26089 rh:26093 rh:26097 rh:26115 rh:26128 rh:26132 rh:26136 rh:26160 rh:26164 rh:26193 rh:26213 rh:26217 rh:26221 rh:26225 rh:26233 rh:26237 rh:26241 rh:26245 rh:26249 rh:26253 rh:26257 rh:26261 rh:26265 rh:26373 rh:26381 rh:26385 rh:26389 rh:26393 rh:26397 rh:26401 rh:26418 rh:26430 rh:26470 rh:26506 rh:26514 rh:27321 rh:27325 rh:27337 rh:27421 rh:27425 rh:27429 rh:27481 rh:27514 rh:27518 rh:27526 rh:27530 rh:27534 rh:27551 rh:27555 rh:27559 rh:27654 rh:27802 rh:27806 rh:27830 rh:27870 rh:27918 rh:27954 rh:28010 rh:28022 rh:28054 rh:28082 rh:28094 rh:28122 rh:28146 rh:28174 rh:28178 rh:28214 rh:28226 rh:28230 rh:28266 rh:28282 rh:28290 rh:28294 rh:28298 rh:28302 rh:28623 rh:28627 rh:28635 rh:28639 rh:28643 rh:29475 rh:29479 rh:29483 rh:29487 rh:29491 rh:29495 rh:29499 rh:29503 rh:29507 rh:29511 rh:29751 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated