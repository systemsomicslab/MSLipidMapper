PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:53772 rh:53776 rh:53780 rh:53784 rh:53788 rh:53796 rh:53800 rh:53804 rh:53808 rh:53812 rh:53820 rh:53824 rh:53840 rh:53844 rh:53848 rh:53852 rh:53856 rh:53860 rh:53864 rh:53908 rh:53912 rh:53932 rh:53936 rh:53940 rh:53972 rh:53976 rh:53980 rh:53984 rh:53992 rh:53996 rh:54000 rh:54004 rh:54008 rh:54012 rh:54016 rh:54020 rh:54028 rh:54040 rh:54044 rh:54048 rh:54052 rh:54056 rh:54060 rh:54064 rh:54068 rh:54072 rh:54076 rh:54108 rh:54112 rh:54116 rh:54148 rh:54212 rh:54216 rh:54220 rh:54224 rh:54232 rh:54236 rh:54240 rh:54244 rh:54248 rh:54252 rh:54284 rh:54320 rh:54324 rh:54328 rh:54332 rh:54336 rh:54340 rh:54344 rh:54348 rh:54352 rh:54356 rh:54372 rh:54376 rh:54380 rh:54384 rh:54388 rh:54392 rh:54396 rh:54400 rh:54404 rh:54408 rh:54412 rh:54416 rh:54456 rh:54460 rh:54464 rh:54468 rh:54472 rh:54476 rh:54480 rh:54484 rh:54488 rh:54492 rh:54496 rh:54500 rh:54504 rh:54508 rh:54512 rh:54516 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated