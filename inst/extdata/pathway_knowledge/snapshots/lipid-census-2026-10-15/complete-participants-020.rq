PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:37683 rh:37687 rh:37691 rh:37695 rh:37699 rh:37703 rh:37707 rh:37711 rh:37715 rh:37719 rh:37723 rh:37727 rh:37731 rh:37735 rh:37739 rh:37743 rh:37747 rh:37755 rh:37759 rh:37763 rh:37767 rh:37771 rh:37775 rh:37779 rh:37783 rh:37787 rh:37803 rh:37807 rh:37811 rh:37819 rh:37839 rh:37843 rh:37855 rh:37859 rh:37863 rh:37867 rh:37895 rh:37907 rh:37911 rh:37915 rh:37919 rh:37923 rh:37927 rh:37931 rh:37935 rh:37939 rh:37943 rh:37947 rh:37951 rh:37955 rh:37959 rh:37971 rh:37975 rh:37995 rh:38003 rh:38011 rh:38019 rh:38031 rh:38035 rh:38039 rh:38047 rh:38051 rh:38055 rh:38059 rh:38063 rh:38067 rh:38071 rh:38075 rh:38079 rh:38083 rh:38087 rh:38099 rh:38115 rh:38119 rh:38123 rh:38127 rh:38131 rh:38135 rh:38139 rh:38155 rh:38163 rh:38167 rh:38171 rh:38175 rh:38179 rh:38183 rh:38187 rh:38191 rh:38195 rh:38199 rh:38203 rh:38207 rh:38211 rh:38219 rh:38223 rh:38227 rh:38231 rh:38235 rh:38239 rh:38243 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated