PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:46972 rh:47044 rh:47052 rh:47056 rh:47060 rh:47064 rh:47068 rh:47072 rh:47076 rh:47080 rh:47096 rh:47100 rh:47108 rh:47112 rh:47116 rh:47120 rh:47124 rh:47128 rh:47132 rh:47136 rh:47140 rh:47144 rh:47156 rh:47160 rh:47164 rh:47168 rh:47172 rh:47176 rh:47180 rh:47184 rh:47196 rh:47200 rh:47204 rh:47208 rh:47212 rh:47216 rh:47220 rh:47224 rh:47228 rh:47232 rh:47236 rh:47240 rh:47252 rh:47256 rh:47260 rh:47264 rh:47268 rh:47272 rh:47276 rh:47280 rh:47284 rh:47288 rh:47292 rh:47296 rh:47300 rh:47304 rh:47308 rh:47312 rh:47316 rh:47328 rh:47332 rh:47336 rh:47340 rh:47344 rh:47348 rh:47352 rh:47356 rh:47360 rh:47364 rh:47368 rh:47376 rh:47380 rh:47388 rh:47392 rh:47396 rh:47400 rh:47412 rh:47420 rh:47424 rh:47428 rh:47432 rh:47436 rh:47440 rh:47444 rh:47448 rh:47452 rh:47456 rh:47460 rh:47464 rh:47468 rh:47472 rh:47476 rh:47480 rh:47484 rh:47488 rh:47492 rh:47496 rh:47500 rh:47504 rh:47508 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated