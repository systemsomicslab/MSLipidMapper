PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:33379 rh:33391 rh:33435 rh:33447 rh:33455 rh:33459 rh:33463 rh:33467 rh:33471 rh:33475 rh:33479 rh:33483 rh:33487 rh:33491 rh:33519 rh:33523 rh:33527 rh:33535 rh:33539 rh:33543 rh:33547 rh:33551 rh:33555 rh:33563 rh:33591 rh:33595 rh:33599 rh:33603 rh:33607 rh:33615 rh:33619 rh:33623 rh:33627 rh:33631 rh:33635 rh:33639 rh:33643 rh:33647 rh:33651 rh:33655 rh:33659 rh:33663 rh:33667 rh:33671 rh:33675 rh:33679 rh:33687 rh:33691 rh:33695 rh:33699 rh:33703 rh:33719 rh:33723 rh:33727 rh:33731 rh:33739 rh:33743 rh:33747 rh:33755 rh:33771 rh:33775 rh:33827 rh:33835 rh:33843 rh:33847 rh:33851 rh:33875 rh:33919 rh:33931 rh:33983 rh:33987 rh:33991 rh:33999 rh:34003 rh:34007 rh:34011 rh:34015 rh:34019 rh:34087 rh:34107 rh:34119 rh:34123 rh:34139 rh:34187 rh:34191 rh:34247 rh:34251 rh:34255 rh:34279 rh:34335 rh:34339 rh:34343 rh:34347 rh:34351 rh:34359 rh:34399 rh:34403 rh:34415 rh:34455 rh:34459 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated