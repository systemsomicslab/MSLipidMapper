PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:47512 rh:47516 rh:47520 rh:47524 rh:47528 rh:47532 rh:47536 rh:47540 rh:47548 rh:47552 rh:47556 rh:47560 rh:47564 rh:47568 rh:47572 rh:47576 rh:47580 rh:47584 rh:47588 rh:47592 rh:47600 rh:47604 rh:47612 rh:47628 rh:47716 rh:47740 rh:47828 rh:47832 rh:47852 rh:47856 rh:47860 rh:47864 rh:47868 rh:47872 rh:47876 rh:47880 rh:47884 rh:47888 rh:47892 rh:47900 rh:47904 rh:47916 rh:47920 rh:47940 rh:47944 rh:47968 rh:47984 rh:48020 rh:48024 rh:48028 rh:48036 rh:48040 rh:48044 rh:48048 rh:48056 rh:48060 rh:48064 rh:48068 rh:48072 rh:48080 rh:48120 rh:48124 rh:48128 rh:48132 rh:48136 rh:48144 rh:48148 rh:48152 rh:48156 rh:48168 rh:48172 rh:48176 rh:48180 rh:48184 rh:48188 rh:48192 rh:48196 rh:48200 rh:48204 rh:48208 rh:48212 rh:48216 rh:48220 rh:48224 rh:48228 rh:48240 rh:48244 rh:48248 rh:48252 rh:48256 rh:48260 rh:48268 rh:48272 rh:48280 rh:48284 rh:48288 rh:48292 rh:48296 rh:48300 rh:48304 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated