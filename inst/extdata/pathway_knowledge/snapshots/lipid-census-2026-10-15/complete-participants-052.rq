PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:61476 rh:61480 rh:61492 rh:61496 rh:61524 rh:61528 rh:61532 rh:61536 rh:61540 rh:61544 rh:61548 rh:61552 rh:61556 rh:61560 rh:61572 rh:61656 rh:61660 rh:61664 rh:61732 rh:61736 rh:61740 rh:61744 rh:61748 rh:61752 rh:61756 rh:61760 rh:61764 rh:61768 rh:61772 rh:61776 rh:61812 rh:61816 rh:61820 rh:61824 rh:61828 rh:61832 rh:61836 rh:61840 rh:61844 rh:61848 rh:61852 rh:61868 rh:61872 rh:61876 rh:61880 rh:61884 rh:61888 rh:61892 rh:61940 rh:61944 rh:61956 rh:61960 rh:61964 rh:61968 rh:61972 rh:62020 rh:62024 rh:62028 rh:62032 rh:62036 rh:62040 rh:62044 rh:62048 rh:62052 rh:62092 rh:62096 rh:62100 rh:62104 rh:62160 rh:62180 rh:62184 rh:62188 rh:62192 rh:62196 rh:62204 rh:62268 rh:62288 rh:62344 rh:62404 rh:62416 rh:62420 rh:62464 rh:62472 rh:62480 rh:62484 rh:62488 rh:62508 rh:62516 rh:62528 rh:62532 rh:62536 rh:62540 rh:62544 rh:62548 rh:62552 rh:62560 rh:62564 rh:62592 rh:62596 rh:62600 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated