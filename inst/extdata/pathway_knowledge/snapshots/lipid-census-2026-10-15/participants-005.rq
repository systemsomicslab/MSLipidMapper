PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:23472 rh:23520 rh:23580 rh:23600 rh:23612 rh:23616 rh:23708 rh:23712 rh:23728 rh:23752 rh:23768 rh:23800 rh:23812 rh:23840 rh:23948 rh:23960 rh:23984 rh:23992 rh:24076 rh:24084 rh:24116 rh:24144 rh:24156 rh:24172 rh:24216 rh:24220 rh:24308 rh:24324 rh:24352 rh:24356 rh:24404 rh:24508 rh:24552 rh:24612 rh:24616 rh:24620 rh:24640 rh:24698 rh:24734 rh:24789 rh:24809 rh:24813 rh:24923 rh:24964 rh:24968 rh:24972 rh:24976 rh:24984 rh:24988 rh:25033 rh:25046 rh:25074 rh:25168 rh:25217 rh:25282 rh:25286 rh:25363 rh:25367 rh:25395 rh:25399 rh:25404 rh:25436 rh:25440 rh:25444 rh:25448 rh:25452 rh:25456 rh:25460 rh:25464 rh:25468 rh:25472 rh:25476 rh:25480 rh:25484 rh:25488 rh:25492 rh:25496 rh:25500 rh:25504 rh:25508 rh:25532 rh:25536 rh:25540 rh:25544 rh:25548 rh:25552 rh:25556 rh:25560 rh:25617 rh:25641 rh:25645 rh:25649 rh:25658 rh:25662 rh:25666 rh:25759 rh:25767 rh:25828 rh:25844 rh:25848 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated