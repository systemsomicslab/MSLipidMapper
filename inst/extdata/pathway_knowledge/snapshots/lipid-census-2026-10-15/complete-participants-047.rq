PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:55356 rh:55360 rh:55364 rh:55372 rh:55384 rh:55424 rh:55428 rh:55432 rh:55436 rh:55440 rh:55444 rh:55452 rh:55456 rh:55460 rh:55464 rh:55468 rh:55472 rh:55476 rh:55480 rh:55484 rh:55488 rh:55492 rh:55496 rh:55500 rh:55504 rh:55508 rh:55512 rh:55516 rh:55520 rh:55536 rh:55556 rh:55560 rh:55588 rh:55596 rh:55600 rh:55604 rh:55608 rh:55616 rh:55620 rh:55632 rh:55652 rh:55656 rh:55660 rh:55664 rh:55668 rh:55688 rh:55692 rh:55696 rh:55700 rh:55712 rh:55716 rh:55740 rh:55768 rh:55776 rh:55780 rh:55784 rh:55788 rh:55800 rh:55804 rh:55808 rh:55828 rh:55832 rh:55836 rh:55840 rh:55844 rh:55856 rh:55860 rh:55920 rh:55936 rh:55940 rh:55952 rh:55956 rh:55964 rh:55968 rh:55992 rh:56060 rh:56088 rh:56104 rh:56124 rh:56128 rh:56148 rh:56152 rh:56156 rh:56164 rh:56168 rh:56184 rh:56228 rh:56236 rh:56240 rh:56244 rh:56248 rh:56336 rh:56340 rh:56408 rh:56412 rh:56424 rh:56428 rh:56432 rh:56436 rh:56440 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated