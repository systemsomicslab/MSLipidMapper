PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:56444 rh:56448 rh:56460 rh:56464 rh:56484 rh:56488 rh:56492 rh:56496 rh:56504 rh:56532 rh:56536 rh:56540 rh:56544 rh:56548 rh:56556 rh:56568 rh:56572 rh:56576 rh:56596 rh:56632 rh:56636 rh:56640 rh:56672 rh:56708 rh:56712 rh:56724 rh:56728 rh:56732 rh:56736 rh:56740 rh:56748 rh:56752 rh:56756 rh:56760 rh:56768 rh:56772 rh:56820 rh:56824 rh:56840 rh:56868 rh:56880 rh:56900 rh:56916 rh:56920 rh:56928 rh:56932 rh:56936 rh:56984 rh:56988 rh:56992 rh:57084 rh:57088 rh:57108 rh:57112 rh:57116 rh:57120 rh:57136 rh:57140 rh:57144 rh:57148 rh:57168 rh:57172 rh:57352 rh:57476 rh:57480 rh:57492 rh:57516 rh:57520 rh:57544 rh:57548 rh:57552 rh:57556 rh:57560 rh:57564 rh:57568 rh:57572 rh:57576 rh:57652 rh:57656 rh:57660 rh:57664 rh:57668 rh:57672 rh:57676 rh:57684 rh:57728 rh:57732 rh:57736 rh:57832 rh:57868 rh:57924 rh:57928 rh:57932 rh:57964 rh:57968 rh:57972 rh:57976 rh:57980 rh:57984 rh:57988 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated