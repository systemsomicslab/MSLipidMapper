PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:77623 rh:77627 rh:77631 rh:77635 rh:77647 rh:77663 rh:77667 rh:77671 rh:77675 rh:77679 rh:77683 rh:77687 rh:77691 rh:77695 rh:77699 rh:77703 rh:77715 rh:77719 rh:77723 rh:77727 rh:77731 rh:77739 rh:77743 rh:77747 rh:77751 rh:77759 rh:77767 rh:77771 rh:77899 rh:77935 rh:77939 rh:77943 rh:77947 rh:77951 rh:77955 rh:77963 rh:77967 rh:77971 rh:77975 rh:77979 rh:77983 rh:77987 rh:77991 rh:77995 rh:78015 rh:78019 rh:78147 rh:78175 rh:78203 rh:78263 rh:78271 rh:78275 rh:78279 rh:78283 rh:78287 rh:78291 rh:78319 rh:78347 rh:78351 rh:78355 rh:78359 rh:78363 rh:78399 rh:78403 rh:78407 rh:78447 rh:78451 rh:78455 rh:78463 rh:78467 rh:78531 rh:78559 rh:78563 rh:78567 rh:78571 rh:78575 rh:78579 rh:78583 rh:78587 rh:78591 rh:78595 rh:78599 rh:78603 rh:78607 rh:78611 rh:78631 rh:78635 rh:78639 rh:78643 rh:78655 rh:78659 rh:78663 rh:78667 rh:78671 rh:78675 rh:78695 rh:78727 rh:78731 rh:78735 rh:78739 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated