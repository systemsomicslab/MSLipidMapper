PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX ch: <http://purl.obolibrary.org/obo/CHEBI_>
PREFIX chebihash: <http://purl.obolibrary.org/obo/chebi#>
PREFIX chemrof: <https://w3id.org/chemrof/>
SELECT DISTINCT ?reaction ?equation ?side ?participant ?compound ?name ?chebi ?coefficient ?transport ?annotated WHERE {
 VALUES ?reaction { rh:40635 rh:40639 rh:40643 rh:40647 rh:40651 rh:40655 rh:40659 rh:40679 rh:40683 rh:40687 rh:40691 rh:40695 rh:40699 rh:40703 rh:40707 rh:40711 rh:40715 rh:40723 rh:40727 rh:40731 rh:40735 rh:40739 rh:40743 rh:40751 rh:40755 rh:40759 rh:40763 rh:40767 rh:40771 rh:40783 rh:40787 rh:40791 rh:40795 rh:40799 rh:40807 rh:40811 rh:40815 rh:40819 rh:40823 rh:40827 rh:40831 rh:40835 rh:40839 rh:40843 rh:40847 rh:40851 rh:40855 rh:40859 rh:40863 rh:40867 rh:40871 rh:40875 rh:40879 rh:40883 rh:40887 rh:40891 rh:40895 rh:40899 rh:40903 rh:40907 rh:40911 rh:40915 rh:40919 rh:40923 rh:40927 rh:40935 rh:40939 rh:40943 rh:40959 rh:40967 rh:40971 rh:40975 rh:40979 rh:40983 rh:40991 rh:40999 rh:41003 rh:41007 rh:41015 rh:41019 rh:41023 rh:41027 rh:41031 rh:41035 rh:41039 rh:41043 rh:41047 rh:41051 rh:41055 rh:41059 rh:41063 rh:41067 rh:41071 rh:41075 rh:41079 rh:41083 rh:41087 rh:41091 rh:41095 rh:41099 }
 GRAPH <https://sparql.rhea-db.org/rhea> {
 ?reaction rh:equation ?equation ; rh:side ?side .
 OPTIONAL { ?reaction rh:isTransport ?transport }
 BIND(?reaction AS ?annotated)
 ?side ?contains ?participant . ?contains rdfs:subPropertyOf rh:contains ; rh:coefficient ?coefficient .
 ?participant rh:compound ?compound . ?compound rh:name ?name .
 OPTIONAL { ?compound (rh:chebi|rh:reactivePart/rh:chebi|rh:underlyingChebi) ?chebi }
 }} ORDER BY ?reaction ?side ?participant ?annotated