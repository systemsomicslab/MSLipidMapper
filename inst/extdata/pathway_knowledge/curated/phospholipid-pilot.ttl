@prefix mslm: <https://systemomicslab.github.io/MSLipidMapper/ontology/> .
@prefix res: <https://systemomicslab.github.io/MSLipidMapper/resource/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# MS-DIAL Ontology values are exact mapping keys. LIPID MAPS classification
# codes describe generic subclasses; no individual structure LM_ID is asserted.
res:Phosphatidylcholine a mslm:LipidEntity, mslm:MSDialMappableLipidEntity ;
  rdfs:label "diacylglycerophosphocholine"@en ;
  mslm:msdialOntologyLabel "PC" ; mslm:lipidMapsCategoryCode "GP" ;
  mslm:lipidMapsMainClassCode "GP01" ; mslm:lipidMapsSubClassCode "GP0101" ;
  mslm:lipidMapsClassificationUrl "https://www.lipidmaps.org/data/classification/LM_classification.php?category=3"^^xsd:anyURI ;
  mslm:resolutionLevel mslm:SubclassLevel .
res:Phosphatidylethanolamine a mslm:LipidEntity, mslm:MSDialMappableLipidEntity ;
  rdfs:label "diacylglycerophosphoethanolamine"@en ;
  mslm:msdialOntologyLabel "PE" ; mslm:lipidMapsCategoryCode "GP" ;
  mslm:lipidMapsMainClassCode "GP02" ; mslm:lipidMapsSubClassCode "GP0201" ;
  mslm:lipidMapsClassificationUrl "https://www.lipidmaps.org/data/classification/LM_classification.php?category=3"^^xsd:anyURI ;
  mslm:resolutionLevel mslm:SubclassLevel .
res:Phosphatidylserine a mslm:LipidEntity, mslm:MSDialMappableLipidEntity ;
  rdfs:label "diacylglycerophosphoserine"@en ;
  mslm:msdialOntologyLabel "PS" ; mslm:lipidMapsCategoryCode "GP" ;
  mslm:lipidMapsMainClassCode "GP03" ; mslm:lipidMapsSubClassCode "GP0301" ;
  mslm:lipidMapsClassificationUrl "https://www.lipidmaps.org/data/classification/LM_classification.php?category=3"^^xsd:anyURI ;
  mslm:resolutionLevel mslm:SubclassLevel .
res:L_serine rdfs:label "L-serine"@en .
res:Choline rdfs:label "choline"@en .
res:Ethanolamine rdfs:label "ethanolamine"@en .
res:Carbon_dioxide rdfs:label "carbon dioxide"@en .
res:S_adenosyl_L_methionine rdfs:label "S-adenosyl-L-methionine"@en .
res:S_adenosyl_L_homocysteine rdfs:label "S-adenosyl-L-homocysteine"@en .

res:Endoplasmic_reticulum_membrane a mslm:CellularCompartment ; rdfs:label "endoplasmic reticulum membrane"@en .
res:Mitochondrial_inner_membrane a mslm:CellularCompartment ; rdfs:label "mitochondrial inner membrane"@en .

res:PTDSS1_enzyme a mslm:Enzyme ; rdfs:label "phosphatidylserine synthase 1"@en ; mslm:encodedBy res:PTDSS1_gene ; rdfs:seeAlso <https://identifiers.org/uniprot/P48651> .
res:PTDSS1_gene a mslm:Gene ; rdfs:label "PTDSS1"@en ; dcterms:identifier "NCBI Gene:9791" ; rdfs:seeAlso <https://identifiers.org/ncbigene/9791> .
res:PTDSS2_enzyme a mslm:Enzyme ; rdfs:label "phosphatidylserine synthase 2"@en ; mslm:encodedBy res:PTDSS2_gene ; rdfs:seeAlso <https://identifiers.org/uniprot/Q9BVG9> .
res:PTDSS2_gene a mslm:Gene ; rdfs:label "PTDSS2"@en ; dcterms:identifier "NCBI Gene:81490" ; rdfs:seeAlso <https://identifiers.org/ncbigene/81490> .
res:PISD_enzyme a mslm:Enzyme ; rdfs:label "phosphatidylserine decarboxylase"@en ; mslm:encodedBy res:PISD_gene ; rdfs:seeAlso <https://identifiers.org/uniprot/Q9UG56> .
res:PISD_gene a mslm:Gene ; rdfs:label "PISD"@en ; dcterms:identifier "NCBI Gene:23761" ; rdfs:seeAlso <https://identifiers.org/ncbigene/23761> .
res:PEMT_enzyme a mslm:Enzyme ; rdfs:label "phosphatidylethanolamine N-methyltransferase"@en ; mslm:encodedBy res:PEMT_gene ; rdfs:seeAlso <https://identifiers.org/uniprot/Q9UBM1> .
res:PEMT_gene a mslm:Gene ; rdfs:label "PEMT"@en ; dcterms:identifier "NCBI Gene:10400" ; rdfs:seeAlso <https://identifiers.org/ncbigene/10400> .

# PC + L-serine -> PS + choline
res:reaction_pc_to_ps a mslm:LipidReaction ;
  rdfs:label "PC is converted to PS by PTDSS1"@en ;
  mslm:hasParticipant res:part_pc_ps_pc, res:part_pc_ps_serine, res:part_pc_ps_ps, res:part_pc_ps_choline ;
  mslm:catalyzedBy res:PTDSS1_enzyme ; mslm:occursIn res:Endoplasmic_reticulum_membrane ;
  mslm:directionality mslm:Forward ; mslm:resolutionLevel mslm:ClassLevel ; mslm:curationStatus mslm:Reviewed ;
  mslm:hasSourceAssertion res:source_reactome_R-HSA-1483186, res:source_rhea_45088 ;
  mslm:hasCurationRecord res:curation_pc_to_ps_v01 .
res:part_pc_ps_pc a mslm:ReactionParticipant ; mslm:participantEntity res:Phosphatidylcholine ; mslm:participantRole mslm:Substrate ; mslm:stoichiometry 1.0 .
res:part_pc_ps_serine a mslm:ReactionParticipant ; mslm:participantEntity res:L_serine ; mslm:participantRole mslm:Substrate ; mslm:stoichiometry 1.0 .
res:part_pc_ps_ps a mslm:ReactionParticipant ; mslm:participantEntity res:Phosphatidylserine ; mslm:participantRole mslm:Product ; mslm:stoichiometry 1.0 .
res:part_pc_ps_choline a mslm:ReactionParticipant ; mslm:participantEntity res:Choline ; mslm:participantRole mslm:Product ; mslm:stoichiometry 1.0 .

# PE + L-serine -> PS + ethanolamine
res:reaction_pe_to_ps a mslm:LipidReaction ;
  rdfs:label "PE is converted to PS by PTDSS2"@en ;
  mslm:hasParticipant res:part_pe_ps_pe, res:part_pe_ps_serine, res:part_pe_ps_ps, res:part_pe_ps_ethanolamine ;
  mslm:catalyzedBy res:PTDSS2_enzyme ; mslm:occursIn res:Endoplasmic_reticulum_membrane ;
  mslm:directionality mslm:Forward ; mslm:resolutionLevel mslm:ClassLevel ; mslm:curationStatus mslm:Reviewed ;
  mslm:hasSourceAssertion res:source_reactome_R-HSA-1483089, res:source_rhea_27606 ;
  mslm:hasCurationRecord res:curation_pe_to_ps_v01 .
res:part_pe_ps_pe a mslm:ReactionParticipant ; mslm:participantEntity res:Phosphatidylethanolamine ; mslm:participantRole mslm:Substrate ; mslm:stoichiometry 1.0 .
res:part_pe_ps_serine a mslm:ReactionParticipant ; mslm:participantEntity res:L_serine ; mslm:participantRole mslm:Substrate ; mslm:stoichiometry 1.0 .
res:part_pe_ps_ps a mslm:ReactionParticipant ; mslm:participantEntity res:Phosphatidylserine ; mslm:participantRole mslm:Product ; mslm:stoichiometry 1.0 .
res:part_pe_ps_ethanolamine a mslm:ReactionParticipant ; mslm:participantEntity res:Ethanolamine ; mslm:participantRole mslm:Product ; mslm:stoichiometry 1.0 .

# PS -> PE + CO2
res:reaction_ps_to_pe a mslm:LipidReaction ;
  rdfs:label "PS is decarboxylated to PE by PISD"@en ;
  mslm:hasParticipant res:part_ps_pe_ps, res:part_ps_pe_pe, res:part_ps_pe_co2 ;
  mslm:catalyzedBy res:PISD_enzyme ; mslm:occursIn res:Mitochondrial_inner_membrane ;
  mslm:directionality mslm:Forward ; mslm:resolutionLevel mslm:ClassLevel ; mslm:curationStatus mslm:Reviewed ;
  mslm:hasSourceAssertion res:source_reactome_R-HSA-1483212, res:source_rhea_20828 ;
  mslm:hasCurationRecord res:curation_ps_to_pe_v01 .
res:part_ps_pe_ps a mslm:ReactionParticipant ; mslm:participantEntity res:Phosphatidylserine ; mslm:participantRole mslm:Substrate ; mslm:stoichiometry 1.0 .
res:part_ps_pe_pe a mslm:ReactionParticipant ; mslm:participantEntity res:Phosphatidylethanolamine ; mslm:participantRole mslm:Product ; mslm:stoichiometry 1.0 .
res:part_ps_pe_co2 a mslm:ReactionParticipant ; mslm:participantEntity res:Carbon_dioxide ; mslm:participantRole mslm:Product ; mslm:stoichiometry 1.0 .

# PE + 3 SAM -> PC + 3 SAH
res:reaction_pe_to_pc a mslm:LipidReaction ;
  rdfs:label "PE is methylated to PC by PEMT"@en ;
  mslm:hasParticipant res:part_pe_pc_pe, res:part_pe_pc_sam, res:part_pe_pc_pc, res:part_pe_pc_sah ;
  mslm:catalyzedBy res:PEMT_enzyme ; mslm:occursIn res:Endoplasmic_reticulum_membrane ;
  mslm:directionality mslm:Forward ; mslm:resolutionLevel mslm:ClassLevel ; mslm:curationStatus mslm:Reviewed ;
  mslm:hasSourceAssertion res:source_reactome_R-HSA-1483174, res:source_rhea_11164, res:source_rhea_32735, res:source_rhea_32739 ;
  mslm:hasCurationRecord res:curation_pe_to_pc_v01 .
res:part_pe_pc_pe a mslm:ReactionParticipant ; mslm:participantEntity res:Phosphatidylethanolamine ; mslm:participantRole mslm:Substrate ; mslm:stoichiometry 1.0 .
res:part_pe_pc_sam a mslm:ReactionParticipant ; mslm:participantEntity res:S_adenosyl_L_methionine ; mslm:participantRole mslm:Substrate ; mslm:stoichiometry 3.0 .
res:part_pe_pc_pc a mslm:ReactionParticipant ; mslm:participantEntity res:Phosphatidylcholine ; mslm:participantRole mslm:Product ; mslm:stoichiometry 1.0 .
res:part_pe_pc_sah a mslm:ReactionParticipant ; mslm:participantEntity res:S_adenosyl_L_homocysteine ; mslm:participantRole mslm:Product ; mslm:stoichiometry 3.0 .

