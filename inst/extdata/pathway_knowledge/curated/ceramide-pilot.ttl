@prefix mslm: <https://systemomicslab.github.io/MSLipidMapper/ontology/> .
@prefix res: <https://systemomicslab.github.io/MSLipidMapper/resource/> .
@prefix chebi: <http://purl.obolibrary.org/obo/CHEBI_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

res:Ceramide_d18 a mslm:LipidEntity ;
  rdfs:label "N-acylsphingosine (ceramide d18)"@en ;
  mslm:resolutionLevel mslm:SubclassLevel ;
  dcterms:identifier "ChEBI:52639" ;
  rdfs:seeAlso chebi:52639 .

res:Glucosylceramide a mslm:LipidEntity ;
  rdfs:label "glucosylceramide"@en ;
  mslm:resolutionLevel mslm:SubclassLevel .

res:UDP_glucose rdfs:label "UDP-glucose"@en .
res:UDP rdfs:label "UDP"@en .
res:Proton rdfs:label "proton"@en .

res:UGCG_enzyme a mslm:Enzyme ;
  rdfs:label "ceramide glucosyltransferase"@en ;
  mslm:encodedBy res:UGCG_gene ;
  rdfs:seeAlso <https://identifiers.org/uniprot/Q16739> .

res:UGCG_gene a mslm:Gene ;
  rdfs:label "UGCG"@en ;
  dcterms:identifier "NCBI Gene:7357" ;
  rdfs:seeAlso <https://identifiers.org/ncbigene/7357> .

res:Golgi_membrane a mslm:CellularCompartment ; rdfs:label "Golgi membrane"@en .

res:reaction_ceramide_glucosylation a mslm:LipidReaction ;
  rdfs:label "UGCG transfers glucose to ceramide"@en ;
  mslm:hasParticipant res:part_ceramide_substrate,
    res:part_udp_glucose_substrate,
    res:part_glccer_product,
    res:part_udp_product,
    res:part_proton_product ;
  mslm:catalyzedBy res:UGCG_enzyme ;
  mslm:occursIn res:Golgi_membrane ;
  mslm:directionality mslm:Forward ;
  mslm:resolutionLevel mslm:SubclassLevel ;
  mslm:curationStatus mslm:Reviewed ;
  mslm:hasSourceAssertion res:source_reactome_R-HSA-1638104,
    res:source_rhea_12088 ;
  mslm:hasCurationRecord res:curation_ceramide_glucosylation_v01 .

res:part_ceramide_substrate a mslm:ReactionParticipant ;
  mslm:participantEntity res:Ceramide_d18 ;
  mslm:participantRole mslm:Substrate ;
  mslm:stoichiometry 1.0 .
res:part_udp_glucose_substrate a mslm:ReactionParticipant ;
  mslm:participantEntity res:UDP_glucose ;
  mslm:participantRole mslm:Substrate ;
  mslm:stoichiometry 1.0 .
res:part_glccer_product a mslm:ReactionParticipant ;
  mslm:participantEntity res:Glucosylceramide ;
  mslm:participantRole mslm:Product ;
  mslm:stoichiometry 1.0 .
res:part_udp_product a mslm:ReactionParticipant ;
  mslm:participantEntity res:UDP ;
  mslm:participantRole mslm:Product ;
  mslm:stoichiometry 1.0 .
res:part_proton_product a mslm:ReactionParticipant ;
  mslm:participantEntity res:Proton ;
  mslm:participantRole mslm:Product ;
  mslm:stoichiometry 1.0 .

res:source_reactome_R-HSA-1638104 a mslm:SourceAssertion ;
  mslm:sourceDatabase "Reactome" ;
  mslm:sourceIdentifier "R-HSA-1638104" ;
  mslm:sourceUrl "https://reactome.org/content/detail/R-HSA-1638104"^^xsd:anyURI ;
  mslm:assertionMethod mslm:DatabaseCurated ;
  prov:wasDerivedFrom <https://reactome.org/content/detail/R-HSA-1638104> .

res:source_rhea_12088 a mslm:SourceAssertion ;
  mslm:sourceDatabase "Rhea" ;
  mslm:sourceIdentifier "RHEA:12088" ;
  mslm:sourceUrl "https://www.rhea-db.org/rhea/12088"^^xsd:anyURI ;
  mslm:assertionMethod mslm:DatabaseCurated ;
  prov:wasDerivedFrom <https://www.rhea-db.org/rhea/12088> .

res:curation_ceramide_glucosylation_v01 a mslm:CurationRecord ;
  mslm:curationStatus mslm:Reviewed ;
  mslm:reviewedOn "2026-08-27"^^xsd:date ;
  mslm:reviewNote "Pilot assertion verified against Reactome R-HSA-1638104, which cross-references RHEA:12088. Species-level chain preservation is not asserted by this record." .

