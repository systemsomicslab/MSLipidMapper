@prefix mslm: <https://systemomicslab.github.io/MSLipidMapper/ontology/> .
@prefix res: <https://systemomicslab.github.io/MSLipidMapper/resource/> .
@prefix rh: <http://rdf.rhea-db.org/> .
@prefix up: <http://purl.uniprot.org/uniprot/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Rhea classification permits chain-resolved traversal. These links describe
# reaction specificity, not preference magnitude.
rh:70751 mslm:rheaParentReaction rh:11164 ;
  mslm:acylChainSignature "18:3/18:3" ;
  mslm:lipidSubclass res:Phosphatidylethanolamine .
rh:70771 mslm:rheaParentReaction rh:32739 ;
  mslm:acylChainSignature "16:0/22:6" ;
  mslm:lipidSubclass res:Phosphatidylcholine .

# Quantitative preference must be stored separately as an observation with
# enzyme, organism, assay measure/value/unit and publication evidence. No value
# is asserted here until the source table has been manually extracted.
res:PEMT_rat_acyl_selectivity_dataset a mslm:AcylSelectivityObservation ;
  mslm:enzymeProtein up:Q08388 ;
  mslm:selectivityFor rh:70751 ; mslm:acylChainSignature "18:3/18:3" ;
  mslm:evidencePubMed <https://pubmed.ncbi.nlm.nih.gov/?term=Specificity+of+rat+hepatic+phosphatidylethanolamine+N-methyltransferase+for+molecular+species> ;
  dcterms:description "Curation placeholder: replace the protein URI and add measure/value/unit only after verifying the primary assay table."@en .
